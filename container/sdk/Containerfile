ARG BASE
FROM ${BASE}
USER root
# What container/firstrun.sh would otherwise install into every new workspace over the proxy (95 s of a 204 s `wk new`).
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends heaptrack valgrind sysprof ubuntu-dbgsym-keyring nodejs npm && \
    . /etc/os-release && \
    printf 'deb http://ddebs.ubuntu.com %s main restricted universe multiverse\n' \
        "$VERSION_CODENAME" "$VERSION_CODENAME-updates" "$VERSION_CODENAME-proposed" > /etc/apt/sources.list.d/ddebs.list && \
    apt-get update -qq
# The Swift toolchain built for the image's own Ubuntu: the one it ships is built for 24.04, and its
# ld.lld (first on PATH) cannot load libxml2.so.2 on 26.04, so no link uses lld.
# TODO: goes with the image upstream publishes from webkit-container-sdk's swift-ubuntu2604 change.
ARG SWIFT_VERSION=6.4.2
RUN case "$(uname -m)" in x86_64) arch="" ;; aarch64) arch="-aarch64" ;; esac && \
    rm -rf /opt/swift && mkdir -p /opt/swift && \
    curl --fail --silent --show-error --location --output /tmp/swift.tar.gz \
        "https://download.swift.org/swift-${SWIFT_VERSION}-release/ubuntu2604${arch}/swift-${SWIFT_VERSION}-RELEASE/swift-${SWIFT_VERSION}-RELEASE-ubuntu26.04${arch}.tar.gz" && \
    tar zxf /tmp/swift.tar.gz --strip-components=1 -C /opt/swift && rm /tmp/swift.tar.gz
RUN clang -fuse-ld=lld -Wl,--version && swiftc --version
