#!/bin/bash
# git-sync-fork [<remote>] [<branch>] -- fast-forward your fork's branch on GitHub to origin's; it does not touch the checkout.
set -euo pipefail

remote="${1:-fork}"
branch="${2:-main}"

git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git checkout" >&2; exit 1; }
git remote get-url "$remote" >/dev/null 2>&1 || {
    echo "no remote '$remote' here. The wired ones are: $(git remote | tr '\n' ' ')" >&2
    exit 1
}

echo "fetching origin/$branch ..."
git fetch --quiet origin "$branch"

upstream=$(git rev-parse "origin/$branch")
current=$(git ls-remote "$remote" "refs/heads/$branch" | awk '{print $1}')

if [ "$current" = "$upstream" ]; then
    echo "$remote/$branch is already at $(git --no-pager log -1 --format=%h "$upstream") -- nothing to do"
    exit 0
fi

if [ -n "$current" ]; then
    behind=$(git rev-list --count "$current..$upstream" 2>/dev/null || echo "?")
    ahead=$(git rev-list --count "$upstream..$current" 2>/dev/null || echo "?")
    echo "$remote/$branch is $behind behind and $ahead ahead of origin/$branch"
    [ "$ahead" = 0 ] || {
        echo "refusing: $remote/$branch has $ahead commit(s) origin does not." >&2
        echo "  That is work on the wrong branch, not drift. Move it to a branch of" >&2
        echo "  its own first; this command only fast-forwards." >&2
        exit 1
    }
fi

echo "pushing origin/$branch -> $remote/$branch (fast-forward) ..."
git push "$remote" "$upstream:refs/heads/$branch"
echo "$remote/$branch is now at $(git --no-pager log -1 --format='%h %s' "$upstream")"
