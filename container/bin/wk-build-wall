#!/usr/bin/env bash
# wk-build-wall: _is_wall greps this prefix within the first 5 lines; without it two wk-tools trees on PATH exec each other until the process table gives out (measured).
# Covers a bare name resolved on PATH in every shell that sources shell/path.sh; a path form is covered instead by the `Bash(*/<name> *)` deny rules in claude/settings.json and claude/settings-host.json.
# One script under three kinds of name, because finding the real tool past itself on PATH is the same job for all: WALL_NAMES is refused for an agent; GATE_NAMES is never refused -- it runs the tool and explains a failure the sandbox caused; BRIDGE_NAMES runs the command under a bridge of root's own.

set -euo pipefail

WALL_NAMES="ninja cmake make xcodebuild build-webkit build-jsc run-javascriptcore-tests run-webkit-tests run-benchmark"

GATE_NAMES="git"   # on a workspace's PATH only (shell/path.sh), where the wall is what a failure means
BRIDGE_NAMES="sudo"   # on a workspace's PATH only: the exec's bridge refuses root's sockets, which it cannot read (container/proxy/bridge.py)
BRIDGE=/opt/wk-tools/container/proxy/ensure-bridge.sh

GIT_WRITE_VERBS="add am apply branch checkout cherry-pick commit fetch gc merge mv notes prune pull push rebase reset restore revert rm stash switch tag"   # what the commit wall (COMMIT_WALL_PATHS, lib/wk/wall.py) can make fail; read only after the command has failed, so a verb whose read-only form works -- `git tag`, `git stash list` -- costs nothing to name

self=${0##*/}
orig=("$@")

# Follows the file bash is running, not $0, which the gate replaces with the tool's name (container/bin/ws/git); bitbake's tmp/hosttools copies have no sibling wall to find, and `readlink -f` is what macOS lacks.
_resolve_self() {
    local p="${BASH_SOURCE[0]}" t n=0 d
    while [ -L "$p" ] && [ "$n" -lt 40 ]; do
        t=$(readlink "$p") || break
        case "$t" in
            /*) p=$t ;;
            *)  p=$(dirname -- "$p")/$t ;;
        esac
        n=$((n + 1))
    done
    d=$(CDPATH= cd -- "$(dirname -- "$p")" 2>/dev/null && pwd) || return 1
    printf '%s/%s' "$d" "${p##*/}"
}
WALL=$(_resolve_self) || :
[ -x "$WALL" ] || {
    printf '%s: cannot locate the wall behind %s -- refusing rather than guessing\n' \
        "$self" "$0" >&2
    exit 1
}

case " $WALL_NAMES $GATE_NAMES $BRIDGE_NAMES " in
    *" $self "*) ;;
    *) printf '%s: nothing calls this by its own name -- it runs as one of: %s\n' \
           "$self" "$WALL_NAMES $GATE_NAMES $BRIDGE_NAMES" >&2
       exit 1 ;;
esac

if [[ " $WALL_NAMES " == *" $self "* ]] && [ -z "${WK_BUILD:-}" ] \
   && { [ -n "${CLAUDECODE:-}" ] || [ -n "${WK_AGENT:-}" ]; }; then
    printf '%s: refused. An agent does not drive a build or a test run directly:\n' "$self" >&2
    printf '  wk carries the job count and the nice level this machine needs, and a raw\n' >&2
    printf '  %s has taken shared build machines down.\n' "$self" >&2
    printf 'Use instead:  wk build <preset> | wk test <args> | wk bench <plan> | wk run -- <args>\n' >&2
    exit 1
fi

_is_wall() { # <path>
    local t
    t=$(readlink "$1" 2>/dev/null) && [ "${t##*/}" = wk-build-wall ] && return 0
    head -n 5 "$1" 2>/dev/null | grep -q '^# wk-build-wall:'
}

_real() {
    local oldifs=$IFS d cand
    IFS=:
    set -- $PATH
    IFS=$oldifs
    for d in "$@"; do
        [ -n "$d" ] || continue
        cand=$d/$self
        [ -x "$cand" ] && [ ! -d "$cand" ] || continue
        [ "$cand" -ef "$WALL" ] && continue
        _is_wall "$cand" && continue
        printf '%s' "$cand"
        return 0
    done
    return 1
}

real=$(_real) || {
    printf '%s: not on PATH (only the wall at %s answers to that name)\n' "$self" "$WALL" >&2
    exit 127
}

_git_verb() {   # git's own global options come before the subcommand, and six of them take a value
    while [ $# -gt 0 ]; do
        case "$1" in
            -C|-c|--git-dir|--work-tree|--namespace|--exec-path)
                [ $# -ge 2 ] || return 1
                shift 2 ;;
            -*) shift ;;
            *)  printf '%s' "$1"; return 0 ;;
        esac
    done
    return 1
}

_history_walled() {   # the wall is read-only mounts, so this asks the machine rather than who started the session: a person's own shell in the same workspace is not walled and gets no note
    local d="$PWD" g=""
    while [ -n "$d" ]; do
        [ -e "$d/.git" ] && { g="$d/.git"; break; }
        d=${d%/*}
    done
    [ -n "$g" ] || return 1
    [ ! -f "$g" ] || g=$(sed -n 's/^gitdir: //p' "$g")
    [ -d "$g" ] || return 1
    [ ! -w "$g/objects" ]
}

# Never a refusal: the command runs exactly as it would without this file, and what is added is the reason for a failure the sandbox caused. Refusing up front would need a list of verbs that always write, and `git tag`, `git branch` and `git stash list` are the same verbs reading.
if [ "$self" = git ]; then
    verb=$(_git_verb "$@") || verb=""
    case " $GIT_WRITE_VERBS " in
        *" $verb "*)
            rc=0
            "$real" "$@" || rc=$?
            [ "$rc" != 0 ] || exit 0
            if _history_walled; then
                printf '\nwk: git history is read-only in this session. An agent runs under bwrap\n' >&2
                printf "    with this checkout's .git commit parts bound read-only, so nothing it\n" >&2
                printf '    runs writes history -- a build, an edit and git status/diff/log all work.\n' >&2
                printf '    A person\x27s own shell here (wk enter) is not walled.\n' >&2
            fi
            exit "$rc" ;;
    esac
fi

# sudo's grammar (parse_args.c): a value option's argument is attached or the next word, a flag cluster may end in a value option, and `VAR=value` words precede the command. A form that runs no command (-l -v -K -V -e -h alone, a missing value, an option sudo would refuse) goes to sudo as it was.
if [ "$self" = sudo ]; then
    # the marker's place: only a container has a bridge to give root; a guest's and a box's sudo is its own
    [ "$(sed -n 's/^place=//p' "$HOME/.wk-workspace" 2>/dev/null)" = container ] || exec "$real" "$@"
    opts=() shell="" dashdash=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --) dashdash=--; shift; break ;;
            --shell) shell=-s; shift ;;
            --login) shell=-i; shift ;;
            --askpass|--background|--bell|--preserve-env|--preserve-env=*|--set-home|--reset-timestamp|--non-interactive|--preserve-groups|--stdin) opts+=("$1"); shift ;;
            --auth-type=*|--login-class=*|--close-from=*|--chdir=*|--group=*|--host=*|--prompt=*|--role=*|--chroot=*|--type=*|--command-timeout=*|--user=*|--other-user=*) opts+=("$1"); shift ;;
            --auth-type|--login-class|--close-from|--chdir|--group|--host|--prompt|--role|--chroot|--type|--command-timeout|--user|--other-user)
                [ $# -ge 2 ] || exec "$real" ${orig[@]+"${orig[@]}"}
                opts+=("$1" "$2"); shift 2 ;;
            --*) exec "$real" ${orig[@]+"${orig[@]}"} ;;
            -[!-]*)
                cluster=${1#-} keep="-"; shift
                while [ -n "$cluster" ]; do
                    c=${cluster:0:1} cluster=${cluster:1}
                    case "$c" in
                        s|i) shell=-$c ;;
                        A|b|B|E|H|k|n|P|S) keep+=$c ;;
                        a|c|C|D|g|h|p|r|R|t|T|u|U)
                            if [ -n "$cluster" ]; then
                                opts+=("$keep$c$cluster"); cluster=""
                            elif [ $# -ge 1 ]; then
                                opts+=("$keep$c" "$1"); shift
                            else
                                exec "$real" ${orig[@]+"${orig[@]}"}
                            fi
                            keep="" ;;
                        *) exec "$real" ${orig[@]+"${orig[@]}"} ;;
                    esac
                done
                [ "$keep" = - ] || [ -z "$keep" ] || opts+=("$keep") ;;
            [A-Za-z_]*=*) [[ "${1%%=*}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || break; opts+=("$1"); shift ;;
            *) break ;;
        esac
    done
    if [ $# -gt 0 ]; then
        exec "$real" ${opts[@]+"${opts[@]}"} ${shell:+"$shell"} ${dashdash:+--} "$BRIDGE" "$@"
    fi
    case "$shell" in
        -s) exec "$real" ${opts[@]+"${opts[@]}"} ${dashdash:+--} "$BRIDGE" "${SHELL:-/bin/bash}" ;;
        -i) exec "$real" ${opts[@]+"${opts[@]}"} ${dashdash:+--} "$BRIDGE" bash -l ;;
    esac
    exec "$real" ${orig[@]+"${orig[@]}"}
fi

exec "$real" "$@"
