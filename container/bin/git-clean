#!/bin/bash
#
# git-clean -- throw away everything not committed, in one command:
# `git reset . && git checkout . && git clean -fd`.
#
# Destructive by design and there is no undo, since `git clean -fd` removes
# untracked files no editor has ever saved. So it says what it is about to
# destroy and asks, unless --yes.
set -euo pipefail

# `case`, not `[ x ] && YES=1`: that is an AND-OR list returning 1 when the test
# fails, which under `set -e` would end the script in the common case.
YES=""
case "${1:-}" in --yes|-y) YES=1 ;; esac

git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git checkout" >&2; exit 1; }

modified=$(git status --porcelain | grep -cv '^??' || true)
untracked=$(git status --porcelain | grep -c '^??' || true)

if [ "$modified" = 0 ] && [ "$untracked" = 0 ]; then
    echo "already clean"
    exit 0
fi

echo "this discards $modified modified file(s) and $untracked untracked file(s):"
git status --short | head -40
[ "$(git status --porcelain | wc -l)" -le 40 ] || echo "  ... and more"

if [ -z "${YES:-}" ]; then
    printf 'discard all of it? [y/N] '
    read -r ans
    case "$ans" in y|Y|yes) ;; *) echo "nothing done"; exit 1 ;; esac
fi

# Both need a HEAD to compare against, and a checkout with no commits has none:
# `git checkout -- .` there fails with "pathspec '.' did not match any file(s)".
# The untracked sweep below is the whole job in that case.
if git rev-parse --verify --quiet HEAD >/dev/null; then
    git reset --quiet .
    # And only when something is tracked: the same "pathspec '.' did not match
    # any file(s)" failure would, under `set -e`, end the script before the
    # clean below.
    [ -z "$(git ls-files)" ] || git checkout --quiet -- .
fi
git clean -fdq
echo "clean"
