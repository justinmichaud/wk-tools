#!/bin/bash
#
# git-clean -- throw away everything not committed, in one command.
#
# `git reset . && git checkout . && git clean -fd`, which is three commands
# nobody remembers in the right order at the moment they want them. Restored
# from the pre-`wk` helpers because it is a real workflow -- a workspace is
# disposable and a wrecked tree is meant to be thrown away, not repaired.
#
# It is destructive by design and there is no undo: `git clean -fd` removes
# untracked files, including ones no editor has ever saved. So it says what it
# is about to destroy and asks, unless --yes.
set -euo pipefail

# `[ x ] && YES=1` on its own line is the last command of an AND-OR list and
# returns 1 when the test fails, which under `set -e` ends the script -- so the
# common case (no --yes) would exit 1 having done nothing.
YES=""
case "${1:-}" in --yes|-y) YES=1 ;; esac

git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git checkout" >&2; exit 1; }

modified=$(git status --porcelain | grep -cv '^??' || true)
untracked=$(git status --porcelain | grep -c '^??' || true)

if [ "$modified" = 0 ] && [ "$untracked" = 0 ]; then
    echo "already clean"
    exit 0
fi

echo "this discards $modified modified file(s) and $untracked untracked file(s):"
git status --short | head -40
[ "$(git status --porcelain | wc -l)" -le 40 ] || echo "  ... and more"

if [ -z "${YES:-}" ]; then
    printf 'discard all of it? [y/N] '
    read -r ans
    case "$ans" in y|Y|yes) ;; *) echo "nothing done"; exit 1 ;; esac
fi

# Both of these need a HEAD to compare against, and a checkout with no commits
# yet has none -- `git checkout -- .` there fails with "pathspec '.' did not
# match any file(s)", which reads like a bug in this script rather than an empty
# repository. The untracked sweep below is the whole job in that case.
if git rev-parse --verify --quiet HEAD >/dev/null; then
    git reset --quiet .
    # ... and only when something is actually tracked. `git checkout -- .` in a
    # tree whose files are all untracked (a fresh checkout, or one whose only
    # commit is empty) fails with "pathspec '.' did not match any file(s)",
    # which under `set -e` ends the script *before* the clean below -- so the
    # command reported an error and left the mess it was asked to remove.
    [ -z "$(git ls-files)" ] || git checkout --quiet -- .
fi
git clean -fdq
echo "clean"
