#!/usr/bin/env python3
# `ProxyCommand <this> <container|vm> <ws>`: that driver's ssh_transport in lib/wk/places.py.
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import act, places  # noqa: E402
from wk.workspace import require_name  # noqa: E402

if len(sys.argv) != 3 or sys.argv[1] not in ("container", "vm"):
    sys.exit("usage: ssh-transport <container|vm> <workspace>   (as an ssh ProxyCommand)")
try:
    require_name(sys.argv[2])
    places.Registry(ROOT).load(sys.argv[1]).ssh_transport(sys.argv[2])
except act.Refused as e:
    sys.exit(e.status)
