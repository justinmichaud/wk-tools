# BatchMode/StrictHostKeyChecking/ConnectTimeout live here because ssh does not pass command-line options to a ProxyJump child, and this gateway offers publickey,password and asks three times if a hop's key is missing -- BatchMode yes refuses instead of blocking a read-only probe on a prompt.
Host igalia.com
  ForwardAgent yes
  User jmichaud
  Port 6789
  BatchMode yes
  StrictHostKeyChecking accept-new
  ConnectTimeout 10

Host moose
  User jmichaud

Host buildbox4
  HostName buildbox4
  User jmichaud
  ProxyJump igalia.com

Host devbox-arm64-2
  HostName bbox-12-arm64
  User jmichaud
  ProxyJump igalia.com

Host devbox-armhf-2
  HostName bbox-12-armhf
  User jmichaud
  ProxyJump igalia.com

Host rpi5
  User jmichaud

# User justinmichaud, not the fleet's jmichaud: this install's account, corrected only at the next reprovision (docs/HANDOFF-reprovision.md) -- do not tidy it, the login would break.
Host tolken
  User justinmichaud
  ServerAliveInterval 30
  ServerAliveCountMax 6

# The same Mac in bench mode: its own tailnet node, `tolken-bench`, which
# bench/mac-tailnet.sh keeps across a rebuild and a rehearsal guest (wk-bench) --
# so no HostName. The ssh host key is NOT kept: every rebuild or `wk new` of the
# guest mints one, so it is not pinned, as for the boards; the tailnet node key
# is what identifies the machine. User `bench`: a benchmark install is cattle,
# reproducible by anyone, so no person's account name is baked into it.
Host tolken-bench
  User bench
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  ServerAliveInterval 30
  ServerAliveCountMax 6

Host moosebmc
  HostName 10.99.0.2
  User root
  Port 2200
  ProxyJump librem5-oob

# Both bridge phones roam between two APs on one SSID, and a roam stalls TCP long enough to kill an idle session while the phone itself never wavered -- ServerAliveInterval below is the fix.
Host tailnet-bridge-generic tailnet-bridge-generic.local
  HostKeyAlias tailnet-bridge-generic

Host tailnet-bridge-moose-bmc tailnet-bridge-moose-bmc.local
  HostKeyAlias tailnet-bridge-moose-bmc

Host tailnet-bridge-generic tailnet-bridge-generic.local tailnet-bridge-moose-bmc tailnet-bridge-moose-bmc.local
  User user
  ServerAliveInterval 15
  ServerAliveCountMax 4
  StrictHostKeyChecking accept-new
  ConnectTimeout 10

# This phone is not a provisioned bridge, so password authentication is still on it and a hop that refuses to ask fails for the wrong reason: BatchMode no, written out because ssh's default is indistinguishable from an omission.
Host librem5-oob
  StrictHostKeyChecking accept-new
  ConnectTimeout 10
  BatchMode no
