# Included from ~/.gitconfig by `./setup`, so machine-local settings and
# credentials can live alongside it without being committed here.

[user]
	name = Justin Michaud
	email = jmichaud@igalia.com

[core]
	excludesFile = ~/.gitignore

[init]
	defaultBranch = main

[pull]
	rebase = true

[fetch]
	prune = true

[push]
	default = current

[diff]
	# Better function-context headers in C++ and Objective-C hunks.
	algorithm = histogram
	colorMoved = zebra

[core]
    fsmonitor = true
    untrackedCache = true
    preloadIndex = true
[feature]
    manyFiles = true
[index]
    skipHash = true
[fetch]
    writeCommitGraph = true
    parallel = 4
[checkout]
    workers = 0
[diff]
    algorithm = histogram
[gc]
    auto = 6700
# No `process`: a long-running filter git cannot start is fatal, and a workspace has no git-lfs.
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
