[Unit]
Description=wk GitHub API credential injector
Documentation=file://@WK_ROOT@/container/proxy/github-inject.py
# On a mount, and waited for, for the reason wk-proxy.service gives.
RequiresMountsFor=@WK_ROOT@

[Service]
# Ready is "the socket is bound", which only the program knows, so it says
# so (sd_notify, lib/wknotify.py) and the start job waits for it. Type=simple
# would report a service that execs and dies a moment later as started.
Type=notify
NotifyAccess=all
ExecStart=/usr/bin/python3 @WK_ROOT@/container/proxy/github-inject.py
Environment=WK_STORE=@WK_STORE@
Restart=on-failure
RestartSec=2
# It publishes its CA certificate into %t/wk, which every container mounts.
RuntimeDirectory=wk
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# It mints its CA through openssl, which is handed a config file written to a
# temporary directory -- and under ProtectSystem=strict every path outside the
# ones named here is read-only, /tmp included.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@WK_STORE@

[Install]
WantedBy=default.target
