#!/bin/sh
# wk-tools/bashrc — shared rc, sourced by BOTH bash and zsh.
#
# Must stay POSIX-clean at the top level; shell-specific code goes inside the
# $BASH_VERSION / $ZSH_VERSION guards below.
#
# Escape hatches:
#   NO_ZSH=1 bash     -> stay in bash
#   HISTFILE=...      -> override history location (set before sourcing)

# --- 0. Interactive-only guard -----------------------------------------------
# ~/.bashrc is sourced non-interactively sometimes (ssh with
# SSH_SOURCE_BASHRC, scp/rsync); bail early rather than corrupt those sessions.
# No bare `return`: it errors under zsh when the file isn't sourced.
case $- in
  *i*) _WK_INTERACTIVE=1 ;;
  *)   _WK_INTERACTIVE=  ;;
esac

if [ -n "$_WK_INTERACTIVE" ]; then

# --- 0b. Unknown TERM fallback (kitty and friends, over ssh) -----------------
# kitty/wezterm/alacritty set TERM to their own name; ssh forwards it as-is,
# and unless the remote has that terminfo installed (`kitten ssh` does this
# automatically, plain `ssh` never does), any program that asks terminfo for
# an escape sequence -- zsh's line editor included -- gets nothing back: the
# "Backspace prints ^H", "Delete does nothing" family of complaints.
#
# xterm-256color ships everywhere and is close enough (these terminals still
# speak classic xterm sequences) to fix all of it at once.
if ! infocmp "$TERM" >/dev/null 2>&1; then
  export TERM=xterm-256color
fi

# --- 1. Switch bash -> zsh ---------------------------------------------------
# Skipped under zsh (no $BASH_VERSION, so `shopt` doesn't blow up when
# ~/.zshrc sources this file) and for TERM=dumb / Emacs subshells, where zsh's
# line editor and prompt escapes break shell-mode / tramp.

if [ -n "$BASH_VERSION" ] \
   && [ -z "$BASH_TO_ZSH_GUARD" ] \
   && [ -z "$NO_ZSH" ] \
   && [ "$TERM" != "dumb" ] \
   && [ -z "$INSIDE_EMACS" ] \
   && [ -t 0 ]
then
  # command -v first (Nix, ~/.local, source builds, asdf); Homebrew is often
  # missing from PATH under a stripped SSH environment before ~/.zprofile runs.
  _wk_zsh=""
  for _wk_c in \
    "$(command -v zsh 2>/dev/null)" \
    /opt/homebrew/bin/zsh \
    /usr/local/bin/zsh \
    /usr/bin/zsh \
    /bin/zsh
  do
    if [ -n "$_wk_c" ] && [ -x "$_wk_c" ]; then _wk_zsh="$_wk_c"; break; fi
  done
  unset _wk_c

  if [ -n "$_wk_zsh" ]; then
    export BASH_TO_ZSH_GUARD=1
    export SHELL="$_wk_zsh"

    # macOS: every Terminal.app/iTerm2 tab is a login shell, so `exec zsh -l`
    # would re-run path_helper via /etc/zprofile, rebuilding PATH with system
    # paths first and shoving wk-tools and any local JSC build behind
    # /usr/bin. So: login semantics on Linux, plain exec on Darwin (~/.zshrc
    # owns PATH there).
    if [ "$(uname -s)" = "Darwin" ]; then
      exec "$_wk_zsh"
    elif shopt -q login_shell; then
      exec "$_wk_zsh" -l
    else
      exec "$_wk_zsh"
    fi

    # Only reached if exec failed: stay in bash, don't leave a broken guard.
    unset BASH_TO_ZSH_GUARD
  fi
  unset _wk_zsh
fi

# --- 2. History — shared settings --------------------------------------------
# HISTFILE stays on local disk: inside a synced wk-tools (git, Dropbox,
# iCloud) it would get clobbered by concurrent writes from two machines.
: "${HISTFILE:=$HOME/.${_WK_SHELL_NAME:-sh}_history}"

if [ -n "$ZSH_VERSION" ]; then
  HISTFILE="$HOME/.zsh_history"
elif [ -n "$BASH_VERSION" ]; then
  HISTFILE="$HOME/.bash_history"
fi

# --- 3. History — zsh --------------------------------------------------------
if [ -n "$ZSH_VERSION" ]; then

  # HISTSIZE (in-memory) must be >= SAVEHIST (on-disk) or the file truncates
  # to the smaller value on every write; kept larger for headroom.
  HISTSIZE=1200000
  SAVEHIST=1000000

  # macOS's /etc/zshrc sets small history limits first; these win only
  # because ~/.zshrc sources this file after.

  setopt EXTENDED_HISTORY        # write timestamp + duration per entry
  setopt APPEND_HISTORY          # append at exit, never truncate the file
  setopt INC_APPEND_HISTORY_TIME # write each command as it finishes, not at
                                 # exit — survives kill -9, crashes, reboots,
                                 # and closing the terminal with the X button
  setopt HIST_FCNTL_LOCK         # fcntl() locking: correct and fast when many
                                 # shells write concurrently
  setopt HIST_VERIFY             # expand !! etc. onto the line, don't run blind
  setopt HIST_IGNORE_SPACE       # leading space = deliberate omission (secrets)
  setopt HIST_FIND_NO_DUPS       # dedupe search results only, not the file

  # Explicitly off: each of these deletes entries, contradicting the goal.
  unsetopt HIST_IGNORE_ALL_DUPS
  unsetopt HIST_SAVE_NO_DUPS
  unsetopt HIST_EXPIRE_DUPS_FIRST
  unsetopt HIST_IGNORE_DUPS

  # SHARE_HISTORY is the live-import alternative to INC_APPEND_HISTORY_TIME
  # (up-arrow in one terminal sees another's commands). To switch:
  #     unsetopt INC_APPEND_HISTORY_TIME; setopt SHARE_HISTORY
  unsetopt SHARE_HISTORY

  # --- 3b. Keymap and keys ---------------------------------------------------
  # The keymap is chosen *before* any key is bound, and nothing after this
  # chooses again: `bindkey -e` links a fresh emacs keymap over `main`, so a
  # binding made while `main` was viins is discarded by it. That is machine-
  # dependent -- zsh picks vi mode when $EDITOR/$VISUAL contains "vi", so a
  # host without helix starts in viins and a host with it starts in emacs --
  # which is how Home worked on one machine and not the next. WK_ZSH_VI=1
  # asks for vi mode; then the bindings below land in viins instead.
  if [ -z "${WK_ZSH_VI:-}" ]; then bindkey -e; else bindkey -v; fi

  # Bound explicitly rather than left to zle's terminfo defaults: the TERM
  # fallback above covers "no entry"; this covers "entry present but wrong"
  # (e.g. `kbs` still ^H while kitty sends ^?).
  #
  # Home and End arrive in two encodings and both are bound, because which one
  # a terminal sends is not ours to choose: zle turns on application cursor
  # mode (terminfo `smkx`) for the duration of a prompt, and a terminal in that
  # mode sends ^[OH / ^[OF where it otherwise sends ^[[H / ^[[F.
  bindkey "^?"    backward-delete-char  # Backspace
  bindkey "^H"    backward-delete-char  # Backspace, terminals/ttys still on kbs=^H
  bindkey "^[[3~" delete-char           # Delete
  bindkey "^[[H"  beginning-of-line     # Home
  bindkey "^[OH"  beginning-of-line     # Home, application cursor mode
  bindkey "^[[1~" beginning-of-line     # Home, older xterm encoding
  bindkey "^[[7~" beginning-of-line     # Home, rxvt encoding
  bindkey "^[[F"  end-of-line           # End
  bindkey "^[OF"  end-of-line           # End, application cursor mode
  bindkey "^[[4~" end-of-line           # End, older xterm encoding
  bindkey "^[[8~" end-of-line           # End, rxvt encoding

fi

# --- 4. History — bash -------------------------------------------------------
# Reached on hosts with no zsh installed, or under NO_ZSH=1.
if [ -n "$BASH_VERSION" ]; then

  shopt -s histappend   # append, don't overwrite — without this the last shell
                        # to exit wins and clobbers every other session
  shopt -s cmdhist      # multi-line command -> one history entry
  shopt -s lithist      # ...preserving real newlines instead of semicolons

  # bash 4.3+ understands HISTSIZE=-1 (unlimited); macOS's system bash 3.2
  # doesn't, so fall back to a large finite value there.
  if [ "${BASH_VERSINFO[0]}" -gt 4 ] 2>/dev/null || \
     { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -ge 3 ]; } 2>/dev/null
  then
    HISTSIZE=-1
    HISTFILESIZE=-1
  else
    HISTSIZE=1000000
    HISTFILESIZE=1000000
  fi

  HISTCONTROL=ignorespace          # not ignoredups: that discards entries
  HISTTIMEFORMAT='%F %T '          # also makes bash write timestamps to file

  # Flush after every command; append to any existing PROMPT_COMMAND rather than replacing it.
  case "$PROMPT_COMMAND" in
    *history\ -a*) : ;;
    "")            PROMPT_COMMAND='history -a' ;;
    *)             PROMPT_COMMAND="${PROMPT_COMMAND%;}; history -a" ;;
  esac
  # Live cross-terminal sharing: 'history -a; history -c; history -r' instead.

fi

# --- 5. History backup -------------------------------------------------------
# Append-only settings protect against clobbering, not truncation or
# corruption (full disk, interrupted write, a stray `>` redirect). One dated
# snapshot per day, 30 kept; costs nothing after the first shell of the day.
_wk_hb_dir="${HISTBACKUP_DIR:-$HOME/.history-backups}"
if [ -s "$HISTFILE" ]; then
  _wk_hb_file="$_wk_hb_dir/$(basename "$HISTFILE").$(date +%Y%m%d)"
  if [ ! -f "$_wk_hb_file" ]; then
    if mkdir -p "$_wk_hb_dir" 2>/dev/null; then
      cp -p "$HISTFILE" "$_wk_hb_file" 2>/dev/null
      # Prune to the 30 newest; -t is supported by both BSD and GNU ls.
      ls -1t "$_wk_hb_dir"/ 2>/dev/null | tail -n +31 | while IFS= read -r _wk_f; do
        rm -f "$_wk_hb_dir/$_wk_f"
      done
    fi
  fi
  unset _wk_hb_file
fi
unset _wk_hb_dir _wk_f

# --- 5b. Prompt --------------------------------------------------------------
# Shows which machine, what it currently *is* (workstation / bench system /
# shared build box / workspace), where you are, and what git thinks -- none of
# it is in zsh's default prompt, and mixing any of them up costs real time.
#
# Runs before every command, so: nothing that forks unless it must
# (machine/role/workspace read once at source time; git branch from
# .git/HEAD, not `git`), and nothing that can block (no ssh, no podman, above
# all no `wk status`, which walks the fleet over the network).
#
# What this machine is, from local evidence only, most-specific marker first:
#   ~/.wk-workspace   this machine *is* a workspace, and names it (lib/target.sh)
#   ~/.wk-remote      the far end of a remote target: a shared build box
#   /etc/wk-image     a system wk built and booted for measuring -- the same
#                     marker `wk boot --status` reads, so the prompt agrees with it
_wk_ps_role=host
_wk_ps_name=$( { hostname -s 2>/dev/null || echo '?'; } | tr '[:upper:]' '[:lower:]' )
_wk_ps_ws=""
if [ -f "$HOME/.wk-workspace" ]; then
  _wk_ps_role=ws
  _wk_ps_ws=$(sed -n 's/^name=//p' "$HOME/.wk-workspace" 2>/dev/null | tail -1)
  [ -n "$_wk_ps_ws" ] || _wk_ps_ws="${WK_WORKSPACE:-workspace}"
  _wk_ps_name="$_wk_ps_ws"
elif [ -f "$HOME/.wk-remote" ]; then
  _wk_ps_role=shared
elif [ -f /etc/wk-image ]; then
  _wk_ps_role=bench
fi

# targets/local.sh keeps its build record in XDG state (the host's isn't
# visible from in here); only a workspace has one, read as one small file.
_wk_ps_build=""
[ "$_wk_ps_role" = ws ] && \
  _wk_ps_build="${XDG_STATE_HOME:-$HOME/.local/state}/wk/ws/$_wk_ps_ws/build.status"

if [ -n "$ZSH_VERSION" ]; then
  setopt PROMPT_SUBST
  # zstat, so the index size below costs no process. Must survive being absent too.
  zmodload zsh/stat 2>/dev/null || true

  # Fish-style path: every component but the last cut to its first letter,
  # only once the whole thing crowds the line -- a wrap is worse than an
  # abbreviation, and the last component is what's being worked in.
  _wk_ps_cwd() {
    local p=${PWD/#$HOME/'~'}
    if (( ${#p} <= 38 )); then print -rn -- "$p"; return; fi
    local -a seg=("${(@s:/:)p}")
    local i n=$#seg out=""
    for (( i = 1; i <= n; i++ )); do
      if (( i == n )) || (( ${#seg[i]} <= 1 )); then out+="${seg[i]}"
      else out+="${seg[i][1]}"; fi
      (( i < n )) && out+="/"
    done
    print -rn -- "$out"
  }

  # Branch read from .git/HEAD rather than asked of `git rev-parse` (two
  # processes and a lock). Walks up since a prompt is often several
  # directories inside the checkout; follows `gitdir:` for a worktree/submodule.
  #
  # Dirtiness is the expensive half, spelled honestly: `*` means git was asked
  # and said yes, `?` means the index was too big to check before every
  # prompt -- as in a WebKit checkout (~50 MB index; `git diff` there is
  # seconds, not milliseconds). Never a blank where a `*` might belong.
  _wk_ps_git() {
    local d=$PWD g="" head br dirty="" l
    while [[ -n $d ]]; do
      [[ -e $d/.git ]] && { g=$d/.git; break; }
      d=${d%/*}
    done
    [[ -n $g ]] || return 0
    if [[ -f $g ]]; then
      read -r l < $g
      g=${l#gitdir: }
      [[ $g == /* ]] || g=$d/$g
    fi
    [[ -r $g/HEAD ]] || return 0
    read -r head < $g/HEAD
    case $head in
      ref:*) br=${head##*/} ;;
      *)     br="detached ${head[1,8]}" ;;
    esac
    if [[ -r $g/index ]]; then
      local -a st
      if zstat -A st +size $g/index 2>/dev/null && (( st[1] < 20971520 )); then
        command git diff --quiet --ignore-submodules HEAD -- 2>/dev/null || dirty='*'
      else
        dirty='?'
      fi
    fi
    print -rn -- " %F{magenta}${br}${dirty}%f"
  }

  # `running` in the build-status file is a claim, not a fact -- lib/detach.sh
  # adjudicates it; this just echoes the file's own word, `wk status` verifies it.
  _wk_ps_buildmark() {
    [[ -n $_wk_ps_build && -r $_wk_ps_build ]] || return 0
    local state="" config="" l
    while IFS= read -r l; do
      case $l in
        state=*)  state=${l#state=} ;;
        config=*) config=${l#config=} ;;
      esac
    done < $_wk_ps_build
    [[ $state == running ]] || return 0
    print -rn -- " %F{yellow}building ${config}%f"
  }

  # host green, bench red, shared/workspace blue: the two that are someone
  # else's machine or sandbox match, and "this reboot is a measurement" stands out.
  case $_wk_ps_role in
    bench)  _wk_ps_hue=red ;;
    ws)     _wk_ps_hue=blue ;;
    shared) _wk_ps_hue=blue ;;
    *)      _wk_ps_hue=green ;;
  esac

  # %(?..) is zsh's own last-exit-code test; a green arrow over a failed command would lie.
  PROMPT='%F{cyan}${_wk_ps_name}%f:%F{${_wk_ps_hue}}${_wk_ps_role}%f $(_wk_ps_cwd)$(_wk_ps_git)$(_wk_ps_buildmark)%(?.. %F{red}exit %?%f) %(!.#.❯) '
fi

if [ -n "$BASH_VERSION" ]; then
  # Fallback for a machine with no zsh (this rc execs zsh when it finds one,
  # so this is boards and stripped images). bash can't run this without a
  # subshell per prompt, so only the branch is worth the fork.
  _wk_ps_bash_git() {
    local d=$PWD g="" head
    while [ -n "$d" ]; do
      [ -e "$d/.git" ] && { g="$d/.git"; break; }
      d=${d%/*}
    done
    [ -n "$g" ] || return 0
    [ -f "$g" ] && g=$(sed -n 's/^gitdir: //p' "$g")
    [ -r "$g/HEAD" ] || return 0
    head=$(cat "$g/HEAD")
    case $head in
      ref:*) printf ' %s' "${head##*/}" ;;
      *)     printf ' detached %s' "$(printf '%s' "$head" | cut -c1-8)" ;;
    esac
  }
  PS1='\[\033[36m\]'"$_wk_ps_name"'\[\033[0m\]:'"$_wk_ps_role"' \w$(_wk_ps_bash_git) \$ '
fi

fi  # _WK_INTERACTIVE
unset _WK_INTERACTIVE

# --- 6. Editor and PATH ------------------------------------------------------
# Deliberately minimal. This file sets up history and shell behaviour and
# nothing else -- build configuration, job counts and toolchain paths belong to
# `wk` and to the workspace, not to every interactive shell on the host.

# A machine that already exports one keeps it: on a shared build box this rc is
# sourced into somebody's existing login environment, and overwriting what their
# own profile set is not this file's business. Only the default is ours.
if [ -z "${EDITOR:-}" ]; then
  if command -v hx >/dev/null 2>&1; then
    EDITOR=hx
  elif command -v vim >/dev/null 2>&1; then
    EDITOR=vim
  else
    EDITOR=vi
  fi
fi
export EDITOR
: "${VISUAL:=$EDITOR}"
export VISUAL

# lazygit sits beside helix (container/firstrun.sh) with no home inside it:
# helix's `:sh`/`:!` capture output rather than attaching a terminal, so `lg`
# means suspend or switch to a second terminal instead. See container/helix/README.md.
command -v lazygit >/dev/null 2>&1 && alias lg=lazygit

# What goes on PATH is shell/path.sh's decision, not this file's: a container
# exec reads no rc file and needs the same answer (container/proxy/ensure-bridge.sh).
WK_TOOLS_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")/.." 2>/dev/null && pwd)"
[ -z "$WK_TOOLS_DIR" ] || . "$WK_TOOLS_DIR/shell/path.sh"
unset WK_TOOLS_DIR

# Scroll-back-clearing clear.
alias clear="clear && printf '\033[3J'"

# --- 6b. The agents' credentials ---------------------------------------------
# A workspace the host has given a credential starts able to use it: no /login,
# no browser, and no login Keychain -- which a macOS guest reached over ssh, or
# through an editor's remote server, does not have unlocked anyway. `wk key set
# <name>` stores one; each target driver puts it here, and this is its only
# reader.
#
# Each file holds the raw value and nothing else, so a container can make it a
# symlink onto the read-only /secrets mount and pick up a rotation without being
# rebuilt. A dangling symlink is simply "not set", and so is no file: a
# workspace without the Claude token asks the person to /login, which still
# works, and one without the LiteLLM key has a pi that cannot reach that
# endpoint.
#
# The pairs are spelled out here rather than read from wk_agent_secrets
# (lib/store.sh): this rc is sourced by every shell on every machine in the
# fleet, including ones with no store to read and no wk library sourced, and it
# forks nothing -- tests/test_pi_agent.py holds the two lists to each other.
for _wk_sec in .wk-agent-token:CLAUDE_CODE_OAUTH_TOKEN .wk-litellm-key:LITELLM_API_KEY; do
  _wk_sec_file="$HOME/${_wk_sec%%:*}"
  _wk_sec_var="${_wk_sec#*:}"
  [ -r "$_wk_sec_file" ] || continue
  while IFS= read -r _wk_sec_val; do
    case $_wk_sec_val in
      "" | \#*) ;;
      *) export "$_wk_sec_var=$_wk_sec_val"; break ;;
    esac
  done < "$_wk_sec_file"
done
unset _wk_sec _wk_sec_file _wk_sec_var _wk_sec_val

# The claude.ai login credential is a file the Claude CLI rewrites in place,
# not a value (README.md, "wk key set"), so it is not exported: the CLI is
# pointed at the one directory every container on this machine shares
# (wk_agent_rw_dir, lib/store.sh), which is also where its own
# `.storage-write` lock goes. The directory and not a symlink into it: the CLI
# writes through a temp file and a rename, which would replace the symlink
# with a private copy on the first refresh.
#
# Set only where a mount put one: this rc is read on every machine in the
# fleet, and naming a directory on a workstation would send the person's own
# `claude` looking for a Keychain item under a name nothing wrote.
if [ -d /agent-rw ]; then
  export CLAUDE_SECURESTORAGE_CONFIG_DIR=/agent-rw
fi

# --- 7. Completion -----------------------------------------------------------
# After PATH (section 6) so `command -v wk` sees it; interactive only, like
# history/prompt above (re-checked since section 5b already unset $_WK_INTERACTIVE).
# One command generates both shells' scripts (`wk completion bash`/`zsh`);
# this just picks which to ask for and evals it.
case $- in
  *i*)
    if command -v wk >/dev/null 2>&1; then
      if [ -n "$ZSH_VERSION" ]; then
        eval "$(wk completion zsh 2>/dev/null)"
      elif [ -n "$BASH_VERSION" ]; then
        eval "$(wk completion bash 2>/dev/null)"
      fi
    fi
    ;;
esac
