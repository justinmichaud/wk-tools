#!/bin/sh
# wk-tools/bashrc — shared rc, sourced by BOTH bash and zsh.
#
# Must stay POSIX-clean at the top level; shell-specific code goes inside the
# $BASH_VERSION / $ZSH_VERSION guards below.
#
# Escape hatches:
#   NO_ZSH=1 bash     -> stay in bash
#   HISTFILE=...      -> override history location (set before sourcing)

# =============================================================================
# 0. Interactive-only guard
# =============================================================================
# ~/.bashrc is sourced non-interactively in some contexts (ssh with
# SSH_SOURCE_BASHRC, some scp/rsync setups). Anything below would corrupt those
# sessions, so bail early. No bare `return` here: it errors under zsh when the
# file isn't sourced, and would skip the rest of a shared rc anyway.
case $- in
  *i*) _WK_INTERACTIVE=1 ;;
  *)   _WK_INTERACTIVE=  ;;
esac

if [ -n "$_WK_INTERACTIVE" ]; then

# =============================================================================
# 0b. Unknown TERM fallback (kitty and friends, over ssh)
# =============================================================================
# kitty (also wezterm, alacritty in some configs) sets TERM to its own name
# locally. ssh forwards that string as-is, and unless the remote got that
# terminal's terminfo installed -- `kitten ssh` does this automatically, a
# plain `ssh` never does -- the remote's terminfo database has no entry for
# it. Every program that asks terminfo for a key's escape sequence instead of
# hardcoding one, zsh's line editor among them, gets nothing back and falls
# through to some default that generally isn't the right one. That's the
# whole "Backspace prints ^H", "Delete does nothing" family of complaints, and
# it hits every workspace and Pi this rc gets sourced on, not just this host.
#
# xterm-256color ships on essentially everything and is close enough to what
# these terminals actually speak (they all still understand the classic xterm
# escape sequences unless you've turned on a terminal-specific protocol) that
# falling back to it fixes every such program at once, rather than one
# bindkey at a time.
if ! infocmp "$TERM" >/dev/null 2>&1; then
  export TERM=xterm-256color
fi

# =============================================================================
# 1. Switch bash -> zsh
# =============================================================================
# Skipped entirely under zsh (no $BASH_VERSION), which is what keeps `shopt`
# from blowing up when ~/.zshrc sources this file.
#
# Also skipped for TERM=dumb and Emacs subshells, where zsh's line editor and
# prompt escapes break shell-mode / tramp.

if [ -n "$BASH_VERSION" ] \
   && [ -z "$BASH_TO_ZSH_GUARD" ] \
   && [ -z "$NO_ZSH" ] \
   && [ "$TERM" != "dumb" ] \
   && [ -z "$INSIDE_EMACS" ] \
   && [ -t 0 ]
then
  # Find zsh. command -v first (Nix, ~/.local, source builds, asdf), then the
  # usual install paths — Homebrew is often absent from PATH under a stripped
  # SSH environment before ~/.zprofile has run.
  _wk_zsh=""
  for _wk_c in \
    "$(command -v zsh 2>/dev/null)" \
    /opt/homebrew/bin/zsh \
    /usr/local/bin/zsh \
    /usr/bin/zsh \
    /bin/zsh
  do
    if [ -n "$_wk_c" ] && [ -x "$_wk_c" ]; then _wk_zsh="$_wk_c"; break; fi
  done
  unset _wk_c

  if [ -n "$_wk_zsh" ]; then
    export BASH_TO_ZSH_GUARD=1
    export SHELL="$_wk_zsh"

    # Login-shell semantics. On macOS every Terminal.app/iTerm2 tab is a login
    # shell, so `exec zsh -l` would re-run /usr/libexec/path_helper via
    # /etc/zprofile after /etc/profile already ran it for bash. path_helper
    # rebuilds PATH with system paths first, shoving wk-tools and any local
    # JSC build behind /usr/bin. So: login semantics on Linux, plain exec on
    # Darwin, and let ~/.zshrc own PATH there.
    if [ "$(uname -s)" = "Darwin" ]; then
      exec "$_wk_zsh"
    elif shopt -q login_shell; then
      exec "$_wk_zsh" -l
    else
      exec "$_wk_zsh"
    fi

    # Only reached if exec failed — stay in bash rather than leaving a broken
    # guard in the environment.
    unset BASH_TO_ZSH_GUARD
  fi
  unset _wk_zsh
fi

# =============================================================================
# 2. History — shared settings
# =============================================================================
# Keep HISTFILE on local disk. If wk-tools is synced (git, Dropbox, iCloud),
# a history file inside it will be clobbered by concurrent writes from two
# machines — the single most reliable way to lose history.
: "${HISTFILE:=$HOME/.${_WK_SHELL_NAME:-sh}_history}"

if [ -n "$ZSH_VERSION" ]; then
  HISTFILE="$HOME/.zsh_history"
elif [ -n "$BASH_VERSION" ]; then
  HISTFILE="$HOME/.bash_history"
fi

# =============================================================================
# 3. History — zsh
# =============================================================================
if [ -n "$ZSH_VERSION" ]; then

  # HISTSIZE is the in-memory list, SAVEHIST the on-disk one. HISTSIZE must be
  # >= SAVEHIST or the file gets truncated to the smaller value on every write.
  # Keep HISTSIZE larger to leave headroom.
  HISTSIZE=1200000
  SAVEHIST=1000000

  # macOS ships an /etc/zshrc that sets HISTFILE/HISTSIZE/SAVEHIST to small
  # values. It runs before ~/.zshrc, so these assignments win — but only if
  # this file is actually sourced from ~/.zshrc. Verify that.

  setopt EXTENDED_HISTORY        # write timestamp + duration per entry
  setopt APPEND_HISTORY          # append at exit, never truncate the file
  setopt INC_APPEND_HISTORY_TIME # write each command as it finishes, not at
                                 # exit — survives kill -9, crashes, reboots,
                                 # and closing the terminal with the X button
  setopt HIST_FCNTL_LOCK         # fcntl() locking: correct and fast when many
                                 # shells write concurrently
  setopt HIST_VERIFY             # expand !! etc. onto the line, don't run blind
  setopt HIST_IGNORE_SPACE       # leading space = deliberate omission (secrets)
  setopt HIST_FIND_NO_DUPS       # dedupe search results only, not the file

  # Explicitly off. Each of these deletes entries, which contradicts the goal.
  unsetopt HIST_IGNORE_ALL_DUPS
  unsetopt HIST_SAVE_NO_DUPS
  unsetopt HIST_EXPIRE_DUPS_FIRST
  unsetopt HIST_IGNORE_DUPS

  # SHARE_HISTORY is the alternative to INC_APPEND_HISTORY_TIME: it also
  # imports other shells' commands live, so up-arrow in one terminal walks
  # through what you typed in another. Nothing is lost either way. To switch:
  #     unsetopt INC_APPEND_HISTORY_TIME; setopt SHARE_HISTORY
  unsetopt SHARE_HISTORY

  # Backspace and Delete, bound explicitly rather than left to zle's
  # terminfo-derived defaults. The TERM fallback above covers "no entry at
  # all"; this covers the other failure mode, a terminfo entry that's present
  # but wrong for what the terminal actually sends -- e.g. a remote where
  # `kbs` is still the historical ^H while kitty (and every other terminal in
  # practice) sends ^? for Backspace. `bindkey` here always wins over
  # whatever zle picked from terminfo at startup, so this is redundant with a
  # correct terminfo entry and load-bearing without one.
  bindkey "^?"    backward-delete-char  # Backspace
  bindkey "^H"    backward-delete-char  # Backspace, terminals/ttys still on kbs=^H
  bindkey "^[[3~" delete-char           # Delete
  bindkey "^[[H"  beginning-of-line     # Home
  bindkey "^[[1~" beginning-of-line     # Home, older xterm encoding
  bindkey "^[[F"  end-of-line           # End
  bindkey "^[[4~" end-of-line           # End, older xterm encoding

fi

# =============================================================================
# 4. History — bash
# =============================================================================
# Reached on hosts with no zsh installed, or under NO_ZSH=1.
if [ -n "$BASH_VERSION" ]; then

  shopt -s histappend   # append, don't overwrite — without this the last shell
                        # to exit wins and clobbers every other session
  shopt -s cmdhist      # multi-line command -> one history entry
  shopt -s lithist      # ...preserving real newlines instead of semicolons

  # Unlimited needs bash 4.3+. macOS system bash is 3.2, where -1 is not
  # understood, so fall back to a large finite value there.
  if [ "${BASH_VERSINFO[0]}" -gt 4 ] 2>/dev/null || \
     { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -ge 3 ]; } 2>/dev/null
  then
    HISTSIZE=-1
    HISTFILESIZE=-1
  else
    HISTSIZE=1000000
    HISTFILESIZE=1000000
  fi

  HISTCONTROL=ignorespace          # not ignoredups: that discards entries
  HISTTIMEFORMAT='%F %T '          # also makes bash write timestamps to file

  # Flush after every command. Append `history -a` to any existing
  # PROMPT_COMMAND rather than replacing it.
  case "$PROMPT_COMMAND" in
    *history\ -a*) : ;;
    "")            PROMPT_COMMAND='history -a' ;;
    *)             PROMPT_COMMAND="${PROMPT_COMMAND%;}; history -a" ;;
  esac
  # For live cross-terminal sharing (bash's rough SHARE_HISTORY equivalent),
  # use 'history -a; history -c; history -r' instead.

fi

# =============================================================================
# 5. History backup
# =============================================================================
# Append-only settings protect against clobbering, not against a truncated or
# corrupted file (full disk, interrupted write, a stray `> ~/.zsh_history`).
# One dated snapshot per day, 30 kept. Runs at shell start, costs nothing after
# the first shell of the day.
_wk_hb_dir="${HISTBACKUP_DIR:-$HOME/.history-backups}"
if [ -s "$HISTFILE" ]; then
  _wk_hb_file="$_wk_hb_dir/$(basename "$HISTFILE").$(date +%Y%m%d)"
  if [ ! -f "$_wk_hb_file" ]; then
    if mkdir -p "$_wk_hb_dir" 2>/dev/null; then
      cp -p "$HISTFILE" "$_wk_hb_file" 2>/dev/null
      # Prune all but the 30 newest. Names are dated, so no spaces to worry
      # about. -t is supported by both BSD and GNU ls.
      ls -1t "$_wk_hb_dir"/ 2>/dev/null | tail -n +31 | while IFS= read -r _wk_f; do
        rm -f "$_wk_hb_dir/$_wk_f"
      done
    fi
  fi
  unset _wk_hb_file
fi
unset _wk_hb_dir _wk_f

# =============================================================================
# 5b. Prompt
# =============================================================================
# What a shell here has to answer before anything is typed: which machine this
# is, what that machine currently *is* (a workstation, a machine booted into a
# bench system, a shared build box, or a workspace), where you are, and what git
# thinks of it. Every one of those has been got wrong at a terminal -- a build
# started on the wrong machine, a benchmark run against a host install, an edit
# made in the wrong checkout of the same repository -- and none of them is
# visible in zsh's default prompt.
#
# Two rules, because this runs before every command:
#
#   Nothing that forks unless it must. The machine, the role and the workspace
#   are read once when this file is sourced -- none of them can change under a
#   running shell -- and the git branch is read out of .git/HEAD rather than
#   asked of git.
#
#   Nothing that can block. No ssh, no podman, and above all no `wk status`:
#   that command walks the fleet over the network, and a prompt that waits on a
#   radio-linked phone is a terminal you cannot type in.

# What this machine is, from local evidence only:
#
#   ~/.wk-workspace   this machine *is* a workspace, and names it (lib/target.sh)
#   ~/.wk-remote      the far end of a remote target: a shared build box
#   /etc/wk-image     a system wk built and booted for measuring -- the same
#                     marker `wk boot --status` reads, so the prompt cannot
#                     disagree with it about which mode a machine is in
#
# In that order, because they are increasingly less specific about what the
# shell is sitting in.
_wk_ps_role=host
_wk_ps_name=$( { hostname -s 2>/dev/null || echo '?'; } | tr '[:upper:]' '[:lower:]' )
_wk_ps_ws=""
if [ -f "$HOME/.wk-workspace" ]; then
  _wk_ps_role=ws
  _wk_ps_ws=$(sed -n 's/^name=//p' "$HOME/.wk-workspace" 2>/dev/null | tail -1)
  [ -n "$_wk_ps_ws" ] || _wk_ps_ws="${WK_WORKSPACE:-workspace}"
  _wk_ps_name="$_wk_ps_ws"
elif [ -f "$HOME/.wk-remote" ]; then
  _wk_ps_role=shared
elif [ -f /etc/wk-image ]; then
  _wk_ps_role=bench
fi

# Where a build in *this* workspace records itself (targets/local.sh keeps its
# own store in XDG state, because the host's is not visible from in here). Only
# a workspace has one, and reading it is one small file rather than a command.
_wk_ps_build=""
[ "$_wk_ps_role" = ws ] && \
  _wk_ps_build="${XDG_STATE_HOME:-$HOME/.local/state}/wk/ws/$_wk_ps_ws/build.status"

if [ -n "$ZSH_VERSION" ]; then
  # The line editor's keymap, chosen here rather than inherited.
  #
  # zsh picks vi mode when $EDITOR or $VISUAL contains "vi" -- so which keymap
  # you get depends on which editor happens to be installed on the machine. On
  # this Mac helix is absent, section 6 below falls through to `vim`, and zsh
  # therefore came up in *viins*, where ^A and ^E are `self-insert`: they type a
  # character instead of moving to the start or end of the line. The same rc on
  # a machine with helix gives emacs bindings, so the two behave differently for
  # a reason nothing on screen mentions (in Zed's terminal `bindkey -lL main`
  # answers `bindkey -A viins main`).
  #
  # So it is stated. WK_ZSH_VI=1 for anyone who wants the other one.
  if [ -z "${WK_ZSH_VI:-}" ]; then bindkey -e; else bindkey -v; fi

  setopt PROMPT_SUBST
  # zstat, so the index size below costs no process. Absent on nothing this runs
  # on, but the prompt must survive it being absent anyway.
  zmodload zsh/stat 2>/dev/null || true

  # The path, fish-style: every component but the last cut to its first letter,
  # and only once the whole thing is long enough to crowd the line. A prompt
  # that wraps is worse than a prompt that abbreviates -- and the last component
  # is the one being worked in, so it stays whole.
  _wk_ps_cwd() {
    local p=${PWD/#$HOME/'~'}
    if (( ${#p} <= 38 )); then print -rn -- "$p"; return; fi
    local -a seg=("${(@s:/:)p}")
    local i n=$#seg out=""
    for (( i = 1; i <= n; i++ )); do
      if (( i == n )) || (( ${#seg[i]} <= 1 )); then out+="${seg[i]}"
      else out+="${seg[i][1]}"; fi
      (( i < n )) && out+="/"
    done
    print -rn -- "$out"
  }

  # The branch, read rather than asked: `git rev-parse` is two processes and a
  # lock, and .git/HEAD is one line. Walks up because a prompt is often several
  # directories inside the checkout, and follows the `gitdir:` indirection so a
  # worktree and a submodule answer too.
  #
  # Dirtiness is the expensive half and is spelled honestly: `*` means git was
  # asked and said yes, and `?` means it was not asked at all because the index
  # is too big to walk before every prompt -- which is precisely the case in a
  # WebKit checkout (a ~50 MB index; `git diff` there is seconds, not
  # milliseconds). Never a blank where a `*` might belong.
  _wk_ps_git() {
    local d=$PWD g="" head br dirty="" l
    while [[ -n $d ]]; do
      [[ -e $d/.git ]] && { g=$d/.git; break; }
      d=${d%/*}
    done
    [[ -n $g ]] || return 0
    if [[ -f $g ]]; then
      read -r l < $g
      g=${l#gitdir: }
      [[ $g == /* ]] || g=$d/$g
    fi
    [[ -r $g/HEAD ]] || return 0
    read -r head < $g/HEAD
    case $head in
      ref:*) br=${head##*/} ;;
      *)     br="detached ${head[1,8]}" ;;
    esac
    if [[ -r $g/index ]]; then
      local -a st
      if zstat -A st +size $g/index 2>/dev/null && (( st[1] < 20971520 )); then
        command git diff --quiet --ignore-submodules HEAD -- 2>/dev/null || dirty='*'
      else
        dirty='?'
      fi
    fi
    print -rn -- " %F{magenta}${br}${dirty}%f"
  }

  # A build running in this workspace, from the status file the build itself
  # wrote. `running` in that file is a claim rather than a fact -- lib/detach.sh
  # is what adjudicates it, and this prompt is not going to -- so the word shown
  # is the file's own and `wk status` remains the place that checks.
  _wk_ps_buildmark() {
    [[ -n $_wk_ps_build && -r $_wk_ps_build ]] || return 0
    local state="" config="" l
    while IFS= read -r l; do
      case $l in
        state=*)  state=${l#state=} ;;
        config=*) config=${l#config=} ;;
      esac
    done < $_wk_ps_build
    [[ $state == running ]] || return 0
    print -rn -- " %F{yellow}building ${config}%f"
  }

  # host green, bench red, a shared box and a workspace blue: the two that are
  # somebody else's machine or somebody else's sandbox read the same, and the
  # one that means "this reboot is a measurement" does not read like the others.
  case $_wk_ps_role in
    bench)  _wk_ps_hue=red ;;
    ws)     _wk_ps_hue=blue ;;
    shared) _wk_ps_hue=blue ;;
    *)      _wk_ps_hue=green ;;
  esac

  # %(?..) is zsh's own "last command failed": the code is worth having and a
  # green arrow over a failed command is not. Everything else in the line is a
  # fact about where you are.
  PROMPT='%F{cyan}${_wk_ps_name}%f:%F{${_wk_ps_hue}}${_wk_ps_role}%f $(_wk_ps_cwd)$(_wk_ps_git)$(_wk_ps_buildmark)%(?.. %F{red}exit %?%f) %(!.#.❯) '
fi

if [ -n "$BASH_VERSION" ]; then
  # The fallback, for a machine with no zsh (`shell/bashrc` execs zsh when it
  # finds one, so this is the boards and the odd stripped image). Same facts,
  # fewer of them: bash has no way to run this without a subshell per prompt, so
  # only the branch is worth the fork and the dirty check is not.
  _wk_ps_bash_git() {
    local d=$PWD g="" head
    while [ -n "$d" ]; do
      [ -e "$d/.git" ] && { g="$d/.git"; break; }
      d=${d%/*}
    done
    [ -n "$g" ] || return 0
    [ -f "$g" ] && g=$(sed -n 's/^gitdir: //p' "$g")
    [ -r "$g/HEAD" ] || return 0
    head=$(cat "$g/HEAD")
    case $head in
      ref:*) printf ' %s' "${head##*/}" ;;
      *)     printf ' detached %s' "$(printf '%s' "$head" | cut -c1-8)" ;;
    esac
  }
  PS1='\[\033[36m\]'"$_wk_ps_name"'\[\033[0m\]:'"$_wk_ps_role"' \w$(_wk_ps_bash_git) \$ '
fi

fi  # _WK_INTERACTIVE
unset _WK_INTERACTIVE

# =============================================================================
# 6. Editor and PATH
# =============================================================================
# Deliberately minimal. This file sets up history and shell behaviour and
# nothing else -- build configuration, job counts and toolchain paths belong to
# `wk` and to the workspace, not to every interactive shell on the host.
#
# In particular this file no longer sources webkit-container-sdk's
# register-sdk-on-host.sh: it was unconditional, so every shell on a machine
# without that checkout printed an error. The SDK now runs inside the VM.

if command -v hx >/dev/null 2>&1; then
  EDITOR=hx
elif command -v vim >/dev/null 2>&1; then
  EDITOR=vim
else
  EDITOR=vi
fi
export EDITOR
export VISUAL="$EDITOR"

# Put `wk` on PATH, without disturbing anything already there. $HOME itself is
# deliberately not on PATH.
_wk_bin="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")/.." 2>/dev/null && pwd)"
case ":$PATH:" in
  *":$_wk_bin:"*) : ;;
  *) [ -n "$_wk_bin" ] && [ -x "$_wk_bin/wk" ] && PATH="$_wk_bin:$PATH" ;;
esac
# The small helpers that only make sense inside a workspace -- strip-addresses,
# show-profiled-functions, git-clean, commit-count, git-sync-fork. They were
# restored as scripts rather than verbs precisely so the checkout can see them,
# which only works if they are on PATH.
case ":$PATH:" in
  *":$_wk_bin/container/bin:"*) : ;;
  *) [ -n "$_wk_bin" ] && [ -d "$_wk_bin/container/bin" ] && PATH="$_wk_bin/container/bin:$PATH" ;;
esac
unset _wk_bin
export PATH

# Scroll-back-clearing clear.
alias clear="clear && printf '\033[3J'"

# =============================================================================
# 7. Completion
# =============================================================================
# After PATH (section 6), so `command -v wk` sees what that section just put
# there. Interactive only, like the history and prompt settings above -- a
# completion table means nothing to a script, and re-checked rather than
# reusing $_WK_INTERACTIVE, which section 5b already unset.
#
# One command generates both shells' scripts (`wk completion bash`/`zsh`,
# cmd/completion) -- this just decides which to ask for and evals it, so a
# workspace shell picks it up exactly the same way a host shell does.
case $- in
  *i*)
    if command -v wk >/dev/null 2>&1; then
      if [ -n "$ZSH_VERSION" ]; then
        eval "$(wk completion zsh 2>/dev/null)"
      elif [ -n "$BASH_VERSION" ]; then
        eval "$(wk completion bash 2>/dev/null)"
      fi
    fi
    ;;
esac
