#!/bin/bash
# Root via a NOPASSWD sudoers rule naming this exact path (polkit refuses a
# non-local session's reboot: auth_admin_keep, measured on rpi5; wk's BatchMode
# ssh has no terminal for sudo). Bounded by shape: a fixed verb list, no
# passthrough, no eval, no argument becoming part of a command line, no file
# written, nothing mounted, no path named; the sole argument any verb takes is a
# boot order matched against 0x plus at most eight hex digits, and the mailbox
# tag it reaches is fixed below, so this cannot be turned into "call any
# mailbox".

set -euo pipefail

say()  { printf 'wk-boot-priv: %s\n' "$*"; }
deny() { printf 'wk-boot-priv: REFUSED: %s\n' "$*" >&2; exit 3; }
fail() { printf 'wk-boot-priv: %s\n' "$*" >&2; exit 1; }

# set_reboot_order.
MAILBOX_TAG=0x0003808b

check_order() {
    case "${1:-}" in
        0x[0-9a-fA-F]) ;;
        0x[0-9a-fA-F][0-9a-fA-F]) ;;
        0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
        0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
        0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
        0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
        0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
        0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
        *) deny "'${1:-}' is not a boot order (0x and up to eight hex digits)" ;;
    esac
}

# What this machine can be asked, not what the verb list holds: a Pi has no
# `bless` and a Mac has neither vcmailbox nor /run/systemd, so a static yes for
# every verb is a claim three of them cannot back on any one machine. `detach`
# names the mechanism the reboot verbs use, so a caller can tell this helper from
# one whose detach macOS does not ship and whose reboot exits 0 having done nothing.
v_status() {
    say "ok"
    command -v vcmailbox >/dev/null 2>&1 && say "order=yes" || say "order=no (no vcmailbox here)"
    say "reboot=yes"
    say "detach=nohup"
    [ -d /run/systemd ] && say "tryboot=yes" || say "tryboot=no (no /run/systemd, so the flag cannot ride the reboot)"
    command -v bless >/dev/null 2>&1 && say "bless=yes" || say "bless=no (not a Mac)"
}

# One-shot: the firmware clears the register after one use.
v_order() {
    check_order "${1:-}"
    command -v vcmailbox >/dev/null 2>&1 \
        || fail "vcmailbox is not installed here, so the firmware cannot be asked"
    vcmailbox "$MAILBOX_TAG" 4 4 "$1"
}

# Detached after a delay: the reboot kills the ssh session that asked for it, and
# the teardown SIGHUPs the process group. `nohup` and not `setsid`, which macOS
# does not ship -- with setsid this verb said "rebooting in 3s" and rebooted
# nothing on every Mac, for as long as it existed.
v_reboot() {
    [ $# -eq 0 ] || deny "reboot takes no arguments"
    nohup sh -c 'sleep 3; reboot' </dev/null >/dev/null 2>&1 &
    say "rebooting in 3s"
}

# Only systemd can pass the tryboot flag (/run/systemd/reboot-param).
v_reboot_tryboot() {
    [ $# -eq 0 ] || deny "reboot-tryboot takes no arguments"
    [ -d /run/systemd ] \
        || fail "no /run/systemd here, so the tryboot flag cannot ride the reboot"
    nohup sh -c 'sleep 3; printf "0 tryboot" > /run/systemd/reboot-param && systemctl reboot' \
        </dev/null >/dev/null 2>&1 &
    say "rebooting into tryboot in 3s"
}

# macOS. Which install the firmware boots is signed into a LocalPolicy. `bless
# --help` (26.6.2, tolken) lists --user/--stdinpass under Snapshot options and
# not under Mount Mode, so this blesses with root alone and quotes what bless
# answered: whether that suffices is the platform's answer, and one run has it.
# The gate is the volume, not an argument: neither verb takes one, no credential
# is read and nothing reaches stdin, and the only volume `boot-volume` will ever
# bless is a mounted macOS system volume that is not the running one and carries
# /etc/wk-image naming a perf-macos profile -- a wk benchmark install and
# nothing else.

bench_install() {   # the one wk benchmark install mounted here, or a refusal
    local v found="" n=0
    for v in /Volumes/*; do
        [ -f "$v/System/Library/CoreServices/SystemVersion.plist" ] || continue
        [ -f "$v/etc/wk-image" ] || continue
        grep -q '^profile=perf-macos' "$v/etc/wk-image" 2>/dev/null || continue
        if [ "$(stat -f %d "$v" 2>/dev/null)" = "$(stat -f %d / 2>/dev/null)" ]; then continue; fi
        found="$v"; n=$((n + 1))
    done
    [ "$n" -eq 1 ] || deny "$n mounted wk benchmark installs; this blesses exactly one"
    printf '%s' "$found"
}

_bless() {   # <mount>
    command -v bless >/dev/null 2>&1 || fail "bless is not on this machine"
    local out rc=0
    out=$(bless --mount "$1" --setBoot 2>&1) || rc=$?
    say "bless said: ${out:-nothing}"
    [ "$rc" -eq 0 ] || fail "bless exited $rc, so the firmware was not told"
}

v_boot_volume() {
    [ $# -eq 0 ] || deny "boot-volume takes no arguments"
    local v; v=$(bench_install) || exit $?   # bench_install's deny is a subshell's
    _bless "$v"
    say "blessed $v"
}

# The way back, and the reason `wk boot` exercises it before it arms anything:
# --setBoot is sticky, so a machine sent to the benchmark install without a
# proven return is a machine that boots into it forever.
v_boot_host() {
    [ $# -eq 0 ] || deny "boot-host takes no arguments"
    _bless /
    say "blessed the running install"
}

verb="${1:-}"; shift || true
case "$verb" in
    status)         v_status ;;
    order)          v_order "$@" ;;
    reboot)         v_reboot "$@" ;;
    reboot-tryboot) v_reboot_tryboot "$@" ;;
    boot-volume)    v_boot_volume "$@" ;;
    boot-host)      v_boot_host "$@" ;;
    *) fail "usage: wk-boot-priv status|order <0xNNNN>|reboot|reboot-tryboot|boot-volume|boot-host" ;;
esac
