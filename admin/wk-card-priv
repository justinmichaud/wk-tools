#!/bin/bash
#
# The privileged half of writing a card. Runs as root via a NOPASSWD
# sudoers rule that names this exact path.
#
# Why it exists: writing a system to a card is `dd` to a block device plus
# a handful of mounts, unavailable to an unprivileged user. The machines
# with card readers are *workstations*, where sudo prompts (CLAUDE.md) --
# but a prompt cannot happen down the BatchMode ssh `wk sysimage write`
# uses, which has no terminal. So the choice is a password prompt nobody
# can answer, a blanket NOPASSWD, or this: one path, a fixed verb list, and
# a device gate that cannot be argued with. Linux cannot make a #! script
# setuid, so the sudoers rule is the mechanism, not a setuid wrapper.
#
# Everything here must be safe to grant unconditionally, because granting
# it is granting it forever:
#
#   - The verb set is a fixed allowlist. No passthrough, no eval, and no
#     argument becomes part of a command line.
#   - **Only USB and SD/MMC whole disks may be touched, ever.** Not
#     "removable" -- RM=1 is set by things that are not cards, and an
#     internal disk can present as removable. Transport is checked against
#     a two-item list instead.
#   - **A disk this machine is currently running from is refused**,
#     whatever its transport: root's disk, /boot's, /boot/firmware's, any
#     swap's, and the kernel command line's root=. On the fleet's Pis the
#     system disk *is* an SD card or USB stick, so the transport check
#     alone would happily overwrite the running machine.
#     The one carve-out is a *second system* beside a rescue
#     (`<device>@second`): a board with one medium (the rpi3) keeps its
#     rescue on partitions 1-2 and a bench system on 3-4 of the same card.
#     Under @second every verb addresses partitions 3 and 4 only, the image
#     is split into them rather than written over the disk, the disk
#     identity is never touched, and arming is one line in the rescue's
#     config.txt (os_prefix) that the bench system removes on its first boot.
#     The disk may be the one this machine runs from (the rescue writing
#     beside itself) or a card in a reader (the first write, from a
#     workstation); either way partitions 1 and 2 are never addressed.
#   - A disk with anything mounted from it is refused: a card in use is a
#     card somebody is using.
#   - Nothing is read from the environment; sudo's env_reset plus the
#     explicit PATH below means a hostile environment cannot redirect a
#     binary.
#   - Secrets (a tailscale auth key, a WiFi passphrase) arrive on stdin,
#     never as arguments, which are world-readable in /proc; the marker
#     and the ssh *public* key are arguments because neither is a secret.
#   - What arrives on stdin is data, never code: an image goes to a gated
#     device, a key to a file, a unit archive to two fixed directories under
#     /etc, each under a size bound. Nothing a caller sends is executed, and
#     no file root runs is a path a caller names.

set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

[ "$(id -u)" -eq 0 ] || { echo "wk-card-priv: must run as root" >&2; exit 1; }

say()  { printf 'wk-card-priv: %s\n' "$*"; }
deny() { printf 'wk-card-priv: REFUSED: %s\n' "$*" >&2; exit 3; }
fail() { printf 'wk-card-priv: %s\n' "$*" >&2; exit 1; }

# --- the gate ----------------------------------------------------------------

# Every disk this machine is currently running from, by kernel name. Four
# sources, since no single one is complete: findmnt knows what's mounted,
# /proc/swaps knows swap, and the kernel command line knows what firmware
# was told -- which matters when / is on an overlay or findmnt no longer
# names the real device.
booted_disks() {
    {
        findmnt -no SOURCE / 2>/dev/null || true
        findmnt -no SOURCE /boot 2>/dev/null || true
        findmnt -no SOURCE /boot/firmware 2>/dev/null || true
        awk '/^\/dev/ { print $1 }' /proc/swaps 2>/dev/null || true
        sed -n 's/.*[[:space:]]root=\([^[:space:]]*\).*/\1/p' /proc/cmdline 2>/dev/null || true
    } | while read -r src; do
        [ -n "$src" ] || continue
        case "$src" in
            PARTUUID=*) src=$(blkid -t "PARTUUID=${src#PARTUUID=}" -o device 2>/dev/null | head -1) ;;
            UUID=*)     src=$(blkid -t "UUID=${src#UUID=}"         -o device 2>/dev/null | head -1) ;;
            LABEL=*)    src=$(blkid -t "LABEL=${src#LABEL=}"       -o device 2>/dev/null | head -1) ;;
            /dev/root)  src=$(readlink -f /dev/root 2>/dev/null || true) ;;
        esac
        [ -n "$src" ] || continue
        # The parent disk of a partition, or the thing itself when it is one.
        d=$(lsblk -no PKNAME "$src" 2>/dev/null | head -1)
        [ -n "$d" ] || d=$(basename "$src")
        printf '%s\n' "$d"
    done | sort -u
}

# <device> -- leaves the validated device path in GATED_DEV, or refuses.
# Ordered cheapest-first, but every check runs before anything is written:
# this is the whole security argument for the sudoers rule.
# Which two partitions a verb addresses: the disk's own system (1 and 2), or
# a system beside it (`<device>@second`, `<device>@third`). Two shapes exist
# physically and the partition table says which this medium has
# (_slot_resolve): a card shared with a rescue carries its bench systems as
# logical pairs 5-6 and 7-8 inside an extended partition 3; a dedicated
# bench medium carries its second system as primaries 3-4 and has no third.
# Set by gate, in this shell -- which is why gate is called as a statement
# and never in a command substitution, whose subshell would keep them.
BOOTP=1; ROOTP=2; SECOND=""; SLOT=0; PFX=""; GATED_DEV=""

# The addressed pair, from the table that exists: reading verbs act on what
# is there. `write` is the one verb that changes the shape, and it re-derives
# it from the first system's role instead (_second_write).
_slot_resolve() { # <disk>
    local p3type
    # tr: sfdisk prints the type indented (" 5"), and a case pattern does
    # not trim.
    p3type=$(sfdisk --part-type "$1" 3 2>/dev/null | tr -d '[:space:]' || true)
    case "$p3type" in
        5|f|0x5|0xf|05|0f)
            BOOTP=$((3 + 2 * SLOT)); ROOTP=$((4 + 2 * SLOT)) ;;
        *)
            [ "$SLOT" -eq 1 ] || deny "'$1' carries its second system on primary partitions 3-4,
    which leaves no room for a third. The shared layout (an extended partition
    holding two systems) is made by a fresh '@second' write on a medium whose
    first system is a rescue."
            BOOTP=3; ROOTP=4 ;;
    esac
}

gate() { # <device>[@second|@third] [allow-mounted]
    local dev="${1:-}" allow_mounted="${2:-}" type tran name booted mounted
    BOOTP=1; ROOTP=2; SECOND=""; SLOT=0; PFX=""; GATED_DEV=""
    case "$dev" in
        *@second) dev="${dev%@second}"; SECOND=1; SLOT=1; PFX=second ;;
        *@third)  dev="${dev%@third}";  SECOND=1; SLOT=2; PFX=third ;;
        *@*) deny "'$dev' names a system this helper does not know; '@second' and '@third' are the two" ;;
    esac

    case "$dev" in
        /dev/*) ;;
        *) deny "'$dev' is not a /dev path" ;;
    esac
    # No globbing, no traversal, no shell metacharacters: a device name is a
    # short, boring string and anything else is someone trying something.
    case "$dev" in
        *[!a-zA-Z0-9/_-]*) deny "'$dev' contains characters a device name does not" ;;
        */../*|*/..) deny "'$dev' contains a path traversal" ;;
    esac
    [ -b "$dev" ] || deny "'$dev' is not a block device"

    read -r type tran <<EOF
$(lsblk -dno TYPE,TRAN "$dev" 2>/dev/null)
EOF
    [ "$type" = disk ] || deny "'$dev' is a '${type:-unknown}', not a whole disk.
    An image carries its own partition table, so it goes to the disk."

    # The two-item list this helper exists to enforce.
    case "$tran" in
        usb|mmc) ;;
        *) deny "'$dev' is on transport '${tran:-unknown}'. Only usb and mmc
    devices may be written by this helper -- that is the entire grant." ;;
    esac

    name=$(basename "$dev")
    booted=$(booted_disks)
    if [ -z "$SECOND" ] && printf '%s\n' "$booted" | grep -qx "$name"; then
        deny "'$dev' is a disk this machine is running from (/, /boot, swap or
    the kernel's root=). On these boards the system disk is itself an SD card or
    a USB stick, so being removable is no protection at all. A second system
    beside this one is '$dev@second'."
    fi

    [ -z "$SECOND" ] || _slot_resolve "$dev"

    # Skipped for exactly one verb -- `unmount`, whose whole purpose is to end
    # this state. The checks above it are the ones that protect the machine
    # and they are never skipped. Under @second/@third only the two partitions
    # the verb addresses are asked about: 1 and 2 may be this machine's
    # running root and boot, and leaving them alone is what the address means.
    if [ "$allow_mounted" != allow-mounted ]; then
        if [ -n "$SECOND" ]; then
            mounted=$(lsblk -no MOUNTPOINT "$(part "$dev" "$BOOTP")" "$(part "$dev" "$ROOTP")" 2>/dev/null | grep -c . || true)
            [ "${mounted:-0}" -eq 0 ] || deny "'$dev@$PFX': partitions $BOOTP and $ROOTP have $mounted mounted filesystem(s).
    A system in use is a system somebody is using; unmount it first."
        else
            mounted=$(lsblk -no MOUNTPOINT "$dev" 2>/dev/null | grep -c . || true)
            [ "${mounted:-0}" -eq 0 ] || deny "'$dev' has $mounted mounted filesystem(s) on it.
    A card in use is a card somebody is using; unmount it first."
        fi
    fi

    GATED_DEV="$dev"
}

# A partition of a validated disk: /dev/sda -> /dev/sda1, /dev/mmcblk0 -> p1.
part() {
    case "$1" in
        *[0-9]) printf '%sp%s' "$1" "$2" ;;
        *)      printf '%s%s'  "$1" "$2" ;;
    esac
}

# Arguments that end up inside files, checked against what they are allowed to
# be rather than escaped. A name that is not a name is a refusal.
check_name() {
    case "${1:-}" in
        ''|*[!a-zA-Z0-9._-]*) deny "'${1:-}' is not a usable name" ;;
    esac
}
check_b64() {
    case "${1:-}" in
        ''|*[!A-Za-z0-9+/=]*) deny "argument is not base64" ;;
    esac
}
check_hex() {
    case "${1:-}" in
        ''|*[!0-9a-fA-F]*) deny "'${1:-}' is not hex" ;;
    esac
}

# A scratch mountpoint of this helper's own making. The caller never names a
# path: "mount this device at that path" is a different and much larger grant
# than "mount this device somewhere and edit two files in it".
with_mount() { # [-r] <partition> <function> [args...]
    local ro=""
    [ "${1:-}" = -r ] && { ro="-o ro"; shift; }
    local p="$1" fn="$2"; shift 2
    local m rc; m=$(mktemp -d /run/wk-card.XXXXXX)
    # shellcheck disable=SC2086
    mount $ro "$p" "$m" || { rmdir "$m"; fail "could not mount $p"; }
    # The edit runs under a trap rather than a bare call, because the two ways
    # it can end both skip the line after it: `set -e` on a non-zero return, and
    # `fail`, which exits. Either one would otherwise leave the card mounted --
    # and a mounted card is one the gate refuses, so the next verb blames the
    # disk for the previous verb's failure.
    trap 'umount "$m" 2>/dev/null || true; rmdir "$m" 2>/dev/null || true' EXIT
    rc=0; "$fn" "$m" "$@" || rc=$?
    trap - EXIT
    umount "$m" || true
    rmdir "$m" || true
    sync
    return "$rc"
}

# --- the verbs ---------------------------------------------------------------

# What this helper can do, for a driving end that must not assume it: a
# helper on a board's rescue is the one its image was built with.
v_status() { say "ok"; say "second=yes"; say "third=yes"; say "init.d=yes"; say "tailnet-keep=yes"; }

v_check() {
    local dev; gate "${1:-}"; dev=$GATED_DEV
    say "$dev may be written: $(lsblk -dno TRAN,SIZE,MODEL "$dev" | tr -s ' ')"
}

# Image bytes on stdin. Nothing about the image is inspected here -- what makes
# this safe is *where* it can go, which the gate has already settled.
v_write() {
    local dev; gate "${1:-}"; dev=$GATED_DEV
    if [ -n "$SECOND" ]; then
        _second_write "$dev"
        return $?
    fi
    say "writing to $dev"
    dd of="$dev" bs=4M conv=fsync status=none
    sync

    # Make the kernel look at the table it was just handed: writing a whole
    # disk replaces its partition table, but the kernel keeps using what it
    # read when the disk appeared. Everything after this (lsblk, mounting
    # partition 2) asks the kernel, so without this the disk reports stale
    # partitions -- fatal and obvious if it had none, silently wrong-sized
    # if a partition happened to sit at the same offset.
    #
    # Best-effort on purpose: EBUSY here (something still holding the disk)
    # is not a reason to fail a write whose bytes are already down and
    # synced, but is reported rather than swallowed.
    if blockdev --rereadpt "$dev" 2>/dev/null; then
        say "partition table re-read"
    else
        say "could not re-read the partition table (something still holds $dev);"
        say "  the bytes are written -- the kernel's view of the partitions is stale"
    fi
    say "written"
}

_fleet_edit() { # <mountpoint> <marker> <pubkey>
    local m="$1" marker="$2" key="$3" home
    printf '%s\n' "$marker" > "$m/etc/wk-image"
    chmod 0644 "$m/etc/wk-image"; chown 0:0 "$m/etc/wk-image"

    home=$(awk -F: '$1 == "root" { print $6 }' "$m/etc/passwd" | head -1)
    case "$home" in
        /*) ;;
        *) fail "no usable root home in the image's passwd" ;;
    esac
    mkdir -p "$m$home/.ssh"
    chmod 0700 "$m$home/.ssh"
    printf '%s\n' "$key" > "$m$home/.ssh/authorized_keys"
    chmod 0600 "$m$home/.ssh/authorized_keys"
    chown -R 0:0 "$m$home/.ssh"

    # Read back: a card with a perfect marker and an empty authorized_keys
    # boots and cannot be reached, invisible from the writing side.
    grep -q . "$m/etc/wk-image" || fail "the identity marker did not land on this disk"
    grep -q '^ssh-\|^ecdsa-\|^sk-' "$m$home/.ssh/authorized_keys" \
        || fail "the driving key did not land in $home/.ssh/authorized_keys"
}

# fleet <device> <marker-base64> <ssh-public-key-base64>. base64 so that
# neither value has to survive a quoting round trip, and both can be
# checked against a character set before anything decodes them.
v_fleet() {
    local dev marker key
    gate "${1:-}"; dev=$GATED_DEV
    check_b64 "${2:-}"; check_b64 "${3:-}"
    marker=$(printf '%s' "$2" | base64 -d) || deny "marker is not valid base64"
    key=$(printf '%s' "$3" | base64 -d)     || deny "key is not valid base64"
    case "$key" in
        ssh-*|ecdsa-*|sk-*) ;;
        *) deny "that does not look like an ssh public key" ;;
    esac
    case "$marker" in
        id=*) ;;
        *) deny "a marker starts with id=" ;;
    esac
    with_mount "$(part "$dev" "$ROOTP")" _fleet_edit "$marker" "$key"
    say "identity marker and driving key installed on $dev"
}

_tailnet_edit() { # <mountpoint> <hostname> <tag> <keyfile>
    local m="$1" host="$2" tag="$3" keyfile="$4"
    [ -x "$m/usr/sbin/wk-tailnet-join" ] || {
        say "no wk-tailnet-join in this image; not seeding a key it cannot spend"
        return 0
    }
    mkdir -p "$m/etc/wk"; chmod 0755 "$m/etc/wk"
    printf 'hostname=%s\ntag=%s\n' "$host" "$tag" > "$m/etc/wk/tailnet.conf"
    chmod 0644 "$m/etc/wk/tailnet.conf"
    cat "$keyfile" > "$m/etc/wk/tailscale-authkey"
    chmod 0600 "$m/etc/wk/tailscale-authkey"
    chown -R 0:0 "$m/etc/wk"

    # What can be read back is; the key is deliberately not printed. Its
    # size and mode answer "did it land" without echoing a credential.
    grep -qx "hostname=$host" "$m/etc/wk/tailnet.conf" \
        || fail "the tailnet name did not survive the write to this disk"
    [ "$(stat -c '%a' "$m/etc/wk/tailscale-authkey")" = 600 ] \
        && [ -s "$m/etc/wk/tailscale-authkey" ] \
        || fail "the auth key did not land on this disk as a 0600 file"
}

_whose_probe() { # <mountpoint>
    local f="$1/etc/wk-image"
    if [ -r "$f" ]; then
        # Only the identifying fields this repo writes, not the whole file:
        # a verb that prints whatever it finds grows with disk content
        # rather than with what was asked for.
        sed -n 's/^\(id\|machine\|profile\|role\|builder\)=/&/p' "$f"
    else
        echo "marker: none"
    fi
}

# whose <device> -- which machine's system is on this disk, from the disk.
# Read-only, and asks the disk rather than a stored note: identity is
# written *into* it at write time (/etc/wk-image), and a second copy out
# here would go stale the first time somebody swaps a stick.
v_whose() {
    local dev; gate "${1:-}"; dev=$GATED_DEV
    with_mount -r "$(part "$dev" "$ROOTP")" _whose_probe
}

_joins_probe() { # <mountpoint>
    [ -x "$1/usr/sbin/wk-tailnet-join" ] && say "tailnet-join: yes" || say "tailnet-join: no"
}

# joins <device> -- does the system on this disk join the tailnet on first
# boot? Read-only, and a verb of its own because the answer decides whether
# the driving end resolves the fleet's auth key at all -- the key has to be
# on stdin before `tailnet` can look, so this can't be folded into it.
# Without this, an image with no wk-tailnet-join would still have the
# fleet's credential read and sent here for a disk with nothing to spend it.
v_joins() {
    local dev; gate "${1:-}"; dev=$GATED_DEV
    with_mount -r "$(part "$dev" "$ROOTP")" _joins_probe
}

# tailnet <device> <hostname> <tag>   -- the auth key arrives on stdin.
v_tailnet() {
    local dev host tag tmp rc
    gate "${1:-}"; dev=$GATED_DEV
    host="${2:-}"; tag="${3:-}"
    check_name "$host"
    case "$tag" in
        tag:[a-z0-9-]*) ;;
        *) deny "'$tag' is not a tailscale tag" ;;
    esac
    tmp=$(mktemp /run/wk-card-key.XXXXXX); chmod 0600 "$tmp"
    cat > "$tmp"
    # tskey-auth-, not tskey-: an API access token and an OAuth client secret
    # share the prefix and administer the tailnet, and this writes what it is
    # given onto a card that leaves the building (wk_tailscale_key_reject,
    # lib/common.sh, refuses the same three shapes on the way in).
    grep -q '^tskey-auth-' "$tmp" \
        || { rm -f "$tmp"; deny "that is not a tailscale auth key (they start 'tskey-auth-')"; }
    rc=0
    with_mount "$(part "$dev" "$ROOTP")" _tailnet_edit "$host" "$tag" "$tmp" || rc=$?
    rm -f "$tmp"
    [ "$rc" -eq 0 ] && say "tailnet identity seeded on $dev (joins as $host, $tag)"
    return "$rc"
}

_wifi_joins_probe() { # <mountpoint>
    [ -x "$1/usr/sbin/wk-wifi-join" ] && say "wifi-join: yes" || say "wifi-join: no"
}

# wifi-joins <device> -- does the system on this disk bring up WiFi on first
# boot? Read-only, the same shape as `joins` and for the same reason: the
# answer decides whether the driving end resolves the fleet's WiFi credential
# at all.
v_wifi_joins() {
    local dev; gate "${1:-}"; dev=$GATED_DEV
    with_mount -r "$(part "$dev" "$ROOTP")" _wifi_joins_probe
}

# A value that has to sit inside a double-quoted wpa_supplicant string,
# checked against what it's allowed to be rather than escaped (same rule
# as check_name/check_b64): a quote or backslash would let it break out of
# the string, a newline would start a second config line.
check_wifi_value() { # <what> <value>
    case "${2:-}" in
        '') deny "$1 is empty" ;;
        *[\"\\]*) deny "$1 contains a '\"' or '\\', which a wpa_supplicant conf cannot carry quoted" ;;
    esac
    case "$2" in
        *[[:cntrl:]]*) deny "$1 contains a control character" ;;
    esac
}

# The credential itself is never hand-made: it is this machine's own WiFi
# connection, read as root. Netplan is the one form read -- on these
# machines NetworkManager writes its connections as netplan
# (/etc/netplan/90-NM-*.yaml), so a netplan reader is also the
# NetworkManager reader, and there is nothing else to read besides.
# Embedded rather than a sibling file: admin/install.sh installs this helper
# alone. tests/test_wifi_seed.py lifts the python from here to test it.
# This machine's own WiFi credential, as a 0600 temp file holding ssid=/psk=,
# or returns 3. Two kinds of machine hold it two ways: a workstation in its
# netplan; a system wk wrote (a board's rescue) in the wpa_supplicant conf
# the card seeded (_wifi_edit's own format, read back the same way), which is
# what lets a rescue seed the bench medium beside it with no reader in the
# loop. Whichever this machine has; a machine with neither has no WiFi to give.
_host_wifi() {
    if ls /etc/netplan/*.yaml >/dev/null 2>&1; then
        _netplan_wifi
    else
        _wpa_conf_wifi /etc/wpa_supplicant/wpa_supplicant-wlan0.conf
    fi
}

_netplan_wifi() { # -> a 0600 temp file holding ssid=/psk=, or returns 3
    local tmp; tmp=$(mktemp /run/wk-card-wifi.XXXXXX); chmod 0600 "$tmp"
    if cat /etc/netplan/*.yaml 2>/dev/null | python3 -c '
import sys, yaml
docs = [d for d in yaml.safe_load_all(sys.stdin) if d]
for doc in docs:
    for _, dev in (doc.get("network", {}).get("wifis") or {}).items():
        for ssid, ap in (dev.get("access-points") or {}).items():
            psk = ((ap.get("auth") or {}).get("password") or ap.get("password") or "")
            if psk:
                print("ssid=%s" % ssid)
                print("psk=%s" % psk)
                sys.exit(0)
sys.exit(3)
' > "$tmp"; then
        printf '%s' "$tmp"
    else
        rm -f "$tmp"
        return 3
    fi
}

# The first network block's quoted ssid= and psk= out of a wpa_supplicant
# conf (the shape _wifi_edit writes), the same temp-file contract as
# _netplan_wifi. sed only: a rescue has no PyYAML.
_wpa_conf_wifi() { # <conf> -> a 0600 temp file holding ssid=/psk=, or returns 3
    local ssid psk tmp
    [ -r "$1" ] || return 3
    ssid=$(sed -n 's/^[[:space:]]*ssid="\(.*\)"$/\1/p' "$1" | head -1)
    psk=$(sed -n 's/^[[:space:]]*psk="\(.*\)"$/\1/p' "$1" | head -1)
    [ -n "$ssid" ] && [ -n "$psk" ] || return 3
    tmp=$(mktemp "${TMPDIR:-/run}/wk-card-wifi.XXXXXX"); chmod 0600 "$tmp"
    printf 'ssid=%s\npsk=%s\n' "$ssid" "$psk" > "$tmp"
    printf '%s' "$tmp"
}

v_wifi_host() {
    local tmp ssid
    if tmp=$(_host_wifi); then
        ssid=$(sed -n 's/^ssid=//p' "$tmp" | head -1)
        rm -f "$tmp"
        say "wifi-host: yes ssid=$ssid"
    else
        say "wifi-host: no"
    fi
}

v_wifi_from_host() {
    local dev tmp ssid psk rc
    gate "${1:-}"; dev=$GATED_DEV
    tmp=$(_host_wifi) \
        || fail "no WiFi credential on this machine (netplan, or the wpa_supplicant conf a card seeded); the write preflight (wifi-host) should have refused before $dev was touched"
    ssid=$(sed -n 's/^ssid=//p' "$tmp" | head -1)
    psk=$(sed -n 's/^psk=//p' "$tmp" | head -1)
    rm -f "$tmp"
    check_wifi_value "the SSID" "$ssid"
    check_wifi_value "the passphrase" "$psk"
    rc=0
    with_mount "$(part "$dev" "$ROOTP")" _wifi_edit "$ssid" "$psk" || rc=$?
    [ "$rc" -eq 0 ] && say "WiFi credentials seeded on $dev (ssid=$ssid)"
    return "$rc"
}

_wifi_edit() { # <mountpoint> <ssid> <psk>
    local m="$1" ssid="$2" psk="$3" d="$1/etc/wpa_supplicant" f
    f="$d/wpa_supplicant-wlan0.conf"
    mkdir -p "$d"; chmod 0755 "$d"
    {
        printf 'ctrl_interface=/var/run/wpa_supplicant\n'
        printf 'update_config=0\n\n'
        printf 'network={\n'
        printf '    ssid="%s"\n' "$ssid"
        printf '    psk="%s"\n' "$psk"
        printf '}\n'
    } > "$f"
    chmod 0600 "$f"; chown 0:0 "$f"

    # Read back, since an unlanded write is invisible from here; the
    # passphrase itself is not printed (same rule as the tailnet key).
    # Fixed-string match (-F), not a pattern: an SSID must not be read as regex.
    grep -qxF "    ssid=\"$ssid\"" "$f" \
        || fail "the SSID did not survive the write to this disk"
    [ "$(stat -c '%a' "$f")" = 600 ] && [ -s "$f" ] \
        || fail "the WiFi credential did not land on this disk as a 0600 file"
}

_id_edit() { # <mountpoint> <old> <new>
    local m="$1" old="$2" new="$3" f
    for f in "$m/cmdline.txt" "$m/current/cmdline.txt" "$m/etc/fstab"; do
        [ -f "$f" ] || continue
        sed -i "s/PARTUUID=$old-/PARTUUID=$new-/g" "$f"
    done
}

# identity <device> <old-hex> <new-hex> -- give this copy a disk identity of its
# own, so two cards written from one image cannot be confused for each other.
v_identity() {
    local dev old new
    gate "${1:-}"; dev=$GATED_DEV
    [ -z "$SECOND" ] || deny "the disk identity belongs to the system this machine runs from;
    a second system takes its PARTUUIDs from it (retarget) and never changes it"
    check_hex "${2:-}"; check_hex "${3:-}"
    old="$2"; new="$3"
    sfdisk --disk-id "$dev" "0x$new" >/dev/null
    with_mount "$(part "$dev" "$BOOTP")" _id_edit "$old" "$new"
    with_mount "$(part "$dev" "$ROOTP")" _id_edit "$old" "$new"
    say "$dev now has disk identity 0x$new"
}

# grow <device>[@second] -- the root partition to the end of the disk, and
# its filesystem to the end of the partition. Under @second `write` already
# made partition 4 reach the end of the disk, so the table step changes
# nothing and the filesystem step is the one that matters.
v_grow() {
    local dev root; gate "${1:-}"; dev=$GATED_DEV; root=$(part "$dev" "$ROOTP")
    # A logical pair (the shared layout) is already its zone's full size, and
    # 'grow to the end of the disk' would eat the system beside it.
    [ "$ROOTP" -gt 4 ] || printf ', +\n' | sfdisk -N "$ROOTP" --no-reread --force "$dev" >/dev/null
    partx -u "$dev" 2>/dev/null || partprobe "$dev" 2>/dev/null || true
    e2fsck -fy "$root" >/dev/null 2>&1 || true
    resize2fs "$root" >/dev/null 2>&1 || fail "could not resize $root"
    say "$root grown to fill $dev"
}

# unmount <device>[@second] -- every filesystem on it, so a card that was
# auto-mounted can be written. The only verb that may see mounted
# filesystems, and it still may not touch a disk the machine is running from.
# Under @second only partitions 3 and 4 are unmounted: 1 and 2 may be this
# machine's own root and boot.
v_unmount() {
    local dev p mp any=0
    gate "${1:-}" allow-mounted; dev=$GATED_DEV
    for p in $(lsblk -lno NAME "$dev" | tail -n +2); do
        if [ -n "$SECOND" ]; then
            case "/dev/$p" in "$(part "$dev" "$BOOTP")"|"$(part "$dev" "$ROOTP")") ;; *) continue ;; esac
        fi
        mp=$(lsblk -no MOUNTPOINT "/dev/$p" 2>/dev/null | head -1)
        [ -n "$mp" ] || continue
        umount "/dev/$p" || fail "could not unmount /dev/$p (was at $mp)"
        any=1
    done
    [ "$any" -eq 1 ] && say "unmounted everything on $dev" || say "nothing was mounted on $dev"
}

_role_edit() { # <mountpoint> <role>
    local m="$1" role="$2" f="$1/etc/wk-image"

    mkdir -p "$m/etc/wk"; chmod 0755 "$m/etc/wk"; chown 0:0 "$m/etc/wk"

    # The marker is the whole mechanism, and it is an absence as much as a
    # presence: every unit that hands a machine back is
    # `ConditionPathExists=!/etc/wk/rescue`. A bench card has no marker;
    # writing one removes the file rather than a second flag that could
    # disagree with the first.
    if [ "$role" = rescue ]; then
        printf 'This system is a rescue: it keeps its board reachable and is never measured.\n' \
            > "$m/etc/wk/rescue"
        chmod 0644 "$m/etc/wk/rescue"; chown 0:0 "$m/etc/wk/rescue"
    else
        rm -f "$m/etc/wk/rescue"
    fi

    # And the identity marker's own `role=`, so a board can be *asked* what
    # it is rather than inferring it from a file's presence per reader. One
    # image serves both roles, so this is where the build's stamped role and
    # the rescue file are reconciled, the only moment both facts are together.
    if [ -f "$f" ]; then
        sed -i "s/^role=.*/role=$role/" "$f"
        grep -qx "role=$role" "$f" \
            || fail "the role did not survive the write to this disk"
    else
        say "no /etc/wk-image on this disk, so there is no role field to stamp"
    fi

    # Read back, because a write that did not land is invisible from here.
    if [ "$role" = rescue ]; then
        [ -f "$m/etc/wk/rescue" ] || fail "the rescue marker did not land on this disk"
    else
        [ ! -e "$m/etc/wk/rescue" ] || fail "the rescue marker is still on this disk"
    fi
}

# role <device> <bench|rescue> -- which role the system on this card plays.
#
# A two-word vocabulary and nothing else reaches a command line, which is what
# lets this live behind the same unconditional grant as the rest: the verb can
# create or remove exactly one known path and rewrite one field of another.
v_role() {
    local dev role
    gate "${1:-}"; dev=$GATED_DEV
    role="${2:-}"
    case "$role" in
        bench|rescue) ;;
        *) deny "'$role' is not a role -- it is 'bench' or 'rescue'" ;;
    esac
    with_mount "$(part "$dev" "$ROOTP")" _role_edit "$role"
    say "$dev is a $role system"
}

# verify <device> <bytes> -- the sha256 of the first N bytes, for comparing a
# written card against the image that was streamed to it. Read-only, and the
# only thing it can read is a disk the gate already permits.
v_verify() {
    local dev bytes
    gate "${1:-}"; dev=$GATED_DEV
    case "${2:-}" in
        ''|*[!0-9]*) deny "'${2:-}' is not a byte count" ;;
    esac
    bytes="$2"
    head -c "$bytes" "$dev" | sha256sum | cut -d' ' -f1
}

v_eject() {
    local dev; gate "${1:-}"; dev=$GATED_DEV
    sync; blockdev --flushbufs "$dev" 2>/dev/null || true
    say "$dev flushed"
}

# --- every edit an image needs, made on the card ------------------------------
#
# `wk sysimage write` streams an image's own bytes onto the card and then
# makes each edit here, on the machine holding the reader: the driving end
# never opens a Linux filesystem, so it needs no mtools, no debugfs and no
# sfdisk -- none of which a macOS workstation has. Same rules as the verbs
# above: the device is gated, text arrives base64 and is checked against a
# character set, an archive arrives on stdin under a size bound, and nothing
# from a caller becomes part of a command line.

# The model of what a Pi's firmware asks of a boot tree
# (boot/check-boot-files.py in wk-tools), installed root-owned beside this
# helper: root runs it, so it may not be a path a caller names, and there is
# no second copy of the model here to drift from that one. admin/install.sh
# and the meta-wk-rescue recipe install the two together.
CHECK_BOOT_FILES=/usr/local/libexec/wk-check-boot-files.py

# This helper's own file, for the one verb that copies it onto a rescue
# (rescue-helper). $0 and not a written-down path: root runs this from the
# absolute path its sudoers rule names, so $0 *is* the installed copy, and a
# second spelling of it could name a file this one is not.
SELF="$0"

# Text that ends up inside a file on the card, checked against what it is
# allowed to be rather than escaped -- the same rule as check_name. Printable
# ASCII and whitespace only: anything else in a config.txt is not a config.txt.
check_text() { # <what> <text>
    case "${2:-}" in
        '') deny "$1 is empty" ;;
    esac
    case "$2" in
        *[![:print:][:space:]]*) deny "$1 has a character outside printable ASCII" ;;
    esac
    [ "${#2}" -le 4096 ] || deny "$1 is longer than 4096 bytes"
}

# The card's own partition table, from the card. sfdisk speaks JSON and
# python reads it: this repo does not parse JSON in bash.
_table() { # <device> -- 'signature=<hex>' and 'partitions=<n>'
    sfdisk -J "$1" 2>/dev/null | python3 -c '
import json, sys
try:
    table = json.load(sys.stdin)["partitiontable"]
except Exception:
    sys.exit(3)
sig = str(table.get("id", ""))
if sig.lower().startswith("0x"):
    sig = sig[2:]
print("signature=%s" % sig)
print("partitions=%d" % len(table.get("partitions") or []))
'
}

# parts <device> -- the card's own partition table: its MBR signature and how
# many partitions it has. Read-only. `wk sysimage write` asks straight after
# the write, because a stream that arrived with a shell banner ahead of it
# hashes perfectly against itself and carries no table at all.
v_parts() {
    local dev out
    gate "${1:-}"; dev=$GATED_DEV
    out=$(_table "$dev") || deny "'$dev' has no readable partition table"
    printf '%s\n' "$out"
}

# The one place the two spellings of a Pi boot tree are ordered: Ubuntu's
# raspi images keep their cmdline under the os_prefix directory the firmware
# selects, and an image carrying both boots the one under the prefix.
_boot_file() { # <mountpoint> <name> -- the path the firmware would read, or nothing
    local m="$1" name="$2" f
    for f in "$m/current/$name" "$m/$name"; do
        [ -f "$f" ] && { printf '%s' "$f"; return 0; }
    done
    return 1
}

_root_spec_probe() { # <mountpoint>
    local f spec
    f=$(_boot_file "$1" cmdline.txt) || return 0
    spec=$(tr ' ' '\n' < "$f" | sed -n 's/^root=//p' | head -1)
    [ -n "$spec" ] && printf 'root=%s\n' "$spec"
    return 0
}

# root-spec <device> -- the `root=` the card's own kernel command line names,
# read off the card. Read-only, and the answer nothing here keeps a copy of:
# what the card boots from is written into the card.
v_root_spec() {
    local dev; gate "${1:-}"; dev=$GATED_DEV
    with_mount -r "$(part "$dev" "$BOOTP")" _root_spec_probe
}

_retarget_boot() { # <mountpoint> <partuuid of partition 2>
    local m="$1" root="$2" f
    f=$(_boot_file "$m" cmdline.txt) || fail "no cmdline.txt on this disk's boot partition"
    # Rewritten in python, with both values as arguments: a root= read off a
    # card is data, and data spliced into a sed script is a sed script.
    python3 -c '
import sys
path, new = sys.argv[1], sys.argv[2]
with open(path, errors="replace") as fh:
    words = fh.read().split()
with open(path, "w") as fh:
    fh.write(" ".join(new if w.startswith("root=") else w for w in words) + "\n")
' "$f" "root=PARTUUID=$root"
    grep -qF "root=PARTUUID=$root" "$f" || fail "root= did not survive the rewrite on this disk"
}

_retarget_fstab() { # <mountpoint> <partuuid of partition 1> <partuuid of partition 2>
    local m="$1" boot="$2" root="$3" f="$1/etc/fstab"
    [ -f "$f" ] || { say "no /etc/fstab on this disk"; return 0; }
    # Two ways a line can name the wrong partition, and both are rewritten: a
    # device path (/dev/mmcblk0p1, which follows the reader rather than the
    # card) and a **PARTUUID of another disk identifier** -- which is what an
    # fstab already retargeted once carries after anything rewrites the card's
    # MBR. Only the first was handled here, and its read-back looked only for
    # /dev paths, so a card whose identifier had moved was reported retargeted
    # while its /boot line still named the old one: the root mounts, /boot does
    # not, local-fs.target fails, and every network unit ordered after it never
    # starts. A board that boots and goes quiet (rpi3, 2026-09-01).
    #
    # Read back in the same pass, and now the check is "does every line name
    # *this* card": anything else is a mount that finds another disk or none.
    python3 -c '
import sys
path, boot, root = sys.argv[1], sys.argv[2], sys.argv[3]
def names_a_partition(f):
    return f.startswith("/dev/") or f.startswith("PARTUUID=")
def retarget(line):
    fields = line.split()
    if not fields or line.lstrip().startswith("#") or not names_a_partition(fields[0]):
        return line
    want = boot if fields[0].endswith("1") else root if fields[0].endswith("2") else ""
    return line.replace(fields[0], want, 1) if want else line
lines = [retarget(l) for l in open(path, errors="replace").read().splitlines(True)]
with open(path, "w") as fh:
    fh.write("".join(lines))
left = [l.split()[0] for l in lines
        if l.split() and not l.lstrip().startswith("#")
        and names_a_partition(l.split()[0])
        and l.split()[0] not in (boot, root)]
if left:
    sys.exit("still names another disk: " + ", ".join(left))
' "$f" "PARTUUID=$boot" "PARTUUID=$root" \
        || fail "/etc/fstab on this disk still names a partition that is not this card's.
    Every line has to name PARTUUID=$boot or PARTUUID=$root; a line naming
    anything else mounts another disk, or nothing, and takes local-fs.target
    down with it."
}

# retarget <device> -- make the card name its own partitions by PARTUUID, so
# it boots from whatever device it is put in. A wic image says
# `root=/dev/mmcblk0p2` because its wks file did: a promise about a device,
# and on a USB stick a promise about somebody else's. Both places that name a
# device are rewritten -- the kernel's root=, resolved by the kernel, and
# /boot in /etc/fstab, mounted by userspace after -- because fixing only the
# first leaves an empty /boot. Which cards need it is the caller's question
# (image_root_class, lib/image.sh); this one does it.
v_retarget() {
    local dev out sig root boot
    gate "${1:-}"; dev=$GATED_DEV
    out=$(_table "$dev") || deny "'$dev' has no readable partition table to take a PARTUUID from"
    sig=$(printf '%s\n' "$out" | sed -n 's/^signature=//p')
    case "$sig" in
        ''|*[!0-9a-fA-F]*) deny "'$dev' has no MBR disk signature, so a PARTUUID cannot name its partitions" ;;
    esac
    root=$(printf '%08x-%02d' "$((0x$sig))" "$ROOTP")
    boot=$(printf '%08x-%02d' "$((0x$sig))" "$BOOTP")
    with_mount "$(part "$dev" "$BOOTP")" _retarget_boot "$root"
    with_mount "$(part "$dev" "$ROOTP")" _retarget_fstab "$boot" "$root"
    say "$dev boots by PARTUUID=$root now, whatever device it is in"
}

_cmdline_append_edit() { # <mountpoint> <text>
    local m="$1" add="$2" f
    f=$(_boot_file "$m" cmdline.txt) || fail "no cmdline.txt on this disk's boot partition to append to"
    if grep -qF -- "$add" "$f"; then
        say "the kernel command line on this disk already carries: $add"
        return 0
    fi
    # One line, always: the firmware reads the first line only, so a trailing
    # newline would silently drop everything after it.
    printf '%s %s\n' "$(tr -d '\r\n' < "$f")" "$add" > "$f.wk"
    mv "$f.wk" "$f"
    grep -qF -- "$add" "$f" || fail "the kernel command line addition did not land on this disk"
}

# cmdline-append <device> <base64 text> -- kernel command-line additions a
# profile declares, appended to what the image already had. base64 on argv
# like `fleet`'s marker, so the value can be checked against a character set
# before anything decodes it. Idempotent by content.
v_cmdline_append() {
    local dev add
    gate "${1:-}"; dev=$GATED_DEV
    check_b64 "${2:-}"
    add=$(printf '%s' "$2" | base64 -d) || deny "the cmdline addition is not valid base64"
    check_text "the cmdline addition" "$add"
    case "$add" in
        *$'\n'*) deny "a kernel command line is one line" ;;
    esac
    with_mount "$(part "$dev" "$BOOTP")" _cmdline_append_edit "$add"
    say "kernel cmdline on $dev += $add"
}

_config_append_edit() { # <mountpoint> <block> <marker line>
    local m="$1" block="$2" marker="$3" f
    f=$(_boot_file "$m" config.txt) || fail "no config.txt on this disk's boot partition to append to"
    if grep -qxF -- "$marker" "$f"; then
        say "config.txt on this disk already carries that block"
        return 0
    fi
    printf '\n%s\n' "$block" >> "$f"
    # Read back: a firmware setting that did not land is a board that runs at
    # whatever clock it felt like, with nothing to notice by.
    grep -qxF -- "$marker" "$f" || fail "config.txt on this disk did not take the block"
}

# config-append <device> <base64 block> -- firmware settings a profile
# declares, appended to the config.txt a Pi's firmware reads whatever the OS
# is. Idempotent by the block's own first line, which has to be the
# `# --- wk sysimage: <profile> ---` banner: one fact, carried by the text
# itself rather than repeated in a second argument that could disagree.
v_config_append() {
    local dev block marker
    gate "${1:-}"; dev=$GATED_DEV
    check_b64 "${2:-}"
    block=$(printf '%s' "$2" | base64 -d) || deny "the config.txt block is not valid base64"
    check_text "the config.txt block" "$block"
    marker=$(printf '%s\n' "$block" | head -1)
    case "$marker" in
        "# --- wk sysimage: "*) ;;
        *) deny "a config.txt block starts with its own '# --- wk sysimage: <profile> ---' line,
    which is what makes appending it twice a no-op" ;;
    esac
    with_mount "$(part "$dev" "$BOOTP")" _config_append_edit "$block" "$marker"
    say "config.txt on $dev carries $marker"
}

_boot_id_edit() { # <mountpoint> <id>
    printf '%s\n' "$2" > "$1/wk-image.id"
    grep -qxF -- "$2" "$1/wk-image.id" \
        || fail "the identity did not survive the write to the boot partition"
}

# boot-id <device> <id> -- which system this card holds, on the **boot
# partition**, a different file from /etc/wk-image in the rootfs: `wk boot`
# reads it off a disk that is not running, without mounting anything ext4.
v_boot_id() {
    local dev
    gate "${1:-}"; dev=$GATED_DEV
    check_name "${2:-}"
    with_mount "$(part "$dev" "$BOOTP")" _boot_id_edit "$2"
    say "$dev's boot partition names this system $2"
}

# The unit archive's members, checked before anything is unpacked: exactly
# `systemd/<name>.service` and `sysctl.d/<name>.conf`, so nothing can land
# outside the two directories this verb writes -- a traversal, an absolute
# path and a nested directory are all refused by the same rule.
_units_names() { # <tar file>
    local list name
    list=$(tar -tf "$1") || deny "the unit archive is not a tar file"
    [ -n "$list" ] || deny "the unit archive is empty"
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        case "$name" in
            systemd/|sysctl.d/|init.d/|./) continue ;;
            systemd/*.service|systemd/*.timer|sysctl.d/*.conf|init.d/S[0-9][0-9]*) ;;
            *) deny "'$name' is not something this verb may write: a unit archive holds
    systemd/<name>.service, systemd/<name>.timer, sysctl.d/<name>.conf and
    init.d/S<nn><name>, and nothing else" ;;
        esac
        case "${name#*/}" in
            ''|.*|*/*|*[!a-zA-Z0-9@._-]*) deny "'$name' is not a plain file name" ;;
        esac
    done <<EOF
$list
EOF
}

# What tar actually produced, after the fact: whatever a tar implementation
# makes of a member name, only plain files and the two directories get copied
# onto the card.
_units_unpacked() { # <directory>
    local p
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        if [ -L "$p" ]; then deny "the unit archive carries a symlink ($p)"; fi
        if [ ! -f "$p" ] && [ ! -d "$p" ]; then deny "the unit archive carries something that is not a file ($p)"; fi
    done <<EOF
$(find "$1" -mindepth 1)
EOF
}

_unit_target() { # <unit file> -- the target its [Install] section asks for
    sed -n 's/^WantedBy=[[:space:]]*//p' "$1" | head -1 | tr -d ' \r'
}

_units_edit() { # <mountpoint> <staging directory>
    local m="$1" work="$2" f name target n=0
    # Which init this image runs, read out of the image rather than assumed:
    # an image without systemd would take these units without complaint, land
    # them where they never start, and report a watchdog installed on a board
    # that has none.
    # A BusyBox init runs /etc/init.d/S??* in order and nothing else, so
    # that image takes the archive's init.d scripts -- the same jobs as the
    # units, composed by the same caller -- and the units go nowhere.
    if [ ! -e "$m/lib/systemd/systemd" ] && [ ! -e "$m/usr/lib/systemd/systemd" ]; then
        if [ ! -d "$m/etc/init.d" ]; then
            say "units: neither systemd nor /etc/init.d on this disk; nothing installed"
            return 0
        fi
        for f in "$work"/init.d/*; do
            [ -f "$f" ] || continue
            name=$(basename "$f")
            cat "$f" > "$m/etc/init.d/$name"
            chmod 0755 "$m/etc/init.d/$name"; chown 0:0 "$m/etc/init.d/$name"
            [ -s "$m/etc/init.d/$name" ] || fail "$name did not land on this disk"
            n=$((n + 1))
        done
        _units_sysctl "$m" "$work"; n=$((n + SYSCTL_N))
        say "units: no systemd on this disk; installed $n init.d script(s) and sysctl drop-in(s)"
        return 0
    fi
    mkdir -p "$m/etc/systemd/system"
    for f in "$work"/systemd/*; do
        [ -f "$f" ] || continue
        name=$(basename "$f")
        # `systemctl enable` never runs against a card, so the unit's own
        # WantedBy= is what decides where it is symlinked -- the same fact
        # systemd would read, rather than a second one passed beside it.
        target=$(_unit_target "$f")
        # A service a *timer* starts declares no WantedBy=, and must not: the
        # timer is what schedules it, and symlinking the service into a target
        # as well would run it once at boot too. So no target is an error only
        # when no timer in this same archive names it.
        if [ -z "$target" ] && [ -f "$work/systemd/${name%.service}.timer" ]; then
            cat "$f" > "$m/etc/systemd/system/$name"
            chmod 0644 "$m/etc/systemd/system/$name"; chown 0:0 "$m/etc/systemd/system/$name"
            [ -s "$m/etc/systemd/system/$name" ] || fail "$name did not land on this disk"
            n=$((n + 1))
            continue
        fi
        case "$target" in
            *.target) ;;
            *) fail "$name declares no WantedBy= target, so nothing would ever start it" ;;
        esac
        case "$target" in
            *[!a-z0-9@.-]*) fail "'$target' is not a systemd target name" ;;
        esac
        cat "$f" > "$m/etc/systemd/system/$name"
        chmod 0644 "$m/etc/systemd/system/$name"; chown 0:0 "$m/etc/systemd/system/$name"
        mkdir -p "$m/etc/systemd/system/$target.wants"
        ln -sf "/etc/systemd/system/$name" "$m/etc/systemd/system/$target.wants/$name"
        [ -s "$m/etc/systemd/system/$name" ] && [ -L "$m/etc/systemd/system/$target.wants/$name" ] \
            || fail "$name did not land on this disk"
        n=$((n + 1))
    done
    _units_sysctl "$m" "$work"; n=$((n + SYSCTL_N))
    say "units: installed $n file(s)"
}

# The sysctl drop-ins, the same for either init (both read /etc/sysctl.d).
SYSCTL_N=0
_units_sysctl() { # <mountpoint> <staging directory>
    local m="$1" work="$2" f name
    SYSCTL_N=0
    for f in "$work"/sysctl.d/*; do
        [ -f "$f" ] || continue
        name=$(basename "$f")
        mkdir -p "$m/etc/sysctl.d"
        cat "$f" > "$m/etc/sysctl.d/$name"
        chmod 0644 "$m/etc/sysctl.d/$name"; chown 0:0 "$m/etc/sysctl.d/$name"
        [ -s "$m/etc/sysctl.d/$name" ] || fail "$name did not land on this disk"
        SYSCTL_N=$((SYSCTL_N + 1))
    done
}

# units <device> -- what makes a booted image a *fleet* system (a self-return
# watchdog, a self-disarm, the profiling knobs), as a tar on stdin: systemd
# units and init.d scripts for the same jobs, plus sysctl drop-ins, composed
# where the profile's values are. Which set lands is decided by the init the
# disk carries, in three fixed directories under /etc.
# On stdin, not argv, because a unit is a file rather than a word -- and
# bounded, because stdin from a caller is not a promise about size.
UNITS_MAX=1048576
v_units() {
    local dev tmp work rc
    gate "${1:-}"; dev=$GATED_DEV
    tmp=$(mktemp /run/wk-card-units.XXXXXX); chmod 0600 "$tmp"
    head -c "$((UNITS_MAX + 1))" > "$tmp"
    if [ "$(stat -c '%s' "$tmp")" -gt "$UNITS_MAX" ]; then
        rm -f "$tmp"; deny "the unit archive is larger than $UNITS_MAX bytes"
    fi
    if [ ! -s "$tmp" ]; then
        rm -f "$tmp"; deny "no unit archive arrived on stdin"
    fi
    _units_names "$tmp" || { rm -f "$tmp"; fail "could not read the unit archive"; }
    work=$(mktemp -d /run/wk-card-units.XXXXXX)
    tar -xf "$tmp" -C "$work" || { rm -rf "$work" "$tmp"; fail "could not unpack the unit archive"; }
    rm -f "$tmp"
    _units_unpacked "$work"
    rc=0
    with_mount "$(part "$dev" "$ROOTP")" _units_edit "$work" || rc=$?
    rm -rf "$work"
    return "$rc"
}

# rescue-helper <device> -- put this machine's card helper and boot-file
# checker onto the rescue being written, so the board that boots it can write
# its own bench media with the same code that just wrote its rescue.
#
# Nothing executable arrives from the caller: the bytes copied are the ones
# root already runs here, which `./setup --stage quiesce` keeps equal to the
# checkout (admin/install.sh). So a board's helper is reproducible from the
# repo plus one write, and a fix to it reaches the fleet without an image
# rebuild -- which is what a baked-in copy costs.
#
# The privilege is the write's own: this verb writes into the rootfs of a card
# whose every byte the same command just streamed, including the copy the
# image baked in. It grants nothing on *this* machine.
_rescue_helper_install() { # <mountpoint>
    local m="$1" d="$m/usr/local/libexec"
    mkdir -p "$d" || fail "could not make $d on this disk"
    cat "$SELF" > "$d/wk-card-priv" || fail "the card helper did not land on this disk"
    cat "$CHECK_BOOT_FILES" > "$d/wk-check-boot-files.py" \
        || fail "the boot-file checker did not land on this disk"
    chmod 0755 "$d/wk-card-priv" "$d/wk-check-boot-files.py"
    chown 0:0 "$d/wk-card-priv" "$d/wk-check-boot-files.py"
    [ -s "$d/wk-card-priv" ] && [ -s "$d/wk-check-boot-files.py" ] \
        || fail "a helper file landed empty on this disk"
    say "helper: this machine's card helper and boot-file checker are on the rescue"
}
v_rescue_helper() {
    local dev; gate "${1:-}"; dev=$GATED_DEV
    [ -z "$SECOND" ] \
        || deny "rescue-helper addresses the system on partitions 1 and 2; '@second' and
    '@third' are bench systems, which never write a card"
    [ -r "$SELF" ] || fail "this helper cannot read its own file at $SELF"
    [ -r "$CHECK_BOOT_FILES" ] || deny "there is no boot-file checker at $CHECK_BOOT_FILES on
    this machine, so a rescue written from here would carry none either.
    Remedy, from a terminal on this machine:  ./setup --stage quiesce"
    with_mount "$(part "$dev" "$ROOTP")" _rescue_helper_install
}

# diag <device> -- the system's own account of its last boot, off the boot
# partition where the image writes it ~90 s in (wk-diag.txt: its marker, the
# root and boot filesystems it found, rfkill, addresses, routes, and the
# network units' journal).
#
# It exists to be read when the system never became reachable, and until now
# the only reader was the board itself (b_diag, over ssh) -- which is the one
# thing an unreachable system cannot offer. With the card in a reader this is
# the path. Read-only, one fixed filename, bounded: nothing a caller names.
DIAG_MAX=65536
_diag_probe() { # <mountpoint>
    [ -f "$1/wk-diag.txt" ] \
        || { say "no wk-diag.txt on this boot partition -- the image did not get that far"; return 0; }
    head -c "$DIAG_MAX" "$1/wk-diag.txt"
}
v_diag() {
    local dev; gate "${1:-}"; dev=$GATED_DEV
    with_mount -r "$(part "$dev" "$BOOTP")" _diag_probe
}

_boot_check_run() { # <mountpoint> <dtb>
    python3 "$CHECK_BOOT_FILES" --root "$1" --dtb "$2"
}

# boot-check <device> <dtb> -- will this card's firmware find everything it
# needs to reach a kernel? Read-only, and asked of the card rather than of
# the image it came from: what the board will boot is what is on the disk.
# A kernel that cannot find its root panics and reboots; firmware that cannot
# find a kernel **halts**, which costs a trip to the board.
v_boot_check() {
    local dev rc=0
    gate "${1:-}"; dev=$GATED_DEV
    check_name "${2:-}"
    [ -r "$CHECK_BOOT_FILES" ] || deny "there is no boot-file checker at $CHECK_BOOT_FILES on this
    machine. It is boot/check-boot-files.py from wk-tools, installed root-owned
    beside this helper -- root runs it, so it cannot be a path a caller names.
    Remedy, from a terminal on this machine:  ./setup --stage quiesce"
    with_mount -r "$(part "$dev" "$BOOTP")" _boot_check_run "$2" || rc=$?
    [ "$rc" -eq 0 ] || fail "this card's boot partition is missing files a $2 board's firmware asks for"
    say "boot-check: every file the firmware asks for resolves"
}

# --- a system beside this machine's own (@second, @third) --------------------
# The image on stdin is a whole card (MBR, boot FAT as partition 1, root as
# partition 2). Where it lands depends on the medium's shape, decided by the
# first system's role: a *rescue* shares its medium with two bench systems --
# an extended partition 3 whose geometry is a pure function of the disk size
# (two logical pairs, 5-6 and 7-8, each a 256 MiB boot and half the remaining
# space), so every write converges on the same table and rewriting one system
# leaves the other's bytes alone. A *dedicated* bench medium (its first
# system is not a rescue) carries one system beside the first as primaries
# 3-4, sized to the image. Then the two partition images are streamed in,
# each hashed as it passes, and the hashes printed for the read-back check
# (`verify` re-reads the same two ranges). Python, since this is byte-offset
# arithmetic on a partition table and a one-pass split of a stream
# (CLAUDE.md: structured data is not handled in bash). The image is on this
# helper's stdin, and the program arrives on stdin too, so the image is
# handed to python on fd 3 before the heredoc takes fd 0.

# The shape fact, read off the first system's root: where it is already
# mounted when this machine runs from the disk, mounted briefly otherwise (a
# card in a reader). A partition with nothing mountable is not a rescue.
_rescue_marker_probe() { [ -f "$1/etc/wk/rescue" ]; }
_first_is_rescue() { # <disk>
    local p2 m; p2=$(part "$1" 2)
    m=$(findmnt -no TARGET "$p2" 2>/dev/null | head -1 || true)
    if [ -n "$m" ]; then _rescue_marker_probe "$m"
    else with_mount -r "$p2" _rescue_marker_probe 2>/dev/null; fi
}

_second_write() { # <disk>   -- image bytes on stdin
    local shape=dedicated
    if _first_is_rescue "$1"; then shape=shared; fi
    python3 - "$1" "$SLOT" "$shape" 3<&0 <<'PY'
import hashlib, json, os, subprocess, sys
dev, slot, shape = sys.argv[1], int(sys.argv[2]), sys.argv[3]
def part(n): return dev + ("p%d" % n if dev[-1].isdigit() else "%d" % n)
def say(m): print("wk-card-priv: " + m, flush=True)
def fail(m): print("wk-card-priv: " + m, file=sys.stderr, flush=True); sys.exit(1)

src = os.fdopen(3, "rb")
mbr = src.read(512)
if len(mbr) != 512 or mbr[510:512] != b"\x55\xaa":
    fail("the image does not start with an MBR")
parts = []
for i in range(4):
    e = mbr[446 + 16 * i: 462 + 16 * i]
    ptype, start, size = e[4], int.from_bytes(e[8:12], "little"), int.from_bytes(e[12:16], "little")
    if ptype and size:
        parts.append((start, size))
if len(parts) != 2:
    fail("the image carries %d partitions; a system is a boot partition and a root" % len(parts))
(b_start, b_size), (r_start, r_size) = parts
if b_start >= r_start:
    fail("the image's partitions are not boot-then-root in disk order")

def table():
    t = json.loads(subprocess.check_output(["sfdisk", "-J", dev]))["partitiontable"]
    return {int(p["node"][len(dev):].lstrip("p")): p for p in t["partitions"]}
def disk_id():
    t = json.loads(subprocess.check_output(["sfdisk", "-J", dev]))["partitiontable"]
    i = str(t.get("id", ""))
    if not i:
        fail("%s has no MBR disk identifier, so its partitions cannot be named by PARTUUID" % dev)
    return i
def disk_sectors():
    with open(dev, "rb") as fh:
        return os.lseek(fh.fileno(), 0, os.SEEK_END) // 512
def reread():
    subprocess.run(["partx", "-d", "--nr", "3:8", dev], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["partx", "-a", dev], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

have = table()
total = disk_sectors()
ALIGN = 2048
def up(s): return (s + ALIGN - 1) // ALIGN * ALIGN

if shape == "shared":
    # The deterministic shared layout, from the disk size alone.
    if 1 not in have or 2 not in have:
        fail("%s has partitions %s; a shared medium starts with its rescue on 1-2" % (dev, sorted(have)))
    BOOT_SECT = 256 * 2048        # 256 MiB per system's boot partition
    ext_start = up(have[2]["start"] + have[2]["size"])
    half = (total - ext_start) // 2
    want = {3: {"start": ext_start, "size": total - ext_start, "type": "5"}}
    zones = {}
    for s in (1, 2):
        z0 = ext_start + (s - 1) * half
        zend = z0 + half if s == 1 else total
        bs = z0 + ALIGN
        rs = bs + BOOT_SECT + ALIGN
        want[3 + 2 * s] = {"start": bs, "size": BOOT_SECT, "type": "c"}
        want[4 + 2 * s] = {"start": rs, "size": zend - rs, "type": "83"}
        zones[s] = (bs, rs)
    def matches():
        for n, w in want.items():
            p = have.get(n)
            if not p or p["start"] != w["start"] or p["size"] != w["size"]:
                return False
        return True
    if not matches():
        old = [n for n in (3, 4, 5, 6, 7, 8) if n in have]
        if old:
            say("replacing the layout of partitions %s; the systems there are gone" %
                ",".join(str(n) for n in old))
        # The disk identifier is carried over rather than left to sfdisk, which
        # generates a fresh random one for a script that does not name it. Every
        # PARTUUID on the card is <disk id>-<nn>, and the *rescue* on partitions
        # 1-2 names its own root that way in cmdline.txt and fstab -- a system
        # this write does not touch and would not retarget. A new identifier
        # here boots the board to a kernel that cannot find any root, and the
        # only way back is a reader (2026-09-01: it cost the rpi3 a day).
        lines = ["label: dos", "label-id: %s" % disk_id()]
        for n in (1, 2):
            p = have[n]
            lines.append("start=%d, size=%d, type=%s%s"
                         % (p["start"], p["size"], p.get("type", "83"),
                            ", bootable" if p.get("bootable") else ""))
        lines.append("start=%d, size=%d, type=5" % (want[3]["start"], want[3]["size"]))
        for n in (5, 6, 7, 8):
            lines.append("start=%d, size=%d, type=%s" % (want[n]["start"], want[n]["size"], want[n]["type"]))
        script = "\n".join(lines) + "\n"
        subprocess.run(["sfdisk", "--no-reread", "--force", dev], input=script.encode(),
                       check=True, stdout=subprocess.DEVNULL)
        reread()
        have = table()
        say("shared layout made: rescue on 1-2, systems on 5-6 and 7-8 inside extended 3")
    bootp, rootp = 3 + 2 * slot, 4 + 2 * slot
else:
    # A dedicated bench medium: one system beside the first, primaries 3-4
    # sized to the image, made once.
    if slot != 1:
        fail("a dedicated bench medium carries one system beside its first; there is no @third here")
    if set(have) == {1, 2}:
        last = have[2]["start"] + have[2]["size"]
        if last + b_size + r_size > total:
            fail("the image's partitions (%d + %d sectors) do not fit the %d sectors left on %s after partition 2"
                 % (b_size, r_size, max(total - last, 0), dev))
        script = "start=%d, size=%d, type=c\nstart=%d, type=83\n" % (last, b_size, last + b_size)
        subprocess.run(["sfdisk", "--append", "--no-reread", dev], input=script.encode(), check=True,
                       stdout=subprocess.DEVNULL)
        reread()
        have = table()
        say("partitions 3 and 4 made beside 1 and 2")
    if not {1, 2, 3, 4} <= set(have):
        fail("%s has partitions %s; a second system needs 1-4" % (dev, sorted(have)))
    bootp, rootp = 3, 4

if have[bootp]["size"] < b_size or have[rootp]["size"] < r_size:
    fail("the image's partitions (%d + %d sectors) do not fit partitions %d and %d (%d + %d)"
         % (b_size, r_size, bootp, rootp, have[bootp]["size"], have[rootp]["size"]))

pos = 512
def copy(n_bytes, out_path, skip_to):
    """Consume the stream up to byte skip_to, then copy n_bytes into out_path."""
    global pos
    while pos < skip_to:
        chunk = src.read(min(1 << 20, skip_to - pos))
        if not chunk:
            fail("the image ended before the partition that goes to %s" % out_path)
        pos += len(chunk)
    h = hashlib.sha256(); left = n_bytes
    with open(out_path, "wb") as out:
        while left:
            chunk = src.read(min(4 << 20, left))
            if not chunk:
                fail("the image ended inside the partition that goes to %s" % out_path)
            out.write(chunk); h.update(chunk); left -= len(chunk); pos += len(chunk)
        out.flush(); os.fsync(out.fileno())
    return h.hexdigest()

say("writing the image's boot partition to %s" % part(bootp))
boot_sha = copy(b_size * 512, part(bootp), b_start * 512)
say("writing the image's root partition to %s" % part(rootp))
root_sha = copy(r_size * 512, part(rootp), r_start * 512)
while src.read(1 << 20):
    pass    # what follows the root partition in the image is padding
os.sync()
print("boot_bytes=%d" % (b_size * 512)); print("boot_sha=%s" % boot_sha)
print("root_bytes=%d" % (r_size * 512)); print("root_sha=%s" % root_sha)
say("written")
PY
}

# `verify <disk>@second|@third <boot bytes> <boot sha> <root bytes> <root sha>`
v_second_verify() {
    local dev got; gate "${1:-}"; dev=$GATED_DEV; shift
    for n in "${1:-}" "${3:-}"; do case "$n" in ''|*[!0-9]*) deny "'$n' is not a byte count" ;; esac; done
    check_hex "${2:-}"; check_hex "${4:-}"
    got=$(head -c "$1" "$(part "$dev" "$BOOTP")" | sha256sum | cut -d' ' -f1)
    [ "$got" = "$2" ] || fail "partition $BOOTP reads back as $got, not the $2 that was written"
    got=$(head -c "$3" "$(part "$dev" "$ROOTP")" | sha256sum | cut -d' ' -f1)
    [ "$got" = "$4" ] || fail "partition $ROOTP reads back as $got, not the $4 that was written"
    say "verified: partitions $BOOTP and $ROOTP hold the image's boot and root"
}

# Arming. The firmware boots the first FAT partition and only that one, so
# the addressed system's kernel, device trees, overlays and cmdline are
# copied from its own boot partition into a prefix directory on the rescue's
# boot partition (`second/` for @second, `third/` for @third) and selected
# with os_prefix. The rescue's config.txt steps aside (config.txt.rescue)
# for the system's own plus the one os_prefix line -- for one boot: the
# system moves it back as the first thing it does (the self-disarm
# `wk sysimage write` stages into every fleet system, from the board's
# driver: boot/pi-sd.sh), and `second-disarm` does the same from the rescue.

# The rescue's boot partition, for one edit: where it is already mounted
# when this machine runs from the disk, mounted here otherwise (a card in
# a reader).
# `-r` for a verb that only reads: a reporting verb mounts read-only, because
# mounting a FAT read-write and unmounting it rewrites the volume's dirty flag
# and its FSInfo sector -- a write, on a card somebody asked a question about
# (CLAUDE.md: read-only is read-only).
_second_with_boot() { # [-r] <disk> <function> [args...] -- calls <function> <boot mountpoint> [args...]
    local ro=""
    [ "${1:-}" = -r ] && { ro=-r; shift; }
    local dev="$1" fn="$2" m; shift 2
    # `|| true`: findmnt exits 1 for "not mounted", which under pipefail
    # would end this helper before the mount below.
    m=$(findmnt -no TARGET "$(part "$dev" 1)" 2>/dev/null | head -1 || true)
    if [ -n "$m" ]; then
        "$fn" "$m" "$@"
    else
        # shellcheck disable=SC2086
        with_mount $ro "$(part "$dev" 1)" "$fn" "$@"
    fi
}
_second_stage_copy() { # <mountpoint of the system's boot partition> <staging directory>
    local src="$1" stage="$2"
    cp -a "$src"/. "$stage/" || fail "could not read the system's boot files"
    [ -f "$stage/cmdline.txt" ] || fail "the system's boot partition has no cmdline.txt"
    [ -f "$stage/config.txt" ]  || fail "the system's boot partition has no config.txt"
}
# Plain copies onto the FAT: `cp -a` would try to preserve ownership there
# and report a failure over a filesystem that has none to preserve.
# Both prefix directories go before the new one lands: a stale second/ next
# to an armed third/ is inert, but a card should read as what it is.
_second_arm_install() { # <boot mountpoint> <staging directory> <prefix>
    local boot="$1" stage="$2" pfx="$3"
    rm -rf "$boot/$pfx.part"
    cp -r "$stage" "$boot/$pfx.part" || fail "could not copy the system's boot files onto the boot partition"
    rm -rf "$boot/second" "$boot/third"; mv "$boot/$pfx.part" "$boot/$pfx"
    [ -f "$boot/config.txt.rescue" ] || cp "$boot/config.txt" "$boot/config.txt.rescue"
    # The prefix leads the file, ahead of every line the armed system's own
    # config.txt carries. The firmware resolves a filename when it reads the
    # directive asking for one, so a prefix set after a `dtoverlay=` line
    # never reaches that overlay's .dtbo; and a prefix appended at the end
    # lands inside whichever conditional section the image closes with, where
    # a filter can drop it outright. Either way the board boots the armed
    # kernel and loses that system's display stack. The image's own os_prefix
    # goes: two of them select nothing predictable.
    {
        printf '# --- wk armed: the %s system, for one boot (wk boot) ---\nos_prefix=%s/\n\n' "$pfx" "$pfx"
        sed '/^os_prefix=/d' "$boot/$pfx/config.txt"
    } > "$boot/config.txt.armed"
    mv "$boot/config.txt.armed" "$boot/config.txt"
    sync
}
_second_disarm_edit() { # <boot mountpoint>
    local boot="$1"
    if [ -f "$boot/config.txt.rescue" ]; then
        mv "$boot/config.txt.rescue" "$boot/config.txt"; sync
        say "disarmed: the rescue's config.txt is back"
    else
        say "not armed"
    fi
}
# armed=yes|no is whether the rescue's config.txt has stepped aside;
# armed_prefix says for which system, read from the os_prefix actually in
# force -- two systems can be present and only the config decides which
# one the next boot is.
_second_state_edit() { # <boot mountpoint>
    if [ -f "$1/config.txt.rescue" ]; then
        say "armed=yes"
        say "armed_prefix=$(sed -n 's|^os_prefix=\(.*\)/$|\1|p' "$1/config.txt" | tail -1)"
    else
        say "armed=no"
    fi
}
# A pair of partitions holds a system when its root carries a filesystem:
# under the shared layout the partitions exist from the day the card is laid
# out, so existence alone says nothing.
_slot_present() { # <disk>
    [ -b "$(part "$1" "$ROOTP")" ] \
        && [ "$(blkid -o value -s TYPE "$(part "$1" "$ROOTP")" 2>/dev/null)" = ext4 ]
}
v_second_arm() {
    local dev stage; gate "${1:-}"; dev=$GATED_DEV
    [ -n "$SECOND" ] || deny "second-arm takes '<disk>@second' or '<disk>@third'"
    _slot_present "$dev" || fail "$dev@$PFX holds no system (partition $ROOTP is absent or empty); write one first"
    stage=$(mktemp -d /run/wk-card-second.XXXXXX)
    with_mount -r "$(part "$dev" "$BOOTP")" _second_stage_copy "$stage" || { rm -rf "$stage"; exit 1; }
    _second_with_boot "$dev" _second_arm_install "$stage" "$PFX" || { rm -rf "$stage"; exit 1; }
    rm -rf "$stage"
    say "armed: the $PFX system boots once (os_prefix=$PFX/); the rescue's config.txt is kept as config.txt.rescue"
}
v_second_disarm() {
    local dev; gate "${1:-}"; dev=$GATED_DEV
    [ -n "$SECOND" ] || deny "second-disarm takes '<disk>@second' or '<disk>@third'"
    _second_with_boot "$dev" _second_disarm_edit
}
v_second_state() {
    local dev; gate "${1:-}"; dev=$GATED_DEV
    [ -n "$SECOND" ] || deny "second-state takes '<disk>@second' or '<disk>@third'"
    _second_with_boot -r "$dev" _second_state_edit
    _slot_present "$dev" && say "present=yes" || say "present=no"
}

# --- the second system's tailnet identity, across a rewrite ------------------
# tailscaled's state on partition 4 is the second system's node identity.
# Kept aside here before the split and put back after it, the rewritten
# system comes up as the node the old one was -- same name, same address, no
# join, and no collision with its own name. The stash is root-only under
# /run: gone at reboot, which is right for something that lives for one
# command.
TAILNET_STATE=var/lib/tailscale/tailscaled.state
# Keyed by the medium, not by the pair: a board's *bench role* is one tailnet
# node, and the systems beside the rescue take turns being it. Two identities
# would collide on one name the moment the second system joined.
#
# And kept where the board keeps things -- the rescue's own root, which is the
# one filesystem a bench rewrite never touches -- rather than in /run for the
# length of one command. That is what makes a *fresh* bench card rejoin as the
# node it was instead of colliding with it: the identity outlives the medium
# it was last on, so nothing has to retire a leftover and no credential that
# can administer the tailnet is needed to write a card. It is a node key at
# rest on a filesystem that already holds one, so it costs no new exposure.
TAILNET_KEEP_DIR=/var/lib/wk/tailnet
_tailnet_stash() { printf '%s/%s.state' "$TAILNET_KEEP_DIR" "$(basename "$1")"; }

# Every partition on this medium that could hold a bench system's root, the
# addressed one first: a system written beside one that already holds the
# board's identity adopts it rather than joining under a name that is taken.
_tailnet_roots() { # <disk>
    local p
    printf '%s\n' "$ROOTP"
    for p in 4 6 8; do [ "$p" = "$ROOTP" ] || printf '%s\n' "$p"; done
}
_tailnet_save_edit() { # <mountpoint of a bench root> <stash>
    if [ -f "$1/$TAILNET_STATE" ]; then
        cp "$1/$TAILNET_STATE" "$2" && chmod 0600 "$2" || fail "could not keep the tailnet state aside"
        say "kept=yes"
    fi
}
_tailnet_restore_edit() { # <mountpoint of partition 4> <stash>
    mkdir -p "$1/var/lib/tailscale"
    chmod 0700 "$1/var/lib/tailscale"; chown 0:0 "$1/var/lib/tailscale"
    cp "$2" "$1/$TAILNET_STATE" && chmod 0600 "$1/$TAILNET_STATE" && chown 0:0 "$1/$TAILNET_STATE" \
        || fail "could not put the tailnet state back"
    [ -s "$1/$TAILNET_STATE" ] || fail "the tailnet state did not land"
    say "restored: the second system comes up as the node it was"
}
# tailnet-save <disk>@second -- kept=yes|no. A partition 4 with no filesystem
# (a write that died in the split) holds nothing to keep.
# Three places the board's bench identity can be, in decreasing immediacy:
# the pair being rewritten, another bench pair on the same medium, and what
# this board remembered the last time it had one. The remembered copy is
# refreshed from a live one whenever there is a live one, so it cannot drift
# into being the *older* of two identities.
v_tailnet_save() {
    local dev stash p root; gate "${1:-}"; dev=$GATED_DEV
    # Whole-disk too: a dedicated bench medium is rewritten whole, and the
    # node it holds is the board's bench node exactly as a second system's is.
    # The gate has already refused a disk this machine runs from.
    mkdir -p "$TAILNET_KEEP_DIR" && chmod 0700 "$TAILNET_KEEP_DIR" && chown 0:0 "$TAILNET_KEEP_DIR" \
        || fail "could not make $TAILNET_KEEP_DIR, where this board remembers its bench node"
    stash=$(_tailnet_stash "$dev")
    for p in $(_tailnet_roots "$dev"); do
        root=$(part "$dev" "$p")
        [ -b "$root" ] || continue
        [ "$(blkid -o value -s TYPE "$root" 2>/dev/null)" = ext4 ] || continue
        with_mount -r "$root" _tailnet_save_edit "$stash.new"
        if [ -f "$stash.new" ]; then
            mv -f "$stash.new" "$stash"
            [ "$p" = "$ROOTP" ] || say "adopted=$p"
            return 0
        fi
    done
    # Nothing live anywhere on the medium: the remembered copy is the board's
    # identity, and a card written from it rejoins as the node it was.
    if [ -f "$stash" ]; then
        say "kept=yes"
        say "adopted=remembered"
        return 0
    fi
    say "kept=no"
}
# tailnet-restore <disk>@second -- what `tailnet-save` kept, onto the
# rewritten partition 4; the stash is spent.
v_tailnet_restore() {
    local dev stash; gate "${1:-}"; dev=$GATED_DEV

    stash=$(_tailnet_stash "$dev")
    [ -f "$stash" ] || { say "nothing kept"; return 0; }
    with_mount "$(part "$dev" "$ROOTP")" _tailnet_restore_edit "$stash"
    # The stash is not spent: it is what this board remembers its bench node
    # to be, and the next card written for it -- a fresh one included -- takes
    # the same identity rather than colliding with it.
}

# --- dispatch ----------------------------------------------------------------
#
# One case, one verb, no default that runs anything. An unknown verb is a usage
# error and not a fallback -- a helper whose unrecognised input does *something*
# is a helper whose grant is larger than its documentation.
verb="${1:-}"; shift || true
case "$verb" in
    status)   v_status ;;
    check)    v_check    "$@" ;;
    write)    v_write    "$@" ;;
    fleet)    v_fleet    "$@" ;;
    joins)    v_joins    "$@" ;;
    whose)    v_whose    "$@" ;;
    tailnet)  v_tailnet  "$@" ;;
    wifi-joins) v_wifi_joins "$@" ;;
    wifi-host) v_wifi_host "$@" ;;
    wifi-from-host) v_wifi_from_host "$@" ;;
    identity) v_identity "$@" ;;
    role)     v_role     "$@" ;;
    grow)     v_grow     "$@" ;;
    unmount)  v_unmount  "$@" ;;
    verify)   case "${1:-}" in *@second) v_second_verify "$@" ;; *) v_verify "$@" ;; esac ;;
    second-arm)    v_second_arm    "$@" ;;
    second-disarm) v_second_disarm "$@" ;;
    second-state)  v_second_state  "$@" ;;
    rescue-helper) v_rescue_helper "$@" ;;
    diag)     v_diag     "$@" ;;
    tailnet-save)    v_tailnet_save    "$@" ;;
    tailnet-restore) v_tailnet_restore "$@" ;;
    eject)    v_eject    "$@" ;;
    parts)    v_parts    "$@" ;;
    root-spec) v_root_spec "$@" ;;
    retarget) v_retarget "$@" ;;
    cmdline-append) v_cmdline_append "$@" ;;
    config-append)  v_config_append  "$@" ;;
    boot-id)  v_boot_id  "$@" ;;
    units)    v_units    "$@" ;;
    boot-check) v_boot_check "$@" ;;
    *) fail "usage: wk-card-priv status|check|write|fleet|joins|whose|tailnet|wifi-joins|wifi-host|wifi-from-host|identity|role|grow|unmount|verify|eject|parts|root-spec|retarget|cmdline-append|config-append|boot-id|units|boot-check|second-arm|second-disarm|second-state|rescue-helper|diag|tailnet-save|tailnet-restore <device>[@second] [...]" ;;
esac
