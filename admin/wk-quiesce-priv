#!/bin/bash
#
# The privileged half of `wk quiesce`. Runs as root via a NOPASSWD sudoers
# rule that names this exact path. Linux cannot make a #! script setuid --
# the kernel ignores the bit -- so the sudoers rule is the mechanism, not a
# setuid wrapper.
#
# Everything here must be safe to grant unconditionally, because granting it
# is equivalent to granting it forever:
#
#   - The command set is a fixed allowlist. No passthrough, no eval, no
#     argument that becomes part of a command.
#   - Nothing is read from the environment: sudo's env_reset plus the
#     explicit PATH below means a hostile environment cannot redirect a
#     binary.
#   - Every action is reversible with `off`, which is also what runs on an
#     unrecognised argument.
#   - The session verbs are one verb per configuration (session-on,
#     session-on-bmc, session-gdm, session-gdm-bmc, session-stop,
#     session-off) rather than one verb taking a configuration, so each
#     spells a fixed device list and compositor command line and no
#     argument ever reaches a command.
#
# The session verbs exist because a GPU benchmark needs a real DRM session
# on the monitor, and taking the seat means stopping the display manager --
# neither of which an unprivileged user may do. The compositor's user comes
# from a root-owned file written at install time, never from an argument:
# an argument would widen this into "run a compositor as anyone".

set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

[ "$(id -u)" -eq 0 ] || { echo "wk-quiesce-priv: must run as root" >&2; exit 1; }

os=$(uname -s)
action="${1:-off}"

# --- macOS -------------------------------------------------------------------
macos_on() {
    mdutil -a -i off >/dev/null 2>&1 || true
    tmutil stopbackup >/dev/null 2>&1 || true
    softwareupdate --schedule off >/dev/null 2>&1 || true
    pmset -a lowpowermode 0 >/dev/null 2>&1 || true
    echo "quiesced: spotlight off, backups stopped, updates off, low-power off"
}

macos_off() {
    mdutil -a -i on >/dev/null 2>&1 || true
    softwareupdate --schedule on >/dev/null 2>&1 || true
    echo "restored: spotlight on, updates on"
}

macos_status() {
    printf 'spotlight: %s\n' "$(mdutil -a -s 2>/dev/null | tr '\n' ' ')"
    printf 'lowpower:  %s\n' "$(pmset -g | awk '/lowpowermode/ {print $2}')"
}

# --- Linux -------------------------------------------------------------------
linux_on() {
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo performance > "$g" || true
    done
    [ -w /sys/devices/system/cpu/intel_pstate/no_turbo ] && \
        echo 1 > /sys/devices/system/cpu/intel_pstate/no_turbo || true
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && \
        echo 0 > /sys/devices/system/cpu/cpufreq/boost || true
    sysctl -q -w kernel.perf_event_paranoid=-1 || true
    sysctl -q -w kernel.randomize_va_space=0 || true
    systemctl stop packagekit.service >/dev/null 2>&1 || true
    echo "quiesced: performance governor, turbo off, perf unrestricted, ASLR off"
}

linux_off() {
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo schedutil > "$g" || true
    done
    [ -w /sys/devices/system/cpu/intel_pstate/no_turbo ] && \
        echo 0 > /sys/devices/system/cpu/intel_pstate/no_turbo || true
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && \
        echo 1 > /sys/devices/system/cpu/cpufreq/boost || true
    sysctl -q -w kernel.perf_event_paranoid=2 || true
    sysctl -q -w kernel.randomize_va_space=2 || true
    echo "restored: schedutil governor, turbo on, perf restricted, ASLR on"
}

linux_status() {
    printf 'governor:  %s\n' "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo n/a)"
    printf 'paranoid:  %s\n' "$(sysctl -n kernel.perf_event_paranoid 2>/dev/null || echo n/a)"
    printf 'aslr:      %s\n' "$(sysctl -n kernel.randomize_va_space 2>/dev/null || echo n/a)"
}

# --- Linux: perf_event_paranoid alone -----------------------------------------
# A narrower pair than `on`/`off`: samply (wk profile --mode samply) needs
# only this one sysctl lowered, not the governor pinned, turbo disabled and
# ASLR off a full benchmark quiesce does. `1` is the least-restrictive value
# that still requires no capability the container lacks; `-1` (`on`'s fully
# unrestricted) is not needed for samply.
perf_on() {
    sysctl -q -w kernel.perf_event_paranoid=1 \
        || { echo "wk-quiesce-priv: could not set kernel.perf_event_paranoid" >&2; exit 1; }
    printf 'perf_event_paranoid: %s (samply/perf unrestricted)\n' "$(sysctl -n kernel.perf_event_paranoid)"
}

perf_off() {
    sysctl -q -w kernel.perf_event_paranoid=2 \
        || { echo "wk-quiesce-priv: could not restore kernel.perf_event_paranoid" >&2; exit 1; }
    printf 'perf_event_paranoid: %s (restored)\n' "$(sysctl -n kernel.perf_event_paranoid)"
}

# --- Linux: the benchmark session -------------------------------------------
# cage is a one-client kiosk compositor: a real DRM session on the real
# device, without a desktop's compositing overhead in the numbers. Started
# through systemd-run with PAMName=login and a TTY, giving it a logind
# session on seat0 (without that, libseat can't take DRM master and the
# compositor exits immediately). Not run as root, though that would work:
# the Wayland socket is the one host socket a workspace can see, and a
# root compositor would make that a much more interesting thing to talk to.
WK_SESSION_CONF=/usr/local/libexec/wk-session.env
WK_SESSION_UNIT=wk-session
WK_SESSION_TTY=${WK_SESSION_TTY:-/dev/tty2}
WK_SESSION_MODE_FILE=/run/wk-session-mode

session_user() {
    [ -r "$WK_SESSION_CONF" ] || return 1
    # shellcheck disable=SC1090
    . "$WK_SESSION_CONF"
    [ -n "${WK_SESSION_USER:-}" ] || return 1
    id -u "$WK_SESSION_USER" >/dev/null 2>&1 || return 1
    echo "$WK_SESSION_USER"
}

# --- which DRM device the compositor is allowed to use ------------------------
# This board has two, and only one is a GPU: the discrete card drives the
# monitor, and the ASPEED BMC exposes a second, display-only `ast` device
# whose framebuffer the BMC serves over KVM-over-IP. Both sit on seat0, so a
# compositor left to enumerate for itself may pick either -- deciding
# whether a Speedometer number came from the GPU or a management chip.
# Every session below names its devices explicitly through WLR_DRM_DEVICES.
#
# The kernel driver is the discriminator, never the card number:
# /dev/dri/card1 is the ast here only by PCI enumeration order, which a
# card addition renumbers.
drm_driver() {
    local link
    link=$(readlink -f "/sys/class/drm/$1/device/driver" 2>/dev/null) || true
    [ -n "$link" ] && basename "$link" || echo none
}

# Every card node, connectors excluded: cardN-CONNECTOR-M is not a device.
drm_cards() {
    local d c
    for d in /sys/class/drm/card[0-9]*; do
        [ -d "$d" ] || continue
        c=$(basename "$d")
        case "$c" in *-*) continue ;; esac
        echo "$c"
    done
}

bmc_card() {
    local c
    for c in $(drm_cards); do
        [ "$(drm_driver "$c")" = ast ] && { echo "/dev/dri/$c"; return 0; }
    done
    return 1
}

gpu_card() {
    local c drv
    for c in $(drm_cards); do
        drv=$(drm_driver "$c")
        case "$drv" in ast|none) continue ;; esac
        [ -e "/dev/dri/$c" ] || continue
        echo "/dev/dri/$c"
        return 0
    done
    return 1
}

# --- removing a DRM device from every seat -----------------------------------
# gdm's compositor (mutter) has no per-process device allowlist the way
# cage's WLR_DRM_DEVICES gives the benchmark session -- the only lever is
# which devices logind hands to seat0 at all. Stripping the udev tags that
# make a device a seat member removes it from seat0 the same way unplugging
# it would. Not a distinct ID_SEAT instead: that makes logind create a real
# seat, and gdm starts a greeter on every seat it finds. The rule lives
# under /run, not /etc, so a crashed helper never leaves a device
# permanently hidden -- it disappears at the next boot regardless.
WK_SEAT_RULE=/run/udev/rules.d/72-wk-session-seat.rules
WK_DESKTOP_MODE_FILE=/run/wk-desktop-mode

# True if $1 (e.g. card2) is currently part of seat0's device tree -- what
# actually matters, since that's what a seat0 session can open, not the
# udev property (which says what was asked for). Anchored so "card2" cannot
# match "card2-DP-1", which grep's default substring matching would allow.
seat0_has_card() {
    loginctl seat-status seat0 2>/dev/null | grep -qE "drm:$1([^-[:alnum:]]|\$)"
}

# Every sysfs path a hide/restore needs to touch: the card and each of its
# cardN-CONNECTOR-M children. 71-seat.rules tags both with `seat` and
# `master-of-seat` (KERNEL=="card[0-9]*" matches a connector's name too), so
# a rule reaching only the bare card leaves every connector still on seat0.
_card_paths() {
    local card="$1" p
    for p in "/sys/class/drm/$card" "/sys/class/drm/$card"-*; do
        [ -e "$p" ] && echo "$p"
    done
}

# Re-processing a device through udev makes a rule change take effect for a
# device that already exists. "change" is tried first since it never
# touches the driver and is enough for logind to recompute the seat on
# every systemd tested; a synthetic remove+add is the stronger fallback, at
# the cost of the device briefly not existing.
# True once $1's presence on seat0 matches what's wanted ($2: 0 present, 1 absent).
_reseated() {
    if seat0_has_card "$1"; then [ "$2" != 1 ]; else [ "$2" = 1 ]; fi
}

_reseat() {
    local card="$1" want_absent="$2" i paths
    paths=$(_card_paths "$card")
    # shellcheck disable=SC2086
    udevadm trigger --action=change $paths 2>/dev/null || true
    udevadm settle --timeout=3 2>/dev/null || true
    for i in 1 2 3 4 5; do
        _reseated "$card" "$want_absent" && return 0
        sleep 0.2
    done

    # shellcheck disable=SC2086
    udevadm trigger --action=remove $paths 2>/dev/null || true
    # shellcheck disable=SC2086
    udevadm trigger --action=add    $paths 2>/dev/null || true
    udevadm settle --timeout=3 2>/dev/null || true
    for i in 1 2 3 4 5; do
        _reseated "$card" "$want_absent" && return 0
        sleep 0.2
    done
    return 1
}

# Hide $1 (a card basename) from seat0. Idempotent: re-hiding an already
# hidden card just rewrites the same rule and finds it already satisfied.
#
# Strips the device's seat tags rather than relocating it to a distinct
# ID_SEAT (see "removing a DRM device from every seat" above). Removing
# `master-of-seat` (what makes a device define a seat) and `seat` (what
# makes it a member of one) leaves the device with no seat whatsoever --
# nothing to enumerate, nowhere for gdm to open a second display.
seat_hide() {
    local card="$1"
    {
        printf 'SUBSYSTEM=="drm", KERNEL=="%s", TAG-="master-of-seat", TAG-="seat"\n' "$card"
        # The connectors are separate udev devices, each independently
        # tagged by 71-seat.rules, so they need their own line here.
        # seat_restore reads only the *first* KERNEL== value in this file,
        # which is why the plain card name comes first.
        printf 'SUBSYSTEM=="drm", KERNEL=="%s-*", TAG-="master-of-seat", TAG-="seat"\n' "$card"
    } > "$WK_SEAT_RULE"
    udevadm control --reload-rules
    _reseat "$card" 1
}

# Undo whatever hide is in effect, whether or not one actually is: callers
# use this as "make sure nothing is hidden", since which mode was active
# before a crash isn't something this helper remembers.
seat_restore() {
    local card=""
    [ -f "$WK_SEAT_RULE" ] && card=$(sed -n 's/.*KERNEL=="\([^"]*\)".*/\1/p' "$WK_SEAT_RULE" | head -1)
    rm -f "$WK_SEAT_RULE"
    udevadm control --reload-rules
    [ -n "$card" ] || return 0
    _reseat "$card" 0 \
        || echo "wk-quiesce-priv: warning: could not confirm $card is back on seat0" >&2
}

# --- making gdm run a compositor the seat hide can actually reach -------------
# Hiding a device from seat0 only constrains a compositor that asks logind
# for its devices. mutter does; Xorg with NVIDIA's own DDX does not, and
# that is this machine's default greeter: 61-gdm.rules lands every driver
# version on Xorg when modeset=Y, and that DDX drives the card through
# /dev/nvidia0 etc -- plain character devices with no seat tags for
# TAG-="seat" to remove. So a seat0 hide can report success while Xorg
# goes on enumerating the monitor through a device it never touched, and
# the desktop lands on the real display anyway.
#
# So the greeter is put on Wayland instead, where the mechanism is real,
# via gdm's own runtime-config tool -- landing the override in /run, gone
# at the next boot, the same crash-safety the seat rule gets.
GDM_RUNTIME_CONFIG=/usr/libexec/gdm-runtime-config

gdm_prefer_wayland() {
    [ -x "$GDM_RUNTIME_CONFIG" ] || return 1
    "$GDM_RUNTIME_CONFIG" set daemon WaylandEnable true || return 1
    "$GDM_RUNTIME_CONFIG" set daemon PreferredDisplayServer wayland || return 1
}

# The greeter's session type, once it has one: an x11 greeter means the
# device hide did not apply and the desktop is on whichever chip NVIDIA's
# DDX felt like driving. Better said out loud than discovered at the monitor.
greeter_type() {
    local i sid class typ
    for i in $(seq 1 40); do
        for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '$4 == "seat0" {print $1}'); do
            class=$(loginctl show-session "$sid" -p Class --value 2>/dev/null || echo)
            [ "$class" = greeter ] || continue
            typ=$(loginctl show-session "$sid" -p Type --value 2>/dev/null || echo)
            [ -n "$typ" ] && { echo "$typ"; return 0; }
        done
        sleep 0.25
    done
    return 1
}

# `systemctl stop` on gdm returning doesn't mean logind is done tearing the
# session down -- PAM cleanup, D-Bus deregistration and VT release continue
# briefly after. Claiming the seat again before that settles races gdm's
# own Xorg wrapper, which fails its console-user check and crash-loops.
# Waiting for seat0 to actually be empty is the fact that matters, not a
# fixed sleep guessing how long cleanup takes.
wait_seat0_quiet() {
    local i
    for i in $(seq 1 20); do
        loginctl list-sessions --no-legend 2>/dev/null | awk '$4 == "seat0"' | grep -q . || return 0
        sleep 0.25
    done
    return 1
}

# --- turning the outputs off, as opposed to painting them black --------------
# Holding DRM master with nothing to draw is only half of `off`: a held
# CRTC still scans out a real mode, so the monitor displays it. Nothing in
# that path asks the connector to power down, and cage 0.1.5 has no idle
# timeout or DPMS option. What it does export is `wlr-output-management`
# v4, whose disable_head is an atomic commit with the CRTC off (enabled ->
# disabled, dpms On -> Off) -- ordinary modesetting, unlike fbcon's
# `fb_blank` (see session_off, below), which does nothing on this driver.
#
# Disabling every head does not release the device: wlroots keeps the DRM
# fd open, so fbcon still cannot repaint. Both halves are needed -- the
# placeholder to keep the console out, this to go dark.
#
# wlr-randr runs as the session user, not root: a root client on a
# user-owned socket is exactly the shape this file avoids elsewhere.
WLR_RANDR=/usr/bin/wlr-randr

# Connector names as wlr-randr prints them: one per unindented line, name
# then a quoted description. Matches the whole first field, not a NAME-N
# pattern -- `HDMI-A-1` has a letter where that wants a digit.
_heads() {
    local socket="$1" uid="$2" gid="$3" out
    out=$(setpriv --reuid="$uid" --regid="$gid" --clear-groups \
              env WAYLAND_DISPLAY="$socket" "$WLR_RANDR" 2>/dev/null) || true
    printf '%s\n' "$out" | sed -n 's/^\([^[:space:]][^[:space:]]*\) ".*/\1/p'
}

outputs_off() {
    local socket="$1" user="$2" uid gid head rc=0 any=""
    uid=$(id -u "$user")
    gid=$(id -g "$user")

    if [ ! -x "$WLR_RANDR" ]; then
        echo "wk-quiesce-priv: $WLR_RANDR is missing -- the screen will be black but still" >&2
        echo "                 powered; install it: ./setup --stage tools" >&2
        return 1
    fi

    # The socket appearing is not the outputs being up: wlroots binds the
    # seat and enumerates connectors after it starts listening, so asking
    # straight away can see no heads -- otherwise correctly a failure.
    local heads="" i
    for i in 1 2 3 4 5 6 7 8; do
        heads=$(_heads "$socket" "$uid" "$gid")
        [ -n "$heads" ] && break
        sleep 0.25
    done

    for head in $heads; do
        any=1
        setpriv --reuid="$uid" --regid="$gid" --clear-groups \
            env WAYLAND_DISPLAY="$socket" "$WLR_RANDR" --output "$head" --off \
            >/dev/null 2>&1 || rc=1
    done

    # No heads at all is a failure, not a job already done: the compositor
    # took no output, and every connector shows whatever was last latched.
    [ -n "$any" ] || return 1
    return "$rc"
}

# Which connected connectors are still driven. Read from sysfs, not the
# compositor, since the claim being checked is about hardware. `dpms` alone
# is not enough (it reads On for a CRTC that was never enabled), so only
# `enabled`+`On` counts as lit.
outputs_power() {
    local conn name
    for conn in /sys/class/drm/card[0-9]*-*; do
        [ -d "$conn" ] || continue
        [ "$(cat "$conn/status" 2>/dev/null)" = connected ] || continue
        name=$(basename "$conn")
        if [ "$(cat "$conn/enabled" 2>/dev/null)" = enabled ] \
           && [ "$(cat "$conn/dpms" 2>/dev/null)" = On ]; then
            printf '%s=on ' "${name#card[0-9]*-}"
        else
            printf '%s=off ' "${name#card[0-9]*-}"
        fi
    done
    echo
}

# $1 is a mode set by the dispatch table at the bottom of this file, never
# by the caller: each verb passes one fixed literal.
#
#   gpu  the GPU alone. What a benchmark runs on, and the default.
#   bmc  the BMC's `ast` chip alone, software-rendered (`pixman`, named
#        explicitly, since ast has no render node): the debugging session,
#        watchable over KVM-over-IP, never a number to compare with
#        anything. GPU-render/BMC-scanout mirroring doesn't work on this
#        board's NVIDIA+ast pairing (every frame fails "EGLImage not
#        supported", silently, without even the compositor refusing to
#        start), so software rendering is what actually shows something.
#   off  the screen-off placeholder `session-off` starts, not an absence of
#        one: `fb_blank` never reaches real hardware on this board's NVIDIA
#        driver, so releasing DRM master leaves the last latched frame on
#        screen forever. Holding master plus `outputs_off` (above) is what
#        actually reaches dark.
#
#        Device list is the GPU alone, not both chips: wlroots' pixman
#        can't copy frames to a secondary with no render node, so naming
#        both silently drops one head. `off` leaves the BMC's chip showing
#        whatever was last latched; `wk session status` prints `lit:` so
#        that's visible rather than assumed.
session_on() {
    local mode="${1:-gpu}"
    local user uid runtime gpu bmc devices cage_args renderer allow_sw
    user=$(session_user) || { echo "wk-quiesce-priv: no session user configured in $WK_SESSION_CONF" >&2; exit 1; }
    uid=$(id -u "$user")
    runtime="/run/user/$uid/wk/display"

    gpu=$(gpu_card) || gpu=""
    bmc=$(bmc_card) || bmc=""

    # WLR_RENDERER is pinned rather than left to auto-detect, which tries
    # GLES2 first regardless of fit; WLR_RENDERER_ALLOW_SOFTWARE only
    # *permits* landing on a software renderer, it doesn't choose one.
    # Against a device with no render node (the ast), GLES2 just fails with
    # no second attempt: the compositor comes up, the output exists at the
    # protocol level, and nothing gets drawn. Naming `pixman` outright is
    # what actually gets a picture.
    renderer=gles2
    allow_sw=""
    cage_args="-d"
    case "$mode" in
        gpu)
            [ -n "$gpu" ] || { echo "wk-quiesce-priv: no GPU DRM device found" >&2; exit 1; }
            devices="$gpu"
            ;;
        bmc)
            [ -n "$bmc" ] || { echo "wk-quiesce-priv: no BMC (ast) DRM device found" >&2; exit 1; }
            devices="$bmc"
            renderer=pixman
            # Redundant now that pixman is named explicitly, but no downside
            # to setting it either.
            allow_sw=1
            ;;
        off)
            # One device, not both: listing both drops the second silently
            # (see the mode comment above), overstating what the mode file
            # claims. The GPU is the one that matters -- it drives the
            # monitor and is the one fbcon would repaint.
            devices="$gpu"
            [ -n "$devices" ] || devices="$bmc"
            [ -n "$devices" ] || { echo "wk-quiesce-priv: no DRM device found" >&2; exit 1; }
            renderer=pixman
            allow_sw=1
            ;;
        *)
            echo "wk-quiesce-priv: unknown session mode $mode" >&2; exit 1 ;;
    esac

    # The display manager holds seat0 through its greeter, and two things
    # cannot own DRM master at once.
    if systemctl is-active --quiet gdm3 2>/dev/null || systemctl is-active --quiet gdm 2>/dev/null; then
        systemctl stop gdm3 2>/dev/null || systemctl stop gdm 2>/dev/null || true
        wait_seat0_quiet \
            || echo "wk-quiesce-priv: warning: seat0 still had a session after stopping gdm" >&2
        echo "stopped the display manager"
    fi

    # A gdm session may have left a device hidden from seat0 (session-gdm-bmc
    # hides the GPU, session-gdm hides the ast), and libseat refuses to hand
    # cage a hidden device regardless of what WLR_DRM_DEVICES asks for.
    seat_restore
    rm -f "$WK_DESKTOP_MODE_FILE"

    # nvidia-drm without modesetting has no KMS to drive; the failure
    # otherwise is a bare "no DRM device" that says nothing about why.
    if [ -r /sys/module/nvidia_drm/parameters/modeset ]; then
        if [ "$(cat /sys/module/nvidia_drm/parameters/modeset)" != Y ]; then
            echo "warning: nvidia-drm modeset is off; the compositor cannot take the display" >&2
            echo "         add 'options nvidia-drm modeset=1' to /etc/modprobe.d and reboot" >&2
        fi
    fi

    install -d -o "$user" -m 0700 "/run/user/$uid/wk" 2>/dev/null || true
    install -d -o "$user" -m 0700 "$runtime" 2>/dev/null || true

    systemctl stop "$WK_SESSION_UNIT" 2>/dev/null || true

    # A dedicated XDG_RUNTIME_DIR for the compositor, so the workspace can
    # be given just the Wayland socket instead of the user's whole runtime
    # directory (where the session D-Bus socket lives).
    #
    # Exported inside the ExecStart shell, not passed with --setenv:
    # PAMName=login runs pam_systemd, which sets XDG_RUNTIME_DIR itself, and
    # relying on which of the two wins is undocumented. If PAM won, the
    # socket would appear where the workspace deliberately cannot see it,
    # looking like "the compositor started but the benchmark can't find a
    # display".
    local setenv=(--setenv=XDG_SESSION_TYPE=wayland
                  --setenv=WLR_NO_HARDWARE_CURSORS=1
                  "--setenv=WLR_DRM_DEVICES=$devices")
    [ -n "$renderer" ] && setenv+=("--setenv=WLR_RENDERER=$renderer")
    [ -n "$allow_sw" ] && setenv+=(--setenv=WLR_RENDERER_ALLOW_SOFTWARE=1)

    systemd-run --unit="$WK_SESSION_UNIT" --collect \
        --description="wk benchmark compositor" \
        --uid="$user" \
        --property=PAMName=login \
        --property=TTYPath="$WK_SESSION_TTY" \
        --property=StandardInput=tty-force \
        --property=StandardOutput=journal \
        --property=StandardError=journal \
        --property=Restart=no \
        "${setenv[@]}" \
        /bin/sh -c "export XDG_RUNTIME_DIR='$runtime'; exec /usr/bin/cage $cage_args -- /usr/bin/sleep infinity" \
        >/dev/null

    # The socket appearing is the only evidence that matters.
    for _ in $(seq 1 40); do
        [ -S "$runtime/wayland-0" ] && break
        sleep 0.25
    done

    if [ -S "$runtime/wayland-0" ]; then
        # Recorded where anything can read it: a benchmark must never run
        # against a BMC/software session that looks like a GPU one from
        # the socket alone.
        printf '%s\n' "$mode" > "$WK_SESSION_MODE_FILE"
        chmod 0644 "$WK_SESSION_MODE_FILE"
        echo "compositor up: $runtime/wayland-0"
        echo "mode: $mode  scanout: $devices  render: $devices"

        # `off` is the placeholder *plus* the modeset that darkens it. Warn,
        # don't fail: a black-but-lit screen beats no session holding the
        # console off at all.
        if [ "$mode" = off ]; then
            outputs_off "$runtime/wayland-0" "$user" \
                || echo "wk-quiesce-priv: warning: could not power the outputs down --" \
                        "the screen is black but still lit" >&2
            echo "power: $(outputs_power)"
        fi
    else
        rm -f "$WK_SESSION_MODE_FILE"
        echo "compositor did not come up; journalctl -u $WK_SESSION_UNIT" >&2
        exit 1
    fi
}

# $1 is gpu or bmc, same convention as session_on, for a real desktop.
# mutter has nothing like cage's WLR_DRM_DEVICES, so the only way to hand
# it exactly one device is to keep the other off seat0 entirely: `gpu`
# hides the ast, `bmc` hides the GPU (mutter's only choice becomes the
# ast, software-rendered, watchable over KVM-over-IP).
session_gdm() {
    local mode="${1:-gpu}"
    local gpu bmc hide _u _r _t
    gpu=$(gpu_card) || gpu=""
    bmc=$(bmc_card) || bmc=""

    case "$mode" in
        gpu)
            [ -n "$gpu" ] || { echo "wk-quiesce-priv: no GPU DRM device found" >&2; exit 1; }
            hide="$bmc"
            ;;
        bmc)
            [ -n "$bmc" ] || { echo "wk-quiesce-priv: no BMC (ast) DRM device found" >&2; exit 1; }
            hide="$gpu"
            ;;
        *)
            echo "wk-quiesce-priv: unknown desktop mode $mode" >&2; exit 1 ;;
    esac

    # Nothing may hold DRM master while the seat's device list changes.
    systemctl stop "$WK_SESSION_UNIT" 2>/dev/null || true
    # And the socket goes with it: left behind, it's indistinguishable from
    # a running compositor to anything checking for the file.
    if _u=$(session_user); then
        _r="/run/user/$(id -u "$_u")/wk/display"
        rm -f "$_r/wayland-0" "$_r/wayland-0.lock"
    fi
    rm -f "$WK_SESSION_MODE_FILE"
    systemctl stop gdm3 2>/dev/null || systemctl stop gdm 2>/dev/null || true
    wait_seat0_quiet \
        || echo "wk-quiesce-priv: warning: seat0 still had a session after stopping gdm" >&2

    seat_restore
    if [ -n "$hide" ]; then
        seat_hide "$(basename "$hide")" \
            || echo "wk-quiesce-priv: warning: could not confirm $(basename "$hide") left seat0 -- gdm may still see it" >&2
    fi

    printf '%s\n' "$mode" > "$WK_DESKTOP_MODE_FILE"
    chmod 0644 "$WK_DESKTOP_MODE_FILE"

    # Before starting it, not after: gdm reads its config once, at startup.
    gdm_prefer_wayland \
        || echo "wk-quiesce-priv: warning: could not set gdm's display server to wayland" >&2

    systemctl start gdm3 2>/dev/null || systemctl start gdm 2>/dev/null \
        || { echo "wk-quiesce-priv: gdm did not start; journalctl -u gdm" >&2; exit 1; }

    if [ -n "$hide" ]; then
        echo "gdm starting: mode $mode  hidden from seat0: $(basename "$hide")"
    else
        echo "gdm starting: mode $mode"
    fi

    # The mode is only as real as the greeter's session type: on x11 the
    # hide never reaches the compositor, so `mode` is intent, not fact.
    if _t=$(greeter_type); then
        echo "greeter: $_t"
        [ "$_t" = wayland ] || {
            echo "wk-quiesce-priv: warning: the greeter came up on $_t, not wayland --" >&2
            echo "                 hiding a device from seat0 does not constrain NVIDIA's" >&2
            echo "                 Xorg driver, so mode '$mode' is not being enforced" >&2
        }
    else
        echo "wk-quiesce-priv: warning: no greeter session appeared on seat0" >&2
    fi
}

# Tear down to nothing: no compositor, no gdm, no hide, no mode file. For
# callers about to claim the seat for something else -- `session-off`
# (below) deliberately is not one of them.
session_stop() {
    local user uid runtime
    systemctl stop "$WK_SESSION_UNIT" 2>/dev/null || true
    systemctl stop gdm3 2>/dev/null || systemctl stop gdm 2>/dev/null || true

    # Left in place, the socket looks exactly like a running session.
    if user=$(session_user); then
        uid=$(id -u "$user")
        runtime="/run/user/$uid/wk/display"
        rm -f "$runtime/wayland-0" "$runtime/wayland-0.lock"
    fi
    rm -f "$WK_SESSION_MODE_FILE" "$WK_DESKTOP_MODE_FILE"
    seat_restore
}

# `session off` is not just session_stop -- tearing everything down and
# trusting fbcon to blank the now-masterless outputs. On this board's
# NVIDIA driver that trust is misplaced: fb_blank stops console redraw but
# never reaches real hardware, so the last latched frame stays on the
# monitor indefinitely, invisible to sysfs (which faithfully reports
# "blanked" throughout). Holding DRM master open with nothing to draw is
# what actually reaches a dark screen here.
session_off() {
    session_stop
    session_on off
}

session_status() {
    local user uid runtime
    user=$(session_user) || { echo "session:   no user configured"; return 0; }
    uid=$(id -u "$user")
    runtime="/run/user/$uid/wk/display"
    # Captured into a value first: `systemctl is-active` prints its answer
    # *and* exits non-zero when inactive, so a `||` chain piped straight to
    # printf would repeat the format once per fallback line.
    local unit_state dm_state
    # `|| true` on each: systemctl is-active exits 3 for an inactive unit,
    # and under `set -o pipefail`/`set -e` that would end the function
    # before it prints anything.
    unit_state=$(systemctl is-active "$WK_SESSION_UNIT" 2>/dev/null | head -1 || true)
    [ -n "$unit_state" ] || unit_state=unknown
    dm_state=$(systemctl is-active gdm3 2>/dev/null | head -1 || true)
    [ -n "$dm_state" ] || dm_state=$(systemctl is-active gdm 2>/dev/null | head -1 || true)
    [ -n "$dm_state" ] || dm_state=unknown

    printf 'session:   %s\n' "$unit_state"
    printf 'socket:    %s\n' "$([ -S "$runtime/wayland-0" ] && echo "$runtime/wayland-0" || echo none)"
    printf 'dm:        %s\n' "$dm_state"
    printf 'modeset:   %s\n' "$(cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null || echo n/a)"
    printf 'mode:      %s\n' "$(cat "$WK_SESSION_MODE_FILE" 2>/dev/null || echo none)"
    printf 'desktop:   %s\n' "$(cat "$WK_DESKTOP_MODE_FILE" 2>/dev/null || echo none)"
    printf 'power:     %s\n' "$(outputs_power)"
    printf 'gpu:       %s\n' "$(gpu_card || echo none)"
    printf 'bmc:       %s\n' "$(bmc_card || echo none)"
    if [ -f "$WK_SEAT_RULE" ]; then
        printf 'seat-hide: %s\n' "$(sed -n 's/.*KERNEL=="\([^"]*\)".*/\1/p' "$WK_SEAT_RULE" | head -1)"
    fi
}

case "$os:$action" in
    Darwin:on)     macos_on ;;
    Darwin:status) macos_status ;;
    Darwin:*)      macos_off ;;
    Linux:session-on)      session_on gpu ;;
    Linux:session-on-bmc)  session_on bmc ;;
    Linux:session-gdm)     session_gdm gpu ;;
    Linux:session-gdm-bmc) session_gdm bmc ;;
    Linux:session-stop)    session_stop ;;
    Linux:session-off)     session_off ;;
    Linux:session-status)  session_status ;;
    Linux:perf-on)  perf_on ;;
    Linux:perf-off) perf_off ;;
    Linux:on)      linux_on ;;
    Linux:status)  linux_status ;;
    Linux:*)       linux_off ;;
    *) echo "wk-quiesce-priv: unsupported OS $os" >&2; exit 1 ;;
esac
