#!/bin/bash
# Root via a NOPASSWD sudoers rule naming this exact path (Linux ignores setuid on a #!
# script), forever, so the grant is bounded by shape: a fixed verb list, no passthrough,
# no eval, no argument that becomes part of a command, nothing read from the environment
# (env_reset plus the PATH below), one verb per configuration each spelling a fixed
# device list and command line, the session user from a root-owned file rather than an
# argument, and every action undone by `off` -- what an unrecognised argument runs.

set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

[ "$(id -u)" -eq 0 ] || { echo "wk-quiesce-priv: must run as root" >&2; exit 1; }

os=$(uname -s)
action="${1:-off}"

macos_on() {
    mdutil -a -i off >/dev/null 2>&1 || true
    tmutil stopbackup >/dev/null 2>&1 || true
    softwareupdate --schedule off >/dev/null 2>&1 || true
    pmset -a lowpowermode 0 >/dev/null 2>&1 || true
    echo "quiesced: spotlight off, backups stopped, updates off, low-power off"
}

macos_off() {
    mdutil -a -i on >/dev/null 2>&1 || true
    softwareupdate --schedule on >/dev/null 2>&1 || true
    echo "restored: spotlight on, updates on"
}

macos_status() {
    printf 'spotlight: %s\n' "$(mdutil -a -s 2>/dev/null | tr '\n' ' ')"
    printf 'lowpower:  %s\n' "$(pmset -g | awk '/lowpowermode/ {print $2}')"
}

linux_on() {
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo performance > "$g" || true
    done
    [ -w /sys/devices/system/cpu/intel_pstate/no_turbo ] && \
        echo 1 > /sys/devices/system/cpu/intel_pstate/no_turbo || true
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && \
        echo 0 > /sys/devices/system/cpu/cpufreq/boost || true
    sysctl -q -w kernel.perf_event_paranoid=-1 || true
    sysctl -q -w kernel.randomize_va_space=0 || true
    systemctl stop packagekit.service >/dev/null 2>&1 || true
    echo "quiesced: performance governor, turbo off, perf unrestricted, ASLR off"
}

linux_off() {
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo schedutil > "$g" || true
    done
    [ -w /sys/devices/system/cpu/intel_pstate/no_turbo ] && \
        echo 0 > /sys/devices/system/cpu/intel_pstate/no_turbo || true
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && \
        echo 1 > /sys/devices/system/cpu/cpufreq/boost || true
    sysctl -q -w kernel.perf_event_paranoid=2 || true
    sysctl -q -w kernel.randomize_va_space=2 || true
    echo "restored: schedutil governor, turbo on, perf restricted, ASLR on"
}

linux_status() {
    printf 'governor:  %s\n' "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo n/a)"
    printf 'paranoid:  %s\n' "$(sysctl -n kernel.perf_event_paranoid 2>/dev/null || echo n/a)"
    printf 'aslr:      %s\n' "$(sysctl -n kernel.randomize_va_space 2>/dev/null || echo n/a)"
}

# 1 is the least-restrictive paranoid value needing no capability the container lacks.
perf_on() {
    sysctl -q -w kernel.perf_event_paranoid=1 \
        || { echo "wk-quiesce-priv: could not set kernel.perf_event_paranoid" >&2; exit 1; }
    printf 'perf_event_paranoid: %s (samply/perf unrestricted)\n' "$(sysctl -n kernel.perf_event_paranoid)"
}

perf_off() {
    sysctl -q -w kernel.perf_event_paranoid=2 \
        || { echo "wk-quiesce-priv: could not restore kernel.perf_event_paranoid" >&2; exit 1; }
    printf 'perf_event_paranoid: %s (restored)\n' "$(sysctl -n kernel.perf_event_paranoid)"
}

# PAMName=login plus a TTY: without a logind session libseat refuses cage DRM master.
WK_SESSION_CONF=/usr/local/libexec/wk-session.env
WK_SESSION_UNIT=wk-session
WK_SESSION_TTY=/dev/tty2
WK_SESSION_MODE_FILE=/run/wk-session-mode

session_user() {
    [ -r "$WK_SESSION_CONF" ] || return 1
    # shellcheck disable=SC1090
    # WK_SESSION_USER comes from this root-owned file, never the environment.
    . "$WK_SESSION_CONF"
    [ -n "${WK_SESSION_USER:-}" ] || return 1
    id -u "$WK_SESSION_USER" >/dev/null 2>&1 || return 1
    echo "$WK_SESSION_USER"
}

# The kernel driver discriminates the GPU from the BMC's `ast`, never the card number.
drm_driver() {
    local link
    link=$(readlink -f "/sys/class/drm/$1/device/driver" 2>/dev/null) || true
    [ -n "$link" ] && basename "$link" || echo none
}

drm_cards() {
    local d c
    for d in /sys/class/drm/card[0-9]*; do
        [ -d "$d" ] || continue
        c=$(basename "$d")
        case "$c" in *-*) continue ;; esac
        echo "$c"
    done
}

bmc_card() {
    local c
    for c in $(drm_cards); do
        [ "$(drm_driver "$c")" = ast ] && { echo "/dev/dri/$c"; return 0; }
    done
    return 1
}

gpu_card() {
    local c drv
    for c in $(drm_cards); do
        drv=$(drm_driver "$c")
        case "$drv" in ast|none) continue ;; esac
        [ -e "/dev/dri/$c" ] || continue
        echo "/dev/dri/$c"
        return 0
    done
    return 1
}

# Untagging, not a distinct ID_SEAT (logind would make a real seat, and gdm greets every
# seat it finds); under /run, so a crash never hides a device past the next boot.
WK_SEAT_RULE=/run/udev/rules.d/72-wk-session-seat.rules
WK_DESKTOP_MODE_FILE=/run/wk-desktop-mode

# seat0's device tree, not the udev property; anchored so "card2" misses "card2-DP-1".
seat0_has_card() {
    loginctl seat-status seat0 2>/dev/null | grep -qE "drm:$1([^-[:alnum:]]|\$)"
}

# 71-seat.rules tags the connectors too, so untagging the bare card leaves them seated.
_card_paths() {
    local card="$1" p
    for p in "/sys/class/drm/$card" "/sys/class/drm/$card"-*; do
        [ -e "$p" ] && echo "$p"
    done
}

# "change" is enough for logind to recompute the seat on every systemd tested.
_reseated() {
    if seat0_has_card "$1"; then [ "$2" != 1 ]; else [ "$2" = 1 ]; fi
}

_reseat() {
    local card="$1" want_absent="$2" i paths
    paths=$(_card_paths "$card")
    # shellcheck disable=SC2086
    udevadm trigger --action=change $paths 2>/dev/null || true
    udevadm settle --timeout=3 2>/dev/null || true
    for i in 1 2 3 4 5; do
        _reseated "$card" "$want_absent" && return 0
        sleep 0.2
    done

    # shellcheck disable=SC2086
    udevadm trigger --action=remove $paths 2>/dev/null || true
    # shellcheck disable=SC2086
    udevadm trigger --action=add    $paths 2>/dev/null || true
    udevadm settle --timeout=3 2>/dev/null || true
    for i in 1 2 3 4 5; do
        _reseated "$card" "$want_absent" && return 0
        sleep 0.2
    done
    return 1
}

# `master-of-seat` makes a device define a seat, `seat` makes it a member of one.
seat_hide() {
    local card="$1"
    {
        printf 'SUBSYSTEM=="drm", KERNEL=="%s", TAG-="master-of-seat", TAG-="seat"\n' "$card"
        # seat_restore reads the first KERNEL== value, so the card comes first.
        printf 'SUBSYSTEM=="drm", KERNEL=="%s-*", TAG-="master-of-seat", TAG-="seat"\n' "$card"
    } > "$WK_SEAT_RULE"
    udevadm control --reload-rules
    _reseat "$card" 1
}

seat_restore() {
    local card=""
    [ -f "$WK_SEAT_RULE" ] && card=$(sed -n 's/.*KERNEL=="\([^"]*\)".*/\1/p' "$WK_SEAT_RULE" | head -1)
    rm -f "$WK_SEAT_RULE"
    udevadm control --reload-rules
    [ -n "$card" ] || return 0
    _reseat "$card" 0 \
        || echo "wk-quiesce-priv: warning: could not confirm $card is back on seat0" >&2
}

GDM_RUNTIME_CONFIG=/usr/libexec/gdm-runtime-config

gdm_prefer_wayland() {
    [ -x "$GDM_RUNTIME_CONFIG" ] || return 1
    "$GDM_RUNTIME_CONFIG" set daemon WaylandEnable true || return 1
    "$GDM_RUNTIME_CONFIG" set daemon PreferredDisplayServer wayland || return 1
}

greeter_type() {
    local i sid class typ
    for i in $(seq 1 40); do
        for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '$4 == "seat0" {print $1}'); do
            class=$(loginctl show-session "$sid" -p Class --value 2>/dev/null || echo)
            [ "$class" = greeter ] || continue
            typ=$(loginctl show-session "$sid" -p Type --value 2>/dev/null || echo)
            [ -n "$typ" ] && { echo "$typ"; return 0; }
        done
        sleep 0.25
    done
    return 1
}

# `systemctl stop` on gdm returns before logind finishes, and claiming the seat that
# early races gdm's Xorg wrapper into a crash loop.
wait_seat0_quiet() {
    local i
    for i in $(seq 1 20); do
        loginctl list-sessions --no-legend 2>/dev/null | awk '$4 == "seat0"' | grep -q . || return 0
        sleep 0.25
    done
    return 1
}

# cage 0.1.5 has no DPMS option; wlr-output-management v4's disable_head commits
# CRTC-off, and wlr-randr runs as the session user.
WLR_RANDR=/usr/bin/wlr-randr

# One head per unindented line: name, then a quoted description. HDMI-A-1 is not NAME-N.
_heads() {
    local socket="$1" uid="$2" gid="$3" out
    out=$(setpriv --reuid="$uid" --regid="$gid" --clear-groups \
              env WAYLAND_DISPLAY="$socket" "$WLR_RANDR" 2>/dev/null) || true
    printf '%s\n' "$out" | sed -n 's/^\([^[:space:]][^[:space:]]*\) ".*/\1/p'
}

outputs_off() {
    local socket="$1" user="$2" uid gid head rc=0 any=""
    uid=$(id -u "$user")
    gid=$(id -g "$user")

    if [ ! -x "$WLR_RANDR" ]; then
        echo "wk-quiesce-priv: $WLR_RANDR is missing -- the screen will be black but still" >&2
        echo "                 powered; install it: ./setup --stage tools" >&2
        return 1
    fi

    # wlroots enumerates connectors after it starts listening, so an early ask sees none.
    local heads="" i
    for i in 1 2 3 4 5 6 7 8; do
        heads=$(_heads "$socket" "$uid" "$gid")
        [ -n "$heads" ] && break
        sleep 0.25
    done

    for head in $heads; do
        any=1
        setpriv --reuid="$uid" --regid="$gid" --clear-groups \
            env WAYLAND_DISPLAY="$socket" "$WLR_RANDR" --output "$head" --off \
            >/dev/null 2>&1 || rc=1
    done

    [ -n "$any" ] || return 1
    return "$rc"
}

# `dpms` alone reads On for a CRTC never enabled, so only `enabled`+`On` counts as lit.
outputs_power() {
    local conn name
    for conn in /sys/class/drm/card[0-9]*-*; do
        [ -d "$conn" ] || continue
        [ "$(cat "$conn/status" 2>/dev/null)" = connected ] || continue
        name=$(basename "$conn")
        if [ "$(cat "$conn/enabled" 2>/dev/null)" = enabled ] \
           && [ "$(cat "$conn/dpms" 2>/dev/null)" = On ]; then
            printf '%s=on ' "${name#card[0-9]*-}"
        else
            printf '%s=off ' "${name#card[0-9]*-}"
        fi
    done
    echo
}

# $1 is a fixed literal from the dispatch table at the bottom, never from the caller.
# GPU-render/BMC-scanout mirroring fails silently on this NVIDIA+ast pairing -- every
# frame "EGLImage not supported" -- so no mode drives both devices.
session_on() {
    local mode="${1:-gpu}"
    local user uid runtime gpu bmc devices cage_args renderer allow_sw
    user=$(session_user) || { echo "wk-quiesce-priv: no session user configured in $WK_SESSION_CONF" >&2; exit 1; }
    uid=$(id -u "$user")
    runtime="/run/user/$uid/wk/display"

    gpu=$(gpu_card) || gpu=""
    bmc=$(bmc_card) || bmc=""

    # Pinned: auto-detect tries GLES2, which fails on the ast and draws nothing.
    renderer=gles2
    allow_sw=""
    cage_args="-d"
    case "$mode" in
        gpu)
            [ -n "$gpu" ] || { echo "wk-quiesce-priv: no GPU DRM device found" >&2; exit 1; }
            devices="$gpu"
            ;;
        bmc)
            [ -n "$bmc" ] || { echo "wk-quiesce-priv: no BMC (ast) DRM device found" >&2; exit 1; }
            devices="$bmc"
            renderer=pixman
            allow_sw=1
            ;;
        off)
            devices="$gpu"
            [ -n "$devices" ] || devices="$bmc"
            [ -n "$devices" ] || { echo "wk-quiesce-priv: no DRM device found" >&2; exit 1; }
            renderer=pixman
            allow_sw=1
            ;;
        *)
            echo "wk-quiesce-priv: unknown session mode $mode" >&2; exit 1 ;;
    esac

    if systemctl is-active --quiet gdm3 2>/dev/null || systemctl is-active --quiet gdm 2>/dev/null; then
        systemctl stop gdm3 2>/dev/null || systemctl stop gdm 2>/dev/null || true
        wait_seat0_quiet \
            || echo "wk-quiesce-priv: warning: seat0 still had a session after stopping gdm" >&2
        echo "stopped the display manager"
    fi

    # libseat refuses cage a device gdm left hidden, whatever WLR_DRM_DEVICES asks for.
    seat_restore
    rm -f "$WK_DESKTOP_MODE_FILE"

    if [ -r /sys/module/nvidia_drm/parameters/modeset ]; then
        if [ "$(cat /sys/module/nvidia_drm/parameters/modeset)" != Y ]; then
            echo "warning: nvidia-drm modeset is off; the compositor cannot take the display" >&2
            echo "         add 'options nvidia-drm modeset=1' to /etc/modprobe.d and reboot" >&2
        fi
    fi

    install -d -o "$user" -m 0700 "/run/user/$uid/wk" 2>/dev/null || true
    install -d -o "$user" -m 0700 "$runtime" 2>/dev/null || true

    systemctl stop "$WK_SESSION_UNIT" 2>/dev/null || true

    # Exported in the ExecStart shell: pam_systemd sets XDG_RUNTIME_DIR too.
    local setenv=(--setenv=XDG_SESSION_TYPE=wayland
                  --setenv=WLR_NO_HARDWARE_CURSORS=1
                  "--setenv=WLR_DRM_DEVICES=$devices")
    [ -n "$renderer" ] && setenv+=("--setenv=WLR_RENDERER=$renderer")
    [ -n "$allow_sw" ] && setenv+=(--setenv=WLR_RENDERER_ALLOW_SOFTWARE=1)

    systemd-run --unit="$WK_SESSION_UNIT" --collect \
        --description="wk benchmark compositor" \
        --uid="$user" \
        --property=PAMName=login \
        --property=TTYPath="$WK_SESSION_TTY" \
        --property=StandardInput=tty-force \
        --property=StandardOutput=journal \
        --property=StandardError=journal \
        --property=Restart=no \
        "${setenv[@]}" \
        /bin/sh -c "export XDG_RUNTIME_DIR='$runtime'; exec /usr/bin/cage $cage_args -- /usr/bin/sleep infinity" \
        >/dev/null

    for _ in $(seq 1 40); do
        [ -S "$runtime/wayland-0" ] && break
        sleep 0.25
    done

    if [ -S "$runtime/wayland-0" ]; then
        printf '%s\n' "$mode" > "$WK_SESSION_MODE_FILE"
        chmod 0644 "$WK_SESSION_MODE_FILE"
        echo "compositor up: $runtime/wayland-0"
        echo "mode: $mode  scanout: $devices  render: $devices"

        if [ "$mode" = off ]; then
            outputs_off "$runtime/wayland-0" "$user" \
                || echo "wk-quiesce-priv: warning: could not power the outputs down --" \
                        "the screen is black but still lit" >&2
            echo "power: $(outputs_power)"
        fi
    else
        rm -f "$WK_SESSION_MODE_FILE"
        echo "compositor did not come up; journalctl -u $WK_SESSION_UNIT" >&2
        exit 1
    fi
}

session_gdm() {
    local mode="${1:-gpu}"
    local gpu bmc hide _u _r _t
    gpu=$(gpu_card) || gpu=""
    bmc=$(bmc_card) || bmc=""

    case "$mode" in
        gpu)
            [ -n "$gpu" ] || { echo "wk-quiesce-priv: no GPU DRM device found" >&2; exit 1; }
            hide="$bmc"
            ;;
        bmc)
            [ -n "$bmc" ] || { echo "wk-quiesce-priv: no BMC (ast) DRM device found" >&2; exit 1; }
            hide="$gpu"
            ;;
        *)
            echo "wk-quiesce-priv: unknown desktop mode $mode" >&2; exit 1 ;;
    esac

    # Nothing may hold DRM master while the seat's device list changes.
    systemctl stop "$WK_SESSION_UNIT" 2>/dev/null || true
    if _u=$(session_user); then
        _r="/run/user/$(id -u "$_u")/wk/display"
        rm -f "$_r/wayland-0" "$_r/wayland-0.lock"
    fi
    rm -f "$WK_SESSION_MODE_FILE"
    systemctl stop gdm3 2>/dev/null || systemctl stop gdm 2>/dev/null || true
    wait_seat0_quiet \
        || echo "wk-quiesce-priv: warning: seat0 still had a session after stopping gdm" >&2

    seat_restore
    if [ -n "$hide" ]; then
        seat_hide "$(basename "$hide")" \
            || echo "wk-quiesce-priv: warning: could not confirm $(basename "$hide") left seat0 -- gdm may still see it" >&2
    fi

    printf '%s\n' "$mode" > "$WK_DESKTOP_MODE_FILE"
    chmod 0644 "$WK_DESKTOP_MODE_FILE"

    # Before starting it: gdm reads its config once, at startup.
    gdm_prefer_wayland \
        || echo "wk-quiesce-priv: warning: could not set gdm's display server to wayland" >&2

    systemctl start gdm3 2>/dev/null || systemctl start gdm 2>/dev/null \
        || { echo "wk-quiesce-priv: gdm did not start; journalctl -u gdm" >&2; exit 1; }

    if [ -n "$hide" ]; then
        echo "gdm starting: mode $mode  hidden from seat0: $(basename "$hide")"
    else
        echo "gdm starting: mode $mode"
    fi

    if _t=$(greeter_type); then
        echo "greeter: $_t"
        [ "$_t" = wayland ] || {
            echo "wk-quiesce-priv: warning: the greeter came up on $_t, not wayland --" >&2
            echo "                 hiding a device from seat0 does not constrain NVIDIA's" >&2
            echo "                 Xorg driver, so mode '$mode' is not being enforced" >&2
        }
    else
        echo "wk-quiesce-priv: warning: no greeter session appeared on seat0" >&2
    fi
}

session_stop() {
    local user uid runtime
    systemctl stop "$WK_SESSION_UNIT" 2>/dev/null || true
    systemctl stop gdm3 2>/dev/null || systemctl stop gdm 2>/dev/null || true

    if user=$(session_user); then
        uid=$(id -u "$user")
        runtime="/run/user/$uid/wk/display"
        rm -f "$runtime/wayland-0" "$runtime/wayland-0.lock"
    fi
    rm -f "$WK_SESSION_MODE_FILE" "$WK_DESKTOP_MODE_FILE"
    seat_restore
}

session_off() {
    session_stop
    session_on off
}

session_status() {
    local user uid runtime
    user=$(session_user) || { echo "session:   no user configured"; return 0; }
    uid=$(id -u "$user")
    runtime="/run/user/$uid/wk/display"
    # `systemctl is-active` prints its answer and exits 3 when inactive.
    local unit_state dm_state
    unit_state=$(systemctl is-active "$WK_SESSION_UNIT" 2>/dev/null | head -1 || true)
    [ -n "$unit_state" ] || unit_state=unknown
    dm_state=$(systemctl is-active gdm3 2>/dev/null | head -1 || true)
    [ -n "$dm_state" ] || dm_state=$(systemctl is-active gdm 2>/dev/null | head -1 || true)
    [ -n "$dm_state" ] || dm_state=unknown

    printf 'session:   %s\n' "$unit_state"
    printf 'socket:    %s\n' "$([ -S "$runtime/wayland-0" ] && echo "$runtime/wayland-0" || echo none)"
    printf 'dm:        %s\n' "$dm_state"
    printf 'modeset:   %s\n' "$(cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null || echo n/a)"
    printf 'mode:      %s\n' "$(cat "$WK_SESSION_MODE_FILE" 2>/dev/null || echo none)"
    printf 'desktop:   %s\n' "$(cat "$WK_DESKTOP_MODE_FILE" 2>/dev/null || echo none)"
    printf 'power:     %s\n' "$(outputs_power)"
    printf 'gpu:       %s\n' "$(gpu_card || echo none)"
    printf 'bmc:       %s\n' "$(bmc_card || echo none)"
    if [ -f "$WK_SEAT_RULE" ]; then
        printf 'seat-hide: %s\n' "$(sed -n 's/.*KERNEL=="\([^"]*\)".*/\1/p' "$WK_SEAT_RULE" | head -1)"
    fi
}

case "$os:$action" in
    Darwin:on)     macos_on ;;
    Darwin:status) macos_status ;;
    Darwin:*)      macos_off ;;
    Linux:session-on)      session_on gpu ;;
    Linux:session-on-bmc)  session_on bmc ;;
    Linux:session-gdm)     session_gdm gpu ;;
    Linux:session-gdm-bmc) session_gdm bmc ;;
    Linux:session-stop)    session_stop ;;
    Linux:session-off)     session_off ;;
    Linux:session-status)  session_status ;;
    Linux:perf-on)  perf_on ;;
    Linux:perf-off) perf_off ;;
    Linux:on)      linux_on ;;
    Linux:status)  linux_status ;;
    Linux:*)       linux_off ;;
    *) echo "wk-quiesce-priv: unsupported OS $os" >&2; exit 1 ;;
esac
