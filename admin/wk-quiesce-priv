#!/bin/bash
#
# The privileged half of `wk quiesce`. Runs as root via a NOPASSWD sudoers rule
# that names this exact path.
#
# Everything here must be safe to grant unconditionally, because granting it is
# equivalent to granting it forever:
#
#   - The command set is a fixed allowlist. There is no passthrough, no eval,
#     and no argument that becomes part of a command.
#   - Nothing is read from the environment. sudo's env_reset plus the explicit
#     PATH below means a hostile environment cannot redirect any binary.
#   - Every action is reversible with `off`, and `off` is what runs if the
#     argument is unrecognised.
#   - The session verbs are one verb per configuration -- session-on,
#     session-on-bmc, session-gdm, session-gdm-bmc, session-stop, session-off
#     -- rather than one verb taking a configuration. Each spells a fixed
#     device list (or a fixed device to hide) and a fixed compositor command
#     line, so no argument ever reaches a command.
#
# Linux cannot make a #! script setuid -- the kernel ignores the bit -- so a
# sudoers rule is the mechanism, not a shell wrapper around a setuid binary.
#
# The session verbs follow the same rules. They exist because a GPU benchmark
# needs a real DRM session on the monitor, and taking the seat means stopping
# the display manager -- neither of which an unprivileged user may do. The user
# to run the compositor as is read from a root-owned file written at install
# time, never from an argument or the environment: an argument would turn this
# into "run a compositor as anyone", which is a very different grant.

set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

[ "$(id -u)" -eq 0 ] || { echo "wk-quiesce-priv: must run as root" >&2; exit 1; }

os=$(uname -s)
action="${1:-off}"

# --- macOS -------------------------------------------------------------------
macos_on() {
    # Spotlight indexing is the single largest source of benchmark noise.
    mdutil -a -i off >/dev/null 2>&1 || true
    # Time Machine can start mid-run.
    tmutil stopbackup >/dev/null 2>&1 || true
    # Software update checks and downloads.
    softwareupdate --schedule off >/dev/null 2>&1 || true
    # Low power mode throttles the CPU unpredictably.
    pmset -a lowpowermode 0 >/dev/null 2>&1 || true
    echo "quiesced: spotlight off, backups stopped, updates off, low-power off"
}

macos_off() {
    mdutil -a -i on >/dev/null 2>&1 || true
    softwareupdate --schedule on >/dev/null 2>&1 || true
    echo "restored: spotlight on, updates on"
}

macos_status() {
    printf 'spotlight: %s\n' "$(mdutil -a -s 2>/dev/null | tr '\n' ' ')"
    printf 'lowpower:  %s\n' "$(pmset -g | awk '/lowpowermode/ {print $2}')"
}

# --- Linux -------------------------------------------------------------------
linux_on() {
    # Pin every CPU to the performance governor.
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo performance > "$g" || true
    done
    # Disable turbo so clocks are steady rather than merely high.
    [ -w /sys/devices/system/cpu/intel_pstate/no_turbo ] && \
        echo 1 > /sys/devices/system/cpu/intel_pstate/no_turbo || true
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && \
        echo 0 > /sys/devices/system/cpu/cpufreq/boost || true
    # Allow perf without restriction, for profiling runs.
    sysctl -q -w kernel.perf_event_paranoid=-1 || true
    # Keep address layout stable between runs.
    sysctl -q -w kernel.randomize_va_space=0 || true
    # Stop the indexer if one is installed.
    systemctl stop packagekit.service >/dev/null 2>&1 || true
    echo "quiesced: performance governor, turbo off, perf unrestricted, ASLR off"
}

linux_off() {
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo schedutil > "$g" || true
    done
    [ -w /sys/devices/system/cpu/intel_pstate/no_turbo ] && \
        echo 0 > /sys/devices/system/cpu/intel_pstate/no_turbo || true
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && \
        echo 1 > /sys/devices/system/cpu/cpufreq/boost || true
    sysctl -q -w kernel.perf_event_paranoid=2 || true
    sysctl -q -w kernel.randomize_va_space=2 || true
    echo "restored: schedutil governor, turbo on, perf restricted, ASLR on"
}

linux_status() {
    printf 'governor:  %s\n' "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo n/a)"
    printf 'paranoid:  %s\n' "$(sysctl -n kernel.perf_event_paranoid 2>/dev/null || echo n/a)"
    printf 'aslr:      %s\n' "$(sysctl -n kernel.randomize_va_space 2>/dev/null || echo n/a)"
}

# --- Linux: the benchmark session -------------------------------------------
# cage is a one-client kiosk compositor: a real DRM session on the real device,
# without a desktop's worth of background compositing to show up in the numbers.
#
# It is started through systemd-run with PAMName=login and a TTY, which is what
# gives it a logind session on seat0 -- without that, libseat cannot take DRM
# master and the compositor exits immediately. Running it as root instead would
# work and is what most kiosk setups do; it is avoided here because the Wayland
# socket is the one host socket a workspace can see, and a compositor running as
# root would make that a much more interesting thing to talk to.
WK_SESSION_CONF=/usr/local/libexec/wk-session.env
WK_SESSION_UNIT=wk-session
WK_SESSION_TTY=${WK_SESSION_TTY:-/dev/tty2}
WK_SESSION_MODE_FILE=/run/wk-session-mode

session_user() {
    [ -r "$WK_SESSION_CONF" ] || return 1
    # shellcheck disable=SC1090
    . "$WK_SESSION_CONF"
    [ -n "${WK_SESSION_USER:-}" ] || return 1
    id -u "$WK_SESSION_USER" >/dev/null 2>&1 || return 1
    echo "$WK_SESSION_USER"
}

# --- which DRM device the compositor is allowed to use ------------------------
# This board has two, and only one of them is a GPU. The discrete card drives
# the monitor; the ASPEED BMC exposes a second, display-only `ast` device whose
# framebuffer is what the BMC serves over KVM-over-IP. Both sit on seat0, so a
# compositor left to enumerate for itself may pick either -- and which one it
# picked decides whether a Speedometer number came from the GPU or from a
# management chip. Every session below therefore names its devices explicitly
# through WLR_DRM_DEVICES instead of trusting enumeration order.
#
# The kernel driver is the discriminator, never the card number: /dev/dri/card1
# is the ast here only because of PCI enumeration, and adding a card renumbers
# both.
drm_driver() {
    local link
    link=$(readlink -f "/sys/class/drm/$1/device/driver" 2>/dev/null) || true
    [ -n "$link" ] && basename "$link" || echo none
}

# Every card node, connectors excluded: /sys/class/drm holds cardN and
# cardN-CONNECTOR-M side by side and only the former is a device.
drm_cards() {
    local d c
    for d in /sys/class/drm/card[0-9]*; do
        [ -d "$d" ] || continue
        c=$(basename "$d")
        case "$c" in *-*) continue ;; esac
        echo "$c"
    done
}

bmc_card() {
    local c
    for c in $(drm_cards); do
        [ "$(drm_driver "$c")" = ast ] && { echo "/dev/dri/$c"; return 0; }
    done
    return 1
}

gpu_card() {
    local c drv
    for c in $(drm_cards); do
        drv=$(drm_driver "$c")
        case "$drv" in ast|none) continue ;; esac
        [ -e "/dev/dri/$c" ] || continue
        echo "/dev/dri/$c"
        return 0
    done
    return 1
}

# --- removing a DRM device from every seat -----------------------------------
# gdm's compositor (mutter) has no per-process device allowlist the way cage's
# WLR_DRM_DEVICES gives the benchmark session -- the only lever that reaches it
# is which devices logind hands to seat0 at all. Stripping the udev tags that
# make a device a seat member removes it from seat0 the same way unplugging
# it would; nothing on seat0, including mutter, can open a device it was never
# handed.
#
# Moving it to a different seat, rather than off every seat, was the first
# attempt, and the wrong one: giving it a distinct ID_SEAT makes logind create
# a real seat there, and gdm starts a greeter on every seat it finds -- so
# instead of one session on the intended chip, it was two, one per chip.
#
# The rule lives under /run, not /etc, so a crashed helper never leaves a
# device permanently hidden -- it disappears at the next boot even if nothing
# here ever runs `seat_restore` again.
WK_SEAT_RULE=/run/udev/rules.d/72-wk-session-seat.rules
WK_DESKTOP_MODE_FILE=/run/wk-desktop-mode

# True if $1 (a card basename, e.g. card2) is currently part of seat0's device
# tree -- the fact that actually matters, since it's what a seat0 session can
# open. Not the udev property: that says what was asked for, not what logind
# ended up doing with it.
#
# Anchored so a search for "card2" cannot match "card2-DP-1": grep's default
# substring matching would call the connector's own presence a match for the
# card, and every one of these connectors is exactly the thing hiding the
# card is trying to remove.
seat0_has_card() {
    loginctl seat-status seat0 2>/dev/null | grep -qE "drm:$1([^-[:alnum:]]|\$)"
}

# Every sysfs path a hide/restore needs to touch: the card itself and each of
# its cardN-CONNECTOR-M children. 71-seat.rules tags both with `seat` and
# `master-of-seat` -- KERNEL=="card[0-9]*" matches a connector's name too, one
# digit then anything -- so a rule (or a re-trigger) that only reaches the
# bare card leaves every connector still fully on seat0, which is indeed what
# happened on the first cut of this: the card itself came off the seat while
# every one of its outputs stayed on, right where a display manager still
# looks for something to show on.
_card_paths() {
    local card="$1" p
    for p in "/sys/class/drm/$card" "/sys/class/drm/$card"-*; do
        [ -e "$p" ] && echo "$p"
    done
}

# Re-processing a device through udev is what makes a rule change take effect
# for a device that already exists. A "change" event is tried first because it
# never touches the driver, and is enough for logind to recompute the seat on
# every systemd tested so far. If the device is still where it started, a
# synthetic remove+add replays the same events real hotplug would, which is a
# stronger prod at the cost of the device briefly not existing.
# True once $1's presence on seat0 matches what we're waiting for -- present
# when $2 is 0, absent when $2 is 1.
_reseated() {
    if seat0_has_card "$1"; then [ "$2" != 1 ]; else [ "$2" = 1 ]; fi
}

_reseat() {
    local card="$1" want_absent="$2" i paths
    paths=$(_card_paths "$card")
    # shellcheck disable=SC2086
    udevadm trigger --action=change $paths 2>/dev/null || true
    udevadm settle --timeout=3 2>/dev/null || true
    for i in 1 2 3 4 5; do
        _reseated "$card" "$want_absent" && return 0
        sleep 0.2
    done

    # shellcheck disable=SC2086
    udevadm trigger --action=remove $paths 2>/dev/null || true
    # shellcheck disable=SC2086
    udevadm trigger --action=add    $paths 2>/dev/null || true
    udevadm settle --timeout=3 2>/dev/null || true
    for i in 1 2 3 4 5; do
        _reseated "$card" "$want_absent" && return 0
        sleep 0.2
    done
    return 1
}

# Hide $1 (a card basename) from seat0. Idempotent: re-hiding a card that is
# already hidden just rewrites the same rule and finds it already satisfied.
#
# This strips the device's seat tags rather than moving it to a different
# seat. ID_SEAT="something-else" does not hide the device, it relocates it:
# logind creates a real seat for
# "something-else", and gdm, being seat-aware, starts its own greeter on
# every seat it finds -- so the result was two live sessions, one on each
# chip, instead of one. Removing `master-of-seat` (what makes a device
# define a seat at all) and `seat` (what makes it a member of one) leaves
# the device with no seat whatsoever, which is what "hidden" actually needs
# to mean: nothing to enumerate, nowhere for gdm to open a second display.
seat_hide() {
    local card="$1"
    {
        printf 'SUBSYSTEM=="drm", KERNEL=="%s", TAG-="master-of-seat", TAG-="seat"\n' "$card"
        # The card's own connectors (cardN-CONNECTOR-M) are separate udev
        # devices, each independently tagged by 71-seat.rules' KERNEL==
        # "card[0-9]*" -- one digit, then anything, which matches a
        # connector's name as readily as the card's -- so they need their own
        # line here. seat_restore only ever reads the *first* KERNEL== value
        # out of this file, which is why the plain card name comes first.
        printf 'SUBSYSTEM=="drm", KERNEL=="%s-*", TAG-="master-of-seat", TAG-="seat"\n' "$card"
    } > "$WK_SEAT_RULE"
    udevadm control --reload-rules
    _reseat "$card" 1
}

# Undo whatever hide is in effect, whether or not one actually is -- callers
# use this as "make sure nothing is hidden" rather than "undo the specific
# thing I hid a moment ago", because which mode was active before a crash is
# not something this helper remembers.
seat_restore() {
    local card=""
    [ -f "$WK_SEAT_RULE" ] && card=$(sed -n 's/.*KERNEL=="\([^"]*\)".*/\1/p' "$WK_SEAT_RULE" | head -1)
    rm -f "$WK_SEAT_RULE"
    udevadm control --reload-rules
    [ -n "$card" ] || return 0
    _reseat "$card" 0 \
        || echo "wk-quiesce-priv: warning: could not confirm $card is back on seat0" >&2
}

# --- making gdm run a compositor the seat hide can actually reach -------------
# Hiding a device from seat0 only constrains a compositor that asks logind for
# its devices. mutter does. Xorg with NVIDIA's own DDX does not, and that is the
# greeter this machine gets by default: 61-gdm.rules walks
#
#   KERNEL=="nvidia_drm", SUBSYSTEM=="module", ACTION=="add"
#     ATTR{parameters/modeset}!="Y" -> disable wayland
#     ATTR{version}=="[5-9][1-9][0-9].*" -> gdm_prefer_xorg
#     GOTO="gdm_prefer_xorg"                      <- unconditional catch-all
#
# so with modeset=Y every driver version lands on Xorg, and the greeter comes up
# as gdm-x-session with NVIDIA(GPU-0) in its log. That DDX never opens
# /dev/dri/cardN: it drives the card through /dev/nvidia0, /dev/nvidiactl and
# /dev/nvidia-modeset -- plain character devices, mode 0666, with no udev
# properties and no seat tags whatsoever. There is nothing there for
# TAG-="seat" to remove.
#
# Which is exactly how `session-gdm-bmc` came to be a no-op that reported
# success: the hide worked -- card2 lost `seat` and `master-of-seat` from its
# CURRENT_TAGS -- and Xorg went on enumerating the monitor through a device the
# hide cannot see, so the desktop appeared on the real display every time. The
# same gap is why a connector's sysfs `enabled` under-reports an X greeter:
# NVKMS modesets outside DRM.
#
# So the greeter is put on Wayland, where the mechanism is real. gdm's own
# runtime-config tool is what writes it -- the same tool 61-gdm.rules uses to
# express its preference -- which means the override lands in /run and is gone
# at the next boot, the same crash-safety the seat rule gets from living there.
GDM_RUNTIME_CONFIG=/usr/libexec/gdm-runtime-config

gdm_prefer_wayland() {
    [ -x "$GDM_RUNTIME_CONFIG" ] || return 1
    "$GDM_RUNTIME_CONFIG" set daemon WaylandEnable true || return 1
    "$GDM_RUNTIME_CONFIG" set daemon PreferredDisplayServer wayland || return 1
}

# The greeter's session type, once it has one. Worth waiting for and worth
# checking: an x11 greeter means the device hide did not apply, and the desktop
# is on whichever chip NVIDIA's DDX felt like driving regardless of the mode
# that was asked for. Better said out loud than discovered by walking over to
# the monitor.
greeter_type() {
    local i sid class typ
    for i in $(seq 1 40); do
        for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '$4 == "seat0" {print $1}'); do
            class=$(loginctl show-session "$sid" -p Class --value 2>/dev/null || echo)
            [ "$class" = greeter ] || continue
            typ=$(loginctl show-session "$sid" -p Type --value 2>/dev/null || echo)
            [ -n "$typ" ] && { echo "$typ"; return 0; }
        done
        sleep 0.25
    done
    return 1
}

# `systemctl stop` on gdm returning doesn't mean logind is done tearing the
# session down -- PAM cleanup, D-Bus deregistration and VT release continue
# briefly after. Claiming the seat again (starting gdm back up, or handing it
# to cage) before that settles is exactly the race a plain `systemctl stop
# gdm3 && systemctl start gdm3` doesn't hit with a couple of seconds between
# the two by hand, and does hit back-to-back: gdm's own Xorg wrapper fails its
# console-user check and crash-loops. Waiting for seat0 to actually be empty
# is the fact that matters, not a fixed sleep guessing how long cleanup takes.
wait_seat0_quiet() {
    local i
    for i in $(seq 1 20); do
        loginctl list-sessions --no-legend 2>/dev/null | awk '$4 == "seat0"' | grep -q . || return 0
        sleep 0.25
    done
    return 1
}

# --- turning the outputs off, as opposed to painting them black --------------
# Holding DRM master with nothing to draw is only half of `off`, and for a long
# time it was the only half: cage came up, painted black, and the monitor sat
# there lit and black. That is what the implementation asked for. A held CRTC is
# still scanning out a real mode -- 1024x600@59.8 here -- so the monitor has a
# perfectly good signal to display, and displays it. Nothing in that path ever
# asks the connector to power down, and nothing in cage ever will: 0.1.5 has no
# idle timeout, no `wlr-output-power-management`, and no option that touches
# DPMS.
#
# What it does export is `wlr-output-management` v4, and that protocol's
# disable_head is not a paint -- it is an atomic commit with the CRTC off. The
# connector goes enabled -> disabled and dpms On -> Off, the signal stops, and
# the monitor drops into standby for want of one. It reaches hardware because it
# is ordinary modesetting, which is exactly what fbcon's `fb_blank` was not --
# that is the path that quietly did nothing on this driver and sent the whole
# design down the "hold it black instead" road in the first place.
#
# Disabling every head does not release the device: wlroots keeps the DRM fd
# open, so fbcon still cannot get back in and repaint. Both halves are needed --
# the placeholder to keep the console out, this to actually go dark.
#
# wlr-randr runs as the session user rather than as root. It has to speak to a
# compositor the user owns, and a root client on a user-owned socket is the
# shape of thing this file spends the rest of its length avoiding.
WLR_RANDR=/usr/bin/wlr-randr

# Connector names as wlr-randr prints them: one per unindented line, name first
# and then a quoted description. Matching the whole first field rather than a
# NAME-N pattern -- `HDMI-A-1` has a letter where a pattern like that wants its
# digit, and the point of this is to leave nothing lit.
_heads() {
    local socket="$1" uid="$2" gid="$3" out
    out=$(setpriv --reuid="$uid" --regid="$gid" --clear-groups \
              env WAYLAND_DISPLAY="$socket" "$WLR_RANDR" 2>/dev/null) || true
    printf '%s\n' "$out" | sed -n 's/^\([^[:space:]][^[:space:]]*\) ".*/\1/p'
}

outputs_off() {
    local socket="$1" user="$2" uid gid head rc=0 any=""
    uid=$(id -u "$user")
    gid=$(id -g "$user")

    if [ ! -x "$WLR_RANDR" ]; then
        echo "wk-quiesce-priv: $WLR_RANDR is missing -- the screen will be black but still" >&2
        echo "                 powered; install it: ./setup --stage tools" >&2
        return 1
    fi

    # The socket appearing is not the outputs being up: wlroots binds the seat,
    # opens the device and enumerates connectors after it starts listening, so
    # asking straight away can see no heads at all -- which this function is
    # otherwise right to treat as a failure.
    local heads="" i
    for i in 1 2 3 4 5 6 7 8; do
        heads=$(_heads "$socket" "$uid" "$gid")
        [ -n "$heads" ] && break
        sleep 0.25
    done

    for head in $heads; do
        any=1
        setpriv --reuid="$uid" --regid="$gid" --clear-groups \
            env WAYLAND_DISPLAY="$socket" "$WLR_RANDR" --output "$head" --off \
            >/dev/null 2>&1 || rc=1
    done

    # No heads at all is a failure, not a job already done: it means the
    # compositor took no output, and every connector is still showing whatever
    # was last latched into it.
    [ -n "$any" ] || return 1
    return "$rc"
}

# Which connected connectors are still being driven. Read from sysfs rather than
# from the compositor, because the claim being checked is about hardware and the
# compositor is the thing making the claim. `dpms` alone is not enough -- it
# reads On for a connector whose CRTC was never enabled at all -- so both are
# printed and only `enabled`+`On` counts as lit.
outputs_power() {
    local conn name
    for conn in /sys/class/drm/card[0-9]*-*; do
        [ -d "$conn" ] || continue
        [ "$(cat "$conn/status" 2>/dev/null)" = connected ] || continue
        name=$(basename "$conn")
        if [ "$(cat "$conn/enabled" 2>/dev/null)" = enabled ] \
           && [ "$(cat "$conn/dpms" 2>/dev/null)" = On ]; then
            printf '%s=on ' "${name#card[0-9]*-}"
        else
            printf '%s=off ' "${name#card[0-9]*-}"
        fi
    done
    echo
}

# $1 is a mode set by the dispatch table at the bottom of this file, never by
# the caller: each verb passes one fixed literal.
#
#   gpu  the GPU alone. What a benchmark runs on, and the default.
#   bmc  the BMC's `ast` chip alone, which means software rendering (`pixman`,
#        named explicitly): it has no render node of its own. This is the
#        debugging session -- watchable over KVM-over-IP, never a number to
#        compare with anything.
#
#        Rendering on the GPU and scanning out on the BMC, with wlroots copying
#        each finished frame across, was tried and dropped: on this board's
#        NVIDIA + ast pairing the copy never works -- the compositor comes up
#        but every frame fails to produce a GLES2 FBO ("EGLImage not
#        supported"), so the BMC connector never gets an output, silently and
#        forever. That failure doesn't even show up as the compositor refusing
#        to start, which is the one thing this helper relies on to fail loudly.
#        Software rendering is slower but it actually shows something.
#   off  the screen-off placeholder. This is what `session-off` actually
#        starts, not a lack of one: releasing DRM master entirely and trusting
#        the kernel's own fbcon to blank the screen was the first design, and
#        on this board's NVIDIA driver `fb_blank` never reaches real hardware
#        -- it stops the console from being redrawn but leaves whatever frame
#        was already latched in the scanout buffer on screen, forever, on a
#        real monitor watched by a person rather than a test harness that only
#        reads sysfs. Holding master sidesteps that bug instead of relying on a
#        DPMS path this driver doesn't implement.
#
#        Holding master is not on its own enough: a compositor that holds an
#        output and paints it black is still scanning out a real mode, so the
#        monitor has a signal and stays
#        lit. `outputs_off` below is the other half -- it modesets the outputs
#        off through wlr-output-management once the compositor is up, which
#        does reach hardware because it is modesetting rather than fb_blank.
#
#        The device list is the GPU alone, not both chips, and that is a
#        limitation rather than a choice: wlroots takes the first entry in
#        WLR_DRM_DEVICES as primary and needs a renderer that can copy frames
#        to any secondary, which pixman cannot do for a device with no render
#        node. Naming both got one head, silently -- the same silent drop the
#        mirror attempt hit. So `off` darkens the monitor and leaves the BMC's
#        chip showing whatever was last latched into it; `wk session status`
#        prints a `lit:` line so that is visible rather than assumed.
session_on() {
    local mode="${1:-gpu}"
    local user uid runtime gpu bmc devices cage_args renderer allow_sw
    user=$(session_user) || { echo "wk-quiesce-priv: no session user configured in $WK_SESSION_CONF" >&2; exit 1; }
    uid=$(id -u "$user")
    runtime="/run/user/$uid/wk/display"

    gpu=$(gpu_card) || gpu=""
    bmc=$(bmc_card) || bmc=""

    # WLR_RENDERER is pinned, in both modes, rather than left to auto-detect --
    # auto-detect tries GLES2 first regardless of what it is likely to find,
    # and WLR_RENDERER_ALLOW_SOFTWARE only permits it to land on a software
    # renderer, it doesn't make it choose one. Against a device with no render
    # node (the ast), auto-detect's GLES2 attempt just fails and there is no
    # second attempt: the compositor comes up, the output exists at the
    # protocol level, and nothing ever actually gets drawn -- no renderer, no
    # frames, not even a background or a cursor. Naming `pixman` outright is
    # what actually gets a picture instead of a technically-present output.
    renderer=gles2
    allow_sw=""
    cage_args="-d"
    case "$mode" in
        gpu)
            [ -n "$gpu" ] || { echo "wk-quiesce-priv: no GPU DRM device found" >&2; exit 1; }
            devices="$gpu"
            ;;
        bmc)
            [ -n "$bmc" ] || { echo "wk-quiesce-priv: no BMC (ast) DRM device found" >&2; exit 1; }
            devices="$bmc"
            renderer=pixman
            # Not load-bearing now that pixman is named explicitly -- pixman
            # was never the software-GLES2-on-llvmpipe case this guards
            # against -- but there is no upside to leaving it unset either.
            allow_sw=1
            ;;
        off)
            # One device, not both. Listing both looked like it covered the
            # machine and did not: the second one is dropped without a word,
            # so all it bought was a mode file that overstated its reach.
            # The GPU is the one that matters -- it drives the monitor a
            # person is looking at, and it is the one fbcon would repaint.
            devices="$gpu"
            [ -n "$devices" ] || devices="$bmc"
            [ -n "$devices" ] || { echo "wk-quiesce-priv: no DRM device found" >&2; exit 1; }
            renderer=pixman
            allow_sw=1
            ;;
        *)
            echo "wk-quiesce-priv: unknown session mode $mode" >&2; exit 1 ;;
    esac

    # The display manager holds seat0 through its greeter, and two things
    # cannot own DRM master at once.
    if systemctl is-active --quiet gdm3 2>/dev/null || systemctl is-active --quiet gdm 2>/dev/null; then
        systemctl stop gdm3 2>/dev/null || systemctl stop gdm 2>/dev/null || true
        wait_seat0_quiet \
            || echo "wk-quiesce-priv: warning: seat0 still had a session after stopping gdm" >&2
        echo "stopped the display manager"
    fi

    # A gdm session may have left a device hidden from seat0 (session-gdm-bmc
    # hides the GPU, session-gdm hides the ast) -- cage's WLR_DRM_DEVICES names
    # a device by path, and a hidden device is one libseat will refuse to hand
    # it, regardless of what the environment asked for.
    seat_restore
    rm -f "$WK_DESKTOP_MODE_FILE"

    # nvidia-drm without modesetting has no KMS for a compositor to drive, and
    # the failure is a bare "no DRM device" that says nothing about why.
    if [ -r /sys/module/nvidia_drm/parameters/modeset ]; then
        if [ "$(cat /sys/module/nvidia_drm/parameters/modeset)" != Y ]; then
            echo "warning: nvidia-drm modeset is off; the compositor cannot take the display" >&2
            echo "         add 'options nvidia-drm modeset=1' to /etc/modprobe.d and reboot" >&2
        fi
    fi

    install -d -o "$user" -m 0700 "/run/user/$uid/wk" 2>/dev/null || true
    install -d -o "$user" -m 0700 "$runtime" 2>/dev/null || true

    systemctl stop "$WK_SESSION_UNIT" 2>/dev/null || true

    # A dedicated XDG_RUNTIME_DIR for the compositor, so the workspace can be
    # given the Wayland socket by sharing one directory instead of the user's
    # whole runtime directory -- which is where the session D-Bus socket lives.
    #
    # Exported inside the ExecStart shell rather than passed with --setenv:
    # PAMName=login runs pam_systemd, which sets XDG_RUNTIME_DIR=/run/user/<uid>
    # itself, and relying on which of the two wins would be relying on a detail
    # that is not documented to go our way. If PAM won, the socket would appear
    # in the user's runtime directory -- where the workspace deliberately cannot
    # see it -- and the failure would look like "the compositor started but the
    # benchmark cannot find a display".
    local setenv=(--setenv=XDG_SESSION_TYPE=wayland
                  --setenv=WLR_NO_HARDWARE_CURSORS=1
                  "--setenv=WLR_DRM_DEVICES=$devices")
    [ -n "$renderer" ] && setenv+=("--setenv=WLR_RENDERER=$renderer")
    [ -n "$allow_sw" ] && setenv+=(--setenv=WLR_RENDERER_ALLOW_SOFTWARE=1)

    systemd-run --unit="$WK_SESSION_UNIT" --collect \
        --description="wk benchmark compositor" \
        --uid="$user" \
        --property=PAMName=login \
        --property=TTYPath="$WK_SESSION_TTY" \
        --property=StandardInput=tty-force \
        --property=StandardOutput=journal \
        --property=StandardError=journal \
        --property=Restart=no \
        "${setenv[@]}" \
        /bin/sh -c "export XDG_RUNTIME_DIR='$runtime'; exec /usr/bin/cage $cage_args -- /usr/bin/sleep infinity" \
        >/dev/null

    # The socket appearing is the only evidence that matters.
    for _ in $(seq 1 40); do
        [ -S "$runtime/wayland-0" ] && break
        sleep 0.25
    done

    if [ -S "$runtime/wayland-0" ]; then
        # The mode is recorded where anything can read it, because the one thing
        # that must never happen is a benchmark run against a BMC or software
        # session that looks exactly like a GPU one from the socket alone.
        printf '%s\n' "$mode" > "$WK_SESSION_MODE_FILE"
        chmod 0644 "$WK_SESSION_MODE_FILE"
        echo "compositor up: $runtime/wayland-0"
        echo "mode: $mode  scanout: $devices  render: $devices"

        # `off` is the placeholder *plus* the modeset that darkens it. Warn
        # rather than fail: a black screen is a worse outcome than a dark one
        # but a much better one than no session at all holding the console off.
        if [ "$mode" = off ]; then
            outputs_off "$runtime/wayland-0" "$user" \
                || echo "wk-quiesce-priv: warning: could not power the outputs down --" \
                        "the screen is black but still lit" >&2
            echo "power: $(outputs_power)"
        fi
    else
        rm -f "$WK_SESSION_MODE_FILE"
        echo "compositor did not come up; journalctl -u $WK_SESSION_UNIT" >&2
        exit 1
    fi
}

# $1 is gpu or bmc, same convention as session_on, but for a real desktop
# instead of the benchmark compositor. mutter has nothing like cage's
# WLR_DRM_DEVICES, so the only way to hand it exactly one device is to make
# sure the other one is never on seat0 for it to see.
#
#   gpu  gdm/mutter gets the real GPU; the ast is hidden from seat0 so there is
#        no question of the desktop having landed on the management chip.
#   bmc  the reverse: the GPU is hidden from seat0, so mutter's only choice is
#        the ast -- software-rendered, watchable over KVM-over-IP, the same
#        trade session-on-bmc makes for the benchmark compositor, but for a
#        real desktop you can log into rather than a kiosk running one window.
session_gdm() {
    local mode="${1:-gpu}"
    local gpu bmc hide _u _r _t
    gpu=$(gpu_card) || gpu=""
    bmc=$(bmc_card) || bmc=""

    case "$mode" in
        gpu)
            [ -n "$gpu" ] || { echo "wk-quiesce-priv: no GPU DRM device found" >&2; exit 1; }
            hide="$bmc"
            ;;
        bmc)
            [ -n "$bmc" ] || { echo "wk-quiesce-priv: no BMC (ast) DRM device found" >&2; exit 1; }
            hide="$gpu"
            ;;
        *)
            echo "wk-quiesce-priv: unknown desktop mode $mode" >&2; exit 1 ;;
    esac

    # Nothing may hold DRM master while the seat's device list changes out from
    # under it.
    systemctl stop "$WK_SESSION_UNIT" 2>/dev/null || true
    # And the socket goes with it: left behind it is indistinguishable from a
    # running compositor to everything that checks for the file, so `status`
    # reported a live socket next to an inactive unit for the whole time a
    # desktop was up.
    if _u=$(session_user); then
        _r="/run/user/$(id -u "$_u")/wk/display"
        rm -f "$_r/wayland-0" "$_r/wayland-0.lock"
    fi
    rm -f "$WK_SESSION_MODE_FILE"
    systemctl stop gdm3 2>/dev/null || systemctl stop gdm 2>/dev/null || true
    wait_seat0_quiet \
        || echo "wk-quiesce-priv: warning: seat0 still had a session after stopping gdm" >&2

    seat_restore
    if [ -n "$hide" ]; then
        seat_hide "$(basename "$hide")" \
            || echo "wk-quiesce-priv: warning: could not confirm $(basename "$hide") left seat0 -- gdm may still see it" >&2
    fi

    printf '%s\n' "$mode" > "$WK_DESKTOP_MODE_FILE"
    chmod 0644 "$WK_DESKTOP_MODE_FILE"

    # Before starting it, not after: gdm reads its config once, at startup.
    gdm_prefer_wayland \
        || echo "wk-quiesce-priv: warning: could not set gdm's display server to wayland" >&2

    systemctl start gdm3 2>/dev/null || systemctl start gdm 2>/dev/null \
        || { echo "wk-quiesce-priv: gdm did not start; journalctl -u gdm" >&2; exit 1; }

    if [ -n "$hide" ]; then
        echo "gdm starting: mode $mode  hidden from seat0: $(basename "$hide")"
    else
        echo "gdm starting: mode $mode"
    fi

    # The mode is only as real as the greeter's session type. On x11 the hide
    # does not reach the compositor at all and `mode` is a statement of intent
    # rather than of fact.
    if _t=$(greeter_type); then
        echo "greeter: $_t"
        [ "$_t" = wayland ] || {
            echo "wk-quiesce-priv: warning: the greeter came up on $_t, not wayland --" >&2
            echo "                 hiding a device from seat0 does not constrain NVIDIA's" >&2
            echo "                 Xorg driver, so mode '$mode' is not being enforced" >&2
        }
    else
        echo "wk-quiesce-priv: warning: no greeter session appeared on seat0" >&2
    fi
}

# Tear down to nothing: no compositor, no gdm, no hide, no mode file. Used by
# callers that are about to claim the seat for something else and just need a
# clean slate first -- `session-off` (below) is not one of them, on purpose.
session_stop() {
    local user uid runtime
    systemctl stop "$WK_SESSION_UNIT" 2>/dev/null || true
    systemctl stop gdm3 2>/dev/null || systemctl stop gdm 2>/dev/null || true

    # Remove the socket the compositor leaves behind. Left in place it looks
    # exactly like a running session to anything that checks for the file.
    if user=$(session_user); then
        uid=$(id -u "$user")
        runtime="/run/user/$uid/wk/display"
        rm -f "$runtime/wayland-0" "$runtime/wayland-0.lock"
    fi
    rm -f "$WK_SESSION_MODE_FILE" "$WK_DESKTOP_MODE_FILE"
    seat_restore
}

# `session off` is not just session_stop -- tearing everything down and trusting
# the kernel's own fbcon to blank the now-masterless outputs. On this board's
# NVIDIA driver that trust is misplaced: fb_blank stops the console from
# being redrawn but never reaches real hardware, so whatever frame was last
# latched in the scanout buffer stayed on the physical monitor indefinitely --
# invisible to every check that reads sysfs, because sysfs faithfully reported
# "blanked" the whole time, and only obvious to someone actually looking at
# the screen. Holding DRM master open with nothing to draw, on every device
# instead of releasing it, is what actually reaches a dark screen on hardware
# that won't take a real DPMS command from software.
session_off() {
    session_stop
    session_on off
}

session_status() {
    local user uid runtime
    user=$(session_user) || { echo "session:   no user configured"; return 0; }
    uid=$(id -u "$user")
    runtime="/run/user/$uid/wk/display"
    # Each of these is captured into a single value first. `systemctl is-active`
    # prints its answer *and* exits non-zero when the unit is inactive, so a
    # chain of `||` fallbacks contributes one line each and printf then repeats
    # its format once per line -- which reads as three mystery status lines.
    local unit_state dm_state
    # `|| true` on each: systemctl is-active exits 3 for an inactive unit, and
    # under `set -o pipefail` that fails the assignment and `set -e` ends the
    # function before it prints anything -- so asking for status while the
    # display manager was stopped produced no output and exit 3.
    unit_state=$(systemctl is-active "$WK_SESSION_UNIT" 2>/dev/null | head -1 || true)
    [ -n "$unit_state" ] || unit_state=unknown
    dm_state=$(systemctl is-active gdm3 2>/dev/null | head -1 || true)
    [ -n "$dm_state" ] || dm_state=$(systemctl is-active gdm 2>/dev/null | head -1 || true)
    [ -n "$dm_state" ] || dm_state=unknown

    printf 'session:   %s\n' "$unit_state"
    printf 'socket:    %s\n' "$([ -S "$runtime/wayland-0" ] && echo "$runtime/wayland-0" || echo none)"
    printf 'dm:        %s\n' "$dm_state"
    printf 'modeset:   %s\n' "$(cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null || echo n/a)"
    printf 'mode:      %s\n' "$(cat "$WK_SESSION_MODE_FILE" 2>/dev/null || echo none)"
    printf 'desktop:   %s\n' "$(cat "$WK_DESKTOP_MODE_FILE" 2>/dev/null || echo none)"
    printf 'power:     %s\n' "$(outputs_power)"
    printf 'gpu:       %s\n' "$(gpu_card || echo none)"
    printf 'bmc:       %s\n' "$(bmc_card || echo none)"
    if [ -f "$WK_SEAT_RULE" ]; then
        printf 'seat-hide: %s\n' "$(sed -n 's/.*KERNEL=="\([^"]*\)".*/\1/p' "$WK_SEAT_RULE" | head -1)"
    fi
}

case "$os:$action" in
    Darwin:on)     macos_on ;;
    Darwin:status) macos_status ;;
    Darwin:*)      macos_off ;;
    Linux:session-on)      session_on gpu ;;
    Linux:session-on-bmc)  session_on bmc ;;
    Linux:session-gdm)     session_gdm gpu ;;
    Linux:session-gdm-bmc) session_gdm bmc ;;
    Linux:session-stop)    session_stop ;;
    Linux:session-off)     session_off ;;
    Linux:session-status)  session_status ;;
    Linux:on)      linux_on ;;
    Linux:status)  linux_status ;;
    Linux:*)       linux_off ;;
    *) echo "wk-quiesce-priv: unsupported OS $os" >&2; exit 1 ;;
esac
