#!/usr/bin/env bash
#
# wk -- WebKit development workspaces. `wk` lists the commands, `wk help` prints
# README.md, and `wk <command> -h` explains one command.
#
# Every command is a file under cmd/, and declares in its header what it acts
# on (see "declarations" below). This file reads that declaration and does, once
# for every command, what would otherwise be re-decided in each: resolve the
# workspace name, refuse a name inside a workspace, wait for readiness, decide
# where the command runs, forward container work into the podman VM on a macOS
# host, and hand a command about another machine's workspace to that machine.
# bash 3.2 throughout: macOS ships nothing newer.
#
# --- environment protocol -----------------------------------------------------
# Set here for a forwarded or delegated child and read by cmd/* and lib/*:
#   WK_NAME         the workspace name this invocation resolved to (main)
#   WK_TARGET       which target answers -- an explicit value skips discovery,
#                   else lib/target.sh's default_target. Set for the command
#                   that runs *here*; a forwarded or delegated child is never
#                   told, the target being that machine's own to resolve
#   WK_CONFIG       the build config an already-forwarded command inherits
#   WK_IN_VM        this is the re-invocation inside the podman VM; stops it
#                   forwarding a second time
#   WK_ROW_LABEL    the machine name a forwarded or delegated command's records
#                   should claim, and WK_HOST_SELF alongside it when the row is
#                   *this* machine rather than one being asked about
#   WK_NO_DELEGATE  set by a command already walking the fleet, so a machine it
#                   asks reports only what it holds and asks nobody
#   WK_ZED_PUBKEY   the key an editor on the *asking* machine will present
#   WK_QUIET        --quiet: drop info/log narration (lib/common.sh)
#   WK_FORCE        --force: cross a refusal that exists because of a rule

set -euo pipefail

# The directory this file sits in -- unless that directory is not a checkout,
# which is what `bin/wk` is: a symlink to `../wk`. Decided by evidence rather
# than by resolving the link, because a *root* may itself be built out of
# symlinks to another checkout and still be the root that was meant
# (tests/test_peer.py's scratch WK_ROOT). `readlink` without -f: macOS ships no
# GNU coreutils.
WK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -f "$WK_ROOT/lib/common.sh" ]; then
    _wk_self="${BASH_SOURCE[0]}"
    while [ -L "$_wk_self" ]; do
        _wk_dir="$(cd "$(dirname "$_wk_self")" && pwd)"
        _wk_self="$(readlink "$_wk_self")"
        case "$_wk_self" in /*) ;; *) _wk_self="$_wk_dir/$_wk_self" ;; esac
    done
    WK_ROOT="$(cd "$(dirname "$_wk_self")" && pwd)"
    unset _wk_self _wk_dir
    [ -f "$WK_ROOT/lib/common.sh" ] || {
        printf 'error: %s is not inside a wk-tools checkout\n' "${BASH_SOURCE[0]}" >&2
        exit 1
    }
fi
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/target.sh"

WK_MACHINE="${WK_MACHINE:-wk}"

# --- declarations -------------------------------------------------------------
#
# Line 2 of cmd/<name> is its synopsis:   # wk <name> <args> -- <summary>
# and one or more `# wk:` lines in the first 15 lines declare its shape:
#
#   where=host       this workstation's own hardware; never forwarded,
#                    refused inside a workspace and on a shared build host
#   where=store      acts on the store, and runs on the machine that holds it:
#                    forwarded into the podman VM on a macOS workstation,
#                    run here on a Linux workstation and on a build machine
#                    (each holds its own). Refused inside a workspace.
#   where=local      runs wherever it is invoked; never forwarded
#   where=workspace  acts on a workspace: the name is resolved here, the
#                    target decides where it runs
#   where=dynamic    the command answers `wk <cmd> --where <args>` itself
#   name=required|optional|none   how the workspace name arrives. Outside a
#                    workspace the first positional is the name; inside one it
#                    is implicit. `optional` differs from `required` only in
#                    what a missing one means: all of them, or none. Either way
#                    a name no workspace answers to is refused here.
#   takes=<n>        how many positionals of the command's own follow the name.
#                    Default 0. With takes=1 -- `wk pr [<workspace>] <ref>` -- a
#                    lone positional is the command's, and only a second one
#                    makes the first the workspace.
#   ready=yes        wait for the workspace to finish creating first
#   group=<g>        which block of `wk help` lists it
#   lifecycle        creates or destroys the workspace record (new, rm)
#   readonly [<subverbs>]   changes nothing; never starts the podman machine
#   broker <subverbs>|*     allowed inside a workspace, through the broker
#   forward no       a workspace command that runs on this host rather than
#                    inside the podman VM; it still goes to the machine that
#                    holds the workspace, if that is another one
#   here             a workspace command that runs where the person typed it and
#                    nowhere else -- it needs this device's editor or files.
#                    Implies forward=no
#   outside          a workspace command refused inside a workspace
#   bare merged      with no workspace named, report on every target here
#   post <hook>      zed | ssh-alias-remove, after the forwarded half
#   values=<flag>    the closed set this command accepts lives in one list in
#                    the code, and `wk <cmd> -h` prints it by running `wk <cmd>
#                    <flag>`. One flag, read-only and instant: `values=--list`.
#   needs <a,b>      tools and standing this command cannot start without: a
#                    command name (gh, tart, nmap...), `gh-auth` (gh's token
#                    works), or `tailnet`. Checked before anything runs.
#   sub <a,b> where=<w> name=<n>[@2] needs=<list>   per-subverb override of
#                    where, name and/or needs; @2 means the name is the
#                    positional after the subverb, and an empty needs= clears
#                    the command's list
#   flag <--x,--y> where=<w>|name=<n>   per-flag override of where and/or name

decl_load() { # <impl>
    # The whole `where=` vocabulary, in one place: this function refuses
    # anything else and the tests read this line. Inside the function because
    # tests lift it on its own (tests/test_sync.py's _lift_func).
    local WK_WHERE_VALUES="host store local workspace dynamic"
    D_WHERE=workspace D_NAME=none D_READY=no D_GROUP=other D_LIFECYCLE=""
    D_READONLY="" D_BROKER="" D_FORWARD=yes D_BARE="" D_POST="" D_SUB="" D_FLAG="" D_OUTSIDE="" D_NEEDS=""
    D_HERE="" D_TAKES=0 D_VALUES=""
    local line tok
    set -f   # `broker *` is a word, not a glob
    while IFS= read -r line; do
        case "$line" in "# wk:"*) ;; *) continue ;; esac
        line=${line#"# wk:"}
        case "$line" in
            " sub "*)  D_SUB="$D_SUB
${line# sub }" ; continue ;;
            " flag "*) D_FLAG="$D_FLAG
${line# flag }" ; continue ;;
        esac
        for tok in $line; do
            case "$tok" in
                where=*)  D_WHERE=${tok#where=}
                          case " $WK_WHERE_VALUES " in
                              *" $D_WHERE "*) ;;
                              *) die "$(basename "$1"): where=$D_WHERE is not one of ${WK_WHERE_VALUES// /|}" ;;
                          esac ;;
                name=*)   D_NAME=${tok#name=} ;;
                takes=*)  D_TAKES=${tok#takes=} ;;
                ready=*)  D_READY=${tok#ready=} ;;
                group=*)  D_GROUP=${tok#group=} ;;
                lifecycle) D_LIFECYCLE=1 ;;
                readonly) D_READONLY=yes ;;
                broker)   D_BROKER=pending ;;
                needs)    D_NEEDS=pending ;;
                values=*) D_VALUES=${tok#values=} ;;
                forward=no) D_FORWARD=no ;;
                here)     D_HERE=1; D_FORWARD=no ;;
                outside)  D_OUTSIDE=1 ;;
                bare=merged) D_BARE=merged ;;
                post=*)   D_POST=${tok#post=} ;;
                *)  case "$D_NEEDS:$D_READONLY:$D_BROKER" in
                        pending:*)     D_NEEDS=$tok ;;
                        *:yes:pending) D_BROKER=$tok ;;
                        *:yes:*)       D_READONLY=$tok ;;
                        *:*:pending)   D_BROKER=$tok ;;
                    esac ;;
            esac
        done
    done < <(head -15 "$1")
    set +f
    [ "$D_BROKER" = pending ] && D_BROKER="*"
    [ "$D_NEEDS" = pending ] && D_NEEDS=""
    return 0
}

usage_die() { # <cmd> <impl> [why]
    [ -z "${3:-}" ] || warn "$3"
    log "usage: wk $(synopsis "$2" | sed 's/ -- .*//')"
    log "       wk $1 -h for the rest"
    exit 2
}

synopsis() { # <impl>
    head -5 "$1" | sed -n 's/^# wk //p' | head -1
}

in_list() { # <word> <list>
    [ -n "$2" ] || return 1
    [ "$2" = "*" ] && return 0
    case ",$2," in *",$1,"*) return 0 ;; esac
    return 1
}

sub_override() { # <key> <subverb>
    local e verbs tok
    while IFS= read -r e; do
        [ -n "$e" ] || continue
        verbs=${e%% *}
        in_list "$2" "$verbs" || continue
        for tok in ${e#* }; do
            case "$tok" in "$1="*) printf '%s' "${tok#*=}"; return 0 ;; esac
        done
    done <<EOF
$D_SUB
EOF
    return 1
}

# `--flag=value` counts as `--flag`: an unrecognised `--target=<t>` would leave
# `where` at its default and send a host command to the podman VM instead.
flag_override() { # <key> <args...>
    local key="$1" e flags a tok found=""; shift
    while IFS= read -r e; do
        [ -n "$e" ] || continue
        flags=${e%% *}
        for a in ${1+"$@"}; do
            in_list "${a%%=*}" "$flags" || continue
            for tok in ${e#* }; do
                case "$tok" in "$key="*) found=${tok#*=} ;; esac
            done
        done
    done <<EOF
$D_FLAG
EOF
    [ -n "$found" ] || return 1
    printf '%s' "$found"
}

cmd_name() { # <args...>
    local n
    n=$(flag_override name ${1+"$@"}) || n=$(sub_override name "${1:-}") || n="$D_NAME"
    printf '%s' "$n"
}

# The other half of where the name sits, after the sub/flag overrides.
cmd_takes() { # <args...>
    local n
    n=$(flag_override takes ${1+"$@"}) || n=$(sub_override takes "${1:-}") || n="$D_TAKES"
    printf '%s' "$n"
}

cmd_where() { # <impl> <args...>
    local impl="$1" w; shift
    w=$(flag_override where ${1+"$@"}) || w=$(sub_override where "${1:-}") || w="$D_WHERE"
    if [ "$w" = dynamic ]; then
        w=$("$impl" --where ${1+"$@"}) || die "'wk $(basename "$impl") --where' did not answer"
    fi
    printf '%s' "$w"
}

cmd_readonly() { # <subverb>
    [ -n "$D_READONLY" ] || return 1
    [ "$D_READONLY" = yes ] && return 0
    in_list "${1:-}" "$D_READONLY"
}

# Checked before the command starts, in one message shape; `wk doctor` holds
# the remedies. <subverb> lets a `sub <verbs> needs=<list>` line override the
# top-level list -- `wk quiesce status` reads what it can without the helper.
check_needs() { # <cmd> [<subverb>]
    local n missing="" needs="$D_NEEDS" ov
    if [ -n "${2:-}" ] && ov=$(sub_override needs "$2"); then needs="$ov"; fi
    [ -n "$needs" ] || return 0
    for n in $(printf '%s' "$needs" | tr , ' '); do
        case "$n" in
            gh-auth) gh_authenticated \
                         || missing="$missing
    gh-auth    gh cannot reach the GitHub API (not logged in, or the token expired): gh auth login" ;;
            tailnet) tailscale status >/dev/null 2>&1 \
                         || missing="$missing
    tailnet    this machine is not on the tailnet: tailscale up" ;;
            quiesce-helper)
                [ -x /usr/local/libexec/wk-quiesce-priv ] \
                    && sudo -n /usr/local/libexec/wk-quiesce-priv status >/dev/null 2>&1 \
                        || missing="$missing
    quiesce-helper    the privileged quiesce/session helper is not set up: ./setup --stage quiesce" ;;
            *)       command -v "$n" >/dev/null 2>&1 \
                         || missing="$missing
    $n    not installed here" ;;
        esac
    done
    [ -z "$missing" ] || die "'wk $1' cannot start here:$missing
    wk doctor says how to get each of these."
}

# The <n>th positional argument (1-based): where the workspace name sits.
positional() { # <n> <args...>
    local n="$1" a i=0; shift
    for a in "$@"; do
        case "$a" in -*) ;; *) i=$((i + 1)); [ "$i" -eq "$n" ] && { printf '%s' "$a"; return 0; } ;; esac
    done
    return 1
}

# So a command's own arguments can be told apart from a workspace name that
# may or may not be in front of them.
positional_count() { # <args...>
    local a i=0
    for a in ${1+"$@"}; do
        case "$a" in -*) ;; *) i=$((i + 1)) ;; esac
    done
    printf '%s' "$i"
}

# The workspace name in this argv, or nothing: the positional at the name's
# slot, but only when the command's own positionals (`takes`) are all still
# there after it, so `wk pr <ref>` is a ref and `wk pr <ws> <ref>` is both.
argv_name() { # <slot> <takes> <args...>
    local slot="$1" takes="$2"; shift 2
    [ "$(positional_count ${1+"$@"})" -ge "$((slot + takes))" ] || return 1
    positional "$slot" ${1+"$@"}
}

# The workspace whose tree the person is standing in, or nothing. On a shared
# build machine several live side by side under one root with no marker to be
# inside of, so the directory says which one is meant; argv still wins.
cwd_workspace() {
    in_remote_host || return 1
    local root name
    root=$(wk_remote_field root) || return 1
    [ -n "$root" ] || return 1
    case "$PWD/" in "$root"/ws/?*) ;; *) return 1 ;; esac
    name=${PWD#"$root"/ws/}
    name=${name%%/*}
    [ -n "$name" ] || return 1
    printf '%s' "$name"
}

without_positional() { # <n> <args...>
    local n="$1" a i=0; shift
    ARGS=()
    for a in "$@"; do
        case "$a" in -*) ;; *) i=$((i + 1)); [ "$i" -eq "$n" ] && continue ;; esac
        ARGS+=("$a")
    done
}

# Where the name sits in argv: 1, or the @N of the name declaration.
name_slot() { # <name-decl>
    case "$1" in *@*) printf '%s' "${1#*@}" ;; *) printf 1 ;; esac
}

# --- usage, derived from the commands themselves ------------------------------

usage() {
    {
        printf 'usage: wk <command> [args]\n'
        usage_group workspaces "workspaces"
        usage_group sources    "sources and disk"
        usage_group hosts      "hosts and machines"
        usage_group other      "other"
        cat <<'EOF'

  Inside a workspace the name is implicit: `wk build <config>`, `wk run -- <args>`
  act on this machine.

  wk <command> -h          what it does, what it acts on, whether it changes anything
  wk <command> --force     cross a refusal that exists because of a rule; the
                           warning repeats when the command ends. It does not
                           force past a missing workspace or a failed build
  wk <command> --quiet     drop the info/log narration; a result, a warning
                           and an error still print. Every command accepts it
  wk <command> --all       every one of what the command acts on -- every
                           machine ('wk push'/'wk sudo'), every workspace on
                           every target ('wk sync'), every line of the log
                           ('wk logs'); a command's own -h says what its --all covers
  WK_DEBUG=1               verbose output
EOF
        printf '\n  wk help                  README.md: architecture, setup, every workflow by example\n'
    } >&2
    exit 2
}

usage_group() { # <group> <title>
    local f n syn line printed=""
    for f in "$WK_ROOT"/cmd/*; do
        [ -f "$f" ] && [ -x "$f" ] || continue
        decl_load "$f"
        [ "$D_GROUP" = "$1" ] || continue
        n=$(basename "$f")
        line=$(synopsis "$f")
        syn=${line%% -- *}
        [ -n "$printed" ] || { printf '\n%s\n' "$2"; printed=1; }
        printf '  %-32s %s\n' "$syn" "${line#* -- }"
    done
}

# `wk --declarations`: one line per command, so `wk completion` reads what
# `wk`'s own usage reads. Tab-separated: name, where, name=, group, synopsis.
dump_declarations() {
    local f n line syn
    for f in "$WK_ROOT"/cmd/*; do
        [ -f "$f" ] && [ -x "$f" ] || continue
        decl_load "$f"
        n=$(basename "$f")
        line=$(synopsis "$f")
        syn=${line%% -- *}
        printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$D_WHERE" "$D_NAME" "$D_GROUP" "$syn"
    done
}

# --- help ---------------------------------------------------------------------
# README.md is the one document. `wk help <topic>` prints the sections whose
# heading names the topic (a `##` section, or a `**bold**` workflow title).
help_doc() { # [topic]
    local f="$WK_ROOT/README.md"
    if [ -n "${1:-}" ]; then
        python3 - "$f" "$1" <<'PY' || exit 1
import re, sys
text, topic = open(sys.argv[1]).read(), sys.argv[2].lower()
# Two levels: a `## section` runs to the next `##`; a `**workflow**` title
# inside one runs to the next title of either kind.
heading = re.compile(r"^(## .+|\*\*[^*]+\*\*)$", re.M)
marks = [(m.start(), m.group(0)) for m in heading.finditer(text)]
out, names = [], []
for i, (start, head) in enumerate(marks):
    level = 2 if head.startswith("##") else 3
    name = head.strip("#* ")
    names.append(name)
    end = len(text)
    for later, _ in [(s, h) for s, h in marks[i + 1:] if level == 3 or h.startswith("##")]:
        end = later
        break
    if topic in name.lower():
        out.append(text[start:end].rstrip() + "\n")
if not out:
    sys.stderr.write("error: no help topic matches '%s'. Topics (wk help <word>):\n" % sys.argv[2])
    for n in names: sys.stderr.write("    %s\n" % n)
    sys.exit(1)
sys.stdout.write("\n".join(out))
PY
        exit 0
    fi
    if [ -t 1 ] && command -v less >/dev/null 2>&1; then less "$f"; else cat "$f"; fi
    exit 0
}

# The answer to "runs on", for one `where=` value. One table, printed for the
# command and again for every subverb and flag that overrides it.
where_prose() { # <where>
    case "$1" in
        host)    printf "this host's own hardware; refused inside a workspace and on a build machine" ;;
        store)   printf "the machine holding the store -- the podman VM on macOS, this machine otherwise; refused inside a workspace" ;;
        local)   printf 'this machine, never forwarded' ;;
        dynamic) printf 'whichever the command itself answers for the rest of the arguments' ;;
        *)       if [ -n "$D_HERE" ]; then
                     printf 'the machine you type it on -- it needs this device'"'"'s editor or files'
                 elif [ -n "$D_LIFECYCLE" ]; then
                     printf 'the workstation that keeps the workspace record'
                 else
                     printf "the workspace's target, on the machine holding it (the podman VM for a container workspace on macOS; that machine's own wk when it has one)"
                 fi ;;
    esac
}

# One line per `sub`/`flag where=` override: the top-level `where=` is wrong for
# most invocations of a command whose subverbs run somewhere else (`wk push on`).
# Read from D_SUB/D_FLAG, not a second reading of the header.
where_overrides() {
    local e verbs w tok
    while IFS= read -r e; do
        [ -n "$e" ] || continue
        verbs=${e%% *}
        w=""
        for tok in ${e#* }; do
            case "$tok" in where=*) w=${tok#where=} ;; esac
        done
        [ -n "$w" ] || continue
        printf '    %s: %s\n' "${verbs//,/, }" "$(where_prose "$w")"
    done <<EOF
$D_SUB
$D_FLAG
EOF
}

# The one help path for every command: cmd/<name>'s header is the reference
# text, the declaration says what it acts on.
explain_cmd() { # <cmd> <impl>
    local cmd="$1" impl="$2"
    printf 'wk %s\n\n' "$(synopsis "$impl")"
    if cmd_readonly; then
        printf '  changes things: no -- starts nothing, writes nothing, repairs nothing\n'
    else
        printf '  changes things: yes\n'
    fi
    printf '  runs on: %s\n' "$(where_prose "$D_WHERE")"
    where_overrides
    grep -q -- '--dry-run' "$impl" 2>/dev/null \
        && printf '  preview: wk %s ... --dry-run resolves everything and changes nothing\n' "$cmd"
    printf '\nwhat it does (from %s):\n' "${impl#$WK_ROOT/}"
    awk 'NR == 1 { next }
         /^# wk:/ { next }
         /^# wk [a-z]/ && !seen { next }
         /^#/  { sub(/^# ?/, ""); if ($0 == "" && !seen) next; seen = 1; print "  " $0; next }
         { exit }' "$impl"
    # The closed set, from the one list that defines it (values=<flag>).
    if [ -n "$D_VALUES" ]; then
        printf '\nvalid values (wk %s %s):\n' "$cmd" "$D_VALUES"
        # Through wk itself, not the impl directly: a values flag can carry its
        # own `where=` override (`wk bench --list` runs in the podman VM on
        # macOS). Whatever it says, refusal included, since help never fails.
        { "$WK_ROOT/wk" "$cmd" "$D_VALUES" 2>&1 || true; } | sed 's/^/  /'
    fi
    exit 0
}

# --- which target, and whether to forward -------------------------------------
# Only the container target lives inside the podman VM; vm and remote workspaces
# are driven from the host. An explicit WK_TARGET wins, then `--target`, then
# which target answers for the name (ws_locate). Called once per invocation.
resolve_target() {
    local prev='' a name='' decl slot takes
    [ -n "${WK_TARGET:-}" ] && { printf '%s' "$WK_TARGET"; return 0; }
    for a in "$@"; do
        if [ "$prev" = --target ]; then printf '%s' "$a"; return 0; fi
        # Both spellings, since a command's own parser takes both: a
        # `--target=<t>` read as no target resolves to the default and sends
        # the command to a machine nobody named.
        case "$a" in --target=?*) printf '%s' "${a#*=}"; return 0 ;; esac
        prev="$a"
    done
    # Which positional is the name is the declaration's answer (argv_name), not
    # "the first that is not a flag": name=none has no workspace in its argv.
    decl=$(cmd_name "$@"); slot=$(name_slot "$decl"); takes=$(cmd_takes "$@")
    if [ "${decl%@*}" != none ]; then
        name=$(argv_name "$slot" "$takes" "$@") || name=$(cwd_workspace) || name=""
        [ -z "$name" ] || { ws_target "$name"; return 0; }
    fi
    printf '%s' container
}

machine_running() {
    [ "$(podman machine inspect "$WK_MACHINE" --format '{{.State}}' 2>/dev/null)" = running ]
}

status_view_env() {
    # The default is the shared one (status_default_mode, lib/common.sh): on a
    # macOS host *this* process renders and on Linux cmd/status does, and a bare
    # `wk status` meaning two things would be two commands with one name.
    # Computed by bare_report *before* this is substituted, since in here stdout
    # is this substitution's pipe.
    local mode="${WK_STATUS_DEFAULT_MODE:-text}"
    # Seeded from the environment for the same reason the mode is: cmd/status
    # honours WK_STATUS_PORT and WK_STATUS_INTERVAL, and on a macOS host it is
    # not the process that renders.
    local out="" port="${WK_STATUS_PORT:-}" interval="${WK_STATUS_INTERVAL:-}"
    # Asked for, as against defaulted to -- see the --wait clause below.
    local asked="" wait=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) mode=json; asked=1 ;;
            --web)  mode=web;  asked=1 ;;
            --text|--cli) mode=text; asked=1 ;;
            --wait) wait=1 ;;
            # The raw stream the halves speak to each other, useful for exactly
            # one thing: seeing what a collector said when a listing looks wrong.
            --records) mode=records ;;
            --html) mode=html; asked=1
                    case "${2:-}" in -*|"") ;; *) out="$2"; shift ;; esac ;;
            --port)      port="${2:-}"; shift ;;
            --port=*)    port="${1#*=}" ;;
            --interval)  interval="${2:-}"; shift ;;
            --interval=*) interval="${1#*=}" ;;
        esac
        shift
    done
    # `--wait` is not "look at the fleet": the answer is the line and the exit
    # code, which a page that blocks until ctrl-c buries. Needed here as well as
    # in cmd/status, this being the process that would serve on a macOS host.
    if [ -z "$asked" ] && [ -n "$wait" ] && [ "$mode" = web ]; then mode=text; fi
    printf 'WK_STATUS_MODE=%s\n' "$(sh_quote "$mode")"
    printf 'WK_STATUS_HTML_OUT=%s\n' "$(sh_quote "$out")"
    printf 'WK_STATUS_PORT=%s\n' "$(sh_quote "$port")"
    printf 'WK_STATUS_INTERVAL=%s\n' "$(sh_quote "$interval")"
}

bare_subject() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --port|--interval|--timeout)
                shift; [ $# -gt 0 ] && shift ;;
            # --html takes an optional path, so only a non-flag word after it is
            # its value rather than a workspace name.
            --html)
                shift
                case "${1:-}" in -*|"") ;; *) shift ;; esac ;;
            -*) shift ;;
            *)  return 1 ;;
        esac
    done
    return 0
}

bare_report() {
    local impl="$1" cmd="$2" t hosts='' rc worst=0
    shift 2
    # A function, because `[ x -gt y ] && worst=x` as the last command of an
    # AND-OR list returns 1 when the test is false, and `set -e` then ends the
    # walk on the second target reporting the same state as the first.
    _bump() { [ "$1" -gt "$worst" ] && worst="$1"; return 0; }

    for t in $(target_all); do
        [ "$t" = container ] && continue
        hosts="$hosts $t"
    done

    # This machine's own name, for both halves: the container store is inside
    # the podman VM, where `hostname` is the VM's and means nothing out here.
    # WK_HOST_SELF says it is *this* machine rather than one being asked about.
    _self=$(wk_machine_name)

    # Two halves, rendered once. Both write *records* (one JSON object per line)
    # into the same file, and the renderer merges them by machine name -- which
    # puts this machine's guests and containers under one heading.
    if [ "$cmd" = status ]; then
        _recs=$(mktemp)
        # Parsed here as well as in cmd/status because on this host *this*
        # process renders -- the two halves only collect. A function, so the
        # parse can shift its own arguments without disturbing the halves'.
        status_default_mode
        eval "$(status_view_env ${@+"$@"})"
        _mode="$WK_STATUS_MODE"
        export WK_STATUS_HTML_OUT WK_STATUS_PORT WK_STATUS_INTERVAL

        # Both halves at once, into files of their own. They ask entirely
        # different machines, so run serially the listing would wait for the sum
        # of two independent waits. Neither can write into the other's file
        # while it runs (a record stream interleaves mid-line), so the parent
        # concatenates them. Stdin from /dev/null: a background job that reads
        # the terminal is stopped by SIGTTIN, and `podman machine ssh` inherits.
        _recs_vm=$(mktemp)
        _recs_host=$(mktemp)
        _vm_pid=""
        _host_pid=""

        if machine_running; then
            ( WK_ROW_LABEL="$_self" WK_HOST_SELF=1
              # --no-devices, not --no-fleet: the boards are reached over ssh
              # from out here and the VM can see none of them.
              forward_to_vm "$cmd" --records --no-devices ${@+"$@"} ) \
                > "$_recs_vm" </dev/null &
            _vm_pid=$!
        elif command -v podman >/dev/null 2>&1; then
            warn "the podman machine '$WK_MACHINE' is stopped, so container workspaces are not included"
            log  "  'wk start' to bring it up"
        fi

        if [ -n "$hosts" ]; then
            ( WK_TARGET="${hosts# }" WK_ROW_LABEL="$_self" WK_HOST_SELF=1 \
                exec "$impl" --records ${@+"$@"} ) > "$_recs_host" </dev/null &
            _host_pid=$!
        fi

        # By pid: a bare `wait` would promise about every background job this
        # shell ever starts, and each half's exit code is half the contract.
        if [ -n "$_vm_pid" ];   then rc=0; wait "$_vm_pid"   || rc=$?; _bump "$rc"; fi
        if [ -n "$_host_pid" ]; then rc=0; wait "$_host_pid" || rc=$?; _bump "$rc"; fi
        cat "$_recs_vm" "$_recs_host" > "$_recs" 2>/dev/null || true
        rm -f "$_recs_vm" "$_recs_host"

        status_render "$_mode" "$_recs"
        rm -f "$_recs"
        exit "$worst"
    fi

    # One document from up to two processes, like the status halves -- captured
    # into files and merged (json_merge_list), two JSON documents back to back
    # not being one.
    _ls_json=""
    if [ "$cmd" = ls ]; then
        for _a in ${@+"$@"}; do [ "$_a" = --json ] && _ls_json=1; done
    fi
    _ls_local="" _ls_vm="" _ls_empty=""

    if [ -n "$hosts" ]; then
        rc=0
        if [ -n "$_ls_json" ]; then
            _ls_local=$(mktemp)
            WK_TARGET="${hosts# }" "$impl" ${@+"$@"} > "$_ls_local" || rc=$?
        elif [ "$cmd" = ls ] && machine_running; then
            # The VM's half follows, so this half must not call the listing
            # empty; whether it printed a row is what the second half is told.
            _ls_local=$(mktemp)
            WK_TARGET="${hosts# }" "$impl" --more-follows ${@+"$@"} > "$_ls_local" || rc=$?
            cat "$_ls_local"
            [ "$(wc -l < "$_ls_local")" -gt 1 ] || _ls_empty=--empty-so-far
            rm -f "$_ls_local"; _ls_local=""
        else
            WK_TARGET="${hosts# }" "$impl" ${@+"$@"} || rc=$?
        fi
        _bump "$rc"
    fi

    if machine_running; then
        # The second half of one listing: rows, no header, no empty note.
        rc=0
        if { [ "$cmd" = ls ] || [ "$cmd" = remotes ]; } && [ -n "$hosts" ]; then
            if [ -n "$_ls_json" ]; then
                _ls_vm=$(mktemp)
                ( WK_ROW_LABEL="$_self"; forward_to_vm "$cmd" --continued ${@+"$@"} ) > "$_ls_vm" || rc=$?
            else
                ( WK_ROW_LABEL="$_self"; forward_to_vm "$cmd" --continued ${_ls_empty:+"$_ls_empty"} ${@+"$@"} ) || rc=$?
            fi
        else
            ( WK_ROW_LABEL="$_self"; forward_to_vm "$cmd" ${@+"$@"} ) || rc=$?
        fi
        _bump "$rc"
    elif command -v podman >/dev/null 2>&1; then
        warn "the podman machine '$WK_MACHINE' is stopped, so container workspaces are not included"
        log  "  'wk start' to bring it up"
    fi

    if [ -n "$_ls_json" ]; then
        json_merge_list workspaces "$_ls_local" "$_ls_vm"
        rm -f "$_ls_local" "$_ls_vm"
    fi
    exit "$worst"
}

# --- handing a command to the machine that holds the workspace ----------------
# A workspace lives on exactly one machine, and a peer workstation's containers
# and guests are reachable by no path from here. The driver says so
# (t_delegates), the whole command goes over, and the far side resolves the name
# from its own evidence. Two kinds stay here, both declared: `here` and
# `lifecycle`.
delegate_target() { # <target> -- it back when it is such a machine, nothing otherwise
    ( load_target "$1" >/dev/null 2>&1 && t_delegates ) 2>/dev/null || return 0
    printf '%s' "$1"
}

# A pty when this end is one, like forward_to_vm: `wk enter` and `wk run --lldb`
# are conversations. Both ends checked, so a captured stdout stays clean.
delegate_run() { # <machine> <cmd> <args...>
    local t="$1" cmd="$2" rc=0
    shift 2
    load_target "$t"
    case "$(t_far_side)" in
        answering) ;;
        unreachable) die "'$cmd' acts on a workspace on $t, and $t did not answer.
    Nothing here can reach into it: the workspace is that machine's own." ;;
        *) die "'$cmd' acts on a workspace on $t, which has no wk-tools of its own to
    run it:  wk remote setup $t" ;;
    esac
    # No WK_HOST_SELF: what comes back is a report about another machine.
    WK_ROW_LABEL="$t"; export WK_ROW_LABEL

    if [ -t 0 ] && [ -t 1 ]; then t_wk_tty "$cmd" ${@+"$@"}; exit $?; fi
    t_wk "$cmd" ${@+"$@"} || rc=$?
    exit "$rc"
}

forward_to_vm() {
    require podman "podman is required; install the official pkg from podman.io"
    local _self_name; _self_name=$(wk_machine_name)

    podman machine inspect "$WK_MACHINE" >/dev/null 2>&1 \
        || die "podman machine '$WK_MACHINE' does not exist -- run ./setup first"

    if [ "$(podman machine inspect "$WK_MACHINE" --format '{{.State}}' 2>/dev/null)" != running ]; then
        # Rule 6: read-only commands are read-only absolutely. Here rather than
        # at the call sites because this is the single place that can start the
        # machine, and it closes the window after a caller's own check.
        if cmd_readonly "${2:-}"; then
            warn "the podman machine '$WK_MACHINE' is stopped, so its store cannot be read"
            log  "  'wk start' to bring it up -- 'wk $1' will not start it"
            exit 0
        fi
        info "starting podman machine '$WK_MACHINE'"
        podman machine start "$WK_MACHINE" >&2
    fi

    # Everything the VM reports is about *this* machine, and its own hostname
    # ("localhost") means nothing out here -- so it is told what to call itself,
    # unless the caller has already said (bare_report does).
    : "${WK_ROW_LABEL:=$_self_name}"
    : "${WK_HOST_SELF:=1}"

    # -- separates our args from ssh's. WK_IN_VM stops the VM-side wk from
    # trying to forward again if anything is ever misconfigured.
    local _cmd
    _cmd="WK_IN_VM=1 $(wk_forwarded_env)${WK_ROW_LABEL:+WK_ROW_LABEL=$(sh_quote "${WK_ROW_LABEL:-}") }${WK_HOST_SELF:+WK_HOST_SELF=1 }${WK_CONFIG:+WK_CONFIG=$(sh_quote "${WK_CONFIG:-}") }/opt/wk-tools/wk $(sh_quote "$@")"

    # A terminal does not survive `podman machine ssh`: it runs ssh without
    # asking for a pty, so the far side sees no tty and everything forwarded
    # that needs to *ask* something is unanswerable. So when this end really is
    # a terminal, the hop is made with ssh directly and `-t`, from the machine's
    # own connection details. Both ends of the pipe are checked, not just stdin:
    # a pty rewrites line endings, and `wk status`'s halves have stdout
    # redirected into a records file while stdin is still the terminal. The host
    # key is not pinned: podman regenerates it whenever the machine is recreated,
    # and it is reached at 127.0.0.1 on this user's own forwarded port.
    if [ -t 0 ] && [ -t 1 ]; then
        local _p _k _u
        _p=$(podman machine inspect "$WK_MACHINE" --format '{{.SSHConfig.Port}}' 2>/dev/null) || _p=""
        _k=$(podman machine inspect "$WK_MACHINE" --format '{{.SSHConfig.IdentityPath}}' 2>/dev/null) || _k=""
        _u=$(podman machine inspect "$WK_MACHINE" --format '{{.SSHConfig.RemoteUsername}}' 2>/dev/null) || _u=""
        if [ -n "$_p" ] && [ -n "$_k" ] && [ -n "$_u" ]; then
            exec ssh -t -p "$_p" -i "$_k" \
                -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                -o LogLevel=ERROR "$_u@127.0.0.1" "$_cmd"
        fi
    fi

    exec podman machine ssh "$WK_MACHINE" -- "$_cmd"
}


# --- main ---------------------------------------------------------------------

main() {
    [ $# -ge 1 ] || usage
    local cmd="$1" _a _seen_dashdash="" _rest where name="" delegate="" decl="" slot="" takes=0; shift
    case "$cmd" in
        help|-h|--help) help_doc "${1:-}" ;;
        setup) exec "$WK_ROOT/setup" "$@" ;;
        image) die "'wk image' is renamed: wk sysimage" ;;
        claude) die "'wk claude' is renamed: wk ai claude${1:+ $1}
    One command for every coding agent (wk ai -h)." ;;
        --declarations) dump_declarations; exit 0 ;;
    esac
    local impl="$WK_ROOT/cmd/$cmd"
    [ -x "$impl" ] || { warn "unknown command: $cmd"; usage; }
    decl_load "$impl"

    _rest=()
    for _a in ${@+"$@"}; do
        case "$_seen_dashdash:$_a" in
            :-h|:--help|:--explain) explain_cmd "$cmd" "$impl" ;;
            :--force) WK_FORCE=1; export WK_FORCE; continue ;;
            :--quiet) WK_QUIET=1; export WK_QUIET; continue ;;
            :--)      _seen_dashdash=1 ;;
        esac
        _rest+=("$_a")
    done
    set -- ${_rest[@]+"${_rest[@]}"}

    # WK_NAME is this invocation's answer, never an inherited one: a shell
    # started by an earlier `wk` would otherwise hand on that workspace.
    unset WK_NAME

    where=$(cmd_where "$impl" "$@")

    # A host command inside a workspace or on a shared build host acts on a
    # store that is not here.
    if in_workspace && { [ "$where" = host ] || [ "$where" = store ] || [ -n "$D_OUTSIDE" ]; } && ! in_list "${1:-}" "$D_BROKER"; then
        if [ -n "$D_OUTSIDE" ]; then
            die "'wk $cmd' acts on a host, and this is workspace '$(wk_self)'.
    From the host:  wk $cmd $(wk_self)"
        fi
        die "'wk $cmd' acts on a host, and this is workspace '$(wk_self)'.
    From the host:  wk $cmd${*:+ $*}"
    fi
    if in_remote_host && [ "$where" = host ]; then
        die "'wk $cmd' acts on a workstation's own store or hardware, and this is
    the shared build machine for target '$(wk_remote_field target)'.
    Run it on the workstation instead. What works here: ls, status, build,
    run, test, logs, enter."
    fi
    if in_remote_host && [ -n "$D_LIFECYCLE" ]; then
        die "workspaces are created and destroyed from the workstation, and this is
    the shared build machine for target '$(wk_remote_field target)'.
    Run 'wk $cmd' there: the workstation owns the workspace's store, and a
    later 'wk build' finds its target from that store."
    fi

    # Once, for the two questions that need it: which machine this command is
    # about, and which positional to take the name from.
    if [ "$where" = workspace ]; then
        decl=$(cmd_name "$@"); slot=$(name_slot "$decl"); takes=$(cmd_takes "$@")
    fi

    # Resolved once, here, because resolving a name walks every target that
    # could hold it (ws_locate) and three questions below need the same answer.
    # Inside a workspace there is nothing to resolve.
    resolved=""
    if [ "$where" = workspace ] && ! in_workspace; then
        resolved=$(resolve_target "$@")
    fi

    # Decided once here. Before check_needs, because what a command needs is
    # needed on the machine that will run it.
    if [ "$where" = workspace ] && [ "${decl%@*}" != none ] \
       && ! in_workspace && [ -z "${WK_IN_VM:-}" ] \
       && [ -z "$D_HERE" ] && [ -z "$D_LIFECYCLE" ]; then
        delegate=$(delegate_target "$resolved")
    fi

    # After the refusals about where it may run and before anything starts. On a
    # macOS host a container command is answered in the podman VM, which has its
    # own tools; the check runs there.
    { [ "$where" = workspace ] && is_macos && [ -z "${WK_IN_VM:-}" ] && ! in_workspace \
        && [ "$D_FORWARD" = yes ] && [ "$resolved" = container ]; } \
        || [ -n "$delegate" ] || check_needs "$cmd" "${1:-}"

    # A store command on a macOS workstation acts on /var/lib/wk inside the
    # podman VM, which this side can neither create nor read. Forwarded rather
    # than attempted: attempting it is `mkdir: Permission denied`.
    if [ "$where" = store ] && [ -z "${WK_IN_VM:-}" ]; then
        command -v store_is_local >/dev/null 2>&1 || . "$WK_ROOT/lib/store.sh"
        store_is_local || forward_to_vm "$cmd" "$@"
    fi

    [ "$where" = workspace ] || exec "$impl" "$@"

    # Resolved, waited for and acted on over there, by the same dispatcher
    # reading the same declaration.
    [ -z "$delegate" ] || delegate_run "$delegate" "$cmd" "$@"

    # --- a workspace command ---------------------------------------------------
    if ! in_workspace && [ "${decl%@*}" = required ]; then
        argv_name "$slot" "$takes" "$@" >/dev/null || cwd_workspace >/dev/null \
            || usage_die "$cmd" "$impl"
    fi
    if in_workspace; then
        : "${WK_TARGET:=local}"; export WK_TARGET
        resolved="$WK_TARGET"
        name=$(wk_self)
        if [ "${decl%@*}" != none ] && [ "$(argv_name "$slot" "$takes" "$@" || true)" = "$name" ]; then
            die "this is workspace '$name', and there is no workspace argument in here --
    every command acts on this one. Drop the name: wk $cmd"
        fi
    elif is_macos && [ -z "${WK_IN_VM:-}" ] && [ "$D_FORWARD" = yes ] \
            && [ "$resolved" = container ]; then
        # A container workspace on a macOS host lives in the podman VM; the
        # VM's own `wk` resolves the name and waits for readiness there.
        if [ "$D_POST" = zed ] && in_list --zed "$(printf '%s,' "$@")"; then
            ARGS=(); for _a in "$@"; do [ "$_a" = --zed ] || ARGS+=("$_a"); done
            name=$(positional 1 ${ARGS[@]+"${ARGS[@]}"}) \
                || die "'wk $cmd --zed' needs a workspace name"
            ( forward_to_vm "$cmd" ${ARGS[@]+"${ARGS[@]}"} ) \
                || die "'wk $cmd $name' failed, so nothing was opened.
    What it managed to say is above; a re-run destroys the rubble and retries."
            exec "$WK_ROOT/cmd/zed" "$name"
        fi
        if [ "$D_POST" = ssh-alias-remove ]; then
            name=$(positional 1 "$@" || true)
            ( forward_to_vm "$cmd" "$@" ) || exit $?
            [ -z "$name" ] || ssh_alias_remove "$name"
            exit 0
        fi
        if [ "$D_BARE" = merged ] && bare_subject "$@"; then
            bare_report "$impl" "$cmd" "$@"
        fi
        if cmd_readonly "${1:-}" && ! command -v podman >/dev/null 2>&1; then
            warn "podman is not installed, so there are no container workspaces to read"
            log  "  './setup' installs it; 'wk vm ls' lists the macOS guests, which do not need it"
            exit 0
        fi
        forward_to_vm "$cmd" "$@"
    fi

    # Resolve the name once; the command reads WK_NAME. The positional at the
    # slot is the name whatever it says -- what it says is checked below.
    case "${decl%@*}" in
        required|optional)
            if [ -z "$name" ]; then
                _a=$(argv_name "$slot" "$takes" "$@" || true)
                if [ -n "$_a" ]; then
                    name="$_a"; without_positional "$slot" "$@"; set -- ${ARGS[@]+"${ARGS[@]}"}
                else
                    # Nothing in argv: the directory, on a machine where that
                    # is what "this workspace" means (cwd_workspace).
                    name=$(cwd_workspace || true)
                fi
            fi ;;
    esac
    if [ -n "$name" ]; then
        WK_NAME="$name"; export WK_NAME
        command -v wk_ws_dir >/dev/null 2>&1 || . "$WK_ROOT/lib/store.sh"
        # A name nothing answers to is refused here, once, for every command.
        # Left to reach the command it is either ignored -- `wk stop <typo>`
        # stopped every workspace on the machine -- or reported as an argument
        # the command never expected. Inside a workspace the marker is the proof
        # it exists, and a lifecycle command is handed a name with nothing yet.
        if [ -z "$D_LIFECYCLE" ] && ! in_workspace; then
            # On the target it resolved to, not on every target again: the
            # walk that produced $resolved already asked them all.
            ws_exists_on "$resolved" "$name" \
                || usage_die "$cmd" "$impl" "no such workspace: $name -- 'wk ls' lists them"
        fi
        # The target this name resolved to, handed to the command rather than
        # walked a second time. Only on this path -- a forwarded or delegated
        # child resolves over there, and a lifecycle command has its own list.
        [ -n "$D_LIFECYCLE" ] || { WK_TARGET="$resolved"; export WK_TARGET; }
        if [ "$D_READY" = yes ]; then
            load_target "$resolved"
            wait_ready "$name"
        fi
    fi
    exec "$impl" "$@"
}
main "$@"
