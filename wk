#!/usr/bin/env bash
#
# wk -- WebKit development workspaces.
#
# On Linux (and inside the podman VM) this dispatches straight to cmd/<name>.
# On macOS most commands have nothing to act on locally, because workspaces
# live inside the VM; those are forwarded over `podman machine ssh`. Inside a
# workspace nothing is forwarded at all -- the target is the machine itself.
# This file must therefore stay bash 3.2 compatible -- macOS ships bash 3.2 and the whole
# point of the design is that the host installs nothing extra.

set -euo pipefail

WK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/target.sh"

WK_MACHINE="${WK_MACHINE:-wk}"

usage() {
    cat >&2 <<'EOF'
usage: wk <command> [args]

workspaces
  new <name> [--target T] [--zed] [--no-wait]
                            create a workspace (container | vm | remote, or a
                            machine in ~/.config/wk/targets/); --zed opens it.
                            Creation is detached and survives this connection;
                            --no-wait returns as soon as it is under way
  ls                        list workspaces
  enter <name> [--zed|cmd]  interactive shell (GPU/desktop integration on Linux)
  build <name> <config>     build, with derived job count and nice level
      --detach              run it on the machine that builds and return; the
                            build survives this connection going away
  status [name]             build/container state; exit code is machine-readable
  logs <name> [-f|--all]    build log, errors first
  run <name> [--config C] [--lldb] [args]   run jsc from the workspace build
  gui <name> [url]          MiniBrowser in the seat, launched as perf runs do
  test <name> [args]        run tests
  bench <name> <plan>       run a benchmark, with preflight and provenance
      stage <ws> --to <machine>
                            put a build where a machine's bench mode will find
                            it (build in the guest, run on the machine itself)
      staged [--plan P]     run it, in the bench mode booted for it; refused
                            in host mode, which is not the same
                            machine underneath
  profile <name> [file.js]  where the time went: JSC's own profilers, samply,
                            or Instruments -- one flag each, no env-var walls
      --mode <m>            sampling (default) | bytecode | samply |
                            instruments | heaptrack | massif | native
  verify <name> [--gpu]     prove the sandbox holds, by testing it
  claude <name>             launch Claude inside the workspace, sandboxed
  rm <name>                 destroy a workspace and everything it created
  stop [--keep-vm]          shut down all containers and the VM; nothing is lost
  start                     bring them all back

sources and disk
  sync [--all|--target <t>] fetch all upstreams, publish a new base snapshot
                            (--target: refresh a machine's tooling and mirror)
  skills <sub>              status|diff|pull|push the shared, mutable skills
  key <sub>                 register|check the fork push keys (uses gh)
  sudo status|require       make root cost a password every time, here or on
                            a configured machine (--target T, --all)
  push on|off|status        whether workspaces may push to git at all; off is
                            what `wk claude` sets before an agent takes over
                            (--target T, --all: the machine that holds the key)
  remotes [ws] [--fix]      is origin upstream, and can fork be pushed to?
  pr [ws] <user>:<branch>   check out a PR head from WebKit or WPEWebKit; warns
                            only when your own work is at stake
  report                    weekly GitHub activity summary (uses gh)
  gc                        prune snapshots, images and caches; reclaim disk
      --purge-mirror        erase the master git store -- the bare mirror and
                            every base snapshot; 'wk sync' refetches them
      --purge-pmos          erase the pmbootstrap chroots on the pmos build
                            hosts (~8 GB each; the next build refetches them)
  disk                      what is stored on this machine, where, and the
                            total (read-only; 'wk help disk' says what to erase)

hosts and machines
  setup                     idempotent host bootstrap (also: ./setup)
  doctor                    what is provisioned here and what is missing (read-only)
  selftest [--quick]        run docs/TESTING.md against this machine
  version                   which wk-tools this machine runs (sha and tree hash)
  backup                    write live desktop settings back into the repo
  vm <sub>                  macOS VM lifecycle: ls|new|start|stop|ip|enter|sync|base|rm
      base [--refresh|--rebuild|--rm]
                            the golden guest every vm workspace is cloned from:
                            build it, fast-forward its checkout, remake it, or
                            erase it (it is the largest thing on the machine)
  pi <sub>                  setup: onto the tailnet; netboot-enable: the
                            EEPROM's only writer
  sysimage <sub>            bootable systems: build|ls|show|disks|write|rm
      write <id> --disk <machine>:<device>
                            write an image onto a removable disk attached to a
                            fleet machine (never that machine's own system
                            disk; writing one does not make anything boot it)
  boot <machine>            put a machine into bench mode for one boot
                            (--status|--keep|--back|--disarm|--diag|--dry-run)
  serve                     hand boot files to machines that netboot
                            (--system|--address|--status|--stop|--dry-run)
  remote setup|rm <target>  provision a shared build machine, or undo that
                            and forget it (never needs root)
  bridge <sub>              ls|setup|status|rm a tailnet bridge: a phone
                            routing a segment (a BMC port, a test board on a
                            cable) onto the tailnet. Declared in
                            bridge/hosts/<name>.conf; 'wk help bridge'
  quiesce on|off|status     quiet the machine for benchmarking
  session on|gdm|off|status a real GPU session, or a real desktop (Linux)
    session on [--bmc]      benchmark kiosk; --bmc moves it to the BMC to
                            watch over KVM-over-IP -- slower, never for numbers
    session gdm [--bmc]     the actual display manager and desktop instead;
                            --bmc hides the GPU from seat0 so it lands on the BMC
    session off             screen held dark on every output (not literally
                            nothing running -- some drivers won't blank for
                            real otherwise); nothing restarts on its own
  mcp                       MCP server, for the Claude Desktop app

  Inside a workspace the name is implicit and there is no host to reach:
  `wk build <config>`, `wk run -- <args>`, `wk test <args>` act on this machine.

  `wk <command> --explain` says what a command does, what it acts on, whether
  it changes anything, and how to preview it -- without running it.

  `wk <command> --force` turns a refusal that exists because of a rule -- an
  unfiltered guest, passwordless sudo -- into a loud warning, repeated when
  the command ends. It does not force past a missing workspace or a failed
  build: those are not rules, they are facts.

  WK_DEBUG=1 for verbose output.
EOF
    help_topics >&2
    exit 2
}

# --- help topics -------------------------------------------------------------
#
# `wk --explain` answers "what does this one command do". A topic answers the
# question underneath that: what a target *is*, which one to put a workspace on,
# where the disk went, how a machine becomes a target here. Neither is derivable
# from the other -- the first is a fact about an implementation and is derived
# from it, the second is a decision, and a decision has to be written down.
#
# The topics are files under docs/help/, one per topic, first line a summary.
# Files rather than heredocs in here for two reasons: this listing is then
# derived from what exists rather than being a second list to keep right, and
# the prose is readable (and greppable, and reviewable in a diff) without being
# indented inside a shell function.
help_dir() { echo "$WK_ROOT/docs/help"; }

help_topics() {
    local f n
    [ -d "$(help_dir)" ] || return 0
    printf '\nconcepts -- wk help <topic>\n'
    for f in "$(help_dir)"/*.txt; do
        [ -f "$f" ] || continue
        n=$(basename "$f" .txt)
        printf '  %-25s %s\n' "$n" "$(head -1 "$f")"
    done
}

help_topic() {
    local f; f="$(help_dir)/$1.txt"
    if [ ! -f "$f" ]; then
        warn "no help topic '$1'"
        help_topics >&2
        exit 2
    fi
    # From the second line: the first is the one-line summary the listing above
    # prints, and repeating it as the page's own first line reads like a stutter.
    tail -n +2 "$f"
    exit 0
}

# Which target a command will act on.
#
# This has to be answered *before* anything is forwarded, because only the
# container target lives inside the podman VM. A vm or remote workspace is
# driven from the host -- forwarding it would run tart or ssh from inside a
# Linux guest that has neither, and the resulting error would point at the
# wrong machine entirely.
#
# The order matters: an explicit WK_TARGET wins, then a `--target` on this
# command line (which is how `wk new` chooses), then what the workspace was
# registered as when it was created. Anything unregistered is a container,
# because that is both the default and what every workspace predating the
# registry is.
resolve_target() {
    local prev='' a name=''

    [ -n "${WK_TARGET:-}" ] && { printf '%s' "$WK_TARGET"; return 0; }

    for a in "$@"; do
        if [ "$prev" = --target ]; then printf '%s' "$a"; return 0; fi
        prev="$a"
        case "$a" in
            -*) ;;
            *)  [ -z "$name" ] && name="$a" ;;
        esac
    done

    # The same answer every command gets (ws_target, lib/target.sh): the
    # registry when it has one, and otherwise whichever target's own store on
    # this machine holds a workspace of that name. The fallback matters here
    # more than anywhere: a `wk new` that died before registering leaves a
    # workspace on a build box, and this used to answer `container`, forward
    # the command into the podman VM and have it report "no such workspace"
    # about a checkout that exists.
    #
    # Still a file test per configured target and nothing else -- no ssh, and
    # nothing started, which is what this function has to remain.
    if [ -n "$name" ]; then ws_target "$name"; return 0; fi
    printf '%s' container
}

# Invocations that act on no target at all, so there is nothing to forward and
# nothing to start. `wk build --list` prints the config table and stops; today
# it forwards, which boots the podman machine for nothing -- and on a host
# without podman it fails with "podman is required", naming a problem the
# command does not have.
is_targetless() {
    # A comparison of two *files on this machine* is host-side: a result taken
    # in bench mode lives on that machine's own volume, not in the
    # container store, and forwarding the command into the podman VM looks for
    # those paths in a Linux guest that has never seen them ("no such run", of
    # a file sitting right there). A comparison of two run *ids* still
    # forwards, because those runs and compare-results both live in there.
    if [ "$1" = bench ] && [ "${2:-}" = compare ]; then
        local _a
        for _a in "$@"; do
            [ -f "$_a" ] && return 0
        done
        return 1
    fi
    case "$1${2:+ $2}" in
        "build --list") return 0 ;;
        # `wk sync --target <machine>` acts on the far end of an ssh, so the
        # one thing it must not do is run inside the podman VM: the VM has no
        # route to that machine and its own copy of wk-tools is the thing being
        # replaced. A bare `wk sync` still forwards -- the container store it
        # publishes into is in there.
        "sync --target"|"sync --target="*) return 0 ;;
        # The two halves of a bare-metal benchmark run. Neither acts on a
        # container workspace and neither may be forwarded into the podman VM:
        # `stage` copies a build out of a *guest* onto a disk attached to this
        # machine, and `staged` runs on the machine that booted the benchmark
        # install. Forwarded, both resolved the word after `bench` as a
        # workspace name and reported "no such workspace: staged".
        "bench stage"|"bench staged") return 0 ;;
    esac
    return 1
}

# Commands that only mean anything on a host, and are refused inside a workspace.
#
# Not the same list as is_host_command below: that one is about *forwarding*
# (which of them the podman machine must not be handed), this one is about the
# machine they act on. Every one of these operates on a host's hardware or on
# the host's store -- the seat, the display, tart, the Pis, the snapshot mirror
# -- and none of that exists in a workspace. Left to run they either no-op
# against an empty store and report success, or do real work in the wrong place:
# `wk sync` inside a container would fetch a 13 GB mirror into a directory that
# is discarded with the workspace.
#
# Deliberately not listed: build, run, test, logs, status, ls, pr, skills --
# those act on the checkout or on the workspace, which is exactly what is here.
is_host_only() {
    case "$1" in
        setup|backup|vm|mcp|quiesce|session|pi|remote|bridge|stop|start|sync|gc) return 0 ;;
        # The fleet and the image store: a boot device, a firmware register, a
        # disk measured in gigabytes, a TFTP server on the LAN. None of it
        # exists in a workspace and the sandbox cannot reach the machine that
        # has it. Each of these three carried its own copy of this refusal,
        # with a comment saying it belonged here -- it does, next to the
        # commands it is the same rule as.
        sysimage|boot|serve) return 0 ;;
        *) return 1 ;;
    esac
}

# Creating and destroying a workspace belongs to the machine that keeps the
# record of it. A shared build box is the far end of a target, not the owner of
# one: it holds checkouts, and the registry that says which target a workspace
# belongs to -- and therefore where `wk build bug-238` should go -- lives on the
# workstation. A `wk new` there would write half that state on the wrong
# machine, and a `wk rm` there would delete the checkout while the workstation
# went on listing it.
is_lifecycle() {
    case "$1" in
        new|rm) return 0 ;;
        *) return 1 ;;
    esac
}

# Commands that act on the host itself and are never forwarded into the VM.
#
# `report` is here because it is `gh` and nothing else: the authenticated GitHub
# CLI lives on the host, the same reason `key` does. Forwarded, it ran in the
# podman machine, which has neither gh nor a credential to give it one.
# `disk` is here because the numbers that matter are host-side: the podman VM's
# disk image and the Tart guests are files on this machine, and the store inside
# the VM is asked for over one ssh -- but only when the machine is already
# running, which forwarding the whole command could not preserve.
is_host_command() {
    case "$1" in
        setup|doctor|selftest|backup|vm|mcp|quiesce|session|pi|remote|bridge|key|report|sudo|version|stop|start|disk|help|-h|--help) return 0 ;;
        # gc, because what it reclaims is on two machines when the workstation is
        # a Mac: the container store inside the podman VM, and the image store
        # and the pmos build hosts' caches out here. Forwarded whole it pruned
        # the first and silently left the other two -- so cmd/gc owns the split
        # now and pipes its own container half into the VM.
        gc) return 0 ;;
        # The image store and the fleet drivers are this machine's: the store
        # is under the host's $WK_STORE, the boot drivers reach machines over
        # ssh from here, and `wk serve` binds a port on this machine's LAN.
        # Forwarded into the podman VM they would have looked in an empty store
        # inside a Linux guest with no route to any of it.
        sysimage|boot|serve) return 0 ;;
        *) return 1 ;;
    esac
}

# Commands that report and change nothing. They still forward when the podman
# machine is already up -- the container store lives in there and nothing on the
# host can read it -- but they must never *start* it to answer.
#
# Starting it costs the whole memory envelope on a macOS host: `wk ls` booted
# the machine, and `wk vm start` then refused for want of memory, naming a
# conflict the user had not created. That is a steep price for a listing, and
# the same fault `wk build --list` had before it became targetless.
#
# The list is the four commands rule 6 names (docs/HANDOFF-workspace-state.md):
# status, ls, logs, doctor. `doctor` never reaches the forward -- it is a host
# command and answers here, asking the machine only when it is already running
# -- but it is named anyway, because the rule is about the command and not
# about which branch of this file happens to implement it today.
# A subcommand can be read-only where its command is not: `wk push status`
# lists where the deploy keys are and changes nothing, and booting a VM to
# answer it would be the same fault this list exists to prevent.
is_readonly_report() {
    case "$1${2:+ $2}" in
        "push status") return 0 ;;
        # Reading the image store, and asking a machine what it is attached to
        # or which role it is in. Every one of these changes nothing -- and
        # `wk boot --status` in particular has to stay that way, because it is
        # what you run when you are not sure what a machine is doing.
        "sysimage ls"|"sysimage show"|"sysimage disks") return 0 ;;
        "boot --status"|"boot --diag") return 0 ;;
        # A bridge listing reads conf files and asks each phone whether it
        # answers; `status` runs the on-device health check, which is read-only
        # by construction (bridge/bin/wk-bridge-healthcheck says so in its
        # first line, and exits non-zero rather than repairing anything).
        "bridge ls"|"bridge status") return 0 ;;
        "serve --status") return 0 ;;
        # `wk remotes --fix` writes: it re-asserts the wiring. Named here so
        # the *bare* form below can be read-only without this one sneaking in.
        "remotes --fix") return 1 ;;
    esac
    case "$1" in
        ls|status|logs|doctor|version|remotes|disk) return 0 ;;
        *) return 1 ;;
    esac
}

# --- what is this command? ---------------------------------------------------
#
# `wk <cmd> --explain` answers "what does this do, what will it touch, and how
# do I ask it to show me before it acts" -- for an agent, which otherwise has
# to read the implementation or guess from the name, and for anyone at a
# terminal wondering whether a command is safe to run here.
#
# Every fact printed is derived, and none of it is written twice:
#
#   what it does   the command's own header comment, which is the file's
#                  documentation and sits next to the code it describes. A
#                  second copy in a table here would be a copy to keep right.
#   what it acts on / whether it changes anything
#                  the same lists the dispatcher itself branches on, so a
#                  command that says "read-only" is read-only by the same
#                  test that stops it starting the podman machine.
#   how to preview it
#                  by looking for a --dry-run in the implementation, which is
#                  the only honest source for whether one exists.
#   usage          the line `wk help` already prints for it.
#
# Answered here, before any target is resolved and before anything is
# forwarded: explaining a command must never start a machine, and must work on
# a host where the thing it describes cannot even run.
explain_cmd() {
    local cmd="$1" impl="$2" line

    printf 'wk %s\n' "$cmd"

    # `|| true`: usage() ends in `exit 2`, and under `set -o pipefail` that
    # status becomes the assignment's, which would end this shell before it
    # printed anything at all.
    # The entry `wk help` prints for it, continuation lines included -- several
    # are two lines and the second one carries the qualifier that matters, and
    # the sub-flags under a command (`build --detach`, `image write`) are
    # indented six rather than eight, which an earlier threshold cut off
    # exactly where the interesting part started.
    # `|| true`: usage() ends in `exit 2`, and under `set -o pipefail` that
    # status becomes the assignment's, which would end this shell before it
    # printed anything at all.
    line=$( (usage 2>&1 || true) | awk -v c="$cmd" '
        $0 ~ "^  " c "( |$)" { on = 1; sub(/^  */, ""); print "  usage: " $0; next }
        on && /^ {6,}/       { sub(/^    /, ""); print "         " $0; next }
        on                   { exit }' ) || true
    [ -n "$line" ] && printf '%s\n' "$line"

    if is_readonly_report "$cmd"; then
        printf '  changes things: no -- read-only absolutely (starts nothing, writes nothing, repairs nothing)\n'
        # ...with the one exception a report is allowed to have: a command whose
        # own text offers --fix has a writing form, and claiming otherwise about
        # the command as a whole would be the kind of overstatement this line
        # exists to prevent.
        grep -q -- '--fix' "$impl" 2>/dev/null && \
            printf '                  ...except with --fix, which is the only form here that writes\n'
    else
        printf '  changes things: yes\n'
    fi

    if is_host_only "$cmd"; then
        printf "  runs on: a host's own store or hardware; refused inside a workspace and on a build machine\n"
    elif is_lifecycle "$cmd"; then
        printf '  runs on: the workstation that keeps the workspace record\n'
    elif is_host_command "$cmd"; then
        printf '  runs on: this machine, never forwarded\n'
    else
        printf "  runs on: the workspace's target (forwarded into the podman VM for a container workspace on macOS)\n"
    fi

    if grep -q -- '--dry-run' "$impl" 2>/dev/null; then
        printf '  preview: wk %s ... --dry-run resolves everything and changes nothing\n' "$cmd"
        # Where the dry run does not stop at "this is what I resolved" but
        # prints the commands themselves, say so -- that is the question
        # --explain gets asked next, and the answer is a different flag rather
        # than a longer explanation here. This file explains *the command*; the
        # dry run reports what an actual invocation would do, which only the
        # command (and, for a build, the target) can know.
        grep -q 'WK_DRY_RUN' "$impl" 2>/dev/null && \
            printf '           ...and prints the exact commands it would run, the far side%s\n' "'s included"
    fi

    # The header comment: everything from the line after the shebang to the
    # first line that is not a comment. Blank comment lines are kept, because
    # they are the paragraph breaks.
    printf '\nwhat it does (from %s):\n' "${impl#$WK_ROOT/}"
    # Two shapes, because one command is python: a `#` comment block, or a
    # module docstring. Both are the file's own first words about itself.
    awk 'NR == 1 { next }
         NR == 2 && /^"""/ { doc = 1; sub(/^"""[[:space:]]*/, "")
                             if ($0 != "") { seen = 1; print "  " $0 }
                             next }
         doc && /"""/ { exit }
         doc { if ($0 == "" && !seen) next
               seen = 1; print "  " $0; next }
         /^#!/ { next }
         /^#/  { sub(/^# ?/, "")
                 if ($0 == "" && !seen) next        # the blank line under the shebang
                 seen = 1; print "  " $0; next }
         { exit }' "$impl"
    exit 0
}

machine_running() {
    [ "$(podman machine inspect "$WK_MACHINE" --format '{{.State}}' 2>/dev/null)" = running ]
}

# A bare `wk ls` or `wk status` reports on every target there is -- and on a
# macOS host that claim was false. The dispatcher forwards a bare report into
# the podman VM, whose registry has never heard of a macOS guest or a shared
# build machine: both are driven from out here, and both were silently missing
# from the one command whose whole job is "what is happening". `wk ls` had it
# worse: it was forwarded whole, so it never mentioned them at all.
#
# So both go through here, and "the workspaces" means the same set in each:
# the host-side targets are walked in one pass out here (WK_TARGET takes a
# list, and cmd/ls and cmd/status share walk_targets), and the container half
# is forwarded, because that store is only readable in there.
#
# Not exec'd, unlike every other forward, so the two halves' exit codes can be
# combined: this command promises a machine-readable status and a caller must
# not be told about the containers alone.
bare_report() {
    local impl="$1" cmd="$2" t hosts='' rc worst=0
    shift 2
    # A function, because `[ x -gt y ] && worst=x` as the last command of an
    # AND-OR list returns 1 when the test is false, and `set -e` then ends the
    # walk on the second target that reports the same state as the first.
    _bump() { [ "$1" -gt "$worst" ] && worst="$1"; return 0; }

    for t in $(target_all); do
        [ "$t" = container ] && continue
        hosts="$hosts $t"
    done

    if [ -n "$hosts" ]; then
        rc=0; WK_TARGET="${hosts# }" "$impl" ${@+"$@"} || rc=$?
        _bump "$rc"
    fi

    if machine_running; then
        # What the forwarded half compares its tooling against: this machine's
        # tree, since this is where its copy is pushed from. Without it the
        # podman VM compares itself with itself and calls a stale copy "in
        # sync" -- true, and not the question being asked.
        if [ "$cmd" = status ]; then
            WK_EXPECT_TREE=$("$WK_ROOT/cmd/version" --tree 2>/dev/null || true)
            export WK_EXPECT_TREE
        fi
        # The forwarded half is the second half of one listing, so it prints
        # rows and neither a header nor an empty-listing note. `wk status`
        # needs no such flag: its rows carry no header, and its own
        # "(no workspaces)" line is already conditional on the whole walk.
        rc=0
        if { [ "$cmd" = ls ] || [ "$cmd" = remotes ]; } && [ -n "$hosts" ]; then
            ( forward_to_vm "$cmd" --continued ${@+"$@"} ) || rc=$?
        else
            ( forward_to_vm "$cmd" ${@+"$@"} ) || rc=$?
        fi
        _bump "$rc"
    elif command -v podman >/dev/null 2>&1; then
        warn "the podman machine '$WK_MACHINE' is stopped, so container workspaces are not included"
        log  "  'wk start' to bring it up"
    fi
    exit "$worst"
}

forward_to_vm() {
    require podman "podman is required; install the official pkg from podman.io"

    podman machine inspect "$WK_MACHINE" >/dev/null 2>&1 \
        || die "podman machine '$WK_MACHINE' does not exist -- run ./setup first"

    if [ "$(podman machine inspect "$WK_MACHINE" --format '{{.State}}' 2>/dev/null)" != running ]; then
        # Rule 6: read-only commands are read-only absolutely. The check is
        # here rather than only at the call sites because this is the single
        # place that can start the machine, and a guard that lives at the
        # callers is a guard that a later path can walk past -- which is
        # exactly what was observed. It also closes the window between a
        # caller's own machine_running check and this one.
        if is_readonly_report "$1" "${2:-}"; then
            warn "the podman machine '$WK_MACHINE' is stopped, so its store cannot be read"
            log  "  'wk start' to bring it up -- 'wk $1' will not start it"
            exit 0
        fi
        info "starting podman machine '$WK_MACHINE'"
        podman machine start "$WK_MACHINE" >&2
    fi

    # -- separates our args from ssh's. WK_IN_VM stops the VM-side wk from
    # trying to forward again if anything is ever misconfigured.
    exec podman machine ssh "$WK_MACHINE" -- \
        "WK_IN_VM=1 ${WK_DEBUG:+WK_DEBUG=1 }${WK_YES:+WK_YES=1 }${WK_FORCE:+WK_FORCE=1 }${WK_EXPECT_TREE:+WK_EXPECT_TREE=$(sh_quote "${WK_EXPECT_TREE:-}") }${WK_CONFIG:+WK_CONFIG=$(sh_quote "${WK_CONFIG:-}") }/opt/wk-tools/wk $(sh_quote "$@")"
}

main() {
    [ $# -ge 1 ] || usage
    local cmd="$1" _a _seen_dashdash="" _rest; shift

    case "$cmd" in
        # A topic argument makes this a question about a concept rather than
        # about a command -- and, like --explain, it must be answerable
        # anywhere: inside a workspace, on a build box, on a host with no
        # podman. Nothing below this point is reached.
        help|-h|--help) [ $# -ge 1 ] && help_topic "$1"; usage ;;
        # Advertised in the help but implemented by the top-level script, so it
        # has no cmd/ file for the dispatch below to find.
        setup) exec "$WK_ROOT/setup" "$@" ;;
        # Renamed 2026-08-20 (docs/HANDOFF-vocabulary.md): a bootable artifact
        # is a *system*, never bare "image" -- the old word also meant three
        # other things. One spelling, so the old one points rather than works.
        image) die "'wk image' is renamed: wk sysimage" ;;
    esac

    local impl="$WK_ROOT/cmd/$cmd"

    # Validate before forwarding. Otherwise a typo starts the VM and then fails
    # inside it, which is slow and reports the wrong problem.
    [ -x "$impl" ] || { warn "unknown command: $cmd"; usage; }

    # Before every refusal and every forward below: --explain is a question
    # about the command, not a use of it, so it must be answerable inside a
    # workspace, on a shared build machine, and on a host with no podman.
    # Only before a `--`: everything after that belongs to whatever the command
    # runs (`wk run <ws> -- --explain` is jsc's argument, not ours).
    #
    # --force is taken off the line here and passed as WK_FORCE, so every
    # command gets it without each one having to parse a flag it would then
    # have to remember to reject in the wrong place. Commands that already had
    # a --force of their own (wk bench) honour the variable as well.
    _rest=()
    for _a in ${@+"$@"}; do
        case "$_seen_dashdash:$_a" in
            :--explain) explain_cmd "$cmd" "$impl" ;;
            :--force)   WK_FORCE=1; export WK_FORCE; continue ;;
            :--)        _seen_dashdash=1 ;;
        esac
        _rest+=("$_a")
    done
    set -- ${_rest[@]+"${_rest[@]}"}

    if in_workspace && is_host_only "$cmd"; then
        die "'wk $cmd' acts on a host, and this is workspace '$(wk_self)'.
    Run it on the host instead."
    fi

    # A shared build machine is not a workstation either, and it is not the
    # owner of the workspaces it holds.
    #
    # The host-only list acts on a host's own store or hardware, and two of
    # them would do more than no-op, which is why this is a refusal rather than
    # a matter of taste: `wk sync` would build a 13 GB mirror in a home
    # directory whose MOTD asks everyone to keep disk use down, and `wk gc`
    # would prune a store that is not where this machine's workspaces come
    # from.
    if in_remote_host && is_host_only "$cmd"; then
        die "'wk $cmd' acts on a workstation's own store or hardware, and this is
    the shared build machine for target '$(wk_remote_field target)'.
    Run it on the workstation instead. What works here: ls, status, build,
    run, test, logs, enter."
    fi

    if in_remote_host && is_lifecycle "$cmd"; then
        die "workspaces are created and destroyed from the workstation, and this is
    the shared build machine for target '$(wk_remote_field target)'.
    Run 'wk $cmd' there: it keeps the record of which target a workspace
    belongs to, and that record is what sends a later 'wk build' back here.
    What works here: build, run, test, logs, status, ls, enter."
    fi

    if in_workspace; then
        # Inside a workspace every command acts on this machine. There is no
        # podman machine to forward to and there never can be -- a container has
        # no podman, a macOS guest has no nested virtualisation -- and the
        # workspace is the thing the command means. An explicit WK_TARGET still
        # wins, so a workspace can be told to act as something else if it ever
        # has the means to.
        : "${WK_TARGET:=local}"
        export WK_TARGET
    elif is_macos && [ -z "${WK_IN_VM:-}" ] && ! is_host_command "$cmd" \
            && ! is_targetless "$cmd" "$@"; then
        if [ "$(resolve_target "$@")" = container ]; then
            # Answering "there is nothing to say, and here is why" beats both
            # booting a VM for it and printing an empty table from a store that
            # is not this machine's.
            # A container workspace on a macOS host has no seat and never can
            # have one: the podman machine is a Linux VM with no GPU (SETUP.md
            # says so as a permanent property), and there is no host compositor
            # for it to draw into -- macOS has no Wayland socket to pass in.
            # Forwarded, `wk gui` would run inside the podman VM, where
            # `is_linux` is true, fail the seat check, and advise `wk session
            # on`, which refuses on macOS. Better to say the true thing here,
            # where both facts are known.
            #
            # VNC/SPICE into the container is the option not taken. It would
            # mean a compositor and a VNC server inside the workspace, both
            # installed through the egress allowlist, to reach a
            # software-rendered browser -- while the same machine has an
            # accelerated one a `wk vm new` away. Worth building only if a
            # container-only workspace ever has to be looked at.
            if [ "$cmd" = gui ]; then
                die "a container workspace on a macOS host has no display, and cannot get one:
    the podman machine has no GPU and there is no compositor to draw into.
    Use a macOS guest instead -- 'wk vm new <name>', then 'wk gui <name>',
    which runs MiniBrowser on the guest's own desktop with the real GPU."
            fi

            # --zed is the same shape of impossibility, and it was failing the
            # long way round: forwarded into the VM, where it looked for
            # /Applications/Zed.app and reported "zed is not installed" about a
            # Mac that has it. Measured 2026-08-19 against a fresh container
            # workspace -- the readiness gate held correctly, waited for
            # creation to finish, and then said that.
            #
            # It cannot work as it stands, for a second reason the message has
            # to carry: the generated alias is written by whichever side ran
            # `wk new`, and for a container on macOS that is the VM. So
            # `wk-<name>` exists in the VM's ssh config and not in this
            # machine's, and even a Zed launched here would have nothing to
            # resolve -- the container is inside a Linux VM with no route in
            # from the host.
            case " $* " in
                *" --zed "*)
                    die "a container workspace on a macOS host cannot be opened in Zed: Zed runs
    here, the container runs inside the podman VM, and there is no ssh route
    from this machine into it (the generated 'wk-<name>' alias is written in
    the VM, not here).
    Use a macOS guest -- 'wk vm new <name>', then 'wk enter <name> --zed' --
    or a remote target, both of which Zed can reach directly." ;;
            esac

            # Before the readonly-report shortcut below, which would answer
            # for the containers alone and exit.
            if [ $# -eq 0 ]; then
                case "$cmd" in
                    status|ls) bare_report "$impl" "$cmd" ;;
                esac
            fi
            # `wk remotes` is the same shape of report -- every workspace there
            # is -- and it keeps that meaning with its one flag, which is why it
            # is matched with an argument where status and ls are not.
            if [ "$cmd" = remotes ] && { [ $# -eq 0 ] || [ "${1:-}" = --fix ]; }; then
                bare_report "$impl" remotes ${1:+"$1"}
            fi

            # A machine that is merely stopped is handled inside
            # forward_to_vm, which is the one place that could start it and so
            # the one place the rule has to hold. This is the other half: no
            # podman at all, where there is nothing to forward to and `require
            # podman` would report a missing package rather than an empty
            # listing.
            if is_readonly_report "$cmd" "${1:-}" && ! command -v podman >/dev/null 2>&1; then
                warn "podman is not installed, so there are no container workspaces to read"
                log  "  './setup' installs it; 'wk vm ls' lists the macOS guests, which do not need it"
                exit 0
            fi
            forward_to_vm "$cmd" "$@"
        fi
    fi

    exec "$impl" "$@"
}

main "$@"
