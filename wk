#!/usr/bin/env bash
#
# wk -- WebKit development workspaces. `wk` lists the commands, `wk help` prints
# README.md, and `wk <command> -h` explains one command.
#
# Every command is a file under cmd/, and declares in its header what it acts
# on (see "declarations" below). This file reads that declaration and does,
# once for every command, what would otherwise be re-decided in each: resolve
# the workspace name, refuse a name inside a workspace, wait for a workspace to
# be ready, decide where the command runs, forward container work into the
# podman VM on a macOS host, and hand a command about a workspace another
# machine owns to that machine. bash 3.2 throughout: macOS ships nothing newer.
#
# --- environment protocol -----------------------------------------------------
# Set here for a forwarded or delegated child and read by cmd/* and lib/*;
# a command reads these rather than inventing its own version of one:
#   WK_NAME         the workspace name this invocation resolved to (main)
#   WK_TARGET       which target answers -- an explicit value skips
#                   discovery, else lib/target.sh's default_target
#   WK_CONFIG       the build config an already-forwarded command inherits
#   WK_IN_VM        this is the re-invocation inside the podman VM; stops it
#                   forwarding a second time
#   WK_ROW_LABEL    the machine name a forwarded or delegated command's
#                   records should claim, when it is not the one asked
#   WK_HOST_SELF    set alongside WK_ROW_LABEL: this row is *this* machine,
#                   not one being asked about (bare_report, forward_to_vm)
#   WK_EXPECT_TREE  the tree hash bare_report already computed, so the VM
#                   half of `wk status` need not recompute it
#   WK_NO_DELEGATE  set by a command already walking the fleet, so a machine
#                   it asks reports only what it holds and asks nobody
#   WK_ZED_PUBKEY   the key an editor on the *asking* machine will present,
#                   for a machine preparing one of its workspaces for it
#   WK_QUIET        --quiet: drop info/log narration (lib/common.sh)
#   WK_FORCE        --force: cross a refusal that exists because of a rule
#                   (lib/common.sh's barrier)

set -euo pipefail

WK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/target.sh"

WK_MACHINE="${WK_MACHINE:-wk}"

# --- declarations -------------------------------------------------------------
#
# Line 2 of cmd/<name> is its synopsis:   # wk <name> <args> -- <summary>
# and one or more `# wk:` lines in the first 15 lines declare its shape:
#
#   where=host       this workstation's store or hardware; never forwarded,
#                    refused inside a workspace and on a shared build host
#   where=local      runs wherever it is invoked; never forwarded
#   where=workspace  acts on a workspace: the name is resolved here, the
#                    target decides where it runs
#   where=dynamic    the command answers `wk <cmd> --where <args>` itself
#   name=required|optional|none   how the workspace name arrives. Outside a
#                    workspace the first positional is the name; inside one it
#                    is implicit and every positional belongs to the command.
#                    `optional` differs from `required` only in what a missing
#                    one means: all of them, or none. Either way a name that no
#                    workspace answers to is refused here, so no command has to
#                    decide what a name it does not recognise meant.
#   ready=yes        wait for the workspace to finish creating first
#   group=<g>        which block of `wk help` lists it
#   lifecycle        creates or destroys the workspace record (new, rm)
#   readonly [<subverbs>]   changes nothing; never starts the podman machine
#   broker <subverbs>|*     allowed inside a workspace, through the broker
#   forward no       a workspace command that runs on this host rather than
#                    inside the podman VM; it still goes to the machine that
#                    holds the workspace, if that is another one
#   here             a workspace command that runs where the person typed it
#                    and nowhere else -- it needs this device's editor. Implies
#                    forward=no
#   outside          a workspace command refused inside a workspace: it must
#                    look at the workspace from the host
#   bare merged      with no workspace named, report on every target here
#   post <hook>      zed | ssh-alias-remove, after the forwarded half
#   needs <a,b>      tools and standing this command cannot start without:
#                    a command name (gh, tart, nmap...), `gh-auth` (gh's token
#                    works), or `tailnet` (this machine is on the tailnet). Checked
#                    before anything runs, so the refusal names the remedy up front
#   sub <a,b> where=<w> name=<n>[@2] needs=<list>   per-subverb override of
#                    where, name and/or needs; @2 means the name is the
#                    positional after the subverb, and an empty needs= clears
#                    the command's list for subverbs that do not use it
#   flag <--x,--y> where=<w>|name=<n>   per-flag override of where and/or name

decl_load() { # <impl>
    D_WHERE=workspace D_NAME=none D_READY=no D_GROUP=other D_LIFECYCLE=""
    D_READONLY="" D_BROKER="" D_FORWARD=yes D_BARE="" D_POST="" D_SUB="" D_FLAG="" D_OUTSIDE="" D_NEEDS=""
    D_HERE=""
    local line tok
    set -f   # `broker *` is a word, not a glob
    while IFS= read -r line; do
        case "$line" in "# wk:"*) ;; *) continue ;; esac
        line=${line#"# wk:"}
        case "$line" in
            " sub "*)  D_SUB="$D_SUB
${line# sub }" ; continue ;;
            " flag "*) D_FLAG="$D_FLAG
${line# flag }" ; continue ;;
        esac
        for tok in $line; do
            case "$tok" in
                where=*)  D_WHERE=${tok#where=} ;;
                name=*)   D_NAME=${tok#name=} ;;
                ready=*)  D_READY=${tok#ready=} ;;
                group=*)  D_GROUP=${tok#group=} ;;
                lifecycle) D_LIFECYCLE=1 ;;
                readonly) D_READONLY=yes ;;
                broker)   D_BROKER=pending ;;
                needs)    D_NEEDS=pending ;;
                forward=no) D_FORWARD=no ;;
                here)     D_HERE=1; D_FORWARD=no ;;
                outside)  D_OUTSIDE=1 ;;
                bare=merged) D_BARE=merged ;;
                post=*)   D_POST=${tok#post=} ;;
                *)  case "$D_NEEDS:$D_READONLY:$D_BROKER" in
                        pending:*)     D_NEEDS=$tok ;;
                        *:yes:pending) D_BROKER=$tok ;;
                        *:yes:*)       D_READONLY=$tok ;;
                        *:*:pending)   D_BROKER=$tok ;;
                    esac ;;
            esac
        done
    done < <(head -15 "$1")
    set +f
    [ "$D_BROKER" = pending ] && D_BROKER="*"
    [ "$D_NEEDS" = pending ] && D_NEEDS=""
    return 0
}

# A bad invocation: the synopsis, and where the rest of the help is.
usage_die() { # <cmd> <impl> [why]
    [ -z "${3:-}" ] || warn "$3"
    log "usage: wk $(synopsis "$2" | sed 's/ -- .*//')"
    log "       wk $1 -h for the rest"
    exit 2
}

# The synopsis: the first `# wk <name> ... -- <summary>` line of the header.
synopsis() { # <impl>
    head -5 "$1" | sed -n 's/^# wk //p' | head -1
}

# Is <word> in the comma list <list>, or is the list "*"?
in_list() { # <word> <list>
    [ -n "$2" ] || return 1
    [ "$2" = "*" ] && return 0
    case ",$2," in *",$1,"*) return 0 ;; esac
    return 1
}

# The value of <key>= from a `sub` line whose verb list holds <subverb>.
sub_override() { # <key> <subverb>
    local e verbs tok
    while IFS= read -r e; do
        [ -n "$e" ] || continue
        verbs=${e%% *}
        in_list "$2" "$verbs" || continue
        for tok in ${e#* }; do
            case "$tok" in "$1="*) printf '%s' "${tok#*=}"; return 0 ;; esac
        done
    done <<EOF
$D_SUB
EOF
    return 1
}

# The value of <key>= from a `flag` line naming a flag that is in <args...>.
# `--flag=value` counts as `--flag`: a declaration names the flag, and a
# spelling the flag's own parser accepts must not be invisible here -- an
# unrecognised `--target=<t>` would leave `where` at its default and send a
# host command to the podman VM instead.
flag_override() { # <key> <args...>
    local key="$1" e flags a tok found=""; shift
    while IFS= read -r e; do
        [ -n "$e" ] || continue
        flags=${e%% *}
        for a in ${1+"$@"}; do
            in_list "${a%%=*}" "$flags" || continue
            for tok in ${e#* }; do
                case "$tok" in "$key="*) found=${tok#*=} ;; esac
            done
        done
    done <<EOF
$D_FLAG
EOF
    [ -n "$found" ] || return 1
    printf '%s' "$found"
}

# How the name arrives for this invocation, after the flag and sub overrides.
cmd_name() { # <args...>
    local n
    n=$(flag_override name ${1+"$@"}) || n=$(sub_override name "${1:-}") || n="$D_NAME"
    printf '%s' "$n"
}

# Where this invocation runs, after the sub/flag overrides.
cmd_where() { # <impl> <args...>
    local impl="$1" w; shift
    w=$(flag_override where ${1+"$@"}) || w=$(sub_override where "${1:-}") || w="$D_WHERE"
    if [ "$w" = dynamic ]; then
        w=$("$impl" --where ${1+"$@"}) || die "'wk $(basename "$impl") --where' did not answer"
    fi
    printf '%s' "$w"
}

cmd_readonly() { # <subverb>
    [ -n "$D_READONLY" ] || return 1
    [ "$D_READONLY" = yes ] && return 0
    in_list "${1:-}" "$D_READONLY"
}

# What a command declared it needs, checked before it starts. One message shape
# for every command; `wk doctor` is where the remedies live.
#
# <subverb>, when given, lets a `sub <verbs> needs=<list>` line override the
# top-level list for that one subverb -- `wk quiesce status`/`wk session
# status` read what they can without the helper and must not be blocked by
# the same `needs` that gates `on`/`off`/`gdm`. Reuses sub_override rather
# than inventing a second per-subverb mechanism.
check_needs() { # <cmd> [<subverb>]
    local n missing="" needs="$D_NEEDS" ov
    if [ -n "${2:-}" ] && ov=$(sub_override needs "$2"); then needs="$ov"; fi
    [ -n "$needs" ] || return 0
    for n in $(printf '%s' "$needs" | tr , ' '); do
        case "$n" in
            gh-auth) gh_authenticated \
                         || missing="$missing
    gh-auth    gh cannot reach the GitHub API (not logged in, or the token expired): gh auth login" ;;
            tailnet) tailscale status >/dev/null 2>&1 \
                         || missing="$missing
    tailnet    this machine is not on the tailnet: tailscale up" ;;
            quiesce-helper)
                [ -x /usr/local/libexec/wk-quiesce-priv ] \
                    && sudo -n /usr/local/libexec/wk-quiesce-priv status >/dev/null 2>&1 \
                        || missing="$missing
    quiesce-helper    the privileged quiesce/session helper is not set up: ./setup --stage quiesce" ;;
            *)       command -v "$n" >/dev/null 2>&1 \
                         || missing="$missing
    $n    not installed here" ;;
        esac
    done
    [ -z "$missing" ] || die "'wk $1' cannot start here:$missing
    wk doctor says how to get each of these."
}

# The <n>th positional argument (1-based) -- where the workspace name sits:
# first, or second after a subverb.
positional() { # <n> <args...>
    local n="$1" a i=0; shift
    for a in "$@"; do
        case "$a" in -*) ;; *) i=$((i + 1)); [ "$i" -eq "$n" ] && { printf '%s' "$a"; return 0; } ;; esac
    done
    return 1
}

# ARGS = <args...> without the <n>th positional.
without_positional() { # <n> <args...>
    local n="$1" a i=0; shift
    ARGS=()
    for a in "$@"; do
        case "$a" in -*) ;; *) i=$((i + 1)); [ "$i" -eq "$n" ] && continue ;; esac
        ARGS+=("$a")
    done
}

# Where the name sits in argv: 1, or the @N of the name declaration.
name_slot() { # <name-decl>
    case "$1" in *@*) printf '%s' "${1#*@}" ;; *) printf 1 ;; esac
}

# --- usage, derived from the commands themselves ------------------------------

usage() {
    {
        printf 'usage: wk <command> [args]\n'
        usage_group workspaces "workspaces"
        usage_group sources    "sources and disk"
        usage_group hosts      "hosts and machines"
        usage_group other      "other"
        cat <<'EOF'

  Inside a workspace the name is implicit: `wk build <config>`, `wk run -- <args>`
  act on this machine.

  wk <command> -h          what it does, what it acts on, whether it changes anything
  wk <command> --force     cross a refusal that exists because of a rule; the
                           warning repeats when the command ends. It does not
                           force past a missing workspace or a failed build
  wk <command> --quiet     drop the info/log narration; a result, a warning
                           and an error still print. Every command accepts it
  wk <command> --all       every one of what the command acts on -- every
                           machine ('wk push'/'wk sudo'), every workspace on
                           every target ('wk sync'), every line of the log
                           ('wk logs'); a command's own -h says what its --all covers
  WK_DEBUG=1               verbose output
EOF
        printf '\n  wk help                  README.md: architecture, setup, every workflow by example\n'
    } >&2
    exit 2
}

usage_group() { # <group> <title>
    local f n syn line printed=""
    for f in "$WK_ROOT"/cmd/*; do
        [ -f "$f" ] && [ -x "$f" ] || continue
        decl_load "$f"
        [ "$D_GROUP" = "$1" ] || continue
        n=$(basename "$f")
        line=$(synopsis "$f")
        syn=${line%% -- *}
        [ -n "$printed" ] || { printf '\n%s\n' "$2"; printed=1; }
        printf '  %-32s %s\n' "$syn" "${line#* -- }"
    done
}

# `wk --declarations`: one line per command, machine-readable, so
# `wk completion` reads what `wk`'s own usage reads rather than re-parsing
# cmd/* a second way. Tab-separated: name, where, name=<required|optional|
# none>, group, synopsis (the part before " -- ").
dump_declarations() {
    local f n line syn
    for f in "$WK_ROOT"/cmd/*; do
        [ -f "$f" ] && [ -x "$f" ] || continue
        decl_load "$f"
        n=$(basename "$f")
        line=$(synopsis "$f")
        syn=${line%% -- *}
        printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$D_WHERE" "$D_NAME" "$D_GROUP" "$syn"
    done
}

# --- help ---------------------------------------------------------------------
#
# README.md is the one document: architecture, setup, every workflow by example.
help_doc() {
    local f="$WK_ROOT/README.md"
    if [ -t 1 ] && command -v less >/dev/null 2>&1; then less "$f"; else cat "$f"; fi
    exit 0
}

# `wk <cmd> -h`: the one help path for every command. The header comment of
# cmd/<name> is the reference text; the declaration says what it acts on.
explain_cmd() { # <cmd> <impl>
    local cmd="$1" impl="$2"
    printf 'wk %s\n\n' "$(synopsis "$impl")"
    if cmd_readonly; then
        printf '  changes things: no -- starts nothing, writes nothing, repairs nothing\n'
    else
        printf '  changes things: yes\n'
    fi
    case "$D_WHERE" in
        host)  printf "  runs on: this host's own store or hardware; refused inside a workspace and on a build machine\n" ;;
        local) printf '  runs on: this machine, never forwarded\n' ;;
        *)     if [ -n "$D_HERE" ]; then
                   printf '  runs on: the machine you type it on -- it needs this device'"'"'s editor\n'
               elif [ -n "$D_LIFECYCLE" ]; then
                   printf '  runs on: the workstation that keeps the workspace record\n'
               else
                   printf "  runs on: the workspace's target, on the machine holding it (the podman VM for a container workspace on macOS; that machine's own wk when it has one)\n"
               fi ;;
    esac
    grep -q -- '--dry-run' "$impl" 2>/dev/null \
        && printf '  preview: wk %s ... --dry-run resolves everything and changes nothing\n' "$cmd"
    printf '\nwhat it does (from %s):\n' "${impl#$WK_ROOT/}"
    awk 'NR == 1 { next }
         /^# wk:/ { next }
         /^# wk [a-z]/ && !seen { next }
         /^#/  { sub(/^# ?/, ""); if ($0 == "" && !seen) next; seen = 1; print "  " $0; next }
         { exit }' "$impl"
    exit 0
}

# --- which target, and whether to forward -------------------------------------
#
# Only the container target lives inside the podman VM; vm and remote
# workspaces are driven from the host. An explicit WK_TARGET wins, then a
# `--target` on the command line (how `wk new` chooses), then the registry --
# a file test per target, no ssh, nothing started.
resolve_target() {
    local prev='' a name=''
    [ -n "${WK_TARGET:-}" ] && { printf '%s' "$WK_TARGET"; return 0; }
    for a in "$@"; do
        if [ "$prev" = --target ]; then printf '%s' "$a"; return 0; fi
        # Both spellings, since a command's own parser takes both: a
        # `--target=<t>` read as no target at all resolves to the default and
        # sends the command to a machine nobody named.
        case "$a" in --target=?*) printf '%s' "${a#*=}"; return 0 ;; esac
        prev="$a"
        case "$a" in -*) ;; *) [ -z "$name" ] && name="$a" ;; esac
    done
    if [ -n "$name" ]; then ws_target "$name"; return 0; fi
    printf '%s' container
}

machine_running() {
    [ "$(podman machine inspect "$WK_MACHINE" --format '{{.State}}' 2>/dev/null)" = running ]
}

status_view_env() {
    # The default is the shared one (status_default_mode, lib/common.sh) rather
    # than a word written here: on a macOS host *this* process renders and on
    # Linux cmd/status does, and a bare `wk status` that meant a page on one and
    # a table on the other would be two commands with one name. Computed by
    # bare_report *before* this is substituted, because the question it answers
    # is whether stdout is a terminal and in here stdout is this substitution's
    # pipe (status_default_mode, lib/common.sh). WK_STATUS_DEFAULT_MODE is
    # that function's return value, not a knob to set by hand -- the ":-text"
    # only guards a call site that runs before status_default_mode has.
    local mode="${WK_STATUS_DEFAULT_MODE:-text}"
    # Seeded from the environment for the same reason the mode is: cmd/status
    # honours WK_STATUS_PORT and WK_STATUS_INTERVAL, and on a macOS host it is
    # not the process that renders -- so without this the two variables worked
    # on Linux and were silently ignored here, which is one command with two
    # behaviours.
    local out="" port="${WK_STATUS_PORT:-}" interval="${WK_STATUS_INTERVAL:-}"
    # Asked for, as against defaulted to -- see the --wait clause below.
    local asked="" wait=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) mode=json; asked=1 ;;
            --web)  mode=web;  asked=1 ;;
            --text|--cli) mode=text; asked=1 ;;
            --wait) wait=1 ;;
            # The raw stream, which is what the halves speak to each other. Not
            # a view, and useful for exactly one thing: seeing what a collector
            # actually said when a listing looks wrong.
            --records) mode=records ;;
            --html) mode=html; asked=1
                    case "${2:-}" in -*|"") ;; *) out="$2"; shift ;; esac ;;
            --port)      port="${2:-}"; shift ;;
            --port=*)    port="${1#*=}" ;;
            --interval)  interval="${2:-}"; shift ;;
            --interval=*) interval="${1#*=}" ;;
        esac
        shift
    done
    # `--wait` is not "look at the fleet": the whole question is whether the
    # thing is finished, and the answer is the line and the exit code. A page
    # that then blocks until ctrl-c buries both. Same rule as cmd/status's, and
    # it has to be here as well because on a macOS host this is the process that
    # would do the serving.
    if [ -z "$asked" ] && [ -n "$wait" ] && [ "$mode" = web ]; then mode=text; fi
    printf 'WK_STATUS_MODE=%s\n' "$(sh_quote "$mode")"
    printf 'WK_STATUS_HTML_OUT=%s\n' "$(sh_quote "$out")"
    printf 'WK_STATUS_PORT=%s\n' "$(sh_quote "$port")"
    printf 'WK_STATUS_INTERVAL=%s\n' "$(sh_quote "$interval")"
}

bare_subject() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --port|--interval|--timeout)
                shift; [ $# -gt 0 ] && shift ;;
            # --html takes an optional path, so only a non-flag word after it is
            # its value rather than a workspace name.
            --html)
                shift
                case "${1:-}" in -*|"") ;; *) shift ;; esac ;;
            -*) shift ;;
            *)  return 1 ;;
        esac
    done
    return 0
}

bare_report() {
    local impl="$1" cmd="$2" t hosts='' rc worst=0
    shift 2
    # A function, because `[ x -gt y ] && worst=x` as the last command of an
    # AND-OR list returns 1 when the test is false, and `set -e` then ends the
    # walk on the second target that reports the same state as the first.
    _bump() { [ "$1" -gt "$worst" ] && worst="$1"; return 0; }

    for t in $(target_all); do
        [ "$t" = container ] && continue
        hosts="$hosts $t"
    done

    # This machine's own name, for both halves: the container store is inside
    # the podman VM, where `hostname` is the VM's and means nothing to anybody
    # -- so the records it writes have to be told which machine they are about.
    # WK_HOST_SELF says it is *this* machine rather than one being asked about,
    # which is what earns the "this machine" note in the heading.
    _self=$(wk_machine_name)

    # `wk status` is assembled from two halves and rendered once. Both write
    # *records* (one JSON object per line) into the same file, and the renderer
    # merges them by machine name -- which is what lets this machine's guests and
    # its containers appear under one heading although two processes found them,
    # and what decides the column widths from the whole listing rather than from
    # whichever half a group came from.
    #
    # It also means the halves never have to agree between themselves about who
    # printed what -- they cannot, being two processes.
    if [ "$cmd" = status ]; then
        _recs=$(mktemp)
        # The view the person asked for. Parsed here as well as in cmd/status
        # because on this host *this* process is the one that renders -- the two
        # halves only collect -- and it has to know where a page goes and which
        # port to serve it on. A function, so the parse can shift its own
        # arguments without disturbing the ones being handed to the halves.
        #
        # The default view is decided here rather than in there, because in
        # there stdout is the substitution's pipe and the question is whether
        # stdout is a terminal (status_default_mode, lib/common.sh).
        status_default_mode
        eval "$(status_view_env ${@+"$@"})"
        _mode="$WK_STATUS_MODE"
        export WK_STATUS_HTML_OUT WK_STATUS_PORT WK_STATUS_INTERVAL

        # Both halves at once, into files of their own.
        #
        # They ask entirely different machines -- one goes into the podman VM
        # over its own ssh, the other walks the guests and every build box out
        # here -- so run one after the other the listing waited for the sum of
        # two independent waits. Neither can write into the same file as the
        # other while it runs (a record stream interleaves mid-line, which makes
        # an unparseable record rather than a lost one), so each gets a file and
        # the parent concatenates them in the order they have always been in:
        # the VM's containers, then this machine's targets.
        #
        # Stdin from /dev/null for both, and that is not caution: a background
        # job that reads the terminal is stopped by SIGTTIN, and `podman machine
        # ssh` inherits stdin.
        _recs_vm=$(mktemp)
        _recs_host=$(mktemp)
        _vm_pid=""
        _host_pid=""

        if machine_running; then
            ( WK_EXPECT_TREE=$("$WK_ROOT/cmd/version" --tree 2>/dev/null || true)
              export WK_EXPECT_TREE
              WK_ROW_LABEL="$_self" WK_HOST_SELF=1
              # --no-devices, not --no-fleet: the boards are reached over ssh
              # from out here and the VM can see none of them, but the machine
              # facts that *are* in there -- the wk-tools every container mounts,
              # the keys in that store -- are worth having.
              forward_to_vm "$cmd" --records --no-devices ${@+"$@"} ) \
                > "$_recs_vm" </dev/null &
            _vm_pid=$!
        elif command -v podman >/dev/null 2>&1; then
            warn "the podman machine '$WK_MACHINE' is stopped, so container workspaces are not included"
            log  "  'wk start' to bring it up"
        fi

        if [ -n "$hosts" ]; then
            ( WK_TARGET="${hosts# }" WK_ROW_LABEL="$_self" WK_HOST_SELF=1 \
                exec "$impl" --records ${@+"$@"} ) > "$_recs_host" </dev/null &
            _host_pid=$!
        fi

        # By pid: a bare `wait` would be a promise about every background job
        # this shell ever starts, and the exit code of each half is half of this
        # command's own contract.
        if [ -n "$_vm_pid" ];   then rc=0; wait "$_vm_pid"   || rc=$?; _bump "$rc"; fi
        if [ -n "$_host_pid" ]; then rc=0; wait "$_host_pid" || rc=$?; _bump "$rc"; fi
        cat "$_recs_vm" "$_recs_host" > "$_recs" 2>/dev/null || true
        rm -f "$_recs_vm" "$_recs_host"

        status_render "$_mode" "$_recs"
        rm -f "$_recs"
        exit "$worst"
    fi

    # `wk ls --json` is one document from up to two processes, same as the
    # status halves above -- captured into files and merged (json_merge_list)
    # instead of streamed, since two JSON documents back to back is not one.
    _ls_json=""
    if [ "$cmd" = ls ]; then
        for _a in ${@+"$@"}; do [ "$_a" = --json ] && _ls_json=1; done
    fi
    _ls_local="" _ls_vm=""

    if [ -n "$hosts" ]; then
        rc=0
        if [ -n "$_ls_json" ]; then
            _ls_local=$(mktemp)
            WK_TARGET="${hosts# }" "$impl" ${@+"$@"} > "$_ls_local" || rc=$?
        else
            WK_TARGET="${hosts# }" "$impl" ${@+"$@"} || rc=$?
        fi
        _bump "$rc"
    fi

    if machine_running; then
        # The forwarded half is the second half of one listing, so it prints
        # rows and neither a header nor an empty-listing note.
        rc=0
        if { [ "$cmd" = ls ] || [ "$cmd" = remotes ]; } && [ -n "$hosts" ]; then
            if [ -n "$_ls_json" ]; then
                _ls_vm=$(mktemp)
                ( WK_ROW_LABEL="$_self"; forward_to_vm "$cmd" --continued ${@+"$@"} ) > "$_ls_vm" || rc=$?
            else
                ( WK_ROW_LABEL="$_self"; forward_to_vm "$cmd" --continued ${@+"$@"} ) || rc=$?
            fi
        else
            ( WK_ROW_LABEL="$_self"; forward_to_vm "$cmd" ${@+"$@"} ) || rc=$?
        fi
        _bump "$rc"
    elif command -v podman >/dev/null 2>&1; then
        warn "the podman machine '$WK_MACHINE' is stopped, so container workspaces are not included"
        log  "  'wk start' to bring it up"
    fi

    if [ -n "$_ls_json" ]; then
        json_merge_list workspaces "$_ls_local" "$_ls_vm"
        rm -f "$_ls_local" "$_ls_vm"
    fi
    exit "$worst"
}

# --- handing a command to the machine that holds the workspace ----------------
#
# A workspace lives on exactly one machine, and some machines are the only
# ones that can act on their own: a peer workstation's containers and guests
# are reachable by no path from here, and a build box drives its own builds
# better than a laptop over ssh does. The driver says so (t_delegates), the
# whole command goes over, and the far side resolves the name again from its
# own evidence -- so no command needs a branch of its own for it.
#
# Two kinds of workspace command stay here, both declared: `here` (it needs
# this device's editor) and `lifecycle` (making and destroying a workspace is
# the owning machine's act, and `--target` already names that machine).
delegate_target() { # <args...> -- the machine, or nothing
    local t
    t=$(resolve_target "$@" 2>/dev/null) || return 0
    ( load_target "$t" >/dev/null 2>&1 && t_delegates ) 2>/dev/null || return 0
    printf '%s' "$t"
}

# A pty when this end is one, for the same reason forward_to_vm allocates one:
# `wk enter` and `wk run --lldb` are conversations, and ssh gives a command no
# terminal unless asked. Both ends checked, so a captured stdout stays clean.
delegate_run() { # <machine> <cmd> <args...>
    local t="$1" cmd="$2" rc=0
    shift 2
    load_target "$t"
    case "$(t_far_side)" in
        answering) ;;
        unreachable) die "'$cmd' acts on a workspace on $t, and $t did not answer.
    Nothing here can reach into it: the workspace is that machine's own." ;;
        *) die "'$cmd' acts on a workspace on $t, which has no wk-tools of its own to
    run it:  wk remote setup $t" ;;
    esac
    # The name this side knows that machine by, and no WK_HOST_SELF: what
    # comes back is a report about another machine, not about this one, and
    # `wk status <ws>` would otherwise head its answer "this machine".
    WK_ROW_LABEL="$t"; export WK_ROW_LABEL

    if [ -t 0 ] && [ -t 1 ]; then t_wk_tty "$cmd" ${@+"$@"}; exit $?; fi
    t_wk "$cmd" ${@+"$@"} || rc=$?
    exit "$rc"
}

forward_to_vm() {
    require podman "podman is required; install the official pkg from podman.io"
    local _self_name; _self_name=$(wk_machine_name)

    podman machine inspect "$WK_MACHINE" >/dev/null 2>&1 \
        || die "podman machine '$WK_MACHINE' does not exist -- run ./setup first"

    if [ "$(podman machine inspect "$WK_MACHINE" --format '{{.State}}' 2>/dev/null)" != running ]; then
        # Rule 6: read-only commands are read-only absolutely. The check is
        # here rather than only at the call sites because this is the single
        # place that can start the machine, and a guard that lives at the
        # callers is a guard that a later path can walk past -- which is
        # exactly what was observed. It also closes the window between a
        # caller's own machine_running check and this one.
        if cmd_readonly "${2:-}"; then
            warn "the podman machine '$WK_MACHINE' is stopped, so its store cannot be read"
            log  "  'wk start' to bring it up -- 'wk $1' will not start it"
            exit 0
        fi
        info "starting podman machine '$WK_MACHINE'"
        podman machine start "$WK_MACHINE" >&2
    fi

    # Everything the VM reports is about *this* machine: it holds this machine's
    # container store and nothing else, and its own hostname ("localhost") means
    # nothing to anybody out here. So it is told what to call itself, unless the
    # caller has already said (bare_report does, for the half it prints first).
    #
    # Without this, `wk status <a container workspace>` -- which forwards whole,
    # arguments and all -- headed this machine's own workspace `localhost`.
    : "${WK_ROW_LABEL:=$_self_name}"
    : "${WK_HOST_SELF:=1}"

    # -- separates our args from ssh's. WK_IN_VM stops the VM-side wk from
    # trying to forward again if anything is ever misconfigured.
    local _cmd
    _cmd="WK_IN_VM=1 ${WK_DEBUG:+WK_DEBUG=1 }${WK_YES:+WK_YES=1 }${WK_FORCE:+WK_FORCE=1 }${WK_EXPECT_TREE:+WK_EXPECT_TREE=$(sh_quote "${WK_EXPECT_TREE:-}") }${WK_ROW_LABEL:+WK_ROW_LABEL=$(sh_quote "${WK_ROW_LABEL:-}") }${WK_HOST_SELF:+WK_HOST_SELF=1 }${WK_CONFIG:+WK_CONFIG=$(sh_quote "${WK_CONFIG:-}") }/opt/wk-tools/wk $(sh_quote "$@")"

    # A terminal does not survive `podman machine ssh`: it runs ssh without
    # asking for a pty, so the far side sees no tty at all: `host: TTY` out
    # here, `VM: NOTTY` one hop in.
    #
    # Everything forwarded that needs to *ask* something is unanswerable as a
    # result. `wk rm <container workspace>` warned that it held 154,339 modified
    # files, asked for confirmation, found no terminal, and declined with advice
    # -- "re-run interactively" -- that could not be followed, because the
    # person was interactive the whole time. The destructive command is
    # the one this hit, which is the worst place for it.
    #
    # So when this end really is a terminal, the hop is made with ssh directly
    # and `-t`, from the machine's own connection details (the same three fields
    # host/macos/vmtools.sh uses). Same host, same key, same command; the only
    # difference is the pty.
    #
    # Both ends of the pipe are checked, not just stdin: a pty rewrites line
    # endings, and `wk status`'s halves have their stdout redirected into a
    # records file while stdin is still the terminal. Requiring both keeps the
    # bytes clean exactly when something is reading them.
    #
    # The host key is not pinned, for podman's own reason: the machine's key is
    # regenerated whenever it is recreated, and it is reached at 127.0.0.1 on a
    # forwarded port that is this user's alone.
    if [ -t 0 ] && [ -t 1 ]; then
        local _p _k _u
        _p=$(podman machine inspect "$WK_MACHINE" --format '{{.SSHConfig.Port}}' 2>/dev/null) || _p=""
        _k=$(podman machine inspect "$WK_MACHINE" --format '{{.SSHConfig.IdentityPath}}' 2>/dev/null) || _k=""
        _u=$(podman machine inspect "$WK_MACHINE" --format '{{.SSHConfig.RemoteUsername}}' 2>/dev/null) || _u=""
        if [ -n "$_p" ] && [ -n "$_k" ] && [ -n "$_u" ]; then
            exec ssh -t -p "$_p" -i "$_k" \
                -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                -o LogLevel=ERROR "$_u@127.0.0.1" "$_cmd"
        fi
    fi

    exec podman machine ssh "$WK_MACHINE" -- "$_cmd"
}


# --- main ---------------------------------------------------------------------

main() {
    [ $# -ge 1 ] || usage
    local cmd="$1" _a _seen_dashdash="" _rest where name="" delegate="" decl="" slot=""; shift
    case "$cmd" in
        help|-h|--help) help_doc ;;
        setup) exec "$WK_ROOT/setup" "$@" ;;
        image) die "'wk image' is renamed: wk sysimage" ;;
        --declarations) dump_declarations; exit 0 ;;
    esac
    local impl="$WK_ROOT/cmd/$cmd"
    [ -x "$impl" ] || { warn "unknown command: $cmd"; usage; }
    decl_load "$impl"

    _rest=()
    for _a in ${@+"$@"}; do
        case "$_seen_dashdash:$_a" in
            :-h|:--help|:--explain) explain_cmd "$cmd" "$impl" ;;
            :--force) WK_FORCE=1; export WK_FORCE; continue ;;
            :--quiet) WK_QUIET=1; export WK_QUIET; continue ;;
            :--)      _seen_dashdash=1 ;;
        esac
        _rest+=("$_a")
    done
    set -- ${_rest[@]+"${_rest[@]}"}

    where=$(cmd_where "$impl" "$@")

    # A host command inside a workspace or on a shared build host acts on a
    # store that is not here.
    if in_workspace && { [ "$where" = host ] || [ -n "$D_OUTSIDE" ]; } && ! in_list "${1:-}" "$D_BROKER"; then
        if [ -n "$D_OUTSIDE" ]; then
            die "'wk $cmd' acts on a host, and this is workspace '$(wk_self)'.
    From the host:  wk $cmd $(wk_self)"
        fi
        die "'wk $cmd' acts on a host, and this is workspace '$(wk_self)'.
    Run it on the host instead."
    fi
    if in_remote_host && [ "$where" = host ]; then
        die "'wk $cmd' acts on a workstation's own store or hardware, and this is
    the shared build machine for target '$(wk_remote_field target)'.
    Run it on the workstation instead. What works here: ls, status, build,
    run, test, logs, enter."
    fi
    if in_remote_host && [ -n "$D_LIFECYCLE" ]; then
        die "workspaces are created and destroyed from the workstation, and this is
    the shared build machine for target '$(wk_remote_field target)'.
    Run 'wk $cmd' there: the workstation owns the workspace's store, and a
    later 'wk build' finds its target from that store."
    fi

    # How the workspace name arrives, once for the two questions that need it:
    # which machine this command is about, and which positional to take the
    # name from further down.
    if [ "$where" = workspace ]; then decl=$(cmd_name "$@"); slot=$(name_slot "$decl"); fi

    # Whether this command is about a workspace another machine owns, decided
    # once here so nothing decides it again. Before check_needs, because what
    # a command needs is needed on the machine that will run it. A command
    # that takes no name is about this machine whatever its positionals say.
    if [ "$where" = workspace ] && [ "${decl%@*}" != none ] \
       && ! in_workspace && [ -z "${WK_IN_VM:-}" ] \
       && [ -z "$D_HERE" ] && [ -z "$D_LIFECYCLE" ]; then
        delegate=$(delegate_target "$@")
    fi

    # What the command needs, checked after the refusals about where it may run
    # and before anything starts. On a macOS host a container command is
    # answered in the podman VM, which has its own tools; the check runs there.
    { [ "$where" = workspace ] && is_macos && [ -z "${WK_IN_VM:-}" ] && ! in_workspace \
        && [ "$D_FORWARD" = yes ] && [ "$(resolve_target "$@")" = container ]; } \
        || [ -n "$delegate" ] || check_needs "$cmd" "${1:-}"

    [ "$where" = workspace ] || exec "$impl" "$@"

    # The name is resolved, waited for and acted on over there, by the same
    # dispatcher reading the same declaration -- so nothing below this line
    # runs twice.
    [ -z "$delegate" ] || delegate_run "$delegate" "$cmd" "$@"

    # --- a workspace command ---------------------------------------------------
    if ! in_workspace && [ "${decl%@*}" = required ]; then
        positional "$slot" "$@" >/dev/null || usage_die "$cmd" "$impl"
    fi
    if in_workspace; then
        : "${WK_TARGET:=local}"; export WK_TARGET
        name=$(wk_self)
        if [ "${decl%@*}" != none ] && [ "$(positional "$slot" "$@" || true)" = "$name" ]; then
            die "this is workspace '$name', and there is no workspace argument in here --
    every command acts on this one. Drop the name: wk $cmd"
        fi
    elif is_macos && [ -z "${WK_IN_VM:-}" ] && [ "$D_FORWARD" = yes ] \
            && [ "$(resolve_target "$@")" = container ]; then
        # A container workspace on a macOS host lives in the podman VM; the
        # VM's own `wk` resolves the name and waits for readiness there.
        if [ "$D_POST" = zed ] && in_list --zed "$(printf '%s,' "$@")"; then
            ARGS=(); for _a in "$@"; do [ "$_a" = --zed ] || ARGS+=("$_a"); done
            name=$(positional 1 ${ARGS[@]+"${ARGS[@]}"}) \
                || die "'wk $cmd --zed' needs a workspace name"
            ( forward_to_vm "$cmd" ${ARGS[@]+"${ARGS[@]}"} ) \
                || die "'wk $cmd $name' failed, so nothing was opened.
    What it managed to say is above; a re-run destroys the rubble and retries."
            exec "$WK_ROOT/cmd/zed" "$name"
        fi
        if [ "$D_POST" = ssh-alias-remove ]; then
            name=$(positional 1 "$@" || true)
            ( forward_to_vm "$cmd" "$@" ) || exit $?
            [ -z "$name" ] || ssh_alias_remove "$name"
            exit 0
        fi
        if [ "$D_BARE" = merged ] && bare_subject "$@"; then
            bare_report "$impl" "$cmd" "$@"
        fi
        if cmd_readonly "${1:-}" && ! command -v podman >/dev/null 2>&1; then
            warn "podman is not installed, so there are no container workspaces to read"
            log  "  './setup' installs it; 'wk vm ls' lists the macOS guests, which do not need it"
            exit 0
        fi
        forward_to_vm "$cmd" "$@"
    fi

    # Running here: resolve the name once, and the command reads WK_NAME.
    # The positional at the slot is the name whatever it says -- what it says
    # is checked below, in one place, rather than by each command in its own
    # words or not at all.
    case "${decl%@*}" in
        required|optional)
            if [ -z "$name" ]; then
                _a=$(positional "$slot" "$@" || true)
                if [ -n "$_a" ]; then
                    name="$_a"; without_positional "$slot" "$@"; set -- ${ARGS[@]+"${ARGS[@]}"}
                fi
            fi ;;
    esac
    if [ -n "$name" ]; then
        WK_NAME="$name"; export WK_NAME
        command -v wk_ws_dir >/dev/null 2>&1 || . "$WK_ROOT/lib/store.sh"
        # A name nothing answers to is refused here, once, for every command.
        # Left to reach the command it is either ignored -- `wk stop <typo>`
        # stopped every workspace on the machine -- or reported as an argument
        # the command never expected, which names neither the mistake nor the
        # remedy. The synopsis comes with it, because giving one argument where
        # two go is the other way to arrive here (`wk build jsc-release`).
        #
        # Inside a workspace the marker is the proof it exists, and a lifecycle
        # command is the one handed a name with nothing behind it yet.
        if [ -z "$D_LIFECYCLE" ] && ! in_workspace; then
            ws_exists "$name" \
                || usage_die "$cmd" "$impl" "no such workspace: $name -- 'wk ls' lists them"
        fi
        if [ "$D_READY" = yes ]; then
            load_target "$(ws_target "$name")"
            wait_ready "$name"
        fi
    fi
    exec "$impl" "$@"
}
main "$@"
