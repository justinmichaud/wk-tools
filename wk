#!/usr/bin/env bash
#
# wk -- WebKit development workspaces. `wk` lists the commands, `wk help` prints
# README.md, `wk <cmd> -h` explains one. bash 3.2: macOS ships nothing newer.
# Every command is a file under cmd/ whose header declares what it acts on (see
# "declarations" below); this file reads that and does, once for all of them,
# what each would otherwise re-decide: resolve the workspace name, refuse one
# inside a workspace, wait for readiness, decide where the command runs, forward
# container work into the podman VM on macOS, delegate to the machine holding it.
#
# Exported for a forwarded or delegated child and read by cmd/* and lib/*: WK_NAME (the resolved name); WK_TARGET (which target answers, set only for a
# command running here, since a child resolves its own); WK_CONFIG; WK_IN_VM (the re-invocation in the podman VM, which stops a second forward);
# WK_ROW_LABEL and WK_HOST_SELF (what a child's records call the machine); WK_NO_DELEGATE; WK_ZED_PUBKEY; WK_QUIET; WK_FORCE.

set -euo pipefail

WK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -f "$WK_ROOT/lib/common.sh" ]; then
    _wk_self="${BASH_SOURCE[0]}"
    while [ -L "$_wk_self" ]; do
        _wk_dir="$(cd "$(dirname "$_wk_self")" && pwd)"
        _wk_self="$(readlink "$_wk_self")"
        case "$_wk_self" in /*) ;; *) _wk_self="$_wk_dir/$_wk_self" ;; esac
    done
    WK_ROOT="$(cd "$(dirname "$_wk_self")" && pwd)"
    unset _wk_self _wk_dir
    [ -f "$WK_ROOT/lib/common.sh" ] || {
        printf 'error: %s is not inside a wk-tools checkout\n' "${BASH_SOURCE[0]}" >&2
        exit 1
    }
fi
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/target.sh"

WK_MACHINE="${WK_MACHINE:-wk}"

# Line 2 of cmd/<name> is `# wk <name> <args> -- <summary>`; `# wk:` lines in its first 15 declare its shape:
#   where=  host (this workstation's hardware; never forwarded, refused inside a workspace and on a shared build host) | store (the store, on the machine holding it: the podman VM on a macOS workstation, here on Linux and on a build machine; refused inside a workspace) | local (wherever invoked) | workspace (the name resolves here, the target decides where it runs) | dynamic (the command answers `wk <cmd> --where <args>` itself)
#   name=   required|optional|none -- how the name arrives; a missing one means all of them or none, and one no workspace answers to is refused here
#   takes=<n>  positionals of the command's own that follow the name, so `wk pr <ref>` is a ref and `wk pr <ws> <ref>` is both
#   ready=yes  wait for the workspace to finish creating.  group=<g>  which block of `wk help` lists it.  lifecycle  creates or destroys the workspace record
#   readonly [<subverbs>]  changes nothing, never starts the podman machine.  broker <subverbs>|*  allowed inside a workspace, through the broker.  outside  refused inside one
#   forward=no  runs on this host, still on the machine holding the workspace.  here  also pins it to where the person typed it.  bare=merged  with no name, report on every target here
#   post=<hook>  zed|ssh-alias-remove, after the forwarded half.  values=<flag>  the read-only flag `wk <cmd> -h` runs to print the closed set.  needs <a,b>  tools and standing checked before anything runs (gh, tart, nmap, gh-auth, tailnet)
#   sub <a,b> / flag <--x,--y>  per-subverb or per-flag override of where=, name= (@2 = the positional after the subverb) and needs=; an empty needs= clears the command's list

decl_load() { # <impl>
    # The one `where=` vocabulary; tests read this line and lift the function on its own (tests/test_sync.py's _lift_func).
    local WK_WHERE_VALUES="host store local workspace dynamic"
    D_WHERE=workspace D_NAME=none D_READY=no D_GROUP=other D_LIFECYCLE=""
    D_READONLY="" D_BROKER="" D_FORWARD=yes D_BARE="" D_POST="" D_SUB="" D_FLAG="" D_OUTSIDE="" D_NEEDS=""
    D_HERE="" D_TAKES=0 D_VALUES=""
    local line tok
    set -f   # `broker *` is a word, not a glob
    while IFS= read -r line; do
        case "$line" in "# wk:"*) ;; *) continue ;; esac
        line=${line#"# wk:"}
        case "$line" in
            " sub "*)  D_SUB="$D_SUB
${line# sub }" ; continue ;;
            " flag "*) D_FLAG="$D_FLAG
${line# flag }" ; continue ;;
        esac
        for tok in $line; do
            case "$tok" in
                where=*)  D_WHERE=${tok#where=}
                          case " $WK_WHERE_VALUES " in
                              *" $D_WHERE "*) ;;
                              *) die "$(basename "$1"): where=$D_WHERE is not one of ${WK_WHERE_VALUES// /|}" ;;
                          esac ;;
                name=*)   D_NAME=${tok#name=} ;;
                takes=*)  D_TAKES=${tok#takes=} ;;
                ready=*)  D_READY=${tok#ready=} ;;
                group=*)  D_GROUP=${tok#group=} ;;
                lifecycle) D_LIFECYCLE=1 ;;
                readonly) D_READONLY=yes ;;
                broker)   D_BROKER=pending ;;
                needs)    D_NEEDS=pending ;;
                values=*) D_VALUES=${tok#values=} ;;
                forward=no) D_FORWARD=no ;;
                here)     D_HERE=1; D_FORWARD=no ;;
                outside)  D_OUTSIDE=1 ;;
                bare=merged) D_BARE=merged ;;
                post=*)   D_POST=${tok#post=} ;;
                *)  case "$D_NEEDS:$D_READONLY:$D_BROKER" in
                        pending:*)     D_NEEDS=$tok ;;
                        *:yes:pending) D_BROKER=$tok ;;
                        *:yes:*)       D_READONLY=$tok ;;
                        *:*:pending)   D_BROKER=$tok ;;
                    esac ;;
            esac
        done
    done < <(head -15 "$1")
    set +f
    [ "$D_BROKER" = pending ] && D_BROKER="*"
    [ "$D_NEEDS" = pending ] && D_NEEDS=""
    return 0
}

usage_die() { # <cmd> <impl> [why]
    [ -z "${3:-}" ] || warn "$3"
    log "usage: wk $(synopsis "$2" | sed 's/ -- .*//')"
    log "       wk $1 -h for the rest"
    exit 2
}

synopsis() { # <impl>
    head -5 "$1" | sed -n 's/^# wk //p' | head -1
}

in_list() { # <word> <list>
    [ -n "$2" ] || return 1
    [ "$2" = "*" ] && return 0
    case ",$2," in *",$1,"*) return 0 ;; esac
    return 1
}

sub_override() { # <key> <subverb>
    local e verbs tok
    while IFS= read -r e; do
        [ -n "$e" ] || continue
        verbs=${e%% *}
        in_list "$2" "$verbs" || continue
        for tok in ${e#* }; do
            case "$tok" in "$1="*) printf '%s' "${tok#*=}"; return 0 ;; esac
        done
    done <<EOF
$D_SUB
EOF
    return 1
}

# `--flag=value` counts as `--flag`: an unrecognised `--target=<t>` would leave `where` at its default and send a host command to the podman VM.
flag_override() { # <key> <args...>
    local key="$1" e flags a tok found=""; shift
    while IFS= read -r e; do
        [ -n "$e" ] || continue
        flags=${e%% *}
        for a in ${1+"$@"}; do
            in_list "${a%%=*}" "$flags" || continue
            for tok in ${e#* }; do
                case "$tok" in "$key="*) found=${tok#*=} ;; esac
            done
        done
    done <<EOF
$D_FLAG
EOF
    [ -n "$found" ] || return 1
    printf '%s' "$found"
}

cmd_name() { # <args...>
    local n
    n=$(flag_override name ${1+"$@"}) || n=$(sub_override name "${1:-}") || n="$D_NAME"
    printf '%s' "$n"
}

cmd_takes() { # <args...>
    local n
    n=$(flag_override takes ${1+"$@"}) || n=$(sub_override takes "${1:-}") || n="$D_TAKES"
    printf '%s' "$n"
}

cmd_where() { # <impl> <args...>
    local impl="$1" w; shift
    w=$(flag_override where ${1+"$@"}) || w=$(sub_override where "${1:-}") || w="$D_WHERE"
    if [ "$w" = dynamic ]; then
        w=$("$impl" --where ${1+"$@"}) || die "'wk $(basename "$impl") --where' did not answer"
    fi
    printf '%s' "$w"
}

cmd_readonly() { # <subverb>
    [ -n "$D_READONLY" ] || return 1
    [ "$D_READONLY" = yes ] && return 0
    in_list "${1:-}" "$D_READONLY"
}

check_needs() { # <cmd> [<subverb>]
    local n missing="" needs="$D_NEEDS" ov
    if [ -n "${2:-}" ] && ov=$(sub_override needs "$2"); then needs="$ov"; fi
    [ -n "$needs" ] || return 0
    for n in $(printf '%s' "$needs" | tr , ' '); do
        case "$n" in
            gh-auth) gh_authenticated \
                         || missing="$missing
    gh-auth    gh cannot reach the GitHub API (not logged in, or the token expired): gh auth login" ;;
            tailnet) tailscale status >/dev/null 2>&1 \
                         || missing="$missing
    tailnet    this machine is not on the tailnet: tailscale up" ;;
            quiesce-helper)
                [ -x /usr/local/libexec/wk-quiesce-priv ] \
                    && sudo -n /usr/local/libexec/wk-quiesce-priv status >/dev/null 2>&1 \
                        || missing="$missing
    quiesce-helper    the privileged quiesce/session helper is not set up: ./setup --stage quiesce" ;;
            *)       command -v "$n" >/dev/null 2>&1 \
                         || missing="$missing
    $n    not installed here" ;;
        esac
    done
    [ -z "$missing" ] || die "'wk $1' cannot start here:$missing
    wk doctor says how to get each of these."
}

positional() { # <n> <args...>
    local n="$1" a i=0; shift
    for a in "$@"; do
        case "$a" in -*) ;; *) i=$((i + 1)); [ "$i" -eq "$n" ] && { printf '%s' "$a"; return 0; } ;; esac
    done
    return 1
}

positional_count() { # <args...>
    local a i=0
    for a in ${1+"$@"}; do
        case "$a" in -*) ;; *) i=$((i + 1)) ;; esac
    done
    printf '%s' "$i"
}

argv_name() { # <slot> <takes> <args...>
    local slot="$1" takes="$2"; shift 2
    [ "$(positional_count ${1+"$@"})" -ge "$((slot + takes))" ] || return 1
    positional "$slot" ${1+"$@"}
}

cwd_workspace() {
    in_remote_host || return 1
    local root name
    root=$(wk_remote_field root) || return 1
    [ -n "$root" ] || return 1
    case "$PWD/" in "$root"/ws/?*) ;; *) return 1 ;; esac
    name=${PWD#"$root"/ws/}
    name=${name%%/*}
    [ -n "$name" ] || return 1
    printf '%s' "$name"
}

without_positional() { # <n> <args...>
    local n="$1" a i=0; shift
    ARGS=()
    for a in "$@"; do
        case "$a" in -*) ;; *) i=$((i + 1)); [ "$i" -eq "$n" ] && continue ;; esac
        ARGS+=("$a")
    done
}

name_slot() { # <name-decl>
    case "$1" in *@*) printf '%s' "${1#*@}" ;; *) printf 1 ;; esac
}


usage() {
    {
        printf 'usage: wk <command> [args]\n'
        usage_group workspaces "workspaces"
        usage_group sources    "sources and disk"
        usage_group hosts      "hosts and machines"
        usage_group other      "other"
        cat <<'EOF'

  Inside a workspace the name is implicit: `wk build <config>`, `wk run -- <args>`
  act on this machine.

  wk <command> -h          what it does, what it acts on, whether it changes anything
  wk <command> --force     cross a refusal that exists because of a rule; the
                           warning repeats when the command ends. It does not
                           force past a missing workspace or a failed build
  wk <command> --quiet     drop the info/log narration; a result, a warning
                           and an error still print. Every command accepts it
  wk <command> --all       every one of what the command acts on -- every
                           machine ('wk push'/'wk sudo'), every workspace on
                           every target ('wk sync'), every line of the log
                           ('wk logs'); a command's own -h says what its --all covers
  WK_DEBUG=1               verbose output
EOF
        printf '\n  wk help                  README.md: architecture, setup, every workflow by example\n'
    } >&2
    exit 2
}

usage_group() { # <group> <title>
    local f n syn line printed=""
    for f in "$WK_ROOT"/cmd/*; do
        [ -f "$f" ] && [ -x "$f" ] || continue
        decl_load "$f"
        [ "$D_GROUP" = "$1" ] || continue
        n=$(basename "$f")
        line=$(synopsis "$f")
        syn=${line%% -- *}
        [ -n "$printed" ] || { printf '\n%s\n' "$2"; printed=1; }
        printf '  %-32s %s\n' "$syn" "${line#* -- }"
    done
}

dump_declarations() {
    local f n line syn
    for f in "$WK_ROOT"/cmd/*; do
        [ -f "$f" ] && [ -x "$f" ] || continue
        decl_load "$f"
        n=$(basename "$f")
        line=$(synopsis "$f")
        syn=${line%% -- *}
        printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$D_WHERE" "$D_NAME" "$D_GROUP" "$syn"
    done
}

help_doc() { # [topic]
    local f="$WK_ROOT/README.md"
    if [ -n "${1:-}" ]; then
        python3 - "$f" "$1" <<'PY' || exit 1
import re, sys
text, topic = open(sys.argv[1]).read(), sys.argv[2].lower()
# Two levels: a `## section` runs to the next `##`; a `**workflow**` title
# inside one runs to the next title of either kind.
heading = re.compile(r"^(## .+|\*\*[^*]+\*\*)$", re.M)
marks = [(m.start(), m.group(0)) for m in heading.finditer(text)]
out, names = [], []
for i, (start, head) in enumerate(marks):
    level = 2 if head.startswith("##") else 3
    name = head.strip("#* ")
    names.append(name)
    end = len(text)
    for later, _ in [(s, h) for s, h in marks[i + 1:] if level == 3 or h.startswith("##")]:
        end = later
        break
    if topic in name.lower():
        out.append(text[start:end].rstrip() + "\n")
if not out:
    sys.stderr.write("error: no help topic matches '%s'. Topics (wk help <word>):\n" % sys.argv[2])
    for n in names: sys.stderr.write("    %s\n" % n)
    sys.exit(1)
sys.stdout.write("\n".join(out))
PY
        exit 0
    fi
    if [ -t 1 ] && command -v less >/dev/null 2>&1; then less "$f"; else cat "$f"; fi
    exit 0
}

where_prose() { # <where>
    case "$1" in
        host)    printf "this host's own hardware; refused inside a workspace and on a build machine" ;;
        store)   printf "the machine holding the store -- the podman VM on macOS, this machine otherwise; refused inside a workspace" ;;
        local)   printf 'this machine, never forwarded' ;;
        dynamic) printf 'whichever the command itself answers for the rest of the arguments' ;;
        *)       if [ -n "$D_HERE" ]; then
                     printf 'the machine you type it on -- it needs this device'"'"'s editor or files'
                 elif [ -n "$D_LIFECYCLE" ]; then
                     printf 'the workstation that keeps the workspace record'
                 else
                     printf "the workspace's target, on the machine holding it (the podman VM for a container workspace on macOS; that machine's own wk when it has one)"
                 fi ;;
    esac
}

where_overrides() {
    local e verbs w tok
    while IFS= read -r e; do
        [ -n "$e" ] || continue
        verbs=${e%% *}
        w=""
        for tok in ${e#* }; do
            case "$tok" in where=*) w=${tok#where=} ;; esac
        done
        [ -n "$w" ] || continue
        printf '    %s: %s\n' "${verbs//,/, }" "$(where_prose "$w")"
    done <<EOF
$D_SUB
$D_FLAG
EOF
}

explain_cmd() { # <cmd> <impl>
    local cmd="$1" impl="$2"
    printf 'wk %s\n\n' "$(synopsis "$impl")"
    if cmd_readonly; then
        printf '  changes things: no -- starts nothing, writes nothing, repairs nothing\n'
    else
        printf '  changes things: yes\n'
    fi
    printf '  runs on: %s\n' "$(where_prose "$D_WHERE")"
    where_overrides
    grep -q -- '--dry-run' "$impl" 2>/dev/null \
        && printf '  preview: wk %s ... --dry-run resolves everything and changes nothing\n' "$cmd"
    printf '\nwhat it does (from %s):\n' "${impl#$WK_ROOT/}"
    awk 'NR == 1 { next }
         /^# wk:/ { next }
         /^# wk [a-z]/ && !seen { next }
         /^#/  { sub(/^# ?/, ""); if ($0 == "" && !seen) next; seen = 1; print "  " $0; next }
         { exit }' "$impl"
    if [ -n "$D_VALUES" ]; then
        printf '\nvalid values (wk %s %s):\n' "$cmd" "$D_VALUES"
        { "$WK_ROOT/wk" "$cmd" "$D_VALUES" 2>&1 || true; } | sed 's/^/  /'
    fi
    exit 0
}

resolve_target() {
    local prev='' a name='' decl slot takes
    [ -n "${WK_TARGET:-}" ] && { printf '%s' "$WK_TARGET"; return 0; }
    for a in "$@"; do
        if [ "$prev" = --target ]; then printf '%s' "$a"; return 0; fi
        case "$a" in --target=?*) printf '%s' "${a#*=}"; return 0 ;; esac
        prev="$a"
    done
    decl=$(cmd_name "$@"); slot=$(name_slot "$decl"); takes=$(cmd_takes "$@")
    if [ "${decl%@*}" != none ]; then
        name=$(argv_name "$slot" "$takes" "$@") || name=$(cwd_workspace) || name=""
        [ -z "$name" ] || { ws_target "$name"; return 0; }
    fi
    printf '%s' container
}

machine_running() {
    [ "$(podman machine inspect "$WK_MACHINE" --format '{{.State}}' 2>/dev/null)" = running ]
}

status_view_env() {
    local mode="${WK_STATUS_DEFAULT_MODE:-text}"
    local out="" port="${WK_STATUS_PORT:-}" interval="${WK_STATUS_INTERVAL:-}"
    local asked="" wait=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) mode=json; asked=1 ;;
            --web)  mode=web;  asked=1 ;;
            --text|--cli) mode=text; asked=1 ;;
            --wait) wait=1 ;;
            --records) mode=records ;;
            --html) mode=html; asked=1
                    case "${2:-}" in -*|"") ;; *) out="$2"; shift ;; esac ;;
            --port)      port="${2:-}"; shift ;;
            --port=*)    port="${1#*=}" ;;
            --interval)  interval="${2:-}"; shift ;;
            --interval=*) interval="${1#*=}" ;;
        esac
        shift
    done
    if [ -z "$asked" ] && [ -n "$wait" ] && [ "$mode" = web ]; then mode=text; fi
    printf 'WK_STATUS_MODE=%s\n' "$(sh_quote "$mode")"
    printf 'WK_STATUS_HTML_OUT=%s\n' "$(sh_quote "$out")"
    printf 'WK_STATUS_PORT=%s\n' "$(sh_quote "$port")"
    printf 'WK_STATUS_INTERVAL=%s\n' "$(sh_quote "$interval")"
}

bare_subject() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --port|--interval|--timeout)
                shift; [ $# -gt 0 ] && shift ;;
            --html)
                shift
                case "${1:-}" in -*|"") ;; *) shift ;; esac ;;
            -*) shift ;;
            *)  return 1 ;;
        esac
    done
    return 0
}

bare_report() {
    local impl="$1" cmd="$2" t hosts='' rc worst=0
    shift 2
    # A function, because `[ x -gt y ] && worst=x` as the last command of an AND-OR list returns 1 when the test is false, and `set -e` would end the walk.
    _bump() { [ "$1" -gt "$worst" ] && worst="$1"; return 0; }

    for t in $(target_all); do
        [ "$t" = container ] && continue
        hosts="$hosts $t"
    done

    _self=$(wk_machine_name)

    if [ "$cmd" = status ]; then
        _recs=$(mktemp)
        status_default_mode
        eval "$(status_view_env ${@+"$@"})"
        _mode="$WK_STATUS_MODE"
        export WK_STATUS_HTML_OUT WK_STATUS_PORT WK_STATUS_INTERVAL

        # Stdin from /dev/null: a background job that reads the terminal is stopped by SIGTTIN, and `podman machine ssh` inherits it.
        _recs_vm=$(mktemp)
        _recs_host=$(mktemp)
        _vm_pid=""
        _host_pid=""

        if machine_running; then
            ( WK_ROW_LABEL="$_self" WK_HOST_SELF=1
              forward_to_vm "$cmd" --records --no-devices ${@+"$@"} ) \
                > "$_recs_vm" </dev/null &
            _vm_pid=$!
        elif command -v podman >/dev/null 2>&1; then
            warn "the podman machine '$WK_MACHINE' is stopped, so container workspaces are not included"
            log  "  'wk start' to bring it up"
        fi

        if [ -n "$hosts" ]; then
            ( WK_TARGET="${hosts# }" WK_ROW_LABEL="$_self" WK_HOST_SELF=1 \
                exec "$impl" --records ${@+"$@"} ) > "$_recs_host" </dev/null &
            _host_pid=$!
        fi

        if [ -n "$_vm_pid" ];   then rc=0; wait "$_vm_pid"   || rc=$?; _bump "$rc"; fi
        if [ -n "$_host_pid" ]; then rc=0; wait "$_host_pid" || rc=$?; _bump "$rc"; fi
        cat "$_recs_vm" "$_recs_host" > "$_recs" 2>/dev/null || true
        rm -f "$_recs_vm" "$_recs_host"

        status_render "$_mode" "$_recs"
        rm -f "$_recs"
        exit "$worst"
    fi

    _ls_json=""
    if [ "$cmd" = ls ]; then
        for _a in ${@+"$@"}; do [ "$_a" = --json ] && _ls_json=1; done
    fi
    _ls_local="" _ls_vm="" _ls_empty=""

    if [ -n "$hosts" ]; then
        rc=0
        if [ -n "$_ls_json" ]; then
            _ls_local=$(mktemp)
            WK_TARGET="${hosts# }" "$impl" ${@+"$@"} > "$_ls_local" || rc=$?
        elif [ "$cmd" = ls ] && machine_running; then
            _ls_local=$(mktemp)
            WK_TARGET="${hosts# }" "$impl" --more-follows ${@+"$@"} > "$_ls_local" || rc=$?
            cat "$_ls_local"
            [ "$(wc -l < "$_ls_local")" -gt 1 ] || _ls_empty=--empty-so-far
            rm -f "$_ls_local"; _ls_local=""
        else
            WK_TARGET="${hosts# }" "$impl" ${@+"$@"} || rc=$?
        fi
        _bump "$rc"
    fi

    if machine_running; then
        rc=0
        if { [ "$cmd" = ls ] || [ "$cmd" = remotes ]; } && [ -n "$hosts" ]; then
            if [ -n "$_ls_json" ]; then
                _ls_vm=$(mktemp)
                ( WK_ROW_LABEL="$_self"; forward_to_vm "$cmd" --continued ${@+"$@"} ) > "$_ls_vm" || rc=$?
            else
                ( WK_ROW_LABEL="$_self"; forward_to_vm "$cmd" --continued ${_ls_empty:+"$_ls_empty"} ${@+"$@"} ) || rc=$?
            fi
        else
            ( WK_ROW_LABEL="$_self"; forward_to_vm "$cmd" ${@+"$@"} ) || rc=$?
        fi
        _bump "$rc"
    elif command -v podman >/dev/null 2>&1; then
        warn "the podman machine '$WK_MACHINE' is stopped, so container workspaces are not included"
        log  "  'wk start' to bring it up"
    fi

    if [ -n "$_ls_json" ]; then
        json_merge_list workspaces "$_ls_local" "$_ls_vm"
        rm -f "$_ls_local" "$_ls_vm"
    fi
    exit "$worst"
}

delegate_target() { # <target> -- it back when it is such a machine, nothing otherwise
    ( load_target "$1" >/dev/null 2>&1 && t_delegates ) 2>/dev/null || return 0
    printf '%s' "$1"
}

delegate_run() { # <machine> <cmd> <args...>
    local t="$1" cmd="$2" rc=0
    shift 2
    load_target "$t"
    case "$(t_far_side)" in
        answering) ;;
        unreachable) die "'$cmd' acts on a workspace on $t, and $t did not answer.
    Nothing here can reach into it: the workspace is that machine's own." ;;
        *) die "'$cmd' acts on a workspace on $t, which has no wk-tools of its own to
    run it:  wk remote setup $t" ;;
    esac
    WK_ROW_LABEL="$t"; export WK_ROW_LABEL

    if [ -t 0 ] && [ -t 1 ]; then t_wk_tty "$cmd" ${@+"$@"}; exit $?; fi
    t_wk "$cmd" ${@+"$@"} || rc=$?
    exit "$rc"
}

forward_to_vm() {
    require podman "podman is required; install the official pkg from podman.io"
    local _self_name; _self_name=$(wk_machine_name)

    podman machine inspect "$WK_MACHINE" >/dev/null 2>&1 \
        || die "podman machine '$WK_MACHINE' does not exist -- run ./setup first"

    if [ "$(podman machine inspect "$WK_MACHINE" --format '{{.State}}' 2>/dev/null)" != running ]; then
        # Rule 6: read-only is read-only absolutely. Here because this is the single place that can start the machine.
        if cmd_readonly "${2:-}"; then
            warn "the podman machine '$WK_MACHINE' is stopped, so its store cannot be read"
            log  "  'wk start' to bring it up -- 'wk $1' will not start it"
            exit 0
        fi
        # Starting it is a convenience for a person who typed the command, not something a script or a test suite asks for by running one. Without a terminal it is refused: `wk verify <a name with a typo in it>` used to boot 20GB of VM so that the VM's own dispatcher could print the usage line, and `wk selftest` did it on every run.
        if [ ! -t 0 ] || [ ! -t 1 ]; then
            die "the podman machine '$WK_MACHINE' is stopped, and 'wk $1' needs it.
    Nothing here starts it without a terminal asking:  wk start"
        fi
        info "starting podman machine '$WK_MACHINE'"
        podman machine start "$WK_MACHINE" >&2
    fi

    : "${WK_ROW_LABEL:=$_self_name}"
    : "${WK_HOST_SELF:=1}"

    local _cmd
    _cmd="WK_IN_VM=1 $(wk_forwarded_env)${WK_ROW_LABEL:+WK_ROW_LABEL=$(sh_quote "${WK_ROW_LABEL:-}") }${WK_HOST_SELF:+WK_HOST_SELF=1 }${WK_CONFIG:+WK_CONFIG=$(sh_quote "${WK_CONFIG:-}") }/opt/wk-tools/wk $(sh_quote "$@")"

    # `podman machine ssh` runs ssh without asking for a pty, so anything forwarded that needs to *ask* is unanswerable; when this end really is a
    # terminal the hop is made with ssh and `-t`. Both ends checked: a pty rewrites line endings, and `wk status`'s halves redirect stdout only.
    if [ -t 0 ] && [ -t 1 ]; then
        local _p _k _u
        _p=$(podman machine inspect "$WK_MACHINE" --format '{{.SSHConfig.Port}}' 2>/dev/null) || _p=""
        _k=$(podman machine inspect "$WK_MACHINE" --format '{{.SSHConfig.IdentityPath}}' 2>/dev/null) || _k=""
        _u=$(podman machine inspect "$WK_MACHINE" --format '{{.SSHConfig.RemoteUsername}}' 2>/dev/null) || _u=""
        if [ -n "$_p" ] && [ -n "$_k" ] && [ -n "$_u" ]; then
            exec ssh -t -p "$_p" -i "$_k" \
                -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                -o LogLevel=ERROR "$_u@127.0.0.1" "$_cmd"
        fi
    fi

    exec podman machine ssh "$WK_MACHINE" -- "$_cmd"
}



main() {
    [ $# -ge 1 ] || usage
    local cmd="$1" _a _seen_dashdash="" _rest where name="" delegate="" decl="" slot="" takes=0; shift
    case "$cmd" in
        help|-h|--help) help_doc "${1:-}" ;;
        setup) exec "$WK_ROOT/setup" "$@" ;;
        image) die "'wk image' is renamed: wk sysimage" ;;
        claude) die "'wk claude' is renamed: wk ai claude${1:+ $1}
    One command for every coding agent (wk ai -h)." ;;
        --declarations) dump_declarations; exit 0 ;;
    esac
    local impl="$WK_ROOT/cmd/$cmd"
    [ -x "$impl" ] || { warn "unknown command: $cmd"; usage; }
    decl_load "$impl"

    _rest=()
    for _a in ${@+"$@"}; do
        case "$_seen_dashdash:$_a" in
            :-h|:--help|:--explain) explain_cmd "$cmd" "$impl" ;;
            :--force) WK_FORCE=1; export WK_FORCE; continue ;;
            :--quiet) WK_QUIET=1; export WK_QUIET; continue ;;
            :--)      _seen_dashdash=1 ;;
        esac
        _rest+=("$_a")
    done
    set -- ${_rest[@]+"${_rest[@]}"}

    # WK_NAME is this invocation's answer, never an inherited one: a shell started by an earlier `wk` would otherwise hand on that workspace.
    unset WK_NAME

    where=$(cmd_where "$impl" "$@")

    if in_workspace && { [ "$where" = host ] || [ "$where" = store ] || [ -n "$D_OUTSIDE" ]; } && ! in_list "${1:-}" "$D_BROKER"; then
        if [ -n "$D_OUTSIDE" ]; then
            die "'wk $cmd' acts on a host, and this is workspace '$(wk_self)'.
    From the host:  wk $cmd $(wk_self)"
        fi
        die "'wk $cmd' acts on a host, and this is workspace '$(wk_self)'.
    From the host:  wk $cmd${*:+ $*}"
    fi
    if in_remote_host && [ "$where" = host ]; then
        die "'wk $cmd' acts on a workstation's own store or hardware, and this is
    the shared build machine for target '$(wk_remote_field target)'.
    Run it on the workstation instead. What works here: ls, status, build,
    run, test, logs, enter."
    fi
    if in_remote_host && [ -n "$D_LIFECYCLE" ]; then
        die "workspaces are created and destroyed from the workstation, and this is
    the shared build machine for target '$(wk_remote_field target)'.
    Run 'wk $cmd' there: the workstation owns the workspace's store, and a
    later 'wk build' finds its target from that store."
    fi

    if [ "$where" = workspace ]; then
        decl=$(cmd_name "$@"); slot=$(name_slot "$decl"); takes=$(cmd_takes "$@")
    fi

    # Resolved once, here: resolving a name walks every target that could hold it (ws_locate), and three questions below need the same answer.
    resolved=""
    if [ "$where" = workspace ] && ! in_workspace; then
        resolved=$(resolve_target "$@")
    fi

    if [ "$where" = workspace ] && [ "${decl%@*}" != none ] \
       && ! in_workspace && [ -z "${WK_IN_VM:-}" ] \
       && [ -z "$D_HERE" ] && [ -z "$D_LIFECYCLE" ]; then
        delegate=$(delegate_target "$resolved")
    fi

    { [ "$where" = workspace ] && is_macos && [ -z "${WK_IN_VM:-}" ] && ! in_workspace \
        && [ "$D_FORWARD" = yes ] && [ "$resolved" = container ]; } \
        || [ -n "$delegate" ] || check_needs "$cmd" "${1:-}"

    if [ "$where" = store ] && [ -z "${WK_IN_VM:-}" ]; then
        command -v store_is_local >/dev/null 2>&1 || . "$WK_ROOT/lib/store.sh"
        store_is_local || forward_to_vm "$cmd" "$@"
    fi

    [ "$where" = workspace ] || exec "$impl" "$@"

    [ -z "$delegate" ] || delegate_run "$delegate" "$cmd" "$@"

    if ! in_workspace && [ "${decl%@*}" = required ]; then
        argv_name "$slot" "$takes" "$@" >/dev/null || cwd_workspace >/dev/null \
            || usage_die "$cmd" "$impl"
    fi
    if in_workspace; then
        : "${WK_TARGET:=local}"; export WK_TARGET
        resolved="$WK_TARGET"
        name=$(wk_self)
        if [ "${decl%@*}" != none ] && [ "$(argv_name "$slot" "$takes" "$@" || true)" = "$name" ]; then
            die "this is workspace '$name', and there is no workspace argument in here --
    every command acts on this one. Drop the name: wk $cmd"
        fi
    elif is_macos && [ -z "${WK_IN_VM:-}" ] && [ "$D_FORWARD" = yes ] \
            && [ "$resolved" = container ]; then
        if [ "$D_POST" = zed ] && in_list --zed "$(printf '%s,' "$@")"; then
            ARGS=(); for _a in "$@"; do [ "$_a" = --zed ] || ARGS+=("$_a"); done
            name=$(positional 1 ${ARGS[@]+"${ARGS[@]}"}) \
                || die "'wk $cmd --zed' needs a workspace name"
            ( forward_to_vm "$cmd" ${ARGS[@]+"${ARGS[@]}"} ) \
                || die "'wk $cmd $name' failed, so nothing was opened.
    What it managed to say is above; a re-run destroys the rubble and retries."
            exec "$WK_ROOT/cmd/zed" "$name"
        fi
        if [ "$D_POST" = ssh-alias-remove ]; then
            name=$(positional 1 "$@" || true)
            ( forward_to_vm "$cmd" "$@" ) || exit $?
            [ -z "$name" ] || ssh_alias_remove "$name"
            exit 0
        fi
        if [ "$D_BARE" = merged ] && bare_subject "$@"; then
            bare_report "$impl" "$cmd" "$@"
        fi
        if cmd_readonly "${1:-}" && ! command -v podman >/dev/null 2>&1; then
            warn "podman is not installed, so there are no container workspaces to read"
            log  "  './setup' installs it; 'wk vm ls' lists the macOS guests, which do not need it"
            exit 0
        fi
        forward_to_vm "$cmd" "$@"
    fi

    case "${decl%@*}" in
        required|optional)
            if [ -z "$name" ]; then
                _a=$(argv_name "$slot" "$takes" "$@" || true)
                if [ -n "$_a" ]; then
                    name="$_a"; without_positional "$slot" "$@"; set -- ${ARGS[@]+"${ARGS[@]}"}
                else
                    name=$(cwd_workspace || true)
                fi
            fi ;;
    esac
    if [ -n "$name" ]; then
        WK_NAME="$name"; export WK_NAME
        command -v wk_ws_dir >/dev/null 2>&1 || . "$WK_ROOT/lib/store.sh"
        # A name nothing answers to is refused here, once, for every command: left to reach the command it is ignored (`wk stop <typo>` stopped every
        # workspace on the machine) or reported as an argument it never expected. In a workspace the marker is the proof; a lifecycle name has nothing yet.
        if [ -z "$D_LIFECYCLE" ] && ! in_workspace; then
            ws_exists_on "$resolved" "$name" \
                || usage_die "$cmd" "$impl" "no such workspace: $name -- 'wk ls' lists them"
        fi
        [ -n "$D_LIFECYCLE" ] || { WK_TARGET="$resolved"; export WK_TARGET; }
        if [ "$D_READY" = yes ]; then
            load_target "$resolved"
            wait_ready "$name"
        fi
    fi
    exec "$impl" "$@"
}
main "$@"
