#!/usr/bin/env python3
"""wk -- WebKit development workspaces. `wk` lists the commands, `wk help`
prints README.md, `wk <cmd> -h` explains one. Every command is a file under
cmd/ whose header declares what it acts on; lib/wk/dispatch.py reads that
and does, once for all of them, what each would otherwise re-decide."""

import os
import sys

# bin/wk's symlink is followed only when this directory is not a checkout.
root = os.path.dirname(os.path.abspath(__file__))
here = __file__
while not os.path.isdir(os.path.join(root, "lib", "wk")) and os.path.islink(here):
    target = os.readlink(here)
    here = target if os.path.isabs(target) else os.path.join(os.path.dirname(here), target)
    root = os.path.dirname(os.path.abspath(here))
if not os.path.isdir(os.path.join(root, "lib", "wk")):
    sys.stderr.write("error: %s is not inside a wk-tools checkout\n" % __file__)
    sys.exit(1)
os.environ["WK_ROOT"] = root
sys.path.insert(0, os.path.join(root, "lib"))

from wk.dispatch import entry  # noqa: E402

entry()
