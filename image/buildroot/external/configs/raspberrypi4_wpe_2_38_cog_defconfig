BR2_cortex_a72=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_ARM_INSTRUCTIONS_THUMB2=y
BR2_CCACHE=y
BR2_OPTIMIZE_2=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_BINUTILS_VERSION_2_33_X=y
BR2_GCC_VERSION_9_X=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/raspberrypi4/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/raspberrypi4/post-image.sh"
# KMS graphics (the overlay the fork's post-image script writes as
# vc4-kms-v3d-pi4), and only the 76 MB of GPU memory a KMS system needs: the
# firmware composits nothing here, the kernel's vc4/v3d do.
BR2_ROOTFS_POST_SCRIPT_ARGS="--tvmode-720 --gpu_mem_1024=76 --add-vc4-kms-v3d-overlay --silent"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/raspberrypi/linux"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="rpi-5.15.y"
# The tree's own 32-bit Pi 4 config (what RPi OS ships as kernel7l), not the
# fork's rpi34-linux-5.15.config: that one is a Pi 2/3 config in truth --
# measured on hardware 2026-08-31, it hangs a Pi 4 before init, and it lacks
# the 2711's SD controller (MMC_SDHCI_IPROC), PCIe root (PCIE_BRCMSTB, where
# the USB controller lives), XHCI, LPAE and HIGHMEM, so it could mount no
# root on this board even if it ran. The kernel *tree* stays the
# release-pinned rpi-5.15.y above; only the config is the board's.
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
# Plus what a fleet bench system needs to be reached over the tailnet (a TUN
# device, netfilter), which that config has none of; see the fragment.
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_WK_PATH)/board/linux-fleet.fragment"
# Gzip (the default), not LZ4: the LZ4 zImage of this same tree and config
# hangs this board before the console is up, while RPi OS's gzip build of
# the same config (kernel7l, 5.15.84) boots it in 90 s -- measured
# 2026-08-31, both via the same tryboot staging. Compression is the one
# variable left between the two.
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="bcm2711-rpi-4-b"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_IFUPDOWN=y
BR2_PACKAGE_NTP=y
BR2_PACKAGE_GSTREAMER1_18=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_APP=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERT=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_GIO=y
BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_ALSA=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_OPUS=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUDIOFX=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUDIOPARSERS=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUTODETECT=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_DEINTERLACE=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ICYDEMUX=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ID3DEMUX=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_INTERLEAVE=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_MATROSKA=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_MPG123=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_DEBUGUTILS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_MPEGTSDEMUX=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_SUBENC=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_DASH=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_FAAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_FDK_AAC=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_HLS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_OPUS=y
BR2_PACKAGE_BITSTREAM_VERA=y
BR2_PACKAGE_RPI_BT_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
# No gst-omx and no vcdbg: each drags in rpi-userland, whose libEGL.so and
# libGLESv2.so are real files in /usr/lib that collide with mesa's symlinks
# (the build dies at mesa's staging install), and the firmware media/GL
# services they exist for are not there on a Pi 4 under KMS anyway.
# wpewebkit still force-selects wpebackend-rdk (the fork's Config.in), but
# with rpi-userland gone every rdk display backend is unselectable and it
# builds as a stub; the bench launch pins WPE_BACKEND_LIBRARY to fdo, since
# rdk's cmake still claims the libWPEBackend-default.so symlink.
BR2_PACKAGE_RPI_WIFI_FIRMWARE=y
# wpa_supplicant, so this board can bring up WiFi from a credential seeded
# onto the card (wk-wifi-join, image/buildroot/wifi-overlay.sh) -- this board
# has no cable at the bench, same as rpi3 and rpi5.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WEXT=y
BR2_PACKAGE_RNG_TOOLS=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_ORC=y
BR2_PACKAGE_SHARED_MIME_INFO=y
# OpenSSH, as the yocto rescues run: the fork's dropbear 2019.78 predates
# ed25519 keys, so a board carrying it refuses the fleet's driving key
# (root's authorized_keys, installed by wk sysimage write).
BR2_PACKAGE_OPENSSH=y
# The netfilter tool tailscaled drives when nftables is not usable.
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_BROTLI=y
BR2_PACKAGE_COG=y
BR2_PACKAGE_COG_USE_SYSTEM_DBUS=y
# No autostarted browser: the Pi 4 renders through one compositor session
# that `wk pi bench` owns, and a boot-time cog would hold the GPU beside it.
BR2_PACKAGE_XKEYBOARD_CONFIG=y
# The Pi 4 has no firmware GL -- the VideoCore VI runs no Khronos vchiq
# service, so wpebackend-rdk's dispmanx backend can never render here
# (measured 2026-08-31: every WPEWebProcess dies registering its service,
# on 5.15 and 6.6 kernels alike, while the same stack renders on the rpi3's
# VideoCore IV). The browser stack is the one the fork's own rpi4 defconfigs
# use: cog's wayland platform on weston's DRM backend, GL from mesa's v3d.
BR2_PACKAGE_WPEBACKEND_FDO=y
# BR2_PACKAGE_WPEBACKEND_RDK is not set
BR2_PACKAGE_COG_PLATFORM_FDO=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_KMSRO=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
# The input seat cog asserts on at startup is a uinput device made by the
# same python shim the yocto images use (PI_SEAT_PY, cmd/pi).
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_LIBMANETTE=y
BR2_PACKAGE_WPEWEBKIT2_38=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_WOFF2=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1600M"
