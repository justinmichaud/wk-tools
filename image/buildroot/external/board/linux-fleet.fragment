# Kernel config fragment for every fleet buildroot image, appended to the
# fork's board config (BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES): what a bench
# system needs to be reached over the tailnet, which neither the fork's
# minimal rpi34-linux-5.15.config nor the tree's bcm2711 defconfig has. tailscaled needs a TUN device for
# tailscale0 and netfilter for its routing marks; nftables is what it drives
# by default, the legacy iptables set is what BR2_PACKAGE_IPTABLES gives it
# when nftables is not usable.
CONFIG_TUN=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# No gcc plugins: the tree's bcm2711 defconfig enables them (the
# arm_ssp_per_task stack-protector plugin), and building a plugin needs the
# host compiler's own gmp headers, which buildroot's gcc 9.2 host toolchain
# does not ship -- the kernel build dies at scripts/gcc-plugins. The regular
# strong stack protector stays on; only the per-task variant needs the plugin.
# CONFIG_GCC_PLUGINS is not set
