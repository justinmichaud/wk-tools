# --- wk sysimage: every image written for the rpi5 -----------------------------
# Appended to the card's own config.txt by `wk sysimage write`, ahead of
# whatever the profile appends. What belongs here is what the *board's firmware*
# requires of any image at all; what a particular measurement wants belongs to
# the profile.

[all]
# The firmware's OS-compatibility check refuses an OS it judges too old for the
# board and moves to the next boot device, which on this one is the NVMe
# workstation -- so a bench image that fails it looks like an arming that did
# nothing. Every image built here fails it, because none of them is a
# Raspberry Pi OS release the check knows.
#
# It is a barrier crossed deliberately, not a fix: on this board the check was
# also right, and forcing past it is what turned a fall-through into a kernel
# panic (image/boards/rpi5/local.conf.append names the fault). Nothing else in
# the lane reports the firmware's own judgement, so what this buys is a boot
# that gets far enough to say why it failed.
#
# The workstation's config.txt does nothing for an image booting from its own
# firmware partition, so every image for this board needs its own copy.
os_check=0

# The overclock deliberately does NOT live here, and must never be written to
# the EEPROM either: SDRAM_BANKLOW and BOOT_ORDER are firmware state shared by
# both roles, so an overclock written there overclocks the workstation too --
# the exact split this whole design exists to preserve. When an `oc` profile
# arrives it sets arm_freq/over_voltage in that *profile's* config.txt.append,
# because it is a property of the measurement and not of the board.
