# --- wk sysimage: webkit-2.52-yocto-rpi4-64 ---------------------------------
# Appended by `wk sysimage build` to the image's own config.txt (the firmware
# reads it off the boot partition whatever the OS is). Only ever adds: the
# image's own copy is what makes it bootable.
#
# What is in here is what this *board* needs in order to be measured, so it
# belongs to whichever profile is measured on it.

[all]
# Pin the ARM clock, because a benchmark measures whatever the clock was doing.
#
# The Pi 4 idles at 600 MHz and ramps on demand. A run that starts cold spends
# its first samples on a CPU that is still climbing, and DVFS ramping inside a
# measurement is a source of variance that has nothing to do with the code
# under test -- which is why `jsc-jetstream-compare` treats pinning the
# frequency as mandatory rather than as tuning.
#
# force_turbo=1 holds the ARM clock at arm_freq instead of scaling it, and
# arm_freq_min=arm_freq removes the floor the firmware would otherwise scale
# back to. Both, not either: force_turbo alone still leaves a min the firmware
# is entitled to use in some states.
force_turbo=1
arm_freq=1500
arm_freq_min=1500

# 1500 and not 1800, deliberately. 1800 needs `arm_boost=1`, and the boost clock
# is the one this board is least able to hold: a Pi 4 with no heatsink throttles
# under sustained load, and a run that throttles partway is worse than a slower
# run that does not, because it is quietly two measurements. 1500 MHz is this
# board's rated base clock, so it is the fastest number it can be expected to
# hold flat.
#
# Set here rather than assumed absent: whether a given image's config.txt turns
# boost on is not something to find out from a benchmark result. `[all]` is
# appended last, so this wins wherever it is set.
arm_boost=0

# The overclock deliberately does NOT live here, and must never be written to
# the EEPROM either: BOOT_ORDER and the SDRAM timings are firmware state shared
# by every role this board has. Per-image is the only place an overclock can go
# without following the board into its rescue role.
