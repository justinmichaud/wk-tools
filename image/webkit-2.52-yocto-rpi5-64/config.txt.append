# --- wk sysimage: webkit-2.52-yocto-rpi5-64 ---------------------------------
# Appended by `wk sysimage build` to the image's own config.txt (the firmware
# reads it off the boot partition whatever the OS is). Only ever adds: the
# image's own copy is what makes it bootable.
#
# What is in here is what this *board* needs in order to be measured, so it
# belongs to whichever profile is measured on it.

[all]
# Pi 5 firmware rejects kernels that lack Ubuntu's trailer, and marks their
# boot 'bad'. Anything staged or built by us is "locally built" by that
# definition, so the image needs its own copy of this -- the workstation's
# config.txt having it does nothing for the image, which boots from its own
# firmware partition.
os_check=0

# The overclock deliberately does NOT live here, and must never be written to
# the EEPROM either: SDRAM_BANKLOW and BOOT_ORDER are firmware state shared by
# both roles, so an overclock written there overclocks the workstation too --
# the exact split this whole design exists to preserve. When an `oc` profile
# arrives it sets arm_freq/over_voltage in *this* file, per image.
