#!/bin/sh

set -u

KEY=/etc/wk/tailscale-authkey
CONF=/etc/wk/tailnet.conf
TS=/usr/bin/tailscale

say() { echo "wk-tailnet-join: $*"; }

shout() {
    say "$*"
    [ -w /dev/console ] && echo "wk-tailnet-join: $*" > /dev/console 2>/dev/null
    return 0
}

[ -x "$TS" ] || { say "no $TS -- nothing to join with"; exit 0; }

# `tailscale ip -4` checks the property, not the daemon's say-so: a running tailscaled with no identity answers nothing here.
if "$TS" ip -4 >/dev/null 2>&1; then
    say "already on the tailnet as $("$TS" ip -4 2>/dev/null | head -1)"
    rm -f "$KEY"
    exit 0
fi

if [ ! -r "$KEY" ]; then
    shout "no auth key at $KEY -- this node has no tailnet identity and cannot join."
    shout "  remedy: wk sysimage write --machine <name>  (rewrite the card with a key)"
    exit 1
fi

HOSTNAME_WANTED=""
TAG="tag:wk"
if [ -r "$CONF" ]; then
    HOSTNAME_WANTED=$(sed -n 's/^hostname=//p' "$CONF" | head -1)
    TAG_READ=$(sed -n 's/^tag=//p' "$CONF" | head -1)
    [ -n "$TAG_READ" ] && TAG="$TAG_READ"
fi
[ -n "$HOSTNAME_WANTED" ] || HOSTNAME_WANTED=$(cat /etc/hostname 2>/dev/null | tr -d ' \t\n')
[ -n "$HOSTNAME_WANTED" ] || HOSTNAME_WANTED=$(hostname 2>/dev/null)

say "joining as $HOSTNAME_WANTED ($TAG)"

# `--auth-key file:`, not the key itself: argv is world readable in /proc.
if "$TS" up --auth-key "file:$KEY" \
        --advertise-tags="$TAG" \
        --hostname="$HOSTNAME_WANTED" \
        --accept-dns=false; then
    say "up as $HOSTNAME_WANTED at $("$TS" ip -4 2>/dev/null | head -1)"
    rm -f "$KEY"
else
    say "tailscale up failed -- the key is kept so the next boot can retry."
    say "  a key that is single-use, untagged or expired fails exactly here."
    exit 0
fi
