#!/usr/bin/env bash
#
# wk gc [--purge-mirror] [--purge-pmos] [--purge-builds] -- reclaim disk
#
# wk: where=host name=none group=sources
#
# Covers every place data accumulates. Prunes by reference count, so a plain
# `wk gc` can never lose work: rubble from interrupted image builds,
# superseded boot images, stranded compressed copies beside a kept image,
# unreferenced base snapshots, dangling podman images/volumes, the mirror
# (repacked, not erased), ccache, stale benchmark payload seeds, orphaned
# creation bookkeeping, and the workspace->target registry every machine
# used to keep -- `wk gc` is the whole migration off it. Also runs fstrim:
# the VM's disk image is sparse and never shrinks on its own, so deleting
# files inside the VM returns no bytes
# to the host until the guest discards those blocks. `wk disk` says what any
# of it costs; `wk help` is the prose.
#
#   --purge-mirror   erase the master git store and every base snapshot (wk
#                    sync refetches them); refused while any workspace exists
#   --purge-pmos     erase the pmbootstrap chroots on the pmos build hosts
#   --purge-builds   erase the build trees images come out of (hours to
#                    rebuild; the next image build there refetches them)
#   --refresh-net    kept as a no-op; the egress policy is by hostname now

set -euo pipefail
# Honouring the environment lets the container half below run *this* copy of
# this file inside the podman VM: `bash -s` sets $0 to "bash", so deriving
# the root from it there resolves to /var/home and every source fails.
# cmd/disk's store probe has the same fix for the same reason.
WK_ROOT="${WK_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/detach.sh"
# The image store's paths and the pmos build hosts' caches: both live here on
# a macOS host, not in the VM.
#
# Sourced optionally, not defensively: the container half pipes this file into
# the VM's bash, where the rest of the tree is only as new as the last
# `wk sync --target container` -- a hard source of a newly-added file fails
# there with "No such file or directory" for a path valid out here.
_source_if_there() { [ -f "$1" ] && . "$1"; return 0; }
_source_if_there "$WK_ROOT/lib/image.sh"
_source_if_there "$WK_ROOT/image/profiles.sh"
_source_if_there "$WK_ROOT/boot/machines.sh"
_source_if_there "$WK_ROOT/image/pmos.sh"

# --- migration: the old workspace->target registry --------------------------
# A cache of a recomputable fact (CLAUDE.md, "no caching of facts"): which
# target a workspace lives on is derived fresh on every call now (ws_target,
# lib/target.sh), so nothing reads this directory any more. Removed here as
# rubble, like any other unreferenced bytes gc finds -- `wk gc` (on the host,
# and once more inside the podman VM on a Mac, which held its own copy) is
# the whole migration off it.
rm -rf "$(wk_state_dir)/targets"

# Through load_target, never by sourcing the driver directly: a driver uses
# lib/target.sh's helpers at source time, and only load_target does the
# per-target reset that stops two drivers in one process sharing globals.
TARGET="${WK_TARGET:-$(default_target)}"
load_target "$TARGET"

# Exclusive, for the same reason `wk sync` takes it: this prunes snapshots by
# reference count, and both `wk sync` (publishing one) and `wk new` (pinning
# one) hold the same lock -- otherwise the window between resolving a base and
# recording the pin is one where gc can delete it from underneath.
hold_lock store

REFRESH_NET=""
[ "${1:-}" = --refresh-net ] && REFRESH_NET=1

# Erasing the master git store, not pruning what nothing references. A flag
# on gc, not a command of its own: same store, same lock, same fstrim at the
# end -- what differs is this throws away something still referenced by
# policy (the newest snapshot), refetchable only over the network.
PURGE=""
[ "${1:-}" = --purge-mirror ] && PURGE=1
# The pmbootstrap chroots on a build host: 8 GB, rebuildable from the network,
# and the difference between a four-minute rebuild and a twenty-minute one. Same
# shape of decision as --purge-mirror, so the same shape of flag.
PURGE_PMOS=""
[ "${1:-}" = --purge-pmos ] && PURGE_PMOS=1

# And the build trees themselves. Same shape again, and the same reason it is a
# flag rather than the default: a buildroot tree is hours of compilation and a
# yocto cache is what makes the next build minutes instead of a day.
PURGE_BUILDS=""
[ "${1:-}" = --purge-builds ] && PURGE_BUILDS=1

# Validated rather than ignored: harmless while every flag is a no-op or a
# refresh, but not next to a flag that erases the mirror -- a typo there
# would run an ordinary gc and report success at doing something else.
case "${1:-}" in
    ''|--refresh-net|--purge-mirror|--purge-pmos|--purge-builds) ;;
    *) die "usage: wk gc [--purge-mirror] [--purge-pmos] [--purge-builds] -- reclaim disk.; see wk gc -h" ;;
esac

# --- the halves, and which machine each belongs to ----------------------------
# On a Mac, wk's storage spans two machines: the container store is inside
# the podman VM, and the image store and pmos caches are out here. Forwarding
# this command whole would prune only the VM's store and report success.
#
# So the halves are named and run separately: on Linux there's one machine;
# on a Mac the second half is this same file piped into the VM's bash, the
# same trick cmd/disk's store probe uses.

# --- boot images ---------------------------------------------------------------
# 4.6 GB each, rebuilt whenever a profile's spec changes -- the fastest-growing
# thing in the store. Three conservative sweeps:
#
#   * rubble first -- a directory with no manifest is an interrupted build,
#     already ignored by every reader and unpinnable by anything.
#   * then all but the newest complete image per profile. An image has no pin
#     to consult (unlike a base snapshot: it's written to a device, which
#     holds no reference back), so the newest is kept unconditionally as the
#     one `wk boot` would arm; older ones rebuild from a spec in the repo.
#   * then any compressed copy or block map beside an image that's *kept* --
#     nothing reads them (boot/disk.sh streams disk.img whole), so they're
#     bytes with no purpose.
#
# Resolves the store's path through image_store_dir, not `$WK_STORE/images`:
# on a macOS host those differ (lib/image.sh says why), and the wrong one
# silently reclaims nothing on the machine that actually has the images.
gc_images() {
    # Nothing to prune without the image store's own path helpers -- which is
    # the case in a podman VM whose copy of the tree predates them.
    command -v image_store_dir >/dev/null 2>&1 || return 0
    [ -d "$(image_store_dir)" ] || return 0

    # One lock per mutated resource (rule 4): `wk sysimage build` holds this
    # while it imports, and pruning "all but the newest per profile" against a
    # store that is gaining one is how the newest gets deleted.
    image_lock

    local id profile newest f sz stranded=""

    for id in $(image_rubble); do
        info "removing rubble from an interrupted image build: $id"
        rm -rf "$(image_dir "$id")"
    done

    for id in $(image_ids | sort); do
        profile=$(manifest_get "$id" profile) || continue
        newest=$(image_latest "$profile" 2>/dev/null) || continue
        [ "$id" = "$newest" ] && continue
        info "removing superseded image $id ($(du -sh "$(image_dir "$id")" 2>/dev/null | cut -f1))"
        rm -rf "$(image_dir "$id")"
    done

    for id in $(image_ids); do
        for f in disk.wic.xz disk.bmap; do
            [ -f "$(image_dir "$id")/$f" ] || continue
            stranded="$stranded $(image_dir "$id")/$f"
        done
    done
    if [ -n "$stranded" ]; then
        # shellcheck disable=SC2086
        sz=$(du -ch $stranded 2>/dev/null | tail -1 | cut -f1)
        info "removing compressed copies and block maps beside disk.img -- nothing reads them (${sz:-?})"
        # shellcheck disable=SC2086
        rm -f $stranded
        # A manifest that names a file which is not there is a record
        # disagreeing with the disk, and `wk sysimage show` prints it. The
        # fields go with the files.
        for id in $(image_ids); do
            sed -i.bak -E '/^(wic_xz|bmap|wic_xz_bytes|wic_of)=/d' "$(image_manifest "$id")" 2>/dev/null \
                && rm -f "$(image_manifest "$id").bak"
        done
    fi

    # Nothing writes serve/, so anything under it is unreferenced bytes.
    if [ -d "$WK_STORE/serve" ]; then
        info "removing the retired serve/ tree ($(du -sh "$WK_STORE/serve" 2>/dev/null | cut -f1))"
        rm -rf "${WK_STORE:?}/serve"
    fi
    return 0
}

# The pmos build hosts: pmbootstrap's chroots and builds waiting to be
# imported, pruned the way images are -- interrupted builds and all but the
# newest two -- with chroots erased only when asked, since they're what makes
# a rebuild four minutes instead of twenty.
#
# Never from inside the VM: it has no route to a build host.
gc_pmos() {
    [ -z "${WK_IN_VM:-}" ] || return 0
    command -v pmos_build_hosts >/dev/null 2>&1 || return 0
    local h
    for h in $(pmos_build_hosts 2>/dev/null); do
        ( WK_PMOS_HOST="$h"; pmos_prune ) || warn "could not prune the build cache on $h"
        [ -n "$PURGE_PMOS" ] && pmos_purge_work "$h"
    done
    return 0
}

# --- everywhere a build leaves bytes ------------------------------------------
# Walks the declared list (image_build_locations, lib/image.sh) and reports
# every entry's size, so "where did 60 GB go" is on screen, not memory.
#
# Reports, doesn't delete: a buildroot tree is hours of compilation and a
# yocto cache makes the next build minutes instead of a day, so removing
# either is a decision -- `wk gc --purge-builds` is where that's made.
gc_build_outputs() {
    command -v image_build_locations >/dev/null 2>&1 || return 0
    local d sz any=""
    for d in $(image_build_locations); do
        [ -d "$d" ] || continue
        sz=$(du -sh "$d" 2>/dev/null | cut -f1)
        [ -n "$any" ] || info "build output, wherever a builder left it:"
        any=1
        log "  ${sz:-?}  $d"
        if [ -n "${PURGE_BUILDS:-}" ]; then
            info "  removing $d (--purge-builds)"
            rm -rf "${d:?}"
        fi
    done
    [ -n "$any" ] || return 0
    [ -n "${PURGE_BUILDS:-}" ] || log "  kept -- 'wk gc --purge-builds' removes them"
    return 0
}

# --- a macOS host: do this machine's half, hand the rest to the VM -----------
# Placed before the store work below: on a Mac $WK_STORE is the VM's
# /var/lib/wk, meaningless out here. `wk` no longer forwards this command
# (is_host_command), so the split lives here, and the VM's exit status is this one's.
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    info "this machine's half: boot images and the pmos build hosts"
    gc_images
    gc_pmos
    # Both halves report their own build locations, because each machine has
    # different ones: on a Mac the buildroot and yocto trees are inside the VM
    # and the downloaded bases are out here, so a single report would be half an
    # answer wherever it ran.
    gc_build_outputs

    if command -v podman >/dev/null 2>&1 \
       && [ "$(podman machine inspect "${WK_MACHINE:-wk}" --format '{{.State}}' 2>/dev/null)" = running ]; then
        info "the container store's half, inside the podman machine"
        podman machine ssh "${WK_MACHINE:-wk}" -- \
            "WK_IN_VM=1 WK_ROOT=/opt/wk-tools WK_STORE=/var/lib/wk bash -s -- ${1:-}" <"$0"
        exit $?
    fi
    warn "the podman machine is not running, so the container store was not touched"
    log  "  'wk start', then 'wk gc' again -- that half is the mirror, the snapshots"
    log  "  and every workspace's overlay, and it is the largest of them"
    exit 0
fi

# The snapshot store and the mirror belong to the overlay scheme, which is the
# container target's. A vm or remote target has neither -- its "base" is the
# golden guest image or the machine's own shared repository -- so pruning and
# repacking them there means operating on an empty directory and reporting a
# fatal git error about it.
_uses_snapshots() { t_needs_base; }

# --- --purge-mirror: the master git store -------------------------------------
# The bare mirror and every base snapshot: ~13 GB, the most expensive thing
# in a container store. `wk sync` rebuilds both from the network, which is
# why this is safe and why it isn't the default.
#
# Refused while any workspace exists -- not politeness: a snapshot is the
# *lower layer of a live overlay mount*, and the kernel leaves an overlay
# whose underlying filesystem changes undefined. Purging ignores reference
# counts, so there must be no references at all.
if [ -n "$PURGE" ]; then
    _uses_snapshots || die "target '$TARGET' has no mirror or snapshots to purge: its base is
    $([ "$WK_TARGET_KIND" = vm ] \
        && echo "the golden guest image -- erase that with 'wk vm base --rm'" \
        || echo "that machine's own repository -- 'wk remote rm $TARGET' offers to remove
    the remote root, and 'wk sync --target $TARGET' refreshes it in place")"

    ws=$(list_workspaces | tr '\n' ' '); ws="${ws% }"
    [ -z "$ws" ] || die "workspaces still exist:$ws
    Every one of them is an overlay whose lower layer is a snapshot in here, so
    this would delete the ground they stand on. Remove them first (wk rm <name>)
    -- or run plain 'wk gc', which prunes only what nothing references."

    # tr: macOS du right-aligns its size field, and " 0B" in a listing reads as
    # a typo rather than as a measurement.
    sz_m=$(du -sh "$(wk_mirror)" 2>/dev/null | cut -f1 | tr -d ' ' || echo '?')
    sz_b=$(du -sh "$(wk_base_dir)" 2>/dev/null | cut -f1 | tr -d ' ' || echo '?')
    n_b=$(ls -1 "$(wk_base_dir)" 2>/dev/null | wc -l | tr -d ' ')
    log "  mirror    $(wk_mirror)  ($sz_m)"
    log "  snapshots $(wk_base_dir)  ($sz_b, $n_b of them)"
    confirm "erase the mirror and every base snapshot? 'wk sync' refetches them (a full clone)" \
        || die "aborted -- nothing was changed"

    rm -rf "${WK_STORE:?}/git" "${WK_STORE:?}/base"
    info "erased the mirror and every base snapshot"
    log  "  'wk sync' rebuilds them; 'wk new' needs one, so run it before the next workspace"
fi

# --- unreferenced base snapshots --------------------------------------------
# A workspace with no recorded pin yet -- creation in flight, or rubble from
# one that was killed -- is a reference nothing can count, so
# `unreferenced_bases` refuses to answer while one exists: the snapshots stay,
# costing disk and nothing else.
unpinned=""
if _uses_snapshots; then
    unpinned=$(unpinned_workspaces | tr '\n' ' ')
    unpinned="${unpinned% }"
fi

if [ -n "$unpinned" ]; then
    warn "not pruning snapshots: workspace(s) $unpinned have no recorded base"
    log  "  they never finished being created -- 'wk new <name>' remakes one from"
    log  "  scratch, 'wk rm <name>' removes it; then re-run 'wk gc'"
elif _uses_snapshots; then
    for base in $(unreferenced_bases); do
        info "removing unreferenced snapshot $base"
        rm -rf "$(wk_base_dir)/$base"
    done
fi

# --- podman ------------------------------------------------------------------
if [ "$WK_TARGET_KIND" = container ] && have podman; then
    podman image prune -f >/dev/null 2>&1 || true
    podman volume prune -f >/dev/null 2>&1 || true
    info "pruned dangling images and volumes"
fi

# --- the mirror --------------------------------------------------------------
# Repacking rewrites pack files that snapshots share inodes with via cp -al, so
# it is only safe when nothing is using them.
active=$(list_workspaces | wc -l | tr -d ' ')
if ! _uses_snapshots; then
    debug "no snapshot store on target '$TARGET'; nothing to repack"
elif [ ! -d "$(wk_mirror)" ]; then
    debug "no mirror here; nothing to repack"
elif [ "$active" -eq 0 ]; then
    info "repacking the mirror"
    git -C "$(wk_mirror)" gc --auto --quiet || true
else
    log "skipping mirror repack: $active workspace(s) still reference snapshots"
fi

# --- ccache ------------------------------------------------------------------
if have ccache; then
    CCACHE_DIR="$WK_STORE/cache/ccache" ccache --max-size="$WK_CCACHE_MAXSIZE" >/dev/null
    CCACHE_DIR="$WK_STORE/cache/ccache" ccache --cleanup >/dev/null 2>&1 || true
    info "ccache trimmed to $WK_CCACHE_MAXSIZE"
fi

# --- firewall address sets ---------------------------------------------------
# Gone: the boundary now allowlists by hostname in the egress proxy on both
# hosts, so there's no CIDR set to refresh or go stale. `--refresh-net` stays
# a no-op rather than an error, so a habit or a stale script doesn't fail.
if [ -n "$REFRESH_NET" ]; then
    warn "--refresh-net does nothing any more: the egress policy is by hostname,
  in container/proxy/wk-proxy.py, and needs no periodic refresh."
    REFRESH_NET=""
fi

# --- stale benchmark payload seeds --------------------------------------------
# Seeds are keyed <plan>-<sha12>, so every upstream move of a benchmark strands
# the previous clone. They are re-fetchable, so keeping only the newest per
# plan is safe. Results under $WK_STORE/bench are the provenance record and are
# never pruned automatically -- their size is reported below instead.
if [ -d "$WK_STORE/cache/bench" ]; then
    for seed in "$WK_STORE"/cache/bench/*/; do
        [ -d "$seed" ] || continue
        seed="${seed%/}"
        # Exactly twelve trailing characters: plan names contain dashes too, so
        # a looser match would let one plan's newer seed delete another's.
        case "$seed" in
            *-????????????) ;;
            *) continue ;;
        esac
        plan="${seed%-????????????}"
        for other in "$plan"-????????????; do
            [ -d "$other" ] || continue
            [ "$other" = "$seed" ] && continue
            if [ "$other" -nt "$seed" ]; then
                info "removing stale benchmark payload $(basename "$seed")"
                rm -rf "$seed"
                break
            fi
        done
    done
fi

# --- creation bookkeeping with nothing left to describe ------------------------
# `wk new` writes $WK_STORE/create/<name>.{status,log} so a later command can
# tell a half-made workspace from a missing one; `wk rm` removes the pair with
# the workspace. Nothing removes the pair whose workspace and environment are
# both gone and nothing is creating it any more -- an interrupted `wk rm`, or
# a driver that died before anything existed. Small, and otherwise sits there
# forever.
#
# No registry: a record speaks for a workspace only while creation is
# genuinely in flight (the same rule ws_target applies, lib/target.sh) --
# checked directly against the process table, not a file that outlives it.
# Once it is dead, only the store answers, asked directly across every
# target this machine can see (this loop covers this one target's own
# create/ directory; running gc against every target reaps every one's).
if [ -d "$(ws_state_dir)" ]; then
    for _sf in "$(ws_state_dir)"/*.status; do
        [ -f "$_sf" ] || continue
        _n=$(basename "$_sf" .status)
        if detach_alive "$_sf"; then continue; fi
        _found=""
        for _t in $(target_all 2>/dev/null); do
            if ( load_target "$_t" >/dev/null 2>&1; [ -d "$(wk_ws_dir "$_n")" ] ); then
                _found=1; break
            fi
        done
        [ -z "$_found" ] || continue
        info "removing orphaned creation record for '$_n' (no live creation, no workspace)"
        rm -f "$_sf" "$(ws_create_log "$_n")"
    done
    unset _sf _n _t _found
fi

gc_images   # (defined above; the store's images)
gc_build_outputs  # ...and everywhere else a build can leave bytes
gc_pmos     # ...and the build hosts' caches, on the machine that can reach them

# --- return free space to the host ------------------------------------------
# Only with passwordless sudo (the podman VM has it; a workstation may not):
# gc runs unattended, and a command that prompts has stopped being usable by
# an agent. Skipping is safe -- the space stays reclaimable.
if [ -n "${WK_IN_VM:-}" ] || is_linux; then
    if sudo -n true 2>/dev/null; then
        sudo -n fstrim -av 2>/dev/null || warn "fstrim failed; freed space may not return to the host"
    else
        log "skipping fstrim (needs a password) -- run 'sudo fstrim -av' yourself to return freed space"
    fi
fi

info "gc complete"
df -h "$WK_STORE" 2>/dev/null | tail -1 || true

# What gc deliberately does not prune, so growth is visible rather than silent.
for d in bench cache/bench cache/images cache/yocto/sstate cache/yocto/downloads \
         cache/yocto/buildtools cache/buildroot; do
    [ -d "$WK_STORE/$d" ] || continue
    du -sh "$WK_STORE/$d" 2>/dev/null | awk -v d="$d" '{printf "  %-8s %s (kept; prune by hand if needed)\n", $1, d}' >&2
done
