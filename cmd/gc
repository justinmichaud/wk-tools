#!/usr/bin/env bash
#
# wk gc -- reclaim disk.
#
# Covers every place data accumulates, because the design promises that nothing
# grows silently. In particular it runs fstrim: the VM's disk image is sparse
# and never shrinks on its own, so deleting files inside the VM returns exactly
# zero bytes to the host until the guest discards those blocks.
#
# Everything here prunes by reference count, so a plain `wk gc` can never lose
# work. `--purge-mirror` is the deliberate exception -- it erases the master git
# store, which only the network can rebuild. `wk disk` says what any of it costs;
# `wk help disk` is the prose.

set -euo pipefail
# Honouring the environment is what lets the container half below run *this*
# copy of this file inside the podman VM: `bash -s` sets $0 to "bash", so
# deriving the root from it there resolves to the parent of whatever cwd the ssh
# landed in (/var/home) and every source fails. cmd/disk's store probe says the
# same thing for the same reason.
WK_ROOT="${WK_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
# The image store's own paths, and the pmos build hosts' caches: both are things
# this command prunes, and on a macOS host both are here rather than in the VM.
#
# Optionally, and that is not defensiveness: the container half of this command
# is this file piped into the VM's bash, where the *rest* of the tree is only as
# new as the last `wk sync --target container`. A hard source of a file added in
# the same commit as this line fails in there with "No such file or directory"
# about a path that is perfectly correct out here. (cmd/disk's store probe
# depends on this same property and says so.) The halves that need these check
# for them.
_source_if_there() { [ -f "$1" ] && . "$1"; return 0; }
_source_if_there "$WK_ROOT/lib/image.sh"
_source_if_there "$WK_ROOT/image/profiles.sh"
_source_if_there "$WK_ROOT/boot/machines.sh"
_source_if_there "$WK_ROOT/image/pmos.sh"

# Through load_target, never by sourcing the driver directly: a driver is
# written against the contract in lib/target.sh and uses its helpers at source
# time (`WK_TARGET=vm wk gc` died in targets/vm.sh with `wk_state_dir: command
# not found`), and the per-target reset that stops two drivers in one process
# from inheriting each other's globals lives there too.
TARGET="${WK_TARGET:-$(default_target)}"
load_target "$TARGET"

# Exclusive, for the same reason `wk sync` takes it: this prunes snapshots by
# reference count, and both `wk sync` (which publishes one) and `wk new` (which
# pins one) hold the same lock. Without it, the window between `wk new`
# resolving a base and the driver recording the pin is a window in which gc can
# delete the snapshot underneath it.
hold_lock store

REFRESH_NET=""
[ "${1:-}" = --refresh-net ] && REFRESH_NET=1

# Erasing the master git store, rather than pruning what nothing references.
# A flag on gc rather than a command of its own: it is the same store, the same
# lock and the same fstrim at the end -- what differs is that this one throws
# away something still referenced by policy (the newest snapshot) and refetchable
# only over the network.
PURGE=""
[ "${1:-}" = --purge-mirror ] && PURGE=1
# The pmbootstrap chroots on a build host: 8 GB, rebuildable from the network,
# and the difference between a four-minute rebuild and a twenty-minute one. Same
# shape of decision as --purge-mirror, so the same shape of flag.
PURGE_PMOS=""
[ "${1:-}" = --purge-pmos ] && PURGE_PMOS=1

# And the build trees themselves. Same shape again, and the same reason it is a
# flag rather than the default: a buildroot tree is hours of compilation and a
# yocto cache is what makes the next build minutes instead of a day.
PURGE_BUILDS=""
[ "${1:-}" = --purge-builds ] && PURGE_BUILDS=1

# Validated rather than ignored, which is what this command used to do with an
# unrecognised argument. That was harmless while every flag was a no-op or a
# refresh; it is not harmless next to a flag that erases the mirror, because a
# typo would run a full ordinary gc and report success at doing something else.
case "${1:-}" in
    ''|--refresh-net|--purge-mirror|--purge-pmos|--purge-builds) ;;
    *) die "unknown option '$1'
    usage: wk gc [--purge-mirror] [--purge-pmos] [--purge-builds]
      --purge-mirror  erase the master git store (wk sync refetches it)
      --purge-pmos    erase the pmbootstrap chroots on the pmos build hosts
      --purge-builds  erase the build trees images come out of (hours to rebuild)
                      (the next image build there refetches them)
      (--refresh-net is kept as a no-op)" ;;
esac

# --- the halves, and which machine each belongs to ----------------------------
#
# What wk stores is on two machines whenever the workstation is a Mac: the
# container store is inside the podman VM, and the image store and the pmos
# build hosts' caches are out here. `wk gc` was forwarded whole, so it pruned the
# VM's store and left 3 GB of phone images and 8 GB of pmbootstrap chroots
# untouched -- reporting success at reclaiming disk while the two largest things
# this repo stores sat there.
#
# So the halves are named. Both run on Linux, where there is one machine;
# on a macOS host the first runs here and the second is this same file piped
# into the VM's bash -- the trick cmd/disk already uses for its store probe,
# and for the same reason (the copy at /opt/wk-tools is only as new as the last
# `wk sync --target container`).

# --- boot images ---------------------------------------------------------------
gc_images() {
    # Nothing to prune without the image store's own path helpers -- which is
    # the case in a podman VM whose copy of the tree predates them.
    command -v image_store_dir >/dev/null 2>&1 || return 0
    # One lock per mutated resource (rule 4): `wk sysimage build` holds this
    # while it imports, and pruning "all but the newest per profile" against a
    # store that is gaining one is how the newest gets deleted.
    image_lock
# 4.6 GB each, and a profile gets rebuilt every time its spec changes, so this
# is the fastest-growing thing in the store by a wide margin. Two rules, both
# conservative:
#
#   * rubble first -- a directory with no manifest is an interrupted build,
#     which every reader already ignores and nothing can be pinned to.
#   * then all but the newest complete image per profile. Unlike a base
#     snapshot there is no pin to consult: an image is written to a device and
#     the device does not hold a reference back. The newest of each profile is
#     therefore kept unconditionally, because it is the one `wk boot` would
#     arm, and older ones are re-buildable from a spec in the repo.
# Sourced before the test, not inside it: the store's location is
# image_store_dir's answer and not $WK_STORE/images -- on a macOS host those are
# two different places (lib/image.sh says why), and testing the wrong one means
# gc reports reclaiming nothing, for ever, on the machine that has the images.
if [ -d "$(image_store_dir)" ]; then

    for id in $(image_rubble); do
        info "removing rubble from an interrupted image build: $id"
        rm -rf "$(image_dir "$id")"
    done

    for id in $(image_ids | sort); do
        profile=$(manifest_get "$id" profile) || continue
        newest=$(image_latest "$profile" 2>/dev/null) || continue
        [ "$id" = "$newest" ] && continue
        info "removing superseded image $id ($(du -sh "$(image_dir "$id")" 2>/dev/null | cut -f1))"
        rm -rf "$(image_dir "$id")"
    done

    # The served copy of an image that is no longer there is just bytes. The
fi
}

# The pmos build hosts: pmbootstrap's chroots and the builds waiting to be
# imported, on a machine that is not this one. Pruned the way images are --
# interrupted builds and all but the newest two -- and the chroots only when
# asked, because they are what makes a rebuild four minutes.
#
# Never from inside the VM: it has no route to a build host, and a failure there
# would be a confusing error about somebody else's machine.
gc_pmos() {
    [ -z "${WK_IN_VM:-}" ] || return 0
    command -v pmos_build_hosts >/dev/null 2>&1 || return 0
    local h
    for h in $(pmos_build_hosts 2>/dev/null); do
        ( WK_PMOS_HOST="$h"; pmos_prune ) || warn "could not prune the build cache on $h"
        [ -n "$PURGE_PMOS" ] && pmos_purge_work "$h"
    done
    return 0
}

# --- everywhere a build leaves bytes ------------------------------------------
#
# With no image store, "reclaim the images" stops being one directory: output
# lives where the builder left it. This walks the declared list
# (image_build_locations, lib/image.sh) and reports every entry with its size,
# so the answer to "where did 60 GB go" is on screen rather than in somebody's
# memory of which builder ran last.
#
# It reports and does not delete. A buildroot tree is hours of compilation and a
# yocto cache is what makes the next build minutes instead of a day, so removing
# either is a decision -- `wk gc --purge-builds` is where that decision is made.
# Saying nothing would be worse than either: bytes nothing mentions are bytes
# nobody reclaims.
gc_build_outputs() {
    command -v image_build_locations >/dev/null 2>&1 || return 0
    local d sz any=""
    for d in $(image_build_locations); do
        [ -d "$d" ] || continue
        sz=$(du -sh "$d" 2>/dev/null | cut -f1)
        [ -n "$any" ] || info "build output, wherever a builder left it:"
        any=1
        log "  ${sz:-?}  $d"
        if [ -n "${PURGE_BUILDS:-}" ]; then
            info "  removing $d (--purge-builds)"
            rm -rf "${d:?}"
        fi
    done
    [ -n "$any" ] || return 0
    [ -n "${PURGE_BUILDS:-}" ] || log "  kept -- 'wk gc --purge-builds' removes them"
    return 0
}

# --- a macOS host: do this machine's half, hand the rest to the VM -----------
#
# Placed before the store work below, because on a Mac $WK_STORE is the VM's
# /var/lib/wk and none of that work means anything out here. `wk` does not
# forward this command any more (is_host_command), so this is where the split
# lives -- and the exit status is the VM's, so a failure in there is still a
# failure of `wk gc`.
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    info "this machine's half: boot images and the pmos build hosts"
    gc_images
    gc_pmos
    # Both halves report their own build locations, because each machine has
    # different ones: on a Mac the buildroot and yocto trees are inside the VM
    # and the downloaded bases are out here, so a single report would be half an
    # answer wherever it ran.
    gc_build_outputs

    if command -v podman >/dev/null 2>&1 \
       && [ "$(podman machine inspect "${WK_MACHINE:-wk}" --format '{{.State}}' 2>/dev/null)" = running ]; then
        info "the container store's half, inside the podman machine"
        podman machine ssh "${WK_MACHINE:-wk}" -- \
            "WK_IN_VM=1 WK_ROOT=/opt/wk-tools WK_STORE=/var/lib/wk bash -s -- ${1:-}" <"$0"
        exit $?
    fi
    warn "the podman machine is not running, so the container store was not touched"
    log  "  'wk start', then 'wk gc' again -- that half is the mirror, the snapshots"
    log  "  and every workspace's overlay, and it is the largest of them"
    exit 0
fi

# The snapshot store and the mirror belong to the overlay scheme, which is the
# container target's. A vm or remote target has neither -- its "base" is the
# golden guest image or the machine's own shared repository -- so pruning and
# repacking them there means operating on an empty directory and reporting a
# fatal git error about it.
_uses_snapshots() { t_needs_base; }

# --- --purge-mirror: the master git store -------------------------------------
#
# The bare mirror and every base snapshot: ~13 GB of history plus a working tree
# per snapshot, and the most expensive thing in a container store. `wk sync`
# rebuilds both from the network, which is the whole reason this is safe to do
# and the whole reason it is not the default.
#
# Refused while any workspace exists, and this is not politeness: a snapshot is
# the *lower layer of a live overlay mount*, and the kernel says the behaviour of
# an overlay whose underlying filesystem changes is undefined. `wk gc` prunes by
# reference count for exactly this reason; purging ignores reference counts, so
# there must be no references at all.
if [ -n "$PURGE" ]; then
    _uses_snapshots || die "target '$TARGET' has no mirror or snapshots to purge: its base is
    $([ "$WK_TARGET_KIND" = vm ] \
        && echo "the golden guest image -- erase that with 'wk vm base --rm'" \
        || echo "that machine's own repository -- 'wk remote rm $TARGET' offers to remove
    the remote root, and 'wk sync --target $TARGET' refreshes it in place")"

    ws=$(list_workspaces | tr '\n' ' '); ws="${ws% }"
    [ -z "$ws" ] || die "workspaces still exist:$ws
    Every one of them is an overlay whose lower layer is a snapshot in here, so
    this would delete the ground they stand on. Remove them first (wk rm <name>)
    -- or run plain 'wk gc', which prunes only what nothing references."

    # tr: macOS du right-aligns its size field, and " 0B" in a listing reads as
    # a typo rather than as a measurement.
    sz_m=$(du -sh "$(wk_mirror)" 2>/dev/null | cut -f1 | tr -d ' ' || echo '?')
    sz_b=$(du -sh "$(wk_base_dir)" 2>/dev/null | cut -f1 | tr -d ' ' || echo '?')
    n_b=$(ls -1 "$(wk_base_dir)" 2>/dev/null | wc -l | tr -d ' ')
    log "  mirror    $(wk_mirror)  ($sz_m)"
    log "  snapshots $(wk_base_dir)  ($sz_b, $n_b of them)"
    confirm "erase the mirror and every base snapshot? 'wk sync' refetches them (a full clone)" \
        || die "aborted -- nothing was changed"

    rm -rf "${WK_STORE:?}/git" "${WK_STORE:?}/base"
    info "erased the mirror and every base snapshot"
    log  "  'wk sync' rebuilds them; 'wk new' needs one, so run it before the next workspace"
fi

# --- unreferenced base snapshots --------------------------------------------
#
# A workspace that has not recorded its pin yet -- creation in flight, or
# rubble left by one that was killed -- is a reference nothing can count, and
# `unreferenced_bases` refuses to answer at all while one exists. Saying why is
# this command's job: the snapshots simply stay, which costs disk and nothing
# else.
unpinned=""
if _uses_snapshots; then
    unpinned=$(unpinned_workspaces | tr '\n' ' ')
    unpinned="${unpinned% }"
fi

if [ -n "$unpinned" ]; then
    warn "not pruning snapshots: workspace(s) $unpinned have no recorded base"
    log  "  they never finished being created -- 'wk new <name>' remakes one from"
    log  "  scratch, 'wk rm <name>' removes it; then re-run 'wk gc'"
elif _uses_snapshots; then
    for base in $(unreferenced_bases); do
        info "removing unreferenced snapshot $base"
        rm -rf "$(wk_base_dir)/$base"
    done
fi

# --- podman ------------------------------------------------------------------
if [ "$WK_TARGET_KIND" = container ] && have podman; then
    podman image prune -f >/dev/null 2>&1 || true
    podman volume prune -f >/dev/null 2>&1 || true
    info "pruned dangling images and volumes"
fi

# --- the mirror --------------------------------------------------------------
# Repacking rewrites pack files that snapshots share inodes with via cp -al, so
# it is only safe when nothing is using them.
active=$(list_workspaces | wc -l | tr -d ' ')
if ! _uses_snapshots; then
    debug "no snapshot store on target '$TARGET'; nothing to repack"
elif [ ! -d "$(wk_mirror)" ]; then
    debug "no mirror here; nothing to repack"
elif [ "$active" -eq 0 ]; then
    info "repacking the mirror"
    git -C "$(wk_mirror)" gc --auto --quiet || true
else
    log "skipping mirror repack: $active workspace(s) still reference snapshots"
fi

# --- ccache ------------------------------------------------------------------
if have ccache; then
    CCACHE_DIR="$WK_STORE/cache/ccache" ccache --max-size="$WK_CCACHE_MAXSIZE" >/dev/null
    CCACHE_DIR="$WK_STORE/cache/ccache" ccache --cleanup >/dev/null 2>&1 || true
    info "ccache trimmed to $WK_CCACHE_MAXSIZE"
fi

# --- firewall address sets ---------------------------------------------------
# Gone, along with the packet filter that needed them. The boundary allowlists
# by hostname in the egress proxy on both hosts now, so there is no CIDR set to
# refresh and nothing to go stale -- which was most of the reason for moving to
# it. `--refresh-net` is kept as a no-op rather than an error so that a habit,
# a script or a stale note does not fail; it says what happened and moves on.
if [ -n "$REFRESH_NET" ]; then
    warn "--refresh-net does nothing any more: the egress policy is by hostname,
  in container/proxy/wk-proxy.py, and needs no periodic refresh."
    REFRESH_NET=""
fi

# --- stale benchmark payload seeds --------------------------------------------
# Seeds are keyed <plan>-<sha12>, so every upstream move of a benchmark strands
# the previous clone. They are re-fetchable, so keeping only the newest per
# plan is safe. Results under $WK_STORE/bench are the provenance record and are
# never pruned automatically -- their size is reported below instead.
if [ -d "$WK_STORE/cache/bench" ]; then
    for seed in "$WK_STORE"/cache/bench/*/; do
        [ -d "$seed" ] || continue
        seed="${seed%/}"
        # Exactly twelve trailing characters: plan names contain dashes too, so
        # a looser match would let one plan's newer seed delete another's.
        case "$seed" in
            *-????????????) ;;
            *) continue ;;
        esac
        plan="${seed%-????????????}"
        for other in "$plan"-????????????; do
            [ -d "$other" ] || continue
            [ "$other" = "$seed" ] && continue
            if [ "$other" -nt "$seed" ]; then
                info "removing stale benchmark payload $(basename "$seed")"
                rm -rf "$seed"
                break
            fi
        done
    done
fi

# --- creation bookkeeping with nothing left to describe ------------------------
#
# `wk new` writes $WK_STORE/create/<name>.{status,log} before it makes anything,
# so that a command arriving later can tell a half-made workspace from a missing
# one; `wk rm` removes the pair with the workspace. What nothing removed was the
# pair whose workspace, environment *and* registry entry are all gone -- a
# creation whose `wk rm` was interrupted, or one whose driver died before the
# registry entry landed. Listed by nothing, pruned by nothing, and small enough
# to sit there for ever.
#
# The registry is the authority on whether a name is still ours: a status file
# for a name no target knows is describing something that does not exist. A
# creation still in flight keeps its pair, because the name is registered from
# the first moment `wk new` acts.
if [ -d "$(ws_state_dir)" ]; then
    for _sf in "$(ws_state_dir)"/*.status; do
        [ -f "$_sf" ] || continue
        _n=$(basename "$_sf" .status)
        # `ws_target` cannot answer this: it falls back to the default target
        # for a name nobody knows, so it never reports "absent". The registry
        # is asked directly instead.
        if target_of "$_n" >/dev/null 2>&1; then continue; fi
        _found=""
        for _t in $(target_all 2>/dev/null); do
            if ( load_target "$_t" >/dev/null 2>&1; [ -d "$(wk_ws_dir "$_n")" ] ); then
                _found=1; break
            fi
        done
        [ -z "$_found" ] || continue
        info "removing orphaned creation record for '$_n' (no registry entry, no workspace)"
        rm -f "$_sf" "$(ws_create_log "$_n")"
    done
    unset _sf _n _t _found
fi

gc_images   # (defined above; the store's images)
gc_build_outputs  # ...and everywhere else a build can leave bytes
gc_pmos     # ...and the build hosts' caches, on the machine that can reach them

# --- boot images ---------------------------------------------------------------
# 4.6 GB each, and a profile gets rebuilt every time its spec changes, so this
# is the fastest-growing thing in the store by a wide margin. Two rules, both
# conservative:
#
#   * rubble first -- a directory with no manifest is an interrupted build,
#     which every reader already ignores and nothing can be pinned to.
#   * then all but the newest complete image per profile. Unlike a base
#     snapshot there is no pin to consult: an image is written to a device and
#     the device does not hold a reference back. The newest of each profile is
#     therefore kept unconditionally, because it is the one `wk boot` would
#     arm, and older ones are re-buildable from a spec in the repo.
if [ -d "$WK_STORE/images" ]; then
    . "$WK_ROOT/lib/image.sh"

    for id in $(image_rubble); do
        info "removing rubble from an interrupted image build: $id"
        rm -rf "$(image_dir "$id")"
    done

    for id in $(image_ids | sort); do
        profile=$(manifest_get "$id" profile) || continue
        newest=$(image_latest "$profile" 2>/dev/null) || continue
        [ "$id" = "$newest" ] && continue
        info "removing superseded image $id ($(du -sh "$(image_dir "$id")" 2>/dev/null | cut -f1))"
        rm -rf "$(image_dir "$id")"
    done

    # Nothing writes serve/ any more, so whatever is under it is a leftover
    # from an older revision of this repo -- reclaim it whole.
    if [ -d "$WK_STORE/serve" ]; then
        info "removing the retired serve/ tree ($(du -sh "$WK_STORE/serve" 2>/dev/null | cut -f1))"
        rm -rf "${WK_STORE:?}/serve"
    fi
fi

# --- return free space to the host ------------------------------------------
# Only with passwordless sudo (the podman VM has it; a workstation may not):
# gc runs unattended, and a command that prompts has stopped being usable by
# an agent. Skipping is safe -- the space stays reclaimable.
if [ -n "${WK_IN_VM:-}" ] || is_linux; then
    if sudo -n true 2>/dev/null; then
        sudo -n fstrim -av 2>/dev/null || warn "fstrim failed; freed space may not return to the host"
    else
        log "skipping fstrim (needs a password) -- run 'sudo fstrim -av' yourself to return freed space"
    fi
fi

info "gc complete"
df -h "$WK_STORE" 2>/dev/null | tail -1 || true

# What gc deliberately does not prune, so growth is visible rather than silent.
for d in bench cache/bench cache/images cache/yocto/sstate cache/yocto/downloads \
         cache/yocto/buildtools cache/buildroot; do
    [ -d "$WK_STORE/$d" ] || continue
    du -sh "$WK_STORE/$d" 2>/dev/null | awk -v d="$d" '{printf "  %-8s %s (kept; prune by hand if needed)\n", $1, d}' >&2
done
