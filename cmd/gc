"""reclaim disk

Lists what wk left on this machine, in the podman VM's store and on the machines it reaches, asks once, and removes
what a plain run may: what loses no work -- unreferenced snapshots, abandoned payload seeds, ccache and tart's image
cache down to their budgets, dangling images, a killed selftest's workspaces. The rest is named with the flag or
command that takes it. 'wk doctor' shows the same rows.
"""
from wk import gc, images, places
from wk.act import die
from wk.decl import Command, Opt

ROOT = images.root()
PURGES = ("--purge-mirror", "--purge-builds", "--purge-rubble", "--purge-images")
COMMAND = Command(where="host", destructive=True, group="sources", opts=(
    Opt("--purge-mirror", "the mirror and every snapshot ('wk sync' refetches); refused while a workspace or guest exists"),
    Opt("--purge-builds", "image build trees, and every finished stage on the Mac's bench volume but the newest"),
    Opt("--purge-rubble", "half-made workspaces nothing is making, a board's leftover instrumented slots, a store's "
        "bench/ tasks outside any workspace"),
    Opt("--purge-images", "container images no container uses ('wk new' pulls again)"),
    Opt("--rows", "print the rows, tab-separated, and remove nothing", sets=dict(readonly=True, destructive=False))))


def main(args, inv):
    flags = tuple(f for f in PURGES if args.flag(f))
    g = gc.Gc(ROOT, places.Registry(ROOT))
    if args.flag("--rows"):
        if flags:
            die("--rows prints what 'wk gc' would take, and takes no --purge flag")
        return g.print_rows()
    return g.run(flags)
