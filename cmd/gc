#!/usr/bin/env python3
#
# wk gc [--purge-mirror] [--purge-pmos] [--purge-builds] [--purge-rubble] [--purge-images] -- reclaim disk
# wk: where=host name=none group=sources opts --purge-mirror,--purge-pmos,--purge-builds,--purge-rubble,--purge-images,--rows destructive dryrun readonly --rows
#
# Lists what wk left on this machine, in the podman VM's store and on the machines
# it reaches, asks once, and removes what a plain run may: what loses no work --
# unreferenced snapshots, abandoned payload seeds, ccache and tart's image cache
# down to their budgets, dangling images, a killed selftest's workspaces. The
# rest is named with the flag or command that takes it. 'wk disk' shows the same rows.
#
#   --purge-mirror   the mirror and every base snapshot ('wk sync' refetches);
#                    refused while a workspace or guest exists
#   --purge-pmos     the pmbootstrap chroots on the pmos build hosts
#   --purge-builds   image build trees, and every finished stage on the Mac's
#                    benchmark volume but the newest (hours to rebuild)
#   --purge-rubble   half-made workspaces nothing is creating, and instrumented
#                    slots left on a board
#   --purge-images   container images no container uses ('wk new' pulls again)
#   --rows           print the rows, tab-separated, and remove nothing

import os
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import decl, gc, targets  # noqa: E402
from wk.act import Refused, die  # noqa: E402


def main(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    purge = {"--purge-mirror": args.flag("--purge-mirror"), "--purge-pmos": args.flag("--purge-pmos"),
             "--purge-builds": args.flag("--purge-builds"), "--purge-rubble": args.flag("--purge-rubble"),
             "--purge-images": args.flag("--purge-images")}
    flags = tuple(f for f, on in purge.items() if on)
    g = gc.Gc(ROOT, targets.Registry(ROOT))
    if args.flag("--rows"):
        if flags:
            die("--rows prints what 'wk gc' would take, and takes no --purge flag")
        return g.print_rows()
    return g.run(flags)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
