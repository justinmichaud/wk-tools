#!/usr/bin/env bash
#
# wk ab <pr-spec|branch|sha> [options] -- an interleaved A/B of a change on the fleet's boards
#
# wk: where=host name=none group=hosts needs ssh,python3 takes=1 destructive dryrun
# wk: opts --devices=,--release=,--builder=,--bits=,--base=,--build-on=,--plan=,--rounds=,--count=,--timeout=,--task=,--kill,--detach
# wk: flag --kill takes=1 opts=--kill
#
#   wk ab wpe:1725 --devices rpi3,rpi4          the A/B of WPEWebKit PR 1725 on
#                                                both boards: two WebKits built
#                                                against each board's image, both
#                                                deployed, then alternated
#   wk ab 1234 ...                               a WebKit/WebKit pull request
#   wk ab <sha> --release 2.52 ...               a bare commit as the patched side
#   wk ab <owner>:<branch> --release 2.52 ...    a fork's branch: its head in the
#                                                mirror is the patched side
#
#   --devices <a,b>       the fleet devices to measure on (required; a name
#                         from wk boot --list). A device with images of both
#                         widths says which as a suffix: rpi3-32,rpi4-32,
#                         rpi5-64 -- one command, mixed widths
#   --release <x.y>       which WebKit release's image: 2.38, 2.46, 2.52
#                         (default: read off the PR's base branch, wpe-2.38 ->
#                         2.38; required for a branch or a commit, which have none)
#   --builder <name>      buildroot or yocto, when the release has both
#   --bits <32|64>        the default word size for devices named without one
#   --base <sha|ref>      the unpatched side (default: the merge-base of the PR
#                         head and the image's own branch, CFG_BRANCH). A base
#                         more than one commit behind the head is refused,
#                         however it was chosen; --force crosses it
#   --build-on <a[,b]>    which machine each arm's lane is on, the base arm
#                         first. A machine builds one thing at a time, so two
#                         names are what makes the two arms build at once --
#                         one name, or none, is one machine building them in
#                         turn. Without it each lane is wherever it already is
#                         ('wk sysimage ls' says where)
#   --plan <name>         the benchmark (default speedometer3); repeatable
#   --rounds <n>          A/B alternations per plan (default 5)
#   --count <n>           run-benchmark iterations per run (default: the plan's)
#   --timeout <s>         seconds one iteration may take before the run is
#                         given up (default: the plan's own; Speedometer's 600
#                         is too short for an rpi3)
#   --detach              confirm, create the task, then hand the work to a
#                         process that outlives this one; follow it with
#                         wk status and wk bench report <task>
#   --task <name>         an existing task to work in -- what --detach hands
#                         its child; every other invocation is a new task
#   --kill                stop the A/B running under the task named in place of
#                         the spec (wk ab <task> --kill) and record it cancelled
#
# Every invocation is one *task*, named for the moment it was requested and
# what it measures (20260830T140000Z-wpe-pr1725, or <stamp>-<sha12> for a
# commit). The bench directory's <task>/ holds task.json, one directory per run
# under runs/, a log per board and the reports; the boards keep nothing.
# `wk bench ls` lists tasks, `wk bench report <task>` reports the rounds
# recorded so far and whether the task is complete.
#
# In order: resolve the two commits; build a WebKit slot for each against
# every device's image (wk sysimage webkit); deploy both slots to each board
# running that image (wk pi deploy) and alternate them there (wk pi bench
# --ab), every board at once; then report (wk bench report --html). A board
# not booted into the image is named with the commands that put it there;
# this command does not write cards.
#
# Every board opens with a warmup round -- a discarded leg per arm that reads
# the renderer, the width and the JIT off the live web process and profiles it.
# What it finds refuses the A/B; --force crosses, recorded.
#
# A/A: give the same commit as --base and the spec, and the two slots differ
# in nothing but their build-ids -- the noise floor of the lane.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/image.sh"
. "$WK_ROOT/image/profiles.sh"
. "$WK_ROOT/boot/machines.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/bench.sh"
. "$WK_ROOT/lib/detach.sh"
. "$WK_ROOT/lib/task.sh"
. "$WK_ROOT/image/pgo.sh"
. "$WK_ROOT/lib/sched.sh"

USAGE="usage: wk ab <pr-spec|branch|sha> --devices <a,b> [--release X.Y] [--builder B] [--bits N] [--base <sha>] [--build-on <a[,b]>] [--plan P]... [--rounds N] [--count N] [--timeout S] [--detach]; wk ab <task> --kill stops one; see wk ab -h"

_ab_pgid() { ps -o pgid= -p "$1" 2>/dev/null | tr -dc '0-9'; }

_ab_wait_gone() { # <pid> <seconds>
    local p="$1" left="$2"
    while kill -0 "$p" 2>/dev/null; do
        [ "$left" -gt 0 ] || return 1
        wk_sleep 1; left=$((left - 1))
    done
}

# The process group, not the pid: the plan's work is `wk sysimage` and `wk pi bench` children of the recorded process. WK_AB_KILL_WAIT is the seconds a TERM gets before the KILL.
ab_kill() { # <task>
    local t="$1" dir pid pgid bound="${WK_AB_KILL_WAIT:-20}"
    dir=$(task_find ab "$t")
    [ -n "$dir" ] || die "no A/B task '$t' was started from this machine.
    'wk bench ls' names the tasks and 'wk status' the one running."
    task_alive "$dir" || die "A/B task '$t' is not running: it is $(task_verdict "$dir").
    What it measured is recorded:  wk bench report $t"
    pid=$(task_field "$dir" pid)
    pgid=$(_ab_pgid "$pid")
    [ -n "$pgid" ] || die "A/B task '$t' recorded pid $pid, which the process table no longer has.
    Ask again: 'wk status' reads the record as died."
    [ "$pgid" != "$(_ab_pgid $$)" ] || die "A/B task '$t' runs in this command's own process group ($pgid),
    which the kill would take with it: run 'wk ab $t --kill' from another shell."
    info "stopping A/B task '$t' (pid $pid, process group $pgid)"
    kill -TERM "-$pgid" 2>/dev/null || true
    if ! _ab_wait_gone "$pid" "$bound"; then
        warn "no exit ${bound}s after SIGTERM; killing process group $pgid"
        kill -KILL "-$pgid" 2>/dev/null || true
        _ab_wait_gone "$pid" 5 \
            || die "pid $pid is still there after SIGKILL (ps -p $pid); the record stays running until it is gone."
    fi
    task_end "$dir" cancelled
    info "cancelled. The rounds it recorded stay in $(bench_task_dir "$t") ('wk bench report $t');
    re-running 'wk ab $t' picks up what is left."
}

STAMP=$(task_stamp)
ORIG_ARGS=("$@")

SPEC="${1:-}"; shift 2>/dev/null || true
[ -n "$SPEC" ] || die "$USAGE"
case "$SPEC" in -*) die "$USAGE" ;; esac

# `--opt=value` is `--opt value` to the loop below.
ARGS=()
for a in "$@"; do case "$a" in --*=*) ARGS+=("${a%%=*}" "${a#*=}") ;; *) ARGS+=("$a") ;; esac; done
set -- ${ARGS[@]+"${ARGS[@]}"}
DEVICES="" RELEASE="" BUILDER="" BITS="" BASE="" ROUNDS=5 COUNT="" TIMEOUT="" DETACH="" TASK="" KILL="" PLANS=()
BUILD_ON=""
while [ $# -gt 0 ]; do
    case "$1" in
        --devices) DEVICES="${2:-}"; shift ;;
        --release) RELEASE="${2:-}"; shift ;;
        --builder) BUILDER="${2:-}"; shift ;;
        --bits)    BITS="${2:-}"; shift ;;
        --base)    BASE="${2:-}"; shift ;;
        --build-on) BUILD_ON="${2:-}"; shift ;;
        --plan)    valid_name "${2:-}" || die "--plan '${2:-}' is not a plan name (letters, digits, '.', '_' and '-')"
                   PLANS+=("$2"); shift ;;
        --rounds)  ROUNDS="${2:-}"; shift ;;
        --count)   COUNT="${2:-}"; shift ;;
        --timeout) TIMEOUT="${2:-}"; shift ;;
        --task)    TASK="${2:-}"; shift ;;
        --kill)    KILL=1 ;;
        --detach)  DETACH=1 ;;
    esac
    shift
done
if [ -n "$KILL" ]; then
    ab_kill "$SPEC"
    exit 0
fi

[ -n "$DEVICES" ] || die "$USAGE; --devices names the boards (wk boot --list)"
case "$ROUNDS" in ''|*[!0-9]*) die "--rounds takes a number (got '$ROUNDS')" ;; esac
[ "$ROUNDS" -ge 1 ] || die "--rounds needs to be at least 1"
[ -z "$COUNT" ] || case "$COUNT" in *[!0-9]*) die "--count takes a number (got '$COUNT')" ;; esac
[ -z "$TIMEOUT" ] || case "$TIMEOUT" in *[!0-9]*) die "--timeout takes seconds (got '$TIMEOUT')" ;; esac
[ -z "$DETACH" ] || [ -z "${WK_DRY_RUN:-}" ] || die "--detach and --dry-run: a dry run has nothing to detach"
[ -z "$TASK" ] || bench_task_attach "$TASK"
[ "${#PLANS[@]}" -gt 0 ] || PLANS=(speedometer3)
case "$BITS" in ''|32|64) ;; *) die "--bits takes 32 or 64 (got '$BITS')" ;; esac

# The two arms, base first: the lane each builds in, and the machine that lane is on. Everything a lane holds is keyed on these -- the step's resource, its id, and the machine the step is reported to run on.
ARM_SLOT=(base "") ARM_ON=("" "")
ab_parse_build_on() {
    local i=0 m
    [ -n "$BUILD_ON" ] || return 0
    for m in $(printf '%s' "$BUILD_ON" | tr ',' ' '); do
        [ "$i" -lt 2 ] || die "--build-on names the machine each of the two arms builds on, base
    first, so it takes one name or two (got '$BUILD_ON')."
        case " $(target_known | tr '\n' ' ') $(wk_machine_name) " in
            *" $m "*) ;;
            *) die "--build-on names a machine this checkout knows (targets/hosts/<name>.conf)
    or this one, and '$m' is neither.$(_target_known_line)" ;;
        esac
        ARM_ON[$i]="$m"; i=$((i + 1))
    done
    [ "$i" -ne 1 ] || ARM_ON[1]="${ARM_ON[0]}"   # one name is both arms in that machine's lane
}
ab_parse_build_on

ab_lane_spec() { # <profile> <arm index> -- the <profile>[@<machine>] the step's own command names
    if [ -n "${ARM_ON[$2]}" ]; then printf '%s@%s' "$1" "${ARM_ON[$2]}"; else printf '%s' "$1"; fi
}

ab_lane_machine() { # <device index> <arm index> -- the machine that arm's lane is on
    image_lane_machine "$(_lane_at "$1" "$2")" "${ARM_ON[$2]}"
}

# Which of the three the spec is settles before the mirror is required, so a malformed spec is refused as the argument error it is.
HEAD_SHA="" HEAD_DESC="" PR_BASE_BRANCH="" PR_REMOTE_NAME="" SPEC_SHA=""
if [ "${#SPEC}" -eq 40 ] && [ -z "${SPEC//[0-9a-f]/}" ]; then
    SPEC_SHA="$SPEC"
else
    pr_parse_spec "$SPEC"
fi
[ -n "$RELEASE" ] || [ "${PR_KIND:-}" = pull ] \
    || die "--release is required for a commit or a branch: only a pull request
    has a base branch saying which image it is for ('wk sysimage --list' has
    every release; --release 2.52)."

MIRROR=$(wk_mirror)
[ -d "$MIRROR" ] || die "no mirror at $MIRROR; 'wk sync' makes one. Both commits are resolved in it."
mgit() { git -C "$MIRROR" "$@"; }

# A fork's branch is a head like a pull request's: found in whichever of that fork's repositories carries it, fetched into the mirror, resolved there.
ab_branch_head() { # <user> <branch> -- `<repo> <url> <sha>` for the one that has it
    local user="$1" branch="$2" found n
    found=$(pr_branch_repo "$user" "$branch")
    n=$(printf '%s\n' "$found" | grep -c . || true)
    case "$n" in
        1) printf '%s\n' "$found" ;;
        0) die "no branch '$branch' under '$user'.
    Checked: $(pr_branch_repo_urls "$user" | tr '\n' ' ')
    A pull request is named as wpe:<n> or <n>, a commit as its 40-digit sha." ;;
        *) die "'$branch' exists in more than one of $user's repositories:
$(printf '%s\n' "$found" | sed 's/^/    /')
    They are different projects; pass the head sha of the one you mean." ;;
    esac
}

ab_branch_fetch() { # <user> <branch> -- sets HEAD_SHA and HEAD_DESC from the mirror
    local user="$1" branch="$2" repo url ref head
    # Into a variable of its own: a die inside a command substitution kills only that subshell.
    head=$(ab_branch_head "$user" "$branch") || return $?
    set -- $head
    repo="$1"; url="$2"
    ref="refs/remotes/pr/$(wk_pr_refname "$user" "$repo" "$branch")"
    mirror_fetch_pr "$url" "$branch" "$(wk_pr_refname "$user" "$repo" "$branch")" \
        || die "could not fetch '$branch' from $url into the mirror"
    HEAD_SHA=$(mgit rev-parse --verify --quiet "$ref^{commit}") \
        || die "the mirror has no head for '$branch' after fetching it from $url"
    HEAD_DESC="$user:$branch (branch of $user/$repo)"
}

if [ -n "$SPEC_SHA" ]; then
    mgit cat-file -e "$SPEC_SHA^{commit}" 2>/dev/null \
        || die "the mirror does not have commit $SPEC_SHA ('wk sync' fetches the upstream branches)"
    HEAD_SHA="$SPEC_SHA"; HEAD_DESC="commit"
elif [ "$PR_KIND" = user ]; then
    ab_branch_fetch "$PR_USER" "$PR_BRANCH"
else
    PR_REMOTE_NAME="$PR_REMOTE"
    mirror_fetch_pull "$PR_REMOTE" "$PR_N" \
        || die "could not fetch pull request $PR_N from '$PR_REMOTE' into the mirror"
    HEAD_SHA=$(mgit rev-parse --verify --quiet "refs/remotes/pr/$(wk_pull_refname "$PR_REMOTE" "$PR_N")^{commit}") \
        || die "the mirror has no head for pull request $PR_N after fetching it"
    HEAD_DESC="$SPEC (pull request $PR_N on $PR_REMOTE)"
fi

# The release names the image: wpe-2.38 -> 2.38, webkitglib/2.52 -> 2.52, off the base branch only a pull request has.
if [ -z "$RELEASE" ]; then
    url=$(wk_remotes | awk -v r="$PR_REMOTE_NAME" '$1 == r {print $2; exit}')
    repo=$(printf '%s' "$url" | sed -E 's#\.git$##; s#https://github.com/##')
    gh_authenticated || die "reading the pull request's base branch needs gh logged in (gh auth login),
    or say the release yourself: --release 2.38"
    PR_BASE_BRANCH=$(gh pr view "$PR_N" --repo "$repo" --json baseRefName --jq .baseRefName 2>&1) \
        || die "could not read pull request $PR_N's base branch from $repo: $PR_BASE_BRANCH
    Say the release yourself: --release 2.38"
    RELEASE=$(printf '%s' "$PR_BASE_BRANCH" | sed -nE 's#^(wpe-|webkitglib/)([0-9]+\.[0-9]+)$#\2#p')
    [ -n "$RELEASE" ] || die "pull request $PR_N targets '$PR_BASE_BRANCH', which names no release.
    Say which image to measure on: --release 2.38 (wk sysimage --list)"
fi

# One profile per device, matched as <project>-<release>-<builder>-<device>-<bits>.
declare -a DEV PROFILE MACHINE_OK
ab_profile_for() { # <device> <bits or empty> -- prints the one profile, or dies naming the choices
    local dev="$1" bits="$2" c matches="" pattern
    # Unquoted on purpose: an empty --builder or width is a wildcard here.
    pattern="*-$RELEASE-${BUILDER:-*}-$dev-${bits:-*}"
    for c in $(image_config_names); do
        match_any "$c" "$pattern" && matches="$matches $c"
    done
    set -- $matches
    case $# in
        1) printf '%s' "$1" ;;
        0) die "no image configuration for $dev at release $RELEASE${BUILDER:+ ($BUILDER)}${bits:+, $bits-bit}.
    'wk sysimage --list' has every configuration this checkout defines." ;;
        *) die "$dev has more than one image at release $RELEASE:
$(printf '    %s\n' "$@")
    Say which: --devices $dev-32 or $dev-64 (and --builder when both builders have one)." ;;
    esac
}
i=0
for tok in $(printf '%s' "$DEVICES" | tr ',' ' '); do
    dev="$tok"; bits="$BITS"
    case "$tok" in
        *-32) dev="${tok%-32}"; bits=32 ;;
        *-64) dev="${tok%-64}"; bits=64 ;;
    esac
    machine_load "$dev" || die "no such fleet device '$dev' (wk boot --list)"
    DEV[$i]="$dev"; PROFILE[$i]=$(ab_profile_for "$dev" "$bits")
    image_profile_load "${PROFILE[$i]}" >/dev/null 2>&1
    [ -z "${CFG_NEEDS:-}" ] || die "${PROFILE[$i]} cannot be built yet: $CFG_NEEDS
    ($(image_config_file "${PROFILE[$i]}"))"
    i=$((i + 1))
done
NDEV=$i

# Every profile at one release shares the branch it tracks; the rest are checked against the first.
image_profile_load "${PROFILE[0]}" >/dev/null 2>&1 || die "profile ${PROFILE[0]} would not load"
CFG_BRANCH0="$CFG_BRANCH"; CFG_REMOTE0="$CFG_REMOTE"; CFG_PROJECT0="$CFG_PROJECT"
for ((i = 1; i < NDEV; i++)); do
    image_profile_load "${PROFILE[$i]}" >/dev/null 2>&1 || die "profile ${PROFILE[$i]} would not load"
    [ "$CFG_BRANCH" = "$CFG_BRANCH0" ] && [ "$CFG_REMOTE" = "$CFG_REMOTE0" ] \
        || die "${PROFILE[$i]} tracks $CFG_REMOTE/$CFG_BRANCH while ${PROFILE[0]} tracks $CFG_REMOTE0/$CFG_BRANCH0;
    one A/B measures one branch. Run them as two."
done
[ -n "$CFG_BRANCH0" ] && [ -n "$CFG_REMOTE0" ] \
    || die "${PROFILE[0]} declares no CFG_BRANCH/CFG_REMOTE, so there is no branch to take a base from"

# Refreshed before the merge-base is taken: a stale mirror would pick an older
# base than the PR was made against.
BRANCH_URL=$(wk_remotes | awk -v r="$CFG_REMOTE0" '$1 == r {print $2; exit}')
[ -n "$BRANCH_URL" ] || die "no upstream remote '$CFG_REMOTE0' (lib/store.sh wk_remotes) to fetch $CFG_BRANCH0 from"
_mirror_fetch_into "$BRANCH_URL" "refs/heads/$CFG_BRANCH0" "refs/remotes/$CFG_REMOTE0/$CFG_BRANCH0" \
    || die "could not refresh $CFG_REMOTE0/$CFG_BRANCH0 in the mirror"
BRANCH_SHA=$(mgit rev-parse --verify --quiet "refs/remotes/$CFG_REMOTE0/$CFG_BRANCH0^{commit}") \
    || die "the mirror has no $CFG_REMOTE0/$CFG_BRANCH0 after fetching it"
BASE_HOW=""
if [ -n "$BASE" ]; then
    BASE_SHA=$(mgit rev-parse --verify --quiet "$BASE^{commit}") \
        || die "--base '$BASE' is not a commit the mirror knows"
    BASE_HOW="given"
else
    BASE_SHA=$(mgit merge-base "$HEAD_SHA" "$BRANCH_SHA") \
        || die "$HEAD_SHA and $CFG_REMOTE0/$CFG_BRANCH0 share no history; is this PR against that branch?
    Say the base yourself: --base <sha>"
    BASE_HOW="merge-base of the head and $CFG_REMOTE0/$CFG_BRANCH0 (guessed)"
fi
AHEAD=$(mgit rev-list --count "$BASE_SHA..$HEAD_SHA")
BEHIND=$(mgit rev-list --count "$HEAD_SHA..$BRANCH_SHA")
PR_SLOT="pr"
[ -z "${PR_N:-}" ] || PR_SLOT="pr$PR_N"
ARM_SLOT[1]="$PR_SLOT"
if [ -n "$TASK" ]; then
    :
elif [ -n "${PR_N:-}" ]; then
    TASK="$STAMP-$PR_REMOTE_NAME-pr$PR_N"
else
    TASK="$STAMP-$(printf '%s' "$HEAD_SHA" | cut -c1-12)"
fi
TASK_DIR=$(bench_task_dir "$TASK")

ab_holds() { # <lane spec> <lane> [the rest of `holds`'s options] -- true when that lane already holds it, asked on the machine holding it: a slot built on moose reads as missing here, and building it again is the bug that answer causes
    local spec="$1" lane="$2"; shift 2
    [ "$("$WK_ROOT/wk" sysimage holds "$spec" --workspace "$lane" ${@+"$@"} 2>/dev/null)" = yes ]
}
_ab_build_note() { # <profile> <device>
    ( image_profile_load "$1" >/dev/null 2>&1
      if image_pgo_wanted; then
          printf 'profile-guided: each slot is instrument, collect on %s, rebuild --' "$2"
          printf ' so %s has to be in this image before the builds, not just before the deploys' "$2"
      else
          printf 'plain: %s predates upstream cmake PGO support' "${CFG_RELEASE:-this release}"
      fi )
}

# A function, not a `$(case ...)` inside the string: bash 3.2 does not parse one there.
_board_mode_note() { # <i>
    case "${BOARD_MODE[$1]}" in
        "bench ${PROFILE[$1]}-"*) echo "  (slots there: ${BOARD_SLOTS[$1]:-none})" ;;
        *)                        echo "  <-- not booted into ${PROFILE[$1]}" ;;
    esac
}
# One lane per arm per device: which workspace it is, and the spec the steps name it by.
declare -a BOARD_MODE BOARD_SLOTS LANE LANE_SPEC
_lane_at() { printf '%s' "${LANE[$(( $1 * 2 + $2 ))]}"; }        # <device index> <arm index>
_lane_spec_at() { printf '%s' "${LANE_SPEC[$(( $1 * 2 + $2 ))]}"; }
for ((i = 0; i < NDEV; i++)); do
    image_profile_load "${PROFILE[$i]}" >/dev/null 2>&1
    case "${IMG_BUILDER:-}" in buildroot|yocto) ;; *) die "${PROFILE[$i]} is built by ${IMG_BUILDER:-nothing}, which has no WebKit slots" ;; esac
    for ((a = 0; a < 2; a++)); do
        LANE[$((i * 2 + a))]=$(image_lane_ws "${PROFILE[$i]}")
        LANE_SPEC[$((i * 2 + a))]=$(ab_lane_spec "${PROFILE[$i]}" "$a")
    done
    machine_load "${DEV[$i]}"
    b_probe >/dev/null 2>&1 || true
    BOARD_MODE[$i]="${MODE:-unreachable}"
    BOARD_SLOTS[$i]=""
    case "${MODE:-}" in
        "bench ${PROFILE[$i]}-"*)
            # `; true`: a board with no slots ends the loop false, which set -e would take fatally.
            BOARD_SLOTS[$i]=$(r_ssh "for s in /var/wk/slots/*/slot.json; do [ -f \"\$s\" ] && basename \"\$(dirname \"\$s\")\"; done 2>/dev/null; true" 2>/dev/null | tr -d '\r' | tr '\n' ' ') ;;
    esac
done

sha12() { printf '%s' "$1" | cut -c1-12; }
subject() { mgit log -1 --format=%s "$1" 2>/dev/null | cut -c1-70; }

log "A/B of $HEAD_DESC on ${DEVICES//,/, }"
log ""
log "  patched   $(sha12 "$HEAD_SHA")  $(subject "$HEAD_SHA")"
log "  base      $(sha12 "$BASE_SHA")  $(subject "$BASE_SHA")"
log "            $BASE_HOW; the patched side is $AHEAD commit(s) ahead of it"
[ "$BEHIND" -eq 0 ] || log "            $CFG_REMOTE0/$CFG_BRANCH0 has moved $BEHIND commit(s) past the base since"
log "  release   $RELEASE (${CFG_PROJECT0:-WebKit} $CFG_REMOTE0/$CFG_BRANCH0)"
log "  plans     ${PLANS[*]}"
log "  rounds    $ROUNDS per plan, interleaved A B A B ...${COUNT:+; --count $COUNT iterations per run}"
log "  slots     base, $PR_SLOT -- one image per board, two WebKits beside it"
log "  task      $TASK"
log "            $TASK_DIR$([ -n "${WK_DRY_RUN:-}" ] && [ ! -d "$TASK_DIR" ] && echo '  (not created: dry run)')"
log ""
for ((i = 0; i < NDEV; i++)); do   # what is already built is the graph's answer, below, so it is not read a second time here
    log "  ${DEV[$i]}: image ${PROFILE[$i]}"
    log "        $(printf 'lane %-7s' base) $(_lane_at "$i" 0) on $(ab_lane_machine "$i" 0)"
    log "        $(printf 'lane %-7s' "$PR_SLOT") $(_lane_at "$i" 1) on $(ab_lane_machine "$i" 1)"
    log "        board      ${BOARD_MODE[$i]}$(_board_mode_note "$i")"
    log "        build      $(_ab_build_note "${PROFILE[$i]}" "${DEV[$i]}")"
done
log ""

[ "$AHEAD" -le 1 ] || barrier \
    "the patched side is $AHEAD commits ahead of the base, so the two arms differ
    by more than the change under measurement and no number says which commit
    moved it. Name the commit's own parent: --base <sha>."

log "the plan as a graph -- a step runs when its needs are done and what it holds is free:"
log ""
SCHED_FILE=$(mktemp "${TMPDIR:-/tmp}/wk-ab-steps.XXXXXX")
_ab_steps_gone() { rm -f "$SCHED_FILE"; return 0; }
wk_atexit _ab_steps_gone
sched_begin "$SCHED_FILE" "$WK_ROOT/image/pgo.sh"

# The benchmark and the report run on the machine the A/B was typed on, because that is where the task's own directory is; every lane step runs on the machine holding that lane, and says so.
RUNS_ON=$(wk_machine_name)
BENCH_ARGS="--rounds $ROUNDS${COUNT:+ --count $COUNT}${TIMEOUT:+ --timeout $TIMEOUT} --task $TASK"
BENCH_IDS=""
IMAGED=" "   # the lanes whose image step is already declared: two arms sharing a lane share its image and toolchain, two machines' lanes need one each
for ((i = 0; i < NDEV; i++)); do
    p="${PROFILE[$i]}"; d="${DEV[$i]}"
    # A profile-guided slot is not one build but the cycle's phases, declared by the lane that owns them (image/pgo.sh).
    pgo=""
    if ( image_profile_load "$p" >/dev/null 2>&1 && image_pgo_wanted ); then pgo=1; fi
    for ((a = 0; a < 2; a++)); do
        slot="${ARM_SLOT[$a]}"
        sha="$BASE_SHA"; [ "$a" -eq 0 ] || sha="$HEAD_SHA"
        lane=$(_lane_at "$i" "$a"); spec=$(_lane_spec_at "$i" "$a")
        on=$(ab_lane_machine "$i" "$a"); res=$(image_build_resource "$on")
        case "$IMAGED" in
            *" $lane@$on "*) ;;
            *) IMAGED="$IMAGED$lane@$on "
               sched_step "image:$lane@$on" "$on" "" "$res" \
                   "$(image_holds_predicate "$spec" "$lane")" \
                   "wk sysimage build $spec --workspace $lane" ;;
        esac
        if [ -n "$pgo" ]; then
            image_pgo_steps "$spec" "$lane" "$sha" "$slot" "$d" "image:$lane@$on"
        else
            sched_step "slot:$lane:$slot" "$on" "image:$lane@$on" "$res" \
                "$(image_holds_predicate "$spec" "$lane" --slot "$slot" --commit "$sha")" \
                "wk sysimage webkit $spec --workspace $lane --commit $sha --slot $slot"
        fi
        sched_step "deploy:$d:$slot" "$on" "slot:$lane:$slot" "device:$d" "" \
            "wk pi deploy $spec $d --workspace $lane --slot $slot"
    done
    for plan in "${PLANS[@]}"; do
        sched_step "bench:$d:$plan" "$RUNS_ON" "deploy:$d:base,deploy:$d:$PR_SLOT" "device:$d" "" \
            "wk pi bench $d $plan --ab base,$PR_SLOT $BENCH_ARGS"
        BENCH_IDS="${BENCH_IDS:+$BENCH_IDS,}bench:$d:$plan"
    done
done
sched_step report "$RUNS_ON" "$BENCH_IDS" "" "" "wk bench report $TASK --html --text"
sched_plan
for ((i = 0; i < NDEV; i++)); do
    case "${BOARD_MODE[$i]}" in
        "bench ${PROFILE[$i]}-"*) ;;
        *) log ""
           log "  ${DEV[$i]} is not booted into ${PROFILE[$i]} -- by hand, before the steps above:"
           log "    wk sysimage write --from ${PROFILE[$i]} --disk ${DEV[$i]}:<device>"
           log "    wk boot ${DEV[$i]}" ;;
    esac
done
log ""
log "each 'wk pi bench --ab' checks every result against the slot's build-id in"
log "the running web process; the report pairs the rounds and writes one"
log "self-contained html file per board and plan into the task."

# The flat plan a task record holds: the steps in the order the scheduler reaches them, which --on-start steps through below.
PLAN=()
while IFS= read -r line; do [ -z "$line" ] || PLAN+=("$line"); done <<EOF
$(sched_steps)
EOF

if [ -n "${WK_DRY_RUN:-}" ]; then
    log ""
    log "dry run -- nothing was built or run."
    exit 0
fi

log ""
warn "this replaces slots 'base' and '$PR_SLOT' on the boards named, and moves each"
warn "image workspace's checkout to the commits above."
confirm "run these ${#PLAN[@]} step(s), replacing those slots?" || die "not run"

# Created, and its lock taken, before any work; a given --task is a --detach
# parent's task, whose lock this process takes over.
if [ -d "$TASK_DIR" ]; then
    hold_lock "bench-task-$TASK" -w 30 || die "task $TASK is held by another process"
else
    task_fields=(subject.kind="$([ -n "${PR_N:-}" ] && echo pull || echo commit)" subject.spec="$SPEC"
                 subject.remote="$PR_REMOTE_NAME" subject.number="${PR_N:-}"
                 subject.head="$HEAD_SHA" subject.base="$BASE_SHA" subject.base_how="$BASE_HOW"
                 subject.release="$RELEASE" subject.branch="$CFG_REMOTE0/$CFG_BRANCH0"
                 plans="$(IFS=,; printf '%s' "${PLANS[*]}")" rounds="$ROUNDS" count="$COUNT" timeout="$TIMEOUT"
                 slots="base,$PR_SLOT" argv="wk ab $SPEC ${ORIG_ARGS[*]:1}")
    devs=""
    for ((i = 0; i < NDEV; i++)); do devs="${devs:+$devs,}${DEV[$i]}=${PROFILE[$i]}"; done
    cmd_args=()
    for step in "${PLAN[@]}"; do cmd_args+=(--command "$step"); done
    bench_task_new "$TASK" "${task_fields[@]}" devices="$devs" "${cmd_args[@]}"
fi
info "task $TASK  ($TASK_DIR)"

# The same command minus --detach, in a process nothing this end can kill.
if [ -n "$DETACH" ]; then
    det=()
    for a in "${ORIG_ARGS[@]:1}"; do [ "$a" = --detach ] || det+=("$a"); done
    pid=$(detach_run "$TASK_DIR/ab.log" -- "$WK_ROOT/wk" ab "$SPEC" "${det[@]}" --yes --task "$TASK")
    info "detached as pid $pid -- this end can go away"
    log "  follow:  tail -f $TASK_DIR/ab.log"
    log "  state:   wk status;  wk bench ls"
    log "  report:  wk bench report $TASK   (partial while it runs)"
    exit 0
fi

AB_TASK=$(task_begin ab here "$TASK" "wk ab $TASK --kill" \
    "$TASK_DIR/ab.log" "${PLAN[@]}")
task_set "$AB_TASK" subject \
    "$HEAD_DESC on ${DEVICES//,/, }: $(sha12 "$BASE_SHA") vs $(sha12 "$HEAD_SHA"), $RELEASE"
_ab_end() { task_end "$AB_TASK" "${WK_EXIT_STATUS:-0}"; }
wk_atexit _ab_end

rc=0
sched_run --log-dir "$TASK_DIR" --on-event "task_step_event $(sh_quote "$AB_TASK") {step} {event}" || rc=$?
[ "$rc" -eq 0 ] || die "A/B incomplete: the steps above say which did not run, and each one's log
    is beside its own resource in $TASK_DIR. Every round that finished is
    recorded ('wk bench ls'; 'wk bench report $TASK'), and re-running
    wk ab $SPEC ... takes up what is left."
for ((i = 0; i < NDEV; i++)); do
    ab_holds "$(_lane_spec_at "$i" 0)" "$(_lane_at "$i" 0)" --slot base --commit "$BASE_SHA" \
        && ab_holds "$(_lane_spec_at "$i" 1)" "$(_lane_at "$i" 1)" --slot "$PR_SLOT" --commit "$HEAD_SHA" \
        || die "${PROFILE[$i]} does not hold both slots after the builds (wk sysimage ls),
    so what ran was not the pair this A/B names. Do not take the report as it stands."
done
info "A/B complete: $TASK_DIR  (wk bench ls; wk bench report $TASK)"
