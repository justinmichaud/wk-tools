#!/usr/bin/env bash
#
# wk boot <machine> -- put a machine into its image for one boot, and take it
# back out again.
#
#   wk boot <machine> [--image <id>] [--dry-run]   arm the one-shot and reboot
#   wk boot <machine> --status                     what role it is in, and why
#   wk boot <machine> --keep                       cancel the self-return watchdog
#   wk boot <machine> --back                       reboot back to the normal role
#   wk boot <machine> --disarm                     cancel an arming not yet spent
#   wk boot <machine> --diag                       the image's own account of
#                                                  its last boot, read offline
#   wk boot --list                                 the machines that have drivers
#
# This is a role transition, not a reboot. A machine that is armed is about to
# stop being a workstation, and anything that acts on it in the meantime is
# acting on a box that is about to reboot out from under it -- so arming leaves
# a record of intent, and this command is where that record is read back
# against the evidence (docs/HANDOFF-workspace-state.md, "wk status walks the
# fleet"; docs/HANDOFF-netboot.md, "wk boot is a role transition").
#
# The record is kept on the machine it describes, next to the boot mechanism it
# describes, and nowhere else. A copy on the driving workstation would be a
# second record of one fact -- forbidden even while the two still agree -- and
# it would be the copy that goes stale, because the transition happens over
# there.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/image.sh"
. "$WK_ROOT/image/profiles.sh"
. "$WK_ROOT/boot/machines.sh"
. "$WK_ROOT/lib/target.sh"

# Both of these act on physical machines: a boot device, a firmware register, a
# disk image measured in gigabytes. None of that exists in a workspace, and the
# sandbox cannot reach the machine that has it. Refused here rather than in
# `wk`'s is_host_only list only because that file belongs to the other lane
# this week -- it belongs there, next to the commands it is the same rule as.
if in_workspace; then
    die "'wk $(basename "$0")' acts on a host and its hardware, and this is
    workspace '$(wk_self)'. Run it on the workstation instead."
fi

usage() {
    cat >&2 <<'EOF'
usage: wk boot <machine> [options]

  (no options)        arm the one-shot and reboot into the image
  --image <id>        which image (default: the newest for this machine)
  --status            the machine's role, its announced transition, and the
                      evidence for both
  --diag              the image's own account of its last boot, read off its
                      boot device -- works when the image never appeared
  --keep              claim a running image: cancel its self-return watchdog
  --back              reboot back to the normal role now
  --disarm            cancel an arming that has not been spent yet
  --dry-run           resolve everything, change nothing
  --list              machines with a boot driver

machines:
EOF
    machine_list | sed 's/^/  /' >&2
    exit 2
}

[ "${1:-}" = --list ] && { machine_list; exit 0; }

MACHINE="${1:-}"; shift 2>/dev/null || true
[ -n "$MACHINE" ] || usage
case "$MACHINE" in -*) usage ;; esac

ACTION=arm; IMAGE=""; DRY=""
while [ $# -gt 0 ]; do
    case "$1" in
        --status)  ACTION=status ;;
        --diag)    ACTION=diag ;;
        --keep)    ACTION=keep ;;
        --back)    ACTION=back ;;
        --disarm)  ACTION=disarm ;;
        --dry-run) DRY=1 ;;
        --image)   IMAGE="${2:-}"; shift ;;
        *) die "unknown option: $1" ;;
    esac
    shift
done

machine_load "$MACHINE" || die "unknown machine '$MACHINE' (wk boot --list)"
load_driver "$MACH_DRIVER"

# --- reading the transition --------------------------------------------------
#
# Three sources, in decreasing authority: what the machine says it is (the
# identity marker, which only the image has), when it last booted, and the
# record of intent. The record is never trusted on its own -- a record whose
# arming predates the machine's current boot has been *spent*, and that is a
# derived fact, not a stored one.
read_state() {
    b_probe
    BOOTED=$(b_booted_at)
    BOOT_ID=$(b_boot_id)
    RECORD=$(record_read)
    ARMED_AT=$(printf '%s\n' "$RECORD" | sed -n 's/^armed_at=//p')
    ARMED_IMG=$(printf '%s\n' "$RECORD" | sed -n 's/^image=//p')
    ARMED_BY=$(printf '%s\n' "$RECORD" | sed -n 's/^armed_by=//p')
    ARMED_BOOT=$(printf '%s\n' "$RECORD" | sed -n 's/^armed_boot_id=//p')

    # Spent: the machine has booted since the arming, so the one-shot is gone
    # whichever way it landed. Decided by boot id, not by clocks -- the first
    # version of this compared the driving host's UTC stamp against the
    # machine's boot time and called a plainly-spent arming "armed", because
    # the two ends were six hours apart in a string nobody had converted.
    SPENT=no
    if [ -n "$ARMED_BOOT" ] && [ -n "$BOOT_ID" ]; then
        if [ "$ARMED_BOOT" != "$BOOT_ID" ]; then SPENT=yes; fi
    elif [ -n "$ARMED_AT" ] && [ -n "$BOOTED" ]; then
        # A record from before boot ids were written. Both stamps carry an
        # explicit Z, so this comparison is at least unambiguous -- but it is
        # the fallback, not the mechanism.
        local a b
        a=$(date -u -d "$ARMED_AT" +%s 2>/dev/null || echo 0)
        b=$(date -u -d "$BOOTED" +%s 2>/dev/null || echo 0)
        if [ "$b" -gt "$a" ]; then SPENT=yes; fi
    fi
    # Explicit, and not decoration: a function whose last statement is a false
    # test returns non-zero, and every caller here runs it as a plain command
    # under `set -e`. That is the trap docs/HANDOFF-linux.md records, and it
    # would fire exactly when nothing was armed -- the common case.
    return 0
}

cmd_status() {
    read_state
    case "$ROLE" in
        unreachable)
            log "$MACHINE: unreachable over ssh in its normal role"
            if [ -n "$ARMED_IMG" ]; then
                log "  the record says it was armed for image $ARMED_IMG"
            else
                log "  no arming record could be read either, so this is a plain outage"
                log "  or the machine is in an image that answers somewhere else."
            fi
            return 3 ;;
        image*)
            log "$MACHINE: $ROLE (booted $BOOTED)"
            log "  a plain reboot returns it to its normal role: wk boot $MACHINE --back"
            return 0 ;;
    esac

    log "$MACHINE: workstation (booted $BOOTED)"
    b_evidence | sed 's/^/  /'

    [ -n "$ARMED_IMG" ] || return 0

    if [ "$SPENT" = yes ]; then
        # Not a desync: the transition happened and the machine came back, which
        # is the mechanism working. The record is simply spent, and saying so is
        # more useful than either clearing it silently or crying wolf.
        log "  a spent arming record remains (image $ARMED_IMG, armed by $ARMED_BY at $ARMED_AT)"
        log "  it was consumed by the boot at $BOOTED; clear it with: wk boot $MACHINE --disarm"
        return 0
    fi

    warn "$MACHINE is ARMED to reboot into image $ARMED_IMG (by $ARMED_BY at $ARMED_AT)"
    log  "  it is still in its normal role, so the one-shot has not been spent."
    log  "  do not start work on it: the next reboot leaves this role."
    log  "  cancel with: wk boot $MACHINE --disarm"
    return 2
}

cmd_diag() {
    b_probe
    case "$ROLE" in
        workstation) ;;
        *) die "$MACHINE is in '$ROLE'. The diagnostics dump is read off the
    image's boot device from the *other* role -- ask the image directly, or
    'wk boot $MACHINE --back' first." ;;
    esac
    b_diag
}

cmd_keep() {
    read_state
    case "$ROLE" in
        image*) ;;
        *) die "$MACHINE is not in an image right now ($ROLE), so there is no
    watchdog to cancel." ;;
    esac
    [ -n "$DRY" ] && { log "would create /run/wk-keep-running on $MACHINE"; return 0; }
    r_ssh 'sudo touch /run/wk-keep-running'
    info "$MACHINE claimed: the self-return watchdog will not reboot it"
    warn "nothing will hand this machine back on its own now -- 'wk boot $MACHINE --back' does"
}

cmd_back() {
    read_state
    case "$ROLE" in
        unreachable) die "$MACHINE is not answering, so nothing here can reboot it.
    The one-shot is spent by any boot, so a power cycle returns it." ;;
    esac
    [ -n "$DRY" ] && { log "would reboot $MACHINE back to its normal role and clear the record"; return 0; }
    # Clear the record first: it lives on the normal role's root, which is
    # exactly where the machine is going, and clearing it after the reboot
    # would mean racing the boot.
    case "$ROLE" in workstation) record_clear ;; esac
    b_reboot
    info "$MACHINE is rebooting; the one-shot is spent, so it lands in its normal role"
}

cmd_disarm() {
    read_state
    [ -n "$ARMED_IMG" ] || { log "$MACHINE has no arming record"; return 0; }
    if [ -n "$DRY" ]; then
        log "would re-arm $MACHINE with its normal boot order and clear the record"
        return 0
    fi
    # Re-arming with the EEPROM's own order is how a one-shot is cancelled:
    # there is no "clear" tag, and the register is write-only, so the way to
    # make the next boot normal is to say so.
    [ "$SPENT" = yes ] || b_arm "$BOOT_ORDER_NORMAL"
    record_clear
    info "$MACHINE disarmed; its next reboot is a normal one"
}

cmd_arm() {
    read_state

    case "$ROLE" in
        unreachable)
            if [ "${BOOT_ARMING:-one-shot}" = server ]; then
                # Not fatal here, unlike a one-shot: the server holds the
                # arming, so a board that is off or wedged is still armed --
                # it boots the image whenever it next powers on.
                warn "$MACHINE is not answering, but its arming lives on the server:"
                warn "  power it on and it boots what this machine is serving."
            else
                die "$MACHINE is not reachable over ssh in its normal role.
    Arming is an ssh command, so there is nothing to arm from here."
            fi ;;
        image*) die "$MACHINE is already in $ROLE.
    'wk boot $MACHINE --back' returns it first." ;;
    esac

    [ -n "$IMAGE" ] || IMAGE=$(image_latest "$MACH_PROFILE") \
        || die "no image built for $MACHINE yet -- 'wk image build $MACH_PROFILE'"
    image_complete "$IMAGE" || die "no such image: $IMAGE"

    # A one-shot boots a local device, so the image has to actually be on it
    # or the boot falls through to the normal role and the whole thing looks
    # like a firmware failure. Asked by name rather than by hash -- see
    # b_device_image() for why bit comparison is the wrong question once an
    # image has booted once.
    #
    # A server-armed machine has no local image to check: its driver's b_arm
    # checks the server instead, which is where its arming actually lives.
    if [ "${BOOT_ARMING:-one-shot}" = one-shot ]; then
        local on_device
        on_device=$(b_device_image)
        [ "$on_device" = "$IMAGE" ] || die "$MACH_DEVICE on $MACHINE holds ${on_device:-no wk image}, not $IMAGE.
    Write it first:  wk image flash $MACHINE --image $IMAGE"
    fi

    if [ -n "$DRY" ]; then
        cat >&2 <<EOF
would arm $MACHINE
  image        $IMAGE (verified present on $MACH_DEVICE)
  boot order   $BOOT_ORDER_IMAGE (one-shot; the normal order $BOOT_ORDER_NORMAL is untouched)
  record       $MACH_RECORD on $MACHINE
  then         reboot, and the image's watchdog returns it in
               $(manifest_get "$IMAGE" watchdog)s unless claimed
EOF
        log "dry run -- nothing was armed."
        return 0
    fi

    info "arming $MACHINE for image $IMAGE"
    if [ "${BOOT_ARMING:-one-shot}" = one-shot ]; then
        # One record of intent, on the machine, next to the boot mechanism.
        record_write "$IMAGE" "$(manifest_get "$IMAGE" profile)" "$MACH_DEVICE" "$BOOT_ORDER_IMAGE"
        b_arm "$BOOT_ORDER_IMAGE"
    else
        # No record is written here, and that is rule 1 rather than an
        # omission: a server-armed machine's intent *is* the server's content,
        # which the serving host already records once in serve.status. A copy
        # on the client would be a second record of one fact -- and the one
        # that goes stale, because the transition happens at the server.
        b_arm
    fi
    b_reboot

    info "$MACHINE is rebooting into $IMAGE"
    [ "${BOOT_ARMING:-one-shot}" = server ] && b_disarm_note
    log  "  it returns by itself in $(manifest_get "$IMAGE" watchdog)s unless claimed:"
    log  "    wk boot $MACHINE --keep     claim it"
    log  "    wk boot $MACHINE --back     hand it back now"
    log  "  if it never appears, the stick's own /boot/firmware/wk-diag.txt says why."
}

case "$ACTION" in
    arm)    cmd_arm ;;
    status) cmd_status ;;
    keep)   cmd_keep ;;
    back)   cmd_back ;;
    disarm) cmd_disarm ;;
    diag)   cmd_diag ;;
esac
