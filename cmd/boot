#!/usr/bin/env bash
#
# wk boot <machine> [options] -- put a machine into bench mode for one boot, then back
#
# wk: where=host name=none group=hosts broker *
# wk: readonly --status,--diag
#
#   wk boot <machine> [--system <id>] [--dry-run]  arm the one-shot and reboot
#   wk boot <machine> --status                     what mode it is in, and why
#   wk boot <machine> --keep                       cancel the self-return watchdog
#   wk boot <machine> --back                       reboot back to host mode
#   wk boot <machine> --disarm                     cancel an arming not yet spent
#   wk boot <machine> --diag                       the bench system's own account
#                                                  of its last boot, read offline
#   wk boot --list                                 the machines that have drivers
#
# This is a mode transition, not a reboot: a machine that is armed is about
# to leave host mode, so arming leaves a record of intent, and this command
# is where that record is read back against the evidence. The record is kept
# on the machine it describes, next to the boot mechanism, and nowhere else
# -- a copy on the driving workstation would be a second copy of one fact,
# and the one that goes stale.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/image.sh"
. "$WK_ROOT/image/profiles.sh"
. "$WK_ROOT/boot/machines.sh"
. "$WK_ROOT/lib/target.sh"

# This acts on a physical machine, and the sandbox cannot reach it, so a
# sandboxed invocation becomes a *request* over the one socket a workspace
# can see, performed out there by a broker that refuses on the same evidence
# this file does (container/broker/wk-broker.py) -- see the block below the
# parser.
. "$WK_ROOT/lib/broker.sh"

[ "${1:-}" = --list ] && { machine_list; exit 0; }

MACHINE="${1:-}"; shift 2>/dev/null || true
[ -n "$MACHINE" ] || die "usage: wk boot <machine> [options]; see wk boot -h"
case "$MACHINE" in -*) die "usage: wk boot <machine> [options]; see wk boot -h" ;; esac

ACTION=arm; IMAGE=""; DRY=""
while [ $# -gt 0 ]; do
    case "$1" in
        --status)  ACTION=status ;;
        --diag)    ACTION=diag ;;
        --keep)    ACTION=keep ;;
        --back)    ACTION=back ;;
        --disarm)  ACTION=disarm ;;
        --dry-run) DRY=1 ;;
        --system)  IMAGE="${2:-}"; shift ;;
        --image)   die "renamed: --system <id> (a bootable artifact is a system, never bare
    'image' -- wk help images)" ;;
        *) die "unknown option: $1" ;;
    esac
    shift
done

# --- inside a workspace, this is a request ------------------------------------
# Before machine_load, and long before any driver: everything below reaches
# hardware. Only the action word and the machine name cross the socket --
# never these arguments as a string, never a command -- so the broker's
# vocabulary is what limits this. --diag is not requestable: it mounts the
# bench system's boot partition on the workstation, a debugging disk read
# rather than an outcome a benchmark needs. --keep *is*: the self-return
# watchdog would otherwise cut every run longer than the profile's watchdog
# interval, most of them on this fleet.
if in_workspace; then
    broker_present || broker_no_route "'wk boot'" "wk boot $MACHINE"
    _rc=0
    case "$ACTION" in
        arm)    broker_call arm     machine="$MACHINE" \
                    ${IMAGE:+system="$IMAGE"} ${DRY:+dry_run=1} || _rc=$? ;;
        status) broker_call status  machine="$MACHINE" || _rc=$? ;;
        keep)   broker_call keep    machine="$MACHINE" ${DRY:+dry_run=1} || _rc=$? ;;
        back)   broker_call release machine="$MACHINE" ${DRY:+dry_run=1} || _rc=$? ;;
        disarm) broker_call disarm  machine="$MACHINE" ${DRY:+dry_run=1} || _rc=$? ;;
        diag)   die "'wk boot $MACHINE --diag' mounts that machine's boot partition on the
    workstation to read the system's own account of its last boot. That is a
    disk read, not a mode transition, and it is not in the request broker's
    vocabulary -- a workspace has no business mounting a filesystem out there.
    Run it on the workstation:  wk boot $MACHINE --diag" ;;
    esac
    exit "$_rc"
fi

machine_load "$MACHINE" || die "unknown machine '$MACHINE' (wk boot --list)"

# Probing a MACH_LOCAL machine from the wrong host reads the *driving*
# machine's marker and answers confidently about the wrong computer -- the
# class of bug MACH_OS exists to stop.
case "$MACH_OS" in
    any) ;;
    macos) is_macos || die "$MACHINE is driven from a macOS host only (os=macos in
    boot/machines/$MACHINE.conf) -- run this over there." ;;
    linux) ! is_macos || die "$MACHINE is driven from a Linux host only (os=linux in
    boot/machines/$MACHINE.conf) -- run this over there." ;;
esac

load_driver "$MACH_DRIVER"

# --- reading the transition --------------------------------------------------
# Three sources, in decreasing authority: the machine's own identity marker,
# when it last booted, and the record of intent -- never trusted on its own,
# since a record whose arming predates the machine's current boot has been
# *spent*, a derived fact, not a stored one.
read_state() {
    b_probe
    BOOTED=$(b_booted_at)
    BOOT_ID=$(b_boot_id)
    RECORD=$(record_read)
    ARMED_AT=$(kv_get armed_at <<<"$RECORD")
    ARMED_IMG=$(kv_get image <<<"$RECORD")
    ARMED_BY=$(kv_get armed_by <<<"$RECORD")
    ARMED_BOOT=$(kv_get armed_boot_id <<<"$RECORD")

    # Spent: the machine has booted since the arming. Decided by boot id, not
    # by clocks -- the driving host and the machine can disagree about the
    # time without either clock being wrong, and a boot id cannot.
    SPENT=no
    if [ -n "$ARMED_BOOT" ] && [ -n "$BOOT_ID" ]; then
        if [ "$ARMED_BOOT" != "$BOOT_ID" ]; then SPENT=yes; fi
    elif [ -n "$ARMED_AT" ] && [ -n "$BOOTED" ]; then
        # Fallback for a record with no boot id; both stamps carry an
        # explicit Z, so the comparison is at least unambiguous.
        local a b
        a=$(utc_to_epoch "$ARMED_AT")
        b=$(utc_to_epoch "$BOOTED")
        if [ "$b" -gt "$a" ]; then SPENT=yes; fi
    fi
    # Explicit: the last statement above can be a false test, and under
    # `set -e` an implicit non-zero return would fire exactly when nothing
    # was armed, the common case.
    return 0
}

cmd_status() {
    read_state
    case "$MODE" in
        unreachable)
            log "$MACHINE: unreachable over ssh in host mode"
            b_evidence 2>/dev/null | sed 's/^/  /' || true
            if [ -n "$ARMED_IMG" ]; then
                log "  the record says it was armed for system $ARMED_IMG"
            elif [ -n "${MACH_BRIDGE:-}" ]; then
                # Not a plain outage until the segment is ruled out: this board
                # is reached across a phone's USB ethernet, and when that
                # adapter is absent every board on the cable goes silent at
                # once, which looks exactly like a dead board and is not one.
                log "  no arming record could be read either -- but this machine is behind"
                log "  $MACH_BRIDGE, so rule the segment out before the board:"
                log "      wk bridge status $MACH_BRIDGE"
            else
                log "  no arming record could be read either, so this is a plain outage"
                log "  or the machine is in a bench system that answers somewhere else."
            fi
            return 3 ;;
        bench*)
            log "$MACHINE: bench mode -- system ${MODE#bench } (booted $BOOTED)"
            log "  a plain reboot returns it to host mode: wk boot $MACHINE --back"
            return 0 ;;
        base*)
            # The resilient fallback whose job is to be reachable and let
            # another system be written, never to be measured. Nothing is
            # wrong here.
            log "$MACHINE: base image -- system ${MODE#base } on $MACH_ROOT (booted $BOOTED)"
            log "  this is the fallback helper, not a bench system. To measure something,"
            log "  arm a system on $MACH_DEVICE:  wk boot $MACHINE --system <id>"
            return 0 ;;
    esac

    # Role and mode are different facts: role says what the machine *is*,
    # mode says what it is running right now.
    log "$MACHINE: ${MACH_ROLE:-workstation}, host mode (booted $BOOTED)"
    b_evidence | sed 's/^/  /'

    [ -n "$ARMED_IMG" ] || return 0

    if [ "$SPENT" = yes ]; then
        # Not a desync -- the mechanism working. Saying the record is spent
        # beats clearing it silently or crying wolf.
        log "  a spent arming record remains (system $ARMED_IMG, armed by $ARMED_BY at $ARMED_AT)"
        log "  it was consumed by the boot at $BOOTED; clear it with: wk boot $MACHINE --disarm"
        return 0
    fi

    if [ "${BOOT_ARMING:-one-shot}" = hands-on ]; then
        warn "$MACHINE is ARMED for '$ARMED_IMG' (by $ARMED_BY at $ARMED_AT) and waiting for a person"
        log  "  nothing will move it on its own: the mode is chosen at the startup"
        log  "  manager. 'wk boot $MACHINE' prints the ritual again."
        log  "  cancel with: wk boot $MACHINE --disarm"
        return 2
    fi
    warn "$MACHINE is ARMED to reboot into system $ARMED_IMG (by $ARMED_BY at $ARMED_AT)"
    log  "  it is still in host mode, so the one-shot has not been spent."
    log  "  do not start work on it: the next reboot leaves host mode."
    log  "  cancel with: wk boot $MACHINE --disarm"
    return 2
}

cmd_diag() {
    b_probe
    case "$MODE" in
        host) ;;
        *) die "$MACHINE is in '$MODE'. The diagnostics dump is read off the
    bench system's boot device from host mode -- ask the bench system
    directly, or 'wk boot $MACHINE --back' first." ;;
    esac
    b_diag
}

cmd_keep() {
    read_state
    case "$MODE" in
        bench*) ;;
        *) die "$MACHINE is not in bench mode right now ($MODE), so there is no
    watchdog to cancel." ;;
    esac
    [ -n "$DRY" ] && { log "would create /run/wk-keep-running on $MACHINE"; return 0; }
    r_sudo 'touch /run/wk-keep-running'
    info "$MACHINE claimed: the self-return watchdog will not reboot it"
    warn "nothing will hand this machine back on its own now -- 'wk boot $MACHINE --back' does"
}

cmd_back() {
    read_state
    case "$MODE" in
        unreachable) die "$MACHINE is not answering, so nothing here can reboot it.
    The one-shot is spent by any boot, so a power cycle returns it." ;;
    esac
    [ -n "$DRY" ] && { log "would reboot $MACHINE back to host mode and clear the record"; return 0; }
    # Clear the record first: it lives on the host install's root, which is
    # exactly where the machine is going, and clearing it after the reboot
    # would mean racing the boot.
    case "$MODE" in host) record_clear ;; esac
    b_reboot
    info "$MACHINE is rebooting; the one-shot is spent, so it lands in host mode"
}

cmd_disarm() {
    read_state
    [ -n "$ARMED_IMG" ] || { log "$MACHINE has no arming record"; return 0; }
    if [ -n "$DRY" ]; then
        log "would re-arm $MACHINE with its normal boot order and clear the record"
        return 0
    fi
    # Re-arming with the EEPROM's own order is how a one-shot is cancelled:
    # there is no "clear" tag, and the register is write-only. A hands-on
    # machine has no register at all, so forgetting the record is its whole disarm.
    if [ "${BOOT_ARMING:-one-shot}" = one-shot ]; then
        [ "$SPENT" = yes ] || b_arm "$BOOT_ORDER_NORMAL"
    elif command -v b_disarm >/dev/null 2>&1; then
        # A medium-armed machine's intent is a file on the stick; forgetting
        # the record without erasing it leaves the board still booting the
        # image it was told to forget.
        b_disarm
    fi
    record_clear
    info "$MACHINE disarmed; its next reboot is a normal one"
    command -v b_disarm_note >/dev/null 2>&1 && b_disarm_note
}

cmd_arm() {
    read_state

    case "$MODE" in
        unreachable)
            # `one-shot`, `medium` and `hands-on` all reach the machine to arm
            # it, so a machine that does not answer cannot be armed. `guest`
            # is the exception: arming a guest *is* starting it (b_arm calls
            # t_start), so "unreachable" is the normal state to arm *from* --
            # a stopped guest is what the rehearsal looks like between runs.
            [ "${BOOT_ARMING:-}" = guest ] || die "$MACHINE is not reachable over ssh in host mode.
    Arming is an ssh command, so there is nothing to arm from here." ;;
        bench*) die "$MACHINE is already in bench mode (system ${MODE#bench }).
    'wk boot $MACHINE --back' returns it first." ;;
        # `base*` is deliberately not refused here: a board on its base image is
        # the normal state to arm *from*, and matching it against `bench*`
        # refuses an unarmed board with "already in bench mode".
    esac

    # What "the system" is depends on the arming model. hands-on boots an
    # *installed volume* (boot/mac-volume.sh) that `wk sysimage build` can
    # never produce; its identity is the volume's name. guest has no image to
    # write either -- the guest *is* the system, and its identity is the
    # guest's name (`wk vm ls`).
    case "${BOOT_ARMING:-one-shot}" in
    hands-on)
        [ -n "$IMAGE" ] || IMAGE="${MACH_VOLUME:-}"
        [ -n "$IMAGE" ] || die "$MACHINE has no benchmark volume configured (MACH_VOLUME)" ;;
    guest)
        [ -n "$IMAGE" ] || IMAGE="${MACH_GUEST:-}"
        [ -n "$IMAGE" ] || die "$MACHINE has no guest configured (MACH_GUEST)" ;;
    # The default system is whatever the device already holds, read off its
    # boot partition (b_device_image). Naming one is a check against the
    # device, never a second way to choose it.
    *)
        [ -n "$IMAGE" ] || IMAGE=$(b_device_image) \
            || die "could not read $MACH_DEVICE on $MACHINE to see what it holds"
        [ -n "$IMAGE" ] || die "$MACH_DEVICE on $MACHINE holds no wk system yet.
    Write one first:  wk sysimage write --from <path> --disk $MACHINE:$MACH_DEVICE
    ('wk sysimage ls' lists what a workspace here has built)" ;;
    esac

    # A one-shot boots a local device, so the system has to actually be on it
    # or the boot falls through to host mode and looks like a firmware
    # failure. Asked by name rather than by hash -- see b_device_image() for
    # why bit comparison is the wrong question once an image has booted once.
    # The watchdog value (for the "hands it back in Ns" line below) comes
    # from the profile this machine's conf names (MACH_PROFILE, IMG_WATCHDOG).
    ARM_WATCHDOG=""
    case "${BOOT_ARMING:-one-shot}" in one-shot|medium)
        local on_device
        on_device=$(b_device_image)
        [ "$on_device" = "$IMAGE" ] || die "$MACH_DEVICE on $MACHINE holds ${on_device:-no wk system}, not $IMAGE.
    Write it first:  wk sysimage write --from <path> --disk $MACHINE:$MACH_DEVICE"
        image_profile_load "$MACH_PROFILE" >/dev/null 2>&1 && ARM_WATCHDOG="$IMG_WATCHDOG"
    ;; esac

    if [ -n "$DRY" ]; then
        if [ "${BOOT_ARMING:-one-shot}" = guest ]; then
            # Neither of the branches below fits: a guest has no device to
            # verify an image against and no watchdog to report.
            cat >&2 <<EOF
would arm $MACHINE
  guest        $IMAGE ($( ( load_target vm >/dev/null 2>&1; _vm_state "$(_vm "$IMAGE")" ) 2>/dev/null || echo unknown ))
  boot order   nothing in firmware; arming a guest is starting it
  record       none; the guest either answers with a marker or it does not
  then         start the guest and wait for its marker. Nothing reboots this
               machine -- the rehearsal is a VM, which is the whole point.
EOF
        elif [ "${BOOT_ARMING:-one-shot}" = hands-on ]; then
            cat >&2 <<EOF
would arm $MACHINE
  volume       $IMAGE $(mac_volume_present 2>/dev/null && echo "(attached)" || echo "(NOT attached -- arming would refuse)")
  boot order   nothing in firmware; the selection is a person's, twice
  record       $MACH_RECORD
  then         print the ritual and stop. Nothing reboots this machine: the
               mode it is going to is chosen at the startup manager.
EOF
        else
            cat >&2 <<EOF
would arm $MACHINE
  system       $IMAGE (verified present on $MACH_DEVICE)
  boot order   $([ "${BOOT_ARMING:-one-shot}" = medium ] \
                  && echo "untouched; the arming is $MACH_DEVICE's own boot partition" \
                  || echo "$BOOT_ORDER_IMAGE (one-shot; the normal order $BOOT_ORDER_NORMAL is untouched)")
  record       $MACH_RECORD on $MACHINE
  then         reboot, and the image's watchdog returns it in
               ${ARM_WATCHDOG:-?}s unless claimed
EOF
        fi
        log "dry run -- nothing was armed."
        return 0
    fi

    info "arming $MACHINE for system $IMAGE"
    if [ "${BOOT_ARMING:-one-shot}" = hands-on ]; then
        # No reboot here: the transition happens when a person picks a disk,
        # and rebooting first would take away the moment they need to be
        # holding the power button. Checks (b_arm) before the record, the
        # opposite order to the one-shot below: a firmware call can
        # half-happen, so its record goes in first; a ritual printed to a
        # person cannot, so recording an intent the checks then refuse would
        # leave the machine "armed" for a volume that is not even attached.
        b_arm
        record_write "$IMAGE" "$MACH_PROFILE" "${MACH_VOLUME:-}" ""
        info "$MACHINE is armed on paper: the record says the next mode is bench ('$IMAGE')"
        log  "  it is still in host mode until somebody boots it -- 'wk boot $MACHINE --status'"
        log  "  says so, and 'wk boot $MACHINE --disarm' forgets the intent."
        return 0
    fi
    # Returns early like hands-on does: the generic tail below ends in
    # b_reboot, and for a guest b_reboot is *stop* -- falling through would
    # stop the guest that was supposed to be starting. No record_write:
    # arming here is the state change itself, and the guest either answers
    # with a marker or it does not (b_evidence reads it directly).
    if [ "${BOOT_ARMING:-one-shot}" = guest ]; then
        b_arm
        info "$MACHINE is in bench mode: guest '$IMAGE' is running and carries its marker"
        log  "  'wk boot $MACHINE --back' stops it -- for a guest, leaving the role"
        log  "  is leaving the machine, so there is nothing to hand back afterwards."
        return 0
    fi
    if [ "${BOOT_ARMING:-one-shot}" = one-shot ]; then
        # One record of intent, on the machine, next to the boot mechanism.
        record_write "$IMAGE" "$MACH_PROFILE" "$MACH_DEVICE" "$BOOT_ORDER_IMAGE"
        b_arm "$BOOT_ORDER_IMAGE"
    elif [ "${BOOT_ARMING:-one-shot}" = medium ]; then
        # Here the record is a claim with evidence behind it: the driver's
        # b_evidence reads the stick and says armed or disarmed, so a record
        # that disagrees with the medium is visibly wrong rather than believed.
        record_write "$IMAGE" "$MACH_PROFILE" "$MACH_DEVICE" ""
        b_arm
    fi
    b_reboot

    info "$MACHINE is rebooting into system $IMAGE"
    log  "  it returns by itself in ${ARM_WATCHDOG:-?}s unless claimed:"
    log  "    wk boot $MACHINE --keep     claim it"
    log  "    wk boot $MACHINE --back     hand it back now"
    log  "  if it never appears, the stick's own /boot/firmware/wk-diag.txt says why."
}

case "$ACTION" in
    arm)    cmd_arm ;;
    status) cmd_status ;;
    keep)   cmd_keep ;;
    back)   cmd_back ;;
    disarm) cmd_disarm ;;
    diag)   cmd_diag ;;
esac
