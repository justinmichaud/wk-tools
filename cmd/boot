"""put a machine into bench mode for one boot, then back

  wk boot <machine> [--system <id>]      arm the one-shot and reboot
  wk boot <machine> --status             what mode it is in, and why
  wk boot <board> --boot-order <order>   write a Pi's EEPROM boot order: usb-first, sd-first, or local (the local
                                         disks, no network)

Inside a workspace it is asked of the host through the request broker.
"""
import os

from wk import act, images, record
from wk.act import Refused, die
from wk.boot import cli, eeprom, pi
from wk.decl import Command, Opt
from wk.places import Registry

ROOT = images.root()
ACTIONS = ("--status", "--diag", "--keep", "--back", "--disarm", "--boot-order")
COMMAND = Command(where="host", takes=("<machine>",), broker=True, values="--list", group="hosts", opts=(
    Opt("--status", "what mode it is in, and why", sets=dict(readonly=True)),
    Opt("--diag", "the bench system's own account of its last boot", sets=dict(readonly=True)),
    Opt("--keep", "cancel the self-return watchdog"),
    Opt("--back", "reboot back to host mode"),
    Opt("--disarm", "cancel an arming not yet spent"),
    Opt("--system", "the bench system to arm (default: the board's own)", value="<id>"),
    Opt("--boot-order", "write a Pi's EEPROM boot order: usb-first, sd-first or local", value="<order>",
        sets=dict(destructive=True)),
    Opt("--list", "the machines that have drivers", sets=dict(takes=(), readonly=True))))


def main(args, inv):
    if args.flag("--list"):
        print(cli.listing(ROOT, os.environ))
        return 0
    chosen = [a for a in ACTIONS if args.flag(a) or args.value(a) is not None]
    if len(chosen) > 1:
        inv.usage_die("one of %s at a time" % ", ".join(chosen))
    action = chosen[0][2:] if chosen else "arm"
    name = args.positionals[0]
    if Registry(ROOT).in_workspace():
        return cli.broker(ROOT, name, action, args.value("--system") or "", os.environ)
    conf = cli.load_conf(ROOT, name, os.environ)
    if conf is None:
        die("unknown machine '%s' (wk boot --list)" % name)
    act.terminate_as_interrupt()
    held = None
    if action in ("arm", "back"):   # the two that move the board out from under whatever is measuring on it
        records = record.Records(env=os.environ)
        held = record.hold(records, lambda r: record.fleet_holders(r, record.fleet_stores(ROOT, os.environ, records.machine)),
                           name, "boot", name, "kill %d" % os.getpid(), "", ["%s %s" % (action, name)], os.getpid(), os.environ)
    rc = 1
    try:
        boot = cli.Boot(ROOT, conf, cli.driver_for(ROOT, conf))
        boot.gate()
        if action == "boot-order":
            if conf["driver"] not in pi.DRIVERS:
                die("%s is not a Raspberry Pi (its driver is %s), so it has no EEPROM boot order" % (name, conf["driver"]))
            rc = eeprom.BootOrder(boot.d).run(args.value("--boot-order"))
        else:
            rc = boot.arm(args.value("--system") or "") if action == "arm" else getattr(boot, action)()
    except Refused as e:
        rc = e.status
        raise
    finally:
        if held is not None:
            held.end(rc)
    return rc
