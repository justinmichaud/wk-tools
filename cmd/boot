#!/usr/bin/env bash
#
# wk boot <machine> -- put a machine from host mode into bench mode for one
# boot, and take it back out again.
#
#   wk boot <machine> [--system <id>] [--dry-run]  arm the one-shot and reboot
#   wk boot <machine> --status                     what mode it is in, and why
#   wk boot <machine> --keep                       cancel the self-return watchdog
#   wk boot <machine> --back                       reboot back to host mode
#   wk boot <machine> --disarm                     cancel an arming not yet spent
#   wk boot <machine> --diag                       the bench system's own account
#                                                  of its last boot, read offline
#   wk boot --list                                 the machines that have drivers
#
# This is a mode transition, not a reboot. A machine that is armed is about to
# leave host mode, and anything that acts on it in the meantime is acting on a
# box that is about to reboot out from under it -- so arming leaves a record of
# intent, and this command is where that record is read back against the
# evidence (docs/HANDOFF-workspace-state.md, "wk status walks the fleet";
# docs/HANDOFF-netboot.md, "wk boot is a mode transition").
#
# The record is kept on the machine it describes, next to the boot mechanism it
# describes, and nowhere else. A copy on the driving workstation would be a
# second record of one fact -- forbidden even while the two still agree -- and
# it would be the copy that goes stale, because the transition happens over
# there.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/image.sh"
. "$WK_ROOT/image/profiles.sh"
. "$WK_ROOT/boot/machines.sh"
. "$WK_ROOT/lib/target.sh"

# Both of these act on physical machines: a boot device, a firmware register, a
# disk image measured in gigabytes. None of that exists in a workspace, and the
# sandbox cannot reach the machine that has it. The rule now lives in `wk`'s
# is_host_only list, where it is one line next to every other command of the
# same kind; this stays as the second half of it, for the case the dispatcher
# cannot cover -- cmd/boot run directly, which is how a hook or a script that
# knows the path invokes it.
if in_workspace; then
    die "'wk $(basename "$0")' acts on a host and its hardware, and this is
    workspace '$(wk_self)'. Run it on the workstation instead."
fi

usage() {
    cat >&2 <<'EOF'
usage: wk boot <machine> [options]

  (no options)        arm the one-shot and reboot into the bench system
  --system <id>       which system (default: the newest for this machine)
  --status            the machine's role and mode, its announced transition,
                      and the evidence for all of it
  --diag              the bench system's own account of its last boot, read off
                      its boot device -- works when it never appeared
  --keep              claim a running bench system: cancel its self-return
                      watchdog
  --back              reboot back to host mode now
  --disarm            cancel an arming that has not been spent yet
  --dry-run           resolve everything, change nothing
  --list              machines with a boot driver

machines:
EOF
    machine_list | sed 's/^/  /' >&2
    exit 2
}

[ "${1:-}" = --list ] && { machine_list; exit 0; }

MACHINE="${1:-}"; shift 2>/dev/null || true
[ -n "$MACHINE" ] || usage
case "$MACHINE" in -*) usage ;; esac

ACTION=arm; IMAGE=""; DRY=""
while [ $# -gt 0 ]; do
    case "$1" in
        --status)  ACTION=status ;;
        --diag)    ACTION=diag ;;
        --keep)    ACTION=keep ;;
        --back)    ACTION=back ;;
        --disarm)  ACTION=disarm ;;
        --dry-run) DRY=1 ;;
        --system)  IMAGE="${2:-}"; shift ;;
        --image)   die "renamed: --system <id> (a bootable artifact is a system, never bare
    'image' -- docs/HANDOFF-vocabulary.md)" ;;
        *) die "unknown option: $1" ;;
    esac
    shift
done

machine_load "$MACHINE" || die "unknown machine '$MACHINE' (wk boot --list)"

# A machine that can only be driven from one OS is refused everywhere else,
# by the registry's own word -- probing a MACH_LOCAL machine from the wrong
# host reads the *driving* machine's marker and answers confidently about the
# wrong computer, which is exactly the class of bug MACH_OS exists to stop.
case "$MACH_OS" in
    any) ;;
    macos) is_macos || die "$MACHINE is driven from a macOS host only (os=macos in
    boot/machines/$MACHINE.conf) -- run this over there." ;;
    linux) ! is_macos || die "$MACHINE is driven from a Linux host only (os=linux in
    boot/machines/$MACHINE.conf) -- run this over there." ;;
esac

load_driver "$MACH_DRIVER"

# --- reading the transition --------------------------------------------------
#
# Three sources, in decreasing authority: what the machine says it is (the
# identity marker, which only a bench system has), when it last booted, and the
# record of intent. The record is never trusted on its own -- a record whose
# arming predates the machine's current boot has been *spent*, and that is a
# derived fact, not a stored one.
read_state() {
    b_probe
    BOOTED=$(b_booted_at)
    BOOT_ID=$(b_boot_id)
    RECORD=$(record_read)
    ARMED_AT=$(printf '%s\n' "$RECORD" | sed -n 's/^armed_at=//p')
    ARMED_IMG=$(printf '%s\n' "$RECORD" | sed -n 's/^image=//p')
    ARMED_BY=$(printf '%s\n' "$RECORD" | sed -n 's/^armed_by=//p')
    ARMED_BOOT=$(printf '%s\n' "$RECORD" | sed -n 's/^armed_boot_id=//p')

    # Spent: the machine has booted since the arming, so the one-shot is gone
    # whichever way it landed. Decided by boot id, not by clocks -- the first
    # version of this compared the driving host's UTC stamp against the
    # machine's boot time and called a plainly-spent arming "armed", because
    # the two ends were six hours apart in a string nobody had converted.
    SPENT=no
    if [ -n "$ARMED_BOOT" ] && [ -n "$BOOT_ID" ]; then
        if [ "$ARMED_BOOT" != "$BOOT_ID" ]; then SPENT=yes; fi
    elif [ -n "$ARMED_AT" ] && [ -n "$BOOTED" ]; then
        # A record from before boot ids were written. Both stamps carry an
        # explicit Z, so this comparison is at least unambiguous -- but it is
        # the fallback, not the mechanism.
        local a b
        a=$(utc_to_epoch "$ARMED_AT")
        b=$(utc_to_epoch "$BOOTED")
        if [ "$b" -gt "$a" ]; then SPENT=yes; fi
    fi
    # Explicit, and not decoration: a function whose last statement is a false
    # test returns non-zero, and every caller here runs it as a plain command
    # under `set -e` -- a trap that has bitten this repo before, and it
    # would fire exactly when nothing was armed -- the common case.
    return 0
}

cmd_status() {
    read_state
    case "$MODE" in
        unreachable)
            log "$MACHINE: unreachable over ssh in host mode"
            # Whatever the driver can still say about it without reaching it --
            # for a guest that is "the guest is absent", which is a different
            # thing from an outage and the reader should not have to guess.
            b_evidence 2>/dev/null | sed 's/^/  /' || true
            if [ -n "$ARMED_IMG" ]; then
                log "  the record says it was armed for system $ARMED_IMG"
            else
                log "  no arming record could be read either, so this is a plain outage"
                log "  or the machine is in a bench system that answers somewhere else."
            fi
            return 3 ;;
        bench*)
            log "$MACHINE: bench mode -- system ${MODE#bench } (booted $BOOTED)"
            log "  a plain reboot returns it to host mode: wk boot $MACHINE --back"
            return 0 ;;
    esac

    # Role and mode are different facts and the line carries both: the role
    # (boot/machines.sh) says what the machine *is*, the mode says what it is
    # running right now. Printing only one of them is the confusion
    # docs/HANDOFF-vocabulary.md exists to end.
    log "$MACHINE: ${MACH_ROLE:-workstation}, host mode (booted $BOOTED)"
    b_evidence | sed 's/^/  /'

    [ -n "$ARMED_IMG" ] || return 0

    if [ "$SPENT" = yes ]; then
        # Not a desync: the transition happened and the machine came back, which
        # is the mechanism working. The record is simply spent, and saying so is
        # more useful than either clearing it silently or crying wolf.
        log "  a spent arming record remains (system $ARMED_IMG, armed by $ARMED_BY at $ARMED_AT)"
        log "  it was consumed by the boot at $BOOTED; clear it with: wk boot $MACHINE --disarm"
        return 0
    fi

    if [ "${BOOT_ARMING:-one-shot}" = hands-on ]; then
        warn "$MACHINE is ARMED for '$ARMED_IMG' (by $ARMED_BY at $ARMED_AT) and waiting for a person"
        log  "  nothing will move it on its own: the mode is chosen at the startup"
        log  "  manager. 'wk boot $MACHINE' prints the ritual again."
        log  "  cancel with: wk boot $MACHINE --disarm"
        return 2
    fi
    warn "$MACHINE is ARMED to reboot into system $ARMED_IMG (by $ARMED_BY at $ARMED_AT)"
    log  "  it is still in host mode, so the one-shot has not been spent."
    log  "  do not start work on it: the next reboot leaves host mode."
    log  "  cancel with: wk boot $MACHINE --disarm"
    return 2
}

cmd_diag() {
    b_probe
    case "$MODE" in
        host) ;;
        *) die "$MACHINE is in '$MODE'. The diagnostics dump is read off the
    bench system's boot device from host mode -- ask the bench system
    directly, or 'wk boot $MACHINE --back' first." ;;
    esac
    b_diag
}

cmd_keep() {
    read_state
    case "$MODE" in
        bench*) ;;
        *) die "$MACHINE is not in bench mode right now ($MODE), so there is no
    watchdog to cancel." ;;
    esac
    [ -n "$DRY" ] && { log "would create /run/wk-keep-running on $MACHINE"; return 0; }
    r_ssh 'sudo touch /run/wk-keep-running'
    info "$MACHINE claimed: the self-return watchdog will not reboot it"
    warn "nothing will hand this machine back on its own now -- 'wk boot $MACHINE --back' does"
}

cmd_back() {
    read_state
    case "$MODE" in
        unreachable) die "$MACHINE is not answering, so nothing here can reboot it.
    The one-shot is spent by any boot, so a power cycle returns it." ;;
    esac
    [ -n "$DRY" ] && { log "would reboot $MACHINE back to host mode and clear the record"; return 0; }
    # Clear the record first: it lives on the host install's root, which is
    # exactly where the machine is going, and clearing it after the reboot
    # would mean racing the boot.
    case "$MODE" in host) record_clear ;; esac
    b_reboot
    info "$MACHINE is rebooting; the one-shot is spent, so it lands in host mode"
}

cmd_disarm() {
    read_state
    [ -n "$ARMED_IMG" ] || { log "$MACHINE has no arming record"; return 0; }
    if [ -n "$DRY" ]; then
        log "would re-arm $MACHINE with its normal boot order and clear the record"
        return 0
    fi
    # Re-arming with the EEPROM's own order is how a one-shot is cancelled:
    # there is no "clear" tag, and the register is write-only, so the way to
    # make the next boot normal is to say so. A hands-on machine has no
    # register at all, so forgetting the record is the whole of the disarm --
    # and its driver says which half a person still has to do.
    if [ "${BOOT_ARMING:-one-shot}" = one-shot ]; then
        [ "$SPENT" = yes ] || b_arm "$BOOT_ORDER_NORMAL"
    elif command -v b_disarm >/dev/null 2>&1; then
        # A medium-armed machine has a real disarm to perform -- the intent is
        # a file on the stick, so forgetting the record would leave the board
        # still booting the image it was told to forget.
        b_disarm
    fi
    record_clear
    info "$MACHINE disarmed; its next reboot is a normal one"
    command -v b_disarm_note >/dev/null 2>&1 && b_disarm_note
}

cmd_arm() {
    read_state

    case "$MODE" in
        unreachable)
            die "$MACHINE is not reachable over ssh in host mode.
    Arming is an ssh command, so there is nothing to arm from here." ;;
        bench*) die "$MACHINE is already in bench mode (system ${MODE#bench }).
    'wk boot $MACHINE --back' returns it first." ;;
    esac

    # What "the system" is depends on the arming model, and for one machine it
    # is not a file at all: a hands-on machine boots an *installed volume*
    # (boot/mac-volume.sh), which no store can hold and `wk sysimage build`
    # can never produce. Its identity is the volume's name, which is also what
    # the person choosing it will see on the screen.
    if [ "${BOOT_ARMING:-one-shot}" = hands-on ]; then
        [ -n "$IMAGE" ] || IMAGE="${MACH_VOLUME:-}"
        [ -n "$IMAGE" ] || die "$MACHINE has no benchmark volume configured (MACH_VOLUME)"
    else
        [ -n "$IMAGE" ] || IMAGE=$(image_latest "$MACH_PROFILE") \
            || die "no system built for $MACHINE yet -- 'wk sysimage build $MACH_PROFILE'"
        image_complete "$IMAGE" || die "no such system: $IMAGE"
    fi

    # A one-shot boots a local device, so the system has to actually be on it
    # or the boot falls through to host mode and the whole thing looks like a
    # firmware failure. Asked by name rather than by hash -- see
    # b_device_image() for why bit comparison is the wrong question once an
    # image has booted once.
    case "${BOOT_ARMING:-one-shot}" in one-shot|medium)
        local on_device
        on_device=$(b_device_image)
        [ "$on_device" = "$IMAGE" ] || die "$MACH_DEVICE on $MACHINE holds ${on_device:-no wk system}, not $IMAGE.
    Write it first:  wk sysimage write $IMAGE --disk $MACHINE:$MACH_DEVICE"
    ;; esac

    if [ -n "$DRY" ]; then
        if [ "${BOOT_ARMING:-one-shot}" = hands-on ]; then
            cat >&2 <<EOF
would arm $MACHINE
  volume       $IMAGE $(mac_volume_present 2>/dev/null && echo "(attached)" || echo "(NOT attached -- arming would refuse)")
  boot order   nothing in firmware; the selection is a person's, twice
  record       $MACH_RECORD
  then         print the ritual and stop. Nothing reboots this machine: the
               mode it is going to is chosen at the startup manager.
EOF
        else
            cat >&2 <<EOF
would arm $MACHINE
  system       $IMAGE (verified present on $MACH_DEVICE)
  boot order   $([ "${BOOT_ARMING:-one-shot}" = medium ] \
                  && echo "untouched; the arming is $MACH_DEVICE's own boot partition" \
                  || echo "$BOOT_ORDER_IMAGE (one-shot; the normal order $BOOT_ORDER_NORMAL is untouched)")
  record       $MACH_RECORD on $MACHINE
  then         reboot, and the image's watchdog returns it in
               $(manifest_get "$IMAGE" watchdog)s unless claimed
EOF
        fi
        log "dry run -- nothing was armed."
        return 0
    fi

    info "arming $MACHINE for system $IMAGE"
    if [ "${BOOT_ARMING:-one-shot}" = hands-on ]; then
        # The record first, then the ritual, and no reboot: the transition
        # happens when a person picks a disk, and a command that rebooted the
        # machine before saying so would take away the moment they need to be
        # holding the power button. There is no watchdog either -- the way back
        # is a plain reboot, because the startup-manager route leaves the
        # default alone.
        # Checks first, record second -- the opposite order to the one-shot
        # below, and for the reason that makes both right. A firmware call can
        # half-happen, so its record goes in before it; a ritual printed to a
        # person cannot, so recording an intent that the checks then refuse
        # would leave the machine "armed" for a volume that is not even
        # attached. Found by running exactly that.
        b_arm
        record_write "$IMAGE" "$MACH_PROFILE" "${MACH_VOLUME:-}" ""
        info "$MACHINE is armed on paper: the record says the next mode is bench ('$IMAGE')"
        log  "  it is still in host mode until somebody boots it -- 'wk boot $MACHINE --status'"
        log  "  says so, and 'wk boot $MACHINE --disarm' forgets the intent."
        return 0
    fi
    if [ "${BOOT_ARMING:-one-shot}" = one-shot ]; then
        # One record of intent, on the machine, next to the boot mechanism.
        record_write "$IMAGE" "$(manifest_get "$IMAGE" profile)" "$MACH_DEVICE" "$BOOT_ORDER_IMAGE"
        b_arm "$BOOT_ORDER_IMAGE"
    elif [ "${BOOT_ARMING:-one-shot}" = medium ]; then
        # The record is written for the same reason as the one-shot's -- the
        # arm and the reboot are two steps and something has to survive between
        # them -- but here it is a claim with evidence behind it: the driver's
        # b_evidence reads the stick and says armed or disarmed, so a record
        # that disagrees with the medium is visibly wrong rather than believed.
        record_write "$IMAGE" "$(manifest_get "$IMAGE" profile)" "$MACH_DEVICE" ""
        b_arm
    fi
    b_reboot

    info "$MACHINE is rebooting into system $IMAGE"
    log  "  it returns by itself in $(manifest_get "$IMAGE" watchdog)s unless claimed:"
    log  "    wk boot $MACHINE --keep     claim it"
    log  "    wk boot $MACHINE --back     hand it back now"
    log  "  if it never appears, the stick's own /boot/firmware/wk-diag.txt says why."
}

case "$ACTION" in
    arm)    cmd_arm ;;
    status) cmd_status ;;
    keep)   cmd_keep ;;
    back)   cmd_back ;;
    disarm) cmd_disarm ;;
    diag)   cmd_diag ;;
esac
