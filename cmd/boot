#!/usr/bin/env python3
#
# wk boot <machine> [options] -- put a machine into bench mode for one boot, then back
#
# wk: where=host name=none values=--list group=hosts broker * takes=1 dryrun destructive --boot-order
# wk: opts --status,--diag,--keep,--back,--disarm,--system=,--boot-order=,--list
# wk: readonly --status,--diag
#
#   wk boot <machine> [--system <id>]              arm the one-shot and reboot
#   wk boot <machine> --status                     what mode it is in, and why
#   wk boot <machine> --keep                       cancel the self-return watchdog
#   wk boot <machine> --back                       reboot back to host mode
#   wk boot <machine> --disarm                     cancel an arming not yet spent
#   wk boot <machine> --diag                       the bench system's own account
#                                                  of its last boot, read offline
#   wk boot <board> --boot-order <order>           write a Pi's EEPROM boot order:
#                                                  usb-first, sd-first, or local
#                                                  (the local disks, no network);
#                                                  asks once, and names the undo
#   wk boot --list                                 the machines that have drivers
#
# This is a mode transition, not a reboot: arming leaves a record of intent, and
# this command reads that record back against the evidence. The record is kept on
# the machine it describes, next to the boot mechanism, and nowhere else.

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images  # noqa: E402

ROOT = images.root()

from wk import act, decl  # noqa: E402
from wk.act import Refused, die  # noqa: E402
from wk.boot import cli, eeprom, pi  # noqa: E402
from wk.places import Registry  # noqa: E402

USAGE = "usage: wk boot <machine> [options]; see wk boot -h"


def parse(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    asked = (("status", args.flag("--status")), ("diag", args.flag("--diag")), ("keep", args.flag("--keep")),
             ("back", args.flag("--back")), ("disarm", args.flag("--disarm")),
             ("boot-order", args.value("--boot-order") is not None))
    chosen = [a for a, on in asked if on]
    if len(chosen) > 1 or len(args.positionals) > 1:
        die(USAGE)
    return args, (chosen[0] if chosen else "arm")


def main(argv):
    args, action = parse(argv)
    if args.flag("--list"):
        print(cli.listing(ROOT, os.environ))
        return 0
    if not args.positionals:
        die(USAGE)
    name = args.positionals[0]
    if Registry(ROOT).in_workspace():
        return cli.broker(ROOT, name, action, args.value("--system") or "", os.environ)
    conf = cli.load_conf(ROOT, name, os.environ)
    if conf is None:
        die("unknown machine '%s' (wk boot --list)" % name)
    act.terminate_as_interrupt()
    held = cli.hold(ROOT, name, action, os.environ) if action in ("arm", "back") else None
    rc = 1
    try:
        boot = cli.Boot(ROOT, conf, cli.driver_for(ROOT, conf))
        boot.gate()
        if action == "boot-order":
            if conf["driver"] not in pi.DRIVERS:
                die("%s is not a Raspberry Pi (its driver is %s), so it has no EEPROM boot order" % (name, conf["driver"]))
            rc = eeprom.BootOrder(boot.d).run(args.value("--boot-order"))
        else:
            rc = boot.arm(args.value("--system") or "") if action == "arm" else getattr(boot, action)()
    except Refused as e:
        rc = e.status
        raise
    finally:
        if held is not None:
            held.end(rc)
    return rc


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
