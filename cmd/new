"""create a workspace named after the task it is for

Creation is detached: a dropped connection does not take it with it, and re-running `wk new` resumes it. Creation
refreshes this machine's mirror first (`wk sync --mirror`; a refresh that fails refuses the creation), then fetches
from it and fast-forwards the checkout. A container workspace on a macOS host is made in the podman VM, and --zed
opens it here once that has finished.

  WK_NEW_TIMEOUT=<s>   how long this end waits for the detached run before giving up (default 3600); the run itself
                       is unaffected
  WK_READY_WAIT=<s>    how long the detached run waits for the workspace to finish initialising (default 1800)
  WK_KILL_WAIT=<s>     how long --kill waits after TERM before KILL (default 15)
"""
from wk import images, places, pr, project, record, repos, store, workspace
from wk.act import Refused, die
from wk.decl import Command, Opt
from wk.lock import Lock

ROOT = images.root()
COMMAND = Command(name="required", lifecycle=True, forward=False, group="workspaces", opts=(
    Opt("--on", "container, vm, or a machine in machines/ (default: container); a build box's or peer's own wk makes it",
        value="<place|machine>"),
    Opt("--base", "the snapshot to build from, an id 'wk sync' published (default: current)", value="<id>"),
    Opt("--arch", "native|armhf: the architecture the workspace itself runs (container only; default: native)",
        value="<arch>"),
    Opt("--repo", "the repository it holds (valid values below); wk-tools is container only", value="<repo>"),
    Opt("--zed", "open the checkout in Zed once it is ready"),
    Opt("--no-wait", "return once creation has started, without waiting for it; incompatible with --pr"),
    Opt("--kill", "stop the creation running for <name>; what it leaves is half-made, and 'wk rm <name>' clears it"),
    Opt("--pr", "check it out onto a PR head once ready: <user>:<branch>, <n>, or wpe:<n>", value="<spec>"),
    Opt("--_detached", "the detached half the front starts")))


def parse(args):
    return {"place": args.value("--on"), "base": args.value("--base"), "arch": args.value("--arch"),
            "repo": args.value("--repo"), "pr": args.value("--pr"), "zed": args.flag("--zed"),
            "no_wait": args.flag("--no-wait"), "kill": args.flag("--kill"), "detached": args.flag("--_detached")}


def detached(reg, records, name, opts):
    """The detached half: the front spawned it with the canonical --on, --arch, --repo and --base."""
    try:
        driver = reg.load(opts.get("place") or reg.default())
        repo = repos.Repo(opts.get("repo") or project.get("REPO"))
    except LookupError as e:
        die(str(e))
    recs = record.of_driver(driver, records.clock, reg.machine)
    return workspace.new_detached_run(driver, recs, Lock(driver.store, reg.machine, recs.clock), recs.clock,
                                      name, opts.get("base") or "", opts.get("arch") or "native", repo)


def main(args, inv):
    opts, name = parse(args), store.ws_name()
    reg = places.Registry(ROOT)
    if inv.vm_side():
        rc = inv.forward([w for w in inv.argv if w != "--zed"])
        if rc and opts["zed"]:
            die("'wk new %s' failed, so nothing was opened.\n"
                "    What it managed to say is above; a re-run destroys the rubble and retries." % name)
        if rc:
            raise Refused(rc)
        workspace.zed_after(reg.machine, ROOT, name, opts)
        return 0
    records = record.Records(machine=reg.machine)
    if opts["detached"]:
        return detached(reg, records, name, opts)
    return workspace.new_front(reg, records, name, opts, pr)
