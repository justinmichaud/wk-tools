#!/usr/bin/env python3
#
# wk new <name> -- create a workspace named after the task it is for
# wk: where=workspace name=required lifecycle post=zed group=workspaces dryrun
# wk: opts --target=,--base=,--arch=,--zed,--no-wait,--kill,--pr=,--sysroot,--_detached
#
# Other targets take minutes (a guest clone, a git clone over ssh), so creation is
# *detached*: a dropped connection does not take it with it, and re-running `wk
# new` resumes it. This end refuses what should be refused, starts the driver and
# follows its log; the driver (`--_detached`) does everything that changes
# anything, under the workspace lock, stepping its task record as it goes.
# --dry-run runs the driver here instead and prints what it would change.
#
#   --target <target>   container, vm, or a machine named in
#                        targets/hosts/<name>.conf (default: container)
#   --base <id>          which base snapshot to build from -- an id 'wk sync'
#                        published, under $WK_STORE/base (default: current)
#   --arch <arch>        native|armhf -- the architecture the workspace
#                        itself runs (container only; default: native)
#   --zed                open the checkout in Zed once it is ready
#   --no-wait            return once creation has started, without waiting for it;
#                        incompatible with --pr
#   --kill               stop the creation running for <name>; what it leaves is
#                        half-made, and 'wk rm <name>' clears it
#   --pr <spec>          check it out onto a PR head once ready -- the same
#                        spec `wk pr` takes: <user>:<branch>, <n>, or wpe:<n>
#
#   WK_NEW_TIMEOUT=<s>   how long this end waits for the driver before giving
#                        up (default 3600); the driver itself is unaffected
#   WK_READY_TIMEOUT=<s> how long the driver waits for the workspace to finish
#                        initialising (default 300)
#   WK_KILL_WAIT=<s>     how long --kill waits after TERM before KILL (default 15)
#
# Creation fetches from the mirror beside its snapshot and fast-forwards the
# checkout onto it. It never fetches over the network and never refreshes the
# mirror itself: that is `wk sync --tools`.

import os
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import record, targets, workspace  # noqa: E402
from wk.act import Refused, die  # noqa: E402
from wk.lock import Lock  # noqa: E402

def parse(argv):
    """The options as the dispatcher hands them on, a declared `--x=` as `--x <value>`; None when not given."""
    def value(flag):
        i = argv.index(flag) + 1
        return argv[i] if i < len(argv) else ""
    return {"target": value("--target") if "--target" in argv else None,
            "base": value("--base") if "--base" in argv else None,
            "arch": value("--arch") if "--arch" in argv else None,
            "pr": value("--pr") if "--pr" in argv else None,
            "zed": "--zed" in argv, "no_wait": "--no-wait" in argv, "kill": "--kill" in argv,
            "sysroot": "--sysroot" in argv, "detached": "--_detached" in argv}


def driver(reg, records, name, opts):
    """The detached half: the front spawned it with the canonical --target, --arch and --base."""
    try:
        target = reg.load(opts.get("target") or reg.default())
    except LookupError as e:
        die(str(e))
    recs = record.of_target(target, records.clock, reg.machine)
    return workspace.new_driver(target, recs, Lock(target.store, reg.machine, recs.clock), recs.clock,
                                name, opts.get("base") or "", opts.get("arch") or "native")


def main(argv):
    opts = parse(argv)
    name = os.environ.get("WK_NAME", "")
    reg = targets.Registry(ROOT)
    records = record.Records(machine=reg.machine)
    if opts.get("detached"):
        return driver(reg, records, name, opts)
    return workspace.new_front(reg, records, name, opts)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
