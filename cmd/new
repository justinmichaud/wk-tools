#!/usr/bin/env bash
#
# wk new <name> -- create a workspace named after the task it is for.
#
# Costs one overlay mount regardless of how large the checkout is: there is no
# clone and no copy, because the base snapshot is shared read-only and this
# workspace only ever writes to its own layer.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"

TARGET=container
BASE=""

NAME="${1:-}"; shift || true
require_name "$NAME"

while [ $# -gt 0 ]; do
    case "$1" in
        --target) TARGET="${2:-}"; shift 2 ;;
        --base)   BASE="${2:-}"; shift 2 ;;
        *) die "unknown option: $1" ;;
    esac
done

case "$TARGET" in
    container|vm|remote) ;;
    *) die "unknown target '$TARGET' (container, vm, remote)" ;;
esac

. "$WK_ROOT/targets/$TARGET.sh"

store_init

[ -n "$BASE" ] || BASE=$(current_base) \
    || die "no base snapshot yet -- run 'wk sync' first"

t_create "$NAME" "$BASE"

# Register an ssh alias so Zed can open the workspace directly. Written to a
# generated file under config.d, never to ~/.ssh/config itself, so it can be
# rewritten without risk to hand-maintained entries.
ssh_conf="$HOME/.ssh/config.d/wk"
ensure_dir "$(dirname "$ssh_conf")" 0700
if ! grep -q "^Host wk-$NAME\$" "$ssh_conf" 2>/dev/null; then
    cat >> "$ssh_conf" <<EOF

Host wk-$NAME
    # generated by wk new -- removed by wk rm
    HostName localhost
    User $(id -un)
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
EOF
    changed "ssh alias wk-$NAME"
fi

info "workspace '$NAME' ready"
log  "  wk enter $NAME          shell"
log  "  wk build $NAME <config> build"
log  "  wk claude $NAME         sandboxed agent"
log  "  zed ssh://wk-$NAME/src/WebKit"
