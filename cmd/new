#!/usr/bin/env python3
#
# wk new <name> -- create a workspace named after the task it is for
# wk: where=workspace name=required lifecycle post=zed group=workspaces dryrun
# wk: opts --on=,--base=,--arch=,--zed,--no-wait,--kill,--pr=,--sysroot,--_detached
#
# Other places take minutes (a guest clone, a git clone over ssh), so creation is
# *detached*: a dropped connection does not take it with it, and re-running `wk
# new` resumes it. This end refuses what should be refused, starts the detached
# run and follows its log; the detached run (`--_detached`) does everything that changes
# anything, under the workspace lock, stepping its task record as it goes.
# --dry-run runs it here instead and prints what it would change.
#
#   --on <place|machine> container, vm, or a machine named in
#                        machines/<name>.conf (default: container); a build
#                        box's or peer workstation's own `wk new` makes it there
#   --base <id>          which snapshot to build from -- an id 'wk sync'
#                        published, under $WK_STORE/base (default: current)
#   --arch <arch>        native|armhf -- the architecture the workspace
#                        itself runs (container only; default: native)
#   --zed                open the checkout in Zed once it is ready
#   --no-wait            return once creation has started, without waiting for it;
#                        incompatible with --pr
#   --kill               stop the creation running for <name>; what it leaves is
#                        half-made, and 'wk rm <name>' clears it
#   --pr <spec>          check it out onto a PR head once ready -- the same
#                        spec `wk pr` takes: <user>:<branch>, <n>, or wpe:<n>
#
#   WK_NEW_TIMEOUT=<s>   how long this end waits for the detached run before
#                        giving up (default 3600); the run itself is unaffected
#   WK_READY_TIMEOUT=<s> how long the detached run waits for the workspace to finish
#                        initialising (default 300)
#   WK_KILL_WAIT=<s>     how long --kill waits after TERM before KILL (default 15)
#
# Creation refreshes this machine's mirror first (`wk sync --mirror`: no other
# workspace is touched), then fetches from it, fast-forwards the checkout onto
# it and runs one `git status`, so the first one in the workspace is fast.
# A refresh that fails refuses the creation: fix it with `wk sync --mirror`.

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images, store  # noqa: E402

ROOT = images.root()

from wk import decl, places, record, workspace  # noqa: E402
from wk.act import Refused, die  # noqa: E402
from wk.lock import Lock  # noqa: E402


def parse(argv):
    a = decl.Args(decl.Decl(__file__), argv)
    return {"place": a.value("--on"), "base": a.value("--base"), "arch": a.value("--arch"),
            "pr": a.value("--pr"), "zed": a.flag("--zed"), "no_wait": a.flag("--no-wait"),
            "kill": a.flag("--kill"), "sysroot": a.flag("--sysroot"), "detached": a.flag("--_detached")}


def detached(reg, records, name, opts):
    """The detached half: the front spawned it with the canonical --on, --arch and --base."""
    try:
        driver = reg.load(opts.get("place") or reg.default())
    except LookupError as e:
        die(str(e))
    recs = record.of_driver(driver, records.clock, reg.machine)
    return workspace.new_detached_run(driver, recs, Lock(driver.store, reg.machine, recs.clock), recs.clock,
                                name, opts.get("base") or "", opts.get("arch") or "native")


def main(argv):
    opts = parse(argv)
    name = store.ws_name()
    reg = places.Registry(ROOT)
    records = record.Records(machine=reg.machine)
    if opts.get("detached"):
        return detached(reg, records, name, opts)
    return workspace.new_front(reg, records, name, opts)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
