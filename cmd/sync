#!/usr/bin/env bash
#
# wk sync [<workspace>|--all|--tools] -- bring WebKit and the tooling up to date
# wk: where=workspace name=optional group=sources needs git,rsync
# wk: flag --target,--all,--tools,--machine where=host
#
# Safe to run at any time: workspaces already made stay pinned to the snapshot
# they were created from, and only ones made after this pick up the new one.
#
#   wk sync                    one workspace on this machine (asked, when several)
#   wk sync <workspace>        that one
#   wk sync --target <target>  every workspace on that target
#   wk sync --all              every workspace on every target
#   wk sync --tools [<target>] a machine's own furniture rather than a
#                              workspace's: its copy of wk-tools, its WebKit
#                              mirror, and a new snapshot. One target's, or all.
#
#   WK_DEBUG=1          per-stage timing on stderr: 'stage <name>: <n>s'
#   WK_BRANCH=<branch>  publish the snapshot from this remote-tracking branch
#                       (origin/safari-7620-branch, wpe/wpe-2.46), not origin/main

set -euo pipefail
WK_ROOT="${WK_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# bash 3.2 here, so second resolution via `date +%s`: no $EPOCHREALTIME.
STAGE_T0=0
stage_begin() { STAGE_T0=$(date +%s); }
stage_end()   { debug "stage $1: $(( $(date +%s) - STAGE_T0 ))s"; }

snapshot_current() {
    [ -n "$1" ] && [ "$1" = "$2" ]
}

sync_scope_decide() {
    local n="$1" tty="$2" pick="${3:-}"
    [ "$n" -eq 0 ] && { printf 'empty\n'; return 0; }
    [ "$n" -eq 1 ] && { printf 'one\n'; return 0; }
    [ "$tty" = 1 ] || { printf 'refuse\n'; return 0; }
    [ -n "$pick" ] || { printf 'ask\n'; return 0; }
    case "$pick" in
        ''|*[!0-9]*) printf 'invalid\n'; return 0 ;;
    esac
    if [ "$pick" -eq "$((n + 1))" ]; then
        printf 'all\n'
    elif [ "$pick" -eq "$((n + 2))" ]; then
        printf 'tools\n'
    elif [ "$pick" -ge 1 ] && [ "$pick" -le "$n" ]; then
        printf 'pick %s\n' "$pick"
    else
        printf 'out-of-range\n'
    fi
}

local_store_named() {
    [ -z "${1:-}" ] && return 0
    case "$(target_kind "$1" 2>/dev/null)" in container|vm|local) return 0 ;; esac
    return 1
}

# `-B` resets rather than switches: the branch `git clone` leaves keeps the sha it was cloned at, and every later snapshot is hardlinked from that one.
snapshot_checkout() { # <tree> <branch>
    local tree="$1" branch="$2" ref upstream local_branch
    ref=$(git -C "$tree" rev-parse --symbolic-full-name "$branch" 2>/dev/null || true)
    case "$ref" in
        refs/remotes/*/*) ;;
        *)  printf "'%s' is not a branch this mirror carries.
    A snapshot is published from a remote-tracking branch, spelled
    <remote>/<branch>:  origin/main (the default), wpe/wpe-2.46.
    Only %s of origin is in the mirror at all -- WK_MIRROR_BRANCHES=<branch>
    carries another one in.\n" "$branch" "$(wk_mirror_branches)"
            return 1 ;;
    esac
    upstream=${ref#refs/remotes/}      # origin/main
    local_branch=${upstream#*/}        # main
    git -C "$tree" checkout --quiet -B "$local_branch" "$ref" \
        || { printf "could not check %s out as branch %s\n" "$upstream" "$local_branch"; return 1; }
    git -C "$tree" branch --quiet --set-upstream-to "$upstream" "$local_branch" \
        || { printf "branch %s does not track %s\n" "$local_branch" "$upstream"; return 1; }
}

mirror_refspecs() {
    local r out="+refs/heads/*:refs/remotes/origin/*"
    for r in $(wk_mirror_default_remotes); do
        [ "$r" = origin ] && continue
        out="$out +refs/remotes/$r/*:refs/remotes/$r/*"
    done
    printf '%s' "$out"
}

net_refspecs() { # <remote>
    local b out=""
    if [ "$1" = origin ]; then
        for b in $(wk_mirror_branches); do
            out="$out +refs/heads/$b:refs/remotes/origin/$b"
        done
    else
        out=" +refs/heads/*:refs/remotes/$1/*"
    fi
    printf '%s' "${out# }"
}

# Generated here as portable `sh` because the checkout is behind a container exec or an ssh, and only for the remotes the checkout actually has:
# naming an absent one fails the whole fetch. --no-tags, because following tags re-negotiates every tag the source has (0.97s -> 0.23s on a 5,000-tag stand-in).
ws_fetch_script() { # <src> <mirror-dir>
    local src="$1" mirror="$2" r
    # The refspecs are `*` globs git reads: `set -f` so `sh` cannot expand one into a filename that happens to be in the working tree.
    printf 'set -f\n'
    printf 'cd %s || exit 1\n' "$(sh_quote "$src")"
    if [ -n "$mirror" ]; then
        printf 'if [ -d %s ]; then\n' "$(sh_quote "$mirror")"
        printf '    git fetch --no-tags --prune --quiet %s %s || exit 1\n' \
            "$(sh_quote "$mirror")" "$(mirror_refspecs)"
        printf '    echo from=mirror\n    exit 0\nfi\n'
    fi
    printf 'rc=0\n'
    for r in $(wk_mirror_default_remotes); do
        printf 'if git remote get-url %s >/dev/null 2>&1; then\n' "$(sh_quote "$r")"
        printf '    git fetch --no-tags --prune --quiet %s %s || rc=1\nfi\n' \
            "$(sh_quote "$r")" "$(net_refspecs "$r")"
    done
    printf 'echo from=remotes\nexit $rc\n'
}

# tests/test_sync.py and tests/test_new_fetch.py source this file for its helpers; `wk` always execs it, so a real run cannot take this arm.
if (return 0 2>/dev/null); then
    [ "${1:-}" = functions ] && return 0
fi

USAGE="usage: wk sync [<workspace>|--target <target>|--all|--tools [<target>]]"
SCOPE=""            # ws | target | all | tools -- what this run brings up to date
SCOPE_AS=""         # how it was spelled, for a message about two of them
ONLY="${WK_NAME:-}" # the workspace named, if one was
TARGET=""           # the target --target or --tools named, if one was
_v=""               # the value a flag was given, while it is being checked

scope_set() { # <scope> <as-typed>
    [ -z "$SCOPE" ] || die "$SCOPE_AS and $2 ask for different things -- one at a time.
    $USAGE"
    SCOPE="$1"; SCOPE_AS="$2"
}

# What the dispatcher's where=host and name checks leave unrefused in here is a *different* workspace's name, checked before the loop.
if in_workspace && [ -n "${1:-}" ]; then
    case "$1" in
        -*|"$(wk_self)") ;;
        *) die "'wk sync $1' acts on a host, and this is workspace '$(wk_self)'.
    From the host:  wk sync $1" ;;
    esac
fi

while [ $# -gt 0 ]; do
    case "$1" in
        --all)  scope_set all --all; shift ;;
        --target|--target=*)
            _v=""
            case "$1" in --target=*) _v="${1#*=}" ;; *) _v="${2:-}" ;; esac
            [ -n "$_v" ] || die "--target names the target whose workspaces to fetch in.
    'wk status' names them; 'wk sync --all' is every one of them."
            [ -z "$TARGET" ] || die "one target at a time (got '$TARGET' and '$_v')"
            TARGET="$_v"
            case "$1" in --target=*) shift ;; *) shift 2 ;; esac
            scope_set target --target ;;
        --tools|--tools=*)
            case "$1" in
                --tools=*)
                    _v="${1#*=}"
                    [ -n "$_v" ] || die "--tools= names one target; --tools alone is every one of them."
                    [ -z "$TARGET" ] || die "one target at a time (got '$TARGET' and '$_v')"
                    TARGET="$_v"; shift ;;
                *)  shift
                    case "${1:-}" in ''|-*) ;;
                        *) [ -z "$TARGET" ] || die "one target at a time (got '$TARGET' and '$1')"
                           TARGET="$1"; shift ;;
                    esac ;;
            esac
            scope_set tools --tools ;;
        --machine)  die "'wk sync --machine' is gone: it meant a machine's furniture and
    every workspace on it at once. Say which:
        wk sync --all         every workspace on every target
        wk sync --tools       every machine's wk-tools, mirror and snapshot
        wk sync --tools <t>   just that one's" ;;
        -*)         die "unknown option: $1
    $USAGE" ;;
        *)          [ -z "$ONLY" ] || die "one workspace at a time (got '$ONLY' and '$1')"
                    ONLY="$1"; require_name "$ONLY"; shift ;;
    esac
done

[ -z "$ONLY" ] || scope_set ws "'$ONLY'"

if [ -n "$TARGET" ]; then
    ( load_target "$TARGET" >/dev/null ) || exit 1
fi

if [ -z "$SCOPE" ] && [ -z "$ONLY" ]; then
    _ws=$(list_workspaces)
    _n=$(printf '%s\n' "$_ws" | grep -c . || true)
    _n="${_n:-0}"
    _tty=0; [ -t 0 ] && _tty=1
    _decision=$(sync_scope_decide "$_n" "$_tty")
    case "$_decision" in
        empty)
            info "no workspaces on this machine, so there is nothing to fetch in."
            log  "  bringing its furniture up to date instead: the tooling, the mirror,"
            log  "  and a snapshot for the first workspace made here."
            SCOPE=tools ;;
        one)
            ONLY="$_ws"; SCOPE=ws
            info "one workspace here, so that is the one: $ONLY"
            log  "  'wk sync --tools' for the mirror, the snapshot and the tooling" ;;
        refuse)
            die "several workspaces here and no terminal to ask which:
    $(printf '%s ' $_ws)
    Name one, or give a scope: 'wk sync --all', 'wk sync --tools'." ;;
        ask)
            info "several workspaces on this machine:"
            _i=0
            for _w in $_ws; do _i=$((_i + 1)); printf '  %2d) %s\n' "$_i" "$_w" >&2; done
            printf '  %2d) %s\n' "$((_i + 1))" "all of them here (--target $(default_target))" >&2
            printf '  %2d) %s\n' "$((_i + 2))" "this machine's tooling, mirror and snapshot (--tools)" >&2
            printf 'which? [1-%d] ' "$((_i + 2))" >&2
            read -r _pick </dev/tty || _pick=""
            _decision=$(sync_scope_decide "$_n" 1 "$_pick")
            case "$_decision" in
                all)      SCOPE=target; TARGET=$(default_target) ;;
                tools)    SCOPE=tools ;;
                pick\ *)  ONLY=$(printf '%s\n' "$_ws" | sed -n "${_decision#pick }p"); SCOPE=ws ;;
                invalid)  die "nothing chosen -- name a workspace, or a scope: --all, --tools" ;;
                *)        die "$_pick is not one of them" ;;
            esac ;;
    esac
fi

# walk_targets, not target_all: a machine answering another machine's --tools (WK_NO_DELEGATE) refreshes what it holds and asks nobody, so a sweep cannot bounce between peers.
sync_furniture() { # <target>, or empty for every target this machine knows
    local only="${1:-}" _bad=0 _t _targets
    if [ -n "$only" ]; then _targets="$only"; else _targets=$(walk_targets); fi
    for _t in $_targets; do
        (
            load_target "$_t" >/dev/null || exit 3
            [ -z "$only" ] || { WK_SYNC_NAMED=1; export WK_SYNC_NAMED; }
            t_sync
        ) || _bad=$((_bad + 1))
    done
    info "'wk status' compares every copy against this one"
    if [ "$_bad" -ne 0 ]; then
        warn "$_bad target(s) did not take the tooling -- see above"
        return 1
    fi
    return 0
}

sync_workspaces() {
    local ws st n=0 bad=0 rc out
    local -a names=()
    for ws in "$@"; do names+=("$ws"); done
    [ "${#names[@]}" -gt 0 ] || return 0

    info "fetching in ${#names[@]} workspace(s) -- $(wk_mirror_default_remotes)"
    for ws in "${names[@]}"; do
        (
            load_target "$(ws_target "$ws")" >/dev/null 2>&1 || exit 3
            st=$(ws_state "$ws" 2>/dev/null) || st=absent
            if [ "$st" != present ]; then
                printf '  %-24s %s\n' "$ws" "$st -- skipped" >&2
                exit 2
            fi
            printf '  %-24s ' "$ws" >&2

            stage_begin
            out=$(t_exec "$ws" sh -c \
                    "$(ws_fetch_script "$(t_src "$ws")" "$(t_mirror_dir "$ws")")" \
                    2>/dev/null) && rc=0 || rc=$?
            stage_end "workspace fetch $ws"
            if [ "$rc" = 0 ]; then
                case "$out" in
                    *from=mirror*)  echo "ok  (from the mirror)" >&2 ;;
                    *)              echo "ok  (over the network: no mirror in this workspace -- remake it to get one)" >&2 ;;
                esac
                exit 0
            fi
            echo "FAILED (continuing)" >&2
            exit 1
        ) && rc=0 || rc=$?
        # `&& rc=0 || rc=$?`, not a bare `( … )`: under `set -e` a non-zero compound command would end the run at one unreachable workspace.
        case "$rc" in
            0)   n=$((n + 1)) ;;
            2)   [ "$SCOPE" != ws ] || die "workspace '$ONLY' is not there to fetch in
    ('wk status $ONLY' says what it is; 'wk ls' lists the ones there are)" ;;
            *)   bad=$((bad + 1)) ;;
        esac
    done
    [ "$bad" -eq 0 ] || warn "$bad workspace(s) did not fetch -- 'wk enter <ws>' and try it by hand"
    return 0
}

# One workspace at a time, by name, never a scope word: what a scope means is decided by *that* machine's copy of wk-tools, a different version as often as not.
sync_target() { # <target>
    local _t="$1" _ws
    if ( load_target "$_t" >/dev/null 2>&1; [ -n "${WK_REMOTE_PEER:-}" ] ); then
        _ws=$( ( load_target "$_t" >/dev/null || exit 3; target_workspaces ) )
        [ -n "$_ws" ] || { info "no workspaces on $_t"; return 0; }
        info "$_t holds its own workspaces -- asking it to fetch in each"
        (
            load_target "$_t" >/dev/null || exit 3
            for _w in $_ws; do
                WK_NO_DELEGATE=1 t_wk sync "$_w" \
                    || warn "$_t did not fetch in '$_w' -- see above"
            done
        )
        return 0
    fi
    # On macOS the container store lives inside the podman VM, so every workspace out here reads as "creating" from an invisible base-id.
    if ( load_target "$_t" >/dev/null 2>&1; t_needs_base && ! store_is_local ); then
        info "$_t keeps its workspaces' records in the podman VM, not out here"
        log  "  from in there:  wk sync <workspace>, or a bare 'wk sync' for the menu"
        return 0
    fi

    _ws=$( ( load_target "$_t" >/dev/null || exit 3; target_workspaces ) )
    [ -n "$_ws" ] || { info "no workspaces on $_t"; return 0; }
    # WK_TARGET: these names came from this target, so ws_target must not ask every other one where each lives -- an ssh probe per workspace per target.
    # shellcheck disable=SC2086 -- deliberate word splitting of the name list.
    ( export WK_TARGET="$_t"; sync_workspaces $_ws )
}

case "$SCOPE" in
    ws)
        in_workspace || store_init
        sync_workspaces "$ONLY"
        log "'git rebase origin/main' in the workspace moves onto what it just fetched."
        exit 0 ;;
    target)
        sync_target "$TARGET"
        log "'git rebase origin/main' in a workspace moves it onto what was just fetched."
        exit 0 ;;
    all)
        for _t in $(walk_targets); do sync_target "$_t"; done
        log "'git rebase origin/main' in a workspace moves it onto what was just fetched."
        exit 0 ;;
esac

FURNITURE_RC=0
sync_furniture "$TARGET" || FURNITURE_RC=1

local_store_named "$TARGET" || exit "$FURNITURE_RC"

# On macOS $WK_STORE is /var/lib/wk *inside the podman VM*, unreadable from out here. Said rather than attempted: a permission error would name no remedy.
if ! store_is_local; then
    echo >&2
    info "the mirror and the snapshot are in the podman VM, not out here"
    log  "  the tooling copies above are done. For the rest:"
    log  "      wk sync    forwards into the VM, and offers them there"
    exit "$FURNITURE_RC"
fi

store_init

# Exclusive: two of these racing would hardlink from each other's half-published snapshot. It also holds off `wk gc` and `wk new`.
hold_lock store

MIRROR=$(wk_mirror)


if [ -d "$MIRROR" ]; then
    unchanged "mirror exists"
else
    info "creating bare mirror (first run: this clones all of WebKit)"
fi

info "fetching $(wk_mirror_default_remotes) (origin: $(wk_mirror_branches))"

stage_begin
{ sh -c "$(mirror_refresh_script "$MIRROR")" 2>/dev/null \
      || warn "the mirror refresh did not finish"; } \
    | while read -r _tag _name _state; do
          [ "$_tag" = mirror-fetch ] || continue
          case "$_state" in
              ok) printf '  %-8s ok\n' "$_name" >&2 ;;
              *)  printf '  %-8s FAILED (continuing)\n' "$_name" >&2 ;;
          esac
      done
stage_end "mirror fetch"

git -C "$MIRROR" rev-parse --verify --quiet refs/heads/main >/dev/null \
    || die "main was not fetched into the mirror; cannot publish a snapshot"
_mirror_main_sha=$(git -C "$MIRROR" rev-parse refs/heads/main)


BRANCH="${WK_BRANCH:-origin/main}"
NEW_ID=$(date -u +%Y%m%dT%H%M%SZ)
NEW_DIR="$(wk_base_dir)/$NEW_ID"
NEW_TREE="$NEW_DIR/WebKit"

PREV_ID=$(current_base 2>/dev/null || true)

# Hardlinking a half-published snapshot then fetching fails with "not a git repository" *after* copying everything, leaving a second broken one.
if [ -n "$PREV_ID" ] && [ ! -d "$(base_path "$PREV_ID")/.git" ]; then
    warn "previous snapshot $PREV_ID is not a git checkout; ignoring it"
    log  "  (remove it with: wk gc)"
    PREV_ID=""
fi

if [ -n "$PREV_ID" ] && ! _why=$(base_verify "$PREV_ID"); then
    warn "$_why"
fi

# Skipped only for the default branch, where the mirror's own head is exactly the ref checked out; a non-default WK_BRANCH has no such mapping.
if [ "$BRANCH" = "origin/main" ] && [ -n "$PREV_ID" ] && base_verify "$PREV_ID" >/dev/null 2>&1 \
    && snapshot_current "$(base_recorded_sha "$PREV_ID")" "$_mirror_main_sha"; then
    unchanged "mirror unchanged; base $PREV_ID is already $(printf '%s' "$_mirror_main_sha" | cut -c1-10)"
    log "the workspaces here fetch with 'wk sync --target $(default_target)'."
    exit 0
fi

if [ -n "$PREV_ID" ]; then
    PREV_TREE=$(base_path "$PREV_ID")
    info "snapshotting $PREV_ID -> $NEW_ID"
    ensure_dir "$NEW_DIR"
    stage_begin
    cp -al "$PREV_TREE" "$NEW_TREE"
    stage_end "snapshot publish (cp -al)"
    git -C "$NEW_TREE" remote set-url origin "$MIRROR" 2>/dev/null || true
    git -C "$NEW_TREE" fetch --all --prune --quiet
else
    info "no previous snapshot; checking out $BRANCH (this takes a few minutes)"
    ensure_dir "$NEW_DIR"
    stage_begin
    git clone --quiet "$MIRROR" "$NEW_TREE"
    stage_end "snapshot publish (clone)"
fi

# The mirror lives in the VM and is not mounted into workspaces: as origin it would be an unreachable remote in every workspace.
info "wiring snapshot remotes for workspace use"
sh -c "$(wk_wiring_script "$NEW_TREE")"

_why=$(snapshot_checkout "$NEW_TREE" "$BRANCH") || { rm -rf "$NEW_DIR"; die "$_why"; }
info "checked out on branch $(git -C "$NEW_TREE" symbolic-ref --short HEAD) (tracking $BRANCH)"
# A stray file in the lower layer appears in every workspace built from this snapshot and cannot be deleted from any of them.
git -C "$NEW_TREE" reset --hard --quiet
git -C "$NEW_TREE" clean -qfdx

[ -d "$NEW_TREE/.git" ] || { rm -rf "$NEW_DIR"; die "snapshot $NEW_ID was not published"; }

# `sha` is the completion marker (lib/store.sh), written last and atomically; `branch` goes first, so a snapshot marked complete has everything beside it.
printf '%s\n' "$BRANCH" > "$NEW_DIR/branch"
git -C "$NEW_TREE" rev-parse HEAD > "$NEW_DIR/sha.tmp"
[ -s "$NEW_DIR/sha.tmp" ] || { rm -rf "$NEW_DIR"; die "snapshot $NEW_ID has no HEAD to record"; }
mv "$NEW_DIR/sha.tmp" "$NEW_DIR/sha"

info "published base $NEW_ID ($(cut -c1-10 < "$NEW_DIR/sha"))"

log "the workspaces here fetch with 'wk sync --target $(default_target)'."
exit "$FURNITURE_RC"
