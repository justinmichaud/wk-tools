#!/usr/bin/env bash
#
# wk sync -- bring WebKit, and the tooling, up to date. One verb, three scopes.
#
# Safe to run at any time, including while workspaces are building. Running
# workspaces stay pinned to the snapshot they were created from and are never
# touched; only workspaces created after this runs pick up the new one.
#
#   wk sync                    the workspace you are working in
#   wk sync <workspace>        that one
#   wk sync --machine          everything on this machine: the mirror, a new
#                              snapshot, every workspace here, and every copy of
#                              wk-tools this machine owns
#   wk sync --all              ...and every other machine and workspace there is
#
# --- scope, and why it is not a noun -----------------------------------------
#
# It used to be spelled by naming the thing: `--target container` for the copy of
# wk-tools in the podman VM, `--tools` for the copies everywhere else, `--target
# <machine>` for a build box, a bare `wk sync` for the store, and `--all` for
# nothing at all -- it was accepted and ignored, a no-op kept as a spelling of
# the default. Five spellings across two axes, and the caller had to know which
# noun held the stale copy before they could ask for it to be refreshed. That is
# backwards: not knowing is the reason to run the command.
#
# So the axis is *how far*, and the command works out what that covers. A
# workspace, this machine, or everywhere. Nothing below takes the name of a
# mechanism.
#
# The store half is this machine's and has no target: a container, a macOS guest
# and a workspace acting on itself all take their base from it. A machine
# reached over ssh keeps its own -- its copy of wk-tools and, unless it has a
# shared WebKit of its own, its own mirror -- and none of it is refreshed by
# anything above. That was the gap: `wk sync` on a remote target did nothing for
# it, and the only thing that ever updated the far side was `wk new` (the
# mirror) and `wk build` (the tooling), so a machine you had not built on
# answered every delegated command from whatever copy it was left with. The
# driver decides what its far side is; see t_sync in targets/remote.sh.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# --- a machine of its own ----------------------------------------------------
# Before store_init and before the store lock: neither has anything to do with
# a target on the far end of an ssh, and taking this machine's store lock to
# fetch on another one would block a local sync for the duration.
SCOPE=""
ONLY=""
TARGET=""
_ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --machine)  SCOPE=machine; shift ;;
        --all)      SCOPE=all; shift ;;
        # The old spellings, refused by name. Each named a mechanism, and the
        # scope flags cover all of them; a silent alias would leave two ways to
        # ask one question (CLAUDE.md, "One path, not two").
        --tools)    die "'wk sync --tools' is now part of a scope, not a flag of its own.
    The tooling is one of the things that goes stale on a machine, so it is
    refreshed with everything else there:
        wk sync --machine     this machine's copies
        wk sync --all         every machine's" ;;
        --target|--target=*)
            case "$1" in --target=*) TARGET="${1#*=}" ;;
                         *) TARGET="${2:-}"; shift ;; esac
            die "'wk sync --target ${TARGET:-<machine>}' is gone: the scope is how far, not
    which mechanism.
        wk sync --machine     this machine, whatever it holds
        wk sync --all         every machine, including ${TARGET:-that one}
    'wk status' says which copy is behind, if that is the question." ;;
        -*)         die "unknown option: $1
    usage: wk sync [<workspace>] [--machine|--all]" ;;
        # A workspace name: that one rather than the one you are in.
        *)          [ -z "$ONLY" ] || die "one workspace at a time (got '$ONLY' and '$1')"
                    ONLY="$1"; require_name "$ONLY"; _ARGS+=("$1"); shift ;;
    esac
done
set -- ${_ARGS[@]+"${_ARGS[@]}"}

[ -z "$ONLY" ] || [ -z "$SCOPE" ] \
    || die "'$ONLY' and --$SCOPE ask for different things: one workspace, or all of them."

# --- autodetect, then ask ----------------------------------------------------
#
# With no workspace named and no scope given, the answer is "the one you are
# working in" -- and the command works out what that is rather than making the
# caller say it.
#
# Inside a workspace there is nothing to work out. On a host there is, and the
# rule is: one workspace is unambiguous and is used; several is a question, and
# it is *asked* rather than guessed or refused, because a wrong guess here
# fetches in somebody else's workspace and a refusal sends the reader to read
# this file. No terminal means no question can be asked, so it refuses there and
# names the two scopes that need no answer.
if [ -z "$SCOPE" ] && [ -z "$ONLY" ]; then
    if in_workspace; then
        ONLY=$(wk_self)
    else
        _ws=$(list_workspaces)
        _n=$(printf '%s\n' "$_ws" | grep -c . || true)
        case "${_n:-0}" in
            0) info "no workspaces on this machine, so there is nothing to fetch in."
               log  "  syncing the machine instead: the mirror, a new snapshot and the tooling."
               SCOPE=machine ;;
            1) ONLY="$_ws"
               info "one workspace here, so that is the one: $ONLY"
               log  "  'wk sync --machine' for the mirror, the snapshot and the tooling too" ;;
            *) if [ ! -t 0 ]; then
                   die "several workspaces here and no terminal to ask which:
    $(printf '%s ' $_ws)
    Name one, or give a scope: 'wk sync --machine', 'wk sync --all'."
               fi
               info "several workspaces on this machine:"
               _i=0
               for _w in $_ws; do _i=$((_i + 1)); printf '  %2d) %s\n' "$_i" "$_w" >&2; done
               printf '  %2d) %s\n' "$((_i + 1))" "all of them, and this machine's mirror, snapshot and tooling (--machine)" >&2
               printf 'which? [1-%d] ' "$((_i + 1))" >&2
               read -r _pick </dev/tty || _pick=""
               case "$_pick" in
                   ''|*[!0-9]*) die "nothing chosen -- name a workspace, or 'wk sync --machine'" ;;
               esac
               if [ "$_pick" -eq "$((_i + 1))" ]; then
                   SCOPE=machine
               elif [ "$_pick" -ge 1 ] && [ "$_pick" -le "$_i" ]; then
                   ONLY=$(printf '%s\n' "$_ws" | sed -n "${_pick}p")
               else
                   die "$_pick is not one of them"
               fi ;;
        esac
    fi
fi

# --tools: the tooling on every machine, and nothing else.
#
# Every machine here runs a *copy* of this repository -- rsynced into the podman
# VM, rsynced onto a build box, its own git checkout on a peer workstation -- and
# a stale copy fails as "unknown option" from a command that works perfectly on
# the machine you typed it on. `wk status` says which are behind; this is the
# one command that fixes all of them.
#
# No mirror and no snapshot: this is about the tooling, and a full sync is
# minutes of fetch that somebody asking for `--tools` did not ask for.
# Why a peer's `git pull` could not reach this machine's tree. The answer is
# always on this side -- a peer pulls from the shared upstream, so anything this
# machine has not published is invisible to it -- and it is worth naming
# precisely, because the three cases have three different fixes.
_peer_why_behind() {
    local dirty="" ahead="" branch="" up=""
    git -C "$WK_ROOT" rev-parse --git-dir >/dev/null 2>&1 || {
        printf 'this copy of wk-tools is not a git checkout, so nothing can pull from it'
        return 0; }
    [ -n "$(git -C "$WK_ROOT" status --porcelain 2>/dev/null)" ] && dirty=1
    branch=$(git -C "$WK_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    up=$(git -C "$WK_ROOT" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || true)
    if [ -n "$up" ]; then
        ahead=$(git -C "$WK_ROOT" rev-list --count "$up..HEAD" 2>/dev/null || echo 0)
    fi
    if [ -n "$dirty" ]; then
        printf 'this machine has uncommitted changes -- a peer pulls from %s, so commit and push them first' \
            "${up:-the upstream}"
    elif [ -n "$up" ] && [ "${ahead:-0}" -gt 0 ]; then
        printf 'this machine is %s commit(s) ahead of %s -- push them, then re-run' "$ahead" "$up"
    elif [ -z "$up" ]; then
        printf "branch '%s' has no upstream here, so there is nothing for a peer to pull from" "${branch:-HEAD}"
    else
        printf 'both are at %s, so the difference is untracked or excluded files rather than commits' "$up"
    fi
}

# The tooling on every machine. Part of --machine and --all rather than a flag,
# because a stale copy of this repository is one of the two things that goes out
# of date on a machine and the caller should not have to know which of them they
# meant.
#
# Every machine here runs a *copy* of this repository -- rsynced into the podman
# VM, rsynced onto a build box, its own git checkout on a peer workstation -- and
# a stale copy fails as "unknown option" from a command that works perfectly on
# the machine you typed it on. `wk status` says which are behind; this is what
# fixes all of them.
sync_tools() {
    local _bad=0 _t
    for _t in $(target_all); do
        # A subshell per target, with its own driver: a driver is a sourced file
        # that sets globals, and one target's overrides outliving it is a bug
        # this repository has already had.
        (
            load_target "$_t" >/dev/null 2>&1 || exit 3
            case "$WK_TARGET_KIND" in
            container)
                # The copy every container bind-mounts. On a Linux workstation
                # that is this checkout and there is nothing to push, which
                # t_sync says in those words.
                t_sync ;;
            vm)
                # Per guest, and only the ones that are up: a guest's copy is
                # inside it, and booting one to refresh a file would be a
                # side effect nobody asked this command for.
                for _g in $(target_workspaces); do
                    [ "$(t_info "$_g" 2>/dev/null)" = running ] || {
                        printf '  %-24s %s\n' "$_g" "not running -- skipped" >&2; continue; }
                    t_sync_tools "$_g" && printf '  %-24s ok\n' "$_g" >&2
                done ;;
            remote)
                if [ -n "${WK_REMOTE_PEER:-}" ]; then
                    # A workstation runs a checkout of its own, under git, and
                    # rsyncing over it would throw away whatever it had
                    # uncommitted. So it pulls -- and --ff-only, because a
                    # merge on somebody else's machine is not this command's to
                    # make.
                    #
                    # And then it is *checked*, which is the half that was
                    # missing. A pull can only bring a peer level with this
                    # machine if what this machine has is committed and pushed;
                    # with a dirty tree here it succeeds, says "Already up to
                    # date", and converges nothing -- and this command printed
                    # "pulled" and exited 0 while `wk status` went on reporting
                    # the peer as behind, offering the pull that had just run as
                    # the remedy. A sync that cannot converge has to say so and
                    # name the reason, which is on this side, not the peer's.
                    _h=$(t_ssh_host "" 2>/dev/null) || exit 0
                    ssh -o BatchMode=yes -o ConnectTimeout="${WK_SSH_TIMEOUT:-10}" "$_h" \
                        "cd $(sh_quote "$(t_tools "")") && git pull --ff-only" >&2 \
                        || { printf '  %-24s %s\n' "$_t" "git pull --ff-only failed there" >&2; exit 1; }

                    _mine=$("$WK_ROOT/cmd/version" --tree 2>/dev/null || true)
                    _theirs=$(ssh -o BatchMode=yes -o ConnectTimeout="${WK_SSH_TIMEOUT:-10}" "$_h" \
                        "$(sh_quote "$(t_tools "")")/cmd/version --tree" 2>/dev/null || true)
                    if [ -n "$_mine" ] && [ "$_mine" = "$_theirs" ]; then
                        printf '  %-24s pulled, in sync\n' "$_t" >&2
                        exit 0
                    fi
                    printf '  %-24s %s\n' "$_t" "pulled, still DIFFERS ($_theirs, this machine has $_mine)" >&2
                    printf '  %-24s %s\n' "" "$(_peer_why_behind)" >&2
                    exit 1
                else
                    t_sync_tools "" && printf '  %-24s pushed\n' "$_t" >&2
                fi ;;
            esac
        ) || _bad=$((_bad + 1))
    done
    info "'wk status' compares every copy against this one"
    # Non-zero when something did not converge. It used to exit 0 regardless,
    # which made the warning decoration: a caller could not tell a fleet that
    # took the tooling from one that did not, and neither could a person reading
    # only the last line.
    if [ "$_bad" -ne 0 ]; then
        warn "$_bad target(s) did not take the tooling -- see above"
        return 1
    fi
    return 0
}

# Every other machine's own store: its mirror, and whatever else a driver keeps
# on the far side. Only --all reaches this -- a machine's own store is not this
# machine's business until the scope says everywhere.
sync_far_stores() {
    local _t
    for _t in $(target_all); do
        # Which targets have a far side is the drivers' answer, not a list kept
        # here: t_sync returns 1 for every target whose base is this machine's
        # store, and walking onto one of those is nothing to report.
        ( load_target "$_t" >/dev/null 2>&1 || exit 0; t_sync ) || true
    done
}

# --- one workspace -----------------------------------------------------------
#
# The default scope, and the answer to "you should not need to recreate a
# container to get up to date WebKit": the fetch happens *inside* the workspace,
# from the mirror mounted at /mirror, so `git log origin/main` and a rebase see
# today's upstream without anything being remade.
if [ -z "$SCOPE" ]; then
    # No store lock and no snapshot: this touches one workspace's own object
    # store and nothing this machine shares.
    store_init
    sync_workspaces "$ONLY"
    log "'git rebase origin/main' in the workspace moves onto what it just fetched."
    exit 0
fi

# Every copy of this repository on this machine, and on every other one when the
# scope is everywhere. Part of the scope rather than a flag: the tooling is one
# of the two things that go stale on a machine, and the caller should not have to
# know which of the two they meant.
#
# Before the store half, not after it: on a Mac the store half is not this
# machine's to do and the fleet is, so doing the fleet first means `--machine`
# always accomplishes the part it can before saying where the rest lives.
sync_tools || true
[ "$SCOPE" = all ] && sync_far_stores

# --- the store half, and where it can run ------------------------------------
#
# On a Linux workstation the store is this machine's and all of this runs here.
# On a macOS workstation it is not: $WK_STORE is /var/lib/wk *inside the podman
# VM*, which the Mac can neither create nor read -- so the mirror, the snapshot
# and the workspaces are all in there, while the fleet is reachable only from out
# here. `--machine` on a Mac is therefore genuinely two halves on two machines.
#
# Said, rather than attempted: what attempting it looked like was
# `mkdir: /var/lib/wk: Permission denied`, which names no machine and no remedy.
if ! store_is_local; then
    echo >&2
    info "the mirror, the snapshot and the workspaces are in the podman VM, not out here"
    log  "  the tooling and the fleet above are done. For the store half:"
    log  "      wk sync <workspace>    forwards into the VM, and is the usual answer"
    log  "      wk enter <workspace> and 'wk sync --machine' in there, for all of it"
    exit 0
fi

store_init

# One lock per mutated resource (rule 4), exclusive: this publishes into the
# store and fetches into the mirror, and two of them racing would hardlink from
# each other's half-published snapshot. It also keeps `wk gc` -- which prunes
# exactly the unmarked directory this is building -- out until the snapshot is
# published. `wk new` takes the same lock while it pins a base, so a create
# and a publish serialise rather than overlap.
hold_lock store

MIRROR=$(wk_mirror)

# --- 1. the mirror -----------------------------------------------------------
# Always safe: the mirror is bare and is never an overlay lower layer, so
# nothing a workspace has mounted can be affected by fetching into it.

if [ -d "$MIRROR" ]; then
    unchanged "mirror exists"
else
    info "creating bare mirror (first run: this clones all of WebKit)"
    git init --bare "$MIRROR"
    # Repacking mid-fetch would rewrite packs that snapshots share inodes with.
    # GC runs only from `wk gc`, and only when no workspace is running.
    git -C "$MIRROR" config gc.auto 0
fi

wk_remotes | while read -r name url; do
    [ -n "$name" ] || continue
    if git -C "$MIRROR" remote get-url "$name" >/dev/null 2>&1; then
        git -C "$MIRROR" remote set-url "$name" "$url"
    else
        git -C "$MIRROR" remote add "$name" "$url"
        info "added remote $name"
    fi

    # origin's branches become the mirror's OWN heads; every other upstream is
    # namespaced under refs/remotes/<name>/.
    #
    # This asymmetry is load-bearing. `git clone` copies refs/heads and ignores
    # refs/remotes, so a mirror that filed origin under refs/remotes/origin/
    # would have an empty refs/heads and clone into a repository with no
    # branches at all.
    #
    # Only the branches from wk_mirror_branches are carried: mirroring all ~920
    # of WebKit's branches costs tens of gigabytes for histories that are never
    # checked out.
    if [ "$name" = origin ]; then
        git -C "$MIRROR" config --unset-all "remote.$name.fetch" 2>/dev/null || true
        for _b in $(wk_mirror_branches); do
            git -C "$MIRROR" config --add "remote.$name.fetch" \
                "+refs/heads/$_b:refs/heads/$_b"
        done
    else
        git -C "$MIRROR" config --replace-all "remote.$name.fetch" \
            "+refs/heads/*:refs/remotes/$name/*"
    fi
done

# A bare mirror has no HEAD by default, and `git clone` then warns "remote HEAD
# refers to nonexistent ref, unable to checkout" and produces a repository with
# nothing checked out. Harmless here, because the snapshot is detached to an
# explicit branch below -- but it looks exactly like the failure mode it is not.
git -C "$MIRROR" symbolic-ref HEAD "refs/heads/$(wk_mirror_branches | awk '{print $1}')" 2>/dev/null || true

# Tags carry their own history and WebKit has a great many; they are not needed
# to build a snapshot and would undo the saving above.
git -C "$MIRROR" config remote.origin.tagOpt --no-tags

# Every remote, every time (wk_mirror_default_remotes). What used to be here was
# `origin` by default and everything else behind `--all`, which meant the mirror
# was reliably missing whichever branch somebody was about to want.
_to_fetch=$(wk_mirror_default_remotes)
info "fetching $_to_fetch (origin: $(wk_mirror_branches))"

# Fetch each remote separately rather than `remote update`: one unreachable
# fork (renamed, made private, network blip) would otherwise abort the whole
# sync after a long download and leave no new snapshot. --prune keeps deleted
# upstream branches from accumulating forever.
for name in $_to_fetch; do
    printf '  %-8s ' "$name" >&2
    if git -C "$MIRROR" fetch --prune --quiet "$name" 2>/dev/null; then
        echo "ok" >&2
    else
        echo "FAILED (continuing)" >&2
    fi
done

# origin is the only remote a snapshot actually needs; the rest are conveniences.
# Checked as refs/heads/main because of the refspec asymmetry above.
git -C "$MIRROR" rev-parse --verify --quiet refs/heads/main >/dev/null \
    || die "main was not fetched into the mirror; cannot publish a snapshot"

# --- 2. the snapshot ---------------------------------------------------------

BRANCH="${WK_BRANCH:-origin/main}"
NEW_ID=$(date -u +%Y%m%dT%H%M%SZ)
NEW_DIR="$(wk_base_dir)/$NEW_ID"
NEW_TREE="$NEW_DIR/WebKit"

PREV_ID=$(current_base 2>/dev/null || true)

# A previous snapshot is only useful if it is a working checkout. If it is not
# -- a half-published snapshot from an interrupted sync, or a directory that was
# never one -- hardlinking it and then fetching into it fails with "not a git
# repository" *after* doing all the copying, and leaves a second broken snapshot
# behind for the next run to trip over in the same way.
if [ -n "$PREV_ID" ] && [ ! -d "$(base_path "$PREV_ID")/.git" ]; then
    warn "previous snapshot $PREV_ID is not a git checkout; ignoring it"
    log  "  (remove it with: wk gc)"
    PREV_ID=""
fi

# Rule 5: when the record and the machine disagree, say so rather than trust
# either. Hardlinking from a snapshot somebody fetched into still produces a
# correct new snapshot -- it records its own HEAD -- but the old one is broken
# for everything pinned to it, and that is worth a name and a line.
if [ -n "$PREV_ID" ] && ! _why=$(base_verify "$PREV_ID"); then
    warn "$_why"
fi

if [ -n "$PREV_ID" ]; then
    PREV_TREE=$(base_path "$PREV_ID")
    info "snapshotting $PREV_ID -> $NEW_ID"
    ensure_dir "$NEW_DIR"
    # Hardlinks: one filesystem, so this is effectively free in time and space.
    # It is safe against the previous snapshot because everything that follows
    # either creates a new file or renames over an old one -- git never writes
    # in place -- so the previous snapshot's inodes keep their contents.
    cp -al "$PREV_TREE" "$NEW_TREE"
    git -C "$NEW_TREE" remote set-url origin "$MIRROR" 2>/dev/null || true
    git -C "$NEW_TREE" fetch --all --prune --quiet
else
    info "no previous snapshot; checking out $BRANCH (this takes a few minutes)"
    ensure_dir "$NEW_DIR"
    git clone --quiet "$MIRROR" "$NEW_TREE"
fi

# Point the snapshot's remotes at GitHub rather than at the mirror it was
# cloned from, and add the forks. The mirror lives in the VM and is
# deliberately not mounted into workspaces, so a snapshot keeping it as origin
# would hand every workspace a remote it cannot reach -- and no mirror remote
# is added here for the same reason.
#
# The wiring itself is wk_wiring_script's, shared with every other target, so
# "origin is WebKit/WebKit and my forks are already there" is one statement in
# one place rather than four that drifted.
info "wiring snapshot remotes for workspace use"
sh -c "$(wk_wiring_script "$NEW_TREE")"

info "checking out $BRANCH"
git -C "$NEW_TREE" checkout --quiet --detach "$BRANCH"
# A snapshot must be pristine: a stray file left in the lower layer appears in
# every workspace built from it and cannot be deleted from any of them.
git -C "$NEW_TREE" reset --hard --quiet
git -C "$NEW_TREE" clean -qfdx

# Publication is only complete once the tree is checked out and pristine. Until
# then a failure must not leave something that `current_base` will hand to the
# next `wk new`.
[ -d "$NEW_TREE/.git" ] || { rm -rf "$NEW_DIR"; die "snapshot $NEW_ID was not published"; }

# `sha` is the completion marker (lib/store.sh), so it is written last and
# atomically: everything above can be killed at any point and leaves a
# directory no reader will look at, which `wk gc` removes. `branch` is
# ordinary content and goes first -- a snapshot marked complete must already
# have everything a reader expects to find next to it.
printf '%s\n' "$BRANCH" > "$NEW_DIR/branch"
git -C "$NEW_TREE" rev-parse HEAD > "$NEW_DIR/sha.tmp"
[ -s "$NEW_DIR/sha.tmp" ] || { rm -rf "$NEW_DIR"; die "snapshot $NEW_ID has no HEAD to record"; }
mv "$NEW_DIR/sha.tmp" "$NEW_DIR/sha"

info "published base $NEW_ID ($(cut -c1-10 < "$NEW_DIR/sha"))"

# --- 3. the workspaces --------------------------------------------------------
#
# A snapshot is what a *new* workspace starts from. It does nothing at all for
# the ones that already exist: a workspace's checkout is an overlay whose lower
# layer is the snapshot it was pinned to at creation, and that pin never moves.
# So the second half of "sync" is this one -- every workspace fetches too, and
# one command means "everything here knows about today's upstream".
#
# The fetch happens *inside* the workspace and its source is the mirror, mounted
# read-only at /mirror (targets/container.sh). That is the point of doing it
# here rather than leaving each workspace to `git fetch` for itself: the objects
# are already on this disk, so nothing crosses the network and nothing is
# downloaded twice. A workspace made before that mount existed has no /mirror,
# and falls back to its own remotes -- which is the slow path, over the egress
# proxy, and it says so.
#
# Driven from the host, because that is where the command belongs: inside a
# workspace `wk sync` is refused for the same reason `wk gc` is (it acts on a
# store the workspace cannot see).
#
# One at a time, and a failure is per workspace: a stopped container or a guest
# that is not booted must cost that line and not the run.

# The refspecs a workspace fetches from the mirror with.
#
# The mirror's layout dictates them: origin's branches are its own heads,
# because `git clone` copies refs/heads and ignores refs/remotes -- so a mirror
# that filed origin under refs/remotes would clone into a repository with no
# branches. Every other upstream is therefore namespaced, and each maps onto the
# same namespace in the workspace.
mirror_refspecs() {
    local r out="+refs/heads/*:refs/remotes/origin/*"
    for r in $(wk_mirror_default_remotes); do
        [ "$r" = origin ] && continue
        out="$out +refs/remotes/$r/*:refs/remotes/$r/*"
    done
    printf '%s' "$out"
}

sync_workspaces() {
    local only="$1" ws st n=0 bad=0 rc out specs
    local -a names=()
    specs=$(mirror_refspecs)
    if [ -n "$only" ]; then
        names=("$only")
    else
        for ws in $(list_workspaces); do names+=("$ws"); done
    fi
    [ "${#names[@]}" -gt 0 ] || return 0

    info "fetching in ${#names[@]} workspace(s) -- $(wk_mirror_default_remotes)"
    for ws in "${names[@]}"; do
        # Each workspace in a subshell with its own driver loaded: a driver is a
        # sourced file that sets globals, and one target's overrides outliving it
        # is a bug this repository has already had (`wk status` read every
        # remote workspace's branch with the container driver's function).
        (
            load_target "$(ws_target "$ws")" >/dev/null 2>&1 || exit 3
            st=$(ws_state "$ws" 2>/dev/null) || st=absent
            if [ "$st" != present ]; then
                printf '  %-24s %s\n' "$ws" "$st -- skipped" >&2
                exit 2
            fi
            printf '  %-24s ' "$ws" >&2

            # One exec, and it says which source it used: from /mirror when the
            # workspace has it (no network, the objects are already on this
            # disk), and otherwise from the workspace's own remotes over the
            # egress proxy -- which is the slow path, and worth naming, because
            # the fix is to remake a workspace that predates the mount.
            #
            # Only the remotes it actually has, in that fallback: one made
            # before `wpe` was wired in has no such remote, and naming it would
            # fail the whole fetch over a remote that was never there.
            out=$(t_exec "$ws" sh -c "cd $(sh_quote "$(t_src "$ws")") || exit 1
                    if [ -d /mirror/WebKit.git ]; then
                        git fetch --prune --quiet /mirror/WebKit.git $specs || exit 1
                        echo from=mirror
                        exit 0
                    fi
                    rc=0
                    for r in $(wk_mirror_default_remotes); do
                        git remote get-url \"\$r\" >/dev/null 2>&1 || continue
                        git fetch --prune --quiet \"\$r\" || rc=1
                    done
                    echo from=remotes
                    exit \$rc" 2>/dev/null) && rc=0 || rc=$?
            if [ "$rc" = 0 ]; then
                case "$out" in
                    *from=mirror*)  echo "ok  (from the mirror)" >&2 ;;
                    *)              echo "ok  (over the network: this workspace has no /mirror -- remake it to get one)" >&2 ;;
                esac
                exit 0
            fi
            echo "FAILED (continuing)" >&2
            exit 1
        ) && rc=0 || rc=$?
        # `( … )` on its own line is a compound command, and under `set -e` a
        # non-zero one ends the run -- which here would be one unreachable
        # workspace ending a sync that has more to do.
        case "$rc" in
            0)   n=$((n + 1)) ;;
            2)   [ -z "$only" ] || die "workspace '$only' is not there to fetch in
    ('wk status $only' says what it is; 'wk ls' lists the ones there are)" ;;
            *)   bad=$((bad + 1)) ;;
        esac
    done
    [ "$bad" -eq 0 ] || warn "$bad workspace(s) did not fetch -- 'wk enter <ws>' and try it by hand"
    return 0
}

sync_workspaces ""

# What the reader can do now, and nothing about how the store is laid out.
#
# The note that used to be here explained that a workspace stays pinned to the
# snapshot it was created from and that "only a new workspace gets a new one" --
# which is true of the implementation and reads as "remake the container to get
# current WebKit". That is exactly wrong, and it is the sentence that made a
# person believe it: every workspace has today's upstream in it the moment this
# command finishes. Moving onto it is a rebase, not a rebuild.
#
# The snapshot is how workspaces share a checkout on disk. It is not a version of
# WebKit anybody has to track, so it is not reported as one.
log "'git rebase origin/main' in a workspace moves it onto what was just fetched."
