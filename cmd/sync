#!/usr/bin/env bash
#
# wk sync [<workspace>] [--machine|--all] -- bring WebKit and the tooling up to date
# wk: where=workspace name=optional outside group=sources needs git,rsync
# wk: flag --machine,--all where=host
#
# Safe to run at any time, including while workspaces are building. Running
# workspaces stay pinned to the snapshot they were created from and are never
# touched; only workspaces created after this runs pick up the new one.
#
#   wk sync                    the workspace you are working in
#   wk sync <workspace>        that one
#   wk sync --machine          everything on this machine: the mirror, a new
#                              snapshot, every workspace here, and every copy of
#                              wk-tools this machine owns
#   wk sync --all              ...and every other machine and workspace there is
#
# --- scope, and why it is not a noun -----------------------------------------
# The axis is *how far* (workspace, machine, everywhere), not which mechanism
# holds the stale copy -- the caller should not have to know that before
# asking for a refresh. Nothing below takes the name of a mechanism.
#
# The store half is this machine's alone; a remote target keeps its own copy
# of wk-tools and, without a shared WebKit, its own mirror. See t_sync in
# targets/remote.sh for what a target's far side is.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# --- a machine of its own ----------------------------------------------------
# Before store_init and before the store lock: neither concerns a target on
# the far end of an ssh, and taking this machine's lock to fetch on another
# would block a local sync for no reason.
#
# --machine/--all switch to where=host, skipping $WK_NAME resolution, so a
# workspace name given alongside one is still parsed here and caught by the
# "ask for different things" check below rather than silently ignored.
SCOPE=""
ONLY="${WK_NAME:-}"
TARGET=""
while [ $# -gt 0 ]; do
    case "$1" in
        --machine)  SCOPE=machine; shift ;;
        --all)      SCOPE=all; shift ;;
        # The old spellings, refused by name rather than silently aliased --
        # two ways to ask one question (CLAUDE.md, "One path, not two").
        --tools)    die "'wk sync --tools' is now part of a scope, not a flag of its own.
    The tooling is one of the things that goes stale on a machine, so it is
    refreshed with everything else there:
        wk sync --machine     this machine's copies
        wk sync --all         every machine's" ;;
        --target|--target=*)
            case "$1" in --target=*) TARGET="${1#*=}" ;;
                         *) TARGET="${2:-}"; shift ;; esac
            die "'wk sync --target ${TARGET:-<machine>}' is gone: the scope is how far, not
    which mechanism.
        wk sync --machine     this machine, whatever it holds
        wk sync --all         every machine, including ${TARGET:-that one}
    'wk status' says which copy is behind, if that is the question." ;;
        -*)         die "unknown option: $1
    usage: wk sync [<workspace>] [--machine|--all]" ;;
        # A workspace name: that one rather than the one you are in.
        *)          [ -z "$ONLY" ] || die "one workspace at a time (got '$ONLY' and '$1')"
                    ONLY="$1"; require_name "$ONLY"; shift ;;
    esac
done

[ -z "$ONLY" ] || [ -z "$SCOPE" ] \
    || die "'$ONLY' and --$SCOPE ask for different things: one workspace, or all of them."

# --- autodetect, then ask ----------------------------------------------------
# With nothing named, the answer is "the workspace you're in" -- worked out
# rather than asked for. Inside a workspace $WK_NAME is already set, so this
# block never runs there.
#
# On a host: one workspace is unambiguous and used; several is asked, not
# guessed or refused -- a wrong guess fetches in somebody else's workspace,
# and a refusal just sends the reader here. No terminal means no question can
# be asked, so it refuses and names the two scopes that need no answer.
if [ -z "$SCOPE" ] && [ -z "$ONLY" ]; then
    _ws=$(list_workspaces)
    _n=$(printf '%s\n' "$_ws" | grep -c . || true)
    case "${_n:-0}" in
        0) info "no workspaces on this machine, so there is nothing to fetch in."
           log  "  syncing the machine instead: the mirror, a new snapshot and the tooling."
           SCOPE=machine ;;
        1) ONLY="$_ws"
           info "one workspace here, so that is the one: $ONLY"
           log  "  'wk sync --machine' for the mirror, the snapshot and the tooling too" ;;
        *) if [ ! -t 0 ]; then
               die "several workspaces here and no terminal to ask which:
    $(printf '%s ' $_ws)
    Name one, or give a scope: 'wk sync --machine', 'wk sync --all'."
           fi
           info "several workspaces on this machine:"
           _i=0
           for _w in $_ws; do _i=$((_i + 1)); printf '  %2d) %s\n' "$_i" "$_w" >&2; done
           printf '  %2d) %s\n' "$((_i + 1))" "all of them, and this machine's mirror, snapshot and tooling (--machine)" >&2
           printf 'which? [1-%d] ' "$((_i + 1))" >&2
           read -r _pick </dev/tty || _pick=""
           case "$_pick" in
               ''|*[!0-9]*) die "nothing chosen -- name a workspace, or 'wk sync --machine'" ;;
           esac
           if [ "$_pick" -eq "$((_i + 1))" ]; then
               SCOPE=machine
           elif [ "$_pick" -ge 1 ] && [ "$_pick" -le "$_i" ]; then
               ONLY=$(printf '%s\n' "$_ws" | sed -n "${_pick}p")
           else
               die "$_pick is not one of them"
           fi ;;
    esac
fi

# Only the tooling; no mirror and no snapshot, since a full sync is minutes of
# fetch nobody asking for tooling wanted.
#
# Why a peer's `git pull` could not reach this machine's tree: the answer is
# always on this side -- a peer pulls from the shared upstream, so anything
# this machine hasn't published is invisible to it. Named precisely, because
# the three cases have three different fixes.
_peer_why_behind() {
    local dirty="" ahead="" branch="" up=""
    git -C "$WK_ROOT" rev-parse --git-dir >/dev/null 2>&1 || {
        printf 'this copy of wk-tools is not a git checkout, so nothing can pull from it'
        return 0; }
    [ -n "$(git -C "$WK_ROOT" status --porcelain 2>/dev/null)" ] && dirty=1
    branch=$(git -C "$WK_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    up=$(git -C "$WK_ROOT" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || true)
    if [ -n "$up" ]; then
        ahead=$(git -C "$WK_ROOT" rev-list --count "$up..HEAD" 2>/dev/null || echo 0)
    fi
    if [ -n "$dirty" ]; then
        printf 'this machine has uncommitted changes -- a peer pulls from %s, so commit and push them first' \
            "${up:-the upstream}"
    elif [ -n "$up" ] && [ "${ahead:-0}" -gt 0 ]; then
        printf 'this machine is %s commit(s) ahead of %s -- push them, then re-run' "$ahead" "$up"
    elif [ -z "$up" ]; then
        printf "branch '%s' has no upstream here, so there is nothing for a peer to pull from" "${branch:-HEAD}"
    else
        printf 'both are at %s, so the difference is untracked or excluded files rather than commits' "$up"
    fi
}

# The tooling on every machine, as part of --machine/--all rather than its own
# flag -- the caller shouldn't have to know it's one of the two things that go
# stale. Every machine runs a *copy* of this repo (rsynced into the podman VM,
# onto a build box, or its own git checkout on a peer) and a stale one fails as
# "unknown option" from a command that works fine where it was typed.
# `wk status` says which copies are behind; this fixes them.
sync_tools() {
    local _bad=0 _t
    for _t in $(target_all); do
        # A subshell per target: a driver is a sourced file that sets globals,
        # and letting one target's overrides outlive it corrupts the next.
        (
            load_target "$_t" >/dev/null 2>&1 || exit 3
            case "$WK_TARGET_KIND" in
            container)
                # The copy every container bind-mounts. On a Linux workstation
                # that is this checkout and there is nothing to push, which
                # t_sync says in those words.
                t_sync ;;
            vm)
                # Per guest, and only the ones that are up: a guest's copy is
                # inside it, and booting one to refresh a file would be a
                # side effect nobody asked this command for.
                for _g in $(target_workspaces); do
                    [ "$(t_info "$_g" 2>/dev/null)" = running ] || {
                        printf '  %-24s %s\n' "$_g" "not running -- skipped" >&2; continue; }
                    t_sync_tools "$_g" && printf '  %-24s ok\n' "$_g" >&2
                done ;;
            remote)
                if [ -n "${WK_REMOTE_PEER:-}" ]; then
                    # A workstation runs its own checkout under git; rsyncing
                    # over it would throw away uncommitted work, so it pulls
                    # instead -- --ff-only, since a merge on someone else's
                    # machine isn't this command's to make.
                    #
                    # Then checked: a pull only brings a peer level if what
                    # this machine has is committed and pushed. A dirty tree
                    # here lets the pull succeed while converging nothing, so
                    # that has to be caught and named rather than reported as
                    # success.
                    _h=$(t_ssh_host "" 2>/dev/null) || exit 0
                    ssh -o BatchMode=yes -o ConnectTimeout="${WK_SSH_TIMEOUT:-10}" "$_h" \
                        "cd $(sh_quote "$(t_tools "")") && git pull --ff-only" >&2 \
                        || { printf '  %-24s %s\n' "$_t" "git pull --ff-only failed there" >&2; exit 1; }

                    _mine=$("$WK_ROOT/cmd/version" --tree 2>/dev/null || true)
                    _theirs=$(ssh -o BatchMode=yes -o ConnectTimeout="${WK_SSH_TIMEOUT:-10}" "$_h" \
                        "$(sh_quote "$(t_tools "")")/cmd/version --tree" 2>/dev/null || true)
                    if [ -n "$_mine" ] && [ "$_mine" = "$_theirs" ]; then
                        printf '  %-24s pulled, in sync\n' "$_t" >&2
                        exit 0
                    fi
                    printf '  %-24s %s\n' "$_t" "pulled, still DIFFERS ($_theirs, this machine has $_mine)" >&2
                    printf '  %-24s %s\n' "" "$(_peer_why_behind)" >&2
                    exit 1
                else
                    t_sync_tools "" && printf '  %-24s pushed\n' "$_t" >&2
                fi ;;
            esac
        ) || _bad=$((_bad + 1))
    done
    info "'wk status' compares every copy against this one"
    # Non-zero when something did not converge. Exiting 0 regardless makes the
    # warning decoration: a caller cannot tell a fleet that took the tooling
    # from one that did not, and neither can a person reading
    # only the last line.
    if [ "$_bad" -ne 0 ]; then
        warn "$_bad target(s) did not take the tooling -- see above"
        return 1
    fi
    return 0
}

# Every other machine's own store: its mirror, and whatever else a driver keeps
# on the far side. Only --all reaches this -- a machine's own store is not this
# machine's business until the scope says everywhere.
sync_far_stores() {
    local _t
    for _t in $(target_all); do
        # Which targets have a far side is the drivers' answer, not a list kept
        # here: t_sync returns 1 for every target whose base is this machine's
        # store, and walking onto one of those is nothing to report.
        ( load_target "$_t" >/dev/null 2>&1 || exit 0; t_sync ) || true
    done
}

# --- one workspace -----------------------------------------------------------
# The default scope: the fetch happens *inside* the workspace, from the mirror
# mounted at /mirror, so `git log origin/main` and a rebase see today's
# upstream without anything being remade.
if [ -z "$SCOPE" ]; then
    # No store lock and no snapshot: this touches one workspace's own object
    # store and nothing this machine shares.
    store_init
    sync_workspaces "$ONLY"
    log "'git rebase origin/main' in the workspace moves onto what it just fetched."
    exit 0
fi

# Before the store half, not after: on a Mac the store half isn't this
# machine's to do, but the fleet is -- so `--machine` always accomplishes the
# part it can before saying where the rest lives.
sync_tools || true
[ "$SCOPE" = all ] && sync_far_stores

# --- the store half, and where it can run ------------------------------------
# On Linux the store is this machine's, so all of this runs here. On macOS
# $WK_STORE is /var/lib/wk *inside the podman VM*, unreadable from out here --
# so the mirror, snapshot and workspaces are all in there, and `--machine` on
# a Mac is genuinely two halves on two machines. Said rather than attempted:
# a bare permission error there would name no machine and no remedy.
if ! store_is_local; then
    echo >&2
    info "the mirror, the snapshot and the workspaces are in the podman VM, not out here"
    log  "  the tooling and the fleet above are done. For the store half:"
    log  "      wk sync <workspace>    forwards into the VM, and is the usual answer"
    log  "      wk enter <workspace> and 'wk sync --machine' in there, for all of it"
    exit 0
fi

store_init

# One lock per mutated resource (rule 4), exclusive: this publishes into the
# store and fetches into the mirror, and two of them racing would hardlink from
# each other's half-published snapshot. It also keeps `wk gc` -- which prunes
# exactly the unmarked directory this is building -- out until the snapshot is
# published. `wk new` takes the same lock while it pins a base, so a create
# and a publish serialise rather than overlap.
hold_lock store

MIRROR=$(wk_mirror)

# --- 1. the mirror -----------------------------------------------------------
# Always safe: the mirror is bare and is never an overlay lower layer, so
# nothing a workspace has mounted can be affected by fetching into it.

if [ -d "$MIRROR" ]; then
    unchanged "mirror exists"
else
    info "creating bare mirror (first run: this clones all of WebKit)"
    git init --bare "$MIRROR"
    # Repacking mid-fetch would rewrite packs that snapshots share inodes with.
    # GC runs only from `wk gc`, and only when no workspace is running.
    git -C "$MIRROR" config gc.auto 0
fi

wk_remotes | while read -r name url; do
    [ -n "$name" ] || continue
    if git -C "$MIRROR" remote get-url "$name" >/dev/null 2>&1; then
        git -C "$MIRROR" remote set-url "$name" "$url"
    else
        git -C "$MIRROR" remote add "$name" "$url"
        info "added remote $name"
    fi

    # origin's branches become the mirror's OWN heads (git clone copies
    # refs/heads, ignores refs/remotes -- filing origin there would clone an
    # empty repo); every other upstream is namespaced under refs/remotes/<name>/.
    # Only wk_mirror_branches are carried: all ~920 of WebKit's branches would
    # cost tens of gigabytes for histories nobody checks out.
    if [ "$name" = origin ]; then
        git -C "$MIRROR" config --unset-all "remote.$name.fetch" 2>/dev/null || true
        for _b in $(wk_mirror_branches); do
            git -C "$MIRROR" config --add "remote.$name.fetch" \
                "+refs/heads/$_b:refs/heads/$_b"
        done
    else
        git -C "$MIRROR" config --replace-all "remote.$name.fetch" \
            "+refs/heads/*:refs/remotes/$name/*"
    fi
done

# A bare mirror has no HEAD by default, and `git clone` then warns "remote HEAD
# refers to nonexistent ref, unable to checkout" and produces a repository with
# nothing checked out. Harmless here, because the snapshot is detached to an
# explicit branch below -- but it looks exactly like the failure mode it is not.
git -C "$MIRROR" symbolic-ref HEAD "refs/heads/$(wk_mirror_branches | awk '{print $1}')" 2>/dev/null || true

# Tags carry their own history and WebKit has a great many; they are not needed
# to build a snapshot and would undo the saving above.
git -C "$MIRROR" config remote.origin.tagOpt --no-tags

# Every remote, every time (wk_mirror_default_remotes). `origin` by default with
# everything else behind `--all` leaves the mirror reliably missing whichever
# branch somebody is about to want.
_to_fetch=$(wk_mirror_default_remotes)
info "fetching $_to_fetch (origin: $(wk_mirror_branches))"

# Fetch each remote separately rather than `remote update`: one unreachable
# fork (renamed, made private, network blip) would otherwise abort the whole
# sync after a long download and leave no new snapshot. --prune keeps deleted
# upstream branches from accumulating forever.
for name in $_to_fetch; do
    printf '  %-8s ' "$name" >&2
    if git -C "$MIRROR" fetch --prune --quiet "$name" 2>/dev/null; then
        echo "ok" >&2
    else
        echo "FAILED (continuing)" >&2
    fi
done

# origin is the only remote a snapshot actually needs; the rest are conveniences.
# Checked as refs/heads/main because of the refspec asymmetry above.
git -C "$MIRROR" rev-parse --verify --quiet refs/heads/main >/dev/null \
    || die "main was not fetched into the mirror; cannot publish a snapshot"

# --- 2. the snapshot ---------------------------------------------------------

BRANCH="${WK_BRANCH:-origin/main}"
NEW_ID=$(date -u +%Y%m%dT%H%M%SZ)
NEW_DIR="$(wk_base_dir)/$NEW_ID"
NEW_TREE="$NEW_DIR/WebKit"

PREV_ID=$(current_base 2>/dev/null || true)

# A previous snapshot is only useful if it's a working checkout. If not -- a
# half-published snapshot from an interrupted sync, or never one at all --
# hardlinking then fetching fails with "not a git repository" *after* copying
# everything, leaving a second broken snapshot for the next run to trip on.
if [ -n "$PREV_ID" ] && [ ! -d "$(base_path "$PREV_ID")/.git" ]; then
    warn "previous snapshot $PREV_ID is not a git checkout; ignoring it"
    log  "  (remove it with: wk gc)"
    PREV_ID=""
fi

# Rule 5: when the record and the machine disagree, say so rather than trust
# either. Hardlinking from a broken snapshot still produces a correct new one
# (it records its own HEAD) -- but the old one stays broken for everything
# pinned to it, worth naming.
if [ -n "$PREV_ID" ] && ! _why=$(base_verify "$PREV_ID"); then
    warn "$_why"
fi

if [ -n "$PREV_ID" ]; then
    PREV_TREE=$(base_path "$PREV_ID")
    info "snapshotting $PREV_ID -> $NEW_ID"
    ensure_dir "$NEW_DIR"
    # Hardlinks: one filesystem, so this is effectively free in time and space.
    # It is safe against the previous snapshot because everything that follows
    # either creates a new file or renames over an old one -- git never writes
    # in place -- so the previous snapshot's inodes keep their contents.
    cp -al "$PREV_TREE" "$NEW_TREE"
    git -C "$NEW_TREE" remote set-url origin "$MIRROR" 2>/dev/null || true
    git -C "$NEW_TREE" fetch --all --prune --quiet
else
    info "no previous snapshot; checking out $BRANCH (this takes a few minutes)"
    ensure_dir "$NEW_DIR"
    git clone --quiet "$MIRROR" "$NEW_TREE"
fi

# Point the snapshot's remotes at GitHub rather than the mirror it was cloned
# from, and add the forks. The mirror lives in the VM and isn't mounted into
# workspaces, so keeping it as origin would hand every workspace an
# unreachable remote.
#
# The wiring is wk_wiring_script's, shared with every target, so "origin is
# WebKit/WebKit and forks are already there" is one statement, not four.
info "wiring snapshot remotes for workspace use"
sh -c "$(wk_wiring_script "$NEW_TREE")"

info "checking out $BRANCH"
git -C "$NEW_TREE" checkout --quiet --detach "$BRANCH"
# A snapshot must be pristine: a stray file left in the lower layer appears in
# every workspace built from it and cannot be deleted from any of them.
git -C "$NEW_TREE" reset --hard --quiet
git -C "$NEW_TREE" clean -qfdx

# Publication is only complete once the tree is checked out and pristine. Until
# then a failure must not leave something that `current_base` will hand to the
# next `wk new`.
[ -d "$NEW_TREE/.git" ] || { rm -rf "$NEW_DIR"; die "snapshot $NEW_ID was not published"; }

# `sha` is the completion marker (lib/store.sh), so it is written last and
# atomically: everything above can be killed at any point and leaves a
# directory no reader will look at, which `wk gc` removes. `branch` is
# ordinary content and goes first -- a snapshot marked complete must already
# have everything a reader expects to find next to it.
printf '%s\n' "$BRANCH" > "$NEW_DIR/branch"
git -C "$NEW_TREE" rev-parse HEAD > "$NEW_DIR/sha.tmp"
[ -s "$NEW_DIR/sha.tmp" ] || { rm -rf "$NEW_DIR"; die "snapshot $NEW_ID has no HEAD to record"; }
mv "$NEW_DIR/sha.tmp" "$NEW_DIR/sha"

info "published base $NEW_ID ($(cut -c1-10 < "$NEW_DIR/sha"))"

# --- 3. the workspaces --------------------------------------------------------
# A snapshot only starts a *new* workspace; an existing one's checkout is an
# overlay pinned to its creation-time snapshot, which never moves. So every
# workspace fetches too -- "everything here knows about today's upstream".
#
# Fetched from /mirror (targets/container.sh), so nothing crosses the network
# twice; a workspace made before that mount exists falls back to its own
# remotes over the egress proxy, and says so.
#
# Driven from the host, same as `wk gc`: it acts on a store the workspace
# can't see, so it's refused from inside one. One workspace's failure -- a
# stopped container, an unbooted guest -- costs that line, not the run.

# The refspecs a workspace fetches with, mirroring the mirror's own layout
# (origin under refs/heads, everything else namespaced -- see above).
mirror_refspecs() {
    local r out="+refs/heads/*:refs/remotes/origin/*"
    for r in $(wk_mirror_default_remotes); do
        [ "$r" = origin ] && continue
        out="$out +refs/remotes/$r/*:refs/remotes/$r/*"
    done
    printf '%s' "$out"
}

sync_workspaces() {
    local only="$1" ws st n=0 bad=0 rc out specs
    local -a names=()
    specs=$(mirror_refspecs)
    if [ -n "$only" ]; then
        names=("$only")
    else
        for ws in $(list_workspaces); do names+=("$ws"); done
    fi
    [ "${#names[@]}" -gt 0 ] || return 0

    info "fetching in ${#names[@]} workspace(s) -- $(wk_mirror_default_remotes)"
    for ws in "${names[@]}"; do
        # Each workspace in a subshell with its own driver: letting one
        # target's overrides outlive it corrupts the next target's read.
        (
            load_target "$(ws_target "$ws")" >/dev/null 2>&1 || exit 3
            st=$(ws_state "$ws" 2>/dev/null) || st=absent
            if [ "$st" != present ]; then
                printf '  %-24s %s\n' "$ws" "$st -- skipped" >&2
                exit 2
            fi
            printf '  %-24s ' "$ws" >&2

            # One exec that says which source it used: /mirror when present,
            # else the workspace's own remotes over the slow egress-proxy path
            # (naming the fix: remake a workspace that predates the mount).
            #
            # Only the remotes it actually has: one made before `wpe` was
            # wired in has no such remote, and naming it would fail the whole
            # fetch over one that was never there.
            out=$(t_exec "$ws" sh -c "cd $(sh_quote "$(t_src "$ws")") || exit 1
                    if [ -d /mirror/WebKit.git ]; then
                        git fetch --prune --quiet /mirror/WebKit.git $specs || exit 1
                        echo from=mirror
                        exit 0
                    fi
                    rc=0
                    for r in $(wk_mirror_default_remotes); do
                        git remote get-url \"\$r\" >/dev/null 2>&1 || continue
                        git fetch --prune --quiet \"\$r\" || rc=1
                    done
                    echo from=remotes
                    exit \$rc" 2>/dev/null) && rc=0 || rc=$?
            if [ "$rc" = 0 ]; then
                case "$out" in
                    *from=mirror*)  echo "ok  (from the mirror)" >&2 ;;
                    *)              echo "ok  (over the network: this workspace has no /mirror -- remake it to get one)" >&2 ;;
                esac
                exit 0
            fi
            echo "FAILED (continuing)" >&2
            exit 1
        ) && rc=0 || rc=$?
        # `( … )` on its own line is a compound command, and under `set -e` a
        # non-zero one ends the run -- which here would be one unreachable
        # workspace ending a sync that has more to do.
        case "$rc" in
            0)   n=$((n + 1)) ;;
            2)   [ -z "$only" ] || die "workspace '$only' is not there to fetch in
    ('wk status $only' says what it is; 'wk ls' lists the ones there are)" ;;
            *)   bad=$((bad + 1)) ;;
        esac
    done
    [ "$bad" -eq 0 ] || warn "$bad workspace(s) did not fetch -- 'wk enter <ws>' and try it by hand"
    return 0
}

sync_workspaces ""

# What the reader can do now, not how the store is laid out: every workspace
# already has today's upstream the moment this command finishes -- moving
# onto it is a rebase, not a rebuild. The snapshot is how workspaces share a
# checkout on disk, not a version of WebKit anybody tracks, so it isn't
# reported as one.
log "'git rebase origin/main' in a workspace moves it onto what was just fetched."
