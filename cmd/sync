#!/usr/bin/env python3
#
# wk sync [<workspace>|--mirror|--target <t>|--all|--tools [<t>]] [--fix] -- bring WebKit and the tooling up to date
# wk: where=dynamic name=optional group=sources needs git dryrun opts --all,--target=,--tools,--machine,--mirror,--fix broker --mirror
#
# A fetch, and never a checkout: no branch is switched, merged or rebased, here
# or in a workspace. Safe to run at any time -- workspaces already made stay
# pinned to the snapshot they were created from, and only ones made after this
# pick up the new one.
#
#   wk sync                    this machine: its tooling, its one WebKit mirror,
#                              a new snapshot, then a fetch in every workspace
#                              here -- the containers and the macOS guests
#   wk sync                    inside a workspace: the mirror, then a fetch in
#                              this one. The mirror is mounted read-only in
#                              there, so the refresh is asked of the machine
#                              through the request broker
#   wk sync <workspace>        a fetch in that one workspace, from its mirror
#   wk sync --mirror           the mirror alone -- no snapshot, no tooling, no
#                              workspace. What the brokered refresh above runs
#   wk sync --target <target>  that target's furniture, then its workspaces
#   wk sync --all              every target's furniture, then its workspaces
#   wk sync --tools [<target>] the furniture alone: a machine's copy of
#                              wk-tools, its WebKit mirror, and a new snapshot.
#                              One target's, or all.
#
# Each fetch also reads the checkout's wiring back: `origin` is upstream
# (fetch-only, push URL `no-push://`), each fork pushes over ssh through its
# host alias, and a fetch reads the machine's mirror. A deviation is named
# under the workspace, and so is one in the base snapshot every new workspace
# starts from.
#
#   --fix   before each fetch, re-assert the wiring, point the branch at the
#           fork it pushes to, and finish `git-webkit setup` in a container or
#           guest. Only git config and the commit hooks change -- never a
#           commit or a working tree -- and a checkout already right is left
#           as it is
#
#   WK_DEBUG=1          per-stage timing on stderr: 'stage <name>: <n>s'
#   WK_BRANCH=<branch>  publish the snapshot from this remote-tracking branch
#                       (origin/safari-7620-branch, wpe/wpe-2.46), not origin/main
#
#   0  everything in scope was brought up to date and is wired right
#   1  something did not take, did not fetch, or is wired wrong (above)

import os
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import decl, sync, targets, workspace  # noqa: E402
from wk.act import Refused, die  # noqa: E402
from wk.clock import Clock  # noqa: E402
from wk.lock import Lock  # noqa: E402

USAGE = "usage: wk sync [<workspace>|--mirror|--target <target>|--all|--tools [<target>]] [--fix]"


def parse(argv, name=""):
    """(scope, the workspace named, the target named, --fix): ws | here | target | all | tools | mirror."""
    args = decl.Args(decl.Decl(__file__), argv)
    if args.flag("--machine"):
        die("'wk sync --machine' is gone: it meant a machine's furniture and\n"
            "    every workspace on it at once. Say which:\n"
            "        wk sync --all         every workspace on every target\n"
            "        wk sync --tools       every machine's wk-tools, mirror and snapshot\n"
            "        wk sync --tools <t>   just that one's")

    scope, spelled, target = "", "", ""

    def set_scope(s, as_typed):
        nonlocal scope, spelled
        if scope:
            die("%s and %s ask for different things -- one at a time.\n    %s" % (spelled, as_typed, USAGE))
        scope, spelled = s, as_typed

    values = args.values("--target")
    if len(values) > 1:
        die("one target at a time (got '%s' and '%s')" % (values[0], values[1]))
    if values:
        target = values[0]
    tools = args.flag("--tools")

    # --tools [<target>]: the sole positional, if there is one, is its optional value.
    positionals = list(args.positionals)
    if tools and positionals:
        target = positionals.pop(0)

    scope_named = {"--all": "all" if args.flag("--all") else None,
                  "--mirror": "mirror" if args.flag("--mirror") else None,
                  "--target": "target" if values else None, "--tools": "tools" if tools else None}
    for opt in args.order:   # two scopes are refused in the order they were typed
        named = scope_named.get(opt)
        if named is not None:
            set_scope(named, opt)

    if positionals:
        workspace.require_name(positionals[0])
        name = positionals[0]
    if name:
        set_scope("ws", "'%s'" % name)
    return scope or "here", name, target, args.flag("--fix")


def main(argv):
    reg = targets.Registry(ROOT)
    if argv[:1] == ["--where"]:
        print(sync.where(reg.in_workspace(), argv[1:]))
        return 0
    scope, name, target, fix = parse(argv, os.environ.get("WK_NAME", ""))
    clock = Clock()
    return sync.Sync(reg, clock, Lock(reg.store, reg.machine, clock), scope, name, target, fix).run()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
