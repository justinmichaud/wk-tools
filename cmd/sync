"""bring WebKit and the tooling up to date

A fetch, and never a checkout: no branch is switched, merged or rebased. A workspace stays on the snapshot it was made
from.

  wk sync                    this machine: its tooling, its one WebKit mirror, a new snapshot, then a fetch in every
                             workspace here -- the containers and the macOS guests
  wk sync                    inside a workspace: the mirror, then a fetch in this one. The mirror is mounted read-only
                             in there, so the refresh is asked of the machine through the request broker
  wk sync <workspace>        a fetch in that one workspace, from its mirror
  wk sync --mirror           the mirror alone (asked of the broker in the podman VM); a refresh that moves a ref
                             remounts the mirror share in each running guest
  wk sync --on <place|machine>   that one's furniture, then its workspaces
  wk sync --all              every place's furniture, then its workspaces
  wk sync --tools [<place|machine>]
                             the furniture alone: a machine's copy of wk-tools, its WebKit mirror, and a new snapshot.
                             One place's, or all.

Each fetch also reads the checkout's wiring back: `origin` is upstream (fetch-only, push URL `no-push://`), each fork
pushes over ssh through its host alias, and a fetch reads the machine's mirror. A deviation is named under the
workspace, and so is one in the snapshot every new workspace starts from.

  WK_DEBUG=1          per-stage timing on stderr: 'stage <name>: <n>s'
  WK_BRANCH=<branch>  publish the snapshot from this remote-tracking branch (origin/safari-7620-branch,
                      wpe/wpe-2.46), not origin/main

  0  everything in scope was brought up to date and is wired right
  1  something did not take, did not fetch, or is wired wrong (above)
"""
from wk import images, places, store, sync, workspace
from wk.act import die
from wk.clock import Clock
from wk.decl import Command, Opt
from wk.lock import Lock

ROOT = images.root()
USAGE = "usage: wk sync [<workspace>|--mirror|--on <place|machine>|--all|--tools [<place|machine>]] [--fix]"
COMMAND = Command(where=lambda args, reg: sync.where(reg.in_workspace(), args), name="optional", needs=("git",),
                  group="sources", opts=(
    Opt("--all", "every place's furniture, then its workspaces"),
    Opt("--on", "that one's furniture, then its workspaces", value="<place|machine>"),
    Opt("--tools", "the furniture alone: wk-tools, the WebKit mirror and a new snapshot, of one place or all"),
    Opt("--mirror", "the mirror alone, asked of the request broker", sets=dict(broker=True)),
    Opt("--fix", "before each fetch, re-assert the wiring and finish `git-webkit setup`; only git config and the "
        "commit hooks change")))


def parse(args, name=""):
    """(scope, the workspace named, the place named, --fix): ws | here | place | all | tools | mirror."""
    scope, spelled, place = "", "", ""

    def set_scope(s, as_typed):
        nonlocal scope, spelled
        if scope:
            die("%s and %s ask for different things -- one at a time.\n    %s" % (spelled, as_typed, USAGE))
        scope, spelled = s, as_typed

    values, tools, named = args.values("--on"), args.flag("--tools"), args.name
    if len(values) > 1:
        die("one place at a time (got '%s' and '%s')" % (values[0], values[1]))
    if values:
        place = values[0]
    if tools and named:
        place, named = named, None
    scope_named = {"--all": "all" if args.flag("--all") else None, "--mirror": "mirror" if args.flag("--mirror") else None,
                   "--on": "place" if values else None, "--tools": "tools" if tools else None}
    for opt in args.order:   # two scopes are refused in the order they were typed
        if scope_named.get(opt) is not None:
            set_scope(scope_named[opt], opt)
    if named:
        workspace.require_name(named)
        name = named
    if name:
        set_scope("ws", "'%s'" % name)
    return scope or "here", name, place, args.flag("--fix")


def main(args, inv):
    reg = places.Registry(ROOT)
    scope, name, place, fix = parse(args, store.ws_name())
    clock = Clock()
    return sync.Sync(reg, clock, Lock(reg.store, reg.machine, clock), scope, name, place, fix).run()
