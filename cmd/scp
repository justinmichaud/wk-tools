#!/usr/bin/env python3
#
# wk scp [<workspace>] [-r] <src> <dst> -- copy a file or directory in or out of a workspace
# wk: where=workspace name=required takes=2 here group=workspaces opts -r
#
#   wk scp bug-238 :Tools/foo.js ./foo.js      # out of the workspace
#   wk scp bug-238 ./foo.js :Tools/foo.js      # into it
#   wk scp :WebKitBuild/build.log ~/log        # inside a workspace: no name
#
#   -r   the source may be a directory. The destination becomes a copy of it,
#        contents replaced rather than merged, so an existing one is refused
#        unless --force.

import os
import posixpath
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import decl, targets  # noqa: E402
from wk.act import Refused, barrier, die, info, log, warn  # noqa: E402


def usage(why):
    warn(why)
    log("usage: wk scp [<workspace>] [-r] <src> <dst>")
    log("       wk scp -h for the rest")
    raise Refused(2)


def is_ws_side(p):
    return p.startswith(":") and len(p) > 1


def ws_path(target, name, p):
    p = p[1:]
    if p.startswith("/"):
        return p
    return posixpath.join(target.src(name), p)


def kind_here(p):
    if os.path.isdir(p):
        return "dir"
    if os.path.exists(p):
        return "file"
    return "absent"


def kind_or_die(kind, what, name):
    if kind in ("dir", "file", "absent"):
        return
    die("could not tell what %s is: workspace '%s' did not answer.\n"
        "    'wk status %s' says whether it is up." % (what, name, name))


def main(argv):
    name = os.environ.get("WK_NAME", "")
    args = decl.Args(decl.Decl(__file__), argv)
    recurse = args.flag("-r")
    operands = args.positionals
    if len(operands) != 2:
        usage("needs exactly two paths, a source and a destination")
    src, dst = operands

    src_is_ws, dst_is_ws = is_ws_side(src), is_ws_side(dst)
    if src_is_ws and dst_is_ws:
        usage("both paths are in the workspace -- exactly one side carries the ':'")
    if not src_is_ws and not dst_is_ws:
        usage("neither path is in the workspace -- mark that side with a leading ':', as in :Tools/foo.js")

    reg = targets.Registry(ROOT)
    try:
        target = reg.load(reg.ws_target(name))
    except LookupError as e:
        die(str(e))

    if src_is_ws:
        src_path, src_pfx = ws_path(target, name, src), name + ":"
        dst_path, dst_pfx = dst, ""
        kind_src = lambda p: target.path_kind(name, p)  # noqa: E731
        kind_dst = kind_here
        copy_file = lambda: target.pull(name, src_path, dst_path)  # noqa: E731
        copy_dir = lambda: target.pull_dir(name, src_path, dst_path)  # noqa: E731
    else:
        src_path, src_pfx = src, ""
        dst_path, dst_pfx = ws_path(target, name, dst), name + ":"
        kind_src = kind_here
        kind_dst = lambda p: target.path_kind(name, p)  # noqa: E731
        copy_file = lambda: target.push(name, src_path, dst_path)  # noqa: E731
        copy_dir = lambda: target.push_dir(name, src_path, dst_path)  # noqa: E731

    src_kind = kind_src(src_path)
    kind_or_die(src_kind, src_pfx + src_path, name)
    if src_kind == "absent":
        die("no such file or directory: %s%s" % (src_pfx, src_path))

    dst_kind = kind_dst(dst_path)
    kind_or_die(dst_kind, dst_pfx + dst_path, name)
    if dst_kind == "dir":
        # An existing directory receives the copy under the source's own name, as cp does.
        dst_path = posixpath.join(dst_path, posixpath.basename(src_path.rstrip("/")))
        dst_kind = kind_dst(dst_path)
        kind_or_die(dst_kind, dst_pfx + dst_path, name)

    try:
        if src_kind == "dir":
            if not recurse:
                die("%s%s is a directory -- 'wk scp -r' copies one" % (src_pfx, src_path))
            if dst_kind == "file":
                die("%s%s is a file, and a directory cannot replace it.\n"
                    "    Name a path for the copy, or remove that file first." % (dst_pfx, dst_path))
            if dst_kind == "dir":
                barrier("%s%s already exists, and -r replaces a directory's\n"
                        "    whole contents rather than merging into it" % (dst_pfx, dst_path))
            copy_dir()
        else:
            if dst_kind == "dir":
                die("%s%s is a directory, and a file cannot replace it.\n"
                    "    Name a path for the copy, or remove that directory first." % (dst_pfx, dst_path))
            copy_file()
    except OSError as e:
        die("copying %s%s to %s%s failed%s" % (src_pfx, src_path, dst_pfx, dst_path, ": %s" % e if str(e) else ""))

    info("copied %s%s to %s%s" % (src_pfx, src_path, dst_pfx, dst_path))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
