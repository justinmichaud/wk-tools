#!/usr/bin/env python3
#
# wk scp [<workspace>] [-r] <src> <dst> -- copy a file or directory in or out of a workspace
# wk: where=workspace name=required takes=2 here group=workspaces destructive dryrun opts -r
#
#   wk scp bug-238 :Tools/foo.js ./foo.js      # out of the workspace
#   wk scp bug-238 ./foo.js :Tools/foo.js      # into it
#   wk scp :WebKitBuild/build.log ~/log        # inside a workspace: no name
#
#   -r   the source may be a directory. The destination becomes a copy of it,
#        contents replaced rather than merged.
#
# An existing destination is asked about before it is replaced.

import os
import posixpath
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import webkit  # noqa: E402,F401  first: the WebKit names lab code is handed (wk.project)
from wk import images, store  # noqa: E402

ROOT = images.root()

from wk import decl, places  # noqa: E402
from wk.act import Refused, confirm, die, dry_run, info, log, nothing_to_ask, warn  # noqa: E402


def usage(why):
    warn(why)
    log("usage: wk scp [<workspace>] [-r] <src> <dst>")
    log("       wk scp -h for the rest")
    raise Refused(2)


def ws_path(driver, name, p):
    return p[1:] if p.startswith(":/") else posixpath.join(driver.src(name), p[1:])


def kind_here(p):
    return "dir" if os.path.isdir(p) else "file" if os.path.exists(p) else "absent"


WORD = {"dir": "directory", "file": "file"}


def main(argv):
    name = store.ws_name()
    args = decl.Args(decl.Decl(__file__), argv)
    operands = args.positionals
    if len(operands) != 2:
        usage("needs exactly two paths, a source and a destination")
    src, dst = operands
    src_is_ws, dst_is_ws = [p.startswith(":") and len(p) > 1 for p in operands]
    if src_is_ws == dst_is_ws:
        usage("both paths are in the workspace -- exactly one side carries the ':'" if src_is_ws else
              "neither path is in the workspace -- mark that side with a leading ':', as in :Tools/foo.js")

    reg = places.Registry(ROOT)
    try:
        driver = reg.load(reg.ws_place(name))
    except LookupError as e:
        die(str(e))

    in_ws = lambda p: driver.path_kind(name, p)  # noqa: E731
    if src_is_ws:
        src_path, src_pfx, kind_src = ws_path(driver, name, src), name + ":", in_ws
        dst_path, dst_pfx, kind_dst = dst, "", kind_here
        copies = driver.pull, driver.pull_dir
    else:
        src_path, src_pfx, kind_src = src, "", kind_here
        dst_path, dst_pfx, kind_dst = ws_path(driver, name, dst), name + ":", in_ws
        copies = driver.push, driver.push_dir

    def kind(of, path, pfx):
        k = of(path)
        if k not in ("dir", "file", "absent"):
            die("could not tell what %s%s is: workspace '%s' did not answer.\n"
                "    'wk status %s' says whether it is up." % (pfx, path, name, name))
        return k

    src_kind = kind(kind_src, src_path, src_pfx)
    if src_kind == "absent":
        die("no such file or directory: %s%s" % (src_pfx, src_path))
    if src_kind == "dir" and not args.flag("-r"):
        die("%s%s is a directory -- 'wk scp -r' copies one" % (src_pfx, src_path))
    dst_kind = kind(kind_dst, dst_path, dst_pfx)
    if dst_kind == "dir":
        # An existing directory receives the copy under the source's own name, as cp does.
        dst_path = posixpath.join(dst_path, posixpath.basename(src_path.rstrip("/")))
        dst_kind = kind(kind_dst, dst_path, dst_pfx)
    if dst_kind not in ("absent", src_kind):
        die("%s%s is a %s, and a %s cannot replace it.\n    Name a path for the copy, or remove that %s first."
            % (dst_pfx, dst_path, WORD[dst_kind], WORD[src_kind], WORD[dst_kind]))
    if dst_kind == "absent":
        nothing_to_ask()
    elif not confirm("%s%s already exists; replace it%s?" % (dst_pfx, dst_path, " (a directory's whole contents, not a merge)"
                                                            if dst_kind == "dir" else "")):
        die("not copied")
    try:
        copies[src_kind == "dir"](name, src_path, dst_path)
    except OSError as e:
        die("copying %s%s to %s%s failed%s" % (src_pfx, src_path, dst_pfx, dst_path, ": %s" % e if str(e) else ""))
    if not dry_run():
        info("copied %s%s to %s%s" % (src_pfx, src_path, dst_pfx, dst_path))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
