#!/usr/bin/env bash
#
# wk run <workspace> [options] [-- jsc-args] -- run jsc from a workspace build
# wk: where=workspace name=required ready=yes group=workspaces
#
# Runs the jsc binary a build produced, from the workspace's own build tree on
# its target. Everything after `--` goes to jsc verbatim.
#
#   --config <config>   the build config to run (default: default_config;
#                       wk build --list prints every name)
#   --lldb              run jsc under lldb instead of directly; under
#                       --until-crash each iteration runs under lldb, and a
#                       crash leaves you at its prompt
#   --until-crash       repeat the run until it exits non-zero, in one round
#                       trip into the workspace; keeps the failing iteration's
#                       output, prints its exit status, arguments and any core
#                       file, and exits with that status
#   --max <n>           cap the iterations under --until-crash (default: 200;
#                       reaching it without a crash exits 0)

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/build/configs.sh"

NAME="${WK_NAME:-}"
require_name "$NAME"

CONFIG="${WK_CONFIG:-$(default_config)}"
DEBUGGER=""
UNTIL_CRASH=""
MAX=200
while [ $# -gt 0 ]; do
    case "$1" in
        --config)      CONFIG="${2:-}"; shift 2 ;;
        --lldb)        DEBUGGER=lldb; shift ;;
        --until-crash) UNTIL_CRASH=1; shift ;;
        --max)
            MAX="${2:-}"
            case "$MAX" in
                ''|*[!0-9]*) die "--max needs a positive integer iteration count (got '${2:-}')
    example:  wk run $NAME --until-crash --max 50 -- ..." ;;
            esac
            shift 2 ;;
        --)            shift; break ;;
        *)             break ;;
    esac
done

TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

config_load "$CONFIG" "$(t_os)" || die "unknown config '$CONFIG'"

SRC=$(t_src "$NAME")
JSC=$(config_jsc_path "$SRC")
VAR=$(config_run_var)
DIR=$(config_run_dir "$SRC")

# Prepended, not replaced: a bare assignment drops the wkdev image's jhbuild prefix.
PRELUDE="export $VAR=\"$DIR\${${VAR}:+:\${${VAR}}}\""

if [ -n "$UNTIL_CRASH" ]; then
    HOMEDIR="$(t_home "$NAME")"
    LOGDIR="$HOMEDIR/until-crash"
    CORE_DIR="$HOMEDIR/wk-cores"

    if [ -n "$DEBUGGER" ]; then
        # until-crash-run-file quits lldb only on a 0 status, so a crash leaves its prompt up.
        RUNFILE="$(t_tools "$NAME")/container/lldb/until-crash-run-file"
        CMD="$(lldb_prelude)
$PRELUDE
LOGDIR=$(sh_quote "$LOGDIR")
mkdir -p \"\$LOGDIR\"
i=0
while [ \"\$i\" -lt $MAX ]; do
    i=\$((i + 1))
    STFILE=\$(mktemp)
    WK_UNTIL_CRASH_STATUS=\"\$STFILE\" \"\$LLDB\" $(t_lldb_opts) -s $(sh_quote "$RUNFILE") $(sh_quote "$JSC") -- --validateOptions=1 $(sh_quote "$@")
    STATUS=\$(cat \"\$STFILE\" 2>/dev/null || true)
    rm -f \"\$STFILE\"
    case \"\$STATUS\" in
        ''|0) continue ;;
    esac
    echo \"until-crash: iteration \$i exited \$STATUS -- args: $(sh_quote "$@")\" >&2
    exit \"\$STATUS\"
done
echo \"until-crash: reached the cap of $MAX iterations without a crash\"
exit 0"
        t_exec_tty "$NAME" bash -lc "$CMD"
    else
        JSC_INVOKE="$(sh_quote "$JSC") --validateOptions=1 $(sh_quote "$@")"
        CMD="$PRELUDE
export JSC_validateOptions=1
LOGDIR=$(sh_quote "$LOGDIR")
CORE_DIR=$(sh_quote "$CORE_DIR")
mkdir -p \"\$LOGDIR\"
i=0
while [ \"\$i\" -lt $MAX ]; do
    i=\$((i + 1))
    STAMP=\$(date -u +%Y%m%dT%H%M%SZ)-\$i
    LOG=\"\$LOGDIR/\$STAMP.log\"
    MARK=\"\$LOGDIR/.mark-\$STAMP\"
    touch \"\$MARK\"
    $JSC_INVOKE >\"\$LOG\" 2>&1
    STATUS=\$?
    if [ \"\$STATUS\" -eq 0 ]; then
        rm -f \"\$LOG\" \"\$MARK\"
        continue
    fi
    echo \"until-crash: crashed on iteration \$i (exit \$STATUS)\" >&2
    echo \"until-crash: args: $(sh_quote "$@")\" >&2
    echo \"until-crash: log: \$LOG\" >&2
    CORES=\$(find \"\$CORE_DIR\" -newer \"\$MARK\" -type f 2>/dev/null || true)
    rm -f \"\$MARK\"
    if [ -n \"\$CORES\" ]; then
        echo \"until-crash: core:\" >&2
        printf '%s\n' \"\$CORES\" | sed 's/^/  /' >&2
    fi
    exit \"\$STATUS\"
done
echo \"until-crash: reached the cap of $MAX iterations without a crash\"
exit 0"
        t_exec "$NAME" bash -lc "$CMD"
    fi
    exit $?
fi

# validateOptions: a typo'd JSC flag otherwise fails silently, and the run measures nothing.
if [ -n "$DEBUGGER" ]; then
    CMD="$(lldb_prelude)
$PRELUDE; exec \"\$LLDB\" $(t_lldb_opts) -s $(sh_quote "$(t_tools "$NAME")/container/lldb/run-file") $(sh_quote "$JSC") -- --validateOptions=1 $(sh_quote "$@")"
else
    CMD="$PRELUDE; export JSC_validateOptions=1; exec $(sh_quote "$JSC") --validateOptions=1 $(sh_quote "$@")"
fi

# ssh allocates a pty only when asked; lldb without one accepts no input.
if [ -n "$DEBUGGER" ]; then
    t_exec_tty "$NAME" bash -lc "$CMD"
else
    t_exec "$NAME" bash -lc "$CMD"
fi
