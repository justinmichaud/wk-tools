#!/usr/bin/env bash
#
# wk run <workspace> [config] -- run jsc from a workspace build.
#
# Replaces jscr/jscd/jscrb and friends, which each hardcoded a different
# WebKitBuild path and a different notion of where the checkout lived.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/build/configs.sh"

# Inside a workspace the name is implicit -- see cmd/build. Nothing else on the
# command line can be one, so anything that is not this workspace's own name is
# an option or a jsc argument, including the very first word.
NAME="${1:-}"
if in_workspace && [ "$NAME" != "$(wk_self)" ]; then
    NAME=$(wk_self)
else
    shift || true
fi
require_name "$NAME"

CONFIG="${WK_CONFIG:-jsc-release}"
DEBUGGER=""
while [ $# -gt 0 ]; do
    case "$1" in
        --config) CONFIG="${2:-}"; shift 2 ;;
        --lldb)   DEBUGGER=lldb; shift ;;
        --)       shift; break ;;
        *)        break ;;
    esac
done

config_load "$CONFIG" || die "unknown config '$CONFIG'"

TARGET="${WK_TARGET:-$(target_of "$NAME" 2>/dev/null || default_target)}"
load_target "$TARGET"
[ "$(t_info "$NAME")" != absent ] || die "no such workspace: $NAME"

# Where the products landed, and what the loader needs to find them, both come
# from build/configs.sh -- four ports lay their trees out four ways and the
# Apple build resolves frameworks rather than shared libraries, so hardcoding
# either here is how the old jscr/jscd scripts each ended up wrong.
SRC=$(t_src "$NAME")
JSC=$(config_jsc_path "$SRC")
VAR=$(config_run_var)
DIR=$(config_run_dir "$SRC")

# Run through a login shell so the loader variable can be *prepended* to what
# the environment already provides. Passing `env LD_LIBRARY_PATH=...` instead
# replaces it, and the wkdev image ships libwpe and the rest of the jhbuild
# prefix that way -- so the WPE and GTK binaries then fail to start with a
# missing-library error for a library that was on the path all along.
PRELUDE="export $VAR=\"$DIR\${${VAR}:+:\${${VAR}}}\""

# validateOptions catches typo'd JSC flags, which otherwise fail silently and
# make a benchmark look like it changed when it never ran the intended path.
if [ -n "$DEBUGGER" ]; then
    CMD="$PRELUDE; exec lldb -s $(sh_quote "$(t_tools "$NAME")/container/lldb/run-file") $(sh_quote "$JSC") -- --validateOptions=1 $(sh_quote "$@")"
else
    CMD="$PRELUDE; export JSC_validateOptions=1; exec $(sh_quote "$JSC") --validateOptions=1 $(sh_quote "$@")"
fi

t_exec "$NAME" bash -lc "$CMD"
