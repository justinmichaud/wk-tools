#!/usr/bin/env python3
#
# wk run <workspace> [options] [-- jsc-args] -- run jsc from a workspace build
# wk: where=workspace name=required ready=yes group=workspaces config=--config dryrun opts --config=,--lldb,--until-crash,--max=,--rr,--replay passthrough
#
# Runs the jsc binary a build produced, from the workspace's own build tree on
# its target. Everything after `--` goes to jsc verbatim.
#
#   --config <config>   the build config to run (default: the last build's,
#                       else the platform's; the list is below)
#   --lldb              run jsc under lldb instead of directly; under
#                       --until-crash each iteration runs under lldb, and a
#                       crash leaves you at its prompt
#   --until-crash       repeat the run until it exits non-zero, in one round
#                       trip into the workspace; keeps the failing iteration's
#                       output, prints its exit status, arguments and any core
#                       file, and exits with that status
#   --max <n>           cap the iterations under --until-crash (default: 200;
#                       reaching it without a crash exits 0)
#   --rr                record the run with rr into ~/wk-rr in the workspace
#                       (Linux ports; perf_event_paranoid must be 1 or less)
#   --replay            replay the latest recording under lldb (rr's own commands
#                       are there as `rr ...`); everything after `--` goes to
#                       `rr replay` instead of jsc: a trace directory, -p <pid>

import os
import shlex
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images, store  # noqa: E402

ROOT = images.root()

from wk import buildconf, decl, targets  # noqa: E402
from wk.act import Refused, die  # noqa: E402
from wk.ldpath import LLDB_PRELUDE, prelude, rr_ready, rr_trace_dir  # noqa: E402

LLDB_UNTIL_CRASH = '''{lldb_prelude}
{prelude}
LOGDIR={logdir_q}
mkdir -p "$LOGDIR"
i=0
while [ "$i" -lt {max} ]; do
    i=$((i + 1))
    STFILE=$(mktemp)
    WK_UNTIL_CRASH_STATUS="$STFILE" "$LLDB" {lldb_opts} -s {runfile_q} {jsc_q} -- --validateOptions=1 {tail_q}
    STATUS=$(cat "$STFILE" 2>/dev/null || true)
    rm -f "$STFILE"
    case "$STATUS" in
        ''|0) continue ;;
    esac
    echo "until-crash: iteration $i exited $STATUS -- args: {tail_q}" >&2
    exit "$STATUS"
done
echo "until-crash: reached the cap of {max} iterations without a crash"
exit 0'''

PLAIN_UNTIL_CRASH = '''{prelude}
export JSC_validateOptions=1
LOGDIR={logdir_q}
CORE_DIR={core_dir_q}
mkdir -p "$LOGDIR"
i=0
while [ "$i" -lt {max} ]; do
    i=$((i + 1))
    STAMP=$(date -u +%Y%m%dT%H%M%SZ)-$i
    LOG="$LOGDIR/$STAMP.log"
    MARK="$LOGDIR/.mark-$STAMP"
    touch "$MARK"
    {jsc_invoke} >"$LOG" 2>&1
    STATUS=$?
    if [ "$STATUS" -eq 0 ]; then
        rm -f "$LOG" "$MARK"
        continue
    fi
    echo "until-crash: crashed on iteration $i (exit $STATUS)" >&2
    echo "until-crash: args: {tail_q}" >&2
    echo "until-crash: log: $LOG" >&2
    CORES=$(find "$CORE_DIR" -newer "$MARK" -type f 2>/dev/null || true)
    rm -f "$MARK"
    if [ -n "$CORES" ]; then
        echo "until-crash: core:" >&2
        printf '%s\\n' "$CORES" | sed 's/^/  /' >&2
    fi
    exit "$STATUS"
done
echo "until-crash: reached the cap of {max} iterations without a crash"
exit 0'''

DIRECT_LLDB = '{lldb_prelude}\n{prelude}; exec "$LLDB" {lldb_opts} -s {runfile_q} {jsc_q} -- --validateOptions=1 {tail_q}'

RR_RECORD = '{prelude}; {trace_dir}; export JSC_validateOptions=1; exec rr record {jsc_q} --validateOptions=1 {tail_q}'

RR_REPLAY = '{lldb_prelude}\n{trace_dir}; exec rr replay -d "$LLDB" {tail_q}'

DIRECT_PLAIN = '{prelude}; export JSC_validateOptions=1; exec {jsc_q} --validateOptions=1 {tail_q}'


def parse(argv):
    """The options as the dispatcher hands them on, a declared `--x=` as `--x <value>`; the tail after `--` verbatim."""
    args = decl.Args(decl.Decl(__file__), argv)
    max_raw = args.value("--max") or "200"
    if not max_raw.isdigit():
        die("--max needs a positive integer iteration count (got '%s')\n"
            "    example:  wk run %s --until-crash --max 50 -- ..." % (max_raw, store.ws_name()))
    rr = [f for f in ("--rr", "--replay") if args.flag(f)]
    rest = [f for f in ("--rr", "--replay", "--lldb", "--until-crash") if args.flag(f) and f not in rr[:1]]
    if rr and rest:
        die("%s runs on its own; drop %s" % (rr[0], " ".join(rest)))
    return {"lldb": args.flag("--lldb"), "rr": args.flag("--rr"), "replay": args.flag("--replay"),
            "until_crash": args.flag("--until-crash"), "max": int(max_raw), "tail": args.tail}


def main(argv):
    name = store.ws_name()
    opts = parse(argv)

    reg = targets.Registry(ROOT)
    try:
        target = reg.load(reg.ws_target(name))
    except LookupError as e:
        die(str(e))

    config = store.build_config() or reg.default_config(name)
    try:
        cfg = buildconf.resolve(config, target.os(), target.kind, target.env)
    except LookupError:
        die("unknown config '%s'" % config)

    src = target.src(name)
    jsc = cfg.jsc_path(src)
    var = cfg.run_var()
    pre = prelude(var, cfg.run_dir(src))
    tail_q = shlex.join(opts["tail"])

    if opts["rr"] or opts["replay"]:
        rr_ready(target, name)
        if opts["replay"]:
            cmd = RR_REPLAY.format(lldb_prelude=LLDB_PRELUDE, trace_dir=rr_trace_dir(target), tail_q=tail_q)
        else:
            cmd = RR_RECORD.format(prelude=pre, trace_dir=rr_trace_dir(target), jsc_q=shlex.quote(jsc), tail_q=tail_q)
        argv_, cwd = target.exec_argv(name, ["bash", "-lc", cmd], tty=opts["replay"])
        reg.machine.exec(argv_, cwd)
        return

    if opts["until_crash"]:
        home = target.home()
        if opts["lldb"]:
            cmd = LLDB_UNTIL_CRASH.format(
                lldb_prelude=LLDB_PRELUDE, prelude=pre, logdir_q=shlex.quote(home + "/until-crash"),
                max=opts["max"], lldb_opts=target.lldb_opts(),
                runfile_q=shlex.quote(target.tools(name) + "/container/lldb/until-crash-run-file"),
                jsc_q=shlex.quote(jsc), tail_q=tail_q)
            argv_, cwd = target.exec_argv(name, ["bash", "-lc", cmd], tty=True)
        else:
            cmd = PLAIN_UNTIL_CRASH.format(
                prelude=pre, logdir_q=shlex.quote(home + "/until-crash"), core_dir_q=shlex.quote(home + "/wk-cores"),
                max=opts["max"], jsc_invoke="%s --validateOptions=1 %s" % (shlex.quote(jsc), tail_q), tail_q=tail_q)
            argv_, cwd = target.exec_argv(name, ["bash", "-lc", cmd], tty=False)
        reg.machine.exec(argv_, cwd)
        return

    if opts["lldb"]:
        cmd = DIRECT_LLDB.format(
            lldb_prelude=LLDB_PRELUDE, prelude=pre, lldb_opts=target.lldb_opts(),
            runfile_q=shlex.quote(target.tools(name) + "/container/lldb/run-file"), jsc_q=shlex.quote(jsc), tail_q=tail_q)
        argv_, cwd = target.exec_argv(name, ["bash", "-lc", cmd], tty=True)
    else:
        cmd = DIRECT_PLAIN.format(prelude=pre, jsc_q=shlex.quote(jsc), tail_q=tail_q)
        argv_, cwd = target.exec_argv(name, ["bash", "-lc", cmd], tty=False)
    reg.machine.exec(argv_, cwd)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
