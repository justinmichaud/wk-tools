#!/usr/bin/env bash
#
# wk run <workspace> [config] -- run jsc from a workspace build.
#
# Replaces jscr/jscd/jscrb and friends, which each hardcoded a different
# WebKitBuild path and a different notion of where the checkout lived.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/build/configs.sh"

# Inside a workspace there is no name to give: every command acts on this one,
# and the name form is refused rather than quietly accepted (refuse_ws_name,
# lib/target.sh). Everything else on the command line is this command's own
# argument, including the very first word.
NAME="${1:-}"
if in_workspace; then
    refuse_ws_name "$NAME" run "[--config <config>] [args...]"
    NAME=$(wk_self)
else
    shift || true
fi
require_name "$NAME"

CONFIG="${WK_CONFIG:-$(default_config)}"
DEBUGGER=""
while [ $# -gt 0 ]; do
    case "$1" in
        --config) CONFIG="${2:-}"; shift 2 ;;
        --lldb)   DEBUGGER=lldb; shift ;;
        --)       shift; break ;;
        *)        break ;;
    esac
done

config_load "$CONFIG" || die "unknown config '$CONFIG'"

TARGET="$(ws_target "$NAME")"
load_target "$TARGET"
# One gate for "is this workspace usable yet" (wait_ready, lib/target.sh):
# `absent` is still refused by name, and everything else -- a creation still
# running, one whose driver died, an environment removed from under the record,
# a machine that will not answer -- gets the words that fit it there rather
# than "no such workspace", which is what this said about all four.
wait_ready "$NAME"

# Where the products landed, and what the loader needs to find them, both come
# from build/configs.sh -- four ports lay their trees out four ways and the
# Apple build resolves frameworks rather than shared libraries, so hardcoding
# either here is how the old jscr/jscd scripts each ended up wrong.
SRC=$(t_src "$NAME")
JSC=$(config_jsc_path "$SRC")
VAR=$(config_run_var)
DIR=$(config_run_dir "$SRC")

# Run through a login shell so the loader variable can be *prepended* to what
# the environment already provides. Passing `env LD_LIBRARY_PATH=...` instead
# replaces it, and the wkdev image ships libwpe and the rest of the jhbuild
# prefix that way -- so the WPE and GTK binaries then fail to start with a
# missing-library error for a library that was on the path all along.
PRELUDE="export $VAR=\"$DIR\${${VAR}:+:\${${VAR}}}\""

# validateOptions catches typo'd JSC flags, which otherwise fail silently and
# make a benchmark look like it changed when it never ran the intended path.
if [ -n "$DEBUGGER" ]; then
    CMD="$(lldb_prelude)
$PRELUDE; exec \"\$LLDB\" $(t_lldb_opts) -s $(sh_quote "$(t_tools "$NAME")/container/lldb/run-file") $(sh_quote "$JSC") -- --validateOptions=1 $(sh_quote "$@")"
else
    CMD="$PRELUDE; export JSC_validateOptions=1; exec $(sh_quote "$JSC") --validateOptions=1 $(sh_quote "$@")"
fi

# A debugger needs a terminal and ssh allocates one only when asked. Without
# this the lldb prompt comes up in a session with no pty: it prints, it accepts
# nothing, and ctrl-c kills the whole thing rather than interrupting the
# inferior -- which reads as "lldb is broken in a workspace".
if [ -n "$DEBUGGER" ]; then
    t_exec_tty "$NAME" bash -lc "$CMD"
else
    t_exec "$NAME" bash -lc "$CMD"
fi
