#!/usr/bin/env bash
#
# wk backup -- write live desktop settings back into the repo
# wk: where=host name=none group=hosts
#
# The inverse of ./setup, so the pair is a real round trip. No subverbs or
# flags except --candidates: it reads this host's own live settings and
# writes whichever files apply --
#
#   macOS   host/macos/defaults.conf (refreshed value by value, comments and
#           ordering kept) and host/macos/symbolichotkeys.plist
#   Linux   host/linux/config.dconf, filtered to drop machine-specific and
#           secret entries, with its own leading comment block kept
#
# Two rules make the output restorable rather than merely complete:
#
#   Only settings that were deliberate choices are captured. macOS reports 574
#   preference domains, nearly all of them window positions and per-app state;
#   dumping everything produces a file that cannot be applied to another
#   machine and that changes on every run.
#
#   Credentials are never captured. ~/.config/gh holds an OAuth token, and the
#   dconf tree contains WiFi 802.1X entries. Both are excluded explicitly here,
#   not by hoping the filters happen to miss them.
#
#   wk backup --candidates   macOS only, read-only, changes nothing: scans
#                            every `defaults` domain for a value that differs
#                            from Apple's own default and is not already in
#                            defaults.conf, after dropping window positions,
#                            timestamps, UUIDs and other per-run noise it
#                            cannot tell from a deliberate choice. Prints
#                            "domain key value", sorted, for a maintainer to
#                            read and decide by hand -- it writes nothing.
#
# Every write here goes tmp-file-in-the-target-directory, then `mv`: the
# rename is on one filesystem (unlike a tmp file under /tmp, which a `mv`
# across filesystems would silently turn into a copy) and is what makes a
# kill mid-write safe -- the target is the old file or the new one, never a
# truncated one, and `cmp` first means a run that changes nothing leaves the
# file's mtime alone.

set -euo pipefail
WK_ROOT="${WK_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
. "$WK_ROOT/lib/common.sh"

# Replace <target> with the content already sitting in <tmp> (created next to
# <target> by the caller, so the rename below is same-filesystem) only if it
# differs -- so an unchanged run doesn't bump the mtime, and a process killed
# before this point never touches <target> at all.
atomic_update() { # <target> <tmp> <label>
    local target="$1" tmp="$2" label="$3"
    if cmp -s "$tmp" "$target" 2>/dev/null; then
        unchanged "$label"
        rm -f "$tmp"
    else
        mv -f "$tmp" "$target"
        changed "$label updated"
    fi
}

# Machine-specific and secret entries dropped from a live `dconf dump /`:
# WiFi 802.1X UUIDs, a weather location, terminal profile UUIDs and a GTK
# last-folder path -- none of which belong in a repo, and all of which make
# the file differ on every single run.
dconf_filter() {
    awk '
        /^\[/ {
            skip = 0
            if ($0 ~ /nm-applet/)                   skip = 1
            if ($0 ~ /Ptyxis.*Profiles/)            skip = 1
            if ($0 ~ /org\/gnome\/shell\/weather/)  skip = 1
        }
        skip { next }
        /^last-folder-path=/                  { next }
        /^welcome-dialog-last-shown-version=/ { next }
        /^last-selected-power-profile=/       { next }
        /^looking-glass-history=/             { next }
        /^command-history=/                   { next }
        { print }
    '
}

macos_backup() {
    local conf="$WK_ROOT/host/macos/defaults.conf" tmp domain key type cur

    # Preserve the file's comments and ordering, refreshing only the values.
    # A regenerated-from-scratch file would lose the rationale for each
    # choice, which is most of what makes the file worth keeping.
    tmp=$(mktemp "$conf.XXXXXX")
    while IFS= read -r line; do
        case "$line" in
            ''|'#'*) printf '%s\n' "$line" >> "$tmp"; continue ;;
        esac
        set -- $line
        domain="$1"; key="$2"; type="$3"
        cur=$(defaults read "$domain" "$key" 2>/dev/null || echo "")
        if [ -z "$cur" ]; then
            warn "$domain $key is no longer set; keeping the recorded value"
            printf '%s\n' "$line" >> "$tmp"
            continue
        fi
        case "$type" in
            bool) case "$cur" in 1) cur=true ;; 0) cur=false ;; esac ;;
        esac
        printf '%s %s %s %s\n' "$domain" "$key" "$type" "$cur" >> "$tmp"
    done < "$conf"
    atomic_update "$conf" "$tmp" "defaults.conf"

    # Keyboard shortcuts: a whole domain, exported as XML so the diff is
    # reviewable rather than an opaque binary blob.
    local hk="$WK_ROOT/host/macos/symbolichotkeys.plist" tmp2
    tmp2=$(mktemp "$hk.XXXXXX")
    defaults export com.apple.symbolichotkeys "$tmp2"
    plutil -convert xml1 "$tmp2" >/dev/null
    atomic_update "$hk" "$tmp2" "symbolichotkeys.plist"
}

linux_backup() {
    local out="$WK_ROOT/host/linux/config.dconf" tmp header

    # The file's own leading comment block (everything before the first
    # `[section]` line) documents why each group of settings is tracked;
    # unlike defaults.conf this file is otherwise regenerated whole from the
    # live dump, so that header is carried forward by hand here rather than
    # being something the dump could ever reproduce.
    tmp=$(mktemp "$out.XXXXXX")
    if [ -f "$out" ]; then
        header=$(awk '/^\[/ { exit } { print }' "$out")
        [ -z "$header" ] || printf '%s\n' "$header" > "$tmp"
    fi
    dconf dump / | dconf_filter >> "$tmp"
    atomic_update "$out" "$tmp" "config.dconf"
}

# --- --candidates: macOS only, read-only -------------------------------------
candidates_main() {
    is_macos || die "wk backup --candidates: macOS only (defaults(1) has no Linux equivalent)"
    python3 - "$WK_ROOT/host/macos/defaults.conf" <<'PY'
import plistlib
import subprocess
import sys

conf_path = sys.argv[1]

# (domain, key) pairs defaults.conf already tracks -- never proposed twice.
known = set()
with open(conf_path) as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) >= 2:
            known.add((parts[0], parts[1]))

# Transient, per-run or per-app state a candidate list must not surface,
# one reason each. Matched case-sensitively against Apple's own PascalCase
# naming for these -- a case-insensitive "date" would also catch "Update".
NOISE = [
    (lambda k: k.startswith("NSWindow Frame"), "a saved window position/size"),
    (lambda k: "NSNavLastRootDirectory" in k, "the last folder used in an Open/Save panel"),
    (lambda k: "Recent" in k, "a recently-used-items list"),
    (lambda k: "Date" in k, "a timestamp, not a choice"),
    (lambda k: "UUID" in k, "a machine- or install-specific identifier"),
    (lambda k: k.startswith("TB Default Item Identifiers"), "a toolbar customization snapshot"),
    (lambda k: k.startswith("NSToolbar"), "toolbar layout state"),
    (lambda k: k == "SUEnableAutomaticChecks", "Sparkle's own per-app update-check toggle"),
    (lambda k: "WindowFrame" in k or "Position" in k or "Bounds" in k,
     "a window, dock or Finder position"),
    (lambda k: k.startswith(("NSSplitView", "NSStatusItem", "NSTableView")),
     "AppKit-restored UI layout state"),
]


def is_noise(key):
    return any(match(key) for match, _why in NOISE)


domains = set()
listing = subprocess.run(["defaults", "domains"], capture_output=True, text=True)
domains.update(d.strip() for d in listing.stdout.split(",") if d.strip())
domains.add("NSGlobalDomain")  # `defaults domains` never lists it

results = []
for domain in sorted(domains):
    export = subprocess.run(["defaults", "export", domain, "-"],
                             capture_output=True, timeout=30)
    if export.returncode != 0 or not export.stdout:
        continue
    try:
        data = plistlib.loads(export.stdout)
    except Exception:
        continue
    if not isinstance(data, dict):
        continue
    for key, value in data.items():
        if (domain, key) in known or is_noise(key):
            continue
        if isinstance(value, (dict, list, bytes)):
            continue  # a nested structure is app state, not a scalar choice
        results.append((domain, key, value))

results.sort()
for domain, key, value in results:
    print(domain, key, value)
PY
}

main() {
    if [ "${1:-}" = --candidates ]; then
        candidates_main
        return 0
    fi

    case "$(wk_os)" in
        macos) macos_backup ;;
        linux) linux_backup ;;
    esac

    echo >&2
    if [ "$WK_CHANGES" -eq 0 ]; then
        info "no settings changed since the last backup"
    else
        info "$WK_CHANGES file(s) updated -- review with 'git diff' before committing"
    fi
}

# Guards `main` so tests can `source cmd/backup` (with WK_ROOT already
# pointed at a scratch tree) and call atomic_update/dconf_filter/etc.
# directly, without running the real backup as a side effect.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
