#!/usr/bin/env bash
#
# wk report -- what happened on GitHub this week, in the current repository.
#
# The week's PRs opened, PRs reviewed and issues touched, for the authenticated
# user, printed as three lists. Written for the weekly summary that has to be
# assembled by hand otherwise, out of three searches nobody remembers the
# syntax for.
#
# Runs on the host and nowhere else: it is `gh` and nothing but `gh`, and the
# credential lives here. Read-only -- every call is a search or a view, and
# nothing is created, edited or commented on.
#
# The repository is whichever one the working directory is in, so run it from a
# checkout of the repository you want the summary for.

# The same three lines every other command in this tree starts with: bash from
# the PATH (this was the one file pinned to /bin/bash, which on macOS is 3.2),
# and errors that stop rather than continue into a summary assembled from
# whatever the failed search did not return.
set -euo pipefail

export GH_PAGER=cat

# BSD date first, GNU second: this ran on macOS only for as long as `gh` was
# only ever authenticated here, and the Linux workstation is a host with a
# credential too. `date -v-7d` is a hard error there, and the failure was one
# line into the output.
SINCE_DATE=$(date -v-7d +%Y-%m-%d 2>/dev/null || date -d '7 days ago' +%Y-%m-%d)

REPO_FULL=$(gh repo view --json nameWithOwner --jq .nameWithOwner)

# The GitHub login, asked of GitHub. Not `$USER` -- the *unix* account name,
# which happens to match here and does not everywhere, and which under `set -u`
# is not even guaranteed to be set (an
# agent or a cron job inherits no login shell). Every search below is scoped by
# it, so getting it wrong does not fail: it reports somebody else's week, or an
# empty one, with no sign that anything went wrong.
USER=$(gh api user --jq .login 2>/dev/null) || USER="${USER:-}"
[ -n "$USER" ] || { echo "not authenticated: run 'gh auth login'" >&2; exit 1; }
echo "📊 Weekly GitHub Activity Summary for @$USER in $REPO_FULL since $SINCE_DATE (Week $(date +"%V"))"
echo "📅 Date range: $SINCE_DATE → $(date +%Y-%m-%d)"
echo "📁 Repository: $REPO_FULL"
echo ""
##########################
# ✅ PRs authored
##########################
echo "✅ Pull Requests created:"
gh pr list --author "$USER" --search "created:>=$SINCE_DATE" --state all 
echo ""

echo "✅ Pull Requests updated:"
gh pr list --author "$USER" --search "updated:>=$SINCE_DATE" --state all 
echo ""


##########################
# 🔍 Reviews & Comments
##########################
echo "🔍 Reviews & Comments:"
total_comments=0

# Get PRs with review/comment counts
echo "PRs reviewed/commented:"
gh search prs --repo="$REPO_FULL" --commenter="$USER" --created=">=$SINCE_DATE" 
echo ""

