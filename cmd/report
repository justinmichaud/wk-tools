#!/bin/bash
#
# wk report -- what happened on GitHub this week, in the current repository.
#
# The week's PRs opened, PRs reviewed and issues touched, for the authenticated
# user, printed as three lists. Written for the weekly summary that has to be
# assembled by hand otherwise, out of three searches nobody remembers the
# syntax for.
#
# Runs on the host and nowhere else: it is `gh` and nothing but `gh`, and the
# credential lives here. Read-only -- every call is a search or a view, and
# nothing is created, edited or commented on.
#
# The repository is whichever one the working directory is in, so run it from a
# checkout of the repository you want the summary for.

export GH_PAGER=cat
# Setup

SINCE_DATE=$(date -v-7d +%Y-%m-%d)
#SINCE_DATE=$(date -f '7 days ago' +%Y-%m-%d)
#SINCE_DATE=2024-12-13
REPO_FULL=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
#USER=$(gh api user --jq .login)
echo "📊 Weekly GitHub Activity Summary for @$USER in $REPO_FULL since $SINCE_DATE (Week $(date +"%V"))"
echo "📅 Date range: $SINCE_DATE → $(date +%Y-%m-%d)"
echo "📁 Repository: $REPO_FULL"
echo ""
##########################
# ✅ PRs authored
##########################
echo "✅ Pull Requests created:"
gh pr list --author "$USER" --search "created:>=$SINCE_DATE" --state all 
echo ""

echo "✅ Pull Requests updated:"
gh pr list --author "$USER" --search "updated:>=$SINCE_DATE" --state all 
echo ""


##########################
# 🔍 Reviews & Comments
##########################
echo "🔍 Reviews & Comments:"
total_comments=0

# Get PRs with review/comment counts
echo "PRs reviewed/commented:"
gh search prs --repo="$REPO_FULL" --commenter="$USER" --created=">=$SINCE_DATE" 
echo ""

