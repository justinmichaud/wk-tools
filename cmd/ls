#!/usr/bin/env bash
#
# wk ls -- workspaces, what they are pinned to, and what they cost on disk
# wk: where=workspace name=none bare=merged readonly group=workspaces
#
# One line per workspace, on every target this machine knows:
#
#   NAME      the workspace
#   TARGET    where it lives (container, vm, or a machine)
#   STATE     the environment's own word: running, exited, present, creating
#   BASE      the snapshot its checkout is pinned to (`wk help`)
#   ARCH      what it builds natively; blank when that is the host's own
#   CHANGES   disk its own writes take -- the overlay layer, which grows
#             without bound between `wk gc` runs and is invisible to podman
#
#   --json    one JSON document ({"workspaces": [...]}), the same fields as
#             the table's columns, lower-cased; nothing else on stdout

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# Every target, from the same walk `wk status` uses (walk_targets, then
# target_workspaces per target). BASE and CHANGES are overlay concepts,
# meaningful only for the container target; `wk vm ls` lists a macOS VM's
# equivalents. ARCH is the one property invisible from inside a workspace:
# the kernel is the host's, so an armhf container reports aarch64 from uname.

# --continued: the second half of a listing assembled from two machines. On
# a macOS host `wk ls` walks the host-side targets here and forwards the
# container half into the podman VM; two header rows in one table isn't one.
CONTINUED=""
JSON=""
while [ $# -gt 0 ]; do
    case "$1" in
        --continued) CONTINUED=1; shift ;;
        --json)      JSON=1; shift ;;
        *) die "usage: wk ls [--json]; see wk ls -h" ;;
    esac
done

# One JSON document (own rows, or a peer target's own --json output) per
# append; json_merge_list (lib/common.sh) reads them all back as one array.
if [ -n "$JSON" ]; then
    JSON_DOCS=$(mktemp)
    _ls_json_cleanup() { rm -f "$JSON_DOCS"; }
    wk_atexit _ls_json_cleanup
fi

# WK_ROW_LABEL: the name the *asking* machine knows this one by, so rows are
# qualified against a peer's colliding vocabulary (`container`, `vm`):
# `moose:container`. Environment, not a flag: an unknown flag on an older
# far-side checkout is fatal where an unknown variable is ignored (t_wk).
LABEL="${WK_ROW_LABEL:-}"
_col() { if [ -z "$LABEL" ] || [ "$1" = "$LABEL" ]; then printf '%s' "$1"; else printf '%s:%s' "$LABEL" "$1"; fi; }

if [ -z "$CONTINUED" ] && [ -z "$JSON" ]; then
    printf '%-20s %-18s %-10s %-20s %-8s %8s\n' NAME TARGET STATE BASE ARCH CHANGES
fi

found=0
TARGETS=$(walk_targets)
# One round of probes for every machine at once, rather than one ten-second
# connect after another as the walk reaches them (prefetch_targets, lib/target.sh).
# shellcheck disable=SC2086 -- deliberate word splitting of the target list.
prefetch_targets $TARGETS
wk_atexit prefetch_done
for TARGET in $TARGETS; do
    load_target "$TARGET"

    # A machine of its own answers for itself, exactly as in `wk status`: the
    # workspaces are over there, and so is every fact about them.
    if t_has_wk; then
        rc=0
        if [ -n "$JSON" ]; then
            WK_ROW_LABEL="$TARGET" WK_NO_DELEGATE=1 t_wk ls --continued --json >> "$JSON_DOCS" || rc=$?
        else
            WK_ROW_LABEL="$TARGET" WK_NO_DELEGATE=1 t_wk ls --continued || rc=$?
        fi
        [ "$rc" -eq 0 ] && found=1
        continue
    fi

    for ws in $(target_workspaces); do
        found=1
        state=$(ws_display_state "$ws")
        base=$(ws_base_id "$ws" 2>/dev/null || echo '-')
        size=$(du -sh "$(wk_ws_dir "$ws")/changes" 2>/dev/null | cut -f1 || echo -)
        if [ -n "$JSON" ]; then
            python3 -c '
import json, sys
print(json.dumps({"workspaces": [{
    "name": sys.argv[1], "target": sys.argv[2], "state": sys.argv[3],
    "base": sys.argv[4], "arch": sys.argv[5], "changes": sys.argv[6],
}]}))' "$ws" "$(_col "$TARGET")" "$state" "$base" "$(t_arch "$ws")" "$size" >> "$JSON_DOCS"
            continue
        fi
        printf '%-20s %-18s %-10s %-20s %-8s %8s\n' \
            "$ws" "$(_col "$TARGET")" "$state" "$base" "$(t_arch "$ws")" "$size"
    done
done

# One document, nothing else on stdout: the advisory text below has no
# place in a document a caller is about to parse.
if [ -n "$JSON" ]; then
    json_merge_list workspaces "$JSON_DOCS"
    exit 0
fi

if [ "$found" -ne 1 ] && [ -z "$CONTINUED" ]; then
    if in_remote_host; then
        log "(no workspaces here -- from the workstation: wk new <name> --target $(wk_remote_field target))"
    else
        log "(no workspaces -- 'wk new <name>' to create one)"
    fi
fi

# The snapshot store is per target, reported per target rather than once for
# whatever driver was loaded last. Not at all when contributing to somebody
# else's listing: with a label, that machine's store isn't the reader's to
# act on (`wk gc`/`wk new` run there).
[ -z "$LABEL" ] || exit 0

_multi=""
if [ "$(printf '%s\n' $TARGETS | wc -l | tr -d ' ')" -gt 1 ]; then _multi=1; fi
for TARGET in $TARGETS; do
    load_target "$TARGET"
    t_needs_base || continue
    [ -n "${_spaced:-}" ] || { echo; _spaced=1; }
    cur=$(current_base 2>/dev/null || echo none)
    log "${_multi:+$TARGET: }current base: $cur"
    unref=$(unreferenced_bases | wc -l | tr -d ' ')
    if [ "$unref" -gt 0 ]; then
        log "${_multi:+$TARGET: }$unref unreferenced snapshot(s) reclaimable with 'wk gc'"
    fi
done
exit 0
