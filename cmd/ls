#!/usr/bin/env python3
#
# wk ls -- workspaces, what they are pinned to, and what they cost on disk
# wk: where=workspace name=none bare=merged readonly group=workspaces opts --json,--continued,--more-follows,--empty-so-far
#
# One line per workspace, on every target this machine knows:
#
#   NAME      the workspace
#   TARGET    where it lives (container, vm, or a machine)
#   STATE     the environment's own word: running, exited, present, creating
#   BASE      the upstream WebKit line it is built from: main, a release like
#             2.52, an image workspace's profile, or `?` when unknown
#   SNAP      the snapshot its checkout is pinned to (`wk help`)
#   ARCH      what it builds natively; blank when that is the host's own
#   CHANGES   disk its own writes take -- the overlay layer, reclaimed by `wk gc`
#
#   --json    one JSON document ({"workspaces": [...]}), the same fields as
#             the table's columns, lower-cased; nothing else on stdout

import json
import os
import re
import sys
from concurrent.futures import ThreadPoolExecutor

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import shell, targets  # noqa: E402
from wk.act import Refused, die, log  # noqa: E402
from wk.machine import Local  # noqa: E402

FORMAT = "%-20s %-18s %-10s %-8s %-20s %-8s %8s"

# Run with $PWD inside the checkout: `main`, a release like `2.52`, or `?`.
UPSTREAM_LINE = r'''
_u=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || _u=''
_b=''
if [ -n "$_u" ]; then
    _br=${_u#*/}
    case "$_br" in
        main) _b=main ;;
        webkitglib/*) _b=${_br#webkitglib/} ;;
    esac
fi
if [ -z "$_b" ]; then
    _rel=$(git for-each-ref --format='%(refname)' --contains HEAD 'refs/remotes/*/webkitglib/*' 2>/dev/null \
        | sed 's#.*/webkitglib/##' | sort -t. -k1,1n -k2,2n | tail -1)
    if [ -n "$_rel" ]; then _b=$_rel
    elif git for-each-ref --format='%(refname)' --contains HEAD 'refs/remotes/*/main' 2>/dev/null | grep -q .; then _b=main
    fi
fi
printf '%s' "${_b:-?}"
'''


def image_base(ws):
    """CFG_RELEASE of an image workspace's profile, or None."""
    for prefix in ("yocto-", "buildroot-"):
        if ws.startswith(prefix):
            conf = os.path.join(ROOT, "image", "configs", ws[len(prefix):] + ".conf")
            return targets.read_conf(conf).get("CFG_RELEASE") or None
    return None


def git_base(target, ws):
    if target.info(ws) in targets.STATES_NOT_THERE:
        return None
    r = target.exec(ws, ["sh", "-c", "cd %s 2>/dev/null || exit 0\n%s" % (shell.sh_quote(target.src(ws)), UPSTREAM_LINE)])
    out = r.out.replace("\r", "").strip().splitlines()
    return out[-1] if r.ok and out else None


def base_of(target, ws):
    return image_base(ws) or git_base(target, ws) or "?"


def col(label, target):
    return target if not label or target == label else "%s:%s" % (label, target)


def row(target, ws, label, as_json):
    state = target.display_state(ws)
    base = base_of(target, ws)
    snap = target.store.ws_base_id(ws) or "-"
    r = Local().run(["du", "-sh", os.path.join(target.store.ws_dir(ws), "changes")])
    size = r.out.split("\t")[0].strip() if r.ok and r.out.strip() else "-"
    arch = target.arch(ws)
    fields = (ws, col(label, target.name), state, base, snap, arch, size)
    if as_json:
        return json.dumps({"workspaces": [dict(zip(("name", "target", "state", "base", "snap", "arch", "changes"), fields))]})
    return FORMAT % fields


def target_rows(reg, name, label, as_json):
    """The rows one target contributes: its own machine's `wk ls` when it has one."""
    target = reg.load(name)
    if target.has_wk() and target.kind == "remote":
        args = ["ls", "--continued"] + (["--json"] if as_json else [])
        os.environ["WK_ROW_LABEL"] = name
        os.environ["WK_NO_DELEGATE"] = "1"
        rc, out = target.wk(*args)
        return out.rstrip("\n")
    names = sorted(set(target.store.workspaces()) | {n for n, _ in target.list()})
    with ThreadPoolExecutor(max_workers=8) as pool:
        rows = list(pool.map(lambda ws: row(target, ws, label, as_json), names))
    return "\n".join(rows)


def walk_targets(reg):
    if os.environ.get("WK_TARGET"):
        return os.environ["WK_TARGET"].split()
    if reg.in_workspace():
        return [reg.default()]
    if os.environ.get("WK_NO_DELEGATE"):
        return [t for t in reg.all() if t not in reg.machines()]
    return reg.all()


def footer(reg, names):
    multi = len(names) > 1
    spaced = False
    for name in names:
        try:
            target = reg.load(name)
        except LookupError:
            continue
        if not target.needs_base:
            continue
        if not spaced:
            print()
            spaced = True
        prefix = "%s: " % name if multi else ""
        cur = shell.ask(ROOT, "load_target %s >/dev/null 2>&1; current_base" % shell.sh_quote(name)) or "none"
        log("%scurrent base: %s" % (prefix, cur))
        unref = shell.ask(ROOT, "load_target %s >/dev/null 2>&1; unreferenced_bases | wc -l" % shell.sh_quote(name)) or "0"
        if int(unref.strip() or 0) > 0:
            log("%s%s unreferenced snapshot(s) reclaimable with 'wk gc'" % (prefix, unref.strip()))


def main(argv):
    continued = "--continued" in argv
    more_follows = "--more-follows" in argv
    empty_so_far = "--empty-so-far" in argv
    as_json = "--json" in argv
    label = os.environ.get("WK_ROW_LABEL", "")
    reg = targets.Registry(ROOT)
    if not continued and not as_json:
        print(FORMAT % ("NAME", "TARGET", "STATE", "BASE", "SNAP", "ARCH", "CHANGES"))
    names = walk_targets(reg)
    try:
        with ThreadPoolExecutor(max_workers=max(1, len(names))) as pool:
            outputs = list(pool.map(lambda n: target_rows(reg, n, label, as_json), names))
    except LookupError as e:
        die(str(e))
    found = False
    docs = []
    for out in outputs:
        if not out:
            continue
        found = True
        if as_json:
            docs.append(out)
        else:
            print(out)
    if as_json:
        items = []
        for doc in docs:
            for chunk in re.split(r"(?<=})\s*(?={)", doc.strip()):
                if chunk.strip():
                    items.extend(json.loads(chunk).get("workspaces", []))
        print(json.dumps({"workspaces": items}))
        return 0
    if not found and not more_follows and (not continued or empty_so_far):
        if reg.remote_marker_field("target"):
            log("(no workspaces here -- from the workstation: wk new <name> --target %s)" % reg.remote_marker_field("target"))
        else:
            log("(no workspaces -- 'wk new <name>' to create one)")
    if label:
        return 0   # that machine's store is not the reader's to act on
    footer(reg, names)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
