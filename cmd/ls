#!/usr/bin/env python3
#
# wk ls -- workspaces, what they are pinned to, and what they cost on disk
# wk: where=workspace name=none bare=merged readonly group=workspaces opts --json,--continued,--more-follows,--empty-so-far
#
# One line per workspace, on every place this machine knows:
#
#   NAME      the workspace
#   PLACE    where it lives (container, vm, or a machine)
#   STATE     the environment's own word: running, exited, present, creating
#   BASE      the upstream WebKit line it is built from: main, a release like
#             2.52, an image workspace's image preset, or `?` when unknown
#   SNAP      the snapshot its checkout is pinned to (`wk help`)
#   ARCH      what it builds natively; blank when that is the host's own
#   CHANGES   disk its own writes take -- the overlay layer, reclaimed by `wk gc`
#
#   Inside a workspace, BASE and CHANGES read `n/a`: the host holds both.
#
#   --json    one JSON document ({"workspaces": [...]}), the same fields as
#             the table's columns, lower-cased; nothing else on stdout

import json
import os
import sys
from concurrent.futures import ThreadPoolExecutor

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images  # noqa: E402

ROOT = images.root()

from wk import decl, places, record  # noqa: E402
from wk.act import Refused, die, log  # noqa: E402
from wk.machine import Local  # noqa: E402
from wk.store import Snapshots  # noqa: E402

FORMAT = "%-20s %-18s %-10s %-8s %-20s %-8s %8s"
NOT_APPLICABLE = "n/a"

def base_of(driver, ws):
    return places.image_base(ROOT, ws) or places.git_base(driver, ws) or "?"


def col(label, place):
    return place if not label or place == label else "%s:%s" % (label, place)


def changes_of(driver, ws):
    r = Local().run(["du", "-sh", os.path.join(driver.store.ws_dir(ws), "changes")])
    return r.out.split("\t")[0].strip() if r.ok and r.out.strip() else "-"


def row(driver, ws, label, as_json):
    state = driver.display_state(ws)
    inside = driver.kind == "local"
    base = NOT_APPLICABLE if inside else base_of(driver, ws)
    snap = driver.store.ws_snapshot_id(ws) or "-"
    size = NOT_APPLICABLE if inside else changes_of(driver, ws)
    arch = driver.arch(ws)
    fields = (ws, col(label, driver.name), state, base, snap, arch, size)
    return dict(zip(("name", "place", "state", "base", "snap", "arch", "changes"), fields)) if as_json else FORMAT % fields


def place_rows(reg, name, label, as_json):
    """The rows one place contributes (table lines, or --json's dicts): its own machine's `wk ls` when it has one."""
    driver = reg.load(name)
    if driver.has_wk() and driver.kind == "remote":
        os.environ["WK_ROW_LABEL"] = name
        os.environ["WK_NO_DELEGATE"] = "1"
        rc, out = driver.wk("ls", "--continued", *(["--json"] if as_json else []))
        if as_json:
            return json.loads(out).get("workspaces", []) if out.strip() else []
        return [out.rstrip("\n")] if out.strip() else []
    with ThreadPoolExecutor(max_workers=8) as pool:
        return list(pool.map(lambda ws: row(driver, ws, label, as_json), driver.workspaces()))


def footer(reg, names):
    multi = len(names) > 1
    spaced = False
    for name in names:
        try:
            driver = reg.load(name)
        except LookupError:
            continue
        if not driver.needs_base:
            continue
        if not spaced:
            print()
            spaced = True
        prefix = "%s: " % name if multi else ""
        bases = Snapshots(driver.store, driver.store_machine)
        log("%scurrent base: %s" % (prefix, bases.current() or "none"))
        unref = len(bases.unreferenced())
        if unref > 0:
            log("%s%s unreferenced snapshot(s) reclaimable with 'wk gc'" % (prefix, unref))


def main(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    continued = args.flag("--continued")
    more_follows = args.flag("--more-follows")
    empty_so_far = args.flag("--empty-so-far")
    as_json = args.flag("--json")
    label = record.row_label(os.environ)
    reg = places.Registry(ROOT)
    if not continued and not as_json:
        print(FORMAT % ("NAME", "PLACE", "STATE", "BASE", "SNAP", "ARCH", "CHANGES"))
    names = reg.walk()
    try:
        with ThreadPoolExecutor(max_workers=max(1, len(names))) as pool:
            outputs = list(pool.map(lambda n: place_rows(reg, n, label, as_json), names))
    except LookupError as e:
        die(str(e))
    rows = [r for out in outputs for r in out]
    if as_json:
        print(json.dumps({"workspaces": rows}))
        return 0
    for r in rows:
        print(r)
    if not rows and not more_follows and (not continued or empty_so_far):
        if reg.in_remote_host():
            log("(no workspaces here -- from the workstation: wk new <name> --on %s)" % reg.self_place())
        else:
            log("(no workspaces -- 'wk new <name>' to create one)")
    if label:
        return 0   # that machine's store is not the reader's to act on
    footer(reg, names)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
