#!/usr/bin/env bash
#
# wk ls -- workspaces, what they are pinned to, and what they cost on disk
# wk: where=workspace name=none bare=merged readonly group=workspaces
#
# One line per workspace, on every target this machine knows:
#
#   NAME      the workspace
#   TARGET    where it lives (container, vm, or a machine)
#   STATE     the environment's own word: running, exited, present, creating
#   BASE      the snapshot its checkout is pinned to (`wk help design`)
#   ARCH      what it builds natively; blank when that is the host's own
#   CHANGES   disk its own writes take -- the overlay layer, which grows
#             without bound between `wk gc` runs and is invisible to podman

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# Every target, from the same walk `wk status` uses (walk_targets, then
# target_workspaces per target): listing only the default target is how the
# two commands came to disagree about "the workspaces" -- a vm or remote
# workspace showed up in `wk status` and not here. TARGET is a column for the
# same reason: with more than one, a bare name says nothing about the machine.
#
# BASE and CHANGES are overlay concepts, meaningful only for the container
# target -- a macOS VM's equivalents are the golden image and the guest's own
# disk, which `wk vm ls` lists. ARCH is here because it's the one workspace
# property invisible from inside it: the kernel is the host's, so an armhf
# container reports aarch64 from uname.

# --continued: this listing is the second half of one being assembled from two
# machines. On a macOS host `wk ls` walks the host-side targets out here and
# forwards the container half into the podman VM; two header rows in one table
# is not a table, and "no workspaces -- 'wk new' to create one" is false when
# the other half just listed several.
CONTINUED=""
[ "${1:-}" = --continued ] && { CONTINUED=1; shift; }

# WK_ROW_LABEL: the name the *asking* machine knows this one by.
# A peer's own vocabulary (`container`, `vm`) collides with the same words
# used for a different machine's containers in somebody else's listing, so
# the asker passes the name it asked about and rows are qualified with it:
# `moose:container`. A build box needs none of this, since its target name
# *is* the label -- hence qualifying rather than always prefixing.
#
# Environment, not a flag: the far side may be an older checkout that
# doesn't know a new flag, and an unknown flag there is fatal where an
# unknown variable is ignored (t_wk, targets/remote.sh).
LABEL="${WK_ROW_LABEL:-}"
_col() { if [ -z "$LABEL" ] || [ "$1" = "$LABEL" ]; then printf '%s' "$1"; else printf '%s:%s' "$LABEL" "$1"; fi; }

if [ -z "$CONTINUED" ]; then
    printf '%-20s %-18s %-10s %-20s %-8s %8s\n' NAME TARGET STATE BASE ARCH CHANGES
fi

found=0
TARGETS=$(walk_targets)
# One round of probes for every machine at once, rather than one ten-second
# connect after another as the walk reaches them (prefetch_targets,
# lib/target.sh). Only the waiting moves; the listing is the same listing.
# shellcheck disable=SC2086 -- deliberate word splitting of the target list.
prefetch_targets $TARGETS
wk_atexit prefetch_done
for TARGET in $TARGETS; do
    load_target "$TARGET"

    # A machine of its own answers for itself, exactly as in `wk status`: the
    # workspaces are over there, and so is every fact about them. Without this
    # `wk status` and `wk ls` disagreed again -- one delegated to a peer's
    # workspaces while this one, walking a local store, reported nothing.
    if t_has_wk; then
        rc=0
        WK_ROW_LABEL="$TARGET" WK_NO_DELEGATE=1 t_wk ls --continued || rc=$?
        [ "$rc" -eq 0 ] && found=1
        continue
    fi

    for ws in $(target_workspaces); do
        found=1
        state=$(ws_display_state "$ws")
        base=$(ws_base_id "$ws" 2>/dev/null || echo '-')
        size=$(du -sh "$(wk_ws_dir "$ws")/changes" 2>/dev/null | cut -f1 || echo -)
        printf '%-20s %-18s %-10s %-20s %-8s %8s\n' \
            "$ws" "$(_col "$TARGET")" "$state" "$base" "$(t_arch "$ws")" "$size"
    done
done

# The advice differs by where you are standing: a shared build machine cannot
# create one, and saying so beats sending someone to a command that refuses.
if [ "$found" -ne 1 ] && [ -z "$CONTINUED" ]; then
    if in_remote_host; then
        log "(no workspaces here -- from the workstation: wk new <name> --target $(wk_remote_field target))"
    else
        log "(no workspaces -- 'wk new <name>' to create one)"
    fi
fi

# The snapshot store is per target and only exists where the overlay scheme
# does, reported per target rather than once for whatever driver was loaded
# last on a multi-target walk.
#
# Not at all when contributing to somebody else's listing: with a label, that
# machine's store isn't the reader's to act on (`wk gc`/`wk new` run there).
# --continued alone still prints it -- the podman VM's store is the *only*
# copy the macOS host is asking about.
[ -z "$LABEL" ] || exit 0

_multi=""
if [ "$(printf '%s\n' $TARGETS | wc -l | tr -d ' ')" -gt 1 ]; then _multi=1; fi
for TARGET in $TARGETS; do
    load_target "$TARGET"
    t_needs_base || continue
    # The blank line belongs to the trailer, so a walk with no snapshot store
    # in it (the host-side half of a macOS listing) ends where its rows do.
    [ -n "${_spaced:-}" ] || { echo; _spaced=1; }
    cur=$(current_base 2>/dev/null || echo none)
    log "${_multi:+$TARGET: }current base: $cur"
    unref=$(unreferenced_bases | wc -l | tr -d ' ')
    if [ "$unref" -gt 0 ]; then
        log "${_multi:+$TARGET: }$unref unreferenced snapshot(s) reclaimable with 'wk gc'"
    fi
done
exit 0
