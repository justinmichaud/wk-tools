#!/usr/bin/env bash
#
# wk ls -- workspaces, what they are pinned to, and what they cost on disk.
#
# Disk is shown because the overlay layers are the one thing that grows without
# bound between `wk gc` runs, and they are invisible to `podman ps`.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# Every target, from the same walk `wk status` uses (walk_targets, then
# target_workspaces per target). Listing only the default target is how the two
# commands came to disagree about what "the workspaces" are: on a macOS host
# this one was forwarded into the podman VM and answered for containers alone,
# so a vm or remote workspace showed up in `wk status` and not here.
#
# TARGET is therefore a column: with more than one of them in the listing, a
# bare name says nothing about which machine it is on.
#
# BASE and CHANGES are overlay concepts and only mean anything for the
# container target. A macOS VM has neither -- its equivalents are the golden
# image and the guest's own disk -- so `wk vm ls` is what lists those.
#
# ARCH is here rather than left to `wk build` to mention, because it is the one
# property of a workspace that cannot be seen from inside it: the kernel is the
# host's, so an armhf container reports aarch64 from uname, and a workspace
# whose architecture is invisible is one whose builds are a surprise.

# --continued: this listing is the second half of one being assembled from two
# machines. On a macOS host `wk ls` walks the host-side targets out here and
# forwards the container half into the podman VM; two header rows in one table
# is not a table, and "no workspaces -- 'wk new' to create one" is false when
# the other half just listed several.
CONTINUED=""
[ "${1:-}" = --continued ] && { CONTINUED=1; shift; }

# WK_ROW_LABEL: the name the *asking* machine knows this one by.
#
# A machine of its own answers for its own workspaces, in its own vocabulary --
# and for a peer workstation that vocabulary is `container` and `vm`, which in
# somebody else's listing is the same word this machine uses for a different
# machine's containers. So the asker passes the name it asked about, and rows
# whose target does not already carry it are qualified with it:
# `moose:container`. A build box needs none of this -- its own target name *is*
# the label -- which is why this qualifies rather than always prefixing.
#
# Environment rather than a flag: a peer runs its own checkout of this
# repository, so the far side may not know a flag added here yet -- and an
# unknown flag there is fatal where an unknown variable is ignored (t_wk,
# targets/remote.sh).
LABEL="${WK_ROW_LABEL:-}"
_col() { if [ -z "$LABEL" ] || [ "$1" = "$LABEL" ]; then printf '%s' "$1"; else printf '%s:%s' "$LABEL" "$1"; fi; }

if [ -z "$CONTINUED" ]; then
    printf '%-20s %-18s %-10s %-20s %-8s %8s\n' NAME TARGET STATE BASE ARCH CHANGES
fi

found=0
TARGETS=$(walk_targets)
# One round of probes for every machine at once, rather than one ten-second
# connect after another as the walk reaches them (prefetch_targets,
# lib/target.sh). Only the waiting moves; the listing is the same listing.
# shellcheck disable=SC2086 -- deliberate word splitting of the target list.
prefetch_targets $TARGETS
trap 'prefetch_done' EXIT
for TARGET in $TARGETS; do
    load_target "$TARGET"

    # A machine of its own answers for itself, exactly as in `wk status`: the
    # workspaces are over there, and so is every fact about them. Without this
    # the two commands disagreed again -- `wk status` delegated and listed a
    # peer workstation's workspaces while this one, walking a local store that
    # has never heard of them, reported nothing.
    if t_has_wk; then
        rc=0
        WK_ROW_LABEL="$TARGET" WK_NO_DELEGATE=1 t_wk ls --continued || rc=$?
        [ "$rc" -eq 0 ] && found=1
        continue
    fi

    for ws in $(target_workspaces); do
        found=1
        state=$(ws_display_state "$ws")
        base=$(ws_base_id "$ws" 2>/dev/null || echo '-')
        size=$(du -sh "$(wk_ws_dir "$ws")/changes" 2>/dev/null | cut -f1 || echo -)
        printf '%-20s %-18s %-10s %-20s %-8s %8s\n' \
            "$ws" "$(_col "$TARGET")" "$state" "$base" "$(t_arch "$ws")" "$size"
    done
done

# The advice differs by where you are standing: a shared build machine cannot
# create one, and saying so beats sending someone to a command that refuses.
if [ "$found" -ne 1 ] && [ -z "$CONTINUED" ]; then
    if in_remote_host; then
        log "(no workspaces here -- from the workstation: wk new <name> --target $(wk_remote_field target))"
    else
        log "(no workspaces -- 'wk new <name>' to create one)"
    fi
fi

# The snapshot store is per target and only exists where the overlay scheme
# does, so this is reported per target rather than once for whatever driver
# happened to be loaded last -- which on a multi-target walk was a store the
# numbers did not come from.
# ...and not at all when this listing is one machine's contribution to
# somebody else's: --label means the rows are going into a fleet table on
# another computer, and that machine's snapshot store is not the reader's to
# act on. `wk gc` and `wk new` there are run there. (--continued alone is the
# other case and does still print it: the podman VM's store is the *only* copy
# of the store the macOS host is asking about.)
[ -z "$LABEL" ] || exit 0

_multi=""
if [ "$(printf '%s\n' $TARGETS | wc -l | tr -d ' ')" -gt 1 ]; then _multi=1; fi
for TARGET in $TARGETS; do
    load_target "$TARGET"
    t_needs_base || continue
    # The blank line belongs to the trailer, so a walk with no snapshot store
    # in it (the host-side half of a macOS listing) ends where its rows do.
    [ -n "${_spaced:-}" ] || { echo; _spaced=1; }
    cur=$(current_base 2>/dev/null || echo none)
    log "${_multi:+$TARGET: }current base: $cur"
    unref=$(unreferenced_bases | wc -l | tr -d ' ')
    if [ "$unref" -gt 0 ]; then
        log "${_multi:+$TARGET: }$unref unreferenced snapshot(s) reclaimable with 'wk gc'"
    fi
done
exit 0
