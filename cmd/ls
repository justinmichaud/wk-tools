"""workspaces, what they are pinned to, and what they cost on disk

One line per workspace, on every place this machine knows:

  NAME      the workspace
  PLACE     where it lives (container, vm, or a machine)
  STATE     the environment's own word: running, exited, present, creating
  BASE      the upstream WebKit line it is built from: main, a release like 2.52, an image workspace's image preset,
            or `?` when unknown; the repo, for one that is not WebKit (`wk new --repo`)
  SNAP      the snapshot its checkout is pinned to (`wk help`)
  ARCH      what it builds natively; blank when that is the host's own
  CHANGES   disk its own writes take -- the overlay layer, reclaimed by `wk gc`

Inside a workspace, BASE and CHANGES read `n/a`: the host holds both. A place with no wk of its own is read from here;
every other place answers its own `wk ls --json`, merged in.
"""
import json
import os
from concurrent.futures import ThreadPoolExecutor

from wk import fleet, images, places, record
from wk.act import die, log, warn
from wk.decl import Command, Opt
from wk.machine import Local
from wk.store import Snapshots

ROOT = images.root()
COMMAND = Command(forward=False, readonly=True, group="workspaces", opts=(
    Opt("--json", "one JSON document ({\"workspaces\": [...]}), the table's columns lower-cased; nothing else on stdout"),))
FORMAT = "%-20s %-18s %-10s %-8s %-20s %-8s %8s"
NOT_APPLICABLE = "n/a"
FIELDS = ("name", "place", "state", "base", "snap", "arch", "changes")

def base_of(driver, ws):
    repo = driver.repo(ws)
    return places.image_base(ROOT, ws) or (repo.name if not repo.snapshot else None) or places.git_base(driver, ws) or "?"


def col(label, place):
    return place if not label or place == label else "%s:%s" % (label, place)


def changes_of(driver, ws):
    r = Local().run(["du", "-sh", os.path.join(driver.store.ws_dir(ws), "changes")])
    return r.out.split("\t")[0].strip() if r.ok and r.out.strip() else "-"


def row(driver, ws, label):
    state = driver.display_state(ws)
    inside = driver.kind == "local"
    base = NOT_APPLICABLE if inside else base_of(driver, ws)
    snap = driver.store.ws_snapshot_id(ws) or "-"
    size = NOT_APPLICABLE if inside else changes_of(driver, ws)
    arch = driver.arch(ws)
    return dict(zip(FIELDS, (ws, col(label, driver.name), state, base, snap, arch, size)))


def rows_of(answer, label):
    """A place with no wk of its own is read from here; any other answers for itself."""
    if answer.side in ("none", "no-wk"):
        driver = answer.driver
        with ThreadPoolExecutor(max_workers=8) as pool:
            return list(pool.map(lambda ws: row(driver, ws, label), driver.workspaces()))
    if answer.side == "unknown":
        die(answer.why)
    if answer.why or answer.rc:
        warn("%s: %s, so its workspaces are not listed" % (answer.name, answer.why or "its 'wk ls' exited %d" % answer.rc))
        return []
    try:
        return json.loads(answer.out).get("workspaces", []) if answer.out.strip() else []
    except ValueError:
        warn("%s: its 'wk ls --json' printed no JSON, so its workspaces are not listed" % answer.name)
        return []


def footer(reg, names):
    multi = len(names) > 1
    spaced = False
    for name in names:
        try:
            driver = reg.load(name)
        except LookupError:
            continue
        if not driver.needs_base:
            continue
        if not spaced:
            print()
            spaced = True
        prefix = "%s: " % name if multi else ""
        bases = Snapshots(driver.store, driver.store_machine)
        log("%scurrent base: %s" % (prefix, bases.current() or "none"))
        unref = len(bases.unreferenced())
        if unref > 0:
            log("%s%s unreferenced snapshot(s) reclaimable with 'wk gc'" % (prefix, unref))


def main(args, inv):
    as_json = args.flag("--json")
    label = record.row_label(os.environ)
    reg = places.Registry(ROOT)
    answers = fleet.each(reg, ["ls", "--json"])
    rows = [r for a in answers for r in rows_of(a, label)]
    if as_json:
        print(json.dumps({"workspaces": rows}))
        return 0
    print(FORMAT % tuple(f.upper() for f in FIELDS))
    for r in rows:
        print(FORMAT % tuple(r.get(f, "?") for f in FIELDS))
    if not rows:
        if reg.in_remote_host():
            log("(no workspaces here -- from the workstation: wk new <name> --on %s)" % reg.self_place())
        else:
            log("(no workspaces -- 'wk new <name>' to create one)")
    if not label:   # another machine's store is not the reader's to act on
        footer(reg, [a.name for a in answers if a.side in ("none", "no-wk")])
    return 0

