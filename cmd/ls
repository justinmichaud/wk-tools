#!/usr/bin/env bash
#
# wk ls -- workspaces, what they are pinned to, and what they cost on disk
# wk: where=workspace name=none bare=merged readonly group=workspaces
#
# One line per workspace, on every target this machine knows:
#
#   NAME      the workspace
#   TARGET    where it lives (container, vm, or a machine)
#   STATE     the environment's own word: running, exited, present, creating
#   BASE      the upstream WebKit line it is built from: main, a release like
#             2.52, an image workspace's profile, or `?` when unknown
#   SNAP      the snapshot its checkout is pinned to (`wk help`)
#   ARCH      what it builds natively; blank when that is the host's own
#   CHANGES   disk its own writes take -- the overlay layer, reclaimed by `wk gc`
#
#   --json    one JSON document ({"workspaces": [...]}), the same fields as
#             the table's columns, lower-cased; nothing else on stdout

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/par.sh"

ws_git_base() { # <ws>
    case "$(t_info "$1")" in
        absent|creating|broken|unreachable) return 0 ;;
    esac
    t_exec "$1" sh -c "cd $(sh_quote "$(t_src "$1")") 2>/dev/null || exit 0
        $(declare -f ws_upstream_line)
        ws_upstream_line" 2>/dev/null | tr -d '\r'
}

ws_base() { # <ws>
    local b
    b=$(ws_image_base "$1" 2>/dev/null) || b=""
    [ -n "$b" ] || b=$(ws_git_base "$1" 2>/dev/null) || b=""
    printf '%s' "${b:-?}"
}

# --continued/--more-follows/--empty-so-far are the dispatcher's (bare_report),
# not a person's: they join this machine's rows and the podman VM's into one table.
CONTINUED=""
MORE_FOLLOWS=""
EMPTY_SO_FAR=""
JSON=""
while [ $# -gt 0 ]; do
    case "$1" in
        --continued)    CONTINUED=1; shift ;;
        --more-follows) MORE_FOLLOWS=1; shift ;;
        --empty-so-far) EMPTY_SO_FAR=1; shift ;;
        --json)         JSON=1; shift ;;
        *) die "usage: wk ls [--json]; see wk ls -h" ;;
    esac
done

if [ -n "$JSON" ]; then
    JSON_DOCS=$(mktemp)
    _ls_json_cleanup() { rm -f "$JSON_DOCS"; }
    wk_atexit _ls_json_cleanup
fi

# WK_ROW_LABEL: the name the *asking* machine knows this one by, qualifying rows
# as `moose:container`. An env var, since an older far-side checkout would die on a flag.
LABEL="${WK_ROW_LABEL:-}"
_col() { if [ -z "$LABEL" ] || [ "$1" = "$LABEL" ]; then printf '%s' "$1"; else printf '%s:%s' "$LABEL" "$1"; fi; }

if [ -z "$CONTINUED" ] && [ -z "$JSON" ]; then
    printf '%-20s %-18s %-10s %-8s %-20s %-8s %8s\n' \
        NAME TARGET STATE BASE SNAP ARCH CHANGES
fi

ws_row() { # <target> <ws>
    local TARGET="$1" ws="$2" state base snap size
    state=$(ws_display_state "$ws")
    base=$(ws_base "$ws")
    snap=$(ws_base_id "$ws" 2>/dev/null || echo '-')
    size=$(du -sh "$(wk_ws_dir "$ws")/changes" 2>/dev/null | cut -f1 || echo -)
    if [ -n "$JSON" ]; then
        python3 -c '
import json, sys
print(json.dumps({"workspaces": [{
    "name": sys.argv[1], "target": sys.argv[2], "state": sys.argv[3],
    "base": sys.argv[4], "snap": sys.argv[5], "arch": sys.argv[6], "changes": sys.argv[7],
}]}))' "$ws" "$(_col "$TARGET")" "$state" "$base" "$snap" "$(t_arch "$ws")" "$size" >&3
        return 0
    fi
    printf '%-20s %-18s %-10s %-8s %-20s %-8s %8s\n' \
        "$ws" "$(_col "$TARGET")" "$state" "$base" "$snap" "$(t_arch "$ws")" "$size" >&3
}

target_rows() { # <target>
    local TARGET="$1" ws list
    load_target "$TARGET"
    if t_has_wk; then
        if [ -n "$JSON" ]; then
            WK_ROW_LABEL="$TARGET" WK_NO_DELEGATE=1 t_wk ls --continued --json >&3
        else
            WK_ROW_LABEL="$TARGET" WK_NO_DELEGATE=1 t_wk ls --continued >&3
        fi
        return $?
    fi

    list=$(target_workspaces)
    [ -n "$list" ] || return 0
    par_begin
    for ws in $list; do par_run "$ws" ws_row "$TARGET" "$ws"; done
    par_wait
    for ws in $list; do par_record "$ws" >&3; done
    par_end
}

found=0
TARGETS=$(walk_targets)
# Every target at once: a machine that will not answer costs only its own timeout.
wk_atexit par_cleanup
par_begin
for TARGET in $TARGETS; do par_run "$TARGET" target_rows "$TARGET"; done
par_wait
for TARGET in $TARGETS; do
    rows=$(par_record "$TARGET")
    [ -n "$rows" ] || continue
    found=1
    if [ -n "$JSON" ]; then printf '%s\n' "$rows" >> "$JSON_DOCS"; else printf '%s\n' "$rows"; fi
done
par_end

if [ -n "$JSON" ]; then
    json_merge_list workspaces "$JSON_DOCS"
    exit 0
fi

if [ "$found" -ne 1 ] && [ -z "$MORE_FOLLOWS" ] && { [ -z "$CONTINUED" ] || [ -n "$EMPTY_SO_FAR" ]; }; then
    if in_remote_host; then
        log "(no workspaces here -- from the workstation: wk new <name> --target $(wk_remote_field target))"
    else
        log "(no workspaces -- 'wk new <name>' to create one)"
    fi
fi

# With a label, that machine's store is not the reader's to act on.
[ -z "$LABEL" ] || exit 0

_multi=""
if [ "$(printf '%s\n' $TARGETS | wc -l | tr -d ' ')" -gt 1 ]; then _multi=1; fi
for TARGET in $TARGETS; do
    load_target "$TARGET"
    t_needs_base || continue
    [ -n "${_spaced:-}" ] || { echo; _spaced=1; }
    cur=$(current_base 2>/dev/null || echo none)
    log "${_multi:+$TARGET: }current base: $cur"
    unref=$(unreferenced_bases | wc -l | tr -d ' ')
    if [ "$unref" -gt 0 ]; then
        log "${_multi:+$TARGET: }$unref unreferenced snapshot(s) reclaimable with 'wk gc'"
    fi
done
exit 0
