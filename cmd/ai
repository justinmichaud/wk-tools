#!/usr/bin/env bash
#
# wk ai claude|pi <workspace> [agent options] -- run a coding agent inside a workspace
# wk: where=workspace name=required@2 ready=yes group=workspaces
#
# The workspace name comes first; everything after it is the agent's, verbatim.
# --rc and --stop are wk's own and are taken out of argv here.
#
#   wk ai claude bb4 -r          resume, in bb4
#   wk ai claude bb4 --continue  and so on
#   wk ai pi bb4 --help          pi's own help, not this one
#
# Permissions are relaxed because the workspace is the blast radius, not the
# machine, so this checks the boundary holds before handing over control. For
# the session it also holds back the push keys and walls off git commits.
#
# --rc runs Claude Code Remote Control (claude.ai/code, the mobile app) instead
# of a foreground session: a persistent server, started detached in the
# workspace's checkout and left running after this command returns.
#
#   wk ai claude <ws> --rc          start it (a no-op, reported, if already up)
#   wk ai claude <ws> --rc --stop   stop it
#
# `wk new` and `wk start` start remote control themselves; WK_NO_CLAUDE_RC=1
# turns that off. It needs the claude.ai account login rather than a
# `claude setup-token` token: 'wk key set claude-login', or a guest logs in for
# itself. Onboarding, the trust dialog and the remote-control dialog are
# recorded in the workspace before either kind of session starts
# (claude/workspace-config.py).
#
# The agents this knows:
#
#   claude   Claude Code. Installed by container/firstrun.sh, and authenticated
#            by whichever one credential the store delivers to this kind of
#            target (wk_agent_secrets, lib/store.sh). The only one with a
#            remote-control server (--rc).
#   pi       the pi coding agent. Installed per workspace from npm on first
#            use, and pointed at an OpenAI-compatible endpoint by its own
#            config file; `wk key set litellm` stores the key for it.

set -euo pipefail
WK_ROOT="${WK_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/detach.sh"

# Carried into the workspace as WK_AGENT, which the build wall reads.
AGENT="${1:-}"

PUSH_WAS_ON=""
PUSH_TARGET=""

push_switch() { # <on|off|status>
    "$WK_ROOT/wk" push "$1" ${PUSH_TARGET:+--target "$PUSH_TARGET"} >/dev/null 2>&1
}

# t_exec hands argv to an exec, not a shell, so a builtin needs `sh -c` (measured).
wall_available() { # <name>
    t_exec "$1" sh -c 'command -v bwrap >/dev/null 2>&1'
}

push_measure_here() {
    local alias sock ident code
    alias=$(wk_push_forks | awk 'NF {print $3; exit}')
    sock=$(ssh -G "$alias" 2>/dev/null | awk '$1 == "identityagent" {print $2; exit}') || sock=""
    if [ -n "$sock" ]; then
        ident=$(SSH_AUTH_SOCK="$sock" ssh-add -l 2>/dev/null | grep -c .) || ident=0
        [ "$ident" = 0 ] || die "refusing to run: $ident deploy key(s) reach this workspace through
    $sock, so an agent in here could push. The switch is the host's:  wk push off"
    fi

    code=$(curl -sS -m 20 -o /dev/null -w '%{http_code}' \
               -H 'Authorization: Basic d2s6d2s=' \
               https://api.github.com/user 2>/dev/null) || code=""
    [ "$code" = 401 ] || die "refusing to run: an authenticated GitHub API call from this workspace
    answered '${code:-nothing}' where it must answer 401, so an agent in here
    could post. The switch is the host's:  wk push off"

    info "measured in here: the agent holds nothing and the API refuses -- an agent
  in this workspace can publish neither a push nor a comment"
}

push_hold_back() { # <name>
    if in_workspace; then push_measure_here; return 0; fi
    local rc=0
    push_switch status || rc=$?
    case "$rc" in
        1|4) return 0 ;;
        0)   ;;
        *)   die "refusing to run: 'wk push status${PUSH_TARGET:+ --target $PUSH_TARGET}' exited $rc rather
    than measuring the switch, so whether an agent in '$1' could publish is
    unknown. Run that command and fix what it names." ;;
    esac
    PUSH_WAS_ON=1
    warn "git push is ON -- turning it off while the agent runs in '$1'"
    push_switch off \
        || die "refusing to run: could not hold back the push keys ('wk push status${PUSH_TARGET:+ --target $PUSH_TARGET}')"
}

restore_push() {
    [ -n "$PUSH_WAS_ON" ] || return 0
    if [ -t 0 ] && [ -t 1 ]; then
        push_switch on \
            && info "git push turned back on" \
            || warn "could not turn git push back on -- 'wk push on'"
    else
        log "git push stays off (headless session; 'wk push on' when you want it back)"
    fi
}

claude_workspace_config() { # <name>
    local out
    out=$(t_exec "$1" bash -lc "python3 $(sh_quote "$(t_tools "$1")/claude/workspace-config.py") $(sh_quote "$(t_src "$1")")" 2>&1) \
        || die "could not record Claude's start-up answers in '$1', and every
    session there would stop at a dialog instead of starting:
$(printf '%s' "$out" | sed 's/^/    /')"
    [ -z "$out" ] || debug "$out"
}

command -v task_begin >/dev/null 2>&1 || . "$WK_ROOT/lib/task.sh"
command -v job_kill   >/dev/null 2>&1 || . "$WK_ROOT/lib/watchdog.sh"

rc_log()     { printf '%s' "$(t_home "$1")/claude-remote-control.log"; }
rc_pidfile() { printf '%s' "$(t_home "$1")/claude-remote-control.pid"; }

# The pid comes out of a file in the workspace's own home, and a wkdev container shares the host's PID namespace, so it is the workspace's claim about a pid rather than a fact (lib/watchdog.sh). One pattern covers both shapes the server's command line has: the `-lc` text before the exec, and the CLI itself after it.
RC_PID_MATCH='*claude*remote-control*'

rc_minutes() {
    local started; started=$(task_field "$(rc_task "$1")" started)
    [ -n "$started" ] || { printf '?'; return 0; }
    printf '%d' $(( ( $(date -u +%s) - $(utc_to_epoch "$started") ) / 60 ))
}

rc_start() {
    local name="$1" claude_bin="$2" task log pidf pid i settled

    if rc_alive "$name"; then
        info "'$name' claude remote-control already running, $(rc_minutes "$name") minutes, log at $(task_field "$(rc_task "$name")" log)"
        return 0
    fi

    # Measured: remote control refuses a `claude setup-token` credential as inference-only.
    t_agent_secret_present "$name" claude-login \
        || die "'$name' has no claude.ai login credential -- what 'claude auth login'
    leaves behind -- and remote control refuses anything less: a
    'claude setup-token' token ('wk key set claude') is inference-only.
    $(t_agent_secret_remedy "$name" claude-login)"

    log=$(rc_log "$name"); pidf=$(rc_pidfile "$name")
    t_exec "$name" mkdir -p "$(t_home "$name")" >/dev/null 2>&1 || true
    task=$(task_begin rc target "$name" "wk ai claude $name --rc --stop" "$log" \
        "claude remote-control in $name")
    task_step "$task" 1

    t_spawn "$name" "$log" "$pidf" \
        env WK_AGENT="$AGENT" WK_WORKSPACE="$name" bash -lc \
        "cd $(sh_quote "$(t_src "$name")") && exec $(sh_quote "$claude_bin") remote-control --spawn=same-dir --name $(sh_quote "$name")" \
        || die "could not start claude remote-control in '$name'"

    # Still there WK_RC_SETTLE ticks of 0.1s after it wrote its pid, within WK_RC_TICKS of them, is it having survived its start-up checks.
    pid=""; i=0; settled=0
    while :; do
        if [ -z "$pid" ]; then
            pid=$(t_exec "$name" cat "$pidf" 2>/dev/null | tr -d '\r') || pid=""
        elif ! t_exec "$name" kill -0 "$pid" >/dev/null 2>&1; then
            task_end "$task" 1
            die "claude remote-control exited at once in '$name'. Its log ($log) ends:
$(t_exec "$name" tail -n 3 "$log" 2>/dev/null | sed 's/^/    /')"
        elif [ "$settled" -ge "${WK_RC_SETTLE:-5}" ]; then
            break
        else
            settled=$((settled + 1))
        fi
        i=$((i + 1))
        [ "$i" -gt "${WK_RC_TICKS:-100}" ] \
            && die "remote-control did not start in '$name': nothing wrote $pidf.
    Its log ($log) ends:
$(t_exec "$name" tail -n 3 "$log" 2>/dev/null | sed 's/^/    /')"
        sleep 0.1
    done

    job_pid_adopt "$name" "$task" "$pid" "$RC_PID_MATCH" || {
        task_end "$task" 1
        die "nothing here will stop remote control in '$name'; its log is $log"
    }
    info "claude remote-control running in '$name' (pid $pid), log at $log"
}

# From https://www.npmjs.com/package/@earendil-works/pi-coding-agent -> https://github.com/earendil-works/pi (packages/coding-agent).
# pi has no LiteLLM provider (earendil-works/pi #4561, closed unimplemented), and
# LiteLLM speaks the OpenAI wire format, so it is a custom provider in ~/.pi/agent/models.json.
PI_PKG=@earendil-works/pi-coding-agent
PI_NODE_MIN=22.19.0

pi_node_ok() { # <version, as `node -v` prints it>
    local have="${1#v}" want="$PI_NODE_MIN" hp wp
    [ -n "$have" ] || return 1
    while [ -n "$have" ] || [ -n "$want" ]; do
        hp="${have%%.*}"; wp="${want%%.*}"
        [ -n "$hp" ] || hp=0
        [ -n "$wp" ] || wp=0
        case "$hp$wp" in *[!0-9]*) return 1 ;; esac
        if [ "$hp" -gt "$wp" ]; then return 0; fi
        if [ "$hp" -lt "$wp" ]; then return 1; fi
        case "$have" in *.*) have="${have#*.}" ;; *) have="" ;; esac
        case "$want" in *.*) want="${want#*.}" ;; *) want="" ;; esac
    done
    return 0
}

pi_probe() { # <name>
    t_exec "$1" bash -lc '
        printf "node=%s\n" "$(node -v 2>/dev/null || true)"
        printf "npm=%s\n" "$(command -v npm 2>/dev/null || true)"
        p=""
        for c in "$HOME/.local/bin/pi" "$(command -v pi 2>/dev/null)"; do
            [ -n "$c" ] && [ -x "$c" ] || continue
            "$c" --version >/dev/null 2>&1 && { p="$c"; break; }
        done
        printf "pi=%s\n" "$p"
        [ -f "$HOME/.pi/agent/models.json" ] && printf "models=yes\n" || printf "models=no\n"
    ' 2>/dev/null | tr -d '\r'
}

# `die` in a command substitution ends only the subshell, so PI_BIN is a global.
pi_ensure() { # <name>
    local name="$1" probe node npm models key
    PI_BIN=""
    probe=$(pi_probe "$name") || die "could not reach the checkout in '$name'"
    node=$(kv_get node <<<"$probe")
    npm=$(kv_get npm <<<"$probe")
    PI_BIN=$(kv_get pi <<<"$probe")
    models=$(kv_get models <<<"$probe")

    if [ -z "$npm" ] || ! pi_node_ok "$node"; then
        die "'$name' has no node runtime pi can use: node ${node:-absent}, npm ${npm:-absent}.
    $PI_PKG needs node >= $PI_NODE_MIN and npm to install itself.
    This repository owns no Containerfile for the workspace image -- it is
    ghcr.io/igalia/wkdev-sdk, pulled pre-built -- so a runtime it lacks is
    installed the way the workspace's other tools are: add a pinned node
    release to container/firstrun.sh beside the samply and helix installs
    (fetch, checksum, unpack into ~/.local), then 'wk rm $name' and 'wk new'.
    On a build box or a macOS guest, install node >= $PI_NODE_MIN into your own
    ~/.local there."
    fi

    if [ -z "$PI_BIN" ]; then
        info "installing pi in '$name' (npm, into your own ~/.local)"
        # npm's global prefix in the image is /usr, which the workspace user cannot write.
        t_exec "$name" bash -lc \
            "npm install -g --ignore-scripts --prefix \"\$HOME/.local\" $(sh_quote "$PI_PKG")" \
            || die "npm could not install $PI_PKG in '$name'. By hand:
        wk enter $name
        npm install -g --ignore-scripts --prefix \"\$HOME/.local\" $PI_PKG
    The workspace's egress allows registry.npmjs.org and nothing else npm
    reaches for (container/proxy/wk-proxy.py is the list)."

        probe=$(pi_probe "$name") || die "could not reach the checkout in '$name'"
        PI_BIN=$(kv_get pi <<<"$probe")
        models=$(kv_get models <<<"$probe")
        [ -n "$PI_BIN" ] || die "installed, and nothing in '$name' runs as pi. Try it by hand:
        wk enter $name
        ~/.local/bin/pi --version"
    fi

    [ "$models" = no ] || return 0
    key=$(wk_agent_secret litellm)
    if [ -n "$key" ]; then
        local endpoint; endpoint=$(pi_litellm_endpoint) \
            || die "lib/credcheck.py has no LITELLM_ENDPOINT to read"
        pi_write_models "$name" "$endpoint" \
            || die "could not write ~/.pi/agent/models.json in '$name'. By hand:
        wk enter $name
        mkdir -p ~/.pi/agent && cat > ~/.pi/agent/models.json"
        info "wrote ~/.pi/agent/models.json in '$name' (\$LITELLM_API_KEY, $endpoint)"
        log  "  set the model id this endpoint serves:"
        log  "    wk enter $name -- \${EDITOR:-vi} ~/.pi/agent/models.json"
    else
        log "no LiteLLM key on this machine ('wk key set litellm') and no"
        log "~/.pi/agent/models.json in '$name', so pi will ask you to /login"
    fi
}

pi_litellm_endpoint() {
    python3 -c 'import sys
sys.path.insert(0, sys.argv[1])
import credcheck
print(credcheck.LITELLM_ENDPOINT)' "$WK_ROOT/lib"
}

pi_write_models() { # <name> <endpoint>
    python3 -c '
import json, sys
json.dump({"providers": {"litellm": {
    "baseUrl": sys.argv[1],
    "api": "openai-completions",
    "apiKey": "$LITELLM_API_KEY",
    "models": [{"id": "REPLACE-WITH-A-MODEL-THIS-ENDPOINT-SERVES"}],
}}}, sys.stdout, indent=2)
sys.stdout.write("\n")
' "$2" | t_exec "$1" "mkdir -p ~/.pi/agent && umask 077 && cat > ~/.pi/agent/models.json"
}

# WK_CLAUDE_LIB=1 sources the functions above without the side effects below.
[ "${WK_CLAUDE_LIB:-}" != 1 ] || return 0

case "$AGENT" in
    claude|pi) shift ;;
    "")     die "usage: wk ai claude|pi <workspace> [agent options]; see wk ai -h" ;;
    *)      die "unknown agent '$AGENT'. This checkout knows: claude, pi" ;;
esac

NAME="${WK_NAME:-}"
require_name "$NAME"

RC=""; RC_STOP=""
_rc_args=()
for _a in ${@+"$@"}; do
    case "$_a" in
        --rc)   RC=1 ;;
        --stop) RC_STOP=1 ;;
        *)      _rc_args+=("$_a") ;;
    esac
done
set -- ${_rc_args[@]+"${_rc_args[@]}"}
[ -z "$RC_STOP" ] || [ -n "$RC" ] || die "--stop only makes sense with --rc: wk ai claude $NAME --rc --stop"
[ -z "$RC" ] || [ $# -eq 0 ] || die "wk ai claude $NAME --rc takes no other options (got: $*)"
[ -z "$RC" ] || [ "$AGENT" = claude ] || die "--rc is Claude Code's remote control; $AGENT has no equivalent.
    A foreground session:  wk ai $AGENT $NAME"

TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

AGENT_BIN="$AGENT"
AGENT_MODE=()
[ "$AGENT" != claude ] || AGENT_MODE=(--dangerously-skip-permissions)

if [ "$WK_TARGET_KIND" = local ]; then
    die "already inside workspace '$(wk_self)' -- run '$AGENT' directly"
fi

if [ "$WK_TARGET_KIND" = remote ]; then
    barrier "'$NAME' is on the shared build machine '$TARGET', which has no sandbox at
    all: no container, no separate uid, no filesystem boundary, and other
    people's work on the same machine. An agent there is an agent on that
    machine, with your access."

    if [ "$AGENT" = claude ]; then
        # A shared box's `claude` on PATH can be an npm install under too old a node.
        AGENT_BIN=$(t_exec "$NAME" bash -lc '
            for c in "$HOME/.local/bin/claude" "$(command -v claude 2>/dev/null)"; do
                [ -n "$c" ] && [ -x "$c" ] || continue
                "$c" --version >/dev/null 2>&1 && { echo "$c"; exit 0; }
            done
            exit 1' 2>/dev/null | tr -d '\r' | tail -1) || AGENT_BIN=""

        if [ -z "$AGENT_BIN" ]; then
            warn "there is no Claude CLI on $TARGET that runs"
            # Single-quoted so the far side's shell expands $c and $(node -v).
            _diag=$(t_exec "$NAME" bash -lc '
                c=$(command -v claude 2>/dev/null) || true
                if [ -n "$c" ]; then
                    echo "  on PATH:  $c"
                    echo "  node:     $(node -v 2>&1 | head -1)  (Claude Code needs 18 or newer)"
                    echo "  it fails to start; see for yourself:  ssh '"$TARGET"' claude --version"
                else
                    echo "  nothing called claude is on PATH in a login shell there"
                fi' 2>/dev/null) || true
            # Captured then printed: `2>/dev/null >&2` would send stdout to that /dev/null.
            [ -z "$_diag" ] || printf '%s\n' "$_diag" >&2

            info "installing the Claude CLI on $TARGET (your own ~/.local, as you)"
            t_exec "$NAME" bash -lc 'curl -fsSL https://claude.ai/install.sh | bash' \
                || die "the installer failed on $TARGET. By hand:
    ssh $TARGET 'curl -fsSL https://claude.ai/install.sh | bash'"

            AGENT_BIN=$(t_exec "$NAME" bash -lc '
                for c in "$HOME/.local/bin/claude" "$(command -v claude 2>/dev/null)"; do
                    [ -n "$c" ] && [ -x "$c" ] || continue
                    "$c" --version >/dev/null 2>&1 && { echo "$c"; exit 0; }
                done
                exit 1' 2>/dev/null | tr -d '\r' | tail -1) || AGENT_BIN=""
            [ -n "$AGENT_BIN" ] || die "installed, and still nothing on $TARGET runs: try it by hand --
    ssh $TARGET '~/.local/bin/claude --version'"
        fi
        AGENT_MODE=(--permission-mode auto)
        info "using $AGENT_BIN on $TARGET, in auto mode (this machine is not a sandbox)"
    fi
fi

# A build box keeps its own keys under its own wk root, so the switch is thrown there.
[ "$WK_TARGET_KIND" != remote ] || PUSH_TARGET="$TARGET"
push_hold_back "$NAME"

if [ "$WK_TARGET_KIND" = remote ] \
   && t_exec "$NAME" sh -c 'test -e "$HOME/.config/gh/hosts.yml" || { command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; }' 2>/dev/null; then
    die "'$TARGET' holds a GitHub credential in the account the agent would run as
    (~/.config/gh/hosts.yml, or gh is logged in there), and nothing an agent runs
    may post as you. Remedy, on $TARGET:  gh auth logout"
fi

case "$WK_TARGET_KIND" in
container|vm)
    WK_NAME="$NAME" "$WK_ROOT/cmd/verify" \
        || barrier "the sandbox around '$NAME' is not intact (see above), and relaxed
    permissions are only defensible while it is."
    ;;
remote)
    info "'wk verify' is not run for '$TARGET': there is no sandbox there to
  measure (cmd/verify says so and refuses). The barrier above is the whole of
  the boundary on this target."
    ;;
esac

if [ "$WK_TARGET_KIND" = vm ]; then
    # A macOS guest's egress is filtered on the host by Softnet, unmeasurable from
    # here, and Softnet applies at `tart run`: a guest booted without it is unfiltered.
    if [ -f "$WK_VM_DIR/$NAME.unfiltered" ] && [ -z "${WK_VM_UNFILTERED:-}" ]; then
        barrier "'$NAME' was booted with NO egress filter.
    Restart it filtered:  wk vm stop $NAME && wk vm start $NAME
    (WK_VM_UNFILTERED=1 is the same decision, said the older way.)"
    fi
    if [ -x "${WK_SOFTNET_BIN:-/usr/local/bin/softnet}" ] && [ -z "${WK_VM_UNFILTERED:-}" ]; then
        info "'$NAME' is a macOS VM: egress is filtered on the host by Softnet,
  default-deny except the wk-proxy address. The host filesystem is unreachable
  and the guest is disposable."
    elif [ -n "${WK_VM_UNFILTERED:-}" ]; then
        warn "WK_VM_UNFILTERED=1: '$NAME' has the open network. The host filesystem
  is still unreachable and the guest is still disposable -- but that is the
  whole of the boundary right now."
    else
        barrier "softnet is not installed, so this guest's egress is not filtered.
    Install it:  ./setup --stage softnet   (needs a terminal)
    (WK_VM_UNFILTERED=1 is the same decision, said the older way.)"
    fi
fi

if [ -n "$RC" ]; then
    if [ -n "$RC_STOP" ]; then
        rc_stop "$NAME"
        exit 0
    fi

    if [ -n "$PUSH_WAS_ON" ]; then
        log "  git push stays off ('wk push on' when you want it back)"
        PUSH_WAS_ON=""
    fi

    rc_alive "$NAME" || claude_workspace_config "$NAME"

    if [ "$WK_TARGET_KIND" = container ]; then
        wall_available "$NAME" \
            || die "the commit wall needs bwrap in the workspace image, and '$NAME' has none
    (see 'wk ai claude $NAME' without --rc for the remedy)."
    fi
    rc_start "$NAME" "$AGENT_BIN"
    exit 0
fi

wk_atexit restore_push

WALL=""
if [ "$WK_TARGET_KIND" = container ]; then
    wall_available "$NAME" \
        || die "the commit wall needs bwrap in the workspace image, and '$NAME' has none.
    Rebuild the workspace from a current base ('wk rm $NAME' then 'wk new'), or
    install bwrap in the image; nothing an agent runs may write git history
    while the sandbox cannot stop it."
    WALL="$(commit_wall_prefix "$(t_src "$NAME")") "
    info "git commits are walled off for this session (bwrap; 'wk push on' lifts it for the next)"
fi

# After the sandbox checks: nothing is installed into the workspace before then.
[ "$AGENT" != pi ] || { pi_ensure "$NAME"; AGENT_BIN="$PI_BIN"; }

if [ "$AGENT" = claude ]; then
    claude_workspace_config "$NAME"
    info "starting Claude in '$NAME' (permissions relaxed; the workspace is the boundary)"
else
    info "starting $AGENT in '$NAME' ($AGENT_BIN; the workspace is the boundary)"
fi

# The babysitter's fix loop runs this under nohup with -p, where t_exec_tty would demand a tty.
rc=0
if [ -t 0 ] && [ -t 1 ]; then
    t_exec_tty "$NAME" env WK_AGENT="$AGENT" WK_WORKSPACE="$NAME" \
        bash -lc "cd $(sh_quote "$(t_src "$NAME")") && exec ${WALL}$(sh_quote "$AGENT_BIN") $(sh_quote ${AGENT_MODE[@]+"${AGENT_MODE[@]}"}) $(sh_quote "$@")" || rc=$?
else
    t_exec "$NAME" env WK_AGENT="$AGENT" WK_WORKSPACE="$NAME" \
        bash -lc "cd $(sh_quote "$(t_src "$NAME")") && exec ${WALL}$(sh_quote "$AGENT_BIN") $(sh_quote ${AGENT_MODE[@]+"${AGENT_MODE[@]}"}) $(sh_quote "$@")" || rc=$?
fi
exit "$rc"
