#!/usr/bin/env python3
#
# wk ai claude|pi <workspace> [agent options] -- run a coding agent inside a workspace
# wk: where=workspace name=required@2 ready=yes group=workspaces passthrough=tail
#
# The workspace name comes first; everything after it is the agent's, verbatim.
#
#   wk ai claude bb4 -r          resume, in bb4
#   wk ai claude bb4 --continue  and so on
#   wk ai pi bb4 --help          pi's own help, not this one
#   wk ai claude                 in a workspace: this one, no name
#
# Permissions are relaxed because the workspace is the blast radius, not the
# machine, so this checks the boundary holds before handing over control. For
# the session it also holds back the push keys and walls off git commits.
#
# Run inside a workspace it is the same command and the same start: `claude`
# there is a shell function that calls it (shell/bashrc). What differs is that
# the host's push switch cannot be thrown from in here, so it is measured
# instead -- a key reaching this workspace, or a GitHub or Bugzilla write that
# is not refused, stops the session and no --force crosses it. The checks are
# `wk doctor`'s own, minus the half only the host can answer, and every one
# runs at once.
#
# A Claude session on a terminal starts with Remote Control on, named after
# the workspace (`claude --remote-control <ws>`), so claude.ai/code and the
# mobile app can join it. Remote Control needs the claude.ai account login
# ('wk key set claude-login', which every container and guest reads); where
# $CLAUDE_CODE_OAUTH_TOKEN authenticates the session instead -- the `claude
# setup-token` credential a build box is given -- it starts without Remote
# Control and says so. Onboarding, the trust dialog and the remote-control
# dialog are recorded in the workspace first (claude/workspace-config.py),
# with the account record (oauthAccount.organizationUuid) `claude auth login`
# wrote beside the shared login: each dialog waits for a terminal the agent
# may not have, and Remote Control refuses a login whose organization it
# cannot read (measured against Claude Code 2.1.269).
#
# The agents this knows:
#
#   claude   Claude Code. Installed by container/firstrun.sh, and authenticated
#            by whichever one credential the store delivers to this kind of
#            target (wk_agent_secrets, lib/store.sh).
#   pi       the pi coding agent. Installed per workspace from npm on first
#            use, and pointed at an OpenAI-compatible endpoint by its own
#            config file; `wk key set litellm` stores the key for it.

import json
import os
import shlex
import signal
import subprocess
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import shell, wall  # noqa: E402
from wk.act import Refused, barrier, debug, die, info, log, warn  # noqa: E402
from wk.doctor import Report  # noqa: E402
from wk.machine import Local  # noqa: E402
from wk.targets import Registry, show  # noqa: E402
from wk.workspace import require_name  # noqa: E402

AGENTS = ("claude", "pi")
NOT_INTACT = ("the sandbox around '%s' is not intact (see above), and relaxed\n"
              "    permissions are only defensible while it is.")
# A shared box's `claude` on PATH can be an npm install under too old a node.
FIND_CLAUDE = '''for c in "$HOME/.local/bin/claude" "$(command -v claude 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] || continue
    "$c" --version >/dev/null 2>&1 && { echo "$c"; exit 0; }
done
exit 1'''
CLAUDE_DIAG = '''c=$(command -v claude 2>/dev/null) || true
if [ -n "$c" ]; then
    echo "  on PATH:  $c"
    echo "  node:     $(node -v 2>&1 | head -1)  (Claude Code needs 18 or newer)"
    echo "  it fails to start; see for yourself:  ssh %s claude --version"
else
    echo "  nothing called claude is on PATH in a login shell there"
fi'''
TOKEN_SET = 'printf %s "${CLAUDE_CODE_OAUTH_TOKEN:+set}"'
GH_LOGIN = 'test -e "$HOME/.config/gh/hosts.yml" || { command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; }'

# https://www.npmjs.com/package/@earendil-works/pi-coding-agent has no LiteLLM provider
# (https://github.com/earendil-works/pi#4561, closed unimplemented); LiteLLM speaks the OpenAI
# wire format, so it is a custom provider in ~/.pi/agent/models.json.
PI_PKG = "@earendil-works/pi-coding-agent"
PI_NODE_MIN = "22.19.0"
PI_PROBE = '''printf "node=%s\\n" "$(node -v 2>/dev/null || true)"
printf "npm=%s\\n" "$(command -v npm 2>/dev/null || true)"
p=""
for c in "$HOME/.local/bin/pi" "$(command -v pi 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] || continue
    "$c" --version >/dev/null 2>&1 && { p="$c"; break; }
done
printf "pi=%s\\n" "$p"
[ -f "$HOME/.pi/agent/models.json" ] && printf "models=yes\\n" || printf "models=no\\n"'''
PI_INSTALL = 'npm install -g --ignore-scripts --prefix "$HOME/.local" '   # the image's global prefix is /usr, which the user cannot write


def pi_node_ok(version):
    have = (version[1:] if version.startswith("v") else version).split(".")
    want = PI_NODE_MIN.split(".")
    if have == [""]:
        return False
    n = max(len(have), len(want))
    for h, w in zip(have + ["0"] * (n - len(have)), want + ["0"] * (n - len(want))):
        h, w = h or "0", w or "0"
        if not (h + w).isdigit():
            return False
        if int(h) != int(w):
            return int(h) > int(w)
    return True


def pi_models(endpoint):
    return json.dumps({"providers": {"litellm": {
        "baseUrl": endpoint,
        "api": "openai-completions",
        "apiKey": "$LITELLM_API_KEY",
        "models": [{"id": "REPLACE-WITH-A-MODEL-THIS-ENDPOINT-SERVES"}],
    }}}, indent=2)


def indented(text):
    return "\n".join("    " + line for line in text.replace("\r", "").splitlines())


def foreground(argv, cwd):
    """The session, on this process's terminal; a Ctrl-C there is the agent's, and this waits for it to end."""
    p = subprocess.Popen(argv, cwd=cwd)
    while True:
        try:
            return p.wait()
        except KeyboardInterrupt:
            continue


def on_a_terminal():
    return sys.stdin.isatty() and sys.stdout.isatty()


def _raise(signum, frame):
    raise SystemExit(128 + signum)


class _CatchTermHup:
    """SIGTERM/SIGHUP have no Python-level default: they end the process before a `finally` restores the push switch."""

    def __enter__(self):
        self.old = {sig: signal.signal(sig, _raise) for sig in (signal.SIGTERM, signal.SIGHUP)}
        return self

    def __exit__(self, *exc):
        for sig, handler in self.old.items():
            signal.signal(sig, handler)
        return False


class Ai:
    def __init__(self, root, env, reg, target, agent, name):
        self.root, self.env, self.reg, self.machine = root, env, reg, reg.machine
        self.target, self.agent, self.name = target, agent, name
        self.push_target = None   # a build box keeps its own keys under its own wk root, so the switch is thrown there
        self.push_was_on = False

    def exec(self, argv):
        return self.target.exec(self.name, argv)

    def push_switch(self, verb):
        argv = [os.path.join(self.root, "wk"), "push", verb] + (["--target", self.push_target] if self.push_target else [])
        return (self.machine.run(argv) if verb == "status" else self.machine.act_run(argv)).rc

    def push_status_line(self):
        return "wk push status" + (" --target %s" % self.push_target if self.push_target else "")

    def push_hold_back(self):
        """In a workspace the measurement stands in for the switch, beside the sandbox probes (`checks`)."""
        if self.reg.in_workspace():
            return
        st = self.push_switch("status")
        push_on = wall.push_verdict(st)
        if push_on == 0:
            return
        if push_on is None:
            die("refusing to run: '%s' exited %d rather\n    than measuring the switch, so whether an agent in '%s' could "
                "publish is\n    unknown. Run that command and fix what it names." % (self.push_status_line(), st, self.name))
        self.push_was_on = True
        warn("git push is ON -- turning it off while the agent runs in '%s'" % self.name)
        if self.push_switch("off") != 0:
            die("refusing to run: could not hold back the push keys ('%s')" % self.push_status_line())

    def restore_push(self, terminal):
        if not self.push_was_on:
            return
        if not terminal:
            log("git push stays off (headless session; 'wk push on' when you want it back)")
        elif self.push_switch("on") == 0:
            info("git push turned back on")
        else:
            warn("could not turn git push back on -- 'wk push on'")

    def remote_claude(self):
        tname = self.target.name
        found = self.find_claude()
        if found:
            return found
        warn("there is no Claude CLI on %s that runs" % tname)
        diag = self.exec(["bash", "-lc", CLAUDE_DIAG % tname]).out.replace("\r", "").rstrip("\n")
        if diag:
            sys.stderr.write(diag + "\n")
        info("installing the Claude CLI on %s (your own ~/.local, as you)" % tname)
        r = self.exec(["bash", "-lc", "curl -fsSL https://claude.ai/install.sh | bash"])
        show(r)
        if not r.ok:
            die("the installer failed on %s. By hand:\n    ssh %s 'curl -fsSL https://claude.ai/install.sh | bash'" % (tname, tname))
        found = self.find_claude()
        if not found:
            die("installed, and still nothing on %s runs: try it by hand --\n    ssh %s '~/.local/bin/claude --version'" % (tname, tname))
        return found

    def find_claude(self):
        lines = self.exec(["bash", "-lc", FIND_CLAUDE]).out.replace("\r", "").splitlines()
        return lines[-1] if lines else ""

    def checks(self):
        """`wk doctor`'s checks, run at once: from the host for a container or a guest, from inside for this workspace."""
        kind, name = self.target.kind, self.name
        if kind == "remote":
            info("'wk doctor %s' is not run for '%s': there is no sandbox there to\n  measure (it says so and refuses). The "
                 "barrier above is the whole of the\n  boundary on this target." % (name, self.target.name))
            return
        rep = Report(sys.stderr)
        if kind == "local":
            info("checking workspace '%s' from inside it" % name)
            publishing = wall.from_inside(self.root, self.target, name, self.machine, rep)
        else:
            info("checking workspace '%s' (%s)" % (name, self.target.name))
            publishing = wall.from_host(self.root, self.target, name, self.machine, rep)
        sys.stderr.write("\n")
        v = wall.verdict(rep, publishing)
        if v == "publishing":
            die("refusing to run: an agent in '%s' could publish (see above).\n    Nothing in here can fix it and --force does "
                "not cross it; the switch is the\n    host's:  wk push off" % name)
        if v == "broken":
            warn("%d check(s) failed -- the sandbox is not intact" % rep.missing)
            barrier(NOT_INTACT % name)
        else:
            info("sandbox intact")

    def guest_egress(self):
        """A macOS guest's egress is filtered on the host by Softnet, unmeasurable from in there, and Softnet applies at
        `tart run`: a guest booted without it is unfiltered."""
        name, unfiltered = self.name, self.env.get("WK_VM_UNFILTERED")
        if not self.target.egress_filtered(name) and not unfiltered:
            barrier("'%s' was booted with NO egress filter.\n    Restart it filtered:  wk vm stop %s && wk vm start %s\n"
                    "    (WK_VM_UNFILTERED=1 is the same decision, said the older way.)" % (name, name, name))
        softnet = self.env.get("WK_SOFTNET_BIN") or "/usr/local/bin/softnet"
        if not unfiltered and self.machine.run(["test", "-x", softnet]).ok:
            info("'%s' is a macOS VM: egress is filtered on the host by Softnet,\n  default-deny except the wk-proxy address. Of "
                 "the host filesystem it reaches\n  one directory, the claude.ai login every container mounts too, and the\n"
                 "  guest is disposable." % name)
        elif unfiltered:
            warn("WK_VM_UNFILTERED=1: '%s' has the open network. Of the host filesystem\n  it still reaches only the login "
                 "directory, and the guest is still\n  disposable -- but that is the whole of the boundary right now." % name)
        else:
            barrier("softnet is not installed, so this guest's egress is not filtered.\n    Install it:  ./setup --stage softnet"
                    "   (needs a terminal)\n    (WK_VM_UNFILTERED=1 is the same decision, said the older way.)")

    def wall_available(self):
        """A builtin needs `sh -c`: a target's exec hands argv to an exec, not a shell (measured)."""
        return self.exec(["sh", "-c", "command -v bwrap >/dev/null 2>&1"]).ok

    def workspace_config(self):
        """Onboarding, the trust dialog and the remote-control dialog, answered before a session waits on one."""
        t = self.target
        r = self.exec(["bash", "-lc", "python3 %s %s" % (shlex.quote(t.tools(self.name) + "/claude/workspace-config.py"),
                                                          shlex.quote(t.src(self.name)))])
        out = (r.out + r.err).replace("\r", "").rstrip("\n")
        if not r.ok:
            die("could not record Claude's start-up answers in '%s', and every\n    session there would stop at a dialog "
                "instead of starting:\n%s" % (self.name, indented(out)))
        if out:
            debug(out)

    def pi_probe(self):
        r = self.exec(["bash", "-lc", PI_PROBE])
        if not r.ok:
            die("could not reach the checkout in '%s'" % self.name)
        return dict(line.partition("=")[::2] for line in r.out.replace("\r", "").splitlines() if "=" in line)

    def pi_ensure(self):
        name, probe = self.name, self.pi_probe()
        node, npm = probe.get("node", ""), probe.get("npm", "")
        if not npm or not pi_node_ok(node):
            die("'%s' has no node runtime pi can use: node %s, npm %s.\n    %s needs node >= %s and npm to install itself.\n"
                "    This repository owns no Containerfile for the workspace image -- it is\n    ghcr.io/igalia/wkdev-sdk, "
                "pulled pre-built -- so a runtime it lacks is\n    installed the way the workspace's other tools are: add a "
                "pinned node\n    release to container/firstrun.sh beside the samply and helix installs\n    (fetch, checksum, "
                "unpack into ~/.local), then 'wk rm %s' and 'wk new'.\n    On a build box or a macOS guest, install node >= %s "
                "into your own\n    ~/.local there." % (name, node or "absent", npm or "absent", PI_PKG, PI_NODE_MIN, name, PI_NODE_MIN))
        if not probe.get("pi"):
            info("installing pi in '%s' (npm, into your own ~/.local)" % name)
            r = self.exec(["bash", "-lc", PI_INSTALL + shlex.quote(PI_PKG)])
            show(r)
            if not r.ok:
                die("npm could not install %s in '%s'. By hand:\n        wk enter %s\n        %s%s\n    The workspace's egress "
                    "allows registry.npmjs.org and nothing else npm\n    reaches for (container/proxy/wk-proxy.py is the list)."
                    % (PI_PKG, name, name, PI_INSTALL, PI_PKG))
            probe = self.pi_probe()
            if not probe.get("pi"):
                die("installed, and nothing in '%s' runs as pi. Try it by hand:\n        wk enter %s\n        ~/.local/bin/pi --version"
                    % (name, name))
        if probe.get("models") == "no":
            self.pi_models()
        return probe["pi"]

    def pi_models(self):
        name = self.name
        if not shell.agent_secret_stored(self.root, self.machine, "litellm"):
            log("no LiteLLM key on this machine ('wk key set litellm') and no")
            log("~/.pi/agent/models.json in '%s', so pi will ask you to /login" % name)
            return
        import credcheck
        endpoint = credcheck.LITELLM_ENDPOINT
        write = "mkdir -p ~/.pi/agent && umask 077 && printf '%%s\\n' %s > ~/.pi/agent/models.json" % shlex.quote(pi_models(endpoint))
        if not self.exec(["bash", "-c", write]).ok:
            die("could not write ~/.pi/agent/models.json in '%s'. By hand:\n        wk enter %s\n"
                "        mkdir -p ~/.pi/agent && cat > ~/.pi/agent/models.json" % (name, name))
        info("wrote ~/.pi/agent/models.json in '%s' ($LITELLM_API_KEY, %s)" % (name, endpoint))
        log("  set the model id this endpoint serves:")
        log("    wk enter %s -- ${EDITOR:-vi} ~/.pi/agent/models.json" % name)

    def remote_control(self):
        """A person's Claude session, not the babysitter's `-p`; a set token wins over the login and Remote Control refuses it."""
        if self.agent != "claude" or not on_a_terminal():
            return []
        if self.exec(["bash", "-lc", TOKEN_SET]).out.replace("\r", "").strip() == "set":
            warn("Remote Control is off for this session: $CLAUDE_CODE_OAUTH_TOKEN authenticates it,\n"
                 "  an inference-only credential Remote Control refuses; the claude.ai login is what it needs")
            return []
        return ["--remote-control", self.name]

    def session(self, agent_bin, mode, args):
        name, t = self.name, self.target
        with _CatchTermHup():
            try:
                prefix = []
                if wall.commit_walled(t):
                    if not self.wall_available():
                        die("the commit wall needs bwrap in the workspace image, and '%s' has none.\n    Rebuild the workspace from "
                            "a current base ('wk rm %s' then 'wk new'), or\n    install bwrap in the image; nothing an agent runs "
                            "may write git history\n    while the sandbox cannot stop it." % (name, name))
                    prefix = wall.commit_wall_prefix(self.root, t.src(name))
                    info("git commits are walled off for this session (bwrap; 'wk push on' lifts it for the next)")
                if self.agent == "pi":
                    agent_bin = self.pi_ensure()
                if self.agent == "claude":
                    self.workspace_config()
                    info("starting Claude in '%s' (permissions relaxed; the workspace is the boundary)" % name)
                else:
                    info("starting %s in '%s' (%s; the workspace is the boundary)" % (self.agent, name, agent_bin))
                words = prefix + [agent_bin] + mode + self.remote_control() + args
                line = "cd %s && exec %s" % (shlex.quote(t.src(name)), " ".join(shlex.quote(w) for w in words))
                # The babysitter's fix loop runs this under nohup with -p, where a terminal of its own would be demanded.
                argv, cwd = t.exec_argv(name, ["env", "WK_AGENT=" + self.agent, "WK_WORKSPACE=" + name, "bash", "-lc", line],
                                        on_a_terminal())
                return foreground(argv, cwd)
            finally:
                self.restore_push(on_a_terminal())

    def run(self, args):
        t, name = self.target, self.name
        agent_bin = self.agent
        mode = ["--dangerously-skip-permissions"] if self.agent == "claude" else []
        if t.kind == "remote":
            barrier("'%s' is on the shared build machine '%s', which has no sandbox at\n    all: no container, no separate uid, "
                    "no filesystem boundary, and other\n    people's work on the same machine. An agent there is an agent "
                    "on that\n    machine, with your access." % (name, t.name))
            if self.agent == "claude":
                agent_bin = self.remote_claude()
                mode = ["--permission-mode", "auto"]
                info("using %s on %s, in auto mode (this machine is not a sandbox)" % (agent_bin, t.name))
            self.push_target = t.name
        self.push_hold_back()
        if t.kind == "remote" and self.exec(["sh", "-c", GH_LOGIN]).ok:
            die("'%s' holds a GitHub credential in the account the agent would run as\n    (~/.config/gh/hosts.yml, or gh is "
                "logged in there), and nothing an agent runs\n    may post as you. Remedy, on %s:  gh auth logout" % (t.name, t.name))
        self.checks()
        if t.kind == "vm":
            self.guest_egress()
        return self.session(agent_bin, mode, args)


def main(argv, env=None, reg=None):
    env = os.environ if env is None else env
    agent = argv[0] if argv else ""
    if not agent:
        die("usage: wk ai claude|pi <workspace> [agent options]; see wk ai -h")
    if agent not in AGENTS:
        die("unknown agent '%s'. This checkout knows: %s" % (agent, ", ".join(AGENTS)))
    name = env.get("WK_NAME", "")
    require_name(name)
    reg = reg or Registry(ROOT, env, Local())
    try:
        target = reg.load(reg.ws_target(name))
    except LookupError as e:
        die(str(e))
    return Ai(ROOT, env, reg, target, agent, name).run(argv[1:])


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
