#!/usr/bin/env bash
#
# wk ai claude|pi <workspace> [agent options] -- run a coding agent inside a workspace
# wk: where=workspace name=required@2 ready=yes group=workspaces
#
# One command for every coding agent, because everything around them is the
# same: which workspace, the sandbox check before control is handed over, the
# commit wall, the push switch, and remote control. The agent is the first
# word, so `wk ai <agent> <workspace>` reads as what it does and a second
# agent costs a case arm rather than a command.
#
# Permissions are relaxed because the workspace is the blast radius, not the
# machine; this checks the boundary holds before handing over control.
#
# The workspace name comes first; everything after it is the agent's, verbatim
# -- for claude and for pi alike. The two exceptions are wk's own and are
# taken out of argv here rather than passed on: --rc and --stop, below.
#
#   wk ai claude bb4 -r          resume, in bb4
#   wk ai claude bb4 --continue  and so on
#   wk ai pi bb4 --help          pi's own help, not this one
#
# --rc: Claude Code Remote Control (claude.ai/code, the mobile app) instead of
# a foreground session here -- a persistent server, started detached in the
# workspace's checkout, left running after this command returns.
#
#   wk ai claude <ws> --rc          start it (a no-op, reported, if already up)
#   wk ai claude <ws> --rc --stop   stop it
#
# Remote control is started for every new workspace, and for every workspace a
# `wk start` brings back up, so a workspace is reachable from the phone without
# anybody having remembered to ask. WK_NO_CLAUDE_RC=1 turns that off -- one
# variable rather than a flag on each of those commands, since they both call
# exactly this one.
#
# A fresh workspace needs one interactive `claude` run first, to accept its
# trust dialog -- remote-control refuses without it, and this runs
# 'wk ai claude <ws>' for you when the workspace has no trust record yet.
#
# It also needs the claude.ai account login, not the token below: measured, it
# answers a `claude setup-token` credential with "Remote Control requires a
# full-scope login token ... limited to inference-only". rc_start refuses
# before spawning without one, asking the target that will run the agent --
# `wk key set claude-login` puts one where a container reads it, and a guest
# logs in for itself (t_agent_secret_present, lib/target.sh).
#
# The agents this knows, and what each one costs to add:
#
#   claude   Claude Code. Installed by container/firstrun.sh, authenticated
#            from the store (`wk key set claude`), and the only one with a
#            remote-control server (--rc).
#   pi       the pi coding agent. Installed per workspace from npm on first
#            use, and pointed at an OpenAI-compatible endpoint by its own
#            config file; `wk key set litellm` stores the key for it.

set -euo pipefail
WK_ROOT="${WK_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/detach.sh"

# Which agent: the first positional, and the only one this command reads for
# itself. Read above the library block because every way this command hands over
# control carries it into the workspace as WK_AGENT, which is how the build wall
# tells an agent's shell from a person's.
AGENT="${1:-}"

# --- the functions this hands over through ------------------------------------
# Above everything else so a test can source just these: `WK_CLAUDE_LIB=1 . cmd/ai`
# defines them and returns instead of running the sandbox checks.

# --- nothing an agent runs can publish ---------------------------------------
# The deploy keys and the API token are held back for the whole session by `wk
# push`, which empties the ssh-agent and removes the injector's token file rather
# than setting a flag an agent could clear. Off is the safe crash/kill direction.
# What differs per target is which machine holds the credentials (PUSH_TARGET).
PUSH_WAS_ON=""
PUSH_TARGET=""

push_switch() { # <on|off|status>
    "$WK_ROOT/wk" push "$1" ${PUSH_TARGET:+--target "$PUSH_TARGET"} >/dev/null 2>&1
}

# Before `wk verify`, which measures the keys' absence in a container. t_exec
# hands argv to an exec, not a shell, so a builtin like `command` needs `sh -c`
# (measured: the bare form failed in every container).
wall_available() { # <name>
    t_exec "$1" sh -c 'command -v bwrap >/dev/null 2>&1'
}

# Inside a workspace there is no switch to throw, so what runs instead is the
# *measurement* -- the same two facts `wk verify` takes from the outside. A
# refusal rather than a warning, because `wk push status` exits non-zero in here
# and push_switch reads that as "push is off".
push_measure_here() {
    local alias sock ident code
    # Asked of ssh itself, against the alias a push would use: the config is an
    # Include of /secrets/ssh_config, and re-deriving the path here could disagree.
    alias=$(wk_push_forks | awk 'NF {print $3; exit}')
    sock=$(ssh -G "$alias" 2>/dev/null | awk '$1 == "identityagent" {print $2; exit}') || sock=""
    if [ -n "$sock" ]; then
        ident=$(SSH_AUTH_SOCK="$sock" ssh-add -l 2>/dev/null | grep -c .) || ident=0
        [ "$ident" = 0 ] || die "refusing to run: $ident deploy key(s) reach this workspace through
    $sock, so an agent in here could push. The switch is the host's:  wk push off"
    fi

    code=$(curl -sS -m 20 -o /dev/null -w '%{http_code}' \
               -H 'Authorization: Basic d2s6d2s=' \
               https://api.github.com/user 2>/dev/null) || code=""
    [ "$code" = 401 ] || die "refusing to run: an authenticated GitHub API call from this workspace
    answered '${code:-nothing}' where it must answer 401, so an agent in here
    could post. The switch is the host's:  wk push off"

    info "measured in here: the agent holds nothing and the API refuses -- an agent
  in this workspace can publish neither a push nor a comment"
}

push_hold_back() { # <name>
    if in_workspace; then push_measure_here; return 0; fi
    push_switch status || return 0
    PUSH_WAS_ON=1
    warn "git push is ON -- turning it off while the agent runs in '$1'"
    push_switch off \
        || die "refusing to run: could not hold back the push keys ('wk push status${PUSH_TARGET:+ --target $PUSH_TARGET}')"
}

# Back on only when a person is there to notice: a headless run re-enters this
# command every few minutes via the babysitter's fix loop.
restore_push() {
    [ -n "$PUSH_WAS_ON" ] || return 0
    if [ -t 0 ] && [ -t 1 ]; then
        push_switch on \
            && info "git push turned back on" \
            || warn "could not turn git push back on -- 'wk push on'"
    else
        log "git push stays off (headless session; 'wk push on' when you want it back)"
    fi
}

# --- claude remote-control ----------------------------------------------------

# The pid here names a process t_spawn started *inside* the target, so unlike
# detach_alive everything below asks the driver, not this host's process table.
rc_status_file() { printf '%s' "$(wk_ws_dir "$1")/claude-rc.status"; }
rc_log()         { printf '%s' "$(t_home "$1")/claude-remote-control.log"; }
rc_pidfile()     { printf '%s' "$(t_home "$1")/claude-remote-control.pid"; }

rc_alive() {
    local name="$1" pid
    pid=$(status_field "$(rc_status_file "$name")" pid)
    [ -n "$pid" ] || return 1
    t_exec "$name" kill -0 "$pid" >/dev/null 2>&1
}

# Minutes since the status file's `updated=`, for the "already running" report.
rc_minutes() {
    local upd; upd=$(status_field "$(rc_status_file "$1")" updated)
    [ -n "$upd" ] || { printf '?'; return 0; }
    printf '%d' $(( ( $(date -u +%s) - $(utc_to_epoch "$upd") ) / 60 ))
}

# A second call is a no-op, found by rc_alive rather than trusted from state=.
rc_start() {
    local name="$1" claude_bin="$2" sf log pidf pid i
    sf=$(rc_status_file "$name")

    if rc_alive "$name"; then
        info "'$name' claude remote-control already running, $(rc_minutes "$name") minutes, log at $(status_field "$sf" log)"
        return 0
    fi

    # Before the spawn, whose own answer is to start, print "Remote Control
    # requires a full-scope login token" and exit -- which the evidence check below
    # would report as a server that died. Asked of the target, not this machine's
    # store: a guest holds a login of its own, with its own remedy.
    t_agent_secret_present "$name" claude-login \
        || die "'$name' has no claude.ai login credential -- what 'claude auth login'
    leaves behind -- and remote control refuses anything less: a
    'claude setup-token' token ('wk key set claude') is inference-only.
    $(t_agent_secret_remedy "$name" claude-login)"

    log=$(rc_log "$name"); pidf=$(rc_pidfile "$name")
    t_exec "$name" mkdir -p "$(t_home "$name")" >/dev/null 2>&1 || true

    t_spawn "$name" "$log" "$pidf" \
        env WK_AGENT="$AGENT" WK_WORKSPACE="$name" bash -lc \
        "cd $(sh_quote "$(t_src "$name")") && exec $(sh_quote "$claude_bin") remote-control --spawn=same-dir --name $(sh_quote "$name")" \
        || die "could not start claude remote-control in '$name'"

    # t_spawn's pidfile is inside the target -- read back through the driver
    # rather than assumed host-visible, which is only true for container.
    pid=""; i=0
    while [ -z "$pid" ]; do
        pid=$(t_exec "$name" cat "$pidf" 2>/dev/null | tr -d '\r') || pid=""
        [ -n "$pid" ] && break
        i=$((i + 1))
        [ "$i" -gt 50 ] && die "remote-control did not start in '$name' (no pid after 5s)"
        sleep 0.1
    done

    # Evidence, not a claim: a process that exits within its first seconds is not
    # running, however promptly its pid was written.
    status_write "$sf" state=running "pid=$pid" "log=$log"
    sleep 2
    if ! rc_alive "$name"; then
        status_write "$sf" state=stopped "log=$log"
        die "claude remote-control exited at once in '$name'. Its log ($log) ends:
$(t_exec "$name" tail -n 3 "$log" 2>/dev/null | sed 's/^/    /')"
    fi
    info "claude remote-control running in '$name' (pid $pid), log at $log"
}

# Through the driver, same reasoning as rc_alive.
rc_stop() {
    local name="$1" sf pid
    sf=$(rc_status_file "$name")

    if ! rc_alive "$name"; then
        info "claude remote-control is not running in '$name'"
        status_write "$sf" state=stopped
        return 0
    fi

    pid=$(status_field "$sf" pid)
    info "stopping claude remote-control in '$name' (pid $pid)"
    t_exec "$name" kill "$pid" >/dev/null 2>&1 || true
    status_write "$sf" state=stopped "pid=$pid" "log=$(status_field "$sf" log)"
}

# --- pi: the runtime, and pi itself, in the workspace ------------------------
# From pi's own package and docs
# (https://www.npmjs.com/package/@earendil-works/pi-coding-agent ->
# https://github.com/earendil-works/pi, packages/coding-agent):
#
#   install   `npm install -g --ignore-scripts @earendil-works/pi-coding-agent`;
#             the launcher is `pi`, and package.json declares
#             "engines": { "node": ">=22.19.0" } (0.84.4).
#   the key   there is no LiteLLM provider built in (issue #4561, closed
#             unimplemented). LiteLLM speaks the OpenAI wire format, so it is a
#             custom provider in ~/.pi/agent/models.json: `baseUrl` is the
#             endpoint, `api` is "openai-completions", and `apiKey` is the
#             literal "$LITELLM_API_KEY", which pi resolves from the environment.
#
# No permission-mode flag: pi's `-a` is project *trust* and tool allowlists, not
# --dangerously-skip-permissions.
PI_PKG=@earendil-works/pi-coding-agent
PI_NODE_MIN=22.19.0

# Dotted-version compare, so the refusal below is about what pi actually requires
# rather than a major number: `sort -V` is not on both a BSD and a GNU userland.
pi_node_ok() { # <version, as `node -v` prints it>
    local have="${1#v}" want="$PI_NODE_MIN" hp wp
    [ -n "$have" ] || return 1
    while [ -n "$have" ] || [ -n "$want" ]; do
        hp="${have%%.*}"; wp="${want%%.*}"
        [ -n "$hp" ] || hp=0
        [ -n "$wp" ] || wp=0
        case "$hp$wp" in *[!0-9]*) return 1 ;; esac
        if [ "$hp" -gt "$wp" ]; then return 0; fi
        if [ "$hp" -lt "$wp" ]; then return 1; fi
        case "$have" in *.*) have="${have#*.}" ;; *) have="" ;; esac
        case "$want" in *.*) want="${want#*.}" ;; *) want="" ;; esac
    done
    return 0
}

# Everything in one round trip, testing the property rather than the file: a node
# on PATH is not a node that runs.
pi_probe() { # <name>
    t_exec "$1" bash -lc '
        printf "node=%s\n" "$(node -v 2>/dev/null || true)"
        printf "npm=%s\n" "$(command -v npm 2>/dev/null || true)"
        p=""
        for c in "$HOME/.local/bin/pi" "$(command -v pi 2>/dev/null)"; do
            [ -n "$c" ] && [ -x "$c" ] || continue
            "$c" --version >/dev/null 2>&1 && { p="$c"; break; }
        done
        printf "pi=%s\n" "$p"
        [ -f "$HOME/.pi/agent/models.json" ] && printf "models=yes\n" || printf "models=no\n"
    ' 2>/dev/null | tr -d '\r'
}

# Leaves the pi to launch in PI_BIN, not printed: `die` in a command substitution
# ends the subshell and the caller carries on.
pi_ensure() { # <name>
    local name="$1" probe node npm models key
    PI_BIN=""
    probe=$(pi_probe "$name") || die "could not reach the checkout in '$name'"
    node=$(kv_get node <<<"$probe")
    npm=$(kv_get npm <<<"$probe")
    PI_BIN=$(kv_get pi <<<"$probe")
    models=$(kv_get models <<<"$probe")

    if [ -z "$npm" ] || ! pi_node_ok "$node"; then
        die "'$name' has no node runtime pi can use: node ${node:-absent}, npm ${npm:-absent}.
    $PI_PKG needs node >= $PI_NODE_MIN and npm to install itself.
    This repository owns no Containerfile for the workspace image -- it is
    ghcr.io/igalia/wkdev-sdk, pulled pre-built -- so a runtime it lacks is
    installed the way the workspace's other tools are: add a pinned node
    release to container/firstrun.sh beside the samply and helix installs
    (fetch, checksum, unpack into ~/.local), then 'wk rm $name' and 'wk new'.
    On a build box or a macOS guest, install node >= $PI_NODE_MIN into your own
    ~/.local there."
    fi

    if [ -z "$PI_BIN" ]; then
        info "installing pi in '$name' (npm, into your own ~/.local)"
        # --ignore-scripts: an install hook is arbitrary code from a package this
        # command chose. --prefix ~/.local: npm's global prefix in the image is
        # /usr, which the workspace user cannot write.
        t_exec "$name" bash -lc \
            "npm install -g --ignore-scripts --prefix \"\$HOME/.local\" $(sh_quote "$PI_PKG")" \
            || die "npm could not install $PI_PKG in '$name'. By hand:
        wk enter $name
        npm install -g --ignore-scripts --prefix \"\$HOME/.local\" $PI_PKG
    The workspace's egress allows registry.npmjs.org and nothing else npm
    reaches for (container/proxy/wk-proxy.py is the list)."

        probe=$(pi_probe "$name") || die "could not reach the checkout in '$name'"
        PI_BIN=$(kv_get pi <<<"$probe")
        models=$(kv_get models <<<"$probe")
        [ -n "$PI_BIN" ] || die "installed, and nothing in '$name' runs as pi. Try it by hand:
        wk enter $name
        ~/.local/bin/pi --version"
    fi

    # Which endpoint pi talks to is pi's own config: the key is on this machine,
    # the URL and the model list are the endpoint's and are not stored here.
    [ "$models" = no ] || return 0
    key=$(wk_agent_secret litellm)
    if [ -n "$key" ]; then
        info "'$name' has your LiteLLM key as \$LITELLM_API_KEY and pi has no endpoint to use it on"
        log  "  give it one, in the workspace:"
        log  "    mkdir -p ~/.pi/agent && cat > ~/.pi/agent/models.json <<'EOF'"
        log  "    { \"providers\": { \"litellm\": {"
        log  "        \"baseUrl\": \"https://YOUR-LITELLM-HOST/v1\","
        log  "        \"api\": \"openai-completions\","
        log  "        \"apiKey\": \"\$LITELLM_API_KEY\","
        log  "        \"models\": [ { \"id\": \"A-MODEL-THAT-ENDPOINT-SERVES\" } ] } } }"
        log  "    EOF"
    else
        log "no LiteLLM key on this machine ('wk key set litellm') and no"
        log "~/.pi/agent/models.json in '$name', so pi will ask you to /login"
    fi
}

# This script has top-level side effects (require_name, load_target, the
# sandbox checks below); WK_CLAUDE_LIB=1 sources only the functions above.
[ "${WK_CLAUDE_LIB:-}" != 1 ] || return 0

case "$AGENT" in
    claude|pi) shift ;;
    "")     die "usage: wk ai claude|pi <workspace> [agent options]; see wk ai -h" ;;
    *)      die "unknown agent '$AGENT'. This checkout knows: claude, pi" ;;
esac

# A bare session id ahead of the name (`wk ai claude -r <id> <ws>`) is taken by
# position, not by checking which word is real.
NAME="${WK_NAME:-}"
require_name "$NAME"

# wk's own flags come out of argv here, not Claude's, riding to the pass-through below.
RC=""; RC_STOP=""
_rc_args=()
for _a in ${@+"$@"}; do
    case "$_a" in
        --rc)   RC=1 ;;
        --stop) RC_STOP=1 ;;
        *)      _rc_args+=("$_a") ;;
    esac
done
set -- ${_rc_args[@]+"${_rc_args[@]}"}
[ -z "$RC_STOP" ] || [ -n "$RC" ] || die "--stop only makes sense with --rc: wk ai claude $NAME --rc --stop"
[ -z "$RC" ] || [ $# -eq 0 ] || die "wk ai claude $NAME --rc takes no other options (got: $*)"
# Remote control is a Claude Code server (claude.ai/code attaches to it), not a
# property of running an agent, so it is refused by name rather than ignored.
[ -z "$RC" ] || [ "$AGENT" = claude ] || die "--rc is Claude Code's remote control; $AGENT has no equivalent.
    A foreground session:  wk ai $AGENT $NAME"

TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

# The permission mode is a property of the boundary, not a preference:
# --dangerously-skip-permissions is what a disposable workspace buys; a shared
# build machine has no such boundary, so it gets auto.
AGENT_BIN="$AGENT"
AGENT_MODE=()
[ "$AGENT" != claude ] || AGENT_MODE=(--dangerously-skip-permissions)

# --- verify the sandbox ------------------------------------------------------
# Relaxed permissions hold only while the boundary does, and what it *is* differs
# by target.

if [ "$WK_TARGET_KIND" = local ]; then
    # Nesting another relaxed session here would skip the boundary check the host
    # already did when it started this one.
    die "already inside workspace '$(wk_self)' -- run '$AGENT' directly"
fi

if [ "$WK_TARGET_KIND" = remote ]; then
    # A barrier, not a refusal: this is the one target with no boundary at all.
    barrier "'$NAME' is on the shared build machine '$TARGET', which has no sandbox at
    all: no container, no separate uid, no filesystem boundary, and other
    people's work on the same machine. An agent there is an agent on that
    machine, with your access."

    if [ "$AGENT" = claude ]; then
        # Test the property, not the file: a shared box's `claude` on PATH may be
        # someone else's npm install under too old a node (18+), dying silently.
        AGENT_BIN=$(t_exec "$NAME" bash -lc '
            for c in "$HOME/.local/bin/claude" "$(command -v claude 2>/dev/null)"; do
                [ -n "$c" ] && [ -x "$c" ] || continue
                "$c" --version >/dev/null 2>&1 && { echo "$c"; exit 0; }
            done
            exit 1' 2>/dev/null | tr -d '\r' | tail -1) || AGENT_BIN=""

        if [ -z "$AGENT_BIN" ]; then
            warn "there is no Claude CLI on $TARGET that runs"
            # Single-quoted so the *far* side's shell expands $c and $(node -v);
            # only $TARGET is substituted here.
            _diag=$(t_exec "$NAME" bash -lc '
                c=$(command -v claude 2>/dev/null) || true
                if [ -n "$c" ]; then
                    echo "  on PATH:  $c"
                    echo "  node:     $(node -v 2>&1 | head -1)  (Claude Code needs 18 or newer)"
                    echo "  it fails to start; see for yourself:  ssh '"$TARGET"' claude --version"
                else
                    echo "  nothing called claude is on PATH in a login shell there"
                fi' 2>/dev/null) || true
            # Captured then printed: `2>/dev/null >&2` would send stdout to the
            # /dev/null the first redirect just made.
            [ -z "$_diag" ] || printf '%s\n' "$_diag" >&2

            # Into your own ~/.local with its own runtime: it touches nothing
            # shared, so it is not asked about.
            info "installing the Claude CLI on $TARGET (your own ~/.local, as you)"
            t_exec "$NAME" bash -lc 'curl -fsSL https://claude.ai/install.sh | bash' \
                || die "the installer failed on $TARGET. By hand:
    ssh $TARGET 'curl -fsSL https://claude.ai/install.sh | bash'"

            AGENT_BIN=$(t_exec "$NAME" bash -lc '
                for c in "$HOME/.local/bin/claude" "$(command -v claude 2>/dev/null)"; do
                    [ -n "$c" ] && [ -x "$c" ] || continue
                    "$c" --version >/dev/null 2>&1 && { echo "$c"; exit 0; }
                done
                exit 1' 2>/dev/null | tr -d '\r' | tail -1) || AGENT_BIN=""
            [ -n "$AGENT_BIN" ] || die "installed, and still nothing on $TARGET runs: try it by hand --
    ssh $TARGET '~/.local/bin/claude --version'"
        fi
        AGENT_MODE=(--permission-mode auto)
        info "using $AGENT_BIN on $TARGET, in auto mode (this machine is not a sandbox)"
    fi
fi

# --- the push switch, and the one credential that is a refusal ----------------
# A build box keeps its own keys under its own wk root, so the switch is thrown
# *there*, by name -- every other target's keys are this machine's.
[ "$WK_TARGET_KIND" != remote ] || PUSH_TARGET="$TARGET"
push_hold_back "$NAME"

# A GitHub credential in the account the agent would run as on a shared box is a
# refusal, not a barrier: nothing in a session may post as the person.
if [ "$WK_TARGET_KIND" = remote ] \
   && t_exec "$NAME" sh -c 'test -e "$HOME/.config/gh/hosts.yml" || { command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; }' 2>/dev/null; then
    die "'$TARGET' holds a GitHub credential in the account the agent would run as
    (~/.config/gh/hosts.yml, or gh is logged in there), and nothing an agent runs
    may post as you. Remedy, on $TARGET:  gh auth logout"
fi

if [ "$WK_TARGET_KIND" = container ]; then
    # `wk verify` measures container properties from inside, including that the
    # keys are gone. It reads the name from WK_NAME, as every command does.
    WK_NAME="$NAME" "$WK_ROOT/cmd/verify" \
        || barrier "the sandbox around '$NAME' is not intact (see above), and relaxed
    permissions are only defensible while it is."
fi

if [ "$WK_TARGET_KIND" = vm ]; then
    # Not `wk verify`: every property it measures is a container property. A macOS
    # guest's egress is filtered on the *host* by Softnet, unmeasurable from here,
    # and Softnet applies at `tart run`, so a guest booted without it is unfiltered.
    if [ -f "$WK_VM_DIR/$NAME.unfiltered" ] && [ -z "${WK_VM_UNFILTERED:-}" ]; then
        barrier "'$NAME' was booted with NO egress filter.
    Restart it filtered:  wk vm stop $NAME && wk vm start $NAME
    (WK_VM_UNFILTERED=1 is the same decision, said the older way.)"
    fi
    if [ -x "${WK_SOFTNET_BIN:-/usr/local/bin/softnet}" ] && [ -z "${WK_VM_UNFILTERED:-}" ]; then
        info "'$NAME' is a macOS VM: egress is filtered on the host by Softnet,
  default-deny except the wk-proxy address. The host filesystem is unreachable
  and the guest is disposable."
    elif [ -n "${WK_VM_UNFILTERED:-}" ]; then
        warn "WK_VM_UNFILTERED=1: '$NAME' has the open network. The host filesystem
  is still unreachable and the guest is still disposable -- but that is the
  whole of the boundary right now."
    else
        barrier "softnet is not installed, so this guest's egress is not filtered.
    Install it:  ./setup --stage softnet   (needs a terminal)
    (WK_VM_UNFILTERED=1 is the same decision, said the older way.)"
    fi
fi

# --- wk ai claude <ws> --rc ------------------------------------------------------
# Same sandbox gate as a foreground session; what differs is that a detached
# server runs instead of a session in this process's own slot.
if [ -n "$RC" ]; then
    if [ -n "$RC_STOP" ]; then
        rc_stop "$NAME"
        exit 0
    fi

    # A background server left running unattended: the keys held back above stay
    # held back -- there is no foreground moment here to turn push back on.
    if [ -n "$PUSH_WAS_ON" ]; then
        log "  git push stays off ('wk push on' when you want it back)"
        PUSH_WAS_ON=""
    fi

    # remote-control refuses outright without the workspace's trust dialog accepted
    # once, and there is no non-interactive substitute -- not -p, a piped stdout,
    # nor any `claude config` subcommand -- so this runs `claude` once.
    if ! rc_alive "$NAME" && ! t_exec "$NAME" test -f "$(t_home "$NAME")/.claude.json" 2>/dev/null; then
        warn "'$NAME' has no Claude trust record yet -- remote-control refuses to start
    until the workspace trust dialog is accepted once, interactively. Running
    'wk ai claude $NAME' now; accept the dialog, then exit it."
        "$WK_ROOT/wk" ai claude "$NAME" || true
    fi

    if [ "$WK_TARGET_KIND" = container ]; then
        wall_available "$NAME" \
            || die "the commit wall needs bwrap in the workspace image, and '$NAME' has none
    (see 'wk ai claude $NAME' without --rc for the remedy)."
    fi
    rc_start "$NAME" "$AGENT_BIN"
    exit 0
fi

# The session is a foreground one from here, so the switch can come back when it
# ends (restore_push, which only does that with a person at the terminal).
wk_atexit restore_push

# The commit wall: a container agent session cannot write git history into the
# checkout (commit_wall_prefix) -- the write-side twin of the push keys. A guest
# has no bind to hang it on and a remote no sandbox.
WALL=""
if [ "$WK_TARGET_KIND" = container ]; then
    wall_available "$NAME" \
        || die "the commit wall needs bwrap in the workspace image, and '$NAME' has none.
    Rebuild the workspace from a current base ('wk rm $NAME' then 'wk new'), or
    install bwrap in the image; nothing an agent runs may write git history
    while the sandbox cannot stop it."
    WALL="$(commit_wall_prefix "$(t_src "$NAME")") "
    info "git commits are walled off for this session (bwrap; 'wk push on' lifts it for the next)"
fi

# After the sandbox checks and after push was held back: this installs into the
# workspace, and nothing goes in there while the boundary is unverified.
[ "$AGENT" != pi ] || { pi_ensure "$NAME"; AGENT_BIN="$PI_BIN"; }

# Said per agent because it is not the same claim: claude is handed the flag that
# turns its prompts off, pi is handed nothing of the sort.
if [ "$AGENT" = claude ]; then
    info "starting Claude in '$NAME' (permissions relaxed; the workspace is the boundary)"
else
    info "starting $AGENT in '$NAME' ($AGENT_BIN; the workspace is the boundary)"
fi

# Headless when there's no terminal: the babysitter's fix loop runs this under
# nohup with `-p`, and t_exec_tty would demand a tty. Not exec'd, so the EXIT trap
# still runs when the agent does.
rc=0
if [ -t 0 ] && [ -t 1 ]; then
    t_exec_tty "$NAME" env WK_AGENT="$AGENT" WK_WORKSPACE="$NAME" \
        bash -lc "cd $(sh_quote "$(t_src "$NAME")") && exec ${WALL}$(sh_quote "$AGENT_BIN") $(sh_quote ${AGENT_MODE[@]+"${AGENT_MODE[@]}"}) $(sh_quote "$@")" || rc=$?
else
    t_exec "$NAME" env WK_AGENT="$AGENT" WK_WORKSPACE="$NAME" \
        bash -lc "cd $(sh_quote "$(t_src "$NAME")") && exec ${WALL}$(sh_quote "$AGENT_BIN") $(sh_quote ${AGENT_MODE[@]+"${AGENT_MODE[@]}"}) $(sh_quote "$@")" || rc=$?
fi
exit "$rc"
