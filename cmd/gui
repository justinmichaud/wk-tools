#!/usr/bin/env python3
#
# wk gui <workspace> [<url>] [flags] -- run MiniBrowser in the benchmark seat
# wk: where=workspace name=required ready=yes forward=no group=workspaces takes=1 passthrough
# wk: opts --config=,--wpe,--gtk,--mac,--no-fullscreen,--lldb=
#
# The same launch a perf run performs (Tools/Scripts/run-minibrowser), without
# the benchmark around it. Refuses when there is no session to draw into.
#
#   [<url>]                page to load (default: about:blank)
#   --config <config>      build config to run (default: per-host/workspace);
#                          `wk build --list` lists every name
#   --wpe, --gtk, --mac    shorthand for --config wpe-release / gtk-release / mac-release
#   --no-fullscreen        skip the port's fullscreen flag (WPE: --fullscreen,
#                          GTK: --full-screen; the Apple port has neither)
#   --lldb <ui|web>        run under lldb: "ui" stops before start; "web"
#                          attaches to the web process once it starts
#   -- <args>              extra arguments passed straight to the browser

import os
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import buildconf, decl, shell, targets  # noqa: E402
from wk.act import Refused, die, exec_into, info, log, warn  # noqa: E402
from wk.machine import is_macos  # noqa: E402


def parse(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    # Whichever of --config/--wpe/--gtk/--mac is typed last wins, the same as
    # any repeated option -- so the config each names is read back in the order seen.
    config_named = {"--config": args.value("--config"), "--wpe": "wpe-release" if args.flag("--wpe") else None,
                    "--gtk": "gtk-release" if args.flag("--gtk") else None, "--mac": "mac-release" if args.flag("--mac") else None}
    config = None
    for opt in args.order:
        named = config_named.get(opt)
        if named is not None:
            config = named
    debug = args.value("--lldb") or ""
    if debug and debug not in ("ui", "web"):
        die("--lldb takes ui or web, not '%s'" % debug)
    fullscreen = not args.flag("--no-fullscreen")
    url = args.positionals[0] if args.positionals else ""
    return {"config": config, "url": url, "fullscreen": fullscreen, "tail": args.tail, "debug": debug}


def gui_default_config(reg, name):
    if reg.in_workspace():
        return reg.default_config(name)
    return "mac-release" if is_macos() else "wpe-release"


def fullscreen_flag(cfg):
    if cfg.buildsys == "cmake" and cfg.port in ("--wpe",):
        return "--fullscreen"
    if cfg.buildsys == "cmake" and cfg.port in ("--gtk",):
        return "--full-screen"
    if cfg.buildsys == "xcode" and not cfg.port:
        return ""
    die("'%s' builds no browser to drive -- use a wpe-*, gtk-* or mac-* config" % cfg.name)


def session_env(root):
    """The Linux GPU-session gate and, on a BMC seat, the software-rendering pins."""
    if not targets.session_socket_present(os.environ):
        die("no graphical session -- 'wk session on', or 'wk session on --bmc' to watch it over the BMC")
    shell.session_mode_warn(root, env=os.environ)
    if shell.session_mode(root, env=os.environ) != "bmc":
        return ""
    run_env = ("WEBKIT_DISABLE_DMABUF_RENDERER=1 LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe"
               " __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json")
    dev = shell.bmc_drm_device(root, env=os.environ)
    if dev:
        run_env += " WPE_DRM_DEVICE=%s" % dev
    else:
        warn("could not identify the ast DRM device -- WPE may still infer the GPU")
    info("software session: pinning the browser to Mesa, disabling the dmabuf renderer,")
    log("  and pointing WPE's own DRM device inference at the ast")
    return run_env


def main(argv):
    name = os.environ.get("WK_NAME", "")
    opts = parse(argv)

    reg = targets.Registry(ROOT)
    try:
        target = reg.load(reg.ws_target(name))
    except LookupError as e:
        die(str(e))

    if target.kind == "remote":
        die("wk gui needs a benchmark seat -- a container, a guest or the workspace itself:\n"
            "    '%s' is a remote target, an arbitrary machine reached over ssh with no seat\n"
            "    of its own to draw into. Use a container or vm workspace instead." % name)

    config = opts["config"] or os.environ.get("WK_CONFIG") or gui_default_config(reg, name)
    try:
        cfg = buildconf.resolve(config, target.os(), target.kind, target.env)
    except LookupError:
        die("unknown config '%s'" % config)

    if cfg.jsc_only:
        die("'%s' builds JavaScriptCore alone -- there is no browser in it.\n"
            "    Use a wpe-*, gtk-* or mac-* config." % config)

    fs_flag = fullscreen_flag(cfg) if opts["fullscreen"] else ""
    url = opts["url"] or "about:blank"

    if is_macos() and target.kind == "container":
        die("a container workspace on a macOS host has no display, and cannot get one:\n"
            "    the podman machine has no GPU and there is no compositor to draw into.\n"
            "    Use a macOS guest instead -- 'wk vm new <name>', then 'wk gui <name>',\n"
            "    which runs MiniBrowser on the guest's own desktop with the real GPU.")

    src = target.src(name)
    browser = cfg.browser_path(src)
    if not target.exec(name, ["test", "-x", browser]).ok:
        die("no MiniBrowser at %s -- wk build %s %s" % (browser, name, config))

    run_env = "" if is_macos() else session_env(ROOT)
    extra_q = shell.sh_quote(*opts["tail"])
    type_flag = "--" + cfg.type.lower()

    if cfg.buildsys == "xcode":
        launch_env = cfg.browser_env(src)
        launch_cmd = "%s %s %s %s" % (shell.sh_quote(browser), cfg.browser_url_flag(), shell.sh_quote(url), extra_q)
        ui_prefix = ""
    else:
        launch_env = ("WPE_BROWSER=minibrowser " + run_env).rstrip()
        launch_cmd = "Tools/Scripts/run-minibrowser %s %s -- %s %s %s" % (cfg.port, type_flag, fs_flag, shell.sh_quote(url), extra_q)
        ui_prefix = 'WEBKIT_MINI_BROWSER_PREFIX="$LLDB %s %s --"' % (target.lldb_opts(), shell.LLDB_PIN_OPTS)

    if opts["debug"] == "":
        info("MiniBrowser (%s) in '%s' -> %s" % (config, name, url))
        log("  ctrl-c here closes it")
        cmd = "cd %s && %s %s" % (src, launch_env, launch_cmd)
        argv_, cwd = target.exec_argv(name, ["bash", "-lc", cmd], tty=False)
        exec_into(argv_, cwd)
        return

    if opts["debug"] == "ui":
        info("MiniBrowser (%s) in '%s' under lldb -> %s" % (config, name, url))
        log("  'run' starts it; breakpoints can go in first")
        if cfg.buildsys == "xcode":
            run = ('cd %s && %s exec "$LLDB" %s %s -- %s'
                  % (src, launch_env, target.lldb_opts(), shell.LLDB_PIN_OPTS, launch_cmd))
        else:
            run = "cd %s && %s %s exec %s" % (src, launch_env, ui_prefix, launch_cmd)
        cmd = "%s\n%s" % (shell.lldb_prelude(ROOT), run)
        argv_, cwd = target.exec_argv(name, ["bash", "-lc", cmd], tty=True)
        exec_into(argv_, cwd)
        return

    web_proc = cfg.web_process_name()
    info("MiniBrowser (%s) in '%s' -> %s, lldb waiting for %s" % (config, name, url, web_proc))
    log("  it attaches as the page's process starts; 'continue' lets it run")
    log("  a cross-site navigation moves the page to a *new* process and leaves")
    log("  lldb in the old one, silently -- breakpoints just stop being reached.")
    log("  'follow-page' attaches to every %s, asks each which one holds" % web_proc)
    log("  the live page, and stays there ('reattach' catches the next one at")
    log("  launch instead, for debugging it from the start). Re-set breakpoints.")
    log("  browser output: /tmp/wk-gui.log (in the workspace)")
    run = ("cd %s && ( sleep 2; %s %s %s >/tmp/wk-gui.log 2>&1 ) & "
          'exec "$LLDB" %s -o %s -o %s -o %s -o %s'
          % (src, launch_env, cfg.web_process_pause_env(), launch_cmd, shell.LLDB_PIN_OPTS,
             shell.sh_quote("command script import %s/container/lldb/webprocess.py" % target.tools(name)),
             shell.sh_quote("command alias follow-page wk-follow-page %s" % web_proc),
             shell.sh_quote("command alias reattach process attach --name %s --waitfor" % web_proc),
             shell.sh_quote("process attach --name %s --waitfor" % web_proc)))
    cmd = "%s\n%s" % (shell.lldb_prelude(ROOT), run)
    argv_, cwd = target.exec_argv(name, ["bash", "-lc", cmd], tty=True)
    exec_into(argv_, cwd)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
