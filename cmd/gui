"""run MiniBrowser in the benchmark seat

The same launch a perf run performs (Tools/Scripts/run-minibrowser), without the benchmark around it, on the page named
(default: about:blank). Refuses when there is no session to draw into. Everything after `--` goes to the browser.
"""
from wk import gui, store
from wk.act import die
from wk.decl import Command, Opt

COMMAND = Command(name="required", takes=("[<url>]",), ready=True, forward=False, preset="--preset", repos=("webkit",),
                  tail="--", group="workspaces", opts=(
    Opt("--preset", "the build preset to run (default: the last build's inside a workspace, else mac-release on macOS "
        "and wpe-release elsewhere)", value="<preset>"),
    Opt("--no-fullscreen", "skip the port's fullscreen flag (WPE: --fullscreen, GTK: --full-screen)"),
    Opt("--lldb", "run under lldb: ui stops before start; web attaches to the web process once it starts", value="<ui|web>"),
    Opt("--rr", "record the browser and every process it starts with rr into ~/wk-rr (GTK/WPE); `wk run --replay` "
        "replays it")))


def parse(args):
    debug = args.value("--lldb") or ""
    if debug and debug not in ("ui", "web"):
        die("--lldb takes ui or web, not '%s'" % debug)
    if debug and args.flag("--rr"):
        die("--rr records the browser and --lldb debugs it live; pick one")
    fullscreen = not args.flag("--no-fullscreen")
    url = args.positionals[0] if args.positionals else ""
    return {"url": url, "fullscreen": fullscreen, "tail": args.tail, "debug": debug, "rr": args.flag("--rr")}


def main(args, inv):
    name = store.ws_name()
    return gui.main(name, parse(args))
