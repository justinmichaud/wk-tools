#!/usr/bin/env bash
#
# wk remotes [<workspace>] [--fix] -- are this checkout's git remotes right?
# wk: where=workspace name=optional bare=merged group=sources
# wk: readonly opts --fix,--continued
#
# Asked of the workspace, not of a record: does `origin` mean upstream
# (fetch-only, push URL `no-push://`), can `fork` be pushed to over ssh through
# its host alias, and does a fetch read the machine's mirror for the refs that
# mirror carries? README.md has why the first two are separate.
#
#   wk remotes             every workspace this machine can see
#   wk remotes <ws>        one of them, with its remotes printed
#   wk remotes <ws> --fix  re-assert the wiring and finish `git-webkit setup`
#   wk remotes --fix       ...for every workspace that needs it
#
# --fix touches only git config -- remotes, their fetch refspecs and URL
# rewrite, `core.sshCommand`, the branch's upstream, and what `git-webkit
# setup --defaults` writes (commit hooks, diff drivers, `webkitscmpy.setup`) --
# never a commit or working tree. It is idempotent: a checkout already wired
# and already set up is left as it is.
#
#   0  every checkout is wired correctly (or --fix made it so)
#   1  something is wrong (and --fix was not given)

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

FIX=""
CONTINUED=""
while [ $# -gt 0 ]; do
    case "$1" in
        --fix) FIX=1; shift ;;
        --continued) CONTINUED=1; shift ;;
    esac
done
NAME="${WK_NAME:-}"

worst=0

show_remotes() {
    local ws="$1"
    t_exec "$ws" git -C "$(t_src "$ws")" remote -v 2>/dev/null \
        | tr -d '\r' | sed 's/^/    /' || true
}

# Run in the target: ssh config and `core.sshCommand` only mean anything where git reads them.
check_one() {
    local ws="$1" out rc=0
    out=$(t_exec "$ws" sh -c \
        "$(wk_wiring_check_script "$(t_src "$ws")" "$(t_mirror_dir "$ws")")" 2>/dev/null) || rc=$?

    if [ "$rc" -eq 2 ] || { [ "$rc" -ne 0 ] && [ -z "$out" ]; }; then
        printf '%-20s %s\n' "$ws" "could not be read (is it up? 'wk status $ws')"
        return 1
    fi
    if [ "$rc" -eq 0 ]; then
        printf '%-20s %s\n' "$ws" "origin is upstream, fork pushes over ssh -- ok"
        [ -z "$out" ] || printf '%s\n' "$out" | tr -d '\r' | sed 's/^note: /  ~ /' >&2
        return 0
    fi

    printf '%-20s %s\n' "$ws" "wired wrong:"
    printf '%s\n' "$out" | tr -d '\r' \
        | sed -e 's/^problem: /  - /' -e 's/^note: /  ~ /' >&2
    return 1
}

fix_one() {
    local ws="$1" extra_name="" extra_url="" ssh_config=""
    # shellcheck disable=SC2034 -- read into three names used just below.

    # Straight from the driver, so --fix cannot wire a workspace differently from its creation.
    { read -r extra_name; read -r extra_url; read -r ssh_config; } <<EOF
$(t_wiring_args)
EOF

    t_exec "$ws" sh -c "$(wk_wiring_script "$(t_src "$ws")" "$(t_mirror_dir "$ws")" \
        "$extra_name" "$extra_url" "$ssh_config")" >/dev/null 2>&1 \
        || { warn "could not re-wire '$ws'"; return 1; }
    changed "re-wired '$ws'"

    _b=$(t_exec "$ws" sh -c "$(wk_branch_upstream_fix_script "$(t_src "$ws")")" 2>/dev/null | tr -d '\r') || _b=""
    [ -z "$_b" ] || printf '%s\n' "$_b" | sed 's/^/  /' >&2
    check_one "$ws"   # say it worked, from the same check that would have said otherwise
}

# git-webkit reads the injected GitHub credential and the injector's CA: a container's exec wrapper puts both in the environment (targets/container.sh), a guest's every shell reads them from ~/.wk-egress, and a machine of the person's own carries their own credentials and their own setup.
fix_gitwebkit() {
    local ws="$1" out rc=0
    case "$WK_TARGET_KIND" in container|vm) ;; *) return 0 ;; esac

    out=$(t_exec "$ws" sh -c "$(wk_gitwebkit_setup_script "$(t_src "$ws")")" </dev/null \
              | tr -d '\r' | tail -1) || rc=$?
    if [ "$rc" -ne 0 ]; then
        warn "'git-webkit setup' did not finish in '$ws' (${out:-no answer}); its own
         output is above. 'wk push on' if the read token is off, then
         'wk remotes $ws --fix' again"
        return 1
    fi
    case "$out" in
        setup=ok) changed "git-webkit is set up in '$ws' ($out)" ;;
        *)        log "$(printf '%-20s %s' "$ws" "git-webkit: $out")" ;;
    esac
}

one() {
    local ws="$1" rc=0
    load_target "$(ws_target "$ws")"
    case "$(ws_state "$ws")" in
        absent)      printf '%-20s %s\n' "$ws" "no such workspace"; return 1 ;;
        creating)    printf '%-20s %s\n' "$ws" "still being created -- nothing to check yet"; return 0 ;;
        broken)      printf '%-20s %s\n' "$ws" "the environment is gone ('wk status $ws')"; return 1 ;;
        unreachable) printf '%-20s %s\n' "$ws" "the machine did not answer"; return 1 ;;
    esac
    check_one "$ws" || rc=$?
    [ -n "$FIX" ] || return "$rc"
    rc=0; fix_one "$ws" || rc=$?   # re-asserted even when the check passes: the wiring carries config the check does not read
    fix_gitwebkit "$ws" || rc=$?
    return "$rc"
}

if [ -n "$NAME" ]; then
    require_name "$NAME"
    rc=0; one "$NAME" || rc=$?
    [ "$rc" -eq 0 ] || { log ""; log "  its remotes now:"; show_remotes "$NAME"; }
    exit "$rc"
fi

found=0
_TARGETS=$(walk_targets)
# shellcheck disable=SC2086 -- deliberate word splitting of the target list.
prefetch_targets $_TARGETS
wk_atexit prefetch_done
for TARGET in $_TARGETS; do
    load_target "$TARGET"
    if t_has_wk; then
        rc=0
        WK_NO_DELEGATE=1 t_wk remotes ${FIX:+--fix} || rc=$?
        # A far side running an older wk-tools prints its usage and exits 2, mid-listing.
        if [ "$rc" -eq 2 ]; then
            warn "$TARGET's wk-tools has no 'remotes' command yet (its usage is above)"
            if [ -n "${WK_REMOTE_PEER:-}" ]; then
                log "  it is a workstation with its own checkout:  git pull there"
            else
                log "  update it:  wk sync --tools $TARGET"
            fi
            rc=0
        fi
        [ "$rc" -gt "$worst" ] && worst="$rc"
        found=1
        continue
    fi
    for ws in $(target_workspaces); do
        found=1
        rc=0; one "$ws" || rc=$?
        [ "$rc" -gt "$worst" ] && worst="$rc"
    done

    # The base snapshot is where every *future* workspace gets its remotes from.
    if t_needs_base; then
        _base=$(current_base 2>/dev/null || true)
        _bp=""
        [ -z "$_base" ] || _bp=$(base_path "$_base" 2>/dev/null || true)
        if [ -n "$_bp" ] && [ -d "$_bp/.git" ]; then
            found=1
            rc=0
            _out=$(sh -c "$(wk_wiring_check_script "$_bp" "$(wk_mirror)" skip-env)" 2>/dev/null) || rc=$?
            if [ "$rc" -eq 0 ]; then
                printf '%-20s %s\n' "base:$_base" "origin is upstream, fork pushes over ssh -- ok"
            else
                printf '%-20s %s\n' "base:$_base" "wired wrong (every new workspace starts from this):"
                printf '%s\n' "$_out" | sed -e 's/^problem: /  - /' -e 's/^note: /  ~ /' >&2
                if [ -n "$FIX" ]; then
                    if sh -c "$(wk_wiring_script "$_bp" "$(wk_mirror)")" >/dev/null 2>&1; then
                        changed "re-wired the base snapshot $_base"
                        rc=0
                    else
                        warn "could not re-wire the base snapshot $_base"
                    fi
                fi
                [ "$rc" -gt "$worst" ] && worst="$rc"
            fi
        fi
    fi
done

[ "$found" -eq 1 ] || [ -n "$CONTINUED" ] || log "(no workspaces)"
if [ "$worst" -ne 0 ] && [ -z "$FIX" ] && [ -z "$CONTINUED" ]; then
    log ""
    log "  re-assert the wiring:  wk remotes --fix"
fi
exit "$worst"
