#!/usr/bin/env bash
#
# wk bridge <sub> [<name>] [flags] -- provision a phone as a tailnet bridge
#
# wk: where=host name=none group=hosts
# wk: readonly ls,status,battery
#
# A bridge is a phone with two legs: WiFi to the house, USB-C Ethernet to a
# segment with no other way onto the tailnet -- a BMC's management port, or a
# test board on a cable. Spec: bridge/provision.sh, bridge/bin and
# bridge/hosts/<name>.conf; the phone holds a copy, never the original. It
# runs postmarketOS; getting pmOS onto the device is a hands-on,
# once-per-phone job (wk help).
#
#   ls                        every declared bridge, and what it answers to
#                             (--names: just the names, unprobed -- for scripts)
#   provision <name>          the whole path: image, card, phone, role,
#                             tailnet policy, health check
#   setup <name>              the ssh half of provision; idempotent -- re-run
#                             after any change to the conf or the provisioner
#   tailnet <name>            just the tailnet join and policy print
#   status <name>             what the role reports right now
#   battery <name>            percent, charging state and the charge-limit
#                             node's threshold, read straight from sysfs
#   rm <name>                 remove everything setup left on the phone and
#                             drop the node from the tailnet; leaves the OS
#
#   --at <host>                reach the phone at an address instead of by
#                             name, before it has a tailnet identity. Not
#                             written down -- it is a DHCP lease
#   --disk <machine>:<dev>     (provision) write the card to this disk instead
#                             of Jumpdrive auto-detection
#   --image <path>               (provision) write this image instead of
#                             building or fetching one
#   --rebuild                   (provision) build a fresh image
#   --no-write                  (provision) the phone already holds the right
#                             system; skip writing it
#   --no-tailnet                 (setup) stop after the role, before tailscale
#   --dry-run                    (provision/setup) resolve everything, write
#                             nothing
#
#   WK_BRIDGE_AUTHKEY=<key>       (setup) the tailnet auth key, for a run with
#                             nobody there to paste one in; otherwise this
#                             machine's own fleet key (wk_tailscale_authkey)

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/image.sh"
. "$WK_ROOT/image/profiles.sh"
# The phone's internal storage arrives as a removable disk on whichever machine
# it is cabled to -- what `wk sysimage disks` already solves.
. "$WK_ROOT/boot/machines.sh"
# pmos_newest_out/pmos_fetch_out: the bridge image stays on its build host
# until this file copies it down (image_for, below).
. "$WK_ROOT/image/pmos.sh"
. "$WK_ROOT/boot/disk.sh"
. "$WK_ROOT/bridge/devices.sh"

# Same split as targets (lib/target.sh): the repository holds what is true no
# matter who is driving, ~/.config/wk/bridges this device's own view, which wins.
bridge_registry_dir() { echo "$WK_ROOT/bridge/hosts"; }
bridge_conf_dir()     { echo "${XDG_CONFIG_HOME:-$HOME/.config}/wk/bridges"; }

bridge_conf() {
    local c
    for c in "$(bridge_conf_dir)/$1.conf" "$(bridge_registry_dir)/$1.conf"; do
        [ -f "$c" ] && { printf '%s' "$c"; return 0; }
    done
    return 1
}

bridge_names() {
    local f
    for f in "$(bridge_registry_dir)"/*.conf "$(bridge_conf_dir)"/*.conf; do
        [ -f "$f" ] || continue
        basename "$f" .conf
    done | sort -u
}

load_bridge() {
    local name="$1" conf
    conf=$(bridge_conf "$name") || die "no such bridge '$name'.
    Declared bridges:$(bridge_names | sed 's/^/ /' | tr -d '\n')
    A bridge is a conf file: $(bridge_registry_dir)/<name>.conf
    (shared, in this repository) or $(bridge_conf_dir)/<name>.conf (this
    device only). See 'wk help'."

    BR_NAME="$name"
    BR_DEVICE=""; BR_SSH=""; BR_HOSTNAME=""; BR_TAG=""; BR_SEGMENT=""
    BR_ROUTER=""; BR_IF=""; BR_POOL=""; BR_LEASES=""; BR_EGRESS=""
    BR_CAMERA=""; BR_REACHED_BY=""; BR_NOTE=""; BR_LAN_MAC=""; BR_CARD=""
    BR_USER=""; BR_BATTERY=""; BR_BATTERY_LIMIT=""
    # shellcheck disable=SC1090
    . "$conf"
    BR_CONF="$conf"

    [ -n "$BR_DEVICE" ]   || die "$conf sets no BR_DEVICE (pinephone | librem5)"
    [ -n "$BR_SEGMENT" ]  || die "$conf sets no BR_SEGMENT"
    [ -n "$BR_ROUTER" ]   || die "$conf sets no BR_ROUTER"
    : "${BR_SSH:=$name}"
    : "${BR_HOSTNAME:=$name}"
    : "${BR_TAG:=tag:bridge}"
    : "${BR_IF:=lan0}"
    : "${BR_EGRESS:=none}"
    : "${BR_CAMERA:=off}"
# The account the image logs in as -- `user` is what pmbootstrap creates. --at
# reaches the phone by address, and an address carries no ssh_config `User` line.
    : "${BR_USER:=user}"
# 80% unless a host conf overrides it. BR_BATTERY stays empty: the node is
# autodetected on the phone, and set only when a device exposes more than one
# charge_control_end_threshold.
    : "${BR_BATTERY_LIMIT:=80}"

    bridge_device_load "$BR_DEVICE" \
        || die "$conf names device '$BR_DEVICE', which bridge/devices.sh has never heard of.
    Known devices:
$(bridge_device_list | sed 's/^/      /')"
}

# Every ssh this command makes, optionally through a jump host. --via exists
# because this access point does not bridge 2.4 GHz to 5 GHz or wired at layer 2:
# the phone, its only 2.4 GHz client, answers ARP to none of them. ProxyJump is
# transport only; the key is still this machine's, which the image holds.
BR_VIA=""
_ssh_via() { [ -z "$BR_VIA" ] || printf '%s' "-J $BR_VIA"; }
rsh() { ssh -o BatchMode=yes -o ConnectTimeout=10 $(_ssh_via) "$BR_SSH" "$@"; }

# The ceiling every probe here runs under lives in lib/common.sh as `capped`
# -- ssh's own timeout flags bound only the TCP connect, not a jump hop.
_reaches() { # <destination>
    capped 20 ssh -o BatchMode=yes -o ConnectTimeout=8 $(_ssh_via) \
        -o StrictHostKeyChecking=accept-new "$1" true >/dev/null 2>&1
}

# --- finding the phone when its name does not resolve ------------------------
#
# The name never resolves before the first provision -- `tailscale up` creates it
# -- and multicast mDNS is broken here: the access point declines to forward
# multicast between its radios, and the phone is on the band the workstation is
# not. *Unicast* mDNS works: a query aimed straight at an address, port 5353, is
# answered by the phone and nothing else.

# This machine's /24, from whichever interface holds the default route. A /24 is
# a deliberate assumption -- every network this repo touches uses one.
_bridge_subnet() {
    local ip=""
    if is_macos; then
        ip=$(route -n get default 2>/dev/null | awk '/interface:/ { print $2 }' \
             | while read -r i; do ipconfig getifaddr "$i" 2>/dev/null; done | head -1)
    else
        ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1)
    fi
    [ -n "$ip" ] || return 1
    printf '%s' "${ip%.*}"
}

# One unicast mDNS query; what it prints is the address the responder gives for
# its own name, more correct than the address asked for a multi-homed host. `dig
# +short` writes its timeout message to *stdout* on some platforms, so the answer
# is filtered to something that is actually an address.
_bridge_claims_name() { # <address>  -> prints the answered address
    local got
    got=$(_bridge_dig "$1" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -1)
    [ -n "$got" ] || return 1
    printf '%s' "$got"
}

# Run wherever it can reach the segment: the jump host with --via, since a scan
# from the wrong side of an L2 boundary finds nothing.
_bridge_dig() { # <address>
    if [ -n "$BR_VIA" ]; then
        ssh -o BatchMode=yes -o ConnectTimeout=8 "$BR_VIA" \
            "dig +short +time=1 +tries=1 @$1 -p 5353 $BR_HOSTNAME.local A" \
            < /dev/null 2>/dev/null
    else
        dig +short +time=1 +tries=1 "@$1" -p 5353 "$BR_HOSTNAME.local" A 2>/dev/null
    fi
}

# Every address in this machine's /24, not the neighbour table: macOS `arp -an`
# lists only resolved entries. A unicast mDNS query needs no ARP, so this asks
# all 254 directly, 48 in flight.

# The fallback for when mDNS cannot work: avahi renames itself on a name conflict,
# at which point the phone stops answering for the name it was asked about while
# staying perfectly reachable. A TCP probe gates it, so ssh runs only for the
# handful that answer.
_bridge_ssh_is_phone() { # <address> -> prints the address
    local u got
    capped 4 nc -z "$1" 22 >/dev/null 2>&1 || return 1
    for u in root "$BR_USER"; do
        got=$(capped 10 ssh -o BatchMode=yes -o ConnectTimeout=4 \
                  -o StrictHostKeyChecking=accept-new "$u@$1" hostname 2>/dev/null \
              | tr -d '\r')
        [ "$got" = "$BR_HOSTNAME" ] && { printf '%s' "$1"; return 0; }
    done
    return 1
}

bridge_discover() {
    local base d i n=0 hit when="${BRIDGE_ELAPSED:+$BRIDGE_ELAPSED  }"
    if [ -z "$BR_VIA" ]; then
        have dig || { warn "${when}no dig(1) here, so no host can be asked its name"; return 1; }
    fi
    if [ -n "$BR_VIA" ]; then
        base=$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$BR_VIA" \
                 "ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \\([0-9.]*\\).*/\\1/p' | head -1" \
                 < /dev/null 2>/dev/null)
        base="${base%.*}"
        [ -n "$base" ] || { warn "${when}cannot tell which subnet $BR_VIA is on"; return 1; }
    else
        base=$(_bridge_subnet) || { warn "${when}cannot tell which subnet this machine is on"; return 1; }
    fi

    d=$(mktemp -d) || return 1
    for i in $(seq 1 254); do
        ( a=$(_bridge_claims_name "$base.$i") && printf '%s' "$a" > "$d/hit.$i" ) &
        n=$((n + 1))
        [ $(( n % 48 )) -eq 0 ] && wait
    done
    wait
    hit=$(cat "$d"/hit.* 2>/dev/null | head -1)
    rm -rf "$d"
    [ -z "$hit" ] || { printf '%s' "$hit"; return 0; }

    # Nobody answered for the name; ask over ssh instead.
    log "  ${when}no host in $base.0/24 answers for $BR_HOSTNAME.local -- asking over ssh"
    d=$(mktemp -d) || return 1
    n=0
    for i in $(seq 1 254); do
        ( a=$(_bridge_ssh_is_phone "$base.$i") && printf '%s' "$a" > "$d/hit.$i" ) &
        n=$((n + 1))
        [ $(( n % 32 )) -eq 0 ] && wait
    done
    wait
    hit=$(cat "$d"/hit.* 2>/dev/null | head -1)
    rm -rf "$d"
    [ -n "$hit" ] || {
        log "  ${when}no host in $base.0/24 is $BR_HOSTNAME, by name or by ssh"
        return 1
    }
    printf '%s' "$hit"
}

# Which name or address actually reaches the phone right now.
#
# Three attempts, in decreasing order of "somebody said so": --at (refused rather
# than worked around if it fails), $BR_SSH (the conf's tailnet name), then
# <hostname>.local mDNS -- tried and not relied on. A subnet-wide ssh sweep is not
# a fourth route: thirty seconds per invocation against a radio that drops
# associations under load. accept-new, not open host-key checking: a fresh image
# brings an unverifiable key, but root on a bridge is whatever is behind it.
resolve_ssh() {
    local u

    if [ -n "${BR_AT:-}" ]; then
        # root first, for the reason resolve_priv prefers it: the image seeds
        # root's key so provisioning needs no password.
        for u in root "$BR_USER"; do
            if _reaches "$u@$BR_AT"; then BR_SSH="$u@$BR_AT"; return 0; fi
        done
        die "--at $BR_AT does not answer ssh as root or '$BR_USER'.
    An address given on the command line is taken at its word rather than worked
    around, because the alternative is provisioning something else. Drop --at to
    try the phone's names instead."
    fi

    _reaches "root@${BR_SSH#*@}" && { BR_SSH="root@${BR_SSH#*@}"; return 0; }
    _reaches "$BR_SSH" && return 0

    # root first here too. dotfiles/ssh/config sets `User user` for these names,
    # so the bare name lands as the console user, which would make resolve_priv
    # bootstrap root on every run.
    local mdns="$BR_HOSTNAME.local"
    for u in "root@$mdns" "$mdns"; do
        if _reaches "$u"; then
            warn "$BR_SSH does not resolve yet, but $mdns answers -- using that."
            BR_SSH="$u"
            return 0
        fi
    done

    # Callers that poll pass --names-only: discovery sweeps a subnet and must not
    # run once every five seconds.
    [ "${1:-}" = --names-only ] && return 1

    local found
    found=$(bridge_discover) || return 1
    for u in root "$BR_USER"; do
        if _reaches "$u@$found"; then
            changed "found $BR_NAME at $found (it identifies itself as $BR_HOSTNAME)"
            log  "  a DHCP lease, so it is used for this run and not written down."
            log  "  Once tailscale is up, $BR_HOSTNAME is the name that lasts."
            BR_SSH="$u@$found"
            return 0
        fi
    done
    warn "$found says it is $BR_HOSTNAME but does not accept ssh as root or '$BR_USER'."
    return 1
}

# Give root the console user's ssh key, using the image's own console password:
# pmOS images log in as an ordinary user with doas or sudo. That password is not
# a secret (image/profiles.sh) -- pmbootstrap handles it in plain text by design,
# and it is the recovery path on the phone's own screen. An image that seeds
# root's key at build time never reaches this.
bridge_bootstrap_root() {
    local prof pw target host
    prof=$(bridge_profile "$BR_NAME" || true)
    [ -n "$prof" ] || return 1
    pw=$(profile_field "$prof" PMO_PASSWORD)
    [ -n "$pw" ] || return 1

    info "giving root the same ssh key, so provisioning needs no password"
    log  "  pmbootstrap installs the key for '$BR_USER' only, and that account cannot"
    log  "  become root without one. Using PMO_PASSWORD from image/profiles.sh, which"
    log  "  is deliberately not a secret. An image that sets it at build time"
    log  "  skips this step entirely."

    # -tt because doas reads its prompt from a tty and refuses a pipe outright.
    #
    # The password is sent after a pause: password readers flush pending terminal
    # input before prompting, so writing it up front gets it thrown away.
    #
    # Not wrapped in `capped` -- that backgrounds the command, and bash redirects a
    # background job's stdin from /dev/null. doas itself is the bound. Output is
    # discarded: a pty echoes what is written to it.
    target="/home/$BR_USER/.ssh/authorized_keys"
    ( sleep 3; printf '%s\n' "$pw"; sleep 3 ) \
        | ssh -tt -o ConnectTimeout=15 \
              -o StrictHostKeyChecking=accept-new "$BR_SSH" \
              "doas sh -c 'install -d -o root -g root -m 700 /root/.ssh && install -o root -g root -m 600 $target /root/.ssh/authorized_keys'" \
              >/dev/null 2>&1 || true

    # The pipeline above cannot report failure reliably -- with a pty, ssh's exit
    # status is about the pty -- so the test is whether root now answers.
    host="${BR_SSH#*@}"
    if _reaches "root@$host"; then
        BR_SSH="root@$host"
        changed "root on $host now accepts the same key"
        return 0
    fi
    return 1
}

PRIV=""
resolve_priv() {
    local uid
    resolve_ssh || die "cannot reach $BR_NAME.
    Tried the name in its conf and $BR_HOSTNAME.local, and neither answered.

    If it was answering earlier, two things do this to an unprovisioned phone
    and the role fixes both -- which is why they are now also baked into the
    image (image/pmos-build.sh), since a phone that needs them in order to
    answer ssh cannot be sent them over ssh:
      - WiFi power save. The RTL8723CS powers its RF side down when idle and
        misses frames aimed at it, so the phone reaches its router while
        answering nothing, ARP included. Proving it takes one command on the
        phone: iw dev wlan0 set power_save off
      - suspend. phosh idles it off the network after a few minutes.

    mDNS is unreliable here through the network rather than the phone: an access
    point that will not forward multicast between its radios breaks the name
    while leaving the phone perfectly reachable. So if you know the address:

        wk bridge <sub> $BR_NAME --at <address>

    Otherwise the phone is off, on another subnet, or was never installed;
    'wk bridge provision $BR_NAME' does the whole path."
    uid=$(rsh 'id -u') || die "cannot ssh to $BR_SSH.
    A bridge is provisioned over ssh against a phone that is already running
    postmarketOS and already answers -- 'wk help' covers getting it
    there, which is a hands-on job once per phone."
    if [ "$uid" = 0 ]; then PRIV=""; return 0; fi
    if rsh 'command -v doas >/dev/null 2>&1'; then PRIV="doas"
    elif rsh 'command -v sudo >/dev/null 2>&1'; then PRIV="sudo -n"
    else die "ssh to $BR_SSH lands on uid $uid and the phone has neither doas nor sudo.
    Either is fine; without one there is no way to provision from here."
    fi
    # Proven, not assumed: a doas that will ask for a password fails silently
    # halfway through a provision run.
    if ! rsh "$PRIV true" >/dev/null 2>&1; then
        # The console password is known and not secret -- bridge_bootstrap_root.
        if bridge_bootstrap_root; then PRIV=""; return 0; fi
        die "'$PRIV' on $BR_SSH needs a password, and root could not be given the key either.
    Provisioning is non-interactive over ssh, so one of the two has to work.
    By hand on the phone, once:
        doas install -d -o root -g root -m 700 /root/.ssh
        doas install -o root -g root -m 600 ~/.ssh/authorized_keys /root/.ssh/authorized_keys
    Newer images do this at build time (image/pmos-build.sh)."
    fi
}

# --- ls ----------------------------------------------------------------------
# `accept-new` accepts a key never seen before but still refuses one that moved.
# A refused key is reported as itself rather than as absence, since a reflash
# changes the key and "unreachable" would aim the diagnosis at the phone's power
# and radio instead of at known_hosts. cmd/selftest lifts _ls_classify out.
_ls_classify() { # <ssh stderr> -> key-changed | unreachable
    case "$1" in
        *"IDENTIFICATION HAS CHANGED"*|*"Host key verification failed"*)
            printf 'key-changed' ;;
        *)  printf 'unreachable' ;;
    esac
}

_ls_probe() { # <destination> -> up | key-changed | unreachable
    local err rc=0
    err=$(ssh -o BatchMode=yes -o ConnectTimeout=5 \
              -o StrictHostKeyChecking=accept-new "$1" true 2>&1) || rc=$?
    [ "$rc" -eq 0 ] && { printf 'up'; return 0; }
    _ls_classify "$err"
}

cmd_ls() {
    local name any=""
    # --names: every declared bridge, one per line, nothing probed -- so `wk
    # doctor --all` need not re-derive the local-overrides-repo conf merge.
    if [ "${1:-}" = --names ]; then
        bridge_names
        return 0
    fi
    printf '%-28s %-10s %-16s %-12s %s\n' NAME DEVICE SEGMENT STATE NOTE
    for name in $(bridge_names); do
        any=1
        ( load_bridge "$name"
          state=$(_ls_probe "$BR_SSH")
          if [ "$state" = up ]; then
              if ssh -o BatchMode=yes -o ConnectTimeout=5 \
                     -o StrictHostKeyChecking=accept-new "$BR_SSH" \
                     'test -f /etc/wk-bridge.conf' >/dev/null 2>&1; then
                  state=provisioned
              else
                  state=bare
              fi
          fi
          printf '%-28s %-10s %-16s %-12s %s\n' \
              "$BR_NAME" "$BR_DEVICE" "$BR_SEGMENT" "$state" "${BR_NOTE:-}" ) \
            || warn "$name: its conf does not load -- 'wk bridge status $name' says why"
    done
    [ -n "$any" ] || log "(no bridges declared -- bridge/hosts/*.conf)"
    log ""
    log "  bare         answers ssh, nothing of this role on it yet"
    log "  provisioned  'wk bridge setup' has run against it"
    log "  key-changed  answered, with a host key that is not the one on record."
    log "               A reflash does this: drop the old line from known_hosts"
    log "               (ssh-keygen -R <name>). Anything else is worth reading"
    log "               before you do."
    log "  unreachable  did not answer in 5s -- off, or not flashed yet"
}

# --- provision ---------------------------------------------------------------
#
# The whole path, from nothing to a health check, as one verb. Holds no tailscale
# credential: minting the auth key and writing the tailnet policy stay the
# operator's.
#
# Installs onto the phone's internal storage, never the card: a bridge writes
# leases, logs and tailscale state for months and a microSD wears out first, so
# the card stays the rescue copy. Jumpdrive, the service image, boots from the
# card and exports the internal storage as USB mass storage, turning "flash a
# phone" into `wk sysimage write`. BR_CARD names the machine holding the reader.
# Every step is skipped when already done; --no-write covers the one thing that
# cannot be inferred, that the phone already holds the right system.

# One field out of one profile, without leaving a profile loaded behind.
profile_field() {
    ( image_profile_load "$1" >/dev/null 2>&1 || exit 0
      local v="$2"
      printf '%s' "${!v:-}" )
}

profile_names() { image_profile_list | awk '/^[a-z0-9-]+$/ { print $1 }'; }

# The two lookups below share a shape and deliberately not an abstraction: a
# `profile_matching <test-command>` helper would word-split its argument without
# quote removal. Neither uses `| head -1` either -- under `set -o pipefail`, head
# SIGPIPEs the producer and turns a successful lookup into a failed one.

# Derived rather than declared twice: image/profiles.sh already records which
# bridge each pmos profile is for (PMO_BRIDGE).
bridge_profile() {
    local want="$1" p hit
    for p in $(profile_names); do
        hit=$( image_profile_load "$p" >/dev/null 2>&1 || exit 0
               [ "${IMG_BUILDER:-}" = pmos ] || exit 0
               [ "${PMO_BRIDGE:-}" = "$want" ] || exit 0
               printf '%s' "$p" )
        [ -z "$hit" ] || { printf '%s' "$hit"; return 0; }
    done
    return 1
}

# The service image that exports this phone's internal storage, matched on the
# pmOS device codename (PMO_DEVICE joins FET_DEVICE). A phone with no such profile
# is real: Jumpdrive is a PinePhone project with no Librem 5 equivalent.
recovery_profile() {
    local want p hit
    want=$(profile_field "$1" PMO_DEVICE)
    [ -n "$want" ] || return 1
    for p in $(profile_names); do
        hit=$( image_profile_load "$p" >/dev/null 2>&1 || exit 0
               [ "${IMG_BUILDER:-}" = fetch ] || exit 0
               [ "${FET_DEVICE:-}" = "$want" ] || exit 0
               printf '%s' "$p" )
        [ -z "$hit" ] || { printf '%s' "$hit"; return 0; }
    done
    return 1
}

# An image for a profile, as a local path ready for `wk sysimage write --from` --
# there is no store to look one up in, so getting one is a property of which
# builder made it. It takes `force` so "the newest will do" and "I want a fresh
# one" are one code path with one set of failure messages.
image_for() {
    local profile="$1" force="${2:-}"
    image_profile_load "$profile" || die "unknown profile '$profile' (image/profiles.sh)"
    case "$IMG_BUILDER" in
        fetch) _fetch_image_for "$force" ;;
        pmos)  _pmos_image_for "$profile" "$force" ;;
        *) die "internal: '$profile' is a '$IMG_BUILDER' profile, and 'wk bridge' only
    knows how to get an image from a fetch or a pmos profile." ;;
    esac
}

# A fetch profile's image is its cached download (image_fetch_base), pinned by
# content, so --rebuild has no fresher copy to make; asked for anyway, so a caller
# need not know that about this one builder.
_fetch_image_for() {
    local force="${1:-}"
    [ -z "$force" ] || debug "fetch profiles are pinned by content -- --rebuild re-verifies rather than re-downloading"
    image_fetch_base "$FET_URL" "$FET_SHA256"
}

_pmos_image_cleanup() { [ -n "${PMOS_IMAGE_TMP:-}" ] && rm -f "$PMOS_IMAGE_TMP"; PMOS_IMAGE_TMP=""; return 0; }

# A pmos profile's image is built on its build host and stays there until the
# bytes are needed locally: copied into a scratch file cleaned up on exit.
_pmos_image_for() {
    local profile="$1" force="${2:-}" id
    if [ -z "$force" ] && id=$(pmos_newest_out "$profile" 2>/dev/null); then
        info "using $id from $(pmos_host)"
        log  "  --rebuild builds a fresh one instead"
    else
        if [ -n "$force" ]; then
            info "building a new $profile (--rebuild)"
        else
            info "no finished $profile build on $(pmos_host) yet -- building one"
        fi
        "$WK_ROOT/wk" sysimage build "$profile" >&2 \
            || die "the $profile build failed -- nothing was written to any disk"
        image_profile_load "$profile" >/dev/null 2>&1
        id=$(pmos_newest_out "$profile") \
            || die "the $profile build reported success but left no finished build on $(pmos_host)"
    fi
    PMOS_IMAGE_TMP=$(mktemp)
    wk_atexit _pmos_image_cleanup
    pmos_fetch_out "$id" "$PMOS_IMAGE_TMP"
}

# Wait for a person. Not `confirm`: there is nothing being decided, and a y/N
# question invites the answer "n" for a step that has no alternative.
pause() {
    [ -t 0 ] || die "this step needs a terminal, and there is not one: $*"
    printf '\n%s' "$* [enter when done] " >&2
    local _reply
    read -r _reply || die "aborted -- nothing further was changed"
}

# resolve_ssh is one attempt at both names; this is that in a loop, since a phone
# booting pmOS takes a minute or two. Two cadences: the cheap attempts run every
# tick, discovery only every DISCOVER_EVERY seconds -- resweeping a subnet would
# load the very link the phone needs.
wait_for_phone() {
    local budget="${1:-420}" start="$SECONDS" last_disc=-999 now
    local DISCOVER_EVERY=60
    while :; do
        now=$((SECONDS - start))
        [ "$now" -lt "$budget" ] || break

        # Redirected because ssh eats stdin and a terminal is waiting on this loop.
        if resolve_ssh --names-only < /dev/null; then return 0; fi

        if [ $((now - last_disc)) -ge "$DISCOVER_EVERY" ]; then
            last_disc="$now"
            # One line per round from bridge_discover, saying what it looked at.
            BRIDGE_ELAPSED=$(printf '%d:%02d' $((now / 60)) $((now % 60)))
            printf '\n' >&2
            if resolve_ssh < /dev/null; then return 0; fi
        fi
        printf '.' >&2
        sleep 5
    done
    log ""
    return 1
}

# --- finding the phone's storage once Jumpdrive has exported it ---------------
#
# By difference, not by recognition: what Jumpdrive exports is a generic USB
# mass-storage LUN, so the question is which disks were not here before the phone
# was plugged in. The cost of a wrong guess is overwriting the boot stick.

# `<dev> <size>` for every removable disk on a machine, one per line, sorted.
# `< /dev/null` because disk_candidates reaches the machine over ssh, which
# forwards stdin to the far side, and both callers poll this against a terminal.
disks_now() {
    disk_candidates < /dev/null | awk '{ print $1, $2 }' | sort
}

disks_new() {
    comm -13 <(printf '%s\n' "$1") <(disks_now)
}

# Polled, because a phone takes a few seconds to boot Jumpdrive.
wait_for_disks() {
    local baseline="$1" budget="${2:-180}" start="$SECONDS" found
    while [ $((SECONDS - start)) -lt "$budget" ]; do
        found=$(disks_new "$baseline")
        [ -z "$found" ] || { printf '%s' "$found"; return 0; }
        printf '.' >&2
        sleep 5
    done
    log ""
    return 1
}

# Which of the new disks is the phone's internal storage.
#
# Jumpdrive on a PinePhone exports the SD card *as well as* the eMMC, as two
# separate LUNs, one of them the Jumpdrive card currently running. Writing the
# bridge image to that one destroys the tool doing the writing.
#
# LUN order and size are both guesses: order can change with a firmware or
# Jumpdrive release, and eMMC/card size ranges overlap. The SCSI model string
# (Jumpdrive 0.8 labels them `e eMMC` and `e microSD`) is only corroboration,
# being an undocumented cosmetic choice of one release. What is certain: we wrote
# the card ourselves and verified the read-back, so the card is the exported disk
# whose head matches the image just written and the other is the eMMC. Both
# failure modes are reported: nothing matched, or everything matched.
CARD_HEAD_BYTES=1048576

image_head_sha() {
    dd if="$1" bs="$CARD_HEAD_BYTES" count=1 2>/dev/null | sha256sum | cut -d' ' -f1
}

# The head of a block device on the card machine, hashed there. `sudo` because a
# raw block device is not world readable. `< /dev/null` is load-bearing: ssh
# forwards stdin to the far side, so calling this inside a `while read` loop would
# eat every candidate after the first. The length is checked, not just the hash:
# a device that reads zero bytes hashes to the sha256 of the empty string, and
# unguarded such a disk is classified "not the card" and *selected as the eMMC*.
device_head_sha() {
    local out bytes sha
    out=$(m_ssh "sudo dd if=$(sh_quote "$1") bs=$CARD_HEAD_BYTES count=1 2>/dev/null | wc -c
                 sudo dd if=$(sh_quote "$1") bs=$CARD_HEAD_BYTES count=1 2>/dev/null | sha256sum" \
          < /dev/null 2>/dev/null) || return 1
    bytes=$(printf '%s\n' "$out" | sed -n 1p | tr -dc '0-9')
    sha=$(printf '%s\n'   "$out" | sed -n 2p | cut -d' ' -f1)
    [ "${bytes:-0}" = "$CARD_HEAD_BYTES" ] || return 1
    [ -n "$sha" ] || return 1
    printf '%s' "$sha"
}

# What the phone is presenting over USB, when it is not presenting storage. It is
# not silent when Jumpdrive fails to boot -- it comes up on its own OS instead,
# and postmarketOS's default USB gadget is MTP with Pine64's own vendor id,
# positive evidence of exactly which failure this is. Reported, never acted on.
phone_usb_note() {
    local usb
    usb=$(m_ssh "lsusb 2>/dev/null" < /dev/null 2>/dev/null) || return 0
    case "$usb" in
        *18d1:4ee1*|*"Nexus/Pixel Device (MTP)"*)
            printf 'the phone IS attached, and it is presenting an MTP gadget (18d1:4ee1)
    rather than storage. That is postmarketOS default -- so the phone booted its
    own installed OS and never read the card. Jumpdrive is not running.
      - power the phone fully OFF: hold power for about 12 seconds until the
        screen is black and stays black. A reboot or a wake from sleep does not
        re-run the boot ROM, so the card is never looked at
      - re-seat the card. The slot is under the back cover, and a card that is
        half in looks exactly like no card at all'
            ;;
        *)
            printf 'nothing on %s'"'"'s USB looks like a phone at all, which points at the
    cable rather than at the card -- a charge-only cable is the most common
    cause of this exact symptom. Jumpdrive would also have drawn a splash
    listing the storage sizes; a blank screen means the card did not boot.' "$NODE_NAME"
            ;;
    esac
}

identify_internal_storage() {
    local candidates="$1" jd_disk="$2" want dev size head
    local emmc="" cards="" n=0

    want=$(image_head_sha "$jd_disk")
    [ -n "$want" ] || die "could not hash the first $(human_bytes "$CARD_HEAD_BYTES") of $jd_disk.
    That hash is how the Jumpdrive card is told apart from the phone's own
    storage, and without it there is nothing to distinguish them by."

    info "identifying the phone's internal storage by content"
    log  "  the card is whichever exported disk matches the Jumpdrive we just wrote;"
    log  "  the eMMC is the other one. Nothing is assumed about LUN order."

    # Collected before hashing: a loop whose body runs ssh cannot also be
    # reading from a heredoc.
    local devs=() sizes=() i
    while read -r dev size; do
        [ -n "$dev" ] || continue
        devs+=("$dev"); sizes+=("$size")
    done <<EOF
$candidates
EOF
    n=${#devs[@]}
    [ "$n" -gt 0 ] || die "identify_internal_storage was given no disks at all."

    for i in $(seq 0 $((n - 1))); do
        dev="${devs[$i]}"; size="${sizes[$i]}"
        head=$(device_head_sha "$dev" || true)
        [ -n "$head" ] || die "could not read the first $(human_bytes "$CARD_HEAD_BYTES") of $dev on $NODE_NAME.
    It is listed as a disk but does not deliver that much when read -- a card
    that has been pulled since the listing, or a LUN the phone is advertising
    without backing. Telling the card from the eMMC is decided by reading both,
    so an unreadable one stops this rather than being assumed to be either.
    Nothing was written."
        if [ "$head" = "$want" ]; then
            log  "  $dev  $size  -- the Jumpdrive card (its head matches the image)"
            cards="$cards $dev"
        else
            log  "  $dev  $size  -- not the card"
            emmc="$emmc $dev"
        fi
    done

    cards="${cards# }"; emmc="${emmc# }"

    [ -n "$cards" ] || die "none of the $n disks the phone exported is the Jumpdrive card.
    Exported:
$(printf '%s\n' "$candidates" | sed 's/^/      /')
    The card was written and read back minutes ago, so one of these should have
    matched it byte for byte. That it did not means these are not the disks this
    was looking for -- something else was plugged into $NODE_NAME, or the phone
    is exporting something other than its storage. Nothing was written."

    if [ -z "$emmc" ] && [ "$n" = 1 ]; then
        die "the only disk that appeared is the Jumpdrive card itself -- the phone's
    internal storage did not show up beside it.
    Jumpdrive exports both, so one LUN and not two means the eMMC was not
    exported. Worth trying, in order: power the phone right off and boot it
    again (a partial gadget setup does look exactly like this), and check the
    phone is a model with eMMC at all. Nothing was written."
    fi
    case "$emmc" in
        "") die "every one of the $n disks that appeared matches the Jumpdrive image.
    Two disks carrying the same image is ambiguous, and not something to resolve
    by picking one -- so nothing was written.
    'wk sysimage disks $NODE_NAME' is what this was looking at."
            ;;
        *" "*) die "the phone exported more than one disk that is not the Jumpdrive card:
      $emmc
    The eMMC is meant to be the only one left after the card is eliminated, so a
    second candidate means something else is attached to $NODE_NAME that was not
    there when the baseline was taken. Unplug it and re-run; nothing was
    written."
            ;;
    esac

    # Corroboration from a signal unrelated to the hash: the label Jumpdrive puts
    # on the LUN. Two signals disagreeing is not resolved by picking a favourite.
    local model
    model=$(m_ssh "lsblk -dno MODEL $(sh_quote "$emmc")" < /dev/null 2>/dev/null \
            | tr -d '\r' | sed 's/[[:space:]]*$//')
    case "$model" in
        *microSD*|*microsd*|*MicroSD*|*micro-SD*)
            die "the content check picked $emmc as the phone's internal storage, but that
    disk reports its own model as '$model'. Two independent signals disagreeing
    about the same disk is not something to resolve by preferring one of them,
    least of all for a write that erases it. Nothing was written.
    'wk sysimage disks $NODE_NAME' shows what is attached."
            ;;
    esac

    info "the phone's internal storage is $emmc${model:+ (which calls itself '$model', agreeing)}"
    printf '%s' "$emmc"
}

# Is the segment actually routed? Without `autoApprovers` the bridge is up,
# healthy, tagged and advertising -- and nothing behind it is reachable.
route_approved() {
    local r
    r=$(rsh "$PRIV tailscale status --json --peers=false 2>/dev/null \
             | jq -rc '.Self.PrimaryRoutes // empty'" 2>/dev/null) || return 1
    case "$r" in *"$BR_SEGMENT"*) return 0 ;; *) return 1 ;; esac
}

# The half that is identical whichever storage the image landed on.
provision_finish() {
    info "waiting for $BR_NAME (up to 7 minutes)"
    log  "  trying, in order: its conf name, $BR_HOSTNAME.local, and a unicast mDNS"
    log  "  question to each host on this subnet asking whether it is the phone."
    wait_for_phone 420 || die "$BR_NAME never answered.
    Tried $BR_SSH and $BR_HOSTNAME.local for 7 minutes. In order of likelihood:
      - the WiFi kill switch is off, so the phone is up and on no network
      - the card is still in it, so it booted Jumpdrive rather than the system
        just installed. A card wins a boot -- that is exactly what makes it the
        rescue copy, and why step 1 above is 'power off', not 'reboot'
      - the image carries the wrong WiFi credential: it is copied from the build
        host's own connection, so an image built on a machine that has since
        moved network comes up in isolation. 'wk sysimage show <id>' names the
        SSID it was built with.
    The phone's own screen is the way in when none of that is it -- it is the
    reason a bridge image keeps a GUI. 'wk help' has the console user
    and password."
    info "$BR_NAME answers on $BR_SSH"

    # --- the role ---
    # cmd_setup, not a copy of it: it resolves privilege itself and prompts for a
    # key only when needed.
    log ""
    cmd_setup

    if [ -n "${BR_NO_TAILNET:-}" ]; then
        log ""
        info "$BR_NAME is provisioned except for the tailnet"
        log  "  status:   wk bridge status $BR_NAME"
        log  "  finish:   wk bridge tailnet $BR_NAME   (needs a tag:bridge auth key)"
        return 0
    fi

    # --- the policy ---
    # Asked for here, then *verified*: "I pasted it" and "the route is live" are
    # different claims.
    log ""
    if route_approved; then
        info "$BR_SEGMENT is approved and live -- the tailnet policy is already in place"
        log  "  which is the normal state of every run after the first: the policy is"
        log  "  per bridge, not per flash."
    else
        warn "$BR_SEGMENT is advertised but not approved, so nothing behind this bridge"
        warn "  is reachable yet. That is the expected state of a first run: the"
        warn "  autoApprovers stanza setup just printed is not in the policy yet."
        log  ""
        log  "  Paste the tagOwners, autoApprovers and grants printed above into"
        log  "  https://login.tailscale.com/admin/acls -- autoApprovers is the one"
        log  "  that makes the route live without a console click."
        local tries=0
        while ! route_approved; do
            tries=$((tries + 1))
            if [ "$tries" -gt 3 ]; then
                warn "still not approved after $((tries - 1)) checks -- leaving it there."
                log  "  Everything on the phone is done; this is the console's half."
                log  "  'wk bridge status $BR_NAME' re-checks it whenever you like."
                return 0
            fi
            pause "policy applied?"
            info "checking whether $BR_SEGMENT came live"
        done
        changed "$BR_SEGMENT is approved and live"
    fi

    log ""
    info "$BR_NAME is provisioned"
    log  "  status:   wk bridge status $BR_NAME"
    log  "  re-apply: wk bridge setup $BR_NAME   (idempotent; after any conf change)"
    log  "  reach something behind it: $(bridge_reach_hint)"
}

# What to try, to prove the segment is reachable, without pretending to know what
# is on it beyond the conf's own reservations.
bridge_reach_hint() {
    local first
    first=$(printf '%s' "${BR_LEASES:-}" | tr ' ' '\n' | sed -n '1s/^[^,]*,\([^,]*\).*/\1/p')
    if [ -n "$first" ]; then
        printf 'ping %s' "$first"
    else
        printf 'ping %s (the router this bridge answers on)' "$BR_ROUTER"
    fi
}

cmd_provision() {
    local disk="" image="" rebuild="" no_write="" dry=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --at)       BR_AT="${2:-}"; [ -n "${BR_AT:-}" ] || die "--at needs a host or address"; shift 2 ;;
            --no-tailnet) BR_NO_TAILNET=1; shift ;;
            --disk)     disk="${2:-}";  [ -n "$disk" ]  || die "--disk needs <machine>:<device>"; shift 2 ;;
            --image)    image="${2:-}"; [ -n "$image" ] || die "--image needs a path"; shift 2 ;;
            --rebuild)  rebuild=1; shift ;;
            --no-write) no_write=1; shift ;;
            --dry-run)  dry=1; shift ;;
            *) die "usage: wk bridge provision <name> [--at <host>] [--disk <machine>:<dev>]
                               [--image <path>] [--rebuild] [--no-write] [--dry-run]
    unknown option: $1" ;;
        esac
    done
    [ -z "$rebuild" ] || [ -z "$image" ] \
        || die "--rebuild and --image contradict each other: one builds a new image, the other names a local file."
    [ -z "$no_write" ] || { [ -z "$rebuild" ] && [ -z "$image" ]; } \
        || die "--no-write says the phone already holds its system, so there is no image for --image or --rebuild to be about."

    local profile="" recovery="" card="" cardmach=""
    if [ -z "$no_write" ]; then
        profile=$(bridge_profile "$BR_NAME" || true)
        [ -n "$profile" ] || die "no image profile builds $BR_NAME.
    A pmos profile in image/profiles.sh claims a bridge by setting PMO_BRIDGE to
    its name, and none of them names this one. Either add a profile for it, or
    provision the phone by hand and use --no-write."

        card="${disk:-${BR_CARD:-}}"
        [ -n "$card" ] || die "no card to write: $BR_CONF sets no BR_CARD and there is no --disk.
    BR_CARD is <machine>:<device> -- the reader that holds this bridge's cards,
    e.g. BR_CARD=rpi5:/dev/mmcblk0. 'wk sysimage disks <machine>' lists what is
    attached where; guessing which /dev is the card is the one mistake
    'wk sysimage write' exists to make impossible, so it is declared, not found."
        cardmach="${card%%:*}"
        [ "$cardmach" != "$card" ] && [ -n "${card#*:}" ] \
            || die "'$card' is not <machine>:<device> -- e.g. rpi5:/dev/mmcblk0."

        # Checked here, with the rest of the arguments, so `--dry-run` catches it.
        # There is no manifest to check its profile against: a path that is not this
        # phone's build is a card that does not boot, with a black screen.
        if [ -n "$image" ]; then
            [ -r "$image" ] || die "no image at $image
    'wk sysimage build $profile' leaves one on its build host; copy it here first."
        fi

        recovery=$(recovery_profile "$profile" || true)
        [ -n "$recovery" ] || die "there is no service image for $(profile_field "$profile" PMO_DEVICE), so this phone cannot be provisioned.
    A bridge is installed onto the phone's internal storage, and the way in is a
    service image that boots from a card and exports that storage over USB --
    Jumpdrive, for the PinePhone. It is a PinePhone project, and image/profiles.sh
    carries no equivalent for this device.
    Adding one is a fetch profile: a pinned URL, its sha256, and FET_DEVICE set
    to this phone's pmOS codename. Until then there is no way to write this
    phone's storage from here, and pretending otherwise would mean installing a
    bridge somewhere it should not live."
    fi

    info "$BR_NAME -- $DEV_NOTE, $BR_SEGMENT via $BR_IF"
    log  "  conf:     $BR_CONF"
    if [ -z "$no_write" ]; then
        log  "  profile:  $profile"
        log  "  card:     $card"
        log  "  onto:     the phone's internal storage, through $recovery on the card"
        log  "            (the card ends up as the rescue copy, which is what it is for)"
        if [ -n "$image" ]; then
            log  "  image:    $image (--image)"
        elif [ -n "$rebuild" ]; then
            log  "  image:    a new build (--rebuild)"
        else
            local have
            have=$( image_profile_load "$profile" >/dev/null 2>&1 && pmos_newest_out "$profile" 2>/dev/null || true )
            log  "  image:    ${have:-none finished on its build host yet, so it gets built}"
        fi
    else
        log  "  image:    not touched (--no-write: the phone already holds its system)"
    fi

    if [ -n "$dry" ]; then
        log ""
        log "dry run -- nothing was built, written, or changed. It would:"
        local n=0
        _step() { n=$((n + 1)); log "  $n. $*"; }
        if [ -z "$no_write" ]; then
            _step "build $recovery and $profile, unless a finished one is already there"
            _step "write $recovery to $card"
            _step "stop, and ask you to put the card in the phone, cable the phone to"
            log   "     $cardmach, and power it on"
            _step "wait for the phone's storage to appear as a disk on $cardmach, then"
            log   "     tell the card from the eMMC by hashing the head of each and"
            log   "     matching it against the Jumpdrive just written -- no prompt, and"
            log   "     nothing assumed about LUN order"
            _step "write the bridge image to the eMMC, with every refusal"
            log   "     'wk sysimage write' has"
            _step "stop, and ask you to power the phone OFF, remove the card, and boot it"
        fi
        _step "wait for the phone to answer, on its tailnet name or ${BR_HOSTNAME}.local"
        if [ -n "${BR_NO_TAILNET:-}" ]; then
            _step "run 'wk bridge setup $BR_NAME --no-tailnet': the whole role except"
            log   "     joining the tailnet, so no auth key is needed and nothing here"
            log   "     waits on a console paste"
            _step "stop, leaving 'wk bridge tailnet $BR_NAME' as the one command left"
        else
            _step "run 'wk bridge setup $BR_NAME' against it (which asks for a tagged auth"
            log   "     key if the node is not on the tailnet yet, and prints the policy)"
            _step "stop, and ask you to apply that policy -- then confirm the route came live"
        fi
        return 0
    fi

    # A terminal, checked here rather than three steps in: finding out *after*
    # erasing a disk costs something.
    if [ ! -t 0 ]; then
        # Assembled rather than interpolated: a `$(...)` inside the string eats
        # its own trailing newline, running the last two lines together.
        local why parts
        if [ -n "$no_write" ]; then
            why="Applying the tailnet policy is a person, so it cannot run unattended."
            parts=""
        else
            why="Several of its steps are a person -- the card into the phone, the phone
    recabled, the policy into the console -- so it cannot run unattended."
            parts="        wk sysimage build $profile
        wk sysimage write --from <path> --disk $card
"
        fi
        die "wk bridge provision needs a terminal.
    $why
    The pieces that can:
$parts        WK_BRIDGE_AUTHKEY=tskey-... wk bridge setup $BR_NAME"
    fi

    if [ -z "$no_write" ]; then
        [ -n "$image" ] || image=$(image_for "$profile" "$rebuild")
        local jd; jd=$(image_for "$recovery" "")

        # --no-grow: Jumpdrive's root is discarded the moment the phone reboots,
        # and growing it would break the head byte-identity
        # identify_internal_storage matches on.
        info "writing $jd to $card"
        "$WK_ROOT/wk" sysimage write --from "$jd" --disk "$card" --no-grow \
            || die "the card was not written -- nothing on the phone has changed"

        machine_load "$cardmach" \
            || die "unknown machine '$cardmach' (from $([ -n "$disk" ] && echo --disk || echo BR_CARD)=$card)"
        m_reachable || die "$cardmach is not reachable, and it is where the phone's storage will appear."

        # Taken *now*, with the phone not yet attached, so "which disks are the
        # phone's" is a difference rather than a recognition problem.
        local baseline; baseline=$(disks_now)
        debug "disks on $cardmach before the phone: $(printf '%s' "$baseline" | tr '\n' ' ')"

        log ""
        info "Jumpdrive is on the card. Now the part no script can do:"
        log  "   1. pull the card out of $cardmach -- it is synced, so it is safe to pull"
        log  "   2. card into the $BR_DEVICE"
        log  "   3. cable the phone to $cardmach with a DATA cable. This is the one"
        log  "      step where the phone is powered from that machine: Jumpdrive needs"
        log  "      the data link, and this is a service boot, not the bridge running."
        log  "   4. power the phone on. Jumpdrive draws a splash and exports storage;"
        log  "      it has no shell and nothing to log into."
        pause "card in the phone, phone cabled to $cardmach, powering up?"

        info "waiting for the phone's storage to appear on $cardmach (up to 3 minutes)"
        local new
        new=$(wait_for_disks "$baseline" 180) || die "no new disk appeared on $cardmach within 3 minutes.
    Jumpdrive exports the phone's storage as USB mass storage within seconds of
    its splash screen, so this means it is not running. What is attached says
    which:
    $(phone_usb_note)
    Nothing was written. 'wk sysimage disks $cardmach' is what this was watching;
    re-running this command picks up from the same place -- the card still holds
    Jumpdrive."
        log ""

        local target
        target=$(identify_internal_storage "$new" "$jd")

        info "writing $image to $cardmach:$target"
        log  "  every refusal 'wk sysimage write' has applies here: it checks the disk"
        log  "  is removable, is not $cardmach's own root, and is big enough."
        "$WK_ROOT/wk" sysimage write --from "$image" --disk "$cardmach:$target" \
            || die "the phone's internal storage was not written.
    Nothing is lost: the card still holds Jumpdrive, so re-running this picks up
    from the same place. 'wk bridge provision $BR_NAME' is idempotent."

        log ""
        info "the bridge is installed on the phone's internal storage. Last hands-on part:"
        log  "   1. power the phone OFF -- not reboot. A card wins a boot, so a reboot"
        log  "      with the card still in it comes back into Jumpdrive."
        log  "   2. take the card out. Keep it: it is the rescue copy now, and putting"
        log  "      it back boots Jumpdrive again with the install untouched."
        log  "   3. unplug the phone from $cardmach."
        log  "   4. power the phone from a WALL CHARGER, never from the machine it"
        log  "      exists to rescue. Fed from that machine the out-of-band path dies"
        log  "      exactly when it is needed; on mains the battery is a UPS instead."
        log  "   5. kill switches: WiFi ON. $DEV_KILLSWITCH"
        log  "   6. plug in the USB-C Ethernet dock -- and power the dock BEFORE"
        log  "      connecting it to the phone. Both phones have one port and default"
        log  "      to USB device mode; a dock that is already powered is the thing"
        log  "      that makes the data-role swap happen, and without the swap $BR_IF"
        log  "      never appears at all."
        log  "   7. power the phone on. It boots the system just installed."
        pause "card out, phone on mains and on its own dock, powering up?"
    fi

    log ""
    provision_finish
}


# --- setup -------------------------------------------------------------------
cmd_setup() {
    local dry=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) dry=1 ;;
            --at) BR_AT="${2:-}"; [ -n "$BR_AT" ] || die "--at needs a host or address"; shift ;;
            --no-tailnet) BR_NO_TAILNET=1 ;;
            *) die "usage: wk bridge setup <name> [--at <host>] [--no-tailnet] [--dry-run]
    unknown option: $1" ;;
        esac
        shift
    done

    info "$BR_NAME -- $DEV_NOTE, $BR_SEGMENT via $BR_IF"
    log  "  conf:     $BR_CONF"
    log  "  ssh:      $BR_SSH"
    log  "  tailnet:  $BR_HOSTNAME, $BR_TAG, advertising $BR_SEGMENT"
    log  "  egress:   $BR_EGRESS$([ "$BR_EGRESS" = nat ] && printf ' (the segment can reach the internet)' || printf ' (the segment reaches nothing but the tailnet)')"
    log  "  camera:   $BR_CAMERA"
    log  "  battery:  cap ${BR_BATTERY_LIMIT}%${BR_BATTERY:+, node $BR_BATTERY}"

    if [ -n "$dry" ]; then
        log ""
        log "dry run -- nothing was copied and nothing was run. It would:"
        log "  1. copy $WK_ROOT/bridge to $BR_SSH:/usr/local/lib/wk-bridge"
        log "  2. run bridge/provision.sh there as root, with the conf above in its environment"
        log "  3. join the tailnet if the node is not on it (asking for a tagged auth key)"
        log "  4. run wk-bridge-healthcheck and print the result"
        return 0
    fi

    resolve_priv

    # pmOS or nothing, checked before the copy. Half-applying Alpine service files
    # onto the Librem 5's PureOS/systemd configuration would leave a bridge that is
    # neither one thing nor the other.
    rsh 'command -v apk >/dev/null 2>&1' \
        || die "$BR_SSH is not running postmarketOS (no apk).
    The bridge role is pmOS-only on purpose: one provisioner for both phones,
    which is what the rewrite bought. Reflash the phone first -- 'wk help
    bridge' has the device names and the flashing path."

    # Two things no script can do, said every time; both have caused an outage.
    warn "power the phone from a wall charger, never from the machine it exists to rescue."
    warn "  A bridge fed by the machine it is the out-of-band path *to* dies exactly"
    warn "  when it is needed. The battery is then a UPS instead of the whole supply."
    warn "kill switches: WiFi on. $DEV_KILLSWITCH"

    info "copying bridge/ to $BR_SSH:/usr/local/lib/wk-bridge"
    # Clean-then-extract, not extract-over: a script removed from the repository
    # must not go on living on the phone.
    tar czf - -C "$WK_ROOT/bridge" . \
        | rsh "$PRIV sh -c 'rm -rf /usr/local/lib/wk-bridge \
                            && mkdir -p /usr/local/lib/wk-bridge \
                            && tar xzf - -C /usr/local/lib/wk-bridge'" \
        || die "could not copy bridge/ to $BR_SSH"

    # Only ask for a key when the node needs one: a re-run against a bridge
    # already on the tailnet is the common case.
    local authkey="" keyfile="" ts_state
    ts_state=$(rsh "$PRIV tailscale status --json --peers=false 2>/dev/null \
                    | jq -r '.BackendState'" 2>/dev/null) || ts_state=""
    if [ -n "${BR_NO_TAILNET:-}" ]; then
        log ""
        info "--no-tailnet: applying the role but not joining the tailnet"
        log  "  no auth key is needed for this run. 'wk bridge tailnet $BR_NAME' is"
        log  "  the one step left afterwards, and it is the only one that needs a"
        log  "  credential fetched by hand."
    elif [ "$ts_state" != Running ]; then
        log ""
        info "this node is not on the tailnet yet, so it needs an auth key"
        log  "  it MUST be tagged $BR_TAG: a tagged node never key-expires, and an"
        log  "  untagged bridge works for 180 days and then goes dark -- which is"
        log  "  the exact outage this device exists to prevent."
        log  "  generate one at https://login.tailscale.com/admin/settings/keys"
        # The environment, when there is one: this command is otherwise
        # unscriptable. Single-use either way -- provision.sh deletes the key file.
        if [ -n "${WK_BRIDGE_AUTHKEY:-}" ]; then
            authkey="$WK_BRIDGE_AUTHKEY"
            log  "  using the key in \$WK_BRIDGE_AUTHKEY"
        elif keyfile=$(wk_tailscale_authkey); then
            # The fleet's one key, from the one place it lives.
            authkey=$(head -1 "$keyfile")
        else
            log  "  no key available, so this run applies the role without joining"
            log  "  the tailnet; 'wk bridge tailnet $BR_NAME' finishes it later"
        fi
    fi

    # The key never appears on a command line, on either side: argv is world
    # readable in /proc. It goes over the same ssh, into a 0600 file on tmpfs,
    # and provision.sh deletes it once used.
    if [ -n "$authkey" ]; then
        printf '%s\n' "$authkey" \
            | rsh "$PRIV sh -c 'umask 077; cat > /run/wk-bridge-authkey'" \
            || die "could not hand the auth key to $BR_SSH"
    fi

    info "provisioning $BR_SSH"
    rsh "$PRIV env \
        BR_NAME=$(sh_quote "$BR_NAME") \
        BR_DEVICE=$(sh_quote "$BR_DEVICE") \
        BR_HOSTNAME=$(sh_quote "$BR_HOSTNAME") \
        BR_TAG=$(sh_quote "$BR_TAG") \
        BR_SEGMENT=$(sh_quote "$BR_SEGMENT") \
        BR_ROUTER=$(sh_quote "$BR_ROUTER") \
        BR_IF=$(sh_quote "$BR_IF") \
        BR_POOL=$(sh_quote "$BR_POOL") \
        BR_LEASES=$(sh_quote "$BR_LEASES") \
        BR_EGRESS=$(sh_quote "$BR_EGRESS") \
        BR_CAMERA=$(sh_quote "$BR_CAMERA") \
        BR_LAN_MAC=$(sh_quote "$BR_LAN_MAC") \
        BR_BATTERY=$(sh_quote "$BR_BATTERY") \
        BR_BATTERY_LIMIT=$(sh_quote "$BR_BATTERY_LIMIT") \
        BR_NO_TAILNET=$(sh_quote "${BR_NO_TAILNET:-}") \
        sh /usr/local/lib/wk-bridge/provision.sh" \
        || die "provisioning failed on $BR_SSH -- nothing here changed"

    if [ -n "${BR_NO_TAILNET:-}" ]; then
        log ""
        info "health check (the tailnet parts will fail, by design)"
        rsh "$PRIV /usr/local/sbin/wk-bridge-healthcheck" || true
        log ""
        info "$BR_NAME has the whole role except the tailnet"
        log  "  finish it with:  wk bridge tailnet $BR_NAME"
        return 0
    fi

    # The one thing this cannot apply, and must print: applying the tailnet policy
    # needs an API key with policy-write scope, and a repository holding one is a
    # repository whose compromise rewrites every ACL.
    cat >&2 <<EOF

Remaining manual step -- the tailnet policy, in the admin console.

  "tagOwners": { "$BR_TAG": ["autogroup:admin"] },

  "autoApprovers": {
    "routes": { "$BR_SEGMENT": ["$BR_TAG"] }
  },

  "grants": [
    { "src": [$(printf '%s' "$BR_REACHED_BY" \
                  | awk -F' *, *' '{ for (i = 1; i <= NF; i++) printf "%s\"%s\"", (i > 1 ? ", " : ""), $i }')],
      "dst": ["$BR_SEGMENT"], "ip": ["*"] }
  ]

autoApprovers is what makes the route live without a console click; without it
the node is up, the segment is advertised, and nothing behind it is reachable.

The grant is the real access control for everything behind this bridge -- the
devices on the segment have none of their own worth relying on (a BMC reverts
to factory credentials on a power loss). Grant $BR_TAG itself nothing: it
routes, it never initiates, and root on it is equivalent to whatever is behind
it.
EOF

    log ""
    info "health check"
    rsh "$PRIV /usr/local/sbin/wk-bridge-healthcheck" || \
        warn "the health check reported problems -- see above; 'wk bridge status $BR_NAME' re-runs it"
}

# --- tailnet -----------------------------------------------------------------
#
# The last step, on its own: it is the only one needing a credential a person has
# to go fetch, and `tailscale up --advertise-tags` is settable only at login.
cmd_tailnet() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --at) BR_AT="${2:-}"; [ -n "$BR_AT" ] || die "--at needs a host or address"; shift 2 ;;
            *) die "usage: wk bridge tailnet <name> [--at <host>]
    unknown option: $1" ;;
        esac
    done
    resolve_priv
    rsh "$PRIV test -f /etc/wk-bridge.conf" 2>/dev/null \
        || die "$BR_SSH has no bridge role on it yet.
    'wk bridge setup $BR_NAME --no-tailnet' applies everything else first; this
    command is only the tailnet half."
    BR_NO_TAILNET=""
    cmd_setup "$@"
}

# --- status ------------------------------------------------------------------
cmd_status() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --at) BR_AT="${2:-}"; [ -n "$BR_AT" ] || die "--at needs a host or address"; shift 2 ;;
            *) die "usage: wk bridge status <name> [--at <host>]
    unknown option: $1" ;;
        esac
    done
    resolve_priv
    rsh "$PRIV test -x /usr/local/sbin/wk-bridge-healthcheck" 2>/dev/null \
        || die "$BR_SSH answers but has no bridge role on it.
    'wk bridge setup $BR_NAME' provisions it."
    rsh "$PRIV /usr/local/sbin/wk-bridge-healthcheck"
}

# --- battery -------------------------------------------------------------------
# Read-only (rule 6, CLAUDE.md): nothing written, just what
# /etc/wk-bridge-battery.conf and sysfs say right now. key=value, one per line,
# so `wk doctor --all` never has to parse prose.
cmd_battery() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --at) BR_AT="${2:-}"; [ -n "$BR_AT" ] || die "--at needs a host or address"; shift 2 ;;
            *) die "usage: wk bridge battery <name> [--at <host>]
    unknown option: $1" ;;
        esac
    done
    resolve_ssh || die "cannot reach $BR_NAME.
    'wk bridge status $BR_NAME' has the full diagnosis."
    rsh 'sh -s' <<'EOF'
set -u
conf=/etc/wk-bridge-battery.conf
node=""; limit=""
if [ -f "$conf" ]; then
    node=$(sed -n 's/^node=//p' "$conf")
    limit=$(sed -n 's/^limit=//p' "$conf")
fi
pct=""; state=""
for d in /sys/class/power_supply/*/capacity; do
    [ -f "$d" ] || continue
    pct=$(cat "$d" 2>/dev/null)
    state=$(cat "$(dirname "$d")/status" 2>/dev/null)
    break
done
cur=""
[ -n "$node" ] && [ -f "$node/charge_control_end_threshold" ] \
    && cur=$(cat "$node/charge_control_end_threshold" 2>/dev/null)
printf 'percent=%s\n' "${pct:-?}"
printf 'status=%s\n'  "${state:-?}"
printf 'limit=%s\n'   "${limit:-?}"
printf 'current=%s\n' "${cur:-?}"
EOF
}

# --- rm ----------------------------------------------------------------------
# Undoes the role, not the phone: everything this removes was written by
# provision.sh, so what is left is a pmOS phone that answers ssh.
cmd_rm() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --at) BR_AT="${2:-}"; [ -n "$BR_AT" ] || die "--at needs a host or address"; shift 2 ;;
            *) die "usage: wk bridge rm <name> [--at <host>]
    unknown option: $1" ;;
        esac
    done
    resolve_priv
    log "this removes the bridge role from $BR_SSH:"
    log "  services       wk-bridge-{dhcp,nftables,netwatch,watchdog,usb-host,camera,battery}"
    log "  configuration  /etc/wk-bridge.conf, /etc/wk-bridge-battery.conf,"
    log "                 /etc/dnsmasq.d/wk-bridge.conf, /etc/nftables.d/wk-bridge.nft,"
    log "                 the udev rule, the NM connection, the chrony and sshd drop-ins"
    log "  tailnet        the node logs out, so it stops advertising $BR_SEGMENT"
    log "it leaves postmarketOS, the packages, and your ssh keys alone."
    confirm "remove the bridge role from $BR_SSH?" || die "aborted -- nothing was changed"

    # Order matters: the tailnet logout is last of the network-affecting steps
    # that still need the network, and sshd's drop-in is removed *before* the
    # daemon is reloaded, so a run that dies partway leaves ssh working.
    rsh "$PRIV sh -s" <<'EOF' || die "deprovisioning did not complete -- re-run it, or see what is left with 'wk bridge status'"
set -u
for s in wk-bridge-camera wk-bridge-netwatch wk-bridge-watchdog wk-bridge-dhcp wk-bridge-nftables wk-bridge-usb-host wk-bridge-battery; do
    [ -x "/etc/init.d/$s" ] || continue
    rc-service "$s" stop >/dev/null 2>&1 || true
    rc-update del "$s" default >/dev/null 2>&1 || true
    rm -f "/etc/init.d/$s"
    printf 'removed %s\n' "$s"
done
nft delete table inet wkbridge 2>/dev/null || true
rm -f /etc/wk-bridge.conf \
      /etc/wk-bridge-battery.conf \
      /etc/dnsmasq.d/wk-bridge.conf \
      /etc/nftables.d/wk-bridge.nft \
      /etc/udev/rules.d/70-wk-bridge-net.rules \
      /etc/sysctl.d/99-wk-bridge.conf \
      /etc/NetworkManager/conf.d/99-wk-bridge.conf \
      /etc/NetworkManager/conf.d/98-wk-bridge-dns.conf \
      /etc/NetworkManager/dispatcher.d/50-wk-bridge-gro \
      /etc/NetworkManager/system-connections/wk-bridge-*.nmconnection \
      /etc/chrony/conf.d/wk-bridge.conf \
      /etc/elogind/logind.conf.d/10-wk-bridge.conf \
      /etc/logrotate.d/wk-bridge \
      /usr/local/sbin/wk-bridge-*
rm -rf /usr/local/lib/wk-bridge
nmcli connection reload >/dev/null 2>&1 || true

# The sshd drop-in goes last and the daemon is only reloaded if it still
# parses: locking yourself out of the phone is the one mistake here with no
# remote fix. The `Include` line provisioning added to sshd_config stays (and
# so does chrony.conf's `include`) -- both tolerate an include of a glob that
# matches nothing, and editing a file we do not own to remove one line is how
# a deprovisioning ends up breaking sshd.
rm -f /etc/ssh/sshd_config.d/10-wk-bridge.conf
if sshd -t 2>/dev/null; then
    rc-service sshd reload >/dev/null 2>&1 || true
else
    printf 'WARNING: sshd -t fails; NOT reloading sshd. Fix /etc/ssh/sshd_config by hand.\n' >&2
fi

tailscale logout >/dev/null 2>&1 || printf 'note: tailscale logout failed (already logged out?)\n'
printf 'the bridge role is gone; postmarketOS and the packages are untouched\n'
EOF

    changed "removed the bridge role from $BR_SSH"
    log "  the tailnet node is logged out but still listed in the admin console --"
    log "  delete it there if the phone is not coming back, or the name is taken"
    log "  when it next joins."
}

# --- dispatch ----------------------------------------------------------------
ACTION="${1:-}"; shift || true
case "$ACTION" in
    ls)
        case "${1:-}" in
            ""|--names) ;;
            *) die "usage: wk bridge ls [--names]
    unexpected argument: $1" ;;
        esac
        cmd_ls "$@"
        ;;
    setup|status|battery|rm|provision|tailnet)
        NAME="${1:-}"
        case "$NAME" in
            -*) die "usage: wk bridge $ACTION <name> [flags]; see wk bridge -h
    unexpected argument: $NAME" ;;
        esac
        [ -n "$NAME" ] || die "usage: wk bridge $ACTION <name>
    Declared bridges:$(bridge_names | sed 's/^/ /' | tr -d '\n')"
        shift || true
        load_bridge "$NAME"
        cmd_"$ACTION" "$@"
        ;;
    *)
        die "usage: wk bridge <sub> [<name>] [flags]; see wk bridge -h"
        ;;
esac
