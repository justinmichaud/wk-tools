#!/usr/bin/env bash
#
# wk completion bash|zsh -- print a shell completion script for wk
#
# wk: where=local name=none group=hosts
#
# `wk completion bash` (or `wk completion zsh`) prints a script meant to be
# eval'd by your shell's rc; `shell/bashrc` does this automatically for both
# shells, guarded on `wk` actually being on PATH. It completes:
#
#   - command names, read from `wk --declarations` -- the same source `wk`'s
#     own usage reads
#   - workspace names, for a command whose declaration takes one, from local
#     state only (list_workspaces_local below) -- never from `wk ls`, which
#     can reach every configured host and, on a macOS workstation, start the
#     podman machine just to answer a TAB press
#   - each command's own --flags, parsed out of its own `-h` text
#
# One completion function, in bash syntax, serves both shells: bash
# registers it directly with `complete -F`; zsh starts its completion system
# and loads `bashcompinit`, then registers the same function the same way
# (CLAUDE.md, "One path, not two").
#
# Two hidden verbs the generated script calls back into at completion time,
# never at shell-startup time (so a slow answer costs a TAB press, not every
# new shell):
#
#   wk completion --list-workspaces   workspace names, from local state
#   wk completion --flags <cmd>       that command's own --flags

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/store.sh"

usage() {
    die "usage: wk completion bash|zsh -- print a shell completion script for wk.; see wk completion -h"
}

# Every workspace name this machine already knows about, without starting
# anything or reaching anywhere: no registry, just the store each built-in
# local kind keeps for itself (lib/store.sh's `ws/` directory), read
# directly -- a bare `ls` per kind, nothing cached between one TAB press and
# the next.
#
# Deliberately does not ask a remote target or a macOS host's podman VM for
# its workspaces: both need a live connection this function must never open
# to answer a TAB press, and the VM case would start the podman machine
# outright. Their names are simply not offered.
list_workspaces_local() {
    local seen=" " t name
    for t in container vm; do
        for name in $(
            ( load_target "$t" >/dev/null 2>&1
              store_is_local || exit 0
              list_workspaces 2>/dev/null ) 2>/dev/null
        ); do
            case "$seen" in *" $name "*) continue ;; esac
            seen="$seen$name "
            printf '%s\n' "$name"
        done
    done
}

# Every `--flag` word in <cmd>'s own `-h` text: a human reading `wk build -h`
# sees exactly the flags this offers, one place rather than two option-parsers.
list_flags() {
    local cmd="$1"
    "$WK_ROOT/wk" "$cmd" -h 2>/dev/null \
        | grep -oE -- '--[a-zA-Z][a-zA-Z0-9-]*' \
        | sort -u
}

case "${1:-}" in
    --list-workspaces) list_workspaces_local; exit 0 ;;
    --flags)
        [ $# -ge 2 ] || usage
        list_flags "$2"
        exit 0 ;;
esac

case "${1:-}" in
    bash|zsh) ;;
    *) usage ;;
esac
SHELL_NAME="$1"

# `wk` here is `${COMP_WORDS[0]}` -- whatever the user actually typed -- not
# a fixed path, so a wrapper or an alias completes the same way it runs.
_completion_function() {
    cat <<'FUNC'
_wk_completion() {
    local cur bin cmd_line dname flags ws
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    bin="${COMP_WORDS[0]}"

    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$("$bin" --declarations 2>/dev/null | cut -f1)" -- "$cur") )
        return 0
    fi

    cmd_line=$("$bin" --declarations 2>/dev/null | awk -F'\t' -v c="${COMP_WORDS[1]}" '$1 == c { print; exit }')
    [ -n "$cmd_line" ] || return 0
    dname=$(printf '%s' "$cmd_line" | cut -f3)

    case "$cur" in
        -*)
            flags=$("$bin" completion --flags "${COMP_WORDS[1]}" 2>/dev/null)
            COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
            return 0 ;;
    esac

    case "$dname" in
        required|optional)
            # Only while no positional has been typed yet.
            local i seen=0
            i=2
            while [ "$i" -lt "$COMP_CWORD" ]; do
                case "${COMP_WORDS[$i]}" in -*) ;; *) seen=1 ;; esac
                i=$((i + 1))
            done
            if [ "$seen" -eq 0 ]; then
                ws=$("$bin" completion --list-workspaces 2>/dev/null)
                COMPREPLY=( $(compgen -W "$ws" -- "$cur") )
            fi
            ;;
    esac
    return 0
}
complete -F _wk_completion wk
FUNC
}

printf '# wk %s completion -- generated by `wk completion %s`; eval this in your rc.\n' \
    "$SHELL_NAME" "$SHELL_NAME"

if [ "$SHELL_NAME" = zsh ]; then
    # `complete` under zsh is a bashcompinit function that calls compdef, and
    # compdef only exists once compinit has run. A stock ~/.zshrc does not run
    # it -- so this does, unconditionally, rather than leaving every shell on
    # such a machine to print "complete: command not found: compdef" and
    # complete nothing. -C: read the dumpfile as it stands, so a shell's
    # startup neither rebuilds it nor stops to ask about an fpath directory
    # someone else's machine made group-writable.
    cat <<'ZSHPRELUDE'
autoload -U +X compinit && compinit -C
autoload -U +X bashcompinit && bashcompinit
ZSHPRELUDE
fi

_completion_function
