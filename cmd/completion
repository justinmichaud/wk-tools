#!/usr/bin/env bash
#
# wk completion bash|zsh -- print a shell completion script for wk
#
# wk: where=local name=none group=hosts
#
# Prints a script meant to be eval'd by your shell's rc; `shell/bashrc` does
# this for both shells, guarded on `wk` being on PATH. It completes:
#
#   - command names, read from `wk --declarations`
#   - workspace names, for a command whose declaration takes one, from local
#     state only -- never from `wk ls`, which can reach every configured host
#     and, on a macOS workstation, start the podman machine to answer a TAB press
#   - each command's own --flags, parsed out of its own `-h` text
#
# One completion function, in bash syntax, serves both shells; zsh registers it
# through `bashcompinit`.
#
# Two hidden verbs the generated script calls back into at completion time,
# never at shell-startup time:
#
#   wk completion --list-workspaces   workspace names, from local state
#   wk completion --flags <cmd>       that command's own --flags

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/store.sh"

usage() {
    die "usage: wk completion bash|zsh -- print a shell completion script for wk.; see wk completion -h"
}

list_workspaces_local() {
    local seen=" " t name
    for t in container vm; do
        for name in $(
            ( load_target "$t" >/dev/null 2>&1
              store_is_local || exit 0
              list_workspaces 2>/dev/null ) 2>/dev/null
        ); do
            case "$seen" in *" $name "*) continue ;; esac
            seen="$seen$name "
            printf '%s\n' "$name"
        done
    done
}

list_flags() {
    local cmd="$1"
    "$WK_ROOT/wk" "$cmd" -h 2>/dev/null \
        | grep -oE -- '--[a-zA-Z][a-zA-Z0-9-]*' \
        | sort -u
}

case "${1:-}" in
    --list-workspaces) [ $# -eq 1 ] || usage; list_workspaces_local; exit 0 ;;
    --flags)
        [ $# -eq 2 ] || usage
        list_flags "$2"
        exit 0 ;;
esac

case "${1:-}" in
    bash|zsh) ;;
    *) usage ;;
esac
[ $# -eq 1 ] || usage
SHELL_NAME="$1"

_completion_function() {
    cat <<'FUNC'
_wk_completion() {
    local cur bin cmd_line dname flags ws
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    bin="${COMP_WORDS[0]}"

    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$("$bin" --declarations 2>/dev/null | cut -f1)" -- "$cur") )
        return 0
    fi

    cmd_line=$("$bin" --declarations 2>/dev/null | awk -F'\t' -v c="${COMP_WORDS[1]}" '$1 == c { print; exit }')
    [ -n "$cmd_line" ] || return 0
    dname=$(printf '%s' "$cmd_line" | cut -f3)

    case "$cur" in
        -*)
            flags=$("$bin" completion --flags "${COMP_WORDS[1]}" 2>/dev/null)
            COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
            return 0 ;;
    esac

    case "$dname" in
        required*|optional*)
            # Which positional the name is: the first, or the @N of the
            # declaration (`wk ai claude <ws>` is name=required@2).
            local i typed=0 slot=1
            case "$dname" in *@*) slot=${dname#*@} ;; esac
            i=2
            while [ "$i" -lt "$COMP_CWORD" ]; do
                case "${COMP_WORDS[$i]}" in -*) ;; *) typed=$((typed + 1)) ;; esac
                i=$((i + 1))
            done
            if [ "$typed" -eq $((slot - 1)) ]; then
                ws=$("$bin" completion --list-workspaces 2>/dev/null)
                COMPREPLY=( $(compgen -W "$ws" -- "$cur") )
            fi
            ;;
    esac
    return 0
}
complete -F _wk_completion wk
FUNC
}

printf '# wk %s completion -- generated by `wk completion %s`; eval this in your rc.\n' \
    "$SHELL_NAME" "$SHELL_NAME"

if [ "$SHELL_NAME" = zsh ]; then
    # bashcompinit's `complete` calls compdef, which needs compinit (a stock
    # ~/.zshrc omits it); -C reads the dumpfile as it stands rather than rebuilding.
    cat <<'ZSHPRELUDE'
autoload -U +X compinit && compinit -C
autoload -U +X bashcompinit && bashcompinit
ZSHPRELUDE
fi

_completion_function
