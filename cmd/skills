#!/usr/bin/env bash
#
# wk skills status|diff|pull|push -- manage the shared, mutable skills directory
# wk: where=host name=none group=sources needs rsync
#
# Every workspace mounts the same writable /skills, so an edit benefits every
# workspace but risks silent drift: it may never reach the repo for review.
#
#   wk skills status   what differs between the shared copy and the repo
#   wk skills diff     the actual diff
#   wk skills pull     shared -> repo, so `git diff` shows it and you can commit
#   wk skills push     repo -> shared, discarding workspace edits
#
# pull is the common direction; push is destructive and asks first.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"

SHARED="$WK_STORE/skills"
REPO="$WK_ROOT/claude/skills"

# The shared copy lives in the VM on macOS; this must run from there.
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    die "run this inside the VM: wk skills $* (the shared copy lives there)"
fi

[ -d "$SHARED" ] || { ensure_dir "$SHARED"; cp -a "$REPO/." "$SHARED/" 2>/dev/null || true; }

ACTION="${1:-status}"
[ $# -le 1 ] || die "usage: wk skills status|diff|pull|push; see wk skills -h"

case "$ACTION" in
status)
    if diff -rq "$REPO" "$SHARED" >/dev/null 2>&1; then
        info "skills are in sync with the repo"
    else
        warn "the shared skills differ from the repo:"
        diff -rq "$REPO" "$SHARED" 2>&1 | sed 's/^/  /' || true
        log ""
        log "  wk skills diff   see the changes"
        log "  wk skills pull   bring them into the repo to review and commit"
    fi
    ;;

diff)
    diff -ru "$REPO" "$SHARED" || true
    ;;

pull)
    if diff -rq "$REPO" "$SHARED" >/dev/null 2>&1; then
        info "nothing to pull; already in sync"
        exit 0
    fi
    # A committed repo copy makes pull reversible through git; uncommitted
    # repo-side edits would be silently overwritten, so those ask first.
    if git -C "$WK_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
        if [ -n "$(git -C "$WK_ROOT" status --porcelain -- claude/skills 2>/dev/null)" ]; then
            warn "the repo has uncommitted skill changes that pull would overwrite:"
            git -C "$WK_ROOT" status --short -- claude/skills | sed 's/^/  /' >&2
            confirm "overwrite them with the shared copy?" || die "aborted; commit or stash first"
        fi
    else
        # No git here (the rsynced copy in the VM): nothing makes this pull
        # reversible, so it always asks.
        confirm "no git repo at $WK_ROOT -- pull cannot be undone; continue?" || die "aborted"
    fi
    # --delete so a skill deleted in a workspace is deleted in the repo too;
    # otherwise the repo slowly fills with skills nothing uses any more.
    rsync -a --delete "$SHARED/" "$REPO/"
    changed "pulled shared skills into $REPO"
    log "review with: git -C $WK_ROOT diff claude/skills"
    ;;

push)
    if diff -rq "$REPO" "$SHARED" >/dev/null 2>&1; then
        info "nothing to push; already in sync"
        exit 0
    fi
    warn "this discards any skill edits made in workspaces:"
    diff -rq "$REPO" "$SHARED" 2>&1 | sed 's/^/  /' || true
    confirm "overwrite the shared skills with the repo copy?" || die "aborted"
    rsync -a --delete "$REPO/" "$SHARED/"
    changed "pushed repo skills to $SHARED"
    ;;

*)
    die "usage: wk skills status|diff|pull|push; see wk skills -h"
    ;;
esac
