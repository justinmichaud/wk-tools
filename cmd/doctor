#!/usr/bin/env bash
#
# wk doctor [--all] -- what is provisioned on this machine, and what is still missing
# wk: where=local name=none readonly group=hosts
#
# The reinstall companion: `./setup` is the automated path, but several pieces
# are deliberately manual (interactive sudo, credentials, hardware). This prints
# the full checklist with the exact next command for everything missing.
#
# Read-only by design: it never starts the podman machine, never boots a guest,
# and never prompts. State it cannot see without starting something is reported
# as '??' with the command that would reveal it.
#
#   --all   also ask every configured build machine (targets/hosts/*.conf) what
#           it has: the tools a build needs there, the identity a commit made
#           there would carry, any build variable that machine's own profile
#           sets, and whether what provisioned it is still what this tree says.
#           A machine that does not answer is reported as unreachable, never as
#           broken. Also reads every bridge phone's battery charge cap and, on a
#           Mac with a battery, the `pmset -g batt` line -- macOS has no
#           settable limit to check.
#
#   0  everything checkable is provisioned
#   1  something is missing (the lines say what and how)

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"

WK_MACHINE="${WK_MACHINE:-wk}"

# The store lives where the containers do -- inside the podman VM on macOS -- so the macOS host asks the VM to run this probe.
probe_store() {
    [ -d "$WK_STORE/git/WebKit.git" ] && echo mirror=ok || echo mirror=no
    [ -n "$(ls -1 "$WK_STORE/base" 2>/dev/null)" ] && echo base=ok || echo base=no
    [ -n "$(ls -1 "$WK_STORE/skills" 2>/dev/null)" ] && echo skills=ok || echo skills=no
    # The socket is proof too: systemctl --user over a bare ssh session can fail to find the user bus even when the service is fine.
    if systemctl --user is-active --quiet wk-proxy.service 2>/dev/null \
       || [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wk/proxy.sock" ]; then
        echo proxy=ok
    else
        echo proxy=no
    fi
    [ -s "$WK_STORE/pi-hosts" ] && echo pihosts=ok || echo pihosts=no
    # The socket, not the service: on macOS the broker runs on the Mac and publishes its socket in here, so a broken forward looks healthy out there.
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wk/broker.sock" ] \
        && echo broker=ok || echo broker=no
    # Emitted only when git is present, so an absent git.name= line (not an empty one) tells "not installed" from "installed but unset".
    if command -v git >/dev/null 2>&1; then
        printf 'git.name=%s\n' "$(git config --get user.name 2>/dev/null || true)"
        printf 'git.email=%s\n' "$(git config --get user.email 2>/dev/null || true)"
        printf 'git.fsmonitor=%s\n' "$(git config --get core.fsmonitor 2>/dev/null || true)"
        printf 'git.manyfiles=%s\n' "$(git config --get feature.manyFiles 2>/dev/null || true)"
    fi
}
if [ "${1:-}" = --probe-store ]; then
    probe_store
    exit 0
fi
ALL=""
case "${1:-}" in
    --all) ALL=1; shift ;;
esac
[ $# -eq 0 ] || die "usage: wk doctor [--all]; see wk doctor -h"

missing=0
ok()   { printf '  \033[32mok\033[0m    %s\n' "$*" >&2; }
miss() { printf '  \033[31m--\033[0m    %-46s -> %s\n' "$1" "$2" >&2; missing=$((missing + 1)); }
unk()  { printf '  \033[33m??\033[0m    %-46s -> %s\n' "$1" "$2" >&2; }
section() { printf '\n%s\n' "$*" >&2; }

check() { # check <description> <fix> <command...>
    local what="$1" fix="$2"; shift 2
    if "$@" >/dev/null 2>&1; then ok "$what"; else miss "$what" "$fix"; fi
}

link_ok() { [ -L "$1" ] && [ "$(readlink "$1")" = "$2" ]; }

# Its own function so tests/test_battery.py can lift it without a phone: "ok\t<line>" or "miss\t<line>\t<remedy>".
battery_verdict() { # <name> <key=value blob>
    local name="$1" blob="$2" pct st limit cur
    pct=$(kv_get percent <<<"$blob")
    st=$(kv_get status <<<"$blob")
    limit=$(kv_get limit <<<"$blob")
    cur=$(kv_get current <<<"$blob")
    if [ -n "$cur" ] && [ "$cur" != '?' ] && [ "$cur" = "$limit" ]; then
        printf 'ok\t%s: %s%% %s, capped at %s%%\n' "$name" "${pct:-?}" "${st:-?}" "$cur"
    else
        printf 'miss\t%s: %s%% %s, cap reads %s (want %s)\t%s\n' \
            "$name" "${pct:-?}" "${st:-?}" "${cur:-?}" "${limit:-?}" "wk bridge setup $name"
    fi
}

# macOS has no CLI knob for optimized charging, so the report is the raw percent and plug state; a desktop Mac's `pmset -g batt` is one line, and fails here.
mac_battery_line() { # <pmset -g batt output>
    local out="$1" head batt pct plug
    head=$(printf '%s\n' "$out" | sed -n '1p')
    batt=$(printf '%s\n' "$out" | sed -n '2p')
    [ -n "$batt" ] || return 1
    pct=$(printf '%s' "$batt" | sed -n 's/.*[[:space:]]\([0-9]\{1,3\}\)%;.*/\1/p')
    [ -n "$pct" ] || return 1
    case "$head" in
        *"'AC Power'"*) plug="plugged in" ;;
        *)              plug="on battery" ;;
    esac
    printf '%s, %s%% -- no OS limit exists' "$plug" "$pct"
}

info "wk doctor on $(wk_os) ($(hostname))"

section "host tools"
if is_macos; then
    check "Xcode command line tools" "xcode-select --install"     xcode-select -p
    check "podman"                   "install the official pkg from podman.io" have podman
    check "zed"        "https://zed.dev/download" sh -c 'command -v zed || [ -d /Applications/Zed.app ]'
    check "tailscale"  "https://tailscale.com/download/macos" \
        sh -c 'command -v tailscale || [ -d /Applications/Tailscale.app ]'
else
    check "podman"     "./setup --stage tools" have podman
    check "zsh"        "./setup --stage tools" have zsh
    check "cage (benchmark kiosk)"  "./setup --stage tools" have cage
    check "wlr-randr (session off)" "./setup --stage tools" have wlr-randr
fi
if have nmap; then
    ok "nmap (wk find)"
elif is_macos; then
    unk "nmap absent -- only 'wk find' needs it" "nmap.org, the .dmg"
else
    unk "nmap absent -- only 'wk find' needs it" "./setup  (host/linux/apt.txt)"
fi
check "jq (claude hook)" "./setup --stage tools" have jq
check "gh"               "install gh, then: gh auth login" have gh
if have gh; then
    # gh_authenticated, not `gh auth status`: the latter passes a configured account whose token has expired.
    check "gh authenticated" "gh auth login   (then: wk key register)" gh_authenticated
fi

section "credentials"
for _cname in $(wk_cred_names); do
    if [ "$_cname" != deploy-key ]; then
        _line=$(wk_cred_check "$_cname" --stored)
        _why=$(wk_cred_detail "$_line" | sed -n '1p')
        _fix=$(wk_cred_detail "$_line" | sed -n 's/^    fix: //p')
        case "$(wk_cred_verdict "$_line")" in
            ok)     ok   "$_cname -- $_why" ;;
            wide)   unk  "$_cname reaches further than wk spends it" "$_why" ;;
            bad)    miss "$_cname: $_why" "${_fix:-wk key check}" ;;
            absent) unk  "$_cname: $_why" "wk key check" ;;
            *)      unk  "$_cname: $_why" "wk key check" ;;
        esac
    fi
done
unset _cname _line _why _fix

section "root access"
# WK_QUIET, not a literal --quiet: this bypasses the dispatcher, which strips the flag into the environment for every other caller.
if _sudo=$(WK_QUIET=1 "$WK_ROOT/cmd/sudo" status 2>&1); then
    ok "sudo: $_sudo"
else
    miss "sudo: $_sudo" "wk sudo setup"
fi

section "config (./setup owns these)"
check "~/.claude/settings.json is the HOST settings" "./setup --stage claude" \
    link_ok "$HOME/.claude/settings.json" "$WK_ROOT/claude/settings-host.json"
check "~/.claude/CLAUDE.md is the HOST briefing" "./setup --stage claude" \
    link_ok "$HOME/.claude/CLAUDE.md" "$WK_ROOT/claude/CLAUDE-host.md"
check "shell rc sources shell/bashrc" "./setup --stage dotfiles" \
    sh -c "grep -q 'wk-tools/shell/bashrc' '$HOME/.zshrc' 2>/dev/null || grep -q 'wk-tools/shell/bashrc' '$HOME/.bashrc' 2>/dev/null"

# The failure worth catching is a [user] section written *after* the include in ~/.gitconfig: git takes a key's last value, so it silently wins.
git_identity_ok() { # <name|email>
    [ "$(git config --get "user.$1" 2>/dev/null)" \
      = "$(git config --file "$WK_ROOT/dotfiles/gitconfig" --get "user.$1" 2>/dev/null)" ]
}
git_speed_ok() {
    [ "$(git config --get core.fsmonitor 2>/dev/null)" = true ] \
        && [ "$(git config --get feature.manyFiles 2>/dev/null)" = true ]
}
if have git; then
    check "git user.name is the repo's"  "./setup --stage dotfiles" git_identity_ok name
    check "git user.email is the repo's" "./setup --stage dotfiles" git_identity_ok email
    check "git speed settings (fsmonitor, manyFiles)" "./setup --stage dotfiles" git_speed_ok
fi

# Findings, not printed rows: <state>\t<what>\t<remedy>, state ok|wrong|note, so each caller's ok()/miss()/unk() stays the one place a row prints.
git_config_findings() { # <label> <blob> <remedy>
    local label="$1" blob="$2" remedy="$3" want have v
    if ! printf '%s\n' "$blob" | grep -q '^git\.name='; then
        printf 'note\t%s: git not installed there\t\n' "$label"
        return 0
    fi
    for v in name email; do
        want=$(git config --file "$WK_ROOT/dotfiles/gitconfig" --get "user.$v" 2>/dev/null || true)
        have=$(kv_get "git.$v" <<<"$blob")
        if [ -n "$want" ] && [ "$have" = "$want" ]; then
            printf 'ok\t%s: git user.%s = %s\t\n' "$label" "$v" "$have"
        elif [ -z "$have" ]; then
            printf 'wrong\t%s: git user.%s is not set there\t%s\n' "$label" "$v" "$remedy"
        else
            printf "wrong\t%s: git user.%s there is '%s', not this repo's '%s'\t%s\n" \
                "$label" "$v" "$have" "$want" "$remedy"
        fi
    done
    if [ "$(kv_get git.fsmonitor <<<"$blob")" = true ] \
       && [ "$(kv_get git.manyfiles <<<"$blob")" = true ]; then
        printf 'ok\t%s: git speed settings (fsmonitor, manyFiles)\t\n' "$label"
    else
        printf 'wrong\t%s: git speed settings (fsmonitor, manyFiles)\t%s\n' "$label" "$remedy"
    fi
    return 0
}

# Everything a rebuilt machine cannot get from this repo is declared here: `regenerable`
# wk makes a new one, `re-authable` a person logs in again, `backed-up` is lost with the disk.
section "machine-local state (everything a rebuild cannot get from this repo)"
# On macOS a path under the store is asked for inside the VM, and only while it runs, since doctor starts nothing.
podman_machine_running() {
    have podman && [ "$(podman machine inspect "$WK_MACHINE" --format '{{.State}}' 2>/dev/null)" = running ]
}
local_state() { # <path> <kind> <how to get it back>
    local path="$1" kind="$2" how="$3" disp
    disp="${path/#$HOME/\~}"
    if is_macos && [ -z "${WK_IN_VM:-}" ] && [ "${path#"$WK_STORE"/}" != "$path" ]; then
        disp="$disp (podman VM)"
        if ! podman_machine_running; then
            unk "$disp -- not visible while the podman machine is stopped" "$kind: $how"
            return 0
        fi
        if podman machine ssh "$WK_MACHINE" -- "test -e $(sh_quote "$path")" </dev/null >/dev/null 2>&1; then
            ok "$disp ($kind) -- $how"
        else
            unk "$disp (absent)" "$kind: $how"
        fi
        return 0
    fi
    if [ -e "$path" ]; then
        ok "$disp ($kind) -- $how"
    else
        unk "$disp (absent)" "$kind: $how"
    fi
}
local_state "$WK_STORE/bench"                      backed-up   "benchmark runs and their provenance -- not regenerable at any price; a rerun is a different measurement"
local_state "$(wk_secrets_dir)"                    regenerable "wk key register makes new deploy keys (revoke the old ones on GitHub)"
local_state "$(wk_push_held_dir)"                  regenerable "wk key register makes new deploy keys; wk key set github-pat stores a new token (revoke the old ones on GitHub)"
local_state "$(push_agent_machine_read_pat)"       regenerable "./setup and wk key set github-pat both write it from the token in $(wk_push_held_dir)"
for _sname in $(wk_agent_secret_names); do
    local_state "$(wk_agent_secret_path "$_sname")" re-authable \
        "wk key set $_sname stores one; every workspace this machine makes starts authenticated with it"
done
unset _sname
local_state "${WK_TS_AUTHKEY:-$HOME/.config/wk/tailscale-authkey}" re-authable "wk key tailnet asks for one (tag:wk, reusable, not ephemeral, longest expiry); joined nodes are unaffected"
local_state "$(wk_tailscale_api_path)" re-authable "wk key tailnet-api asks for one; only this machine holds it, and only writes that must retire a stale node need it"
local_state "$(wk_state_dir)/broker"               regenerable "request records (argv, log, status) the fleet-request broker writes; the next request makes new ones"
local_state "$HOME/.ssh/config.d/local"            backed-up   "hand-written ssh entries (host/dotfiles.sh moves them here and owns the rest)"
local_state "$(wk_state_dir)/ssh/zed_ed25519"      regenerable "wk zed makes a new one and re-authorises it in the workspace"
if [ "$(wk_os)" = linux ]; then
    # "This machine is rpi5" is read off the registry (NODE_SSH), not a literal here.
    . "$WK_ROOT/boot/machines.sh"
    if machine_load rpi5 2>/dev/null && [ "$(wk_machine_name)" = "$NODE_SSH" ]; then
        local_state "$WK_ROOT/host/linux/rpi5/rpi5.conf" backed-up "site WiFi identity (gitignored: repo is public); rpi5.conf.example documents the shape"
    fi
    local_state /var/lib/tailscale                 re-authable "tailscale up re-authenticates; the node name survives via the admin console"
fi
unset -f local_state

report_store() { # <probe output> [container-machine git remedy]
    local out="$1" gitremedy="${2:-}" v _gs _gw _gr
    v() { printf '%s' "$out" | sed -n "s/^$1=//p"; }
    [ "$(v mirror)" = ok ] && ok "WebKit mirror"          || miss "WebKit mirror" "wk sync"
    [ "$(v base)" = ok ]   && ok "base snapshot"          || miss "base snapshot" "wk sync"
    # Read here, not in the probe: the deploy keys are this machine's own, which on macOS is the directory the podman machine mounts.
    [ -f "$(wk_push_held_dir)/build_key_fork" ] \
        && ok "fork push key" || miss "fork push key" "wk key register  (needs gh auth)"
    [ "$(v skills)" = ok ] && ok "shared skills seeded"   || miss "shared skills seeded" "wk skills push"
    [ "$(v proxy)" = ok ]  && ok "egress proxy running"   || miss "egress proxy running" "./setup --stage sdk, then systemctl --user status wk-proxy"
    [ "$(v pihosts)" = ok ] && ok "pi-hosts populated"    || miss "pi-hosts populated" "wk pi setup rpi5 / rpi4  (skip if no Pi devices)"
    [ "$(v broker)" = ok ]  && ok "fleet-request broker reachable from workspaces" \
                           || miss "fleet-request broker reachable from workspaces" \
                                   "./setup --stage broker  (macOS: it also publishes the socket into the VM)"
    # Only when the probe came from a genuinely different machine: on Linux it runs locally, and the config section above checked it.
    if [ -n "$gitremedy" ]; then
        while IFS="$(printf '\t')" read -r _gs _gw _gr; do
            [ -n "$_gs" ] || continue
            case "$_gs" in
                ok)    ok "$_gw" ;;
                wrong) miss "$_gw" "$_gr" ;;
                note)  unk "$_gw" "$_gr" ;;
            esac
        done <<GITFINDINGS
$(git_config_findings "container machine" "$out" "$gitremedy")
GITFINDINGS
    fi
}

section "workspaces store"
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    if ! have podman || ! podman machine inspect "$WK_MACHINE" >/dev/null 2>&1; then
        miss "podman machine '$WK_MACHINE'" "./setup --stage machine"
    elif ! podman_machine_running; then
        unk "podman machine '$WK_MACHINE' is stopped" "wk start, then re-run wk doctor for the store checks"
    else
        ok "podman machine '$WK_MACHINE' running"
        out=$(podman machine ssh "$WK_MACHINE" -- \
            "WK_STORE=/var/lib/wk bash /opt/wk-tools/cmd/doctor --probe-store" 2>/dev/null || true)
        if [ -n "$out" ]; then
            report_store "$out" \
                "podman machine ssh $WK_MACHINE -- git config --global include.path /opt/wk-tools/dotfiles/gitconfig"
        else
            unk "store inside the VM" "/opt/wk-tools missing in the VM? run ./setup --stage sdk"
        fi
    fi
else
    report_store "$(probe_store)"
fi

if is_linux; then
    section "benchmarking"
    # The property, not the file: a helper whose sudoers rule is out-ranked is installed, executable and useless.
    if [ ! -x /usr/local/libexec/wk-quiesce-priv ]; then
        miss "privileged helper (wk quiesce / wk session)" \
             "./setup --stage quiesce  (interactive sudo)"
    elif sudo -n /usr/local/libexec/wk-quiesce-priv status >/dev/null 2>&1; then
        ok "privileged helper (wk quiesce / wk session)"
    else
        miss "privileged helper: installed, but its sudoers rule is not in force" \
             "sudo -l shows the include order; /etc/sudoers.d/zzz-wk-quiesce must be the last match -- ./setup --stage quiesce"
    fi
    case " $(id -nG "$(id -un)" 2>/dev/null) " in
        *" render "*) ok "render group configured" ;;
        *) miss "render group configured" "./setup --stage tools, then log out and in" ;;
    esac
fi

# A stopped guest is skipped rather than reported unreachable, since doctor starts nothing;
# a guest is a clone of the golden base, so a wrong one is fixed by a refreshed base and a fresh clone.
VM_GIT_PROBE='command -v git >/dev/null 2>&1 || exit 0
printf "git.name=%s\n" "$(git config --get user.name 2>/dev/null || true)"
printf "git.email=%s\n" "$(git config --get user.email 2>/dev/null || true)"
printf "git.fsmonitor=%s\n" "$(git config --get core.fsmonitor 2>/dev/null || true)"
printf "git.manyfiles=%s\n" "$(git config --get feature.manyFiles 2>/dev/null || true)"'
vm_guest_git_findings() {
    local g state remedy blob
    for g in $(target_workspaces 2>/dev/null); do
        [ -n "$g" ] || continue
        state=$(t_info "$g" 2>/dev/null || true)
        [ "$state" = running ] || continue
        remedy="wk vm base --refresh, then wk rm $g and wk new (a guest is a clone of the base)"
        blob=$(t_exec "$g" sh -c "$VM_GIT_PROBE" 2>/dev/null) || blob=""
        if [ -z "$blob" ]; then
            printf 'note\t%s (tart guest): git config did not answer\t%s\n' "$g" "wk vm check $g"
            continue
        fi
        git_config_findings "$g (tart guest)" "$blob" "$remedy"
    done
    return 0
}

if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    section "macOS VM target (optional -- Apple ports)"
    if have tart || [ -x "$HOME/.local/bin/tart" ]; then
        ok "tart installed"
        if [ -x "${WK_SOFTNET_BIN:-/usr/local/bin/softnet}" ] && [ -u "${WK_SOFTNET_BIN:-/usr/local/bin/softnet}" ]; then
            ok "softnet installed SUID root"
        else
            miss "softnet installed SUID root" "./setup --stage softnet  (interactive sudo)"
        fi
        # In a subshell, like the build machines below: the vm driver re-points WK_STORE at this machine's state.
        _base=$( ( . "$WK_ROOT/lib/target.sh"
                   load_target vm >/dev/null 2>&1
                   vm_base_findings ) 2>/dev/null ) || _base=""
        if [ -z "$_base" ]; then
            unk "golden base VM: the vm driver did not answer" "wk vm ls"
        else
            while IFS="$(printf '\t')" read -r _state _what _remedy; do
                [ -n "$_state" ] || continue
                case "$_state" in
                    ok)    ok "$_what" ;;
                    wrong) miss "$_what" "${_remedy:-wk vm ls}" ;;
                    note)  unk "$_what" "${_remedy:-}" ;;
                esac
            done <<FINDINGS
$_base
FINDINGS
        fi
        unset _base _state _what _remedy

        _gfindings=$( ( . "$WK_ROOT/lib/target.sh"
                         load_target vm >/dev/null 2>&1
                         vm_guest_git_findings ) 2>/dev/null ) || _gfindings=""
        while IFS="$(printf '\t')" read -r _gstate _gwhat _gremedy; do
            [ -n "$_gstate" ] || continue
            case "$_gstate" in
                ok)    ok "$_gwhat" ;;
                wrong) miss "$_gwhat" "${_gremedy:-wk vm ls}" ;;
                note)  unk "$_gwhat" "${_gremedy:-}" ;;
            esac
        done <<GFINDINGS
$_gfindings
GFINDINGS
        unset _gfindings _gstate _gwhat _gremedy
    else
        unk "tart not installed" "README.md, Setup -- only needed for Apple-port builds"
    fi
fi

if [ -n "$ALL" ]; then
    . "$WK_ROOT/lib/target.sh"
    . "$WK_ROOT/remote/deps.sh"
    for _t in $(target_all); do
        [ "$_t" = container ] && continue
        ( load_target "$_t" >/dev/null 2>&1 && [ "$WK_TARGET_KIND" = remote ] ) || continue
        section "build machine: $_t"
        _probe=$( ( load_target "$_t" >/dev/null 2>&1; wk_remote_probe ) 2>/dev/null ) || _probe=""
        if [ -z "$_probe" ]; then
            unk "$_t did not answer" "ssh $_t true  -- then re-run; nothing was changed"
            continue
        fi
        while IFS="$(printf '\t')" read -r _state _what _remedy; do
            [ -n "$_state" ] || continue
            case "$_state" in
                ok)       ok "$_what" ;;
                required) miss "$_what" "${_remedy:-see 'wk remote setup $_t'}" ;;
                wanted)   miss "$_what" "${_remedy:-see 'wk remote setup $_t'}" ;;
                note)     unk "$_what" "${_remedy:-}" ;;
            esac
        done <<FINDINGS
$(wk_remote_findings "$_probe")
FINDINGS
        # remote_provision_stale: a machine can have every tool a build needs while its wk-side provisioning came from an older remote/provision.sh.
        if _why=$( ( load_target "$_t" >/dev/null 2>&1; remote_provision_stale ) 2>/dev/null ); then
            miss "provisioning on $_t predates its inputs: $_why" "wk remote setup $_t"
        else
            ok "provisioned from this tree's remote/provision.sh + remote/deps.sh"
        fi
    done
    unset _t _probe _state _what _remedy _why
fi

if [ -n "$ALL" ]; then
    section "battery"
    if _names=$("$WK_ROOT/cmd/bridge" ls --names 2>/dev/null) && [ -n "$_names" ]; then
        while IFS= read -r _bn; do
            [ -n "$_bn" ] || continue
            _blob=$("$WK_ROOT/cmd/bridge" battery "$_bn" 2>/dev/null) || _blob=""
            if [ -z "$_blob" ]; then
                unk "$_bn: did not answer" "wk bridge status $_bn"
                continue
            fi
            while IFS="$(printf '\t')" read -r _verdict _line _remedy; do
                [ -n "$_verdict" ] || continue
                case "$_verdict" in
                    ok)   ok "$_line" ;;
                    miss) miss "$_line" "$_remedy" ;;
                esac
            done <<VERDICT
$(battery_verdict "$_bn" "$_blob")
VERDICT
        done <<BRIDGES
$_names
BRIDGES
    fi
    unset _bn _blob _names _verdict _line _remedy

    if is_macos && _pm=$(pmset -g batt 2>/dev/null) && _macline=$(mac_battery_line "$_pm"); then
        unk "this Mac: $_macline" "docs/Urgent/HUMAN-battery.md -- no OS knob exists yet"
    fi
    unset _pm _macline
fi

echo >&2
if [ "$missing" -eq 0 ]; then
    info "everything checkable is provisioned"
    exit 0
fi
warn "$missing item(s) missing -- each line above names its fix; the order that"
log  "works from bare metal: ./setup -> the interactive stages it lists ->"
log  "gh auth login -> wk key register -> wk sync -> (optional) wk pi setup,"
log  "wk vm base -> claude setup-token and wk key set claude. See README.md."
exit 1
