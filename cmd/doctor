#!/usr/bin/env bash
#
# wk doctor [--all] -- what is provisioned on this machine, and what is still missing
# wk: where=local name=none readonly group=hosts
#
# The reinstall companion: `./setup` is the automated path, but several pieces
# are deliberately manual (interactive sudo, credentials, hardware) and after a
# wipe the only record of them was memory. This prints the full checklist with
# the exact next command for everything missing, so "is this machine ready" is
# one read-only command instead of archaeology.
#
# Read-only by design: it never starts the podman machine, never boots a
# guest, and never prompts. State it cannot see without starting something is
# reported as '??' with the command that would reveal it.
#
#   --all   also ask every configured build machine (targets/hosts/*.conf) what
#           it has: the tools a build needs there, the identity a commit made
#           there would carry, and any build variable that machine's own
#           profile sets. Read-only, over ssh, and it starts nothing; a machine
#           that does not answer is reported as unreachable, never as broken.
#
#   0  everything checkable is provisioned
#   1  something is missing (the lines say what and how)

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"

WK_MACHINE="${WK_MACHINE:-wk}"

# The store lives where the containers do -- locally on Linux, inside the
# podman VM on macOS -- so the macOS host asks the VM to run exactly this
# probe and parses the key=value lines back.
probe_store() {
    [ -d "$WK_STORE/git/WebKit.git" ] && echo mirror=ok || echo mirror=no
    [ -n "$(ls -1 "$WK_STORE/base" 2>/dev/null)" ] && echo base=ok || echo base=no
    [ -f "$WK_STORE/secrets/build_key_fork" ] && echo key=ok || echo key=no
    [ -f "$WK_STORE/secrets/claude-credentials.json" ] && echo creds=ok || echo creds=no
    [ -n "$(ls -1 "$WK_STORE/skills" 2>/dev/null)" ] && echo skills=ok || echo skills=no
    # The socket is accepted as proof too: systemctl --user over a bare ssh
    # session can fail to find the user bus even when the service is fine.
    if systemctl --user is-active --quiet wk-proxy.service 2>/dev/null \
       || [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wk/proxy.sock" ]; then
        echo proxy=ok
    else
        echo proxy=no
    fi
    [ -s "$WK_STORE/pi-hosts" ] && echo pihosts=ok || echo pihosts=no
    # The fleet-request broker's socket, not the service: on macOS the
    # broker runs on the Mac and publishes its socket in here over ssh, so a
    # broker up with a broken forward looks healthy from out there and
    # unreachable from every workspace. This probe runs where a workspace
    # stands, the only place the answer means anything.
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wk/broker.sock" ] \
        && echo broker=ok || echo broker=no
}
if [ "${1:-}" = --probe-store ]; then
    probe_store
    exit 0
fi
ALL=""
case "${1:-}" in
    --all) ALL=1; shift ;;
esac
[ $# -eq 0 ] || die "usage: wk doctor [--all]; see wk doctor -h"

missing=0
ok()   { printf '  \033[32mok\033[0m    %s\n' "$*" >&2; }
miss() { printf '  \033[31m--\033[0m    %-46s -> %s\n' "$1" "$2" >&2; missing=$((missing + 1)); }
unk()  { printf '  \033[33m??\033[0m    %-46s -> %s\n' "$1" "$2" >&2; }
section() { printf '\n%s\n' "$*" >&2; }

check() { # check <description> <fix> <command...>
    local what="$1" fix="$2"; shift 2
    if "$@" >/dev/null 2>&1; then ok "$what"; else miss "$what" "$fix"; fi
}

link_ok() { [ -L "$1" ] && [ "$(readlink "$1")" = "$2" ]; }

info "wk doctor on $(wk_os) ($(hostname))"

# --- host tools ----------------------------------------------------------------
section "host tools"
if is_macos; then
    check "Xcode command line tools" "xcode-select --install"     xcode-select -p
    check "podman"                   "install the official pkg from podman.io" have podman
    check "zed"        "https://zed.dev/download" sh -c 'command -v zed || [ -d /Applications/Zed.app ]'
    check "tailscale"  "https://tailscale.com/download/macos" \
        sh -c 'command -v tailscale || [ -d /Applications/Tailscale.app ]'
else
    check "podman"     "./setup --stage tools" have podman
    check "zsh"        "./setup --stage tools" have zsh
    check "cage (benchmark kiosk)"  "./setup --stage tools" have cage
    check "wlr-randr (session off)" "./setup --stage tools" have wlr-randr
fi
# Optional: only `wk find` (the LAN sweep for a board with no tailnet name)
# needs it, and it refuses by name without it (cmd/find). Same note as
# host/macos/tools.sh's ./setup-time check, just with both platforms' remedy.
if have nmap; then
    ok "nmap (wk find)"
elif is_macos; then
    unk "nmap absent -- only 'wk find' needs it" "nmap.org, the .dmg"
else
    unk "nmap absent -- only 'wk find' needs it" "./setup  (host/linux/apt.txt)"
fi
check "jq (claude hook)" "./setup --stage tools" have jq
check "gh"               "install gh, then: gh auth login" have gh
if have gh; then
    # gh_authenticated, not `gh auth status`: the latter passes a configured
    # account whose token has expired, which is a healthy report about a
    # machine that cannot register a key (lib/common.sh).
    check "gh authenticated" "gh auth login   (then: wk key register)" gh_authenticated
fi
# Checked here rather than only listed under machine-local state below: its
# absence isn't a backup question, it's what a freshly written card spends
# to join the tailnet -- `wk sysimage write` refuses without it. Never
# prompts (wk_tailscale_authkey_present, lib/common.sh).
check "tailnet auth key" "wk key tailnet" wk_tailscale_authkey_present
# Optional, and reported as such: only a write whose name is held by a stale
# fleet node needs it. Presence only -- a doctor run must not spend a request
# on every invocation; `wk key tailnet-api` asks the tailnet.
if wk_tailscale_api_present; then
    ok "tailnet API token (retires a stale fleet node)"
else
    unk "no tailnet API token -- a write whose name a stale fleet node holds stops without it" "wk key tailnet-api"
fi

# --- root costs a password ------------------------------------------------------
# Reported on every run rather than remembered anywhere: a site sudoers
# update, a reinstall, or a forced `wk sudo setup` all change it underneath
# you. Never prompts (`wk sudo status` is all `sudo -n`).
section "root access"
# WK_QUIET, not a literal --quiet: this bypasses the dispatcher, which is
# what strips the flag into the environment for every other caller.
if _sudo=$(WK_QUIET=1 "$WK_ROOT/cmd/sudo" status 2>&1); then
    ok "sudo: $_sudo"
else
    miss "sudo: $_sudo" "wk sudo setup"
fi

# --- config links ----------------------------------------------------------------
section "config (./setup owns these)"
check "~/.claude/settings.json is the HOST settings" "./setup --stage claude" \
    link_ok "$HOME/.claude/settings.json" "$WK_ROOT/claude/settings-host.json"
check "~/.claude/CLAUDE.md is the HOST briefing" "./setup --stage claude" \
    link_ok "$HOME/.claude/CLAUDE.md" "$WK_ROOT/claude/CLAUDE-host.md"
check "shell rc sources shell/bashrc" "./setup --stage dotfiles" \
    sh -c "grep -q 'wk-tools/shell/bashrc' '$HOME/.zshrc' 2>/dev/null || grep -q 'wk-tools/shell/bashrc' '$HOME/.bashrc' 2>/dev/null"

# The identity every commit from this machine carries, and its speed settings
# (fsmonitor, untrackedCache, manyFiles -- what makes `git status` in a WebKit
# checkout, and Zed's git panel over ssh, answer at all). Both come from
# dotfiles/gitconfig, so both are checked against that file rather than against
# a literal here. The failure worth catching is not an absent include but a
# [user] section written *after* it in ~/.gitconfig: git takes a key's last
# value, so it silently wins, and the first sign of it is a pushed commit with
# the wrong author.
git_identity_ok() { # <name|email>
    [ "$(git config --get "user.$1" 2>/dev/null)" \
      = "$(git config --file "$WK_ROOT/dotfiles/gitconfig" --get "user.$1" 2>/dev/null)" ]
}
git_speed_ok() {
    [ "$(git config --get core.fsmonitor 2>/dev/null)" = true ] \
        && [ "$(git config --get feature.manyFiles 2>/dev/null)" = true ]
}
if have git; then
    check "git user.name is the repo's"  "./setup --stage dotfiles" git_identity_ok name
    check "git user.email is the repo's" "./setup --stage dotfiles" git_identity_ok email
    check "git speed settings (fsmonitor, manyFiles)" "./setup --stage dotfiles" git_speed_ok
fi

# --- machine-local state: declared, never hidden ---------------------------------
# The cattle-not-pets rule (CLAUDE.md): everything a rebuilt machine cannot
# get from this repo is *declared here*, with how to get it back. Three
# kinds, and the kind is the restore story:
#   regenerable   wk makes a new one (nothing to back up)
#   re-authable   a person logs in again (nothing to back up)
#   backed-up     genuinely machine-local data; if it is not in your backups,
#                 it is lost with the disk
section "machine-local state (everything a rebuild cannot get from this repo)"
# On macOS the store is the podman VM's, so a path under it is asked for in
# there -- only while the machine is running, since doctor starts nothing.
podman_machine_running() {
    have podman && [ "$(podman machine inspect "$WK_MACHINE" --format '{{.State}}' 2>/dev/null)" = running ]
}
local_state() { # <path> <kind> <how to get it back>
    local path="$1" kind="$2" how="$3" disp
    disp="${path/#$HOME/\~}"
    if is_macos && [ -z "${WK_IN_VM:-}" ] && [ "${path#"$WK_STORE"/}" != "$path" ]; then
        disp="$disp (podman VM)"
        if ! podman_machine_running; then
            unk "$disp -- not visible while the podman machine is stopped" "$kind: $how"
            return 0
        fi
        if podman machine ssh "$WK_MACHINE" -- "test -e $(sh_quote "$path")" </dev/null >/dev/null 2>&1; then
            ok "$disp ($kind) -- $how"
        else
            unk "$disp (absent)" "$kind: $how"
        fi
        return 0
    fi
    if [ -e "$path" ]; then
        ok "$disp ($kind) -- $how"
    else
        unk "$disp (absent)" "$kind: $how"
    fi
}
# Benchmark runs are the one thing in the store that is data rather than a
# rebuildable artifact: a number came off a machine in a state that no
# longer exists, and a rerun is a different measurement.
local_state "$WK_STORE/bench"                      backed-up   "benchmark runs and their provenance -- not regenerable at any price; a rerun is a different measurement"
local_state "$WK_STORE/secrets"                    regenerable "wk key register makes new deploy keys (revoke the old ones on GitHub)"
local_state "$WK_STORE/secrets/claude-credentials.json" re-authable "claude login in one workspace re-seeds it"
# The fleet's one tailscale auth key (wk_tailscale_authkey, lib/common.sh).
# re-authable, not backed-up: a new tagged key from the admin console is as
# good as the old one, and a tagged node never key-expires.
local_state "${WK_TS_AUTHKEY:-$HOME/.config/wk/tailscale-authkey}" re-authable "wk key tailnet asks for one (tag:wk, reusable, not ephemeral, longest expiry); joined nodes are unaffected"
# The tailnet API token (wk_tailscale_api_path, lib/common.sh): what retires
# a stale fleet node so a reprovision does not stop at a person with a
# browser. re-authable, and never written to a card -- it administers the
# whole tailnet, which is the one power a board on a shelf must not hold.
local_state "${WK_TS_API_SECRET:-$HOME/.config/wk/tailscale-api-key}" re-authable "wk key tailnet-api asks for one; only this machine holds it, and only writes that must retire a stale node need it"
# What the request broker did, on this machine, for workspaces that could
# not do it themselves. Regenerable: a machine's state is always read back
# from the machine, so losing the directory costs the words, not a fact.
local_state "$(wk_state_dir)/broker"               regenerable "request records (argv, log, status) the fleet-request broker writes; the next request makes new ones"
local_state "$HOME/.ssh/config.d/local"            backed-up   "hand-written ssh entries (host/dotfiles.sh moves them here and owns the rest)"
# This machine's key for reaching its own container workspaces' sshd (zed_key,
# lib/target.sh). Regenerable without asking anybody: it authenticates this
# machine to containers this machine owns, and the next `wk zed` authorises
# whatever key it finds.
local_state "$(wk_state_dir)/ssh/zed_ed25519"      regenerable "wk zed makes a new one and re-authorises it in the workspace"
if [ "$(wk_os)" = linux ]; then
    # "This machine is rpi5" is read off the registry (MACH_SSH,
    # boot/machines/rpi5.conf) rather than a second "rpi5" literal here.
    . "$WK_ROOT/boot/machines.sh"
    if machine_load rpi5 2>/dev/null && [ "$(wk_machine_name)" = "$MACH_SSH" ]; then
        local_state "$WK_ROOT/host/linux/rpi5/rpi5.conf" backed-up "site WiFi identity (gitignored: repo is public); rpi5.conf.example documents the shape"
    fi
    local_state /var/lib/tailscale                 re-authable "tailscale up re-authenticates; the node name survives via the admin console"
fi
unset -f local_state

# --- the store: mirror, snapshots, keys, credentials -----------------------------
# Probed over one `podman machine ssh` on macOS -- and only if the machine is
# already running, because doctor never starts anything.
report_store() { # <probe output>
    local out="$1" v
    v() { printf '%s' "$out" | sed -n "s/^$1=//p"; }
    [ "$(v mirror)" = ok ] && ok "WebKit mirror"          || miss "WebKit mirror" "wk sync"
    [ "$(v base)" = ok ]   && ok "base snapshot"          || miss "base snapshot" "wk sync"
    [ "$(v key)" = ok ]    && ok "fork push key"          || miss "fork push key" "wk key register  (needs gh auth)"
    [ "$(v creds)" = ok ]  && ok "shared claude credentials" \
                           || miss "shared claude credentials" "run 'claude login' once inside a workspace"
    [ "$(v skills)" = ok ] && ok "shared skills seeded"   || miss "shared skills seeded" "wk skills push"
    [ "$(v proxy)" = ok ]  && ok "egress proxy running"   || miss "egress proxy running" "./setup --stage sdk, then systemctl --user status wk-proxy"
    [ "$(v pihosts)" = ok ] && ok "pi-hosts populated"    || miss "pi-hosts populated" "wk pi setup rpi5 / rpi4  (skip if no Pi devices)"
    # Named for what a workspace loses without it: its absence reads as "wk
    # boot refuses in here", which is also what a locked-down workspace looks like.
    [ "$(v broker)" = ok ]  && ok "fleet-request broker reachable from workspaces" \
                           || miss "fleet-request broker reachable from workspaces" \
                                   "./setup --stage broker  (macOS: it also publishes the socket into the VM)"
}

section "workspaces store"
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    if ! have podman || ! podman machine inspect "$WK_MACHINE" >/dev/null 2>&1; then
        miss "podman machine '$WK_MACHINE'" "./setup --stage machine"
    elif ! podman_machine_running; then
        unk "podman machine '$WK_MACHINE' is stopped" "wk start, then re-run wk doctor for the store checks"
    else
        ok "podman machine '$WK_MACHINE' running"
        out=$(podman machine ssh "$WK_MACHINE" -- \
            "WK_STORE=/var/lib/wk bash /opt/wk-tools/cmd/doctor --probe-store" 2>/dev/null || true)
        if [ -n "$out" ]; then
            report_store "$out"
        else
            unk "store inside the VM" "/opt/wk-tools missing in the VM? run ./setup --stage sdk"
        fi
    fi
else
    report_store "$(probe_store)"
fi

# --- benchmarking (Linux) ----------------------------------------------------------
if is_linux; then
    section "benchmarking"
    # The property, not the file: `test -x` answers "is the helper
    # installed", not whether it works -- a helper whose sudoers rule is
    # out-ranked is installed, executable and useless. Asking the helper is
    # what tells the two apart.
    if [ ! -x /usr/local/libexec/wk-quiesce-priv ]; then
        miss "privileged helper (wk quiesce / wk session)" \
             "./setup --stage quiesce  (interactive sudo)"
    elif sudo -n /usr/local/libexec/wk-quiesce-priv status >/dev/null 2>&1; then
        ok "privileged helper (wk quiesce / wk session)"
    else
        miss "privileged helper: installed, but its sudoers rule is not in force" \
             "sudo -l shows the include order; /etc/sudoers.d/zzz-wk-quiesce must be the last match -- ./setup --stage quiesce"
    fi
    case " $(id -nG "$(id -un)" 2>/dev/null) " in
        *" render "*) ok "render group configured" ;;
        *) miss "render group configured" "./setup --stage tools, then log out and in" ;;
    esac
fi

# --- macOS VM target ---------------------------------------------------------------
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    section "macOS VM target (optional -- Apple ports)"
    if have tart || [ -x "$HOME/.local/bin/tart" ]; then
        ok "tart installed"
        if [ -x "${WK_SOFTNET_BIN:-/usr/local/bin/softnet}" ] && [ -u "${WK_SOFTNET_BIN:-/usr/local/bin/softnet}" ]; then
            ok "softnet installed SUID root"
        else
            miss "softnet installed SUID root" "./setup --stage softnet  (interactive sudo)"
        fi
        tart_bin=$(command -v tart 2>/dev/null || echo "$HOME/.local/bin/tart")
        if "$tart_bin" list 2>/dev/null | grep -q "wk-base"; then
            ok "golden base VM 'wk-base'"
        else
            miss "golden base VM 'wk-base'" "wk vm base  (hours: image pull + prebuild)"
        fi
    else
        unk "tart not installed" "README.md, Setup -- only needed for Apple-port builds"
    fi
fi

# --- the build machines (--all) ------------------------------------------------
# Read-only and over ssh: remote/probe.sh behind remote/deps.sh, exactly as `wk
# remote setup` sends it, so the two cannot disagree about what a build machine
# needs. Nothing is provisioned, started or asked for here.
if [ -n "$ALL" ]; then
    . "$WK_ROOT/lib/target.sh"
    . "$WK_ROOT/remote/deps.sh"
    for _t in $(target_all); do
        [ "$_t" = container ] && continue
        ( load_target "$_t" >/dev/null 2>&1 && [ "$WK_TARGET_KIND" = remote ] ) || continue
        section "build machine: $_t"
        _probe=$( ( load_target "$_t" >/dev/null 2>&1; wk_remote_probe ) 2>/dev/null ) || _probe=""
        if [ -z "$_probe" ]; then
            unk "$_t did not answer" "ssh $_t true  -- then re-run; nothing was changed"
            continue
        fi
        while IFS="$(printf '\t')" read -r _state _what _remedy; do
            [ -n "$_state" ] || continue
            case "$_state" in
                ok)       ok "$_what" ;;
                required) miss "$_what" "${_remedy:-see 'wk remote setup $_t'}" ;;
                wanted)   miss "$_what" "${_remedy:-see 'wk remote setup $_t'}" ;;
                note)     unk "$_what" "${_remedy:-}" ;;
            esac
        done <<FINDINGS
$(wk_remote_findings "$_probe")
FINDINGS
    done
    unset _t _probe _state _what _remedy
fi

# --- verdict -----------------------------------------------------------------------
echo >&2
if [ "$missing" -eq 0 ]; then
    info "everything checkable is provisioned"
    exit 0
fi
warn "$missing item(s) missing -- each line above names its fix; the order that"
log  "works from bare metal: ./setup -> the interactive stages it lists ->"
log  "gh auth login -> wk key register -> wk sync -> (optional) wk pi setup,"
log  "wk vm base -> claude login in the first workspace. See README.md."
exit 1
