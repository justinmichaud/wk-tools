#!/usr/bin/env python3
#
# wk doctor [<workspace> [--gpu] | <machine>] [--all] -- what is provisioned on this machine, a machine's facts, or whether a workspace's wall holds
# wk: where=dynamic name=optional readonly group=hosts opts --all,--probe-store,--probe-tools,--gpu
#
# Every check of what this machine has provisioned, with the next command for
# each one missing; then which wk-tools this is (`sha`, and `dirty` on tracked
# files) and everything wk stores here with the total: the podman VM's disk
# image, the Tart guests, the store, and what `wk gc` reclaims or names.
# It never starts the podman machine, boots a guest or prompts: what it cannot
# see without that is '??' with the command that would reveal it.
#
#   wk doctor <workspace>   the sandbox around that workspace, measured from
#           inside it: egress through the allowlisting proxy, isolation and the
#           commit wall (a container), no key, token or credential inside that
#           could publish, reads and writes through the credential injector
#           against the host's push switch, the agent's login, and the GPU. A
#           remote place has no sandbox, and is refused.
#   wk doctor <machine>     a machine in machines/, asked from here: its tailnet
#           names, whether it answers, a bench machine's system, media and arm,
#           and a board's cpu governor and temperature. A name that is both a
#           machine and a workspace is the machine.
#   wk doctor               inside a workspace: the half it answers about itself,
#           with the push switch measured rather than read (what `wk ai claude`
#           runs in here before a session)
#
#   --gpu   fail if the workspace has no hardware-accelerated GPU (informational otherwise)
#
#   --all   also ask every build machine in machines/ for the tools a build
#           needs, its commit identity, its profile's build variables, whether
#           its credential copies are the ones stored here and whether its
#           provisioning is current (one that does not answer is unreachable,
#           never broken); and every bridge phone's battery charge cap and this
#           Mac's `pmset -g batt` line.
#
#   --probe-store   the store's key=value facts alone, for the host that asks
#                   the podman VM to run this where the store is
#   --probe-tools   this checkout's sha= and dirty= alone, for a machine
#                   comparing its wk-tools with this one's
#
#   0  everything checkable is provisioned; every check of the wall passed
#   1  something is missing, or a check of the wall failed (the lines say what and how)
#   3  inside a workspace: something in here could publish (a deploy key, a
#      GitHub or Bugzilla write the injector did not refuse)

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images, store  # noqa: E402

ROOT = images.root()

from wk import decl, disk, fleet, tools, wall  # noqa: E402
from wk.act import Refused, die, info, log, warn  # noqa: E402
from wk.doctor import Doctor, Report, device  # noqa: E402
from wk.machine import Local  # noqa: E402
from wk.places import Registry  # noqa: E402

ALLOWED = ("--all", "--probe-store", "--probe-tools", "--gpu")


def machine_named(argv, env):
    return next((a for a in argv if not a.startswith("-") and fleet.Fleet(ROOT, env).kind(a)), None)


def where(argv, env):
    """The dispatcher's `where=dynamic` question: a workspace's name goes to the machine holding it; a machine's is asked here."""
    return "workspace" if not machine_named(argv, env) and any(not a.startswith("-") for a in argv) else "local"


def about_machine(name, env):
    info("asking machine '%s' from here" % name)
    rep = Report(sys.stderr)
    rep.rows(device(ROOT, name, env, Local()))
    sys.stderr.write("\n")
    return rep.exit_status()


def only(args, allowed, why):
    extra = [f for f in ALLOWED if args.flag(f) and f not in allowed]
    if extra:
        die("%s %s" % (extra[0], why))


def inside(reg):
    driver = reg.load("local")
    info("checking workspace '%s' from inside it" % driver.ws_name)
    rep = Report(sys.stderr)
    publishing = wall.from_inside(ROOT, driver, driver.ws_name, reg.machine, rep)
    sys.stderr.write("\n")
    disk.workspace_report(reg)
    v = wall.verdict(rep, publishing)
    if v == "publishing":
        warn("an agent in here could publish (see above)")
        return 3
    if v == "broken":
        warn("%d check(s) failed -- the sandbox is not intact" % rep.missing)
        return 1
    info("sandbox intact, and nothing in here can publish")
    return 0


def workspace(reg, name, argv):
    args = decl.Args(decl.Decl(__file__), argv)
    driver = reg.load(reg.ws_place(name))
    info("checking workspace '%s' (%s)" % (name, driver.name))
    rep = Report(sys.stderr)
    wall.from_host(ROOT, driver, name, reg.machine, rep, want_gpu=args.flag("--gpu"))
    sys.stderr.write("\n")
    if wall.verdict(rep) == "broken":
        warn("%d check(s) failed -- the sandbox is not intact" % rep.missing)
        return 1
    info("sandbox intact")
    return 0


def main(argv, env=None, reg=None):
    env = os.environ if env is None else env
    if argv[:1] == ["--where"]:
        print(where(argv[1:], env))
        return 0
    args = decl.Args(decl.Decl(__file__), argv)
    if args.flag("--probe-tools"):
        only(args, ("--probe-tools",), "is not asked with --probe-tools")
        sys.stdout.write(tools.identity_text(tools.identity(ROOT, Local())))
        return 0
    reg = reg or Registry(ROOT, env, Local())
    named = machine_named(args.positionals, env)
    if named:
        if reg.in_workspace():
            die("'wk doctor %s' asks a machine from the host; in here 'wk doctor' checks this workspace" % named)
        only(args, (), "is not asked of a machine: wk doctor %s" % named)
        return about_machine(named, env)
    if reg.in_workspace():
        only(args, (), "is not asked inside a workspace: 'wk doctor' here checks this one")
        return inside(reg)
    name = store.ws_name(env)
    if name:
        only(args, ("--gpu",), "is this machine's question, not a workspace's: drop the workspace name")
        return workspace(reg, name, argv)
    only(args, ("--all", "--probe-store"), "is a workspace's question: wk doctor <workspace> --gpu")
    doc = Doctor(ROOT)
    if args.flag("--probe-store"):
        sys.stdout.write(doc.probe_store())
        return 0
    info("wk doctor on %s (%s)" % ("macos" if doc.macos else "linux", doc.hostname()))
    rep = Report(sys.stderr)
    for title, rows in doc.sections(args.flag("--all")):
        rep.section(title)
        rep.rows(rows)
    rep.section("wk-tools")
    ident = tools.identity(ROOT, Local())
    sys.stderr.write("  sha    %s\n  dirty  %s\n" % (ident["sha"], ident["dirty"]))
    disk.machine_report(ROOT, reg)
    sys.stderr.write("\n")
    if not rep.missing:
        info("everything checkable is provisioned")
        return rep.exit_status()
    warn("%d item(s) missing -- each line above names its fix; the order that" % rep.missing)
    log("works from bare metal: ./setup -> the interactive stages it lists ->")
    log("gh auth login -> claude setup-token -> wk key setup")
    log("-> wk sync -> (optional) wk machine setup <board>, wk sysimage build macos-guest-base. See README.md.")
    return rep.exit_status()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
