#!/usr/bin/env python3
#
# wk doctor [--all] -- what is provisioned on this machine, and what is still missing
# wk: where=local name=none readonly group=hosts opts --all,--probe-store
#
# The reinstall companion: `./setup` is the automated path, but several pieces
# are deliberately manual (interactive sudo, credentials, hardware). This prints
# the full checklist with the exact next command for everything missing.
#
# Read-only by design: it never starts the podman machine, never boots a guest,
# and never prompts. State it cannot see without starting something is reported
# as '??' with the command that would reveal it.
#
#   --all   also ask every configured machine (targets/hosts/*.conf) what it
#           has. A peer workstation: whether its own claude.ai login is one
#           Anthropic accepts and may run remote control. A build machine: the
#           tools a build needs there, the identity a commit made there would
#           carry, any build variable that machine's own profile sets, whether
#           the credential copies it holds are the ones stored here, and
#           whether what provisioned it is still what this tree says.
#           A machine that does not answer is reported as unreachable, never as
#           broken. Also reads every bridge phone's battery charge cap and, on a
#           Mac with a battery, the `pmset -g batt` line -- macOS has no
#           settable limit to check.
#
#   --probe-store   the store's key=value facts alone, for the host that asks
#                   the podman VM to run this where the store is
#
#   0  everything checkable is provisioned
#   1  something is missing (the lines say what and how)

import os
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk.act import info, log, warn  # noqa: E402
from wk.doctor import Doctor, Report  # noqa: E402


def main(argv):
    doc = Doctor(ROOT)
    if "--probe-store" in argv:
        sys.stdout.write(doc.probe_store())
        return 0
    info("wk doctor on %s (%s)" % ("macos" if doc.macos else "linux", doc.hostname()))
    rep = Report(sys.stderr)
    for title, rows in doc.sections("--all" in argv):
        rep.section(title)
        rep.rows(rows)
    sys.stderr.write("\n")
    if not rep.missing:
        info("everything checkable is provisioned")
        return rep.exit_status()
    warn("%d item(s) missing -- each line above names its fix; the order that" % rep.missing)
    log("works from bare metal: ./setup -> the interactive stages it lists ->")
    log("gh auth login -> claude setup-token and claude auth login -> wk key setup")
    log("-> wk sync -> (optional) wk pi setup, wk vm base. See README.md.")
    return rep.exit_status()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
