#!/usr/bin/env bash
#
# wk test <workspace> [flags] [paths...] -- run the JSC or layout test suites
# wk: where=workspace name=required ready=yes group=workspaces
#
# The same reportability as `wk build`: a watchdog that detects a silent run, a
# status file `wk status` can read, and a summary instead of raw output. --lldb
# turns all of that off and debugs one layout test instead.
#
# Layout tests default to software rendering: there is no GPU inside the
# workspace on macOS (the podman VM has no /dev/dri to pass through). On Linux
# with a real seat, pass --gpu.
#
#   --config <config>   the build config to test (default: last built, or
#                        default_config); `wk build --list` lists every name
#   --layout             run the layout-test suite instead of the JSC suite
#   --gpu                use the real GPU for layout tests (Linux only)
#   --lldb [web|ui]      debug one layout test: "web" (default) attaches to the
#                        web process, "ui" to WebKitTestRunner
#   --dry-run            print the resolved run and stop

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/arch.sh"
. "$WK_ROOT/build/configs.sh"

NAME="${WK_NAME:-}"
require_name "$NAME"

CONFIG="${WK_CONFIG:-}"
SUITE=jsc
GPU=""
DRY=""
LLDB=""
while [ $# -gt 0 ]; do
    case "$1" in
        --config)  CONFIG="${2:-}"; shift 2 ;;
        --layout)  SUITE=layout; shift ;;
        --gpu)     GPU=1; shift ;;
        # Consumed here, or the test path below would swallow "ui"/"web".
        --lldb)    LLDB=web
                   case "${2:-}" in ui|web) LLDB="$2"; shift ;; esac
                   shift ;;
        --dry-run) DRY=1; shift ;;
        --)        shift; break ;;
        -*)        die "usage: wk test <workspace> [--config <c>] [--layout] [--gpu]
    [--lldb [web|ui]] [--dry-run] [--] [paths...]; see wk test -h" ;;
        *)         break ;;
    esac
done

if [ -z "$CONFIG" ]; then
    CONFIG=$(last_built_config "$NAME")
    if [ -n "$CONFIG" ]; then
        info "config: $CONFIG -- what '$NAME' was last built with"
    else
        CONFIG=$(default_config)
    fi
fi

# The target first: on macOS a config does not choose its own build system, so config_load needs t_os.
TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

config_load "$CONFIG" "$(t_os)" || die "unknown config '$CONFIG' (wk build --list)"

# Asked of the config, not of CFG_PORT: on macOS a jsc-* config is an Apple-port build with no port flag.
if [ "$SUITE" = layout ] && config_jsc_only; then
    die "'$CONFIG' builds JavaScriptCore alone, which has no layout tests -- no
    WebKitTestRunner and no ImageDiff are built by it. Name a full-port config
    that has been built in '$NAME':
        wk test $NAME --layout --config gtk-release-asan
    ('wk status $NAME' says what it was last built with; 'wk build --list' has
    the configs.)"
fi

if [ -n "$DRY" ]; then
    WS_STATE=$(ws_state "$NAME")
else
    WS_STATE=present
fi

lower=$(echo "$CFG_TYPE" | tr '[:upper:]' '[:lower:]')
SRC=$(t_src "$NAME")

# The same personality wrapper the build ran under: without it `uname -m` in an armhf container answers aarch64.
ARCH=$(t_arch "$NAME")
WRAP=$(arch_wrapper "$ARCH")
export_target_resources "$NAME"
POLITE=""
[ "$WK_TARGET_KIND" = remote ] && POLITE=1
JOBS=$(build_jobs "$POLITE")
build_admit "this test run" "$JOBS"
build_record "wk test $NAME" "$JOBS" "$(( JOBS * WK_MB_PER_JOB ))" "pid:$$"

if [ "$CFG_BUILDSYS" = xcode ]; then
    RENDER_ENV=""
    RENDER_DESC="the guest's GPU"
    [ -n "$GPU" ] && warn "--gpu has no meaning for an Apple port; ignoring"
elif [ -n "$GPU" ]; then
    RENDER_ENV=""
    RENDER_DESC=GPU
    info "using the real GPU (requires /dev/dri in the workspace)"
    # /dev/dri being there is not the whole story: a BMC or software seat's display path is not the GPU's.
    session_mode_warn || true
else
    RENDER_ENV="LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe WEBKIT_DISABLE_DMABUF_RENDERER=1"
    RENDER_DESC="software rendering"
fi

if [ "$SUITE" = layout ] && [ $# -gt 0 ] && [ -z "$DRY" ]; then
    _missing=$(t_exec "$NAME" sh -c "$(
        printf 'for t in %s; do\n' "$(sh_quote "$@")"
        printf '  p=${t%%%%\\?*}\n'
        printf '  [ -e %s/LayoutTests/"$p" ] || [ -e %s/"$p" ] || printf "%%s\\n" "$t"\n' \
               "$(sh_quote "$SRC")" "$(sh_quote "$SRC")"
        printf 'done\n'
    )" 2>/dev/null | tr -d '\r') || _missing=""
    [ -z "$_missing" ] || die "no such test in '$NAME':
$(printf '%s\n' "$_missing" | sed 's/^/      /')
    A path run-webkit-tests cannot find is not a failure to it -- it runs
    nothing and exits 0. Paths are relative to LayoutTests/ (or to the
    checkout): 'wk enter $NAME', then look under $SRC/LayoutTests."
    unset _missing
fi

if [ -n "$LLDB" ]; then
    [ "$SUITE" = layout ] || die "--lldb debugs a layout test; for jsc use 'wk run --lldb'"
    case "$LLDB" in
        web) ATTACH=$(config_web_process_name) ;;
        ui)  ATTACH=$(config_test_runner_name) ;;
    esac
    [ -n "$ATTACH" ] || die "'$CONFIG' builds no layout-test binaries to debug -- use a wpe-*, gtk-* or mac-* config"
    [ $# -gt 0 ] || die "--lldb needs a test to debug, e.g. fast/dom/Comment"
    JOBS=1  # one driver, so exactly one process of either kind to catch
fi

# mac-release-asan builds into Release-asan/, and only WEBKIT_OUTPUTDIR tells webkitdirs so.
OUT_ENV=""
[ "$CFG_BUILDSYS" = xcode ] && OUT_ENV="WEBKIT_OUTPUTDIR=$(config_build_dir "$SRC")"

case "$SUITE" in
jsc)
    info "JSC tests ($CONFIG, -j$JOBS)"
    CMD="cd $SRC && $OUT_ENV $WRAP nice -n 10 Tools/Scripts/run-javascriptcore-tests \
         --$lower $CFG_PORT --no-build --no-fail-fast --memory-limited $(sh_quote "$@")"
    ;;
layout)
    info "layout tests ($CONFIG, $RENDER_DESC, $JOBS processes)"
    # --no-timeout: the runner's own 30s per-test timeout cannot tell a process stopped at a breakpoint from one that hung.
    DEBUG_FLAGS=""
    [ -n "$LLDB" ] && DEBUG_FLAGS="--no-timeout"
    [ "$LLDB" = web ] && DEBUG_FLAGS="$DEBUG_FLAGS --additional-env-var=$(config_web_process_pause_env)"
    CMD="cd $SRC && $OUT_ENV $RENDER_ENV $WRAP nice -n 10 Tools/Scripts/run-webkit-tests \
         --$lower $CFG_PORT --no-build --no-retry-failures \
         --child-processes=$JOBS $DEBUG_FLAGS $(sh_quote "$@")"
    ;;
*) die "unknown suite: $SUITE" ;;
esac

if [ -n "$DRY" ]; then
    log "dry run -- nothing was run."
    ARCH_LABEL=$(arch_label "$ARCH")
    log "  workspace: $NAME ($TARGET, $WS_STATE${ARCH_LABEL:+, $ARCH_LABEL})"
    log "  suite:     $SUITE ($CONFIG)"
    log "  would run: bash -lc $(sh_quote "$CMD")"
    [ -n "$LLDB" ] && log "  in front of: lldb $(lldb_pin_opts) -o 'process attach --name $ATTACH --waitfor'"
    exit 0
fi

t_sync_tools "$NAME"

# The watchdog kills a silent job after WK_ABORT_SECONDS, and a process at a breakpoint is silent by definition.
if [ -n "$LLDB" ]; then
    info "debugging $* ($CONFIG) in '$NAME', lldb waiting for $ATTACH"
    log  "  it attaches as that process starts; 'continue' runs the test"
    log  "  test output: /tmp/wk-test-lldb.log (in the workspace)"
    t_exec_tty "$NAME" bash -lc "$(lldb_prelude)
( sleep 2; $CMD >/tmp/wk-test-lldb.log 2>&1 ) & \
        exec \"\$LLDB\" $(lldb_pin_opts) -o $(sh_quote "process attach --name $ATTACH --waitfor")"
    exit 0
fi

WS=$(wk_ws_dir "$NAME")
LOG="$WS/test.log"
STATUS="$WS/test.status"
STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
START_EPOCH=$(date +%s)

printf 'state=running\nsuite=%s\nconfig=%s\nstarted=%s\nlog=%s\n' \
    "$SUITE" "$CONFIG" "$STARTED" "$LOG" > "$STATUS"

write_status() {
    cat > "$STATUS" <<EOF
state=$1
suite=$SUITE
config=$CONFIG
exit=${2:-}
started=$STARTED
finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)
seconds=$(( $(date +%s) - START_EPOCH ))
log=$LOG
EOF
}

log "  log: $LOG"

set +e
run_watched "$LOG" -- t_exec "$NAME" bash -lc "$CMD"
rc=$?
set -e

ELAPSED=$(( $(date +%s) - START_EPOCH ))
MINS=$(( ELAPSED / 60 )); SECS=$(( ELAPSED % 60 ))

# `|| true` is load-bearing: grep exits 1 on no match, which would abort under `set -e` and leave the status file at "running".
summary=$(tr '\r' '\n' < "$LOG" | grep -iE '^(Ran |Test suite|[0-9]+ test|All [0-9]+ test)' | tail -4 || true)

echo >&2
case $rc in
0)
    write_status ok 0
    info "TESTS OK  $SUITE/$CONFIG in '$NAME'  (${MINS}m${SECS}s)"
    [ -n "$summary" ] && printf '%s\n' "$summary" | sed 's/^/  /' >&2
    ;;
124)
    write_status stalled 124
    die "TESTS STALLED  $SUITE/$CONFIG in '$NAME' (killed after ${MINS}m${SECS}s with no output)
    log: $LOG"
    ;;
*)
    write_status failed "$rc"
    warn "TESTS FAILED  $SUITE/$CONFIG in '$NAME'  (exit $rc after ${MINS}m${SECS}s)"
    [ -n "$summary" ] && printf '%s\n' "$summary" | sed 's/^/  /' >&2
    log "failures:"
    tr '\r' '\n' < "$LOG" | grep -iE 'FAIL|crash|timed out' | head -10 | sed 's/^/  /' || true
    log "  full log: $LOG"
    exit "$rc"
    ;;
esac
