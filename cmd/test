#!/usr/bin/env bash
#
# wk test <workspace> [--layout] [--config C] [paths...]
#
# Runs the JSC or layout test suites with the same reportability as `wk build`:
# a watchdog that detects a silent run rather than waiting on it, a status file
# `wk status` can read, and a summary that says what happened instead of leaving
# a few hundred KB of output to interpret.
#
# Layout tests default to software rendering. There is no GPU inside the
# workspace on macOS -- the podman VM has no /dev/dri to pass through -- so
# without llvmpipe the runner either fails to start or silently produces
# garbage. On Linux with a real seat, pass --gpu to use the real device.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/build/configs.sh"

# Inside a workspace the name is implicit -- see cmd/build. A test path is never
# a valid workspace name, so treating anything but this workspace's own name as
# the first real argument is unambiguous.
NAME="${1:-}"
if in_workspace && [ "$NAME" != "$(wk_self)" ]; then
    NAME=$(wk_self)
else
    shift || true
fi
require_name "$NAME"

CONFIG="${WK_CONFIG:-jsc-release}"
SUITE=jsc
GPU=""
while [ $# -gt 0 ]; do
    case "$1" in
        --config) CONFIG="${2:-}"; shift 2 ;;
        --layout) SUITE=layout; shift ;;
        --gpu)    GPU=1; shift ;;
        --)       shift; break ;;
        *)        break ;;
    esac
done

config_load "$CONFIG" || die "unknown config '$CONFIG' (wk build --list)"

TARGET="${WK_TARGET:-$(target_of "$NAME" 2>/dev/null || default_target)}"
load_target "$TARGET"
[ "$(t_info "$NAME")" != absent ] || die "no such workspace: $NAME"

lower=$(echo "$CFG_TYPE" | tr '[:upper:]' '[:lower:]')
SRC=$(t_src "$NAME")
if [ "$TARGET" != remote ]; then
    WK_CGROUP_MB=$(t_mem_mb "$NAME"); WK_CGROUP_CORES=$(t_cores "$NAME")
    export WK_CGROUP_MB WK_CGROUP_CORES
fi
JOBS=$(build_jobs)

# Before the status file, so a failure here cannot leave state=running behind.
t_sync_tools "$NAME"

WS=$(wk_ws_dir "$NAME")
LOG="$WS/test.log"
STATUS="$WS/test.status"
STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
START_EPOCH=$(date +%s)

# Software rendering. llvmpipe via Mesa's software gallium driver, and the WPE
# headless backend so no compositor is needed.
#
# None of it applies to the Apple ports: these are Mesa and WPE variables, and
# a macOS guest renders through Virtualization.framework's paravirtualised GPU
# whether you want it to or not. Setting them there would be cargo cult.
if [ "$CFG_BUILDSYS" = xcode ]; then
    RENDER_ENV=""
    [ -n "$GPU" ] && warn "--gpu has no meaning for an Apple port; ignoring"
elif [ -n "$GPU" ]; then
    RENDER_ENV=""
    info "using the real GPU (requires /dev/dri in the workspace)"
    # /dev/dri being there is not the whole story: if the seat is a BMC or
    # software session, the display path is not the GPU's and nothing further
    # down would mention it.
    session_mode_warn || true
else
    RENDER_ENV="LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe WEBKIT_DISABLE_DMABUF_RENDERER=1"
fi

# The Apple configs no longer live where a bare run-webkit-tests would look for
# them: mac-release-asan builds into Release-asan/, and only WEBKIT_OUTPUTDIR
# tells webkitdirs so. Without this the runner resolves the *non*-sanitized
# tree and tests mac-release while reporting mac-release-asan -- a green run
# for a binary nobody asked about. Same answer config_build_env() gives the
# build, from the same function, so the two cannot disagree.
OUT_ENV=""
[ "$CFG_BUILDSYS" = xcode ] && OUT_ENV="WEBKIT_OUTPUTDIR=$(config_build_dir "$SRC")"

printf 'state=running\nsuite=%s\nconfig=%s\nstarted=%s\nlog=%s\n' \
    "$SUITE" "$CONFIG" "$STARTED" "$LOG" > "$STATUS"

write_status() {
    cat > "$STATUS" <<EOF
state=$1
suite=$SUITE
config=$CONFIG
exit=${2:-}
started=$STARTED
finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)
seconds=$(( $(date +%s) - START_EPOCH ))
log=$LOG
EOF
}

case "$SUITE" in
jsc)
    info "JSC tests ($CONFIG, -j$JOBS)"
    CMD="cd $SRC && $OUT_ENV nice -n 10 Tools/Scripts/run-javascriptcore-tests \
         --$lower $CFG_PORT --no-build --no-fail-fast --memory-limited $(sh_quote "$@")"
    ;;
layout)
    info "layout tests ($CONFIG, ${GPU:+GPU}${GPU:-software rendering}, $JOBS processes)"
    # --no-retry-failures: a retry doubles the runtime and hides flakiness,
    # which is the opposite of what an automated check wants.
    CMD="cd $SRC && $OUT_ENV $RENDER_ENV nice -n 10 Tools/Scripts/run-webkit-tests \
         --$lower $CFG_PORT --no-build --no-retry-failures \
         --child-processes=$JOBS $(sh_quote "$@")"
    ;;
*) die "unknown suite: $SUITE" ;;
esac

log "  log: $LOG"

set +e
run_watched "$LOG" -- t_exec "$NAME" bash -lc "$CMD"
rc=$?
set -e

ELAPSED=$(( $(date +%s) - START_EPOCH ))
MINS=$(( ELAPSED / 60 )); SECS=$(( ELAPSED % 60 ))

# run-webkit-tests reports its own totals; surface them rather than a raw tail.
# `|| true` is load-bearing: grep exits 1 when it matches nothing, and under
# `set -e` a failing command substitution aborts the script -- which silently
# skipped the verdict and left the status file saying "running" forever.
summary=$(tr '\r' '\n' < "$LOG" | grep -iE '^(Ran |Test suite|[0-9]+ test|All [0-9]+ test)' | tail -4 || true)

echo >&2
case $rc in
0)
    write_status ok 0
    info "TESTS OK  $SUITE/$CONFIG in '$NAME'  (${MINS}m${SECS}s)"
    [ -n "$summary" ] && printf '%s\n' "$summary" | sed 's/^/  /' >&2
    ;;
124)
    write_status stalled 124
    die "TESTS STALLED  $SUITE/$CONFIG in '$NAME' (killed after ${MINS}m${SECS}s with no output)
    log: $LOG"
    ;;
*)
    write_status failed "$rc"
    warn "TESTS FAILED  $SUITE/$CONFIG in '$NAME'  (exit $rc after ${MINS}m${SECS}s)"
    [ -n "$summary" ] && printf '%s\n' "$summary" | sed 's/^/  /' >&2
    log "failures:"
    tr '\r' '\n' < "$LOG" | grep -iE 'FAIL|crash|timed out' | head -10 | sed 's/^/  /' || true
    log "  full log: $LOG"
    exit "$rc"
    ;;
esac
