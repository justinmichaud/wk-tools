"""run the JSC or layout test suites, or profile a run

Like `wk build`: a watchdog for a silent run, a record `wk status` reads, and a summary instead of raw output. Layout
tests use software rendering unless --gpu. --profile takes every mode and flag `wk run --profile` takes (wk run -h).
"""
from wk import profile, store, testcmd
from wk.decl import Command, Opt

COMMAND = Command(name="required", takes=("[<path>...]",), ready=True, preset="--preset", repos=("webkit",), tail="--",
                  group="workspaces", opts=(
    Opt("--preset", "the build preset to test (default: the last build's, else the platform's; the list is below)",
        value="<preset>"),
    Opt("--layout", "run the layout-test suite instead of the JSC suite"),
    Opt("--gpu", "use the real GPU for layout tests (Linux only)"),
    Opt("--lldb", "debug one layout test: a first path of web (the default) attaches to the web process, ui to "
        "WebKitTestRunner"),
    Opt("--kill", "stop the test run in this workspace, wherever it runs"),
    *profile.OPTS))


def parse(args):
    paths = list(args.positionals)
    lldb = args.flag("--lldb") and (paths.pop(0) if paths and paths[0] in ("ui", "web") else "web")
    return {"suite": "layout" if args.flag("--layout") else "jsc", "gpu": args.flag("--gpu"),
            "kill": args.flag("--kill"), "lldb": lldb, "pass": paths + args.tail}


def main(args, inv, reg=None, clock=None):
    profile.refuse_mixed(args, ("--layout", "--gpu", "--lldb", "--kill"))
    if profile.asked(args):
        return profile.main(args, "test", reg)
    return testcmd.main(store.ws_name(), parse(args), reg, clock)
