#!/usr/bin/env bash
#
# wk test <workspace> [--layout] [--config C] [--lldb [web|ui]] [paths...]
#
# Runs the JSC or layout test suites with the same reportability as `wk build`:
# a watchdog that detects a silent run rather than waiting on it, a status file
# `wk status` can read, and a summary that says what happened instead of leaving
# a few hundred KB of output to interpret.
#
# --lldb turns all of that off and debugs one layout test instead: see
# "debugging one test" below for why a debug run cannot share any of it.
#
# Layout tests default to software rendering. There is no GPU inside the
# workspace on macOS -- the podman VM has no /dev/dri to pass through -- so
# without llvmpipe the runner either fails to start or silently produces
# garbage. On Linux with a real seat, pass --gpu to use the real device.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/arch.sh"
. "$WK_ROOT/build/configs.sh"

# Inside a workspace there is no name to give: every command acts on this one,
# and the name form is refused rather than quietly accepted (refuse_ws_name,
# lib/target.sh). Everything else on the command line is this command's own
# argument, including the very first word.
NAME="${1:-}"
if in_workspace; then
    refuse_ws_name "$NAME" test "[--layout <test>]"
    NAME=$(wk_self)
else
    shift || true
fi
require_name "$NAME"

# Resolved after the options, so the workspace's own history can answer when
# nothing on the command line does (below).
CONFIG="${WK_CONFIG:-}"
SUITE=jsc
GPU=""
DRY=""
LLDB=""
while [ $# -gt 0 ]; do
    case "$1" in
        --config)  CONFIG="${2:-}"; shift 2 ;;
        --layout)  SUITE=layout; shift ;;
        --gpu)     GPU=1; shift ;;
        # Debug one test rather than report on many -- see "a debug run is a
        # different run" below. `--lldb ui` takes its mode as a separate word,
        # so it has to be consumed here or the test path would swallow it.
        --lldb)    LLDB=web
                   case "${2:-}" in ui|web) LLDB="$2"; shift ;; esac
                   shift ;;
        # Print the resolved run and stop, for the same reason `wk build` has it:
        # a suite takes long enough that "did it resolve the right tree" needs
        # an answer that is not a full run.
        --dry-run) DRY=1; shift ;;
        --)        shift; break ;;
        *)         break ;;
    esac
done

# What to test, when nobody said: the config this workspace was last built
# with, and only then the fallback default. Without this a bare
# `wk test <ws> --layout` resolved jsc-release -> `--jsc-only`, and pointed
# run-webkit-tests at a tree that contains neither WebKitTestRunner nor
# ImageDiff -- a port with no layout tests in it at all.
if [ -z "$CONFIG" ]; then
    CONFIG=$(last_built_config "$NAME")
    if [ -n "$CONFIG" ]; then
        info "config: $CONFIG -- what '$NAME' was last built with"
    else
        CONFIG=$(default_config)
    fi
fi

config_load "$CONFIG" || die "unknown config '$CONFIG' (wk build --list)"

# A JSCOnly build has no layout tests, and saying so beats letting
# run-webkit-tests discover it: the port builds jsc and the JSC test harness
# and nothing else, so there is no driver to run a page in and no ImageDiff to
# compare one with.
if [ "$SUITE" = layout ] && [ "$CFG_PORT" = --jsc-only ]; then
    die "'$CONFIG' is a JSCOnly build, which has no layout tests -- no
    WebKitTestRunner and no ImageDiff are built by it. Name a full-port config
    that has been built in '$NAME':
        wk test $NAME --layout --config gtk-release-asan
    ('wk status $NAME' says what it was last built with; 'wk build --list' has
    the configs.)"
fi

TARGET="$(ws_target "$NAME")"
load_target "$TARGET"
# One gate for "is this workspace usable yet" (wait_ready, lib/target.sh):
# `absent` is still refused by name, and everything else -- a creation still
# running, one whose driver died, an environment removed from under the record,
# a machine that will not answer -- gets the words that fit it there rather
# than "no such workspace", which is what this said about all four.
#
# Not for a dry run: that resolves and prints, and printing must not wait for a
# workspace that is still being made. It reports the state it saw instead.
if [ -n "$DRY" ]; then
    WS_STATE=$(ws_state "$NAME")
    [ "$WS_STATE" != absent ] || die "no such workspace: $NAME"
else
    wait_ready "$NAME"
    WS_STATE=present
fi

lower=$(echo "$CFG_TYPE" | tr '[:upper:]' '[:lower:]')
SRC=$(t_src "$NAME")

# The same personality wrapper the build ran under, and for a sharper reason
# here: the test scripts ask the machine what architecture it is. `uname -m` in
# an armhf container answers with the host's aarch64, webkitdirs turns that into
# arm64 (it reads CMAKE_SYSTEM_PROCESSOR out of `cmake --system-information`,
# which is the host's), and run-javascriptcore-tests passes the answer to
# run-jsc-stress-tests as --arch. That would select 64-bit expectations for a
# 32-bit binary -- FTL and SIMD platform checks, 36-bit address-space
# assumptions -- and report the results as if they were meant.
ARCH=$(t_arch "$NAME")
WRAP=$(arch_wrapper "$ARCH")
if [ "$WK_TARGET_KIND" = remote ]; then
    # Another machine entirely: its numbers replace this one's rather than
    # capping them, exactly as in cmd/build.
    WK_AVAIL_MB=$(t_mem_mb "$NAME"); WK_CGROUP_CORES=$(t_cores "$NAME")
    WK_LOAD=$(t_load "$NAME")
    export WK_AVAIL_MB WK_CGROUP_CORES WK_LOAD
else
    WK_CGROUP_MB=$(t_mem_mb "$NAME"); WK_CGROUP_CORES=$(t_cores "$NAME")
    export WK_CGROUP_MB WK_CGROUP_CORES
fi
POLITE=""
[ "$WK_TARGET_KIND" = remote ] && POLITE=1
JOBS=$(build_jobs "$POLITE")

# Software rendering. llvmpipe via Mesa's software gallium driver, and the WPE
# headless backend so no compositor is needed.
#
# None of it applies to the Apple ports: these are Mesa and WPE variables, and
# a macOS guest renders through Virtualization.framework's paravirtualised GPU
# whether you want it to or not. Setting them there would be cargo cult.
if [ "$CFG_BUILDSYS" = xcode ]; then
    RENDER_ENV=""
    RENDER_DESC="the guest's GPU"
    [ -n "$GPU" ] && warn "--gpu has no meaning for an Apple port; ignoring"
elif [ -n "$GPU" ]; then
    RENDER_ENV=""
    RENDER_DESC=GPU
    info "using the real GPU (requires /dev/dri in the workspace)"
    # /dev/dri being there is not the whole story: if the seat is a BMC or
    # software session, the display path is not the GPU's and nothing further
    # down would mention it.
    session_mode_warn || true
else
    RENDER_ENV="LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe WEBKIT_DISABLE_DMABUF_RENDERER=1"
    RENDER_DESC="software rendering"
fi

# --lldb is a layout-test flow: the JSC suite runs a shell, and `wk run --lldb`
# already debugs that. It also needs a process to wait for by name, which
# build/configs.sh answers per port -- and which a jsc-only config has no answer
# to, because it builds neither of these binaries.
#
#   --lldb, --lldb web   the web process the test runs in -- its JS, its layout,
#                        its rendering, and so nearly always the right one
#   --lldb ui            WebKitTestRunner itself, for the driver side: the
#                        protocol, the injected bundle, process launching
if [ -n "$LLDB" ]; then
    [ "$SUITE" = layout ] || die "--lldb debugs a layout test; for jsc use 'wk run --lldb'"
    case "$LLDB" in
        web) ATTACH=$(config_web_process_name) ;;
        ui)  ATTACH=$(config_test_runner_name) ;;
    esac
    [ -n "$ATTACH" ] || die "'$CONFIG' builds no layout-test binaries to debug -- use a wpe-*, gtk-* or mac-* config"
    [ $# -gt 0 ] || die "--lldb needs a test to debug, e.g. fast/dom/Element/id-attribute.html"
    # One driver, so there is exactly one process of either kind to catch.
    JOBS=1

    # Check the test exists before handing the terminal to a debugger. A
    # mistyped path is not an error the debug flow can report: the run behind
    # lldb fails in a log nobody is looking at, while lldb waits for a process
    # that will now never start -- so the whole thing reads as a hang.
    for _t in "$@"; do
        t_exec "$NAME" test -e "$SRC/LayoutTests/${_t%%\?*}" -o -e "$SRC/${_t%%\?*}" 2>/dev/null \
            || die "no such test in $NAME: $_t"
    done
    unset _t
fi

# The Apple configs no longer live where a bare run-webkit-tests would look for
# them: mac-release-asan builds into Release-asan/, and only WEBKIT_OUTPUTDIR
# tells webkitdirs so. Without this the runner resolves the *non*-sanitized
# tree and tests mac-release while reporting mac-release-asan -- a green run
# for a binary nobody asked about. Same answer config_build_env() gives the
# build, from the same function, so the two cannot disagree.
OUT_ENV=""
[ "$CFG_BUILDSYS" = xcode ] && OUT_ENV="WEBKIT_OUTPUTDIR=$(config_build_dir "$SRC")"

case "$SUITE" in
jsc)
    info "JSC tests ($CONFIG, -j$JOBS)"
    CMD="cd $SRC && $OUT_ENV $WRAP nice -n 10 Tools/Scripts/run-javascriptcore-tests \
         --$lower $CFG_PORT --no-build --no-fail-fast --memory-limited $(sh_quote "$@")"
    ;;
layout)
    info "layout tests ($CONFIG, $RENDER_DESC, $JOBS processes)"
    # A debug run is a different run, not the same run with a flag on it:
    #
    #   --no-timeout       the runner's own per-test timeout is 30 s, and a
    #                      process stopped at a breakpoint is indistinguishable
    #                      from one that hung -- it kills the driver mid-session
    #   --additional-env-var  the pause that gives lldb time to attach; it has
    #                      to reach the web process, which is a child of the
    #                      driver rather than of this shell
    #
    # --no-retry-failures: a retry doubles the runtime and hides flakiness,
    # which is the opposite of what an automated check wants.
    DEBUG_FLAGS=""
    [ -n "$LLDB" ] && DEBUG_FLAGS="--no-timeout"
    # The pause is the web process's own, and only that process reads it.
    [ "$LLDB" = web ] && DEBUG_FLAGS="$DEBUG_FLAGS --additional-env-var=$(config_web_process_pause_env)"
    CMD="cd $SRC && $OUT_ENV $RENDER_ENV $WRAP nice -n 10 Tools/Scripts/run-webkit-tests \
         --$lower $CFG_PORT --no-build --no-retry-failures \
         --child-processes=$JOBS $DEBUG_FLAGS $(sh_quote "$@")"
    ;;
*) die "unknown suite: $SUITE" ;;
esac

if [ -n "$DRY" ]; then
    log "dry run -- nothing was run."
    ARCH_LABEL=$(arch_label "$ARCH")
    log "  workspace: $NAME ($TARGET, $WS_STATE${ARCH_LABEL:+, $ARCH_LABEL})"
    log "  suite:     $SUITE ($CONFIG)"
    log "  would run: bash -lc $(sh_quote "$CMD")"
    # The debugger is the foreground half of a debug run and the run itself is
    # the background half; a dry run that showed only the second would describe
    # a command nobody is about to issue.
    [ -n "$LLDB" ] && log "  in front of: lldb $(lldb_pin_opts) -o 'process attach --name $ATTACH --waitfor'"
    exit 0
fi

# Everything from here changes something, which is why the dry run stops above.
# The tooling sync stays ahead of the status file, so a failure in it cannot
# leave state=running behind.
t_sync_tools "$NAME"

# --- debugging one test ------------------------------------------------------
# Everything below this point -- watchdog, status file, failure summary --
# exists to make an unattended run *reportable*, and all of it is wrong here.
# The watchdog kills the job after WK_ABORT_SECONDS (1800) of silence, and a
# process sitting at a breakpoint is silent by definition, so it would end a
# debugging session with "TESTS STALLED"; the status file would then record a
# verdict about a run nobody asked for a verdict on.
#
# The shape is the same as `wk gui --lldb web`: lldb goes first and waits, the
# run starts behind it, and the attach lands as the web process is created.
# Anything else races -- by the time a run has printed enough for a human to
# type an attach command, the process to attach to has come and gone.
if [ -n "$LLDB" ]; then
    info "debugging $* ($CONFIG) in '$NAME', lldb waiting for $ATTACH"
    log  "  it attaches as that process starts; 'continue' runs the test"
    log  "  test output: /tmp/wk-test-lldb.log (in the workspace)"
    t_exec_tty "$NAME" bash -lc "$(lldb_prelude)
( sleep 2; $CMD >/tmp/wk-test-lldb.log 2>&1 ) & \
        exec \"\$LLDB\" $(lldb_pin_opts) -o $(sh_quote "process attach --name $ATTACH --waitfor")"
    exit 0
fi

WS=$(wk_ws_dir "$NAME")
LOG="$WS/test.log"
STATUS="$WS/test.status"
STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
START_EPOCH=$(date +%s)

printf 'state=running\nsuite=%s\nconfig=%s\nstarted=%s\nlog=%s\n' \
    "$SUITE" "$CONFIG" "$STARTED" "$LOG" > "$STATUS"

write_status() {
    cat > "$STATUS" <<EOF
state=$1
suite=$SUITE
config=$CONFIG
exit=${2:-}
started=$STARTED
finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)
seconds=$(( $(date +%s) - START_EPOCH ))
log=$LOG
EOF
}

log "  log: $LOG"

set +e
run_watched "$LOG" -- t_exec "$NAME" bash -lc "$CMD"
rc=$?
set -e

ELAPSED=$(( $(date +%s) - START_EPOCH ))
MINS=$(( ELAPSED / 60 )); SECS=$(( ELAPSED % 60 ))

# run-webkit-tests reports its own totals; surface them rather than a raw tail.
# `|| true` is load-bearing: grep exits 1 when it matches nothing, and under
# `set -e` a failing command substitution aborts the script -- which silently
# skipped the verdict and left the status file saying "running" forever.
summary=$(tr '\r' '\n' < "$LOG" | grep -iE '^(Ran |Test suite|[0-9]+ test|All [0-9]+ test)' | tail -4 || true)

echo >&2
case $rc in
0)
    write_status ok 0
    info "TESTS OK  $SUITE/$CONFIG in '$NAME'  (${MINS}m${SECS}s)"
    [ -n "$summary" ] && printf '%s\n' "$summary" | sed 's/^/  /' >&2
    ;;
124)
    write_status stalled 124
    die "TESTS STALLED  $SUITE/$CONFIG in '$NAME' (killed after ${MINS}m${SECS}s with no output)
    log: $LOG"
    ;;
*)
    write_status failed "$rc"
    warn "TESTS FAILED  $SUITE/$CONFIG in '$NAME'  (exit $rc after ${MINS}m${SECS}s)"
    [ -n "$summary" ] && printf '%s\n' "$summary" | sed 's/^/  /' >&2
    log "failures:"
    tr '\r' '\n' < "$LOG" | grep -iE 'FAIL|crash|timed out' | head -10 | sed 's/^/  /' || true
    log "  full log: $LOG"
    exit "$rc"
    ;;
esac
