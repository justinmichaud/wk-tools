#!/usr/bin/env python3
#
# wk test <workspace> [flags] [paths...] -- run the JSC or layout test suites
# wk: where=workspace name=required ready=yes group=workspaces takes=* passthrough dryrun
# wk: opts --config=,--layout,--gpu,--lldb,--kill
#
# The same reportability as `wk build`: a watchdog that detects a silent run, a
# status file `wk status` can read, and a summary instead of raw output. --lldb
# turns all of that off and debugs one layout test instead.
#
# Layout tests default to software rendering: there is no GPU inside the
# workspace on macOS (the podman VM has no /dev/dri to pass through). On Linux
# with a real seat, pass --gpu.
#
#   --config <config>   the build config to test (default: the last build's,
#                        else the platform's); `wk build --list` lists every name
#   --layout             run the layout-test suite instead of the JSC suite
#   --gpu                use the real GPU for layout tests (Linux only)
#   --lldb [web|ui]      debug one layout test: "web" (default) attaches to the
#                        web process, "ui" to WebKitTestRunner
#   --kill               stop the test run in this workspace, wherever it runs

import os
import re
import shlex
import subprocess
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import buildconf, decl, job, record, shell, targets  # noqa: E402
from wk.act import Refused, die, dry_run, info, log, warn  # noqa: E402
from wk.build import records_of, size_for  # noqa: E402
from wk.clock import Clock  # noqa: E402

# The suite runner, in the announcing shell's own -lc text.
PID_MATCH = "*Tools/Scripts/run-*"
_SUMMARY = re.compile(r"^(Ran |Test suite|[0-9]+ test|All [0-9]+ test)", re.I | re.M)
_FAILURE = re.compile(r"FAIL|crash|timed out", re.I)


def parse(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    o = {"suite": "layout" if args.flag("--layout") else "jsc"}
    if args.value("--config") is not None:
        o["config"] = args.value("--config")
    if args.flag("--gpu"):
        o["gpu"] = True
    if args.flag("--kill"):
        o["kill"] = True
    paths = list(args.positionals)
    if args.flag("--lldb"):
        lldb = "web"
        if paths and paths[0] in ("ui", "web"):
            lldb = paths.pop(0)
        o["lldb"] = lldb
    o["pass"] = paths + args.tail
    return o


def missing_layout_paths(runner, src, paths):
    """Every `paths` entry (its `?query` stripped) run-webkit-tests would find neither
    under LayoutTests/ nor under the checkout -- one round trip, so a mistyped path is
    named before the suite starts rather than silently "0 tests, 0 run"."""
    if not paths:
        return []
    q_src = shlex.quote(src)
    script = ("for t in " + " ".join(shlex.quote(p) for p in paths) + "; do\n"
              "  p=${t%%\\?*}\n"
              '  [ -e ' + q_src + '/LayoutTests/"$p" ] || [ -e ' + q_src + '/"$p" ] || printf "%s\\n" "$t"\n'
              "done\n")
    r = runner(["sh", "-c", script])
    if not r.ok:
        return []
    return [l for l in r.out.replace("\r", "").splitlines() if l]


def size_and_admit(reg, target, name, cfg, clock):
    """`wk build`'s sizing: one machine's jobs and disk are spoken for the same way whether the job compiles or runs tests."""
    budget, running, jobs, mbpj, _ = size_for(reg, target, name, cfg, clock)
    store = reg.env.get("WK_STORE") or reg.env.get("HOME", "")
    budget.disk_admit("this test run", cfg.disk_gb, budget.free_gb(store), "%s's filesystem" % store)
    budget.admit("this test run", jobs, running)
    if not dry_run():
        budget.record("wk test %s" % name, jobs, jobs * mbpj, "pid:%d" % os.getpid())
    return jobs


def build_cmd(suite, src, out_env, render_env, wrap, lower, port, jobs, debug_flags, pass_args):
    tail = shlex.join(pass_args)
    if suite == "jsc":
        head = " ".join(x for x in (out_env, wrap, "nice -n 10 Tools/Scripts/run-javascriptcore-tests") if x)
        return ("cd %s && %s --%s %s --no-build --no-fail-fast --memory-limited %s"
                % (src, head, lower, port, tail)).rstrip()
    head = " ".join(x for x in (out_env, render_env, wrap, "nice -n 10 Tools/Scripts/run-webkit-tests") if x)
    return ("cd %s && %s --%s %s --no-build --no-retry-failures --child-processes=%d %s %s"
            % (src, head, lower, port, jobs, debug_flags, tail)).rstrip()


def main(argv, reg=None, clock=None, popen=None):
    name = os.environ.get("WK_NAME", "")
    opts = parse(argv)
    clock = clock or Clock()
    popen = popen or subprocess.Popen
    reg = reg or targets.Registry(ROOT)

    try:
        tname = reg.ws_target(name)
        target = reg.load(tname)
    except LookupError as e:
        die(str(e))
    recs = records_of(target, clock, reg.machine)

    kill_cmd = "wk test%s --kill" % ("" if reg.in_workspace() else " " + name)

    if opts.get("kill"):
        rc = job.stop(target, recs, name, "test", reg.machine, clock, reg.env)
        if rc == 1:
            die("the test run in '%s' outlived a TERM and a KILL.\n"
                "    Look at it:  wk enter %s  and then  pgrep -af run-" % (name, name))
        return 0

    config = opts.get("config") or os.environ.get("WK_CONFIG") or reg.default_config(name)
    try:
        cfg = buildconf.resolve(config, target.os(), target.kind, target.env)
    except LookupError:
        die("unknown config '%s' (wk build --list)" % config)

    # Asked of the config, not of cfg.port: on macOS a jsc-* config is an Apple-port build with no port flag.
    if opts["suite"] == "layout" and cfg.jsc_only:
        die("'%s' builds JavaScriptCore alone, which has no layout tests -- no\n"
            "    WebKitTestRunner and no ImageDiff are built by it. Name a full-port config\n"
            "    that has been built in '%s':\n"
            "        wk test %s --layout --config gtk-release-asan\n"
            "    ('wk status %s' says what it was last built with; 'wk build --list' has\n"
            "    the configs.)" % (config, name, name, name))

    ws_state = target.state(name) if dry_run() else "present"

    lower = cfg.type.lower()
    src = target.src(name)

    # The same personality wrapper the build ran under: without it `uname -m` in an armhf container answers aarch64.
    arch = target.arch(name)
    wrap = buildconf.ARCH.get(arch, {}).get("wrapper", "")
    jobs = size_and_admit(reg, target, name, cfg, clock)

    if cfg.buildsys == "xcode":
        render_env, render_desc = "", "the guest's GPU"
        if opts.get("gpu"):
            warn("--gpu has no meaning for an Apple port; ignoring")
    elif opts.get("gpu"):
        render_env, render_desc = "", "GPU"
        info("using the real GPU (requires /dev/dri in the workspace)")
        # /dev/dri being there is not the whole story: a BMC or software seat's display path is not the GPU's.
        shell.session_mode_warn(ROOT, env=reg.env)
    else:
        render_env = "LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe WEBKIT_DISABLE_DMABUF_RENDERER=1"
        render_desc = "software rendering"

    if opts["suite"] == "layout" and opts["pass"] and not dry_run():
        missing = missing_layout_paths(lambda argv: target.exec(name, argv), src, opts["pass"])
        if missing:
            die("no such test in '%s':\n%s\n"
                "    A path run-webkit-tests cannot find is not a failure to it -- it runs\n"
                "    nothing and exits 0. Paths are relative to LayoutTests/ (or to the\n"
                "    checkout): 'wk enter %s', then look under %s/LayoutTests."
                % (name, "\n".join("      " + m for m in missing), name, src))

    attach = ""
    if opts.get("lldb"):
        if opts["suite"] != "layout":
            die("--lldb debugs a layout test; for jsc use 'wk run --lldb'")
        attach = cfg.web_process_name() if opts["lldb"] == "web" else cfg.test_runner_name()
        if not attach:
            die("'%s' builds no layout-test binaries to debug -- use a wpe-*, gtk-* or mac-* config" % config)
        if not opts["pass"]:
            die("--lldb needs a test to debug, e.g. fast/dom/Comment")
        jobs = 1   # one driver, so exactly one process of either kind to catch

    # mac-release-asan builds into Release-asan/, and only WEBKIT_OUTPUTDIR tells webkitdirs so.
    out_env = "WEBKIT_OUTPUTDIR=%s" % cfg.build_dir(src) if cfg.buildsys == "xcode" else ""

    debug_flags = ""
    if opts["suite"] == "layout" and opts.get("lldb"):
        debug_flags = "--no-timeout"
        if opts["lldb"] == "web":
            debug_flags += " --additional-env-var=%s" % cfg.web_process_pause_env()

    if opts["suite"] == "jsc":
        info("JSC tests (%s, -j%d)" % (config, jobs))
    else:
        info("layout tests (%s, %s, %d processes)" % (config, render_desc, jobs))
    cmd = build_cmd(opts["suite"], src, out_env, render_env, wrap, lower, cfg.port, jobs, debug_flags, opts["pass"])

    if dry_run():
        log("dry run -- nothing was run.")
        arch_label = buildconf.arch_label(arch)
        log("  workspace: %s (%s, %s%s)" % (name, target.name, ws_state, ", " + arch_label if arch_label else ""))
        log("  suite:     %s (%s)" % (opts["suite"], config))
        log("  would run: bash -lc %s" % shlex.quote(cmd))
        if opts.get("lldb"):
            log("  in front of: lldb %s -o 'process attach --name %s --waitfor'" % (shell.LLDB_PIN_OPTS, attach))
        return 0

    if not target.sync_tools(name):
        die("pushing wk-tools into '%s' failed -- the reason is above" % name)

    # The watchdog kills a silent job after WK_ABORT_SECONDS, and a process at a breakpoint is silent by definition. The running record carries that deadline, so cmd/status can tell a quiet run from one whose watchdog is gone.
    if opts.get("lldb"):
        info("debugging %s (%s) in '%s', lldb waiting for %s" % (" ".join(opts["pass"]), config, name, attach))
        log("  it attaches as that process starts; 'continue' runs the test")
        log("  test output: /tmp/wk-test-lldb.log (in the workspace)")
        script = ("%s\n( sleep 2; %s >/tmp/wk-test-lldb.log 2>&1 ) &\nexec \"$LLDB\" %s -o %s"
                  % (shell.lldb_prelude(ROOT), cmd, shell.LLDB_PIN_OPTS,
                     shlex.quote("process attach --name %s --waitfor" % attach)))
        target.exec_tty(name, ["bash", "-lc", script])
        return 0

    ws_dir = target.store.ws_dir(name)
    log_path = os.path.join(ws_dir, "test.log")
    start = clock.now()

    task = recs.begin("test", "here", name, kill_cmd, log_path, ["%s/%s in %s" % (opts["suite"], config, name)])
    task.step(1)

    watcher = None
    rc = None
    with job.Signals():
        try:
            log("  log: %s" % log_path)
            log("  stop: %s" % kill_cmd)
            watcher = job.PidWatch(target, name, task, log_path, "test", PID_MATCH, int(reg.env.get("WK_JOB_PID_TRIES") or 900))
            watcher.start()
            script = "echo \"wk: test pid $$\" >&2\n%s" % cmd
            run_argv, cwd = target.exec_argv(name, ["bash", "-lc", script])
            rc = job.watch(run_argv, log_path, reg.machine, clock, reg.env, cwd, popen)
        except job.Interrupted as e:
            warn("interrupted -- stopping the test run in '%s'" % name)
            if not job.kill(target, name, task, "cancelled", reg.machine, clock, reg.env):
                warn("it is still running; stop it with:  %s" % kill_cmd)
            raise Refused(job.EXIT_OF.get(e.signum, 130))
        finally:
            if watcher is not None:
                watcher.stop()

    try:
        text = record.normalised(log_path)
    except OSError:
        text = ""
    summary = _SUMMARY.findall(text) and [l for l in text.split("\n") if _SUMMARY.match(l)][-4:] or []
    elapsed = int(clock.now() - start)
    mins, secs = elapsed // 60, elapsed % 60

    sys.stderr.write("\n")
    if rc != 0 and task.field("stopping"):
        task.end(rc)
        warn("TESTS STOPPED  %s/%s in '%s'  (by '%s' after %dm%ds)" % (opts["suite"], config, name, kill_cmd, mins, secs))
        raise Refused(rc)
    if rc == 0:
        task.end(0)
        info("TESTS OK  %s/%s in '%s'  (%dm%ds)" % (opts["suite"], config, name, mins, secs))
        for l in summary:
            log("  " + l)
        return 0
    if rc == 124:
        task.end("stalled")
        die("TESTS STALLED  %s/%s in '%s' (killed after %dm%ds with no output)\n"
            "    log: %s" % (opts["suite"], config, name, mins, secs, log_path))
    task.end(rc)
    warn("TESTS FAILED  %s/%s in '%s'  (exit %d after %dm%ds)" % (opts["suite"], config, name, rc, mins, secs))
    for l in summary:
        log("  " + l)
    log("failures:")
    for l in [l for l in text.split("\n") if _FAILURE.search(l)][:10]:
        log("  " + l)
    log("  full log: %s" % log_path)
    raise Refused(rc)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
