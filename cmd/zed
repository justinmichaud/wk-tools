#!/usr/bin/env bash
#
# wk zed <workspace> -- open a workspace's checkout in Zed
# wk: where=workspace name=optional here outside group=workspaces
# wk: flag --tools name=none
#
# Refused inside a workspace: Zed runs where the person is, and a container has
# no display and a macOS guest is driven from the host. From the host:
# wk zed <name>. `wk enter <ws> --zed` and `wk new <ws> --zed` launch Zed the
# same way.
#
#   --tools [<machine>|<workspace>]   open a wk-tools copy instead of the
#                                     checkout: a machine's, a workspace's, or
#                                     (with no argument) this one
#   --url                             print the ssh:// URL (and the `zed`
#                                     command line for it) instead of opening
#                                     Zed -- for a machine with no Zed of its
#                                     own, to paste onto one that has it
#   --route                           prepare this workspace's sshd for the
#                                     machine that asked and print the three
#                                     fields it needs to build a route of its
#                                     own (user, src, proxy). What `wk zed`
#                                     runs on another workstation to reach a
#                                     workspace that machine owns; nothing to
#                                     type by hand

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# With --tools the name may be a machine, which the dispatcher does not
# resolve (`flag --tools name=none`), so it comes from argv here, not $WK_NAME.
TOOLS=""
NAME="${WK_NAME:-}"
URL_ONLY=""
ROUTE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --tools) TOOLS=1; shift ;;
        --url)   URL_ONLY=1; shift ;;
        --route) ROUTE=1; shift ;;
        -*) die "unknown option: $1
    usage: wk zed <workspace>        the checkout
           wk zed --tools [<machine>|<workspace>]
           wk zed --url <workspace>  print the route instead of opening it" ;;
        *) [ -z "$NAME" ] || die "one name at a time (got '$NAME' and '$1')
    usage: wk zed <workspace>; see wk zed -h"
           NAME="$1"; shift ;;
    esac
done

# emit <url> -- hands it to Zed, or with --url prints it: one place for both.
# Zed outlives this command and every terminal it opens inherits its
# environment, so it gets none of the dispatcher's variables (wk_exec_clean):
# a `wk` typed in a Zed terminal is about what it names, not about the
# workspace this command opened.
emit() {
    local url="$1"
    if [ -n "$URL_ONLY" ]; then
        printf '%s\n' "$url"
        log "  zed '$url'"
        exit 0
    fi
    wk_exec_clean "$Z" "$url"
}

[ -z "$ROUTE" ] || [ -z "$TOOLS" ] \
    || die "--route describes a workspace; a wk-tools copy is already an ssh destination
    (wk zed --tools --url $NAME prints it)"

# Neither --url nor --route opens anything, so neither needs a Zed here: both
# exist for a machine that has none.
if [ -z "$URL_ONLY" ] && [ -z "$ROUTE" ]; then
    Z=$(zed_cli) || die "zed is not installed (no 'zed' on PATH, no /Applications/Zed.app)
    https://zed.dev/download -- 'wk doctor' checks for it, or add --url to print
    the route instead and open it from a machine that does have Zed"
fi

# --- --tools ------------------------------------------------------------------
# A path, not an ssh:// url: the local checkout is already where Zed runs.
if [ -n "$TOOLS" ]; then
    if [ -z "$NAME" ] || [ "$NAME" = here ] || [ "$NAME" = "$(hostname -s 2>/dev/null)" ]; then
        if [ -n "$URL_ONLY" ]; then
            printf '%s\n' "$WK_ROOT"
            log "  already local -- open it directly:  zed $WK_ROOT"
            exit 0
        fi
        wk_exec_clean "$Z" "$WK_ROOT"
    fi

    # A machine is tested for first (`target_kind` reads its conf file);
    # anything else is a workspace name.
    if [ "$(target_kind "$NAME" 2>/dev/null)" = remote ]; then
        load_target "$NAME"
        # "" -- t_tools and t_ssh_host answer for the machine itself here.
        host=$(t_ssh_host "" 2>/dev/null) \
            || die "target '$NAME' is this machine -- 'wk zed --tools' opens this checkout"
        emit "ssh://$host$(t_tools "")"
    fi

    case "$(target_kind "$NAME" 2>/dev/null)" in
    container|vm|local)
        die "'$NAME' is a kind of target, not a machine. What holds a copy of
    wk-tools is a machine or a workspace:
        wk zed --tools            this checkout
        wk zed --tools moose      a machine's copy
        wk zed --tools <ws>       /opt/wk-tools as that workspace sees it" ;;
    esac

    require_name "$NAME"
    # Checked here, not by the dispatcher: with --tools a name may be a machine.
    ws_exists "$NAME" || die "no machine or workspace named '$NAME'
    'wk ls' lists the workspaces, 'wk status' the machines."
    TARGET="$(ws_target "$NAME")"
    load_target "$TARGET"
    t_ssh_prepare "$NAME"
    host=$(t_ssh_host "$NAME") || die "'$NAME' is not running, so nothing in it can be opened"
    emit "ssh://$host$(t_tools "$NAME")"
fi

# --- a workspace --------------------------------------------------------------
require_name "$NAME"
TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

t_ssh_prepare "$NAME"

# The fields, not a URL: only this machine can say what to run here to speak
# ssh to a workspace that has no address, and the asking machine is the one
# that has to wrap that in its own hop. Printed after the preparation above,
# so by the time anybody uses them the sshd is installed and the key that
# came with the question is authorised.
if [ -n "$ROUTE" ]; then
    USER_IN=$(t_ssh_user "$NAME") \
        || die "a '$WK_TARGET_KIND' workspace has no ssh account for an editor to log in to"
    PROXY=$(t_ssh_proxy "$NAME") || PROXY=""
    printf 'user=%s\nsrc=%s\nproxy=%s\n' "$USER_IN" "$(t_src "$NAME")" "$PROXY"
    exit 0
fi

host=$(t_ssh_host "$NAME") || die "'$NAME' is not running, so there is no route to it.
    A macOS guest needs booting first:  wk vm start $NAME"

emit "ssh://$host$(t_src "$NAME")"
