#!/usr/bin/env python3
#
# wk zed <workspace> -- open a workspace's checkout in Zed
# wk: where=workspace name=optional here outside group=workspaces dryrun opts --tools,--url,--route
# wk: flag --tools name=none takes=1
#
# Refused inside a workspace: Zed runs where the person is.
#
#   --tools [<machine>|<workspace>]   open a wk-tools copy instead of the
#                                     checkout: a machine's, a workspace's, or
#                                     (with no argument) this one
#   --url                             print the ssh:// URL and the `zed` command
#                                     line for it instead of opening Zed
#   --route                           prepare this workspace's sshd for the
#                                     machine that asked and print the three
#                                     fields it needs to build a route of its
#                                     own (user, src, proxy)

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images, store  # noqa: E402

ROOT = images.root()

from wk import decl, dispatch, places, record  # noqa: E402
from wk.act import Refused, die, log  # noqa: E402
from wk.machine import Local  # noqa: E402
from wk.workspace import require_name  # noqa: E402


def exec_clean(argv):
    """Zed outlives this command and every terminal it opens inherits its environment,
    so the dispatcher's own variables are stripped first."""
    Local().exec(argv, env={k: v for k, v in os.environ.items() if k not in dispatch.DISPATCH_VARS})


def emit(url_only, zed, url):
    if url_only:
        print(url)
        log("  zed '%s'" % url)
        sys.exit(0)
    exec_clean([zed, url])


def main(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    tools = args.flag("--tools")
    url_only = args.flag("--url")
    route = args.flag("--route")
    name = store.ws_name()
    if args.positionals:
        name = args.positionals[-1]

    if route and tools:
        die("--route describes a workspace; a wk-tools copy is already an ssh destination\n"
            "    (wk zed --tools --url %s prints it)" % name)

    zed = None
    if not url_only and not route:
        zed = places.zed_cli(Local())
        if zed is None:
            die("zed is not installed (no 'zed' on PATH, no /Applications/Zed.app)\n"
                "    https://zed.dev/download -- 'wk doctor' checks for it, or add --url to print\n"
                "    the route instead and open it from a machine that does have Zed")

    reg = places.Registry(ROOT)

    if tools:
        hostname = record.host_name(reg.machine)
        if not name or name == "here" or name.lower() == hostname:
            if url_only:
                print(ROOT)
                log("  already local -- open it directly:  zed %s" % ROOT)
                return 0
            exec_clean([zed, ROOT])

        try:
            kind = reg.kind(name)
        except LookupError:
            kind = None
        if kind == "remote":
            try:
                driver = reg.load(name)
            except LookupError as e:
                die(str(e))
            host = driver.ssh_host("")
            if not host:
                die("place '%s' is this machine -- 'wk zed --tools' opens this checkout" % name)
            emit(url_only, zed, "ssh://%s%s" % (host, driver.tools("")))

        if kind in ("container", "vm", "local"):
            die("'%s' is a kind of place, not a machine. What holds a copy of\n"
                "    wk-tools is a machine or a workspace:\n"
                "        wk zed --tools            this checkout\n"
                "        wk zed --tools moose      a machine's copy\n"
                "        wk zed --tools <ws>       /opt/wk-tools as that workspace sees it" % name)

        require_name(name)
        try:
            tname = reg.ws_place(name)
            driver = reg.load(tname)
        except LookupError as e:
            die(str(e))
        if not reg.on_place(tname, name) and driver.info(name) != "unreachable":
            die("no machine or workspace named '%s'\n"
                "    'wk ls' lists the workspaces, 'wk status' the machines." % name)
        driver.ssh_prepare(name)
        host = driver.ssh_host(name)
        if not host:
            die("'%s' is not running, so nothing in it can be opened" % name)
        emit(url_only, zed, "ssh://%s%s" % (host, driver.tools(name)))
        return 0

    require_name(name)
    try:
        tname = reg.ws_place(name)
        driver = reg.load(tname)
    except LookupError as e:
        die(str(e))
    if driver.state(name) == "broken":
        die(driver.broken_words(name))

    driver.ssh_prepare(name)

    if route:
        user = driver.ssh_user(name)
        if not user:
            die("a %s workspace has no ssh account for an editor to log in to" % driver.kind)
        proxy = driver.ssh_proxy(name) or ""
        print("user=%s" % user)
        print("src=%s" % driver.src(name))
        print("proxy=%s" % proxy)
        return 0

    host = driver.ssh_host(name)
    if not host:
        die("'%s' is not running, so there is no route to it.\n"
            "    A macOS guest needs booting first:  wk start %s" % (name, name))

    if driver.kind == "vm":
        driver.login_note()

    emit(url_only, zed, "ssh://%s%s" % (host, driver.src(name)))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
