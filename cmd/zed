#!/usr/bin/env python3
#
# wk zed <workspace> -- open a workspace's checkout in Zed
# wk: where=workspace name=optional here outside group=workspaces dryrun opts --url,--route
#
# Refused inside a workspace: Zed runs where the person is.
#
#   --url                             print the ssh:// URL and the `zed` command
#                                     line for it instead of opening Zed
#   --route                           prepare this workspace's sshd for the
#                                     machine that asked and print the three
#                                     fields it needs to build a route of its
#                                     own (user, src, proxy)

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images, store  # noqa: E402

ROOT = images.root()

from wk import decl, dispatch, guest, places  # noqa: E402
from wk.act import Refused, die, log  # noqa: E402
from wk.machine import Local  # noqa: E402
from wk.workspace import require_name  # noqa: E402


def exec_clean(argv):
    """Zed outlives this command and every terminal it opens inherits its environment,
    so the dispatcher's own variables are stripped first."""
    Local().exec(argv, env={k: v for k, v in os.environ.items() if k not in dispatch.DISPATCH_VARS})


def emit(url_only, zed, url):
    if url_only:
        print(url)
        log("  zed '%s'" % url)
        sys.exit(0)
    exec_clean([zed, url])


def main(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    url_only = args.flag("--url")
    route = args.flag("--route")
    name = store.ws_name()
    if args.positionals:
        name = args.positionals[-1]

    zed = None
    if not url_only and not route:
        zed = places.zed_cli(Local())
        if zed is None:
            die("zed is not installed (no 'zed' on PATH, no /Applications/Zed.app)\n"
                "    https://zed.dev/download -- 'wk doctor' checks for it, or add --url to print\n"
                "    the route instead and open it from a machine that does have Zed")

    reg = places.Registry(ROOT)

    require_name(name)
    try:
        tname = reg.ws_place(name)
        driver = reg.load(tname)
    except LookupError as e:
        die(str(e))
    if driver.state(name) == "broken":
        die(driver.broken_words(name))

    driver.ssh_prepare(name)

    if route:
        user = driver.ssh_user(name)
        if not user:
            die("a %s workspace has no ssh account for an editor to log in to" % driver.kind)
        proxy = driver.ssh_proxy(name) or ""
        print("user=%s" % user)
        print("src=%s" % driver.src(name))
        print("proxy=%s" % proxy)
        return 0

    host = driver.ssh_host(name)
    if not host:
        die("'%s' is not running, so there is no route to it.\n"
            "    A macOS guest needs booting first:  wk start %s" % (name, name))

    if driver.kind == "vm":
        guest.login_note(driver.env)

    emit(url_only, zed, "ssh://%s%s" % (host, driver.src(name)))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
