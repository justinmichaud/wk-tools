#!/usr/bin/env python3
#
# wk zed <workspace> -- open a workspace's checkout in Zed
# wk: where=workspace name=optional here outside group=workspaces opts --tools,--url,--route
# wk: flag --tools name=none takes=1
#
# Refused inside a workspace: Zed runs where the person is.
#
#   --tools [<machine>|<workspace>]   open a wk-tools copy instead of the
#                                     checkout: a machine's, a workspace's, or
#                                     (with no argument) this one
#   --url                             print the ssh:// URL and the `zed` command
#                                     line for it instead of opening Zed
#   --route                           prepare this workspace's sshd for the
#                                     machine that asked and print the three
#                                     fields it needs to build a route of its
#                                     own (user, src, proxy)

import os
import re
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import decl, record, shell, targets  # noqa: E402
from wk.act import Refused, die, exec_into, log  # noqa: E402
from wk.machine import Local  # noqa: E402
from wk.workspace import require_name  # noqa: E402


def dispatch_vars():
    """The dispatcher's own per-invocation variables, read from where they are
    declared (lib/common.sh's WK_DISPATCH_VARS) rather than copied here."""
    m = re.search(r'WK_DISPATCH_VARS="([^"]+)"', open(os.path.join(ROOT, "lib", "common.sh")).read())
    if not m:
        die("lib/common.sh no longer declares WK_DISPATCH_VARS -- exec_clean cannot tell\n"
            "    which of its own environment to strip before Zed inherits it")
    return tuple(m.group(1).split())


def exec_clean(argv):
    """Zed outlives this command and every terminal it opens inherits its environment,
    so the dispatcher's own variables are stripped first."""
    exec_into(argv, env={k: v for k, v in os.environ.items() if k not in dispatch_vars()})


def emit(url_only, zed, url):
    if url_only:
        print(url)
        log("  zed '%s'" % url)
        sys.exit(0)
    exec_clean([zed, url])


def main(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    tools = args.flag("--tools")
    url_only = args.flag("--url")
    route = args.flag("--route")
    name = os.environ.get("WK_NAME", "")
    if args.positionals:
        name = args.positionals[-1]

    if route and tools:
        die("--route describes a workspace; a wk-tools copy is already an ssh destination\n"
            "    (wk zed --tools --url %s prints it)" % name)

    zed = None
    if not url_only and not route:
        zed = targets.zed_cli(Local())
        if zed is None:
            die("zed is not installed (no 'zed' on PATH, no /Applications/Zed.app)\n"
                "    https://zed.dev/download -- 'wk doctor' checks for it, or add --url to print\n"
                "    the route instead and open it from a machine that does have Zed")

    reg = targets.Registry(ROOT)

    if tools:
        hostname = record.host_name(reg.machine)
        if not name or name == "here" or name.lower() == hostname:
            if url_only:
                print(ROOT)
                log("  already local -- open it directly:  zed %s" % ROOT)
                return 0
            exec_clean([zed, ROOT])

        try:
            kind = reg.kind(name)
        except LookupError:
            kind = None
        if kind == "remote":
            try:
                target = reg.load(name)
            except LookupError as e:
                die(str(e))
            host = target.ssh_host("")
            if not host:
                die("target '%s' is this machine -- 'wk zed --tools' opens this checkout" % name)
            emit(url_only, zed, "ssh://%s%s" % (host, target.tools("")))

        if kind in ("container", "vm", "local"):
            die("'%s' is a kind of target, not a machine. What holds a copy of\n"
                "    wk-tools is a machine or a workspace:\n"
                "        wk zed --tools            this checkout\n"
                "        wk zed --tools moose      a machine's copy\n"
                "        wk zed --tools <ws>       /opt/wk-tools as that workspace sees it" % name)

        require_name(name)
        try:
            tname = reg.ws_target(name)
            target = reg.load(tname)
        except LookupError as e:
            die(str(e))
        if not reg.on_target(tname, name) and target.info(name) != "unreachable":
            die("no machine or workspace named '%s'\n"
                "    'wk ls' lists the workspaces, 'wk status' the machines." % name)
        target.ssh_prepare(name)
        host = target.ssh_host(name)
        if not host:
            die("'%s' is not running, so nothing in it can be opened" % name)
        emit(url_only, zed, "ssh://%s%s" % (host, target.tools(name)))
        return 0

    require_name(name)
    try:
        tname = reg.ws_target(name)
        target = reg.load(tname)
    except LookupError as e:
        die(str(e))
    broken = broken_reason(target, tname, name)
    if broken:
        die(broken)

    target.ssh_prepare(name)

    if route:
        user = target.ssh_user(name)
        if not user:
            die("a %s workspace has no ssh account for an editor to log in to" % target.kind)
        proxy = target.ssh_proxy(name) or ""
        print("user=%s" % user)
        print("src=%s" % target.src(name))
        print("proxy=%s" % proxy)
        return 0

    host = target.ssh_host(name)
    if not host:
        die("'%s' is not running, so there is no route to it.\n"
            "    A macOS guest needs booting first:  wk vm start %s" % (name, name))

    # vm_login_note is the one place the guest's login password is stated.
    if target.kind == "vm":
        shell.vm_login_note(ROOT, env=target.env)

    emit(url_only, zed, "ssh://%s%s" % (host, target.src(name)))
    return 0


def broken_reason(target, tname, name):
    """None, or why `name` is a record without an environment -- naming the repair, not a driver's word."""
    if target.state(name) != "broken":
        return None
    return ("'%s' exists as a record and not as a %s workspace: creation\n"
            "    finished, and the environment is gone -- something outside wk removed it.\n"
            "    Repair:  wk rm %s    (then 'wk new %s' if you still want it)" % (name, tname, name, name))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
