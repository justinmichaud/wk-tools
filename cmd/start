#!/usr/bin/env bash
#
# wk start -- bring everything back up after `wk stop`.
#
# Starts the podman machine, then every workspace container that exists.
# Container init does not re-run: .wkdev-init guards its task list behind
# /run/.wkdev-init-done, so a restart is quick and does not re-provision.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"

WK_MACHINE="${WK_MACHINE:-wk}"

# Named _in_machine because targets/vm.sh, sourced below, defines its own _vm().
_in_machine() {
    if is_macos && [ -z "${WK_IN_VM:-}" ]; then
        podman machine ssh "$WK_MACHINE" "$@" </dev/null
    else
        bash -c "$*" </dev/null
    fi
}

if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    state=$(podman machine inspect "$WK_MACHINE" --format '{{.State}}' 2>/dev/null || echo absent)
    [ "$state" = absent ] && die "no machine '$WK_MACHINE' -- run ./setup"
    if [ "$state" != running ]; then
        info "starting machine '$WK_MACHINE'"
        podman machine start "$WK_MACHINE" >/dev/null
    else
        unchanged "machine already running"
    fi
fi

# Plain podman, not sudo: see the note in cmd/stop.
stopped=$(_in_machine 'podman ps -a --filter "name=^wk-" --filter "status=exited" --filter "status=created" --format "{{.Names}}"' || true)
if [ -n "$stopped" ]; then
    printf '%s\n' "$stopped" | sed 's/^/  starting /' >&2
    _in_machine 'podman start $(podman ps -a --filter "name=^wk-" --filter "status=exited" --filter "status=created" --format "{{.Names}}" | tr "\n" " ") >/dev/null'
    info "started $(printf '%s\n' "$stopped" | wc -l | tr -d ' ') container(s)"
else
    info "no stopped containers"
fi

# macOS VMs are deliberately NOT started here. They do not share the podman
# machine's memory -- they compete with it -- so bringing both up unattended is
# how the desktop ends up swapping. Say they are there and let the choice be
# made explicitly.
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    . "$WK_ROOT/lib/target.sh"
    . "$WK_ROOT/targets/vm.sh"
    if _tart_bin >/dev/null 2>&1; then
        _guests=$(t_list 2>/dev/null | awk -F'\t' '$2 != "running" { print $1 }' | tr '\n' ' ')
        [ -n "${_guests// /}" ] && \
            log "macOS VM(s) not started (they compete with the machine for memory): $_guests
  wk vm start <name>"
    fi
fi

exec "$WK_ROOT/wk" status
