#!/usr/bin/env bash
#
# wk start [<workspace>] -- bring one workspace back up, or everything
# wk: where=workspace name=optional forward=no group=hosts needs podman
#
# With a workspace named, brings only that workspace's environment back
# through the driver contract (t_start): a container's machine started if
# not already, then the container itself; a macOS guest booted. A target
# with no notion of starting one workspace says so and does nothing else.
#
# `forward=no`, the same reason `wk stop` gives: runs on the host that holds
# the environment, never forwarded into the podman VM.
#
# With no workspace, starts the podman machine, then every workspace
# container that exists. Container init does not re-run: .wkdev-init guards
# its task list behind /run/.wkdev-init-done, so a restart is quick. macOS
# guests are listed rather than started (see below) -- `wk start
# <that-workspace>` is how to bring one back.
#
#   wk start                 the podman machine, then every container
#   wk start <workspace>     only that workspace's environment

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

WK_MACHINE="${WK_MACHINE:-wk}"

NAME="${WK_NAME:-}"

# --- one workspace ------------------------------------------------------------
if [ -n "$NAME" ]; then
    [ $# -eq 0 ] || die "'wk start $NAME' takes no options"
    TARGET="$(ws_target "$NAME")"
    load_target "$TARGET"
    [ "$(t_info "$NAME")" != absent ] || die "no such workspace: $NAME"
    t_start "$NAME"
    exit 0
fi

# --- everything ----------------------------------------------------------------
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    state=$(_machine_state "$WK_MACHINE")
    [ "$state" = absent ] && die "no machine '$WK_MACHINE' -- run ./setup"
    if [ "$state" != running ]; then
        info "starting machine '$WK_MACHINE'"
        podman machine start "$WK_MACHINE" >/dev/null
    else
        unchanged "machine already running"
    fi
fi

# Plain podman, not sudo: see the note in cmd/stop.
stopped=$(_in_machine 'podman ps -a --filter "name=^wk-" --filter "status=exited" --filter "status=created" --format "{{.Names}}"' || true)
if [ -n "$stopped" ]; then
    printf '%s\n' "$stopped" | sed 's/^/  starting /' >&2
    _in_machine 'podman start $(podman ps -a --filter "name=^wk-" --filter "status=exited" --filter "status=created" --format "{{.Names}}" | tr "\n" " ") >/dev/null'
    info "started $(printf '%s\n' "$stopped" | wc -l | tr -d ' ') container(s)"
else
    info "no stopped containers"
fi

# macOS VMs are not started here: they compete with the podman machine for
# memory, so bringing both up unattended causes swapping. List them instead.
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    . "$WK_ROOT/targets/vm.sh"
    if _tart_bin >/dev/null 2>&1; then
        _guests=$(t_list 2>/dev/null | awk -F'\t' '$2 != "running" { print $1 }' | tr '\n' ' ')
        [ -n "${_guests// /}" ] && \
            log "macOS VM(s) not started (they compete with the machine for memory): $_guests
  wk vm start <name>"
    fi
fi

exec "$WK_ROOT/wk" status
