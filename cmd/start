#!/usr/bin/env bash
#
# wk start [<workspace>] -- bring one workspace back up, or everything
# wk: where=workspace name=optional forward=no group=hosts needs podman
#
# `forward=no`: runs on the host that holds the environment, never forwarded
# into the podman VM. macOS guests are listed rather than started.
#
#   wk start                 the podman machine, then every container
#   wk start <workspace>     only that workspace's environment
#
# WK_NO_CLAUDE_RC=1 skips restarting claude remote control in the containers
# that came back up.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

WK_MACHINE="${WK_MACHINE:-wk}"

NAME="${WK_NAME:-}"

if [ -n "$NAME" ]; then
    [ $# -eq 0 ] || die "usage: wk start [<workspace>]; see wk start -h
    'wk start $NAME' takes no options"
    TARGET="$(ws_target "$NAME")"
    load_target "$TARGET"
    [ "$(t_info "$NAME")" != absent ] || die "no such workspace: $NAME"
    t_start "$NAME"
    exit 0
fi

[ $# -eq 0 ] || die "usage: wk start [<workspace>]; see wk start -h
    unexpected argument: $1"

if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    state=$(_machine_state "$WK_MACHINE")
    [ "$state" = absent ] && die "no machine '$WK_MACHINE' -- run ./setup"
    if [ "$state" != running ]; then
        info "starting machine '$WK_MACHINE'"
        podman machine start "$WK_MACHINE" >/dev/null
    else
        unchanged "machine already running"
    fi
fi

stopped=$(_in_machine 'podman ps -a --filter "name=^wk-" --filter "status=exited" --filter "status=created" --format "{{.Names}}"' || true)
if [ -n "$stopped" ]; then
    printf '%s\n' "$stopped" | sed 's/^/  starting /' >&2
    _in_machine 'podman start $(podman ps -a --filter "name=^wk-" --filter "status=exited" --filter "status=created" --format "{{.Names}}" | tr "\n" " ") >/dev/null'
    info "started $(printf '%s\n' "$stopped" | wc -l | tr -d ' ') container(s)"
else
    info "no stopped containers"
fi

if [ -n "$stopped" ] && [ -z "${WK_NO_CLAUDE_RC:-}" ]; then
    printf '%s\n' "$stopped" | sed 's/^wk-//' | while read -r _ws; do
        [ -n "$_ws" ] || continue
        "$WK_ROOT/wk" ai claude "$_ws" --rc >/dev/null 2>&1 \
            || warn "claude remote control did not start in '$_ws' -- 'wk ai claude $_ws --rc' says why"
    done
fi

if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    . "$WK_ROOT/targets/vm.sh"
    if _tart_bin >/dev/null 2>&1; then
        _guests=$(t_list 2>/dev/null | awk -F'\t' '$2 != "running" { print $1 }' | tr '\n' ' ')
        [ -n "${_guests// /}" ] && \
            log "macOS VM(s) not started (they compete with the machine for memory): $_guests
  wk vm start <name>"
    fi
fi

exec "$WK_ROOT/wk" status
