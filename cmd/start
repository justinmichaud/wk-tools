#!/usr/bin/env python3
#
# wk start [<workspace>] -- bring one workspace back up, or everything
# wk: where=workspace name=optional forward=no group=hosts needs podman
#
# `forward=no`: runs on the host that holds the environment, never forwarded
# into the podman VM. macOS guests are listed rather than started.
#
#   wk start                 the podman machine, then every container
#   wk start <workspace>     only that workspace's environment; for a macOS
#                            guest this is `wk vm start <workspace>`

import os
import subprocess
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import act, shell, targets  # noqa: E402
from wk.act import Refused, die, info, log  # noqa: E402

MACHINE = os.environ.get("WK_MACHINE", "wk")
STOPPED = 'podman ps -a --filter "name=^wk-" --filter "status=exited" --filter "status=created" --format "{{.Names}}"'


def here():
    return os.uname().sysname == "Darwin" and not os.environ.get("WK_IN_VM")


def start_workspace(reg, name):
    target = reg.load(reg.ws_target(name))
    if target.kind == "vm":
        os.execv(os.path.join(ROOT, "wk"), [os.path.join(ROOT, "wk"), "vm", "start", name])
    if target.info(name) == "absent":
        die("no such workspace: %s" % name)
    return 0 if target.start(name) else 1


def start_everything(reg):
    if here():
        state = reg.load("container").machine_state()
        if state == "absent":
            die("no machine '%s' -- run ./setup" % MACHINE)
        if state != "running":
            info("starting machine '%s'" % MACHINE)
            act.act(["podman", "machine", "start", MACHINE], stdout=subprocess.DEVNULL)
        else:
            act.debug("ok: machine already running")
    shell.run(ROOT, "push_agent_pat_converge_machine")
    stopped = (shell.in_machine(ROOT, STOPPED) or "").split()
    if stopped:
        for n in stopped:
            sys.stderr.write("  starting %s\n" % n)
        shell.in_machine(ROOT, "podman start $(%s | tr \"\\n\" \" \") >/dev/null" % STOPPED)
        info("started %d container(s)" % len(stopped))
    else:
        info("no stopped containers")
    if here():
        try:
            vm = reg.load("vm")
            guests = [n for n, state in vm.list() if state != "running"]
        except LookupError:
            guests = []
        if guests:
            log("macOS VM(s) not started (they compete with the machine for memory): %s\n  wk vm start <name>" % " ".join(guests))
    log("status (information only)")
    subprocess.call([os.path.join(ROOT, "wk"), "status", "--no-fleet"])
    return 0


def main(argv):
    reg = targets.Registry(ROOT)
    name = os.environ.get("WK_NAME", "")
    try:
        return start_workspace(reg, name) if name else start_everything(reg)
    except LookupError as e:
        die(str(e))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
