"""bring one workspace back up, or everything

Runs on the host holding the environment, never forwarded into the podman VM. macOS guests are listed rather than
started.

  wk start                 the podman machine, then every container
  wk start <workspace>     only that workspace's environment: a macOS guest is booted, converged and given its ssh alias
"""
import sys

from wk import act, dispatch, images, places, secrets, store
from wk.act import die, info, log
from wk.decl import Command
from wk.store import Store

ROOT = images.root()
MACHINE = Store().podman_machine()
COMMAND = Command(name="optional", forward=False, needs=("podman",), group="hosts")


def start_everything(reg):
    if Store().macos_host:
        state = reg.load("container").machine_state()
        if state == "absent":
            die("no machine '%s' -- run ./setup" % MACHINE)
        if state != "running":
            dispatch.start_podman_machine(reg.machine, "start", True)   # 'wk start' is itself the asking
        else:
            act.debug("ok: machine already running")
    secrets.Secrets(ROOT).push_converge_machine()
    ctr = reg.load("container")
    stopped = ctr.machine.run(ctr.podman() + ["ps", "-a", "--filter", "name=^wk-", "--filter", "status=exited",
                                              "--filter", "status=created", "--format", "{{.Names}}"], input="").out.split()
    if stopped:
        for n in stopped:
            sys.stderr.write("  starting %s\n" % n)
        ctr.machine.act_run(ctr.podman() + ["start"] + stopped, input="")
        info("started %d container(s)" % len(stopped))
    else:
        info("no stopped containers")
    if Store().macos_host:
        try:
            vm = reg.load("vm")
            guests = [n for n, state in vm.list() if state != "running"]
        except LookupError:
            guests = []
        if guests:
            log("macOS VM(s) not started (they compete with the machine for memory): %s\n  wk start <name>" % " ".join(guests))
    log("  wk status   what each workspace is doing")
    return 0


def main(args, inv):
    reg = places.Registry(ROOT)
    name = store.ws_name()
    try:
        return (0 if reg.present(name).start(name) else 1) if name else start_everything(reg)
    except LookupError as e:
        die(str(e))

