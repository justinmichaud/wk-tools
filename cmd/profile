#!/usr/bin/env bash
#
# wk profile [<workspace>] [flags] [file.js] -- profile a jsc or browser run
# wk: where=workspace name=required ready=yes group=workspaces
# wk: flag --list name=none
#
# Where the time went -- with the env-var wall for each profiler written down
# once, here, instead of in three wiki pages and two skills.
#
# Which profiler, and why it is a choice at all:
#
#   sampling    JSC's own sampling profiler. Names JS functions, and gives the
#               tier breakdown (LLInt/Baseline/DFG/FTL/C++) that decides where
#               to look next. No tools, no privileges, works on every port and
#               every architecture -- including armhf, where the native
#               profilers need a patched build. This is the default because it
#               is the one that answers "which half of the engine is this".
#   bytecode    JSC's Profiler::Database: per-CodeBlock, per-bytecode counts
#               split by tier, plus the compile/OSR-exit/jettison log. The
#               answer to "is this function reaching FTL, and if not why".
#   samply      native sampling with the Firefox Profiler UI: C++ frames,
#               every thread, the GC and the compiler. The mirror image of the
#               two above -- precise about the engine, poor about JS -- which
#               is why `--jit-dump` exists to give it JS frame names too.
#   instruments Apple's Time Profiler through xctrace. Same job as samply on
#               a Mac, and it needs nothing installed: a guest that can build
#               the Apple port already has Xcode. `--mode native` picks this
#               one on the Apple ports and samply everywhere else.
#   heaptrack   allocations rather than time (Linux ports only).
#   massif      the same question asked of the peak, through valgrind.
#
# What this doesn't decide is *what* to profile: the run is the jsc shell
# with your file, MiniBrowser with your page, or an attach to something
# already running -- a profiler that also picks the workload is a benchmark,
# that's `wk bench`. Artifacts stay in the workspace; `--fetch` copies them
# out through t_pull, since `t_exec <ws> cat` silently corrupts a binary.
#
#   --mode <m>        sampling (default) | bytecode | samply | instruments |
#                     heaptrack | massif | native  (native = instruments on the
#                     Apple ports, samply everywhere else)
#   --config <c>      which build to profile (default: the workspace's own);
#                     `wk build --list` lists every name
#   --browser [url]   profile MiniBrowser on that page instead of the jsc shell
#   --process <p>     which of MiniBrowser's processes: ui | web (default) |
#                     network | gpu. On the Apple ports the browser is profiled
#                     directly and this is refused. On the CMake ports (GTK/WPE),
#                     'ui' puts the recorder in front of the launch itself
#                     (WEBKIT_MINI_BROWSER_PREFIX, the hook `wk gui --lldb ui`
#                     also uses); web/network/gpu launch the browser and attach
#                     once the named process appears -- first cut: a fixed wait,
#                     then the newest process of that name, so it may not be
#                     mid-load. Only --mode samply attaches; sampling/bytecode
#                     set environment variables the whole process tree inherits
#                     and refuse --process; heaptrack/massif are not wired up
#                     for a browser yet (docs/Urgent/HANDOFF-linux-minibrower.md).
#   --attach <pid|name>
#                     profile something already running in the workspace
#   --jit-dump        JS/JIT frame names for the native profilers
#   --markers         JSC's interval text markers, for splitting a trace by phase
#   --top <n>         how many functions/bytecodes the sampling report prints
#   --fetch [dir]     copy the artifacts to this machine when the run ends
#   --env NAME=VALUE  one more variable for the run (repeatable)
#   --list            print the available modes and exit
#   --dry-run         print the environment and the command, run nothing
#
# Everything after `--` is passed to what is being profiled.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/build/configs.sh"

MODES="sampling bytecode samply instruments heaptrack massif"

NAME="${WK_NAME:-}"

# Same constant cmd/quiesce and cmd/session use: the only mechanism that may
# touch the host sysctl below.
PRIV=/usr/local/libexec/wk-quiesce-priv

MODE=sampling
CONFIG="${WK_CONFIG:-}"
BROWSER=""; URL=""; PROCESS=web; PROCESS_EXPLICIT=""
ATTACH=""; JITDUMP=""; MARKERS=""; TOP=""
FETCH=""; FETCH_DIR=""; DRY=""; EXTRA_ENV=""
ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        --mode)    MODE="${2:-}"; shift 2 ;;
        --mode=*)  MODE="${1#*=}"; shift ;;
        --config)  CONFIG="${2:-}"; shift 2 ;;
        --browser) BROWSER=1; shift
                   case "${1:-}" in ''|-*) ;; *) URL="$1"; shift ;; esac ;;
        --process) PROCESS="${2:-}"; PROCESS_EXPLICIT=1; shift 2 ;;
        --process=*) PROCESS="${1#*=}"; PROCESS_EXPLICIT=1; shift ;;
        --attach)  ATTACH="${2:-}"; [ -n "$ATTACH" ] || die "--attach needs a pid or a process name"; shift 2 ;;
        --jit-dump) JITDUMP=1; shift ;;
        --markers) MARKERS=1; shift ;;
        --top)     TOP="${2:-}"; shift 2 ;;
        --fetch)   FETCH=1; shift
                   case "${1:-}" in ''|-*) ;; *) FETCH_DIR="$1"; shift ;; esac ;;
        --env)     EXTRA_ENV="$EXTRA_ENV
${2:-}"; shift 2 ;;
        --dry-run) DRY=1; shift ;;
        --list)    printf '%s\n' $MODES; exit 0 ;;
        --)        shift; while [ $# -gt 0 ]; do ARGS+=("$1"); shift; done ;;
        -*)        die "usage: wk profile [<workspace>] [--mode <m>] [--config <c>] [--browser [url]]
    [--process ui|web|network|gpu] [--attach <pid|name>] [--jit-dump] [--markers]
    [--top <n>] [--fetch [dir]] [--env NAME=VALUE] [--list] [--dry-run] [--] [file.js]
    unknown option: $1; 'wk profile -h' lists them." ;;
        *)         ARGS+=("$1"); shift ;;
    esac
done

case "$PROCESS" in
    ui|web|network|gpu) ;;
    *) die "no such process '$PROCESS' -- there are: ui web network gpu" ;;
esac

require_name "$NAME"

[ -n "$CONFIG" ] || CONFIG=$(default_config)
config_load "$CONFIG" || die "unknown config '$CONFIG' (wk build --list)"

# `native` is a question about the platform, not a mode of its own: xctrace is
# already there on the Apple ports, so asking for a Rust toolchain instead
# would be a poor trade.
[ "$MODE" = native ] && { case "$CFG_BUILDSYS" in xcode) MODE=instruments ;; *) MODE=samply ;; esac; }
case " $MODES " in
    *" $MODE "*) ;;
    *) die "no such mode '$MODE' -- there are: $MODES (and 'native')" ;;
esac

[ -n "$ATTACH" ] && [ -n "$BROWSER" ] && \
    die "--attach and --browser are two ways to name the same thing: one starts
    the browser under the profiler, the other profiles a process that is
    already running. Pick one."

[ -n "$PROCESS_EXPLICIT" ] && [ -z "$BROWSER" ] && \
    die "--process only makes sense with --browser: it names which of
    MiniBrowser's own processes (ui, web, network, gpu) to point the profiler
    at, and without --browser there is no MiniBrowser to name one of."

TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

SRC=$(t_src "$NAME")
VAR=$(config_run_var)
DIR=$(config_run_dir "$SRC")

# --- where the recording lands ------------------------------------------------
# Not /tmp: a profile is worth more than the ten minutes it took to record,
# and /tmp on a container workspace is the first thing a restart takes away.
# Computed before "what is being profiled" below: the CMake --browser
# --process web/network/gpu shape needs it there, to name samply's own file.
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
RUN="$STAMP-$MODE"
OUTDIR="$(t_home "$NAME")/wk-profile/$RUN"

# --- what is being profiled ---------------------------------------------------
#
# One of three shapes, each resolving to a command in the workspace. The jsc
# shell is the default: one process, one workload, nothing else in the way.
MB_PREFIX=""      # set below when --process ui's recorder belongs in
                  # WEBKIT_MINI_BROWSER_PREFIX, not prepended to TARGET_CMD
CMAKE_BROWSER=""  # set below for any CMake --browser run, to keep the mode
                  # case's own WRAP out of TARGET_CMD -- this shape builds its
                  # own command line instead (prefix env var, or launch+attach)
if [ -n "$ATTACH" ]; then
    SUBJECT="attach:$ATTACH"
    TARGET_CMD=""
elif [ -n "$BROWSER" ]; then
    [ -n "$URL" ] || URL="about:blank"
    BIN=$(config_browser_path "$SRC")
    case "$CFG_BUILDSYS" in
    xcode)
        [ -z "$PROCESS_EXPLICIT" ] || \
            die "--process is not wired up for the Apple ports: MiniBrowser is profiled
    directly here, not through a process picker. '--attach
    $(config_web_process_name)' reaches the web process once it is up."
        SUBJECT="MiniBrowser $URL"
        TARGET_CMD="$(sh_quote "$BIN") $(config_browser_url_flag) $(sh_quote "$URL")"
        [ ${#ARGS[@]} -gt 0 ] && TARGET_CMD="$TARGET_CMD $(sh_quote "${ARGS[@]}")"
        ;;
    *)
        CMAKE_BROWSER=1
        # MiniBrowser is a grandchild of Tools/Scripts/run-minibrowser here, so a
        # profiler pointed at the launcher would record the launcher, not
        # MiniBrowser. run-minibrowser reads WEBKIT_MINI_BROWSER_PREFIX after
        # setting up the port's own launch environment and splits it in front of
        # the MiniBrowser command it builds (webkitpy/port/{gtk,wpe}.py) -- the
        # same hook `wk gui --lldb ui` uses to put lldb in front of the same
        # binary.
        case "$MODE" in
            heaptrack|massif)
                die "--browser --mode $MODE is not wired up on the CMake ports: $MODE has to
    be there from the process's first allocation, and its own launch line is a
    shell fragment ('cd <dir> && $MODE'), not the plain command
    WEBKIT_MINI_BROWSER_PREFIX needs. Owed --
    docs/Urgent/HANDOFF-linux-minibrower.md. Use --mode samply against the
    browser, or profile the jsc shell instead." ;;
        esac
        if [ -n "$PROCESS_EXPLICIT" ]; then
            case "$MODE" in
                sampling|bytecode)
                    die "--process is meaningless with --mode $MODE: it sets environment
    variables the whole browser process tree inherits, not a wrapper pointed at
    one process. Drop --process, or use --mode samply to pick one." ;;
            esac
        fi
        TYPE_FLAG="--$(printf '%s' "$CFG_TYPE" | tr 'A-Z' 'a-z')"
        LAUNCH_ENV="WPE_BROWSER=minibrowser"
        LAUNCH_CMD="Tools/Scripts/run-minibrowser $CFG_PORT $TYPE_FLAG -- $(sh_quote "$URL")"
        [ ${#ARGS[@]} -gt 0 ] && LAUNCH_CMD="$LAUNCH_CMD $(sh_quote "${ARGS[@]}")"
        if [ "$MODE" = samply ] && [ "$PROCESS" != ui ]; then
            # samply cannot be a prefix of a process the UI process spawns later,
            # so it attaches instead: launch the browser, wait for the named
            # process to appear, then `samply record -p <pid>`. First cut -- a
            # fixed wait, then the newest process of that name, which is not
            # necessarily mid-load (docs/Urgent/HANDOFF-debug.md's prewarming
            # note is why that is still the page's process and not a leftover
            # prewarm one).
            case "$PROCESS" in
                web)     PROC_NAME=$(config_web_process_name) ;;
                network) PROC_NAME=$(config_network_process_name) ;;
                gpu)     PROC_NAME=$(config_gpu_process_name) ;;
            esac
            [ -n "$PROC_NAME" ] || die "no $PROCESS process for '$CONFIG' ($CFG_BUILDSYS:$CFG_PORT)"
            SUBJECT="MiniBrowser $URL, samply attaching to the newest $PROC_NAME after launch"
            TARGET_CMD="$LAUNCH_ENV $LAUNCH_CMD >$(sh_quote "$OUTDIR/browser.log") 2>&1 &
sleep 5
_pid=\$(pgrep -n -x $(sh_quote "$PROC_NAME") 2>/dev/null) || true
[ -n \"\$_pid\" ] || { echo \"error: no $PROC_NAME appeared within 5s of launching MiniBrowser -- see $(sh_quote "$OUTDIR/browser.log")\" >&2; exit 1; }
echo \"attaching samply to $PROC_NAME pid \$_pid\" >&2
exec samply record --save-only -o $(sh_quote "$OUTDIR/profile.json") -p \"\$_pid\""
        else
            SUBJECT="MiniBrowser $URL"
            if [ "$MODE" = samply ]; then
                SUBJECT="$SUBJECT (process: ui, samply prefixed via WEBKIT_MINI_BROWSER_PREFIX)"
                MB_PREFIX=1
            fi
            TARGET_CMD="$LAUNCH_ENV $LAUNCH_CMD"
        fi
        ;;
    esac
else
    BIN=$(config_jsc_path "$SRC")
    SUBJECT="jsc${ARGS[0]:+ ${ARGS[0]}}"
    # jsc takes its options *before* the script: a `--sample` appended after
    # the file name is silently handed to the script as an argument instead.
    TARGET_CMD=""
fi

# --- the environment ----------------------------------------------------------
# The loader variable is prepended, not replaced: a plain assignment would
# drop the wkdev image's own libwpe/jhbuild prefix on that path, failing to
# start with a missing library that was there all along. Same prelude cmd/run uses.
PRELUDE="export $VAR=\"$DIR\${${VAR}:+:\${${VAR}}}\""

# JSC_<option> is spelled the way JSC's OptionsList.h spells it -- a typo'd
# variable is ignored in silence, and the profile looks like the code changed.
JSC_ENV=""
add_env() { JSC_ENV="$JSC_ENV $1"; }

if [ -n "$MARKERS" ]; then
    # For splitting one trace into per-phase profiles (jsc-marker-trace skill).
    # With the default empty directory the markers go nowhere, and the
    # failure looks like a build without the instrumentation.
    add_env "JSC_useTextMarkers=1"
    add_env "JSC_textMarkersDirectory=$OUTDIR"
fi

if [ -n "$JITDUMP" ]; then
    # Opt-in: known to take the WebKitGTK UI process down within seconds of
    # startup, a warning below rather than a barrier since it's port-specific
    # and the jsc shell is fine.
    add_env "JSC_useJITDump=1"
    add_env "JSC_jitDumpDirectory=$OUTDIR"
    if [ "$CFG_BUILDSYS" != xcode ] && [ -n "$BROWSER" ]; then
        warn "JSC_useJITDump=1 has been seen to crash the WebKitGTK UI process on startup"
        log  "  (claude/skills/jsc-marker-trace). If the browser dies at once, that is why."
    fi
fi

if [ -n "$EXTRA_ENV" ]; then
    while IFS= read -r _e; do
        [ -n "$_e" ] || continue
        add_env "$_e"
    done <<EOF
$EXTRA_ENV
EOF
fi

# --- the tool -----------------------------------------------------------------
# Each mode contributes three things -- what has to be present, what wraps
# the command, what it leaves behind -- assembled here, not branched over
# three times below.
NEEDS=""       # a binary that must exist in the workspace
JSC_FLAGS=""   # options for the jsc shell itself, which go before the script
TEE=""         # a file the run's own output is copied into
WRAP=""        # what goes in front of the command
PRE=""         # what to run in the workspace first
POST=""        # what to run in the workspace afterwards
ARTIFACT=""    # what to point at when it is done

case "$MODE" in
sampling)
    [ -n "$ATTACH" ] && die "the sampling profiler is a JSC option, not an attach: it has to be
    on when the process starts. Use --mode samply (or instruments) to profile
    something already running."
    if [ -n "$BROWSER" ]; then
        # In a browser the report has nowhere to print to at exit but stderr.
        add_env "JSC_useSamplingProfiler=1"
        add_env "JSC_collectExtraSamplingProfilerData=1"
        add_env "JSC_reportSamplingProfilerData=1"
        ARTIFACT="the report goes to the browser's stderr at exit"
    else
        # The shell's own spelling of useSamplingProfiler plus
        # collectExtraSamplingProfilerData.
        JSC_FLAGS="--sample"
        if [ -n "$TOP" ]; then
            JSC_FLAGS="$JSC_FLAGS --samplingProfilerTopFunctionsCount=$TOP"
            JSC_FLAGS="$JSC_FLAGS --samplingProfilerTopBytecodesCount=$((TOP * 2))"
        fi
        ARTIFACT="$OUTDIR/report.txt"
        TEE="$ARTIFACT"
    fi
    ;;
bytecode)
    [ -n "$ATTACH" ] && die "the bytecode profiler is a JSC option and has to be on when the
    process starts -- there is nothing to attach to."
    add_env "JSC_useProfiler=true"
    add_env "JSC_dumpProfilerDataAtExit=true"
    # JSC writes JSCProfile-<pid>-<n>.json into the working directory (the
    # checkout, since a relative script path needs it there), so the file is
    # moved out afterwards -- identified by being newer than a stamp taken
    # just before the run, not by being newest in the tree, which on a
    # machine with two runs going would be somebody else's profile.
    ARTIFACT="$OUTDIR/JSCProfile.json"
    PRE="touch $(sh_quote "$OUTDIR/.stamp")"
    POST="p=\$(find $(sh_quote "$SRC") -maxdepth 1 -name 'JSCProfile-*.json' -newer $(sh_quote "$OUTDIR/.stamp") 2>/dev/null | head -1)
          [ -n \"\$p\" ] || { echo 'no JSCProfile-*.json was written -- did the run reach exit?'; exit 1; }
          mv \"\$p\" $(sh_quote "$ARTIFACT")
          printf 'summary\\nquit\\n' | $(sh_quote "$SRC")/Tools/Scripts/display-profiler-output $(sh_quote "$ARTIFACT")"
    ;;
samply)
    NEEDS=samply
    ARTIFACT="$OUTDIR/profile.json"
    if [ -n "$ATTACH" ]; then
        case "$ATTACH" in
            [0-9]*) WRAP="samply record --save-only -o $(sh_quote "$ARTIFACT") -p $ATTACH" ;;
            *) die "samply attaches by pid. Find it in the workspace first:
    wk enter $NAME -- pgrep -f $ATTACH" ;;
        esac
    else
        WRAP="samply record --save-only -o $(sh_quote "$ARTIFACT") --"
    fi
    ;;
instruments)
    [ "$CFG_BUILDSYS" = xcode ] || die "xctrace profiles Mach-O processes on macOS; '$CONFIG' is a $CFG_BUILDSYS
    build. Use --mode samply there."
    NEEDS=xctrace
    ARTIFACT="$OUTDIR/trace.trace"
    if [ -n "$ATTACH" ]; then
        WRAP="xctrace record --template 'Time Profiler' --output $(sh_quote "$ARTIFACT") --attach $(sh_quote "$ATTACH")"
    else
        WRAP="xctrace record --template 'Time Profiler' --output $(sh_quote "$ARTIFACT") --launch --"
    fi
    ;;
heaptrack|massif)
    [ "$CFG_BUILDSYS" = xcode ] && die "$MODE is a Linux tool and this is an Apple-port build.
    For allocations on macOS use Instruments' Allocations template by hand --
    'wk profile --mode instruments' records Time Profiler only."
    [ -n "$ATTACH" ] && die "$MODE has to be there from the first allocation; there is nothing
    useful to attach to."
    if [ "$MODE" = heaptrack ]; then
        NEEDS=heaptrack
        ARTIFACT="$OUTDIR/heaptrack.*.zst"
        WRAP="cd $(sh_quote "$OUTDIR") && heaptrack"
    else
        NEEDS=valgrind
        ARTIFACT="$OUTDIR/massif.out"
        WRAP="valgrind --tool=massif --massif-out-file=$(sh_quote "$ARTIFACT")"
    fi
    ;;
esac

# A CMake --browser run builds its own command line above (a prefix env var,
# or a launch-then-attach script) instead of leaning on WRAP the way the jsc
# shell and --attach do: prepending WRAP here would wrap the wrong binary --
# Tools/Scripts/run-minibrowser, not MiniBrowser -- or double up the attach
# script already assembled. --process ui moves it into
# WEBKIT_MINI_BROWSER_PREFIX instead, the hook run-minibrowser reads after
# setting up the port's own launch environment (webkitpy/port/{gtk,wpe}.py).
if [ -n "$CMAKE_BROWSER" ]; then
    [ -n "$MB_PREFIX" ] && add_env "WEBKIT_MINI_BROWSER_PREFIX=$(sh_quote "$WRAP")"
    WRAP=""
fi

# --- what has to be true before anything runs ---------------------------------

# Under --dry-run this is reported, not enforced: the point of a dry run is
# to see what an invocation would do, not to refuse describing one.
BIN_PRESENT=""
if [ -z "$ATTACH" ] && [ -n "${BIN:-}" ]; then
    if t_exec "$NAME" test -x "$BIN" 2>/dev/null; then
        BIN_PRESENT=1
    elif [ -z "$DRY" ]; then
        die "nothing to profile: no $(basename "$BIN") at $BIN
    Build it first:  wk build $NAME $CONFIG"
    fi
fi

if [ -n "$NEEDS" ] && [ -z "$DRY" ]; then
    t_exec "$NAME" command -v "$NEEDS" >/dev/null 2>&1 || die "$NEEDS is not installed in '$NAME'.
    It is provisioning, not a per-run step -- see the provisioning half of
    docs/Urgent/HANDOFF-profile.md. Until that lands:
        wk enter $NAME     and install it there, or
        wk profile $NAME --mode sampling   which needs no tools at all."
fi

# samply reads the kernel's perf events, refused by the default paranoia
# level; the sysctl is not namespaced, so a container cannot set it, which
# reads from inside the workspace as a permission problem with samply.
#
# On Linux, where the workspace's host and the sysctl's host are the same
# machine, the quiesce helper's perf-on verb lowers it (same helper cmd/quiesce
# and cmd/session use). On macOS the container runs inside the podman VM, a
# different kernel the helper has no reach into, so the old by-hand refusal
# still applies there.
if [ "$MODE" = samply ] && [ -z "$DRY" ]; then
    _par=$(t_exec "$NAME" cat /proc/sys/kernel/perf_event_paranoid 2>/dev/null | tr -dc '0-9') || _par=""
    if [ -n "$_par" ] && [ "$_par" -gt 1 ] && is_linux && [ -x "$PRIV" ]; then
        info "perf_event_paranoid is $_par on this host -- asking the quiesce helper to unrestrict it"
        sudo -n "$PRIV" perf-on >/dev/null 2>&1 || true
        _par=$(t_exec "$NAME" cat /proc/sys/kernel/perf_event_paranoid 2>/dev/null | tr -dc '0-9') || _par=""
    fi
    if [ -n "$_par" ] && [ "$_par" -gt 1 ]; then
        if ! is_linux; then
            die "perf_event_paranoid is $_par in '$NAME', and samply needs 1 or less.
    It is a host setting and cannot be written from inside a workspace (the
    sysctl is not namespaced -- sudo in there fails with 'permission denied on
    key'). On the machine that runs the workspace:
        echo 1 | sudo tee /proc/sys/kernel/perf_event_paranoid
    On a booted benchmark image it is set already (docs/HANDOFF-boot.md)."
        elif [ ! -x "$PRIV" ]; then
            die "perf_event_paranoid is $_par in '$NAME', and samply needs 1 or less.
    The privileged helper that can lower it is not installed on this host.
    Remedy:  ./setup --stage quiesce"
        else
            die "perf_event_paranoid is $_par in '$NAME', and samply needs 1 or less.
    Asking the quiesce helper ('$PRIV perf-on') did not bring it down --
    passwordless sudo is likely not set up for it.
    Remedy:  ./setup --stage quiesce"
        fi
    fi
fi

# --- run it -------------------------------------------------------------------

if [ -z "$TARGET_CMD" ]; then
    TARGET_CMD="$(sh_quote "$BIN")${JSC_FLAGS:+ $JSC_FLAGS}"
    [ ${#ARGS[@]} -gt 0 ] && TARGET_CMD="$TARGET_CMD $(sh_quote "${ARGS[@]}")"
fi

# pipefail with the tee, or the run's status becomes tee's own and every
# crash reads as a clean exit.
[ -n "$TEE" ] && TARGET_CMD="set -o pipefail; $TARGET_CMD 2>&1 | tee $(sh_quote "$TEE")"

CMD="$PRELUDE
mkdir -p $(sh_quote "$OUTDIR")
${PRE:+$PRE
}${JSC_ENV:+export$JSC_ENV
}${WRAP:+$WRAP }$TARGET_CMD"

if [ -n "$DRY" ]; then
    info "dry run -- nothing was profiled"
    log  "  workspace: $NAME ($TARGET), config: $CONFIG, mode: $MODE"
    log  "  subject:   $SUBJECT${BIN:+ (${BIN_PRESENT:+built: }${BIN_PRESENT:-NOT BUILT: }$BIN)}"
    log  "  output:    $OUTDIR"
    log  "  in the workspace:"
    printf '%s\n' "$CMD" | sed 's/^/    /' >&2
    [ -n "$POST" ] && { log "  and afterwards:"; printf '%s\n' "$POST" | sed 's/^/    /' >&2; }
    exit 0
fi

info "$MODE: $SUBJECT in '$NAME' ($CONFIG)"
log  "  output: $OUTDIR"

# A tty when the subject is interactive: xctrace and an attached samply both
# expect ctrl-c, which without a pty kills the ssh instead of the recorder.
if [ -n "$ATTACH" ] || [ -n "$BROWSER" ]; then
    t_exec_tty "$NAME" bash -lc "cd $(sh_quote "$SRC") && $CMD"
else
    t_exec "$NAME" bash -lc "cd $(sh_quote "$SRC") && $CMD"
fi

[ -n "$POST" ] && t_exec "$NAME" bash -lc "$POST" || true

# --- what to do with it -------------------------------------------------------

info "recorded in '$NAME': $ARTIFACT"

if [ -n "$FETCH" ]; then
    [ -n "$FETCH_DIR" ] || FETCH_DIR="$(wk_state_dir)/profiles/$NAME/$RUN"
    # The whole run directory in one copy (t_pull_dir), not a loop over
    # t_pull: a loop only reaches top-level files, silently missing a
    # subdirectory like instruments' .trace bundle. Replaces the
    # destination's contents rather than merging (lib/target.sh).
    if t_pull_dir "$NAME" "$OUTDIR" "$FETCH_DIR" 2>/dev/null; then
        info "copied to $FETCH_DIR"
    else
        warn "could not copy '$OUTDIR' out of '$NAME'"
    fi
fi

case "$MODE" in
samply)
    log "  view it:  samply load $ARTIFACT          (in the workspace)"
    log "            or --fetch it here and open it at profiler.firefox.com --"
    log "            the file is self-contained and the site uploads nothing"
    ;;
instruments)
    log "  view it:  open $ARTIFACT                 (on the machine that has it)"
