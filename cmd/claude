#!/usr/bin/env bash
#
# wk claude <workspace> [claude options] -- run Claude inside a workspace
# wk: where=workspace name=required ready=yes group=workspaces
#
# Permissions are relaxed because the workspace is the blast radius, not the
# machine; this checks the boundary holds before handing over control, rather
# than trusting that setup ran correctly at some point in the past.
#
# The workspace name comes first; everything after it is Claude's, verbatim:
#
#   wk claude bb4 -r          resume, in bb4
#   wk claude bb4 --continue  and so on

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# The dispatcher takes the first non-flag word as the name and strips it,
# leaving Claude's own options in order. A bare session id ahead of the name
# (`wk claude -r <id> <ws>`) is taken by position, not by checking which word
# is a real workspace -- put it after instead: `wk claude <ws> -r <id>`.
NAME="${WK_NAME:-}"
require_name "$NAME"

TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

# `claude` from PATH everywhere provisioning installed it (container, guest);
# a specific path only on a shared machine, where PATH may resolve to
# somebody else's broken system-wide install (see the remote branch below).
CLAUDE_BIN=claude

# ...and which permission mode it starts in, a property of the boundary, not
# a preference. --dangerously-skip-permissions is the point of a sandbox:
# inside a disposable workspace, prompting for each edit buys nothing. A
# shared build machine has no such boundary -- your own uid, other people's
# work on the same filesystem -- so it gets auto instead: unattended for
# ordinary work (reading, editing, building), asking before anything that
# leaves the machine.
CLAUDE_MODE=(--dangerously-skip-permissions)

# --- verify the sandbox ------------------------------------------------------
# Relaxed permissions are defensible only while the boundary holds, and what
# it *is* differs by target -- so this dispatches on the target.

if [ "$WK_TARGET_KIND" = local ]; then
    # This *is* the workspace already; the host verified the boundary when it
    # started it. Nesting another relaxed session here would skip that
    # verification, which is what this refusal prevents.
    die "already inside workspace '$(wk_self)' -- run 'claude' directly"
fi

if [ "$WK_TARGET_KIND" = remote ]; then
    # A barrier, not a refusal -- it's the user's machine and their call. This
    # is the one target with no boundary at all, so the warning is the containment.
    barrier "'$NAME' is on the shared build machine '$TARGET', which has no sandbox at
    all: no container, no separate uid, no filesystem boundary, and other
    people's work on the same machine. An agent there is an agent on that
    machine, with your access."

    # Forced, and now it has to actually work.
    #
    # Test the property, not the file (same rule as `wk sudo`): a shared box's
    # `claude` on PATH may be someone else's npm install running under too old
    # a node (Claude Code needs 18+) and dying silently. So find one that
    # *runs*, prefer the one in your own home, and launch it by path -- PATH
    # ordering on a shared machine is not ours to fix.
    CLAUDE_BIN=$(t_exec "$NAME" bash -lc '
        for c in "$HOME/.local/bin/claude" "$(command -v claude 2>/dev/null)"; do
            [ -n "$c" ] && [ -x "$c" ] || continue
            "$c" --version >/dev/null 2>&1 && { echo "$c"; exit 0; }
        done
        exit 1' 2>/dev/null | tr -d '\r' | tail -1) || CLAUDE_BIN=""

    if [ -z "$CLAUDE_BIN" ]; then
        warn "there is no Claude CLI on $TARGET that runs"
        # Single-quoted so the *far* side's shell expands $c and $(node -v);
        # only $TARGET, which just this side knows, is substituted here.
        _diag=$(t_exec "$NAME" bash -lc '
            c=$(command -v claude 2>/dev/null) || true
            if [ -n "$c" ]; then
                echo "  on PATH:  $c"
                echo "  node:     $(node -v 2>&1 | head -1)  (Claude Code needs 18 or newer)"
                # Not the error text: an old-node npm install dies printing a
                # file URL and kilobytes of minified bundle, so this names the
                # command that shows it instead of trying to grep it out.
                echo "  it fails to start; see for yourself:  ssh '"$TARGET"' claude --version"
            else
                echo "  nothing called claude is on PATH in a login shell there"
            fi' 2>/dev/null) || true
        # Captured then printed rather than redirected in place: `2>/dev/null
        # >&2` would send stdout to the /dev/null the first redirect just made.
        [ -z "$_diag" ] || printf '%s\n' "$_diag" >&2

        # Offered, never assumed: installing onto a shared machine is a
        # decision about someone else's machine too (`confirm` declines when
        # there's nobody to ask). Same installer as container/guest, and it
        # carries its own runtime, so it doesn't touch the shared node.
        if confirm "install one on $TARGET now (into your own ~/.local, as you)?"; then
            t_exec "$NAME" bash -lc 'curl -fsSL https://claude.ai/install.sh | bash' \
                || die "the installer failed on $TARGET"
        else
            die "not installing. To do it yourself:
        ssh $TARGET 'curl -fsSL https://claude.ai/install.sh | bash'
    That install goes in your home directory and carries its own runtime, so it
    works whatever node the machine has -- and wk runs it by path, so it wins
    over anything installed system-wide."
        fi

        CLAUDE_BIN=$(t_exec "$NAME" bash -lc '
            for c in "$HOME/.local/bin/claude" "$(command -v claude 2>/dev/null)"; do
                [ -n "$c" ] && [ -x "$c" ] || continue
                "$c" --version >/dev/null 2>&1 && { echo "$c"; exit 0; }
            done
            exit 1' 2>/dev/null | tr -d '\r' | tail -1) || CLAUDE_BIN=""
        [ -n "$CLAUDE_BIN" ] || die "installed, and still nothing on $TARGET runs: try it by hand --
        ssh $TARGET '~/.local/bin/claude --version'"
    fi
    CLAUDE_MODE=(--permission-mode auto)
    info "using $CLAUDE_BIN on $TARGET, in auto mode (this machine is not a sandbox)"
fi

if [ "$WK_TARGET_KIND" = container ]; then
    # `wk verify` measures container properties from inside: no network
    # interface, egress refused outside the allowlist, no host filesystem. If
    # any of that regressed, the right response is to stop, not proceed anyway.
    "$WK_ROOT/cmd/verify" "$NAME" \
        || barrier "the sandbox around '$NAME' is not intact (see above), and relaxed
    permissions are only defensible while it is."
fi

if [ "$WK_TARGET_KIND" = vm ]; then
    # Deliberately NOT `wk verify`: every property it measures is a container
    # property, and a macOS guest has none of them by construction. Its egress
    # is filtered on the *host* by Softnet instead, unmeasurable from in here.
    #
    # Two checks: the filter must exist now, and the guest must not have been
    # *booted* without it -- Softnet applies at `tart run`, so installing it
    # after boot filters nothing until restart. Both fail closed.
    if [ -f "$WK_VM_DIR/$NAME.unfiltered" ] && [ -z "${WK_VM_UNFILTERED:-}" ]; then
        barrier "'$NAME' was booted with NO egress filter.
    Restart it filtered:  wk vm stop $NAME && wk vm start $NAME
    (WK_VM_UNFILTERED=1 is the same decision, said the older way.)"
    fi
    if [ -x "${WK_SOFTNET_BIN:-/usr/local/bin/softnet}" ] && [ -z "${WK_VM_UNFILTERED:-}" ]; then
        info "'$NAME' is a macOS VM: egress is filtered on the host by Softnet,
  default-deny except the wk-proxy address. The host filesystem is unreachable
  and the guest is disposable."
    elif [ -n "${WK_VM_UNFILTERED:-}" ]; then
        warn "WK_VM_UNFILTERED=1: '$NAME' has the open network. The host filesystem
  is still unreachable and the guest is still disposable -- but that is the
  whole of the boundary right now."
    else
        barrier "softnet is not installed, so this guest's egress is not filtered.
    Install it:  ./setup --stage softnet   (needs a terminal)
    (WK_VM_UNFILTERED=1 is the same decision, said the older way.)"
    fi
fi

# --- git push: off while an agent has the keyboard ---------------------------
# The one thing a disposable workspace cannot contain is a push -- it leaves
# the blast radius by definition. So the deploy keys are held back for the
# duration (`wk push`, which moves them out of the mount rather than setting
# a flag an agent could clear).
#
# Turned back on only for an interactive session, where somebody is there to
# notice: a headless run re-enters this command every few minutes via the
# babysitter's fix loop, and leaving push on between attempts would be the
# switch flapping open unattended. Off is also the safe crash/kill direction.
#
# Container targets only: the deploy keys live in the podman VM's store and
# mount only into containers. A macOS guest has none to hold back.
PUSH_WAS_ON=""
if [ "$WK_TARGET_KIND" = container ] && "$WK_ROOT/wk" push status >/dev/null 2>&1; then
    PUSH_WAS_ON=1
    warn "git push is ON -- turning it off while Claude runs in '$NAME'"
    "$WK_ROOT/wk" push off >/dev/null 2>&1 \
        || die "refusing to run: could not hold back the push keys ('wk push status')"
fi

restore_push() {
    [ -n "$PUSH_WAS_ON" ] || return 0
    if [ -t 0 ] && [ -t 1 ]; then
        "$WK_ROOT/wk" push on >/dev/null 2>&1 \
            && info "git push turned back on" \
            || warn "could not turn git push back on -- 'wk push on'"
    else
        log "git push stays off (headless session; 'wk push on' when you want it back)"
    fi
}
wk_atexit restore_push

info "starting Claude in '$NAME' (permissions relaxed; the workspace is the boundary)"

# CLAUDE_MODE was chosen above, with the boundary. Headless when there's no
# terminal: the babysitter's fix loop runs this under nohup with `-p`, and
# t_exec_tty would demand a tty from a process that owns none -- same sandbox
# checks either way, which is why it comes through here rather than running
# claude directly. Not exec'd, so the EXIT trap still runs when Claude exits.
rc=0
if [ -t 0 ] && [ -t 1 ]; then
    t_exec_tty "$NAME" env WK_WORKSPACE="$NAME" \
        bash -lc "cd $(t_src "$NAME") && exec $(sh_quote "$CLAUDE_BIN") $(sh_quote "${CLAUDE_MODE[@]}") $(sh_quote "$@")" || rc=$?
else
    t_exec "$NAME" env WK_WORKSPACE="$NAME" \
        bash -lc "cd $(t_src "$NAME") && exec $(sh_quote "$CLAUDE_BIN") $(sh_quote "${CLAUDE_MODE[@]}") $(sh_quote "$@")" || rc=$?
fi
exit "$rc"
