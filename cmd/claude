#!/usr/bin/env bash
#
# wk claude <workspace> -- run Claude inside a workspace.
#
# Permissions are relaxed because the workspace is the blast radius, not the
# machine. That is only a defensible trade if the boundary actually holds, so
# this checks it before handing over control rather than trusting that setup
# ran correctly at some point in the past.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

NAME="${1:-}"; shift || true
require_name "$NAME"

TARGET="${WK_TARGET:-$(target_of "$NAME" 2>/dev/null || default_target)}"
load_target "$TARGET"

[ "$(t_info "$NAME")" != absent ] || die "no such workspace: $NAME"

# --- verify the sandbox ------------------------------------------------------
# Relaxed permissions are defensible only while the boundary holds, and what the
# boundary *is* differs by target -- so this dispatches on the target rather
# than applying one test everywhere.

if [ "$TARGET" = local ]; then
    # Claude is already in here -- this *is* the workspace, and the host verified
    # the boundary when it started this one. Launching another agent from inside
    # would nest a relaxed-permission session in a sandbox nothing re-measured,
    # which is the one thing the check below exists to prevent.
    die "already inside workspace '$(wk_self)' -- run 'claude' directly"
fi

if [ "$TARGET" = remote ]; then
    die "refusing to run Claude against a remote target: it is a shared machine
    with no isolation at all. Use a container or vm workspace."
fi

if [ "$TARGET" = container ]; then
    # `wk verify` measures the properties from inside the workspace: no network
    # interface, egress refused outside the allowlist, no path with the proxy
    # bypassed, no host filesystem. If any of that has regressed -- a
    # hand-edited container, a proxy that is not running -- the right response
    # is to stop, not to start an autonomous agent anyway.
    "$WK_ROOT/cmd/verify" "$NAME" || die "refusing to run: the sandbox is not intact (see above)"
fi

if [ "$TARGET" = vm ]; then
    # Deliberately NOT `wk verify`. Every property that check measures is a
    # container property -- no network interface, a unix-socket proxy -- and a
    # macOS guest has none of them by construction. Its egress is filtered from
    # the *host* by Softnet instead, which cannot be measured from in here.
    #
    # Two checks. The filter must exist now, and the guest must not have been
    # *booted* without it -- Softnet applies at `tart run`, so a binary
    # installed after boot filters nothing until the guest restarts. The boot
    # writes the marker; both fail closed, matching the container path above.
    if [ -f "$WK_VM_DIR/$NAME.unfiltered" ] && [ -z "${WK_VM_UNFILTERED:-}" ]; then
        die "refusing to run: '$NAME' was booted with NO egress filter.
    Restart it filtered:  wk vm stop $NAME && wk vm start $NAME
    Or set WK_VM_UNFILTERED=1 to say you meant it."
    fi
    if [ -x "${WK_SOFTNET_BIN:-/usr/local/bin/softnet}" ] && [ -z "${WK_VM_UNFILTERED:-}" ]; then
        info "'$NAME' is a macOS VM: egress is filtered on the host by Softnet,
  default-deny except the wk-proxy address. The host filesystem is unreachable
  and the guest is disposable."
    elif [ -n "${WK_VM_UNFILTERED:-}" ]; then
        warn "WK_VM_UNFILTERED=1: '$NAME' has the open network. The host filesystem
  is still unreachable and the guest is still disposable -- but that is the
  whole of the boundary right now."
    else
        die "refusing to run: softnet is not installed, so this guest's egress is
    not filtered. Install it:  ./setup --stage softnet   (needs a terminal)
    Or set WK_VM_UNFILTERED=1 to say you meant it."
    fi
fi

info "starting Claude in '$NAME' (permissions relaxed; the workspace is the boundary)"

# --dangerously-skip-permissions is the point of the sandbox: inside a
# disposable workspace with no host filesystem, prompting for each edit buys
# nothing and prevents unattended work.
t_exec_tty "$NAME" env WK_WORKSPACE="$NAME" \
    bash -lc "cd $(t_src "$NAME") && exec claude --dangerously-skip-permissions $(sh_quote "$@")"
