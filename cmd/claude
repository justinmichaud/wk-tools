#!/usr/bin/env bash
#
# wk claude <workspace> [claude options] -- run Claude inside a workspace
# wk: where=workspace name=required ready=yes group=workspaces
#
# Permissions are relaxed because the workspace is the blast radius, not the
# machine; this checks the boundary holds before handing over control.
#
# The workspace name comes first; everything after it is Claude's, verbatim:
#
#   wk claude bb4 -r          resume, in bb4
#   wk claude bb4 --continue  and so on
#
# --rc: Claude Code Remote Control (claude.ai/code, the mobile app) instead of
# a foreground session here -- a persistent server, started detached in the
# workspace's checkout, left running after this command returns.
#
#   wk claude <ws> --rc          start it (a no-op, reported, if already up)
#   wk claude <ws> --rc --stop   stop it
#
# A fresh workspace needs one interactive `claude` run first, to accept its
# trust dialog -- remote-control refuses without it, and this runs
# 'wk claude <ws>' for you when the workspace has no trust record yet.

set -euo pipefail
WK_ROOT="${WK_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/detach.sh"

# --- claude remote-control: functions ----------------------------------------
# Kept together and above everything else so a test can source just these:
# `WK_CLAUDE_LIB=1 . cmd/claude` defines them and returns (guard below)
# instead of running require_name, load_target and the sandbox checks.
# Fakes for t_exec/t_spawn/t_home/t_src, defined by the caller afterward so
# they win over lib/target.sh's own, make that hermetic (tests/test_claude_rc.py).

# The pid here names a process t_spawn started *inside* the target, not one
# this process forked, so unlike detach_alive, everything below asks the
# driver rather than this host's own process table.
rc_status_file() { printf '%s' "$(wk_ws_dir "$1")/claude-rc.status"; }
rc_log()         { printf '%s' "$(t_home "$1")/claude-remote-control.log"; }
rc_pidfile()     { printf '%s' "$(t_home "$1")/claude-remote-control.pid"; }

rc_alive() {
    local name="$1" pid
    pid=$(status_field "$(rc_status_file "$name")" pid)
    [ -n "$pid" ] || return 1
    t_exec "$name" kill -0 "$pid" >/dev/null 2>&1
}

# Minutes since the status file's `updated=`, for the "already running" report.
rc_minutes() {
    local upd; upd=$(status_field "$(rc_status_file "$1")" updated)
    [ -n "$upd" ] || { printf '?'; return 0; }
    printf '%d' $(( ( $(date -u +%s) - $(utc_to_epoch "$upd") ) / 60 ))
}

# A second call is a no-op, found by rc_alive rather than trusted from state=
# alone: a claim, per lib/detach.sh; the process table is the fact.
rc_start() {
    local name="$1" claude_bin="$2" sf log pidf pid i
    sf=$(rc_status_file "$name")

    if rc_alive "$name"; then
        info "'$name' claude remote-control already running, $(rc_minutes "$name") minutes, log at $(status_field "$sf" log)"
        return 0
    fi

    log=$(rc_log "$name"); pidf=$(rc_pidfile "$name")
    t_exec "$name" mkdir -p "$(t_home "$name")" >/dev/null 2>&1 || true

    t_spawn "$name" "$log" "$pidf" \
        env WK_WORKSPACE="$name" bash -lc \
        "cd $(sh_quote "$(t_src "$name")") && exec $(sh_quote "$claude_bin") remote-control --spawn=same-dir --name $(sh_quote "$name")" \
        || die "could not start claude remote-control in '$name'"

    # t_spawn's pidfile is inside the target -- read back through the driver
    # rather than assumed host-visible, which is only true for container.
    pid=""; i=0
    while [ -z "$pid" ]; do
        pid=$(t_exec "$name" cat "$pidf" 2>/dev/null | tr -d '\r') || pid=""
        [ -n "$pid" ] && break
        i=$((i + 1))
        [ "$i" -gt 50 ] && die "remote-control did not start in '$name' (no pid after 5s)"
        sleep 0.1
    done

    status_write "$sf" state=running "pid=$pid" "log=$log"
    info "claude remote-control running in '$name' (pid $pid), log at $log"
}

# Through the driver, same reasoning as rc_alive. A no-op, reported, when
# nothing is running.
rc_stop() {
    local name="$1" sf pid
    sf=$(rc_status_file "$name")

    if ! rc_alive "$name"; then
        info "claude remote-control is not running in '$name'"
        status_write "$sf" state=stopped
        return 0
    fi

    pid=$(status_field "$sf" pid)
    info "stopping claude remote-control in '$name' (pid $pid)"
    t_exec "$name" kill "$pid" >/dev/null 2>&1 || true
    status_write "$sf" state=stopped "pid=$pid" "log=$(status_field "$sf" log)"
}

# This script has top-level side effects (require_name, load_target, the
# sandbox checks below); WK_CLAUDE_LIB=1 sources only the functions above.
[ "${WK_CLAUDE_LIB:-}" != 1 ] || return 0

# A bare session id ahead of the name (`wk claude -r <id> <ws>`) is taken by
# position, not by checking which word is real -- put it after instead.
NAME="${WK_NAME:-}"
require_name "$NAME"

# wk's own flags come out of argv here, not Claude's, riding to the pass-through below.
RC=""; RC_STOP=""
_rc_args=()
for _a in ${@+"$@"}; do
    case "$_a" in
        --rc)   RC=1 ;;
        --stop) RC_STOP=1 ;;
        *)      _rc_args+=("$_a") ;;
    esac
done
set -- ${_rc_args[@]+"${_rc_args[@]}"}
[ -z "$RC_STOP" ] || [ -n "$RC" ] || die "--stop only makes sense with --rc: wk claude $NAME --rc --stop"
[ -z "$RC" ] || [ $# -eq 0 ] || die "wk claude $NAME --rc takes no other options (got: $*)"

TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

# The permission mode is a property of the boundary, not a preference.
# --dangerously-skip-permissions is the point of a sandbox: inside a
# disposable workspace, prompting for each edit buys nothing. A shared build
# machine has no such boundary, so it gets auto instead: unattended for
# ordinary work, asking before anything that leaves the machine.
CLAUDE_BIN=claude
CLAUDE_MODE=(--dangerously-skip-permissions)

# --- verify the sandbox ------------------------------------------------------
# Relaxed permissions are defensible only while the boundary holds, and what
# it *is* differs by target.

if [ "$WK_TARGET_KIND" = local ]; then
    # This *is* the workspace already; nesting another relaxed session here
    # would skip the boundary check the host already did when it started it.
    die "already inside workspace '$(wk_self)' -- run 'claude' directly"
fi

if [ "$WK_TARGET_KIND" = remote ]; then
    # A barrier, not a refusal: it's the user's machine and their call. This
    # is the one target with no boundary at all, so the warning is the containment.
    barrier "'$NAME' is on the shared build machine '$TARGET', which has no sandbox at
    all: no container, no separate uid, no filesystem boundary, and other
    people's work on the same machine. An agent there is an agent on that
    machine, with your access."

    # Test the property, not the file (same rule as `wk sudo`): a shared box's
    # `claude` on PATH may be someone else's npm install under too old a node
    # (Claude Code needs 18+), dying silently. Find one that *runs*, prefer
    # your own home, and launch it by path.
    CLAUDE_BIN=$(t_exec "$NAME" bash -lc '
        for c in "$HOME/.local/bin/claude" "$(command -v claude 2>/dev/null)"; do
            [ -n "$c" ] && [ -x "$c" ] || continue
            "$c" --version >/dev/null 2>&1 && { echo "$c"; exit 0; }
        done
        exit 1' 2>/dev/null | tr -d '\r' | tail -1) || CLAUDE_BIN=""

    if [ -z "$CLAUDE_BIN" ]; then
        warn "there is no Claude CLI on $TARGET that runs"
        # Single-quoted so the *far* side's shell expands $c and $(node -v);
        # only $TARGET is substituted here.
        _diag=$(t_exec "$NAME" bash -lc '
            c=$(command -v claude 2>/dev/null) || true
            if [ -n "$c" ]; then
                echo "  on PATH:  $c"
                echo "  node:     $(node -v 2>&1 | head -1)  (Claude Code needs 18 or newer)"
                echo "  it fails to start; see for yourself:  ssh '"$TARGET"' claude --version"
            else
                echo "  nothing called claude is on PATH in a login shell there"
            fi' 2>/dev/null) || true
        # Captured then printed: `2>/dev/null >&2` would send stdout to the
        # /dev/null the first redirect just made.
        [ -z "$_diag" ] || printf '%s\n' "$_diag" >&2

        # The same installer as container/guest, into your own ~/.local with
        # its own runtime: it touches nothing shared, so it is not asked about.
        info "installing the Claude CLI on $TARGET (your own ~/.local, as you)"
        t_exec "$NAME" bash -lc 'curl -fsSL https://claude.ai/install.sh | bash' \
            || die "the installer failed on $TARGET. By hand:
        ssh $TARGET 'curl -fsSL https://claude.ai/install.sh | bash'"

        CLAUDE_BIN=$(t_exec "$NAME" bash -lc '
            for c in "$HOME/.local/bin/claude" "$(command -v claude 2>/dev/null)"; do
                [ -n "$c" ] && [ -x "$c" ] || continue
                "$c" --version >/dev/null 2>&1 && { echo "$c"; exit 0; }
            done
            exit 1' 2>/dev/null | tr -d '\r' | tail -1) || CLAUDE_BIN=""
        [ -n "$CLAUDE_BIN" ] || die "installed, and still nothing on $TARGET runs: try it by hand --
        ssh $TARGET '~/.local/bin/claude --version'"
    fi
    CLAUDE_MODE=(--permission-mode auto)
    info "using $CLAUDE_BIN on $TARGET, in auto mode (this machine is not a sandbox)"
fi

# --- nothing an agent runs can publish ----------------------------------------
# The deploy keys are held back for the whole session (`wk push`, which moves
# them out of the mount rather than setting a flag an agent could clear) --
# before `wk verify`, which measures their absence. Off is also the safe
# crash/kill direction. A build box keeps its own keys, so the switch is
# thrown there; a GitHub credential in the account the agent would run as on
# that box is a refusal, not a barrier: nothing in a session may post as the
# person.
PUSH_WAS_ON=""
PUSH_TARGET=""
case "$WK_TARGET_KIND" in
    container) ;;
    remote) PUSH_TARGET="$TARGET" ;;
esac
if [ "$WK_TARGET_KIND" = container ] || [ "$WK_TARGET_KIND" = remote ]; then
    if "$WK_ROOT/wk" push status ${PUSH_TARGET:+--target "$PUSH_TARGET"} >/dev/null 2>&1; then
        PUSH_WAS_ON=1
        warn "git push is ON -- turning it off while Claude runs in '$NAME'"
        "$WK_ROOT/wk" push off ${PUSH_TARGET:+--target "$PUSH_TARGET"} >/dev/null 2>&1 \
            || die "refusing to run: could not hold back the push keys ('wk push status${PUSH_TARGET:+ --target $PUSH_TARGET}')"
    fi
fi
if [ "$WK_TARGET_KIND" = remote ] \
   && t_exec "$NAME" sh -c 'test -e "$HOME/.config/gh/hosts.yml" || { command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; }' 2>/dev/null; then
    die "'$TARGET' holds a GitHub credential in the account Claude would run as
    (~/.config/gh/hosts.yml, or gh is logged in there), and nothing an agent runs
    may post as you. Remedy, on $TARGET:  gh auth logout"
fi

if [ "$WK_TARGET_KIND" = container ]; then
    # `wk verify` measures container properties from inside -- including that
    # the keys are gone -- and if any regressed, the right response is to stop.
    "$WK_ROOT/cmd/verify" "$NAME" \
        || barrier "the sandbox around '$NAME' is not intact (see above), and relaxed
    permissions are only defensible while it is."
fi

if [ "$WK_TARGET_KIND" = vm ]; then
    # Not `wk verify`: every property it measures is a container property, and
    # a macOS guest has none by construction. Its egress is filtered on the
    # *host* by Softnet, unmeasurable from in here. Two checks: the filter
    # must exist now, and the guest must not have been *booted* without it --
    # Softnet applies at `tart run`, so installing it after boot filters
    # nothing until restart. Both fail closed.
    if [ -f "$WK_VM_DIR/$NAME.unfiltered" ] && [ -z "${WK_VM_UNFILTERED:-}" ]; then
        barrier "'$NAME' was booted with NO egress filter.
    Restart it filtered:  wk vm stop $NAME && wk vm start $NAME
    (WK_VM_UNFILTERED=1 is the same decision, said the older way.)"
    fi
    if [ -x "${WK_SOFTNET_BIN:-/usr/local/bin/softnet}" ] && [ -z "${WK_VM_UNFILTERED:-}" ]; then
        info "'$NAME' is a macOS VM: egress is filtered on the host by Softnet,
  default-deny except the wk-proxy address. The host filesystem is unreachable
  and the guest is disposable."
    elif [ -n "${WK_VM_UNFILTERED:-}" ]; then
        warn "WK_VM_UNFILTERED=1: '$NAME' has the open network. The host filesystem
  is still unreachable and the guest is still disposable -- but that is the
  whole of the boundary right now."
    else
        barrier "softnet is not installed, so this guest's egress is not filtered.
    Install it:  ./setup --stage softnet   (needs a terminal)
    (WK_VM_UNFILTERED=1 is the same decision, said the older way.)"
    fi
fi

# --- wk claude <ws> --rc ------------------------------------------------------
# Same sandbox gate above this line as a foreground session; what differs is
# what runs once it holds -- a detached server (rc_start, above) instead of a
# session in this process's own foreground/headless slot.
if [ -n "$RC" ]; then
    if [ -n "$RC_STOP" ]; then
        rc_stop "$NAME"
        exit 0
    fi

    # A background server left running unattended: the keys held back above
    # stay held back -- there is no foreground moment here to notice a session
    # ending and turn push back on.
    if [ -n "$PUSH_WAS_ON" ]; then
        log "  git push stays off ('wk push on' when you want it back)"
        PUSH_WAS_ON=""
    fi

    # remote-control refuses outright without the workspace's trust dialog
    # accepted once ("claude remote-control --help": "Run `claude` first...").
    # There is no non-interactive substitute -- neither -p, a piped stdout,
    # nor any `claude config`/`claude project` subcommand sets it -- so this
    # does what the tool itself says: run `claude` once, interactively, and
    # only when nothing has done that yet.
    if ! rc_alive "$NAME" && ! t_exec "$NAME" test -f "$(t_home "$NAME")/.claude.json" 2>/dev/null; then
        warn "'$NAME' has no Claude trust record yet -- remote-control refuses to start
    until the workspace trust dialog is accepted once, interactively. Running
    'wk claude $NAME' now; accept the dialog, then exit it."
        "$WK_ROOT/wk" claude "$NAME" || true
    fi

    rc_start "$NAME" "$CLAUDE_BIN"
    exit 0
fi

# --- git push: back on only when a person is there to notice -----------------
# A headless run re-enters this command every few minutes via the babysitter's
# fix loop, and leaving push on between attempts would be the switch flapping
# open unattended.
restore_push() {
    [ -n "$PUSH_WAS_ON" ] || return 0
    if [ -t 0 ] && [ -t 1 ]; then
        "$WK_ROOT/wk" push on ${PUSH_TARGET:+--target "$PUSH_TARGET"} >/dev/null 2>&1 \
            && info "git push turned back on" \
            || warn "could not turn git push back on -- 'wk push on'"
    else
        log "git push stays off (headless session; 'wk push on' when you want it back)"
    fi
}
wk_atexit restore_push

info "starting Claude in '$NAME' (permissions relaxed; the workspace is the boundary)"

# Headless when there's no terminal: the babysitter's fix loop runs this
# under nohup with `-p`, and t_exec_tty would demand a tty from a process
# that owns none. Not exec'd, so the EXIT trap still runs when Claude exits.
rc=0
if [ -t 0 ] && [ -t 1 ]; then
    t_exec_tty "$NAME" env WK_WORKSPACE="$NAME" \
        bash -lc "cd $(t_src "$NAME") && exec $(sh_quote "$CLAUDE_BIN") $(sh_quote "${CLAUDE_MODE[@]}") $(sh_quote "$@")" || rc=$?
else
    t_exec "$NAME" env WK_WORKSPACE="$NAME" \
        bash -lc "cd $(t_src "$NAME") && exec $(sh_quote "$CLAUDE_BIN") $(sh_quote "${CLAUDE_MODE[@]}") $(sh_quote "$@")" || rc=$?
fi
exit "$rc"
