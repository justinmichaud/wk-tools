#!/usr/bin/env bash
#
# wk logs <workspace> [--follow] -- the build or image-stage log, with the noise stripped
# wk: where=workspace name=required group=workspaces readonly
#
# ninja writes progress with carriage returns; this normalises that and shows
# the parts worth reading -- the tail after a failure is usually unrelated.
#
#   --follow, -f   stream the log live
#   --all, -a      print the full normalised log

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"

NAME="${WK_NAME:-}"
require_name "$NAME"

load_target "$(ws_target "$NAME")"

WSDIR="$(wk_ws_dir "$NAME")"
LOG="$WSDIR/build.log"
_shown=""
if [ ! -f "$LOG" ]; then
    # An image workspace has no build.log: its stages log to
    # home/<kind>-<stage>.log instead (yocto_log in image/yocto.sh, buildroot_log
    # in image/buildroot.sh). The newest is whichever stage is running or ran last.
    shopt -s nullglob
    _stage_logs=("$WSDIR"/home/yocto-*.log "$WSDIR"/home/buildroot-*.log)
    shopt -u nullglob
    if [ "${#_stage_logs[@]}" -gt 0 ]; then
        LOG=$(ls -1t "${_stage_logs[@]}" | head -1)
        _shown="$LOG"
    else
        die "no build log and no image-stage log for '$NAME' -- has it been
    built? ('wk build', 'wk sysimage build')"
    fi
fi
[ -z "$_shown" ] || info "showing $_shown"

[ $# -le 1 ] || die "usage: wk logs [<workspace>] [--follow|-f|--all|-a]; see wk logs -h"
case "${1:-}" in
--follow|-f) exec tail -f "$LOG" ;;
--all|-a)    exec tr '\r' '\n' < "$LOG" ;;
"") ;;
*) die "usage: wk logs [<workspace>] [--follow|-f|--all|-a]; see wk logs -h" ;;
esac

log "errors:"
first_error "$LOG" | sed 's/^/  /' || log "  (none)"
log ""
log "last output:"
tr '\r' '\n' < "$LOG" | grep -v '^$' | tail -15 | sed 's/^/  /'
log ""
# implicit inside a workspace; noise outside it
_hint=""; in_workspace || _hint=" $NAME"
log "  wk logs$_hint --all     full log"
log "  wk logs$_hint --follow  live"
