#!/usr/bin/env python3
#
# wk logs <workspace> [--follow] -- the build or image-stage log, with the noise stripped
# wk: where=workspace name=required group=workspaces readonly opts --follow,-f,--all,-a,--gates,-g
#
# ninja writes progress with carriage returns; this normalises that and shows
# the first error plus the last output.
#
#   --follow, -f   stream the log live
#   --all, -a      print the full normalised log
#   --gates, -g    the readings this build was collected under: the browser
#                  check, the profile check, and the pinned benchmark payloads

import glob
import os
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import decl, shell, targets  # noqa: E402
from wk.act import Refused, die, info, log  # noqa: E402
from wk.record import first_error, normalised  # noqa: E402

# The readings travel beside the products (lib/wk/bench/mac.py's `PgoCollect.evidence`), read from the build
# the workspace holds now, on the machine holding it, each verdict re-derived by its own checker.
GATES = r'''
set -u
shopt -s nullglob
seen=0
for f in "$SRC"/WebKitBuild/*/wk-browser-check.json; do
    seen=1; printf 'browser check %s\n' "$f"
    python3 "$TOOLS/bench/mac-browser-check.py" --read "$f" 2>&1 | sed 's/^/  /'
done
for f in "$SRC"/WebKitBuild/*/wk-profile-check.json "$SRC"/WebKitBuild/wk-pgo/*/profile-check.json; do
    [ -f "$f" ] || continue
    seen=1; printf 'profile check %s\n' "$f"
    PYTHONPATH="$TOOLS/lib" python3 -m wk.pgo check --read "$f" 2>&1 | sed 's/^/  /'
done
for f in "$SRC"/WebKitBuild/*/wk-payload-pins; do
    seen=1; printf 'benchmark payloads %s\n' "$f"
    sed 's/^/  /' "$f"
done
[ "$seen" = 1 ] || printf 'no readings under %s/WebKitBuild -- only a profile-guided build
collects them (build/mac-pgo.sh beside the products, a board cycle under
wk-pgo/); every other build has no gates.\n' "$SRC"
'''


def resolve_log(target, name):
    ws_dir = target.store.ws_dir(name)
    build_log = os.path.join(ws_dir, "build.log")
    if os.path.isfile(build_log):
        return build_log, False
    stage_logs = glob.glob(os.path.join(ws_dir, "home", "yocto-*.log")) + glob.glob(os.path.join(ws_dir, "home", "buildroot-*.log"))
    if not stage_logs:
        die("no build log and no image-stage log for '%s' -- has it been\n    built? ('wk build', 'wk sysimage build')" % name)
    return max(stage_logs, key=os.path.getmtime), True


def main(argv):
    name = os.environ.get("WK_NAME", "")
    if not name:
        die("wk logs needs a workspace name")
    if len(argv) > 1:
        die("wk logs shows one of --follow, --all or --gates at a time; see wk logs -h")
    reg = targets.Registry(ROOT)
    try:
        target = reg.load(reg.ws_target(name))
    except LookupError as e:
        die(str(e))
    args = decl.Args(decl.Decl(__file__), argv)
    gates = args.flag("--gates") or args.flag("-g")
    follow = args.flag("--follow") or args.flag("-f")
    whole = args.flag("--all") or args.flag("-a")
    if gates:
        r = target.exec(name, ["bash", "-c", "SRC=%s TOOLS=%s\n%s" % (shell.sh_quote(target.src(name)), shell.sh_quote(target.tools(name)), GATES)])
        sys.stdout.write(r.out)
        sys.stderr.write(r.err)
        return r.rc
    path, shown = resolve_log(target, name)
    if shown:
        info("showing %s" % path)
    if follow:
        sys.stdout.flush()
        os.execvp("tail", ["tail", "-f", path])
    if whole:
        sys.stdout.write(normalised(path))
        return 0
    log("errors:")
    errors = first_error(path)
    for e in errors:
        log("  " + e)
    if not errors:
        log("  (none)")
    log("")
    log("last output:")
    for line in [l for l in normalised(path).split("\n") if l][-15:]:
        log("  " + line)
    log("")
    hint = "" if reg.in_workspace() else " " + name
    log("  wk logs%s --all     full log" % hint)
    log("  wk logs%s --follow  live" % hint)
    log("  wk logs%s --gates   the readings this build was collected under" % hint)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
