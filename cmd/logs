#!/usr/bin/env bash
#
# wk logs <workspace> [--follow] -- the build or image-stage log, with the noise stripped
# wk: where=workspace name=required group=workspaces readonly opts --follow,-f,--all,-a,--gates,-g
#
# ninja writes progress with carriage returns; this normalises that and shows
# the first error plus the last output.
#
#   --follow, -f   stream the log live
#   --all, -a      print the full normalised log
#   --gates, -g    the readings this build was collected under: the browser
#                  check, the profile check, and the pinned benchmark payloads

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"

NAME="${WK_NAME:-}"
require_name "$NAME"

load_target "$(ws_target "$NAME")"

WSDIR="$(wk_ws_dir "$NAME")"
LOG="$WSDIR/build.log"

resolve_log() {
    local shown=""
    if [ ! -f "$LOG" ]; then
        shopt -s nullglob
        local stage_logs=("$WSDIR"/home/yocto-*.log "$WSDIR"/home/buildroot-*.log)
        shopt -u nullglob
        if [ "${#stage_logs[@]}" -gt 0 ]; then
            LOG=$(ls -1t "${stage_logs[@]}" | head -1) || LOG=""
            shown="$LOG"
        else
            die "no build log and no image-stage log for '$NAME' -- has it been
    built? ('wk build', 'wk sysimage build')"
        fi
    fi
    [ -z "$shown" ] || info "showing $shown"
}

# The readings travel beside the products (build/mac-pgo.sh's `_pgo_evidence`), so they are read from the build this workspace holds now, on the machine holding it, and each verdict is re-derived by the checker that took the reading rather than remembered from the build.
gates() {
    local script
    script=$(cat <<'GATES'
set -u
shopt -s nullglob
seen=0
for f in "$SRC"/WebKitBuild/*/wk-browser-check.json; do
    seen=1; printf 'browser check %s\n' "$f"
    python3 "$TOOLS/bench/mac-browser-check.py" --read "$f" 2>&1 | sed 's/^/  /'
done
for f in "$SRC"/WebKitBuild/*/wk-profile-check.json "$SRC"/WebKitBuild/wk-pgo/*/profile-check.json; do
    [ -f "$f" ] || continue
    seen=1; printf 'profile check %s\n' "$f"
    python3 "$TOOLS/lib/wkpgo.py" check --read "$f" 2>&1 | sed 's/^/  /'
done
for f in "$SRC"/WebKitBuild/*/wk-payload-pins; do
    seen=1; printf 'benchmark payloads %s\n' "$f"
    sed 's/^/  /' "$f"
done
[ "$seen" = 1 ] || printf 'no readings under %s/WebKitBuild -- only a profile-guided build
collects them (build/mac-pgo.sh beside the products, image/pgo.sh under
wk-pgo/); every other build has no gates.\n' "$SRC"
GATES
)
    t_exec "$NAME" bash -c "SRC=$(sh_quote "$(t_src "$NAME")") TOOLS=$(sh_quote "$(t_tools "$NAME")")
$script"
}

[ $# -le 1 ] || die "wk logs shows one of --follow, --all or --gates at a time; see wk logs -h"
case "${1:-}" in
--gates|-g)  gates; exit 0 ;;
--follow|-f) resolve_log; exec tail -f "$LOG" ;;
--all|-a)    resolve_log; exec tr '\r' '\n' < "$LOG" ;;
"")          resolve_log ;;
esac

log "errors:"
first_error "$LOG" | sed 's/^/  /' || log "  (none)"
log ""
log "last output:"
tr '\r' '\n' < "$LOG" | grep -v '^$' | tail -15 | sed 's/^/  /'
log ""
_hint=""; in_workspace || _hint=" $NAME"
log "  wk logs$_hint --all     full log"
log "  wk logs$_hint --follow  live"
log "  wk logs$_hint --gates   the readings this build was collected under"
