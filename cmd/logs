#!/usr/bin/env bash
#
# wk logs <workspace> [--follow] -- the build log, with the noise stripped.
#
# ninja writes progress with carriage returns, so a raw `tail` shows one
# unreadable smear. This normalises that and, by default, shows the parts worth
# reading rather than the last N lines -- after a failure the tail is usually
# unrelated, because compilers keep going past the first error.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"

# Inside a workspace the name is implicit -- see cmd/build -- so `wk logs -f`
# follows this workspace's own build.
NAME="${1:-}"
if in_workspace && [ "$NAME" != "$(wk_self)" ]; then
    NAME=$(wk_self)
else
    shift || true
fi
require_name "$NAME"

# The log lives wherever that workspace's target keeps its state, which is not
# the same place for a container and a macOS VM.
load_target "${WK_TARGET:-$(target_of "$NAME" 2>/dev/null || default_target)}"
LOG="$(wk_ws_dir "$NAME")/build.log"
[ -f "$LOG" ] || die "no build log for '$NAME' -- has it been built?"

case "${1:-}" in
--follow|-f) exec tail -f "$LOG" ;;
--all|-a)    exec tr '\r' '\n' < "$LOG" ;;
esac

log "errors:"
first_error "$LOG" | sed 's/^/  /' || log "  (none)"
log ""
log "last output:"
tr '\r' '\n' < "$LOG" | grep -v '^$' | tail -15 | sed 's/^/  /'
log ""
# The name is part of the hint on a host and noise inside a workspace, where it
# is implicit and the command as printed would still work either way.
_hint=""; in_workspace || _hint=" $NAME"
log "  wk logs$_hint --all     full log"
log "  wk logs$_hint --follow  live"
