#!/usr/bin/env bash
#
# wk logs <workspace> [--follow] -- the build log, with the noise stripped.
#
# ninja writes progress with carriage returns, so a raw `tail` shows one
# unreadable smear. This normalises that and, by default, shows the parts worth
# reading rather than the last N lines -- after a failure the tail is usually
# unrelated, because compilers keep going past the first error.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"

# Inside a workspace there is no name to give: every command acts on this one,
# and the name form is refused rather than quietly accepted (refuse_ws_name,
# lib/target.sh). Everything else on the command line is this command's own
# argument, including the very first word.
NAME="${1:-}"
if in_workspace; then
    refuse_ws_name "$NAME" logs "[-f]"
    NAME=$(wk_self)
else
    shift || true
fi
require_name "$NAME"

# The log lives wherever that workspace's target keeps its state, which is not
# the same place for a container and a macOS VM.
load_target "$(ws_target "$NAME")"

# The canonical log for a target that is a machine of its own is on that
# machine -- written there by the build itself, whichever end started it. Ask
# it rather than reading the transcript this side happens to hold, which is
# empty for every build driven from the other one.
#
# The whole command goes over, arguments included, so --all and --follow behave
# the same as they do locally. A ctrl-c out of --follow closes the connection,
# which ends the `tail -f` with it.
if t_has_wk; then
    rc=0
    t_wk logs "$NAME" ${@+"$@"} || rc=$?
    exit "$rc"
fi

LOG="$(wk_ws_dir "$NAME")/build.log"
[ -f "$LOG" ] || die "no build log for '$NAME' -- has it been built?"

case "${1:-}" in
--follow|-f) exec tail -f "$LOG" ;;
--all|-a)    exec tr '\r' '\n' < "$LOG" ;;
esac

log "errors:"
first_error "$LOG" | sed 's/^/  /' || log "  (none)"
log ""
log "last output:"
tr '\r' '\n' < "$LOG" | grep -v '^$' | tail -15 | sed 's/^/  /'
log ""
# The name is part of the hint on a host and noise inside a workspace, where it
# is implicit and the command as printed would still work either way.
_hint=""; in_workspace || _hint=" $NAME"
log "  wk logs$_hint --all     full log"
log "  wk logs$_hint --follow  live"
