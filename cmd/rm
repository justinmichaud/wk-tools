#!/usr/bin/env bash
#
# wk rm <name>... -- destroy one or more workspaces and everything they created
# wk: where=workspace name=required lifecycle post=ssh-alias-remove group=workspaces
#
# The container, the overlay, the home directory and the ssh alias all go;
# shared caches (ccache, yocto, buildroot) survive.
#
# `wk rm a b c` is three removals: one confirmation for all, each destroyed
# independently.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/task.sh"
. "$WK_ROOT/lib/watchdog.sh"

NAME="${WK_NAME:-}"
require_name "$NAME"

NAMES=("$NAME")
for _a in ${@+"$@"}; do
    case "$_a" in
        -*) die "usage: wk rm <name>...; unknown option: $_a; see wk rm -h" ;;
    esac
    require_name "$_a"
    NAMES+=("$_a")
done

ws_task_records() { # <name> -- every task record written for it (lib/task.sh)
    local d
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        [ "$(task_field "$d" name)" = "$1" ] || continue
        printf '%s\n' "$d"
    done <<EOF
$(task_list)
EOF
}

# The rc task is not in here: rm stops that one itself, with the workspace it runs in.
ws_task_live_lines() { # <name> -- one line per running job, with the command that stops it
    local d
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        [ "$(task_field "$d" kind)" = rc ] && continue
        task_alive "$d" || continue
        printf '    %s (pid %s on %s)  stop it:  %s\n' \
            "$(task_field "$d" kind)" "$(task_field "$d" pid)" \
            "$(task_field "$d" machine)" "$(task_field "$d" kill)"
    done <<EOF
$(ws_task_records "$1")
EOF
}

ws_task_records_remove() { # <name> -- rm's own convergence: no record outlives its workspace
    local d
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        rm -rf "$d"
    done <<EOF
$(ws_task_records "$1")
EOF
}

# rm_plan <name> -- a subshell, mutating nothing: "<target> workspace" (an environment or its record is here), "<target> record" (only a creation record); exit 1 when there is nothing, exit 2 having said why when there is no record here and the machine did not answer.
rm_plan() (
    set -euo pipefail
    local NAME="$1" TARGET _t _d
    TARGET="$(ws_target "$NAME")"
    load_target "$TARGET"
    if [ -d "$(wk_ws_dir "$NAME")" ]; then printf '%s workspace\n' "$TARGET"; exit 0; fi
    t_answers || { err "'$NAME' has no record here, and $TARGET did not answer: $WK_FAR_WHY
    Nothing this end can see is there to destroy; re-run once $TARGET answers."; exit 2; }
    if [ "$(t_info "$NAME")" != absent ]; then printf '%s workspace\n' "$TARGET"; exit 0; fi
    # ws_target guesses once nothing answers for the name, so ask each target's store.
    _d=$(ws_create_task "$NAME")
    if [ -z "$_d" ]; then
        for _t in $(target_all 2>/dev/null); do
            [ "$_t" = "$TARGET" ] && continue
            load_target "$_t"
            _d=$(ws_create_task "$NAME")
            [ -n "$_d" ] || continue
            TARGET="$_t"; break
        done
    fi
    [ -n "$_d" ] || exit 1
    printf '%s record\n' "$TARGET"
)

# rm_one <name> <target> <what> -- a subshell, so a refusal ends only this one name's attempt.
rm_one() (
    set -euo pipefail
    local NAME="$1" TARGET="$2" WHAT="$3" ws clog n rc left _live

    load_target "$TARGET"
    ws=$(wk_ws_dir "$NAME")
    clog=$(ws_create_log "$NAME")

    if [ "$WHAT" = record ]; then
        hold_lock "ws-$NAME"
        ws_task_records_remove "$NAME"
        rm -f "$clog"
        ssh_alias_remove "$NAME"
        info "'$NAME' had nothing left but its record; forgotten"
        exit 0
    fi

    if [ "$WK_TARGET_KIND" = local ]; then t_destroy "$NAME"; fi

    # A job left writing into a destroyed workspace compiles into nothing, so this refuses rather than racing it.
    _live=$(ws_task_live_lines "$NAME")
    [ -z "$_live" ] || die "'$NAME' has work running in it, and destroying it under a running job
    leaves that job compiling into a directory that is gone:
$_live"

    hold_lock "ws-$NAME"
    if t_needs_base; then hold_lock store -s; fi

    if [ -d "$ws/changes" ]; then
        n=$(find "$ws/changes" -type f 2>/dev/null | wc -l | tr -d ' ')
        if [ "$n" -gt 0 ]; then warn "$NAME has $n modified file(s) in its overlay"; fi
    fi

    # t_destroy kills claude remote-control with a container or guest, not with a checkout.
    [ "$WK_TARGET_KIND" != remote ] || rc_stop "$NAME"

    rc=0
    t_destroy "$NAME" || rc=$?

    left=""
    [ "$(t_info "$NAME")" = absent ] || left="$left the $TARGET environment"
    if [ -d "$ws" ]; then left="$left $ws"; fi

    if [ -n "$left" ] || [ "$rc" -ne 0 ]; then
        warn "'$NAME' was not fully destroyed; still here:$left"
        log  "  re-run 'wk rm $NAME' -- what is left is exactly what it will find and retry"
        exit 1
    fi

    ws_task_records_remove "$NAME"
    rm -f "$clog"
    ssh_alias_remove "$NAME"

    info "workspace '$NAME' destroyed"
)

worst=0
FOUND=(); TARGETS=(); WHATS=(); _list=""
for _n in "${NAMES[@]}"; do
    rc=0; _p=$(rm_plan "$_n") || rc=$?
    case "$rc" in
        0) # shellcheck disable=SC2086 -- "<target> <what>" is two words by construction.
           set -- $_p
           FOUND+=("$_n"); TARGETS+=("$1"); WHATS+=("$2"); _list="$_list '$_n'" ;;
        1) err "no such workspace: $_n"; worst=1 ;;
        *) worst=1 ;;
    esac
done
[ "${#FOUND[@]}" -gt 0 ] || exit "$worst"

confirm "destroy workspace(s)${_list} and all their changes?" || die "aborted"

_i=0
for _n in "${FOUND[@]}"; do
    rc=0
    rm_one "$_n" "${TARGETS[$_i]}" "${WHATS[$_i]}" || rc=$?
    [ "$rc" -gt "$worst" ] && worst=$rc
    _i=$((_i + 1))
done
exit "$worst"
