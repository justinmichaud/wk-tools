#!/usr/bin/env bash
#
# wk rm <name>... -- destroy one or more workspaces and everything they created
# wk: where=workspace name=required lifecycle post=ssh-alias-remove group=workspaces
#
# Thorough, since this is the guarantee that makes workspaces disposable: the
# container, the overlay, the home directory and the ssh alias all go. Shared
# caches (ccache, yocto, buildroot) survive -- they are why the next build is fast.
#
# `wk`'s header resolves only the first name into WK_NAME, leaving the rest in
# argv, so `wk rm a b c` becomes three removals: one confirmation for all,
# each destroyed independently, not stopped by another's refusal.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/detach.sh"

NAME="${WK_NAME:-}"
require_name "$NAME"

NAMES=("$NAME")
for _a in ${@+"$@"}; do NAMES+=("$_a"); done

# WK_YES=1 makes rm_one's own confirmation a no-op once this one is answered.
_list=""
for _n in "${NAMES[@]}"; do _list="$_list '$_n'"; done
confirm "destroy workspace(s)${_list} and all their changes?" || die "aborted"
export WK_YES=1

# rm_one <name> -- everything a single `wk rm <name>` does, in a subshell so
# a refusal ends only this one name's attempt. Each name gets its own target
# load and its own locks, held only for as long as this subshell runs.
rm_one() (
    set -euo pipefail
    local NAME="$1" TARGET ws sf clog n rc left _t _sf _pid

    TARGET="$(ws_target "$NAME")"
    load_target "$TARGET"

    # Refuse before asking: prompting for a decision that cannot be carried
    # out either way is worse than saying so straight away.
    if [ "$WK_TARGET_KIND" = local ]; then t_destroy "$NAME"; fi

    ws=$(wk_ws_dir "$NAME")

    # Beside the workspace directory, not in it (lib/target.sh), so named
    # here: left behind, `wk status` would report a workspace gone anywhere.
    sf=$(ws_status_file "$NAME")
    clog=$(ws_create_log "$NAME")

    # Before the lock: a creation in flight holds it, so waiting for it and
    # then destroying what it just made would look exactly like a slow `wk rm`.
    if detach_alive "$sf"; then
        warn "'$NAME' is being created right now (pid $(status_field "$sf" pid), at stage
  '$(status_field "$sf" stage)') -- this will wait for that to finish and then
  destroy it. Ctrl-C now if that is not what you meant."
    fi

    # The workspace being destroyed, and the store -- `wk gc` must not be
    # counting references while this is removing one.
    hold_lock "ws-$NAME"
    if t_needs_base; then hold_lock store -s; fi

    # Nothing left but the record: this is what a `wk rm` killed right after
    # `wk new` took its lock, before anything existed, leaves behind, and
    # re-running it has to finish the job.
    if [ ! -d "$ws" ] && [ "$(t_info "$NAME")" = absent ]; then
        # ws_target falls back to a guess once nothing else answers for the
        # name, so every target's own store is asked directly for the record.
        if [ ! -f "$sf" ]; then
            for _t in $(target_all 2>/dev/null); do
                [ "$_t" = "$TARGET" ] && continue
                load_target "$_t"
                _sf=$(ws_status_file "$NAME")
                [ -f "$_sf" ] || continue
                TARGET="$_t"; sf="$_sf"; clog=$(ws_create_log "$NAME")
                break
            done
        fi
        if [ -f "$sf" ]; then
            rm -f "$sf" "$clog"
            ssh_alias_remove "$NAME"
            info "'$NAME' had nothing left but its record; forgotten"
            exit 0
        fi
        die "no such workspace: $NAME"
    fi


    # Uncommitted work lives only in the overlay layer, so warn before discarding.
    if [ -d "$ws/changes" ]; then
        n=$(find "$ws/changes" -type f 2>/dev/null | wc -l | tr -d ' ')
        if [ "$n" -gt 0 ]; then warn "$NAME has $n modified file(s) in its overlay"; fi
    fi

    confirm "destroy workspace '$NAME' and all its changes?" || die "aborted"

    # claude remote-control runs detached inside the target; t_destroy takes
    # it down with a container or guest, but a remote target's checkout keeps
    # running, so a live server there would otherwise outlive the workspace.
    if [ "$WK_TARGET_KIND" = remote ]; then
        _sf="$(wk_ws_dir "$NAME")/claude-rc.status"
        _pid=$([ -f "$_sf" ] && status_field "$_sf" pid || true)
        if [ -n "$_pid" ] && t_exec "$NAME" kill -0 "$_pid" >/dev/null 2>&1; then
            info "stopping claude remote-control in '$NAME' (pid $_pid)"
            t_exec "$NAME" kill "$_pid" >/dev/null 2>&1 || true
            status_write "$_sf" state=stopped "pid=$_pid"
        fi
    fi

    # The artifacts first, the bookkeeping last: what actually happened is
    # re-derived from evidence (t_info, $ws) on every attempt, never assumed.
    rc=0
    t_destroy "$NAME" || rc=$?

    left=""
    [ "$(t_info "$NAME")" = absent ] || left="$left the $TARGET environment"
    if [ -d "$ws" ]; then left="$left $ws"; fi

    if [ -n "$left" ] || [ "$rc" -ne 0 ]; then
        warn "'$NAME' was not fully destroyed; still here:$left"
        log  "  re-run 'wk rm $NAME' -- what is left is exactly what it will find and retry"
        exit 1
    fi

    rm -f "$sf" "$clog"
    ssh_alias_remove "$NAME"

    info "workspace '$NAME' destroyed"
)

worst=0
for _n in "${NAMES[@]}"; do
    rc=0
    rm_one "$_n" || rc=$?
    [ "$rc" -gt "$worst" ] && worst=$rc
done
exit "$worst"
