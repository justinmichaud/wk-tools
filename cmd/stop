#!/usr/bin/env bash
#
# wk stop -- shut everything down without destroying anything.
#
# Stops every workspace container and then the podman machine, which is what
# actually returns CPU and memory to the host: a stopped container inside a
# running VM still costs you the VM's whole allocation.
#
# Nothing is deleted. The overlay layer, the build tree, the home directory and
# the container itself all persist -- that is exactly why the overlay is
# declared with an explicit upperdir rather than a bare :O, which podman would
# discard on stop.
#
# macOS VMs are stopped too, and first: a guest holds its entire allocation
# whether or not anything is building in it, so it is the largest thing on the
# machine by some way.
#
#   wk stop              macOS VMs, containers, then the machine
#   wk stop --keep-vm    macOS VMs and containers, leave the machine running

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"

WK_MACHINE="${WK_MACHINE:-wk}"
KEEP_VM=""
[ "${1:-}" = --keep-vm ] && KEEP_VM=1

# On macOS this half runs on the host, so reach into the machine for the
# containers. Named _in_machine rather than _vm because targets/vm.sh defines
# its own _vm(), and sourcing that below would otherwise clobber this silently.
_in_machine() {
    if is_macos && [ -z "${WK_IN_VM:-}" ]; then
        podman machine ssh "$WK_MACHINE" "$@" </dev/null
    else
        bash -c "$*" </dev/null
    fi
}

# Deliberately before the podman-machine check: if the machine is already
# stopped, a running macOS VM is *still* holding memory, and exiting early
# without touching it would report "nothing to do" while 20 GB stayed spoken
# for.
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    . "$WK_ROOT/lib/target.sh"
    . "$WK_ROOT/targets/vm.sh"
    if _tart_bin >/dev/null 2>&1; then
        for _guest in $(t_list 2>/dev/null | awk -F'\t' '$2 == "running" { print $1 }'); do
            t_stop "$_guest"
        done
    fi
fi

if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    state=$(podman machine inspect "$WK_MACHINE" --format '{{.State}}' 2>/dev/null || echo absent)
    if [ "$state" != running ]; then
        info "machine '$WK_MACHINE' is already $state -- nothing to do"
        exit 0
    fi
fi

running=$(_in_machine 'sudo podman ps --filter "name=^wk-" --format "{{.Names}}"' || true)
if [ -n "$running" ]; then
    printf '%s\n' "$running" | sed 's/^/  stopping /' >&2
    # A build mid-flight gets SIGTERM and then SIGKILL. ccache and the overlay
    # are both crash-safe, so the worst case is recompiling the current file.
    _in_machine 'sudo podman stop --time 30 $(sudo podman ps --filter "name=^wk-" --format "{{.Names}}" | tr "\n" " ") >/dev/null'
    info "stopped $(printf '%s\n' "$running" | wc -l | tr -d ' ') container(s)"
else
    info "no running containers"
fi

if [ -n "$KEEP_VM" ]; then
    log "leaving the machine running (--keep-vm)"
elif is_macos && [ -z "${WK_IN_VM:-}" ]; then
    info "stopping the machine"
    podman machine stop "$WK_MACHINE" >/dev/null
    info "machine stopped -- CPU and memory returned to the host"
fi
