#!/usr/bin/env bash
#
# wk stop [<workspace>] [--keep-vm] -- shut down one workspace, or everything
# wk: where=workspace name=optional forward=no group=hosts needs podman
#
# A named workspace: stops only its container or macOS guest (t_stop); nothing
# on disk is touched.
#
# `forward=no`: runs on the host holding the environment -- stopping its own
# containers from inside the podman VM would kill the ssh session mid-word.
#
# No workspace: every container, the macOS VMs first (a guest holds its full
# allocation regardless of what it's building), then the machine.
#
#   wk stop                  macOS VMs, containers, then the machine
#   wk stop --keep-vm        macOS VMs and containers, leave the machine running
#   wk stop <workspace>      only that workspace's environment

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/detach.sh"

WK_MACHINE="${WK_MACHINE:-wk}"

NAME="${WK_NAME:-}"

if [ -n "$NAME" ]; then
    [ $# -eq 0 ] || die "usage: wk stop [<workspace>] [--keep-vm]; see wk stop -h
    'wk stop $NAME' takes no options -- --keep-vm only applies to a bare 'wk stop'"
    TARGET="$(ws_target "$NAME")"
    load_target "$TARGET"
    [ "$(t_info "$NAME")" != absent ] || die "no such workspace: $NAME"

    # claude remote-control runs detached inside the target; t_stop takes it
    # down with a container or guest, but a remote target's checkout keeps
    # running, so it is killed here.
    if [ "$WK_TARGET_KIND" = remote ]; then
        _rc_sf="$(wk_ws_dir "$NAME")/claude-rc.status"
        _rc_pid=$([ -f "$_rc_sf" ] && status_field "$_rc_sf" pid || true)
        if [ -n "$_rc_pid" ] && t_exec "$NAME" kill -0 "$_rc_pid" >/dev/null 2>&1; then
            info "stopping claude remote-control in '$NAME' (pid $_rc_pid)"
            t_exec "$NAME" kill "$_rc_pid" >/dev/null 2>&1 || true
            status_write "$_rc_sf" state=stopped "pid=$_rc_pid"
        fi
    fi

    t_stop "$NAME"
    exit 0
fi

KEEP_VM=""
case "${1:-}" in
    --keep-vm) KEEP_VM=1; shift ;;
    "") ;;
    *) die "usage: wk stop [<workspace>] [--keep-vm]; see wk stop -h
    unexpected argument: $1" ;;
esac
[ $# -eq 0 ] || die "usage: wk stop [<workspace>] [--keep-vm]; see wk stop -h
    unexpected argument: $1"

# Before the podman-machine check: a macOS VM holds its memory even with the machine stopped.
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    . "$WK_ROOT/targets/vm.sh"
    if _tart_bin >/dev/null 2>&1; then
        for _guest in $(t_list 2>/dev/null | awk -F'\t' '$2 == "running" { print $1 }'); do
            t_stop "$_guest"
        done
    fi
fi

if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    state=$(_machine_state "$WK_MACHINE")
    if [ "$state" != running ]; then
        info "machine '$WK_MACHINE' is already $state -- nothing to do"
        exit 0
    fi
fi

# Plain podman, not sudo: workspaces are rootless, owned by the machine's own user; `sudo podman` looks at root's (empty) storage.
running=$(_in_machine 'podman ps --filter "name=^wk-" --format "{{.Names}}"' || true)
if [ -n "$running" ]; then
    printf '%s\n' "$running" | sed 's/^/  stopping /' >&2
    # A build mid-flight gets SIGTERM then SIGKILL: ccache and the overlay are both crash-safe, so the worst case is recompiling the current file.
    _in_machine 'podman stop --time 30 $(podman ps --filter "name=^wk-" --format "{{.Names}}" | tr "\n" " ") >/dev/null'
    info "stopped $(printf '%s\n' "$running" | wc -l | tr -d ' ') container(s)"
else
    info "no running containers"
fi

if [ -n "$KEEP_VM" ]; then
    log "leaving the machine running (--keep-vm)"
elif is_macos && [ -z "${WK_IN_VM:-}" ]; then
    info "stopping the machine"
    podman machine stop "$WK_MACHINE" >/dev/null
    info "machine stopped -- CPU and memory returned to the host"
fi
