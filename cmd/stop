#!/usr/bin/env bash
#
# wk stop [<workspace>] [--keep-vm] -- shut down one workspace, or everything
# wk: where=workspace name=optional forward=no group=hosts needs podman
#
# With a workspace named, stops only that workspace's environment -- its
# container stopped, its macOS guest stopped -- through the driver contract
# (t_stop), and leaves every other workspace, and the podman machine itself,
# exactly as they were. Nothing on disk is touched, the same guarantee the
# bare form makes, narrowed to one workspace. A target with no notion of
# stopping a single workspace (a shared remote build machine; a workspace
# asked to stop itself) refuses and says why, rather than silently doing
# nothing.
#
# `forward=no`: this always runs on the host that holds the environment,
# never forwarded into the podman VM the way `wk build`/`wk enter` are --
# stopping the VM's own containers *from* the VM would stop the ssh session
# forwarding the command mid-word.
#
# With no workspace, stops every workspace container and then the podman
# machine, which is what actually returns CPU and memory to the host: a
# stopped container inside a running VM still costs you the VM's whole
# allocation.
#
# Nothing is deleted. The overlay layer, the build tree, the home directory and
# the container itself all persist -- that is exactly why the overlay is
# declared with an explicit upperdir rather than a bare :O, which podman would
# discard on stop.
#
# macOS VMs are stopped too, and first: a guest holds its entire allocation
# whether or not anything is building in it, so it is the largest thing on the
# machine by some way.
#
#   wk stop                  macOS VMs, containers, then the machine
#   wk stop --keep-vm        macOS VMs and containers, leave the machine running
#   wk stop <workspace>      only that workspace's environment

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/detach.sh"

WK_MACHINE="${WK_MACHINE:-wk}"

NAME="${WK_NAME:-}"

# --- one workspace ------------------------------------------------------------
if [ -n "$NAME" ]; then
    [ $# -eq 0 ] || die "'wk stop $NAME' takes no options -- --keep-vm only applies to a bare 'wk stop'"
    TARGET="$(ws_target "$NAME")"
    load_target "$TARGET"
    [ "$(t_info "$NAME")" != absent ] || die "no such workspace: $NAME"

    # claude remote-control (`wk claude ... --rc`) is a process started
    # detached *inside* the target, separate from the environment t_stop below
    # acts on. container and vm need nothing here -- t_stop suspends the whole
    # container or guest, taking a live server with it -- but a remote target
    # has no notion of stopping a single workspace at all (t_stop refuses, a
    # few lines down), and its "environment" is a checkout on a machine that
    # keeps running regardless, so this is the one place that stops it there.
    if [ "$WK_TARGET_KIND" = remote ]; then
        _rc_sf="$(wk_ws_dir "$NAME")/claude-rc.status"
        _rc_pid=$([ -f "$_rc_sf" ] && status_field "$_rc_sf" pid || true)
        if [ -n "$_rc_pid" ] && t_exec "$NAME" kill -0 "$_rc_pid" >/dev/null 2>&1; then
            info "stopping claude remote-control in '$NAME' (pid $_rc_pid)"
            t_exec "$NAME" kill "$_rc_pid" >/dev/null 2>&1 || true
            status_write "$_rc_sf" state=stopped "pid=$_rc_pid"
        fi
    fi

    t_stop "$NAME"
    exit 0
fi

# --- everything ----------------------------------------------------------------
KEEP_VM=""
[ "${1:-}" = --keep-vm ] && KEEP_VM=1

# Deliberately before the podman-machine check: if the machine is already
# stopped, a running macOS VM is *still* holding memory, and exiting early
# without touching it would report "nothing to do" while 20 GB stayed spoken
# for.
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    . "$WK_ROOT/targets/vm.sh"
    if _tart_bin >/dev/null 2>&1; then
        for _guest in $(t_list 2>/dev/null | awk -F'\t' '$2 == "running" { print $1 }'); do
            t_stop "$_guest"
        done
    fi
fi

if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    state=$(_machine_state "$WK_MACHINE")
    if [ "$state" != running ]; then
        info "machine '$WK_MACHINE' is already $state -- nothing to do"
        exit 0
    fi
fi

# Plain podman, not sudo: workspaces are rootless containers owned by the
# machine's own user now. `sudo podman` looks at root's storage, which is empty
# -- so this reported "no running containers" while two were running.
running=$(_in_machine 'podman ps --filter "name=^wk-" --format "{{.Names}}"' || true)
if [ -n "$running" ]; then
    printf '%s\n' "$running" | sed 's/^/  stopping /' >&2
    # A build mid-flight gets SIGTERM and then SIGKILL. ccache and the overlay
    # are both crash-safe, so the worst case is recompiling the current file.
    _in_machine 'podman stop --time 30 $(podman ps --filter "name=^wk-" --format "{{.Names}}" | tr "\n" " ") >/dev/null'
    info "stopped $(printf '%s\n' "$running" | wc -l | tr -d ' ') container(s)"
else
    info "no running containers"
fi

if [ -n "$KEEP_VM" ]; then
    log "leaving the machine running (--keep-vm)"
elif is_macos && [ -z "${WK_IN_VM:-}" ]; then
    info "stopping the machine"
    podman machine stop "$WK_MACHINE" >/dev/null
    info "machine stopped -- CPU and memory returned to the host"
fi
