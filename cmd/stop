#!/usr/bin/env python3
#
# wk stop [<workspace>|--keep-vm|--tasks [--all]] -- shut down one workspace, or everything
# wk: where=workspace name=optional forward=no group=hosts needs podman opts --keep-vm,--tasks,--all destructive --tasks dryrun --tasks
# wk: flag --keep-vm name=none
# wk: flag --tasks name=none
# wk: flag --all name=none
#
# A named workspace: stops only its container or macOS guest; nothing on disk
# is touched.
#
# `forward=no`: runs on the host holding the environment -- stopping its own
# containers from inside the podman VM would kill the ssh session mid-word.
#
#   wk stop                  macOS VMs, containers, then the machine
#   wk stop --keep-vm        macOS VMs and containers, leave the machine running
#   wk stop <workspace>      only that workspace's environment
#   wk stop --tasks          every task still running here -- a build, a
#                            creation, an agent session -- through the kill
#                            command each one recorded. Workspaces stay up
#   wk stop --tasks --all    every machine's too, each through its own wk
#
#   0  nothing was left running
#   1  a task was still there after its kill command ran
#   3  a machine did not answer, so what runs there is unknown

import os
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import act, decl, record, shell, status, targets  # noqa: E402
from wk.act import Refused, confirm, die, info, log, warn  # noqa: E402
from wk.machine import is_macos  # noqa: E402

MACHINE = os.environ.get("WK_MACHINE", "wk")


def here():
    return is_macos() and not os.environ.get("WK_IN_VM")


def running_tasks(records):
    """(task, 'kind name', kill) for each task still going -- kill is each kind's own stop command."""
    rows = []
    for t in records.list():
        if t.verdict("capped") in record.RUNNING:
            rows.append((t, "%s %s" % (t.field("kind"), t.field("name")), t.field("kill")))
    return rows


def stop_tasks_here(records):
    machine = record.machine_name()
    rows = running_tasks(records)
    if not rows:
        info("no task is running on %s" % machine)
        return 0
    for _, what, kill in rows:
        log("  %s -- %s" % (what, kill))
    if not confirm("stop %d task(s) on %s? What they have not finished is dropped" % (len(rows), machine)):
        die("nothing stopped")
    os.environ["WK_YES"] = "1"   # answered once, here: a kill command of its own would ask again with no terminal
    path = "%s/bin:%s" % (ROOT, os.environ.get("PATH", ""))
    for _, what, kill in rows:
        cp = act.act(["env", "PATH=" + path, "sh", "-c", kill])
        if cp is not None and cp.returncode != 0:
            warn("'%s' exited non-zero" % kill)
    if act.dry_run():
        return 0
    left = running_tasks(records)   # asked again rather than believed
    if left:
        warn("still running on %s:" % machine)
        for _, what, _ in left:
            sys.stderr.write("    %s\n" % what)
        return 1
    info("no task is running on %s" % machine)
    return 0


def stop_tasks_everywhere(reg, records):
    if not confirm("stop every task on this machine and every other one? What they have not finished is dropped"):
        die("nothing stopped")
    os.environ["WK_YES"] = "1"
    rc = stop_tasks_here(records)
    for m in reg.machines():
        target = reg.load(m)
        side, why = target.probe()
        if side != "answering":
            sys.stderr.write("%-22s %s\n" % (m, status.far_side_reason(target, side, why)))
            rc = max(rc, 3)   # a machine that cannot be asked may be running something
            continue
        rc_there, out = target.wk("stop", "--tasks")
        for line in out.splitlines():
            sys.stdout.write("%-22s%s\n" % (m, line))
        rc = max(rc, rc_there)
    return rc


def stop_workspace(reg, name):
    target = reg.load(reg.ws_target(name))
    if target.info(name) == "absent":
        die("no such workspace: %s" % name)
    if not target.stop(name):
        raise Refused(1)
    return 0


def stop_everything(reg, keep_vm):
    if here():
        vm = reg.load("vm")
        for guest, state in vm.list():   # a guest holds its memory even with the machine stopped
            if state == "running":
                vm.stop(guest)
        state = reg.load("container").machine_state()
        if state != "running":
            info("machine '%s' is already %s -- nothing to do" % (MACHINE, state))
            return 0
    running = shell.in_machine(ROOT, 'podman ps --filter "name=^wk-" --format "{{.Names}}"') or ""
    names = running.split()
    if names:
        for n in names:
            sys.stderr.write("  stopping %s\n" % n)
        shell.in_machine(ROOT, 'podman stop --time 30 $(podman ps --filter "name=^wk-" --format "{{.Names}}" | tr "\\n" " ") >/dev/null')
        info("stopped %d container(s)" % len(names))
    else:
        info("no running containers")
    if keep_vm:
        log("leaving the machine running (--keep-vm)")
    elif here():
        info("stopping the machine")
        act.act(["podman", "machine", "stop", MACHINE], stdout=sys.stderr)
        info("machine stopped -- CPU and memory returned to the host")
    return 0


def main(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    keep_vm = args.flag("--keep-vm")
    tasks = args.flag("--tasks")
    everywhere = args.flag("--all")
    name = os.environ.get("WK_NAME", "")
    reg = targets.Registry(ROOT)
    try:
        if tasks:
            if keep_vm:
                die("'--keep-vm' is about the podman machine, which 'wk stop --tasks' leaves alone")
            records = record.Records(ask_target=lambda n, pid, cap: shell.target_pid_alive(ROOT, n, pid, cap))
            return stop_tasks_everywhere(reg, records) if everywhere else stop_tasks_here(records)
        if name:
            return stop_workspace(reg, name)
        return stop_everything(reg, keep_vm)
    except LookupError as e:
        die(str(e))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
