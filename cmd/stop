"""shut down one workspace, or everything

A named workspace: stops only its container or macOS guest; nothing on disk is touched. Runs on the host holding the
environment, never forwarded into the podman VM.

  wk stop                  macOS VMs, containers, then the machine
  wk stop --keep-vm        macOS VMs and containers, leave the machine running
  wk stop <workspace>      only that workspace's environment
  wk stop --tasks          every task still running here -- a build, a creation, an agent session -- through the kill
                           command each one recorded. Workspaces stay up
  wk stop --tasks --all    every machine's too, each through its own wk

  0  nothing was left running
  1  a task was still there after its kill command ran
  3  a machine did not answer, so what runs there is unknown
"""
from wk import stop, store
from wk.decl import Command, Opt

COMMAND = Command(name="optional", forward=False, needs=("podman",), group="hosts", opts=(
    Opt("--keep-vm", "stop the macOS VMs and containers, and leave the podman machine running", sets=dict(name="none")),
    Opt("--tasks", "stop every task still running here through its own kill command",
        sets=dict(name="none", destructive=True)),
    Opt("--all", "with --tasks: every machine's tasks too, each through its own wk", sets=dict(name="none"))))


def main(args, inv):
    return stop.main(store.ws_name(), args.flag("--keep-vm"), args.flag("--tasks"), args.flag("--all"))
