#!/usr/bin/env bash
#
# wk image -- build and manage boot images.
#
#   wk image build <profile> [--dry-run] [--keep-rubble]
#   wk image ls
#   wk image show <id>
#   wk image flash <machine> [--image <id>] [--dry-run]
#   wk image rm <id>
#
# An image is a whole machine, built from a spec in this repo, that a machine
# can be put into for one boot and taken out of again. It exists because four
# later steps all need the same thing -- a machine with no sandbox, whose
# kernel knobs are ours to set -- and each was otherwise going to invent its
# own way to get a binary onto hardware (docs/HANDOFF-netboot.md).
#
# The build runs entirely unprivileged. Nothing here mounts anything: the
# seed files go into the image's FAT partition with mtools at a byte offset
# read out of the partition table, which is the whole reason the workstation
# still has no privileged component. The one operation that does need root is
# writing the image to a device, and that happens on the target machine, over
# ssh, where sudo is passwordless.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/image.sh"
. "$WK_ROOT/image/profiles.sh"
. "$WK_ROOT/boot/machines.sh"
. "$WK_ROOT/lib/target.sh"

# Both of these act on physical machines: a boot device, a firmware register, a
# disk image measured in gigabytes. None of that exists in a workspace, and the
# sandbox cannot reach the machine that has it. Refused here rather than in
# `wk`'s is_host_only list only because that file belongs to the other lane
# this week -- it belongs there, next to the commands it is the same rule as.
if in_workspace; then
    die "'wk $(basename "$0")' acts on a host and its hardware, and this is
    workspace '$(wk_self)'. Run it on the workstation instead."
fi

usage() {
    cat >&2 <<'EOF'
usage: wk image <sub>

  build <profile> [--dry-run]     build an image from the spec in this repo
  ls                              images in the store
  show <id>                       what an image is, and whether it still is
  flash <machine> [--image <id>]  write an image to that machine's boot device
  rm <id>                         delete an image

profiles:
EOF
    image_profile_list | sed 's/^/  /' >&2
    exit 2
}

# --- the seed ----------------------------------------------------------------

# The public key the image will accept. The board is reached over Tailscale SSH
# today, which authenticates with no key at all -- so the key that works now is
# not evidence of the key the image needs, and it has to be named here.
driving_key() {
    local k="${WK_IMAGE_KEY:-$HOME/.ssh/id_ed25519.pub}"
    [ -r "$k" ] || die "no public key at $k
    The image has to accept an ssh key on first boot, or it comes up
    unreachable. Set WK_IMAGE_KEY to the one this machine should use."
    cat "$k"
}

# The network profile, copied from the target board's own netplan on the board,
# so the PSK never travels through a log or an agent's context.
#
# Copied rather than composed, and from netplan rather than from a
# NetworkManager keyfile: on this distro NM rewrites a dropped-in keyfile under
# a new uuid and the secret does not survive the round trip (netboot handoff,
# "Attempts 2 and 3"). netplan is what NM is actually configured from here, and
# cloud-init's network-config is netplan.
network_config() {
    local host="$1"
    # One document per file, `---`-separated: several netplan files
    # concatenated are not a YAML document, they are several, and a parser
    # handed the concatenation either fails or silently keeps the last.
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" \
        'for f in /etc/netplan/*.yaml; do echo ---; sudo cat "$f"; done' \
        | python3 "$WK_ROOT/image/netplan-to-networkd.py"
}

# What the image is, in the image, so "which OS am I talking to" is never a
# guess -- and so `wk boot --status` can tell the two roles apart from the
# outside by evidence rather than by trusting its own record.
marker_file() {
    cat <<EOF
id=$ID
profile=$IMG_PROFILE
machine=$IMG_MACHINE
base=$(basename "$IMG_BASE_URL")
built=$BUILT
built_by=$(hostname)
wk_tools=$(git -C "$WK_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)
EOF
}

# cloud-config. Everything the image needs that the base does not already do,
# and nothing else.
user_data() {
    cat <<EOF
#cloud-config
# Generated by 'wk image build $IMG_PROFILE' -- do not edit here, edit
# image/profiles.sh and image/$IMG_PROFILE/ and rebuild.
hostname: $IMG_HOSTNAME
prefer_fqdn_over_hostname: false

users:
  - name: $(id -un)
    gecos: wk image
    groups: [adm, sudo, dialout, video, render, plugdev]
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - $(driving_key)

ssh_pwauth: false
disable_root: true

# The one-shot is spent by the first reboot, whoever causes it. A base image
# that grows its root and reboots itself therefore lands back on the
# workstation and this image never finishes coming up.
growpart:
  mode: $IMG_GROW
resize_rootfs: $([ "$IMG_GROW" = off ] && echo false || echo true)

package_update: $([ -n "$IMG_PACKAGES" ] && echo true || echo false)
packages:$([ -n "$IMG_PACKAGES" ] && for p in $IMG_PACKAGES; do printf '\n  - %s' "$p"; done || printf ' []')

bootcmd:
  # Cheap insurance, and it is only insurance: this radio is not soft-blocked
  # on this distro. The regulatory country is deliberately NOT set -- the
  # board associates with this AP on channel 52 today with country 99 /
  # DFS-UNSET, so setting one would be changing the one thing known to work.
  # `command -v` first: this base image has neither rfkill nor iw, and an
  # unconditional call just puts "not found" in the log of every boot.
  - [ sh, -c, "command -v rfkill >/dev/null && rfkill unblock all || true" ]
  # NOTHING ELSE GOES IN bootcmd. An earlier version armed the self-return
  # watchdog here with `systemd-run`, reasoning that bootcmd is the first
  # cloud-init stage and runcmd is the last. It deadlocked the boot outright:
  # `systemd-run` without --no-block waits for the start job to complete, the
  # transient unit it creates carries default dependencies and so waits for
  # basic.target, basic.target waits for sysinit.target, and sysinit.target
  # waits for cloud-init-local -- which is sitting in `systemd-run`. The board
  # stalled at sysinit.target forever: no ssh, no multi-user, no watchdog, and
  # a journal whose last systemd line is an unmet condition check. Anything
  # that has to run early belongs in a unit installed in the rootfs, where
  # systemd orders it, not in a command that asks systemd to do work while
  # systemd is waiting for that command.

write_files:
  - path: /etc/wk-image
    permissions: "0644"
    content: |
$(marker_file | sed 's/^/      /')

  # The self-return watchdog and the diagnostics dump are NOT here. They are
  # installed into the rootfs at build time and enabled by systemd, precisely
  # so that they do not depend on cloud-init having succeeded -- the boots that
  # need a watchdog most are the ones where cloud-init did not run.

  # The stock journal is volatile, so the first attempt's logs were simply
  # gone once the board rebooted itself.
  - path: /etc/systemd/journald.conf.d/10-wk-persistent.conf
    permissions: "0644"
    content: |
      [Journal]
      Storage=persistent

  # The reason this image exists. No sandbox, no host to ask: the profiling
  # knobs are simply ours here.
  - path: /etc/sysctl.d/90-wk-perf.conf
    permissions: "0644"
    content: |
      kernel.perf_event_paranoid = -1
      kernel.kptr_restrict = 0

  # The JIT-dump wall is written down but NOT exported. Every one of these
  # changes what JSC does -- useConcurrentJIT=0 most of all -- so a shell that
  # set them for every process would silently change every measurement taken
  # on this machine, which is exactly the class of trap this repo keeps
  # finding. Source it deliberately, per run.
  - path: /etc/wk-perf-env
    permissions: "0644"
    content: |
      # . /etc/wk-perf-env   -- before a samply/perf JIT run, never globally.
      export JSC_useJITDump=1
      export JSC_useTextMarkers=1
      export JSC_useConcurrentJIT=0
      export JSC_jitDumpDirectory=\${WK_JITDUMP_DIR:-/var/tmp/wk-jitdump}

  - path: /etc/profile.d/wk-image.sh
    permissions: "0644"
    content: |
      export WK_IMAGE=$ID
      export WK_JITDUMP_DIR=/var/tmp/wk-jitdump

runcmd:
  - [ mkdir, -p, /var/log/journal, /var/tmp/wk-jitdump ]
  - [ systemctl, restart, systemd-journald ]
  - [ sysctl, --system ]
  - [ systemctl, enable, ssh.service ]
  - [ systemctl, start, --no-block, ssh.service ]


final_message: "wk image $ID up after \$UPTIME seconds"
EOF
}

# --- FAT surgery, without a mount --------------------------------------------
#
# mtools addresses a filesystem inside an image file directly, at a byte
# offset, which is what keeps this whole command unprivileged. MTOOLS_SKIP_CHECK
# is needed because distro images rarely have a sector count that is a whole
# number of tracks, and mtools refuses such an image by default.
mt() {
    local prog="$1"; shift
    MTOOLS_SKIP_CHECK=1 "$prog" -i "$DISK@@$FAT_OFFSET" "$@"
}

# Byte offset of a partition, from the table in the file itself. No loop
# device, no root -- the same trick the FAT seeding relies on, and e2fsprogs
# speaks it natively through `file?offset=N`.
part_offset() {
    local img="$1" n="$2"
    sfdisk -J "$img" | python3 -c '
import json, sys
p = json.load(sys.stdin)["partitiontable"]["partitions"]
print(p[int(sys.argv[1]) - 1]["start"] * 512)' "$n"
}

fat_offset() {
    local img="$1"
    # sfdisk reads the partition table straight out of the file; no loop
    # device, no root. Partition 1 is the firmware/boot FAT on every Pi image.
    sfdisk -J "$img" \
        | sed -n 's/.*"start": *\([0-9]*\).*/\1/p' \
        | head -1 \
        | awk '{ print $1 * 512 }'
}

# Install a systemd unit into the image's rootfs, enabled, without cloud-init.
#
# This exists because of a hole that cost two trips to the machine. The
# self-return watchdog was armed by cloud-init, so every failure *earlier* than
# cloud-init -- a seed that was not read, a datasource that did not initialise,
# a stage that hung -- produced a board that was stranded with nothing to hand
# it back. The watchdog protected exactly the boots that did not need it.
#
# So the units are written into the rootfs at build time, with their
# multi-user.target.wants symlinks, and systemd starts them whether cloud-init
# ever runs or not. Everything that can be installed this way should be: the
# only things left to cloud-init are the ones that genuinely need it (a user
# with an authorized key, and the rendered network configuration).
install_unit() {
    local roff="$1" name="$2" body="$3"
    printf '%s' "$body" > "$SEED/$name"
    debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
cd /etc/systemd/system
rm $name
write $SEED/$name $name
sif $name mode 0100644
sif $name uid 0
sif $name gid 0
symlink /etc/systemd/system/multi-user.target.wants/$name /etc/systemd/system/$name
EOF
    debugfs -R "stat /etc/systemd/system/$name" "$DISK?offset=$roff" 2>/dev/null \
        | grep -q '^Inode:' || die "could not install $name into the image"
}

# Give the image filesystem labels of its own, and make everything that names
# them agree: the ext4 superblock, the FAT boot sector, `/etc/fstab` and the
# kernel command line. See the note in image/profiles.sh for why this is a
# correctness fix and not tidiness.
#
# All of it unprivileged. e2fsprogs takes `file?offset=N` on any of its tools,
# so the root filesystem is editable in place in the image exactly as the boot
# partition is, and nothing is mounted at any point.
relabel() {
    local seed="$1" roff old_root cmdline_path
    roff=$(part_offset "$DISK" 2)

    old_root=$(dumpe2fs -h "$DISK?offset=$roff" 2>/dev/null \
        | sed -n 's/^Filesystem volume name: *//p')
    [ -n "$old_root" ] || die "could not read the image's root filesystem label"

    info "relabelling: root '$old_root' -> '$IMG_LABEL_ROOT', boot -> '$IMG_LABEL_BOOT'"
    tune2fs -L "$IMG_LABEL_ROOT" "$DISK?offset=$roff" >/dev/null
    mt mlabel "::$IMG_LABEL_BOOT"

    # fstab, rewritten through debugfs. `rm` unlinks and leaves the inode on
    # the orphan list, which is why e2fsck runs afterwards -- and it is worth
    # running regardless, as the one check that the surgery left a filesystem
    # a kernel will mount.
    debugfs -R "cat /etc/fstab" "$DISK?offset=$roff" 2>/dev/null \
        | sed -e "s/LABEL=$old_root/LABEL=$IMG_LABEL_ROOT/" \
              -e "s/LABEL=system-boot/LABEL=$IMG_LABEL_BOOT/" \
        > "$seed/fstab"
    grep -q "LABEL=$IMG_LABEL_ROOT" "$seed/fstab" \
        || die "the image's /etc/fstab does not name its root by label; this
    profile's relabelling assumes it does"

    debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
rm /etc/fstab
cd /etc
write $seed/fstab fstab
sif fstab mode 0100644
sif fstab uid 0
sif fstab gid 0
EOF
    e2fsck -fy "$DISK?offset=$roff" >/dev/null 2>&1 || true
    debugfs -R "cat /etc/fstab" "$DISK?offset=$roff" 2>/dev/null \
        | grep -q "LABEL=$IMG_LABEL_ROOT" \
        || die "/etc/fstab did not survive the rewrite"

    install_datasource "$roff"
    install_units "$roff"

    # The identity marker, in the rootfs rather than only in cloud-init's
    # write_files, for the same reason: "which OS am I talking to" has to be
    # answerable on a boot where cloud-init did not run, because those are
    # exactly the boots worth identifying.
    marker_file > "$SEED/wk-image"
    debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
cd /etc
rm wk-image
write $SEED/wk-image wk-image
sif wk-image mode 0100644
sif wk-image uid 0
sif wk-image gid 0
EOF

    # The kernel command line. Ubuntu's raspi images keep it under the
    # os_prefix directory the firmware selects, not at the root of the boot
    # partition, so both places are tried.
    for cmdline_path in ::/current/cmdline.txt ::cmdline.txt; do
        if mt mtype "$cmdline_path" > "$seed/cmdline.txt" 2>/dev/null; then
            sed -i "s/root=LABEL=$old_root/root=LABEL=$IMG_LABEL_ROOT/" "$seed/cmdline.txt"
            grep -q "root=LABEL=$IMG_LABEL_ROOT" "$seed/cmdline.txt" \
                || die "$cmdline_path does not select its root by label"
            mt mcopy -o "$seed/cmdline.txt" "$cmdline_path"
            debug "rewrote $cmdline_path"
            return 0
        fi
    done
    die "no cmdline.txt in the image's boot partition"
}

# Point cloud-init's seed search at *this* image's boot filesystem.
#
# This is the second half of the relabelling, and leaving it out is what made
# the first relabelled image configure itself as the workstation. Ubuntu's
# raspi base ships:
#
#     datasource:
#       NoCloud:
#         fs_label: system-boot
#
# -- so cloud-init does not read `/boot/firmware`, it goes looking for a
# filesystem with that label and mounts whatever it finds. Rename the stick's
# boot partition and the only `system-boot` left in the machine is the
# *workstation's* NVMe, which cloud-init then dutifully used: the image booted
# from the stick (root and /boot/firmware both correct) and configured itself
# from the workstation's seed. No user, no key, no network, no watchdog, and
# nothing in any log saying anything had gone wrong.
#
# The general rule this is an instance of: an image and an install made from
# the same distro are twins in *every* namespace, and any mechanism that finds
# something by name will find the wrong one. Renaming one namespace is not a
# fix until every mechanism that reads that name has been changed with it --
# here fstab, the kernel command line, and this.
#
# A file that sorts after the distro's own, rather than an edit of it: the
# override is then visible as an override.
install_datasource() {
    local roff="$1"
    printf '%s\n' \
        "# Written by wk image build. Sorts after the base image's" \
        "# 99-fake-cloud.cfg, which points NoCloud at 'system-boot' -- the label" \
        "# this machine's *workstation* install also carries." \
        "datasource_list: [ NoCloud, None ]" \
        "datasource:" \
        "  NoCloud:" \
        "    fs_label: $IMG_LABEL_BOOT" \
        > "$SEED/99-wk-image.cfg"

    debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
cd /etc/cloud/cloud.cfg.d
rm 99-wk-image.cfg
write $SEED/99-wk-image.cfg 99-wk-image.cfg
sif 99-wk-image.cfg mode 0100644
sif 99-wk-image.cfg uid 0
sif 99-wk-image.cfg gid 0
EOF
    debugfs -R "cat /etc/cloud/cloud.cfg.d/99-wk-image.cfg" "$DISK?offset=$roff" 2>/dev/null \
        | grep -q "fs_label: $IMG_LABEL_BOOT" \
        || die "could not point cloud-init's seed search at $IMG_LABEL_BOOT;
    without it the image reads the target machine's own seed instead."
}

install_units() {
    local roff="$1"
    # The .wants directory need not exist in a stock image.
    debugfs -w -R "mkdir /etc/systemd/system/multi-user.target.wants" \
        "$DISK?offset=$roff" >/dev/null 2>&1 || true

    info "installing the self-return watchdog and the diagnostics dump into the rootfs"

    # TimeoutStartSec=infinity is load-bearing: systemd's default 90 s start
    # timeout kills a Type=oneshot that sleeps longer than that before it can
    # ever fire.
    install_unit "$roff" wk-self-return.service "[Unit]
Description=Hand the machine back to its normal role unless claimed
[Service]
Type=oneshot
ExecStart=/bin/sh -c 'sleep $IMG_WATCHDOG; [ -f /run/wk-keep-running ] || systemctl reboot'
TimeoutStartSec=infinity
[Install]
WantedBy=multi-user.target
"

    # Written where the driving machine can read it offline, by mounting the
    # boot device from the machine's other role. This is the channel that
    # works precisely when the network is the thing that failed.
    install_unit "$roff" wk-diag.service "[Unit]
Description=Dump boot and network state where it can be read offline
After=network.target cloud-init.service
[Service]
Type=oneshot
TimeoutStartSec=600
ExecStart=/bin/sh -c 'sleep 90; { date -Is; cat /etc/wk-image 2>/dev/null; \
  echo; findmnt -no SOURCE,TARGET /; findmnt -no SOURCE,TARGET /boot/firmware; \
  echo; rfkill list 2>&1; iw reg get 2>&1; ip -br addr; ip route; \
  echo; networkctl status --no-pager 2>&1 | head -40; \
  echo; cloud-init status --long 2>&1; \
  echo; journalctl -b -u systemd-networkd -u wpa_supplicant -u cloud-init \
    -u cloud-init-local --no-pager 2>&1 | tail -120; } \
  > /boot/firmware/wk-diag.txt 2>&1; sync'
[Install]
WantedBy=multi-user.target
"
}

# --- build -------------------------------------------------------------------

cmd_build() {
    local profile="${1:-}" dry=""
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) dry=1 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    [ -n "$profile" ] || usage
    image_profile_load "$profile" || die "unknown profile '$profile' (wk image ls)"

    # Collected rather than asserted, so --dry-run can answer "it would fail,
    # and here is what is missing" instead of failing at the check itself. A
    # dry run whose job is to say whether the real run would work should not
    # be the first thing to stop.
    MISSING=""
    have mcopy  || MISSING="$MISSING mtools"
    have sfdisk || MISSING="$MISSING util-linux(sfdisk)"
    have xz     || MISSING="$MISSING xz-utils"
    python3 -c 'import yaml' 2>/dev/null || MISSING="$MISSING python3-yaml"
    have tune2fs || MISSING="$MISSING e2fsprogs"

    machine_load "$IMG_MACHINE" || die "profile '$profile' names an unknown machine '$IMG_MACHINE'"

    BUILT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    ID="$profile-$(date -u +%Y%m%dT%H%M%SZ)"

    if [ -n "$dry" ]; then
        cat >&2 <<EOF
would build image $ID
  profile     $IMG_PROFILE ($IMG_ARCH, $IMG_BASE_KIND)
  for machine $IMG_MACHINE (ssh $MACH_SSH, writes to $MACH_DEVICE)
  base        $(basename "$IMG_BASE_URL")
              $([ -f "$(image_cache_dir)/$(basename "$IMG_BASE_URL")" ] && echo "cached" || echo "not cached -- would download")
  hostname    $IMG_HOSTNAME
  ssh key     ${WK_IMAGE_KEY:-$HOME/.ssh/id_ed25519.pub}
  network     $MACH_SSH's own netplan, re-rendered for networkd
  watchdog    ${IMG_WATCHDOG}s self-return unless /run/wk-keep-running exists
  grow root   $IMG_GROW
  packages    ${IMG_PACKAGES:-none}
  into        $(image_dir "$ID")
  tooling     ${MISSING:+MISSING:}${MISSING:-all present}
EOF
        log "dry run -- nothing was built."
        return 0
    fi

    [ -z "$MISSING" ] || die "missing:$MISSING
    './setup' installs the host's packages, mtools among them."

    # The network profile is read off the target machine, so an unreachable
    # machine means no image -- and finding that out *after* a 45 s unpack is
    # 45 s spent on an answer already available. Checked before the lock, too:
    # nothing else should queue behind a build that cannot start.
    m_reachable || die "$IMG_MACHINE is not reachable over ssh, and the image's network
    profile is read from that machine -- an image built without it comes up
    unreachable on a board with no cable.
    'wk boot $IMG_MACHINE --status' says what role it is in."

    image_lock

    # Rubble from an interrupted build is destroyed, never repaired and never
    # reported as "already exists" (rules 2 and 3).
    local r
    for r in $(image_rubble); do
        warn "destroying rubble from an interrupted build: $r"
        rm -rf "$(image_dir "$r")"
    done

    local base
    base=$(image_fetch_base "$IMG_BASE_URL" "$IMG_BASE_SHA256")

    local dir; dir=$(image_dir "$ID")
    mkdir -p "$dir"
    DISK="$dir/disk.img"

    info "unpacking $(basename "$base")"
    xz -dc "$base" > "$DISK"

    FAT_OFFSET=$(fat_offset "$DISK")
    [ -n "$FAT_OFFSET" ] && [ "$FAT_OFFSET" -gt 0 ] \
        || die "could not find the boot partition in $DISK"
    debug "boot partition at byte $FAT_OFFSET"

    info "seeding the image (cloud-init, on the boot partition)"
    # SEED is global on purpose: the trap runs after this function's scope is
    # gone, and a `local` there is an unbound variable under `set -u` -- which
    # turns any failure during seeding into a confusing second failure that
    # hides the first.
    SEED=$(mktemp -d)
    trap 'rm -rf "${SEED:-}"' EXIT

    user_data > "$SEED/user-data"

    # instance-id must change or cloud-init recognises an instance it has
    # already configured and skips every module -- which looks exactly like a
    # seed that was never read.
    printf 'instance-id: %s\nlocal-hostname: %s\n' "$ID" "$IMG_HOSTNAME" > "$SEED/meta-data"

    info "reading the network profile from $MACH_SSH (the PSK stays on the board)"
    network_config "$MACH_SSH" > "$SEED/network-config"
    grep -q 'wifis:' "$SEED/network-config" \
        || die "$MACH_SSH's netplan has no wifi stanza, so the image would come up unreachable.
    That board has no cable; an image with no credentials boots into isolation."

    # The image's own config.txt: read the base's, append the profile's, write
    # it back. Appended rather than replaced, because the base's copy is what
    # makes the base bootable.
    mt mtype ::config.txt > "$SEED/config.txt" \
        || die "could not read config.txt out of the base image's boot partition"
    if [ -f "$IMG_SPEC_DIR/config.txt.append" ]; then
        printf '\n' >> "$SEED/config.txt"
        cat "$IMG_SPEC_DIR/config.txt.append" >> "$SEED/config.txt"
    fi

    local f
    for f in user-data meta-data network-config config.txt; do
        mt mcopy -o "$SEED/$f" "::$f"
    done

    relabel "$SEED"

    rm -rf "$SEED"; trap - EXIT

    # The manifest is written last, and that is the entire publishing
    # protocol: until it exists this directory is rubble that every reader
    # ignores and the next build deletes.
    info "hashing the image"
    local sha; sha=$(sha256sum "$DISK" | cut -d' ' -f1)
    cat > "$(image_manifest "$ID")" <<EOF
id=$ID
profile=$IMG_PROFILE
machine=$IMG_MACHINE
arch=$IMG_ARCH
base_url=$IMG_BASE_URL
base_sha256=$IMG_BASE_SHA256
hostname=$IMG_HOSTNAME
watchdog=$IMG_WATCHDOG
built=$BUILT
built_by=$(hostname)
wk_tools=$(git -C "$WK_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)
disk_bytes=$(stat -c %s "$DISK")
disk_sha256=$sha
EOF

    info "built $ID  ($(du -h "$DISK" | cut -f1))"
    log  "  next:  wk image flash $IMG_MACHINE --image $ID"
}

# --- the rest ----------------------------------------------------------------

cmd_ls() {
    local id r n=0
    for id in $(image_ids | sort); do
        n=$((n + 1))
        printf '%-34s %-12s %-8s %s\n' \
            "$id" \
            "$(manifest_get "$id" machine)" \
            "$(numfmt --to=iec "$(manifest_get "$id" disk_bytes)" 2>/dev/null || echo '?')" \
            "$(manifest_get "$id" built)"
    done
    [ "$n" -eq 0 ] && log "no images built yet -- 'wk image build <profile>'"
    for r in $(image_rubble); do
        warn "$r: rubble from an interrupted build; the next build deletes it"
    done
    return 0
}

cmd_show() {
    local id="${1:-}"
    [ -n "$id" ] || usage
    image_complete "$id" || die "no such image: $id"
    cat "$(image_manifest "$id")"
    image_verify "$id" && log "disk.img matches its manifest"
}

cmd_rm() {
    local id="${1:-}"
    [ -n "$id" ] || usage
    [ -d "$(image_dir "$id")" ] || die "no such image: $id"
    confirm "delete image $id?" || die "not deleted"
    rm -rf "$(image_dir "$id")"
    info "deleted $id"
}

cmd_flash() {
    local machine="${1:-}" id="" dry=""
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            --image) id="${2:-}"; shift ;;
            --dry-run) dry=1 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    [ -n "$machine" ] || usage
    machine_load "$machine" || die "unknown machine '$machine' (wk boot --list)"
    load_driver "$MACH_DRIVER"

    [ -n "$id" ] || id=$(image_latest "$MACH_PROFILE") \
        || die "no image built for $machine yet -- 'wk image build $MACH_PROFILE'"
    image_complete "$id" || die "no such image: $id"

    if [ -n "$dry" ]; then
        log "would write $id ($(numfmt --to=iec "$(manifest_get "$id" disk_bytes)")) to $MACH_DEVICE on $machine"
        log "dry run -- nothing was written."
        return 0
    fi

    image_verify "$id" || die "refusing to flash an image that does not match its manifest"

    m_reachable || die "$machine is not reachable over ssh in its normal role"

    warn "this ERASES $MACH_DEVICE on $machine, whatever is on it now."
    confirm "write $id to $MACH_DEVICE on $machine?" || die "not written"

    b_flash "$(image_disk "$id")" "$MACH_DEVICE"
    info "$machine now has $id on $MACH_DEVICE"
    log  "  next:  wk boot $machine"
}

case "${1:-}" in
    build) shift; cmd_build "$@" ;;
    ls|list) shift; cmd_ls "$@" ;;
    show) shift; cmd_show "$@" ;;
    flash) shift; cmd_flash "$@" ;;
    rm) shift; cmd_rm "$@" ;;
    *) usage ;;
esac
