#!/usr/bin/env bash
#
# wk pi <verb> <args> -- Raspberry Pi test boards: get one on the tailnet, then run WebKit on it
#
# wk: where=host name=none group=hosts broker deploy,bench needs ssh,python3
#
# A board runs a bench system on removable media; its own workstation install
# is never touched. `wk help hardware` has the per-board arrangement.
#
#   wk pi setup <ssh-host>                put it on the tailnet: copies pinned
#                                         tailscale binaries onto a writable
#                                         partition; no image rebuild
#   wk pi boot-order <ssh-host> <order>   rpi4/rpi5 firmware boot order;
#                                         --revert undoes it, --dry-run previews
#   wk pi deploy <workspace> <machine>    put a cross build on the board
#       [--slot NAME] [--skeleton|--skeleton-only] [--libs-only]
#                                         --slot lands beside an existing build;
#                                         --skeleton clones the tree the board's
#                                         scripts need; --skeleton-only stops there
#   wk pi bench <machine> <plan>          run a benchmark on a booted bench
#       [--slot NAME] [--count N] [--timeout S] [--keep-session]
#                                         system; refuses host mode and a
#                                         missing display without --force
#       --ab A,B [--rounds N]             interleaved A/B between two deployed
#                                         slots, compared with wk bench compare
#
# Bare-board order: wk sysimage build/disks/write, wk pi boot-order, wk boot,
# then wk pi setup once it answers on the tailnet. Flashing lives in
# wk sysimage write, not here.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/boot/machines.sh"
. "$WK_ROOT/lib/image.sh"
. "$WK_ROOT/image/profiles.sh"
. "$WK_ROOT/boot/disk.sh"
. "$WK_ROOT/boot/rpi-eeprom.sh"
. "$WK_ROOT/lib/detach.sh"
# For `deploy`, which reaches into a build workspace as well as onto a board.
. "$WK_ROOT/lib/target.sh"

# The tailscale release, from the one file that declares it -- the same one the
# Yocto layer's recipe requires (image/yocto/meta-wk-tailnet). Two copies of a
# version is a board running a different tailscale from the image beside it, and
# the drift would be invisible until something needed them to match.
TS_RELEASE="$WK_ROOT/image/yocto/meta-wk-tailnet/recipes-network/tailscale/tailscale-release.inc"
ts_release_field() { # <name> -- one `NAME = "value"` line out of the .inc
    sed -n "s/^$1 = \"\(.*\)\"\$/\1/p" "$TS_RELEASE" | head -1
}
TS_VERSION="${TS_VERSION:-$(ts_release_field TS_VERSION)}"
[ -n "$TS_VERSION" ] || die "no TS_VERSION in $TS_RELEASE"
TAG="${WK_PI_TAG:-tag:wk}"

ACTION="${1:-}"; HOST="${2:-}"
case "$ACTION" in
    setup|boot-order) [ -n "$HOST" ] || die "usage: wk pi $ACTION <ssh-host>; see wk pi -h" ;;
    # deploy takes a *workspace* and a fleet machine, not an ssh host: it has
    # to reach into the build to make the archive and onto the board to unpack
    # it, and the board is named the way every other fleet verb names one.
    deploy|bench) : ;;
    # Kept only to say where it went; see below.
    flash) : ;;
    *) die "usage: wk pi <verb> <args>; see wk pi -h" ;;
esac
shift 2 2>/dev/null || true

rsh() { ssh -o BatchMode=yes "$HOST" "$@"; }

if [ "$ACTION" = flash ]; then
    die "'wk pi flash' is gone -- it and 'wk image flash' were one operation.

    Writing a disk is an image operation, so it lives with the image store, and
    the disk is named rather than the machine:

        wk sysimage disks $HOST                  what is attached over there
        wk sysimage write <id> --disk $HOST:<device>

    'wk pi' is for the things that are actually about the board: putting it on
    the tailnet, and its EEPROM boot order."
fi

# --- wk pi deploy --------------------------------------------------------------
#
# Put a cross-built WebKit on a device. The loop the wiki does by hand
# (`WebKit JSC Container Development Setup`, and the Yocto Wayland page for the
# device half), encoded so neither a person nor an agent re-derives it.
#
# The shape is fixed by one fact: **the image is the runtime and the browser is
# not in it.** A Yocto `webkit-dev-ci-tools` image carries weston, libwpe and the
# FDO backend and no libWPEWebKit at all -- deliberately, because a browser
# rebuilt into the image would make every WebKit change an hours-long bitbake
# instead of a minutes-long copy. So the browser arrives here.
#
#   wk pi deploy <workspace> <machine> [--skeleton] [--libs-only]
#
# The device needs a WebKit *skeleton* at /WebKit/WebKit -- `--depth 1`, not a
# checkout -- because `built-product-archive extract` and `run-minibrowser` are
# WebKit's own scripts and both run **on the board**, out of that tree. The
# source in it is not the source that built the binary and must never be read as
# such (the rpi3 skill records that trap: a stale pi tree said 90% where the
# running binary used 80%).
pi_deploy_ws_profile() {
    # `yocto-<profile>` is what image/yocto.sh names its workspaces, so the
    # profile is derivable rather than a second argument to keep in sync.
    local ws="$1"
    case "$ws" in
        yocto-*) printf '%s' "${ws#yocto-}" ;;
        *) return 1 ;;
    esac
}

# Registered rather than trapped, for the reason lib/common.sh's wk_atexit
# exists: a `trap ... EXIT` here would replace whatever else is registered.
PI_TMP=""
_pi_tmp_cleanup() { [ -n "${PI_TMP:-}" ] && rm -rf "$PI_TMP"; PI_TMP=""; return 0; }

cmd_deploy() {
    local ws="${1:-}" machine="${2:-}"; shift 2 2>/dev/null || true
    local skeleton="" libs_only="" skeleton_only="" slot=a
    while [ $# -gt 0 ]; do
        case "$1" in
            # Which build directory on the board this lands in. Default `a` is
            # the historical unsuffixed path, so nothing that predates slots
            # changes behaviour.
            --slot)      slot="${2:-}"; pi_check_slot "$slot"; shift ;;
            --skeleton)  skeleton=1 ;;
            # Provision the tree and stop -- useful while a cross build is
            # still running, since the two do not depend on each other.
            --skeleton-only) skeleton=1; skeleton_only=1 ;;
            --libs-only) libs_only=1 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done
    [ -n "$ws" ] && [ -n "$machine" ] \
        || die "usage: wk pi deploy <workspace> <machine> [--slot NAME] [--skeleton] [--libs-only]"

    machine_load "$machine" || die "no such machine '$machine' (boot/machines.sh)"
    machine_armed_barrier "A deploy now lands in the system that is answering, and the
    machine is about to leave it -- the build would be on the disk nobody boots."

    local profile target
    profile=$(pi_deploy_ws_profile "$ws") \
        || die "'$ws' is not a yocto build workspace (they are named yocto-<profile>)"
    image_profile_load "$profile" \
        || die "'$ws' names profile '$profile', which this checkout does not define"
    target="${YOC_TARGET:-}"
    [ -n "$target" ] || die "profile '$profile' declares no YOC_TARGET, so there is no
    cross-target to archive for."

    # 1. The skeleton first, because it is a precondition and not part of the
    # payload: discovering it missing *after* an archive has been built is the
    # wrong order, and with --skeleton-only it is the whole job.

    if ! m_ssh 'test -d /WebKit/WebKit/Tools/CISupport' 2>/dev/null; then
        [ -n "$skeleton" ] || die "$machine has no WebKit skeleton at /WebKit/WebKit.
    'built-product-archive extract' and 'run-minibrowser' are WebKit's own
    scripts and both run on the board out of that tree, so a copy of the
    archive alone cannot be unpacked or launched.
    Provision it once (a --depth 1 clone, ~minutes):
        wk pi deploy $ws $machine --skeleton"
        pi_skeleton "$machine"
    fi

    [ -n "$skeleton_only" ] && { log "skeleton ready on $machine"; return 0; }

    # 2. The archive, built in the workspace.
    #
    # The env scrub is not defensive tidiness: the wiki marks it VERY IMPORTANT
    # because a poisoned CC/CXX/LD_LIBRARY_PATH produces a *broken archive with
    # no error*, which is discovered on the board. `env -u` rather than `unset`
    # so it cannot depend on what the calling shell happens to hold.
    # The workspace's own driver, or t_exec is not defined at all: each target
    # kind brings its own (targets/container.sh, remote.sh, vm.sh).
    load_target "$(ws_target "$ws")" >/dev/null 2>&1 \
        || die "'$ws' is not a workspace this machine knows (wk ls)"

    # Somewhere to stage a payload, needed by both transports below -- so it is
    # created before the branch chooses one. Created inside the
    # built-product-archive path, it leaves the tar path pulling into
    # "$PI_TMP/..." with PI_TMP unset: podman is asked to write
    # `/wk-webkit.tgz` and refuses to make `/` writable, which is a confusing
    # way to be told a variable is empty.
    PI_TMP=$(mktemp -d)
    wk_atexit _pi_tmp_cleanup

    # Two transports, and which one is available is a property of the build
    # container rather than a preference.
    #
    # `built-product-archive` is the documented path (the wiki's, and what the
    # board's own extract expects) but it shells out to `zip`, which the yocto
    # build image did not have -- and cannot be given at runtime, because
    # ports.ubuntu.com is not in the egress allowlist and widening that to
    # install a zip is the wrong trade. container/yocto/Containerfile carries
    # `zip`, so a workspace built from it takes the documented path; one
    # without takes the tar below rather than being unusable.
    if ! t_exec "$ws" bash -c 'command -v zip >/dev/null' 2>/dev/null; then
        warn "the build container has no 'zip', so built-product-archive cannot run.
  Falling back to a plain tar of bin/ and lib/ -- the same bytes, without the
  archive format. 'wk rm $ws' and rebuild to get the documented path back."
        pi_deploy_tar "$ws" "$machine" "$target" "$slot"
        return 0
    fi

    info "archiving the cross build in '$ws' (target $target)"
    t_exec "$ws" env -u CC -u CXX -u LD_LIBRARY_PATH bash -c "cd /src/WebKit &&
        Tools/CISupport/built-product-archive --platform=wpe --release \
            --cross-target=$(sh_quote "$target") archive" \
        || die "built-product-archive failed in '$ws' -- nothing is deployed.
    Read the error above rather than assuming a cause; the two seen so far are
    a cross build that was never made:
        wk sysimage build $profile --stage webkit
    and a host tool missing from the build container (it needs \`zip\`), which
    is container/yocto/Containerfile's business, not this command's."

    local zip="$PI_TMP/release.zip"
    t_pull "$ws" /src/WebKit/WebKitBuild/release.zip "$zip" \
        || die "the archive was built but could not be copied out of '$ws'"
    info "archive: $(human_bytes "$(file_bytes "$zip")")"

    # 3. And across.
    info "copying the archive to $machine"
    m_ssh 'mkdir -p /WebKit/WebKit/WebKitBuild' >/dev/null 2>&1 || true
    # `cat >` through m_ssh rather than scp: the same channel the rest of this
    # repo uses to move bytes onto a board (boot/disk.sh), and it needs no scp
    # binary on the far side -- which a slim image may not have.
    m_ssh 'cat > /WebKit/WebKit/WebKitBuild/release.zip' < "$zip" \
        || die "could not copy the archive to $machine"

    info "extracting on $machine"
    m_ssh 'cd /WebKit/WebKit && Tools/CISupport/built-product-archive --platform=wpe --release extract' \
        >/dev/null 2>&1 \
        || die "extract failed on $machine. The archive is at
    /WebKit/WebKit/WebKitBuild/release.zip; run the extract by hand to see why."

    # Proof, not a claim: the thing the whole deploy exists to put there.
    local built
    built=$(m_ssh 'ls -l --time-style=+%Y-%m-%dT%H:%M /WebKit/WebKit/WebKitBuild/WPE/Release/bin/jsc 2>/dev/null | awk "{print \$6}"' 2>/dev/null | tr -d '\r')
    [ -n "$built" ] || die "the extract reported success but there is no
    WebKitBuild/WPE/Release/bin/jsc on $machine."
    log "deployed to $machine"
    log "  jsc      $built  (timestamps, not the SONAME, tell builds apart)"
    log "  next:    wk pi bench $machine <plan>"
}

# The transport of last resort: bin/ and lib/ as a tarball.
# Where a build lives on the board, by slot.
#
# `Release` with no suffix is slot "a" and the historical path, so every
# existing invocation and every deployed board keeps working untouched.
#
# Slots exist because a board that holds one build makes an A/B of two WebKits
# a reflash-per-side affair -- minutes of copying between every pair of numbers,
# on a board whose thermal state drifts over exactly that timescale. Two builds
# side by side turn that into an alternation, which is the design that
# actually controls for drift (see cmd_bench's --ab).
#
# The name is restricted to a short alphanumeric because it becomes a directory
# on the board and arrives from the command line.
pi_build_dir() {
    local slot="${1:-a}"
    case "$slot" in
        a) printf '/WebKit/WebKit/WebKitBuild/WPE/Release' ;;
        *) printf '/WebKit/WebKit/WebKitBuild/WPE/Release-%s' "$slot" ;;
    esac
}

pi_check_slot() {
    case "${1:-}" in
        [a-zA-Z0-9] | [a-zA-Z0-9][a-zA-Z0-9] | [a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]) return 0 ;;
        *) die "slot '${1:-}' is not usable: one to three letters or digits.
    It names a directory on the board, so it stays boring on purpose." ;;
    esac
}

# It carries the same bytes built-product-archive would, minus the archive
# format and its manifest, so the board's build directory is written
# directly. The destination is `WebKitBuild/WPE/Release`, *not* the
# cross-target-suffixed name the workspace uses (`Release_rpi4-64bits-mesa`):
# run-benchmark is pointed at the former, and a board only ever holds one build.
#
# Staged through a file rather than piped out of the container: a `t_exec ... |
# tar -x` puts a container exec's stdout straight into an extractor, and
# anything printed ahead of the bytes (an init log, a shell banner) corrupts
# the stream. image/yocto.sh records that exact trap for disk images.
pi_deploy_tar() {
    local ws="$1" machine="$2" target="$3" slot="${4:-a}" b="/src/WebKit/WebKitBuild/WPE"
    local dest; dest=$(pi_build_dir "$slot")
    info "packing bin/ and lib/ from Release_$target"
    t_exec "$ws" bash -c "cd $(sh_quote "$b/Release_$target") &&
        tar -czf /tmp/wk-webkit.tgz bin lib" \
        || die "could not pack the build in '$ws' -- is $b/Release_$target there?"

    local tgz="$PI_TMP/wk-webkit.tgz"
    t_pull "$ws" /tmp/wk-webkit.tgz "$tgz" \
        || die "could not copy the tarball out of '$ws'"
    info "copying $(human_bytes "$(file_bytes "$tgz")") to $machine"

    m_ssh "mkdir -p $(sh_quote "$dest") && tar -C $(sh_quote "$dest") -xzf -" < "$tgz" \
        || die "could not unpack the build on $machine"

    # What this slot holds, beside the bytes. Without it an A/B record can say
    # which slot each side ran from and not which commit that was, which is the
    # half that matters six months later.
    m_ssh "printf '%s\\n' \
        workspace=$(sh_quote "$ws") \
        sha=$(sh_quote "$(t_exec "$ws" bash -c 'cd /src/WebKit && git rev-parse HEAD' 2>/dev/null | tr -d '\r' | tail -1)") \
        deployed=$(date -u +%Y-%m-%dT%H:%M:%SZ) > $(sh_quote "$dest/.wk-slot")" \
        >/dev/null 2>&1 || true

    local built
    built=$(m_ssh "ls -l --time-style=+%Y-%m-%dT%H:%M $(sh_quote "$dest/bin/MiniBrowser") 2>/dev/null | awk '{print \$6}'" 2>/dev/null | tr -d '\r')
    [ -n "$built" ] || die "the unpack reported success but there is no
    $dest/bin/MiniBrowser on $machine."
    log "deployed to $machine (tar transport)"
    log "  MiniBrowser $built"
    log "  slot        $slot ($dest)"
    if [ "$slot" = a ]; then
        log "  next:       wk pi bench $machine <plan>"
    else
        log "  next:       wk pi bench $machine <plan> --slot $slot"
    fi
}

# The skeleton. `--depth 1` of the profile's own branch, from the profile's own
# remote: the tree only has to carry the scripts the board runs, and a full
# history on a bench device is 3 GB of nothing anyone will read there.
pi_skeleton() {
    local machine="$1" url
    url=$(wk_remotes | awk -v r="${YOC_REMOTE:-origin}" '$1 == r { print $2 }')
    [ -n "$url" ] || die "no remote '${YOC_REMOTE:-origin}' in wk_remotes (lib/store.sh)"

    info "provisioning the WebKit skeleton on $machine (--depth 1, ${YOC_BRANCH:-main} from $url)"
    m_ssh "command -v git >/dev/null" \
        || die "$machine has no git, so the skeleton cannot be cloned there.
    A Yocto image has no apt either; the tree has to be copied in instead."
    # Detached on the board, with a log, and resumable -- for the same reason
    # `wk build` is: this is minutes of work over a channel that can drop, and
    # a checkout killed at "Updating files: 42%" by a timeout on *this* end
    # leaves the objects intact (2.8 GB, right branch) with only the working
    # tree half-written, so a re-run completes it instead of fetching it all
    # again.
    #
    # --quiet on both: git's progress meter emitted several thousand
    # "Updating files: N%" lines into the log, which buries everything else.
    m_ssh "mkdir -p /WebKit && cd /WebKit &&
        if [ -d WebKit.part/.git ] &&
           [ \"\$(git -C WebKit.part rev-parse --abbrev-ref HEAD 2>/dev/null)\" = $(sh_quote "${YOC_BRANCH}") ]; then
            echo resuming
        else
            rm -rf WebKit.part
            git clone --quiet --depth 1 --branch $(sh_quote "${YOC_BRANCH}") $(sh_quote "$url") WebKit.part
        fi
        cd WebKit.part && git checkout -f --quiet" \
        || die "the skeleton clone failed on $machine.
    It is resumable -- the objects are kept at /WebKit/WebKit.part and a re-run
    finishes the checkout rather than starting over."
    m_ssh "test -x /WebKit/WebKit.part/Tools/Scripts/run-benchmark" \
        || die "the clone left an incomplete working tree on $machine (no
    Tools/Scripts/run-benchmark). Re-run to finish it."
    m_ssh "cd /WebKit && rm -rf WebKit && mv WebKit.part WebKit && mkdir -p WebKit/WebKitBuild" \
        || die "could not put the skeleton in place on $machine"

    # Three empty directories, and they are load-bearing: webkitdirs.pm walks
    # up looking for `-d Source && -d Source/WebCore && -d
    # Source/JavaScriptCore` (determineSourceDir). A Tools-only tree fails
    # that, so `webkit-build-directory` dies and run-benchmark's WPE driver
    # falls back to "Using default MiniBrowser" -- a browser that doesn't
    # exist here, so the run sits there having launched nothing, reading like
    # a hung benchmark rather than a missing directory.
    #
    # The test is `-d` only, so the skeleton stays ~4,400 files instead of
    # 427,711, and the scripts still resolve the build directory correctly.
    m_ssh 'mkdir -p /WebKit/WebKit/Source/WebCore /WebKit/WebKit/Source/JavaScriptCore' \
        || die "could not create the source-tree markers on $machine"
    m_ssh 'cd /WebKit/WebKit && perl Tools/Scripts/webkit-build-directory --configuration --release --wpe' \
        >/dev/null 2>&1 \
        || die "$machine's skeleton is present but webkit-build-directory still
    cannot resolve a build directory in it. Nothing downstream will find the
    browser; check it by hand before running a benchmark."
    m_ssh 'test -x /WebKit/WebKit/Tools/CISupport/built-product-archive' \
        || die "the clone succeeded but Tools/CISupport is not there -- wrong branch?"
    log "  skeleton at /WebKit/WebKit (its Source/ is NOT what built any binary here)"
}

# --- wk pi bench ---------------------------------------------------------------
#
#   wk pi bench <machine> <plan> [--count N] [--timeout S] [--keep-session]
#
# Runs a browser benchmark on a booted bench system and brings the number back.
# The mechanics are the rpi3 skill's, encoded so that neither a person nor an
# agent re-derives them; what this adds on top is the refusals and the
# provenance, which are the difference between a number and a defensible one.
#
# **The harness is WebKit's own `run-benchmark`, not a URL in a browser.** That
# is not a preference: the benchmarks keep their score in the DOM, so launching
# `run-minibrowser` at browserbench.org tells you the run *finished* and nothing
# about what it scored (the rpi3 skill's §5 says so at length, having tried).
# run-benchmark also clones the benchmark and serves it from a local webserver
# (speedometer3.plan names WebKit/Speedometer.git at release/3.0), keeping the
# content origin on loopback rather than the internet -- nothing in a measured
# run path may be a network mount. Both properties come free with the official
# harness and neither can be bolted onto a URL.
pi_bench_env() {
    # LD_LIBRARY_PATH always: a cross build's RPATH names the *workspace's*
    # build directory, which doesn't exist on the board, so the loader finds
    # nothing and MiniBrowser dies with "cannot open shared object file".
    # `run-minibrowser` papers over this (webkitdirs), but run-benchmark's WPE
    # driver execs MiniBrowser directly and doesn't.
    #
    # WEBKIT_INJECTED_BUNDLE_PATH for the same reason: its location is
    # compiled in as an install prefix, and a deployed build was never
    # installed, so the web process warns "Error loading the injected bundle".
    local b="${1:?pi_bench_env needs a build directory}/lib"
    local libs="export LD_LIBRARY_PATH=$b WEBKIT_INJECTED_BUNDLE_PATH=$b"
    if [ "${PI_SESSION:-}" = headless-rdp ]; then
        printf '%s' "$libs && export XDG_RUNTIME_DIR=/run/user/0 WAYLAND_DISPLAY=wk-bench"
        return 0
    fi
    printf '%s && ' "$libs"
    # weston's own environment, read out of the running compositor rather than
    # assumed. The process to read is `weston-desktop-shell`, not `weston`: the
    # skill's helpers hard-code /run/user/1000 + wayland-1 and say to update
    # them if weston differs, which is a note that only exists because it did.
    printf '%s' 'source <(strings /proc/$(pidof weston-desktop-shell)/environ \
        | grep -E "^(XDG_RUNTIME_DIR|WAYLAND_DISPLAY)=") \
        && export XDG_RUNTIME_DIR WAYLAND_DISPLAY'
}

# cog aborts at startup with no input seat:
#   cog_wl_platform_create_im_context: assertion failed: (display->seat_default)
# so a virtual uinput device has to exist and *stay* alive for the whole run.
# Inline rather than a copied script: one fewer file to get out of sync, and it
# is the form the skill offers for exactly that reason.
PI_SESSION=""
PI_SEAT_PY='import fcntl,os,struct,signal
IOC=lambda d,t,nr,size:(d<<30)|(size<<16)|(t<<8)|nr
U=ord("U")
fd=os.open("/dev/uinput",os.O_WRONLY|os.O_NONBLOCK)
fcntl.ioctl(fd,IOC(1,U,100,4),1)
fcntl.ioctl(fd,IOC(1,U,101,4),1)
os.write(fd,struct.pack("=80s4HI256i",b"wk-bench-seat",3,1,1,1,0,*([0]*256)))
fcntl.ioctl(fd,IOC(0,U,1,0),0)
signal.pause()'

# Save the run where `wk bench compare` will find it.
#
# Printing run-benchmark's JSON to stdout and stopping there makes an on-board
# number a thing you have to keep in a terminal scrollback. The store is
# the only place `wk bench compare` looks (BENCH_DIR, cmd/bench), so a result
# that never lands there cannot be compared against anything -- and comparing
# two runs is most of why anyone takes one. That gap is what an A/B of a kernel
# patch runs straight into: two runs, and no way to put them side by side.
#
# Same directory shape and same three axes as every other run, so the records
# are interchangeable: env.json, result.json, run.log.
pi_bench_record() {
    local machine="$1" plan="$2" sysid="$3" kernel="$4" gov="$5" throttled="$6"
    local root_dev="$7" renderer="$8" session="$9" count="${10}"
    local logf="${11}" res="${12}" slot="${13:-a}" sha="${14:-}" bws="${15:-}"
    local dir="$WK_STORE/bench/$(date -u +%Y%m%dT%H%M%SZ)-$plan-$machine-$slot"
    ensure_dir "$dir"

    m_ssh "cat $(sh_quote "$res")"  > "$dir/result.json" 2>/dev/null || true
    m_ssh "cat $(sh_quote "$logf")" > "$dir/run.log"     2>/dev/null || true

    # kernel_arch and the kernel release, because this is the pair that makes a
    # kernel A/B legible afterwards.
    #
    # kernel_provenance is deliberately *not* a hand-set stock/custom flag. The
    # honest discriminator is already here: two systems built from two profiles
    # have two image ids, and two kernels built from two profiles have two
    # `uname -r` strings if the patched build sets its own LOCALVERSION. Both
    # are read off the running board rather than asserted, which a boolean in a
    # config file would not be.
    local karch
    karch=$(m_ssh 'uname -m' 2>/dev/null | tr -d '\r')

    # The three axes: class from the plan (a CPU-bound suite counts differently
    # from a GPU one), runner is always "browser" here, bench_host is "image"
    # because this path is only reachable against a booted bench system.
    local class=gpu
    case "$plan" in
        jetstream*|octane*|kraken*|sunspider*|ares6*|jsbench*) class=cpu ;;
    esac
    # Software compositing is never incidental on these boards -- there is
    # either a panel or there is not -- and --force is what allows the second.
    local software="" software_reason=""
    if [ "$renderer" = pixman ]; then
        software=1
        software_reason="no display attached; weston rdp + pixman"
    fi

    # workspace is the checkout whose Tools/ matches the binary that produced
    # these numbers -- read back from the board's .wk-slot marker -- which is
    # what `wk bench compare` needs to run compare-results in.
    python3 "$WK_ROOT/lib/wkdata.py" env-record "$dir/env.json" \
        plan="$plan" workspace="${bws:-}" config=wpe-release browser=minibrowser-wpe \
        count="${count:-}" class="$class" runner=browser \
        arch="${karch:-native}" bench_host=image \
        software_reason="$software_reason" \
        session_mode="${session:-}" gpu_renderer="${renderer:-}" \
        machine="$machine" system="$sysid" build_slot="$slot" webkit_sha="${sha:-}" \
        host.kernel="$kernel" host.kernel_arch="$karch" host.governor="$gov" \
        host.throttled="$throttled" host.root_device="$root_dev" \
        --bool forced="${WK_FORCE:-}" --bool software="$software"
    PI_LAST_RUN=$(basename "$dir")
    log "  recorded    $PI_LAST_RUN"
}

cmd_bench() {
    local machine="${1:-}" plan="${2:-}"; shift 2 2>/dev/null || true
    local count="" timeout_s="" keep="" slot=a ab="" rounds=3
    while [ $# -gt 0 ]; do
        case "$1" in
            --count)   count="${2:-}"; shift ;;
            --timeout) timeout_s="${2:-}"; shift ;;
            --keep-session) keep=1 ;;
            --slot)    slot="${2:-}"; pi_check_slot "$slot"; shift ;;
            # Two slots, alternated. See pi_bench_ab. Validated here rather
            # than in that function: the slot-presence check below would
            # otherwise reject a malformed pair with a message about a missing
            # build, which sends the reader to fix the wrong thing.
            --ab)      ab="${2:-}"
                       case "$ab" in
                           *,*) ;;
                           *) die "--ab takes two slot names separated by a comma, e.g. --ab a,b" ;;
                       esac
                       pi_check_slot "${ab%%,*}"; pi_check_slot "${ab##*,}"
                       [ "${ab%%,*}" != "${ab##*,}" ] \
                           || die "--ab needs two different slots (got '${ab%%,*}' twice).
    Two runs from one build directory measure the same binary twice, which is a
    repeatability check rather than an A/B -- '--count N' is the way to ask for
    that."
                       shift ;;
            --rounds)  rounds="${2:-}"; shift ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done
    [ -n "$machine" ] && [ -n "$plan" ] \
        || die "usage: wk pi bench <machine> <plan> [--slot NAME] [--ab A,B [--rounds N]]
                                    [--count N] [--timeout S]"

    machine_load "$machine" || die "no such machine '$machine' (boot/machines.sh)"

    # One run at a time, and this is not politeness. Two run-benchmark
    # invocations on one board each start their own http server, both write this
    # log, and the second's clone appears to hang while the first holds the
    # board -- which is what a stale run from a previous attempt did here, and it
    # read like a stuck benchmark rather than two of them. The same reason
    # bitbake has a cooker lock (image/yocto.sh, yocto_spawn).
    #
    # Bracketed pattern so pgrep does not match the shell carrying this command.
    # `pgrep -fc` prints its count *and* exits non-zero when the count is zero,
    # so a `|| echo 0` appends a second zero and the value becomes "0\n0" --
    # which is not "0", and the guard then refuses every run. head -1 is the fix;
    # the empty case is a pgrep that did not run at all.
    local running
    running=$(m_ssh 'pgrep -fc "run-bench[m]ark" 2>/dev/null | head -1' 2>/dev/null | tr -d '\r\n')
    if [ -n "$running" ] && [ "$running" != 0 ]; then
        die "a benchmark is already running on $machine.
    Watch it:  ssh $MACH_SSH 'tail -f /tmp/wk-bench-*.log'
    Stop it:   ssh $MACH_SSH 'pkill -f run-bench\[m\]ark'"
    fi

    # 1. Bench mode or nothing, and it is not softened here: a run on a machine that never left host mode is a
    # measurement of a desktop with a browser on it, which is a different thing
    # wearing the same number. The evidence is the image's own marker.
    local sysid probe rootdev kind
    probe=$(m_ssh "$_b_probe_sh" 2>/dev/null | tr -d '\r')
    sysid=$(kv_get id <<<"$probe")
    rootdev=$(kv_get rootdev <<<"$probe")
    [ -n "$sysid" ] || die "$machine is not running a wk bench system (no /etc/wk-image).
    A benchmark runs in bench mode or it does not run:
        wk boot $machine --system <id>   then   wk boot $machine --keep"

    # A marker is not enough, and this is the refusal that was missing. Every
    # image wk writes carries /etc/wk-image, the base image included -- so a
    # board that fell back to the medium it is never armed from (an unarmed
    # stick, a stick that would not boot, or a board that has only ever had one
    # medium) passed this check and got measured. The base image is a helper
    # for flashing and recovering other systems; a number taken from it is a
    # number from the wrong system, and it is indistinguishable from a real one
    # afterwards. Evidence, not the record: which device the running root is on.
    kind=$(b_system_kind "$rootdev")
    if [ "$kind" = base ]; then
        die "$machine is running its **base image** ($sysid, root on $rootdev), not a
    bench system. That image is the resilient helper the board falls back to --
    it exists to keep the board reachable and to let another system be written
    and recovered, and it is never the thing to measure.

    Arm a bench system on $MACH_DEVICE and boot it:
        wk boot $machine --system <id>   then   wk boot $machine --keep

    'wk boot $machine --status' says what is there now."
    fi
    if [ "$kind" = unknown ]; then
        warn "cannot tell which medium $machine booted from (root: ${rootdev:-unknown})."
        warn "  proceeding, but check 'wk boot $machine --status': a run against the"
        warn "  base image is a number from the wrong system."
    fi

    # 1b. Is there a display? Asked here, ahead of the build check, and that
    # ordering is deliberate: this refusal cannot be satisfied by anything the
    # user does on the software side, so making them deploy a WebKit first only
    # spends twenty minutes to arrive at the same answer. It is also asked
    # before anything on the board is touched -- a refusal that arrives after
    # netdata has been stopped and a compositor started has already changed the
    # machine it refused to measure.
    local connected renderer session
    connected=$(m_ssh 'grep -l "^connected$" /sys/class/drm/card*-HDMI-*/status 2>/dev/null | head -1' 2>/dev/null | tr -d '\r')

    # No display is a refusal, not a fallback, and the difference is the whole
    # point. Compositing on the CPU does not degrade the number a little: it
    # puts the CPU under test to work drawing the frames, so a Speedometer score
    # taken this way is measuring the renderer as much as the engine. That is a
    # fine thing to do deliberately -- proving the path works, comparing a
    # change against itself -- and a ruinous thing to do by accident, because
    # the result looks exactly like a real one and lands in the same store.
    #
    # Warning and carrying on is the shape that loses the distinction: a
    # warning scrolls past, and six months later the number is just a number. cmd/bench makes the same call for the same reason (a
    # gpu-class plan on a machine with no GPU is refused there too), and
    # --force is the one way through in both.
    if [ -z "$connected" ] && [ -z "${WK_FORCE:-}" ]; then
        die "$machine has no display attached, so the only session available composites
    on the CPU (weston's RDP virtual head, pixman renderer). $plan would then be
    measuring the software renderer as much as the browser, and the result would
    be indistinguishable from a real one afterwards.

    Attach a display, or say so on purpose:

        wk pi bench $machine $plan --force

    The run is recorded as software-composited either way; --force is what makes
    that a decision rather than an accident."
    fi

    # 2. The build(s) the whole thing measures. Every slot this run will use is
    # checked here, before the session is brought up -- an --ab that discovers
    # its second slot is missing only after the first half has run has wasted
    # the first half and left half an experiment in the store.
    local _s _need="$slot"
    [ -z "$ab" ] || _need="${ab%%,*} ${ab##*,}"
    for _s in $_need; do
        pi_check_slot "$_s"
        m_ssh "test -x $(sh_quote "$(pi_build_dir "$_s")/bin/jsc")" 2>/dev/null \
            || die "$machine has no WebKit build in slot '$_s' ($(pi_build_dir "$_s")).
    The image is the runtime and carries no browser; deploy one first:
        wk pi deploy <workspace> $machine --slot $_s"
    done

    # 3. Provenance, gathered before the run rather than reconstructed after.
    local kernel gov throttled root_dev forced
    kernel=$(m_ssh 'uname -r' 2>/dev/null | tr -d '\r')
    gov=$(m_ssh 'cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null' 2>/dev/null | tr -d '\r')
    throttled=$(m_ssh 'vcgencmd get_throttled 2>/dev/null' 2>/dev/null | tr -d '\r')
    root_dev=$(m_ssh 'findmnt -no SOURCE /' 2>/dev/null | tr -d '\r')
    forced=$(manifest_get "$sysid" display_forced 2>/dev/null || true)

    log "$machine: $sysid"
    log "  kernel      $kernel"
    log "  root        $root_dev"
    log "  governor    ${gov:-unknown}$([ "$gov" = performance ] || echo '   <-- not pinned; the score is not a perf result')"
    log "  throttled   ${throttled:-unknown}$(case "$throttled" in throttled=0x0) ;; *) echo '   <-- non-zero: thermally or voltage limited' ;; esac)"
    [ -n "$forced" ] && warn "this system's display is FORCED ($forced), so the compositor is
  drawing to a mode no panel negotiated. The run proves the path works; the
  number is not comparable with one taken against real hardware."

    # 4. The graphical session. Which one it is was already decided above; a
    # display that is absent has ended the run by now unless --force said
    # otherwise.
    # netdata goes first either way -- it competes for the CPU being measured,
    # and the board's own runbook stops it before every run.
    info "bringing up the session on $machine"
    m_ssh 'systemctl stop netdata 2>/dev/null' >/dev/null 2>&1 || true

    if [ -n "$connected" ]; then
        # A real panel: weston's own service, DRM backend, GL renderer. The
        # only configuration whose number is comparable with other hardware.
        renderer=gl; session=drm
        m_ssh 'systemctl start --no-block weston' >/dev/null 2>&1 || true
    else
        # None attached. The compositor still needs an *output*, and "no
        # display" is not the same thing as "no compositor": weston's RDP
        # backend synthesises a head with no display hardware at all, and the
        # pixman renderer composites it on the CPU. Nothing has to connect to
        # the RDP port for the output to exist -- it is a virtual head, not a
        # remote desktop -- so this needs no client and no network in the run.
        #
        # This is the honest headless answer, and it is *not* the same as
        # forcing a mode with `video=`: that hangs vc4 in probe and takes the
        # board off the network. Software compositing costs a
        # comparable number, which is recorded rather than hidden.
        renderer=pixman; session=headless-rdp
        info "  no display attached: RDP virtual head + pixman (software) compositing"
        # The backend refuses to start without keys. Generated here, once, so
        # the session is reproducible rather than depending on what somebody
        # left on the board.
        m_ssh 'mkdir -p /etc/wk-bench && [ -f /etc/wk-bench/rdp.key ] || {
                 openssl req -x509 -newkey rsa:2048 -nodes \
                   -keyout /etc/wk-bench/rdp.key -out /etc/wk-bench/rdp.crt \
                   -days 3650 -subj /CN=wk-bench >/dev/null 2>&1
                 chmod 600 /etc/wk-bench/rdp.key; }' >/dev/null 2>&1 \
            || die "could not create the RDP backend's keys on $machine (needs openssl)"
        # desktop-shell, not fullscreen-shell: the latter serves no xdg-shell,
        # and a browser asking for one gets "invalid object" and exits. Measured
        # by watching weston-simple-shm do exactly that.
        m_ssh 'pkill -x weston 2>/dev/null; sleep 1
               mkdir -p /run/user/0 && chmod 700 /run/user/0
               XDG_RUNTIME_DIR=/run/user/0 setsid weston \
                 --backend=rdp-backend.so --renderer=pixman \
                 --width=1280 --height=1024 --socket=wk-bench \
                 --rdp-tls-cert=/etc/wk-bench/rdp.crt \
                 --rdp-tls-key=/etc/wk-bench/rdp.key \
                 </dev/null >/tmp/wk-weston.log 2>&1 & sleep 6' >/dev/null 2>&1 || true
    fi

    local i=0 out=""
    while [ "$i" -lt 20 ]; do
        out=$(m_ssh 'grep -oE "Output .[a-z0-9-]+. enabled" /tmp/wk-weston.log 2>/dev/null | tail -1;
                     pidof weston-desktop-shell 2>/dev/null' 2>/dev/null | tr -d '\r' | head -1)
        [ -n "$out" ] && break
        i=$((i + 1)); sleep 2
    done
    [ -n "$out" ] || die "no compositor output on $machine.
    Check:  ssh $MACH_SSH 'tail -30 /tmp/wk-weston.log; journalctl -u weston -n 20'
    and whether a display is seen at all:
        ssh $MACH_SSH 'for c in /sys/class/drm/card*/status; do echo \$c \$(cat \$c); done'"
    PI_SESSION="$session"
    log "  session     $session, $renderer renderer ($out)"
    [ "$renderer" = pixman ] && warn "compositing is on the CPU, so this number is not comparable with a
  run on real display hardware. It proves the path, which is what it is for."

    # The seat, once, and left running for the whole session.
    if ! m_ssh 'pgrep -f wk-bench-seat >/dev/null' 2>/dev/null; then
        m_ssh "setsid python3 -c $(sh_quote "$PI_SEAT_PY") </dev/null >/tmp/wk-seat.log 2>&1 & sleep 2" >/dev/null 2>&1 || true
    fi
    m_ssh 'pgrep -f "signal.pause|wk-bench-seat" >/dev/null' 2>/dev/null \
        && log "  input seat  up" \
        || warn "no fake input seat -- cog asserts at startup without one; the run may abort"

    # 5/6. The run(s). One slot, or two alternated.
    if [ -n "$ab" ]; then
        pi_bench_ab "$ab" "$rounds"
        return $?
    fi
    pi_bench_once "$slot" || die "benchmark failed on $machine"
    m_ssh "cat /tmp/wk-bench-$plan-$slot.json"
}

# One run, from a named slot, waited on and recorded.
#
# Split out of cmd_bench so that --ab can call it repeatedly against a session
# that was brought up once. That is not a refactor for tidiness: bringing the
# compositor down and up between the halves of an A/B would put a fresh
# weston, a fresh seat and a cold page cache on one side of the comparison and
# not the other.
pi_bench_once() {
    local slot="$1" bdir; bdir=$(pi_build_dir "$slot")

    m_ssh "test -x $(sh_quote "$bdir/bin/jsc")" 2>/dev/null \
        || die "$machine has no WebKit build in slot '$slot' ($bdir).
    Deploy one first:
        wk pi deploy <workspace> $machine${slot:+ --slot $slot}"

    # Detached on the board with its own log, because a Speedometer 3 round is
    # minutes and an ssh channel held open for it is a channel that can drop
    # and take the run with it. Log and result are named per slot so two halves
    # of an A/B cannot overwrite each other's evidence.
    local logf="/tmp/wk-bench-$plan-$slot.log" res="/tmp/wk-bench-$plan-$slot.json"
    local rcf="/tmp/wk-bench-$plan-$slot.rc"
    local args="--plan $(sh_quote "$plan") --browser minibrowser-wpe --platform linux"
    args="$args --build-directory $(sh_quote "$bdir")"
    args="$args --output-file $(sh_quote "$res")"
    [ -n "$count" ] && args="$args --count $(sh_quote "$count")"

    info "running $plan on $machine from slot '$slot' (detached; log $logf)"
    # The stale result from a previous run in this slot is not evidence of
    # this one; detach_remote truncates the log itself, but the json output
    # lives at a path of run-benchmark's own choosing and is this call's to
    # clear.
    m_ssh "rm -f $(sh_quote "$res")" >/dev/null 2>&1 || true
    detach_remote m_ssh "$logf" "$rcf" -- \
        bash -c "cd /WebKit/WebKit && $(pi_bench_env "$bdir") && exec Tools/Scripts/run-benchmark $args" \
        || die "could not start the benchmark on $machine"

    # The abort pattern is the same early-crash regex this used to grep for by
    # hand every 20s; detach_wait_remote now does that polling and returns
    # `aborted` the moment it matches, rather than waiting out the timeout.
    local start; start=$(date +%s)
    local rc; rc=$(detach_wait_remote m_ssh "$logf" "$rcf" 20 0 "${timeout_s:-3600}" \
        'Traceback|Crash!|cannot open display|assertion failed') || true
    local waited=$(( $(date +%s) - start ))

    case "$rc" in
        aborted)
            warn "the run from slot '$slot' reported a failure; its log follows"
            m_ssh "tail -30 $(sh_quote "$logf")"
            return 1
            ;;
        timeout|'')
            warn "no result from slot '$slot' after ${timeout_s:-3600}s -- the run may still be going"
            m_ssh "tail -20 $(sh_quote "$logf")"
            return 1
            ;;
    esac

    # Wait on the result file, not the process's exit code: run-benchmark
    # writes it when it has a score, which is the only completion signal that
    # means what it says. A process that exited without one is still a
    # failure, just not the same failure as a timeout.
    if m_ssh "test -s $(sh_quote "$res")" 2>/dev/null; then
        log "  result      after ${waited}s"
        pi_bench_record "$machine" "$plan" "$sysid" "$kernel" "$gov" \
            "$throttled" "$root_dev" "$renderer" "$session" "$count" \
            "$logf" "$res" "$slot" "$(pi_slot_sha "$bdir")" "$(pi_slot_ws "$bdir")"
        return 0
    fi
    warn "no result from slot '$slot' after ${waited}s -- the run may still be going"
    m_ssh "tail -20 $(sh_quote "$logf")"
    return 1
}

# What a slot holds, written by `wk pi deploy`.
pi_slot_sha() {
    m_ssh "sed -n 's/^sha=//p' $(sh_quote "$1/.wk-slot") 2>/dev/null" 2>/dev/null \
        | tr -d '\r' | head -1
}
pi_slot_ws() {
    m_ssh "sed -n 's/^workspace=//p' $(sh_quote "$1/.wk-slot") 2>/dev/null" 2>/dev/null \
        | tr -d '\r' | head -1
}

# Interleaved A/B: A B A B ..., not AAA then BBB.
#
# The order is the whole point. These boards drift -- they warm up, the SoC
# throttles, the SD card's cache state changes -- and every one of those drifts
# monotonically over the tens of minutes an A/B takes. Run all of A and then
# all of B and the drift lands entirely on B, where it is indistinguishable
# from an effect of the change. Alternating spreads it across both arms, which
# is the standard answer and the reason this is a verb rather than advice in a
# document.
#
# Each half is recorded as its own run, so the output is 2N runs in the store
# and the statistics are `wk bench compare`'s job, not this function's --
# compare-results already does Welch with FDR correction across subtests, and
# reimplementing that here would be a second, worse copy.
pi_bench_ab() {
    local spec="$1" n="$2" a b i
    # The pair was validated at parse time (cmd_bench); only the count is new.
    a="${spec%%,*}"; b="${spec##*,}"
    case "$n" in ''|*[!0-9]*) die "--rounds takes a number (got '$n')" ;; esac
    [ "$n" -ge 1 ] || die "--rounds needs to be at least 1"

    log "interleaving $n round(s) of $a vs $b -- $((n * 2)) runs"
    log "  alternated rather than blocked, so thermal drift lands on both arms"

    # Only *paired* rounds are compared, and that is the whole resilience
    # design. A round where one arm crashed and the other did not is not half a
    # data point -- including the survivor puts one extra sample on one arm,
    # and since a crash is usually a property of the build being crashed (OOM
    # under a heavier binary, say) the surviving arm is exactly the one that
    # would bias the answer. So a broken round is dropped from the comparison
    # whole.
    #
    # Dropped, not deleted: both records stay in the store. The run that
    # succeeded is still evidence, and an investigation into why its partner
    # died starts from it.
    local a_runs="" b_runs="" ra rb kept=0 lost=0
    i=1
    while [ "$i" -le "$n" ]; do
        log ""
        log "round $i/$n -- slot $a"
        ra=""; rb=""
        if pi_bench_once "$a"; then ra="$PI_LAST_RUN"; fi
        log "round $i/$n -- slot $b"
        if pi_bench_once "$b"; then rb="$PI_LAST_RUN"; fi

        if [ -n "$ra" ] && [ -n "$rb" ]; then
            a_runs="${a_runs:+$a_runs,}$ra"
            b_runs="${b_runs:+$b_runs,}$rb"
            kept=$((kept + 1))
        else
            lost=$((lost + 1))
            warn "round $i produced ${ra:+a }${rb:+b }only -- dropped from the comparison"
            # A board that has started failing usually keeps failing, and the
            # next round costs the same minutes. Carrying on is still right --
            # a transient OOM is real and recoverable -- but say how it is
            # going so a run that is quietly losing every round is visible
            # while there is still time to stop it.
            [ "$lost" -lt 3 ] || { warn "three rounds lost; stopping early"; break; }
        fi
        i=$((i + 1))
    done

    log ""
    log "$kept round(s) usable, $lost dropped"
    [ "$kept" -ge 1 ] || die "no round produced both halves; nothing to compare.
    The individual runs that did finish are in the store ('wk bench ls')."

    # The comparison itself is compare-results' job and nobody else's. It is
    # WebKit's own tool, it does Welch with FDR correction across subtests, and
    # it merges the several JSONs of one arm on its own (`-a` takes nargs='+').
    # Anything computed here instead would be a second implementation of that,
    # differing from the one every other WebKit result is judged by.
    log ""
    log "comparing with compare-results: $kept run(s) per arm, merged"
    log "  a = slot $a   b = slot $b"
    "$WK_ROOT/wk" bench compare "$a_runs" "$b_runs" \
        || warn "compare-results did not complete; the runs are recorded and can be
  compared by hand:  wk bench compare $a_runs $b_runs"
}

# --- wk pi boot-order ----------------------------------------------------------
#
# The EEPROM's only writer, and the reason that matters: `BOOT_ORDER` is
# firmware state *shared by both of a machine's modes*, so a wrong value costs
# a trip to the device. There are two orders, the local-boot lane's and its
# undo, because those are the only two boots this fleet asks a board to make.
#
# BOOT_ORDER reads lowest-nibble-first, so the string is written in reverse
# priority: 0xf41 is SD(1), then USB(4), then restart(f). The network nibble
# (2) is stripped by every order here, and so are the TFTP_IP/CLIENT_IP keys
# that go with it: no lane here boots over the network, and a board carrying
# either one would spend every boot on a source nothing answers -- benign, but
# a stale fact that reads as a live one.

boot_order_without_net() {
    local order="${1#0x}"
    printf '0x%s' "$(printf '%s' "$order" | sed 's/2//g')"
}

# USB first, then whatever else was there -- the local-boot lane.
#
# `0xf412 -> 0xf14`. Network comes out because this lane does not use it, and
# USB moves to the front because the default order tries the SD card first: an
# image written to the stick with `0xf41` in the EEPROM is an image that never
# boots, and the symptom is a board that comes up looking perfectly normal on
# the wrong root.
#
# The SD card staying *behind* USB is the whole safety property. A stick with no
# bootable filesystem is skipped and the board lands on its rescue image,
# reachable, with no one in the room. Falling through is the property to
# protect: firmware that gets as far as start4.elf and no further **halts**
# instead, and a halted board needs a person.
#
# Derived from the current order rather than written as a constant, so a board
# with an entry this does not know about (6 is NVMe on a Pi 5) keeps it.
boot_order_usb_first() {
    local order="${1#0x}"
    order=$(printf '%s' "$order" | sed 's/2//g')
    order=$(printf '%s' "$order" | sed 's/4//g')
    printf '0x%s4' "$order"
}

# One writer. BOOT_ORDER is firmware state shared by every mode a machine
# has, and two commands that could both write it is two places for a wrong
# value to come from.
cmd_boot_order() {
    local dry="" revert=""
    local order_name="${ORDER_NAME:-}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run)   dry=1 ;;
            --revert)    revert=1 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    if [ -z "$order_name" ]; then
        if [ -n "$revert" ]; then
            order_name=local
        else
            # The order defaults from what the fleet says this machine is,
            # not from a flag the caller has to remember: getting it wrong on
            # a workstation costs a trip to the device.
            if machine_by_ssh "$HOST" && [ "${MACH_ROLE:-workstation}" = bench-device ]; then
                order_name=usb-first
            else
                order_name=local
            fi
        fi
    fi

    case "$order_name" in
        usb-first|local) ;;
        *) die "no such boot order '$order_name'.
    orders:
      usb-first      USB, then the SD card -- the local-boot lane, where the
                     stick carries the system and the card is the rescue role
      local          the local disks only, network removed" ;;
    esac

    rsh true >/dev/null 2>&1 || die "cannot ssh to $HOST.
    This writes the board's firmware configuration, so it needs the board
    running and reachable -- a Pi that cannot be reached at all has to be met
    physically first, with a card written by 'wk sysimage write'."

    # Two ways to write an EEPROM, and which one is available is a property of
    # the image the board happens to be running rather than of the board.
    #
    #   onboard   rpi-eeprom-config --apply, on the device. Raspberry Pi OS.
    #   recovery  stage recovery.bin + pieeprom.upd and let the ROM do it.
    #             boot/rpi-eeprom.sh, and it needs nothing on the board.
    #
    # onboard is preferred where it exists, because it edits the *running*
    # EEPROM image and so changes only what was asked for; recovery replaces
    # the whole image with a pinned release. Refusing outright when onboard is
    # missing grounds a board that has no rpi-eeprom-config.
    local method=onboard
    if ! rsh 'command -v rpi-eeprom-config >/dev/null 2>&1'; then
        method=recovery
        eeprom_check_soc
    fi

    local current new
    if [ "$method" = onboard ]; then
        current=$(rsh 'sudo rpi-eeprom-config') || die "could not read $HOST's EEPROM configuration"
    else
        current=$(eeprom_read_config)
    fi

    local order
    order=$(kv_get BOOT_ORDER <<<"$current")
    [ -n "$order" ] || order=0xf41

    # The network-boot keys come out unconditionally: nothing here writes
    # them, and a TFTP_IP left behind on a board is a stale fact that reads as
    # a live one.
    local stripped want
    stripped=$(printf '%s\n' "$current" | grep -vE '^(TFTP_IP|CLIENT_IP|SUBNET|GATEWAY)=')

    case "$order_name" in
        local)     want=$(boot_order_without_net "$order") ;;
        usb-first) want=$(boot_order_usb_first "$order") ;;
    esac
    new=$(printf '%s\n' "$stripped" | sed "s|^BOOT_ORDER=.*|BOOT_ORDER=$want|")

    # The no-change case reads badly the other way round: a "would change"
    # header followed by an empty diff and then "already says this" is three
    # lines saying one thing, and the one they agree on is the opposite of the
    # header. It is also the *common* case once a board is set up.
    if [ "$current" = "$new" ]; then
        info "$HOST's firmware already says this; nothing to write"
        # And if it says this *because* a staged update was applied, the files
        # that carried it have done their job. This is the only moment that is
        # knowable -- the staging runs before the reboot that consumes it, so
        # it can never clean up after itself.
        [ "$method" = recovery ] && eeprom_clear_staged
        return 0
    fi

    log "$HOST's firmware configuration would change (boot order: $order_name):"
    diff -u <(printf '%s\n' "$current") <(printf '%s\n' "$new") | sed '1,2d;s/^/  /' || true

    if [ -n "$dry" ]; then
        log "dry run -- the EEPROM was not written."
        return 0
    fi

    warn "this writes $HOST's EEPROM. BOOT_ORDER is shared by both of that"
    warn "machine's roles, and a bad value needs physical access to fix."
    if [ "$method" = recovery ]; then
        warn ""
        warn "$HOST has no rpi-eeprom-config, so this goes through recovery.bin --"
        warn "which replaces the whole bootloader image with rpi-eeprom's pinned"
        warn "$EEPROM_IMAGE, carrying the configuration above onto it. The"
        warn "bootloader is upgraded as well as configured."
    fi
    confirm "write this configuration to $HOST's EEPROM?" || die "not written"

    if [ "$method" = onboard ]; then
        printf '%s\n' "$new" | rsh 'cat > /tmp/wk-boot.conf && sudo rpi-eeprom-config --apply /tmp/wk-boot.conf' \
            || die "rpi-eeprom-config refused the configuration; nothing was written"
        info "$HOST's EEPROM updated; it takes effect on the next boot"
        log  "  verify with: ssh $HOST sudo rpi-eeprom-config"
    else
        eeprom_stage_recovery "$new"
        info "$HOST's EEPROM update is staged; the ROM applies it on the next boot"
        log  "  apply with:  ssh $HOST reboot"
        log  "  verify with: ssh $HOST vcgencmd bootloader_config"
        log  "  the board goes through firmware twice, so allow a few minutes"
    fi
    log  "  undo with:   wk pi boot-order $HOST local"
}

# --- inside a workspace, deploy and bench are requests -------------------------
#
# `wk pi` is host-only and stays host-only: putting a device on the tailnet
# needs an auth key and writing an EEPROM boot order needs the board. Two of
# its verbs, though, are exactly the outcomes a sandboxed benchmark run has to
# have and cannot produce -- put this build on the board, and run this plan on
# it -- so in a workspace those two become a request over the socket, performed
# by the broker on the workstation (lib/broker.sh).
#
# Parsed here rather than forwarded as a line: what crosses is a verb and a
# handful of validated words, so the broker's vocabulary is the limit and not
# whatever this file happens to accept. An option outside that vocabulary is
# refused by name here rather than dropped -- a request that silently ran
# without the flag it was given is the worst of the three available outcomes.
if in_workspace; then
    . "$WK_ROOT/lib/broker.sh"
    case "$ACTION" in
        deploy|bench) ;;
        *) broker_no_route "'wk pi $ACTION'" "wk pi $ACTION ..." ;;
    esac
    broker_present || broker_no_route "'wk pi $ACTION'" "wk pi $ACTION $HOST $*"

    # One bare word is expected after the top-level shift: the machine for
    # `deploy` (whose first argument is the workspace, taken into $HOST), the
    # plan for `bench`. Everything else is either a vocabulary word or a
    # refusal.
    _pos=""; _opts=""; _slot=""; _extra=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --slot)     _slot="${2:-}"; shift ;;
            --count)    _opts="$_opts count=${2:-}"; shift ;;
            --skeleton) _opts="$_opts skeleton=1" ;;
            -*)         _extra="$_extra $1" ;;
            *)          if [ -n "$_pos" ]; then _extra="$_extra $1"; else _pos="$1"; fi ;;
        esac
        shift
    done
    [ -z "$_extra" ] || die "the request broker's vocabulary does not carry:$_extra
    A request is a fixed set of outcomes, not this command's option list, and
    the set is in container/broker/wk-broker.py -- deliberately smaller than
    what this command accepts at a keyboard, because each argument that crosses
    the boundary is one more thing that has to be validated out there.
    Run it on the workstation instead:  wk pi $ACTION $HOST $_pos$_extra"
    [ -z "$_slot" ] || _opts="$_opts slot=$_slot"

    _rc=0
    # shellcheck disable=SC2086  -- $_opts is a list of validated key=value words
    if [ "$ACTION" = deploy ]; then
        broker_call stage machine="$_pos" workspace="$HOST" $_opts || _rc=$?
    else
        broker_call run machine="$HOST" plan="$_pos" $_opts || _rc=$?
    fi
    exit "$_rc"
fi

# $HOST holds $2, which for `deploy` is the workspace -- the argument order is
# <workspace> <machine>, so the machine is what is left after the top-level
# shift. Named locally rather than reusing $HOST, which means an ssh host
# everywhere else in this file.
if [ "$ACTION" = deploy ]; then
    cmd_deploy "$HOST" "$@"
    exit 0
fi

if [ "$ACTION" = bench ]; then
    cmd_bench "$HOST" "$@"
    exit 0
fi

if [ "$ACTION" = boot-order ]; then
    ORDER_NAME=""
    case "${1:-}" in
        ''|--*) ;;
        *) ORDER_NAME="$1"; shift ;;
    esac
    cmd_boot_order "$@"
    exit 0
fi

info "probing $HOST"
ARCH=$(rsh 'uname -m') || die "cannot ssh to $HOST"
KERNEL=$(rsh 'uname -r')

case "$ARCH" in
    aarch64|arm64) TS_ARCH=arm64 ;;
    armv7l|armv6l) TS_ARCH=arm ;;
    x86_64)        TS_ARCH=amd64 ;;
    *) die "unsupported architecture: $ARCH" ;;
esac
log "  arch=$ARCH kernel=$KERNEL -> tailscale_${TS_VERSION}_${TS_ARCH}"

# A buildroot rootfs is often read-only or tiny, so find somewhere durable to
# put the binaries and the node state rather than assuming /usr/local exists.
DEST=$(rsh 'for d in /opt /data /usr/local /home/root /root; do
              if [ -d "$d" ] && touch "$d/.wk-probe" 2>/dev/null; then
                rm -f "$d/.wk-probe"; echo "$d"; exit 0
              fi
            done
            echo /tmp')
log "  writable prefix: $DEST"

# Kernel-mode Tailscale needs /dev/net/tun. Userspace mode is the fallback and
# needs no kernel support at all, which is what keeps the no-image-change
# promise honest on a buildroot device.
if rsh 'test -c /dev/net/tun'; then
    TS_MODE=kernel
    log "  /dev/net/tun present -> kernel networking"
else
    TS_MODE=userspace
    warn "/dev/net/tun absent -> userspace networking"
    warn "  verify inbound ssh over the tailnet works on this device;"
    warn "  if it does not, fall back to a Pi-originated reverse tunnel (still no image change)"
fi

# The published checksum for this arch, from the same file as the version,
# checked before the tarball is unpacked on a device whose whole job is to run
# other people's code and report numbers about it.
TS_SHA256=$(ts_release_field "TS_SHA256_$TS_ARCH")
[ -n "$TS_SHA256" ] || die "$TS_RELEASE declares no TS_SHA256_$TS_ARCH.
    Add the published checksum for that architecture:
      curl -fsS https://pkgs.tailscale.com/stable/tailscale_${TS_VERSION}_${TS_ARCH}.tgz.sha256"

info "installing tailscale $TS_VERSION on $HOST"
rsh "set -e
    cd '$DEST'
    if [ ! -x '$DEST/tailscaled' ]; then
        url=https://pkgs.tailscale.com/stable/tailscale_${TS_VERSION}_${TS_ARCH}.tgz
        # wget and sha256sum, not curl or openssl: every image this repo builds
        # is at least busybox, and busybox carries the first of each pair and
        # never the second. One path, checked and refused rather than guessed.
        command -v wget >/dev/null \
            || { echo 'no wget on this board; refusing to fetch tailscale unverified' >&2; exit 1; }
        wget -qO ts.tgz \"\$url\"
        # Verified before it is unpacked, not after: an archive that is not the
        # one this fleet pinned must never be written to the disk at all.
        command -v sha256sum >/dev/null \
            || { echo 'no sha256sum on this board; refusing to unpack an unverified tarball' >&2; exit 1; }
        echo '$TS_SHA256  ts.tgz' | sha256sum -c - >/dev/null
        tar xzf ts.tgz --strip-components=1 \
                  'tailscale_${TS_VERSION}_${TS_ARCH}/tailscale' \
                  'tailscale_${TS_VERSION}_${TS_ARCH}/tailscaled'
        rm -f ts.tgz
        chmod +x tailscale tailscaled
    fi
    mkdir -p '$DEST/tailscale-state'"

# BusyBox init: an S-script is the portable option, since buildroot images
# usually have neither systemd nor a service manager with a unit format.
FLAGS="--state=$DEST/tailscale-state/tailscaled.state --socket=$DEST/tailscale-state/tailscaled.sock"
[ "$TS_MODE" = userspace ] && FLAGS="$FLAGS --tun=userspace-networking"

rsh "cat > '$DEST/tailscale-up.sh' <<'EOF'
#!/bin/sh
# Installed by wk pi setup. Starts tailscaled with state on a writable
# partition so nothing in the read-only rootfs has to change.
DEST=$DEST
[ -S \"\$DEST/tailscale-state/tailscaled.sock\" ] && exit 0
\"\$DEST/tailscaled\" $FLAGS >/var/log/tailscaled.log 2>&1 &
EOF
chmod +x '$DEST/tailscale-up.sh'
'$DEST/tailscale-up.sh'"

sleep 2

# Only prompt for an auth key when the node actually needs one: a re-run
# against a device already on the tailnet is routine, and prompts are for
# things that cannot proceed without an answer.
TSIP=$(rsh "'$DEST/tailscale' --socket='$DEST/tailscale-state/tailscaled.sock' ip -4" 2>/dev/null | head -1) || TSIP=""
if [ -n "$TSIP" ]; then
    info "$HOST is already on the tailnet at $TSIP -- no auth key needed"
else
    info "bringing the node up as $TAG"

    # The fleet's one key, from the one place it lives (wk_tailscale_authkey,
    # lib/common.sh) rather than a `read` of its own. Two reasons, and the
    # second is the one that bit: a second copy of a credential is state this
    # repository refuses, and a command that stops to ask for a secret cannot be
    # run from a script or handed to an agent -- which is exactly how a board
    # ends up staying off the tailnet with its address written down somewhere
    # instead.
    KEYFILE=$(wk_tailscale_authkey) || die "no tailscale auth key, so this board cannot join the tailnet.
    It has to: everything wk touches is on the tailnet, and a node is reached by
    its tailnet name with nothing about how to reach it stored anywhere
    (CLAUDE.md, 'Cattle, not pets'). The key must be tagged $TAG."

    # Over the same ssh into a 0600 file, and never onto a command line: argv is
    # world readable in /proc, so `--authkey=tskey-...` hands the key to anything
    # with a shell on the board. `wk bridge` makes the same argument at length
    # and does the same thing. `--auth-key file:` is how tailscale reads one
    # without argv; the file goes as soon as it has been spent, whether or not
    # the join worked.
    rsh "umask 077; cat > '$DEST/tailscale-state/authkey'" < "$KEYFILE" \
        || die "could not hand the auth key to $HOST"

    UP_RC=0
    rsh "'$DEST/tailscale' --socket='$DEST/tailscale-state/tailscaled.sock' up \
            --auth-key='file:$DEST/tailscale-state/authkey' \
            --advertise-tags='$TAG' --hostname='$(basename "$HOST")'" || UP_RC=$?
    rsh "rm -f '$DEST/tailscale-state/authkey'" || \
        warn "the spent auth key is still at $DEST/tailscale-state/authkey on $HOST"
    [ "$UP_RC" -eq 0 ] || die "tailscale up failed on $HOST (exit $UP_RC).
    A key that is single-use, untagged, or expired fails exactly here; the node
    is left with tailscaled running and no identity, and re-running this is safe."

    TSIP=$(rsh "'$DEST/tailscale' --socket='$DEST/tailscale-state/tailscaled.sock' ip -4" | head -1)
fi
info "$HOST is on the tailnet at $TSIP"

# Add the address to the workspace egress allowlist. Individual addresses, not
# the whole CGNAT range: the workstation is itself an unrestricted tailnet node,
# so allowing 100.64.0.0/10 would let a workspace reach everything it can.
# The file lives in the store, which ./setup never regenerates, so re-running
# setup cannot cut the test devices off.
PI_FILE="$WK_STORE/pi-hosts"
ensure_dir "$(dirname "$PI_FILE")"
if ! grep -qxF "$TSIP" "$PI_FILE" 2>/dev/null; then
    printf '%s\n' "$TSIP" >> "$PI_FILE"
    info "recorded $TSIP in $PI_FILE"
fi

# The file *is* the policy: the egress proxy re-reads it on every request, so
# a device added here is reachable immediately with nothing to reload.
info "allowed $TSIP (the egress proxy re-reads $PI_FILE per request)"

cat >&2 <<EOF

Remaining manual step -- the tailnet ACL. In the admin console, grant tag:wk
full access to itself so workspaces and Pis can reach each other:

  "tagOwners": { "tag:wk": ["autogroup:admin"] },
  "grants": [
    { "src": ["tag:wk"], "dst": ["tag:wk"], "ip": ["*"] },
    { "src": ["autogroup:member"], "dst": ["*"], "ip": ["*"] }
  ]

Note the existing tag:server covers moose, nextcloud, immich, overleaf and the
gateway -- do not reuse it here, or workspaces get all of them.
EOF
