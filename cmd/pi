#!/usr/bin/env bash
#
# wk pi <verb> <args> -- Raspberry Pi test boards: get one on the tailnet, then run WebKit on it
#
# wk: where=host name=none group=hosts broker deploy,bench needs ssh,python3
#
# A board runs a bench system on removable media; its own workstation install
# is never touched. `wk help` has the per-board arrangement.
#
#   wk pi setup <ssh-host>                put it on the tailnet: copies pinned
#                                         tailscale binaries onto a writable
#                                         partition; no image rebuild
#   wk pi boot-order <machine> <order>    rpi4/rpi5 firmware boot order;
#                                         --revert undoes it, --dry-run previews
#   wk pi deploy <image-profile> <machine> --slot <name>
#                                         put a built WebKit on the board as a
#                                         slot (the profile's slot from 'wk
#                                         sysimage webkit', buildroot or yocto);
#                                         verified byte for byte on the board
#   wk pi bench <machine> <plan>          run a benchmark on a booted bench
#       [--slot NAME] [--count N] [--timeout S]
#                                         system; refuses the rescue and a
#                                         missing display without --force;
#                                         --count N is iterations per run,
#                                         --timeout S the seconds one iteration
#                                         may take (default: the plan's own).
#                                         run-benchmark runs here and drives
#                                         the board's browser over ssh; the
#                                         process that reports is checked
#                                         against the slot's build-id
#       [--cores <set>]                   pin the browser: taskset -c <set>,
#                                         same syntax as wk bench
#       --ab A,B [--rounds N]             interleaved A/B between two deployed
#                                         slots, reported with wk bench report
#       --task <name>                     file the runs into an existing task
#                                         (wk ab's); without it this command
#                                         is its own task
#                                         Every run lands on this machine, in
#                                         the task's directory (wk bench ls);
#                                         the board keeps nothing of it
#
#   WK_PI_TAG=<tag>                       the tailscale tag 'wk pi setup'
#                                         advertises when it brings a board up
#                                         (default tag:wk)
#
# Bare-board order, one step each. Flashing is wk sysimage write, not a verb
# here: it is an image operation shared by every machine and medium.
#   wk sysimage build <profile>                  build the image
#   wk sysimage disks <machine>                  find the disk to write it to
#   wk sysimage write --from <path> \
#       --disk <machine>:<device>                write it
#   wk pi boot-order <machine> <usb-first|sd-first|local>    set the boot order
#   wk boot <machine>                            boot it
#   wk pi setup <ssh-host>                       put it on the tailnet
#   wk sysimage webkit <profile> --commit <sha> --slot <name>
#                                                build a WebKit for the image
#   wk pi deploy <profile> <machine> --slot <name>   put it on the board
#   wk pi bench <machine> <plan>                 run a benchmark

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/boot/machines.sh"
. "$WK_ROOT/lib/image.sh"
. "$WK_ROOT/image/profiles.sh"
. "$WK_ROOT/boot/disk.sh"
. "$WK_ROOT/boot/rpi-eeprom.sh"
. "$WK_ROOT/lib/detach.sh"
# For `deploy`, which reaches into a build workspace as well as onto a board.
. "$WK_ROOT/lib/target.sh"
# The result store, seeded payloads, the runner tree (lib/bench.sh).
. "$WK_ROOT/lib/bench.sh"
# A benchmark is legitimately silent for much longer than a build (cmd/bench
# sets the same two, for the same reason, before sourcing the watchdog).
WK_STALL_SECONDS="${WK_STALL_SECONDS:-900}"
WK_ABORT_SECONDS="${WK_ABORT_SECONDS:-5400}"
. "$WK_ROOT/lib/watchdog.sh"

# The tailscale release, from the one file that declares it -- the same one the
# Yocto layer's recipe requires (image/yocto/meta-wk-tailnet). Two copies of a
# version is a board running a different tailscale from the image beside it, and
# the drift would be invisible until something needed them to match.
TS_RELEASE="$WK_ROOT/image/yocto/meta-wk-tailnet/recipes-network/tailscale/tailscale-release.inc"
ts_release_field() { # <name> -- one `NAME = "value"` line out of the .inc
    sed -n "s/^$1 = \"\(.*\)\"\$/\1/p" "$TS_RELEASE" | head -1
}
TS_VERSION="${TS_VERSION:-$(ts_release_field TS_VERSION)}"
[ -n "$TS_VERSION" ] || die "no TS_VERSION in $TS_RELEASE"
TAG="${WK_PI_TAG:-tag:wk}"

# Bare `wk pi` and an unknown subcommand both need the sequence above; lifted
# out of this file's own header comment with the awk `wk pi -h` reads through
# the dispatcher's explain_cmd, rather than kept as a second copy the two
# could drift from.
pi_usage_page() {
    awk 'NR == 1 { next }
         /^# wk:/ { next }
         /^# wk [a-z]/ && !seen { next }
         /^#/  { sub(/^# ?/, ""); if ($0 == "" && !seen) next; seen = 1; print; next }
         { exit }' "$0"
}

ACTION="${1:-}"; HOST="${2:-}"
case "$ACTION" in
    "") pi_usage_page; exit 0 ;;
    setup|boot-order) [ -n "$HOST" ] || die "usage: wk pi $ACTION <machine|ssh-host>; see wk pi -h" ;;
    # deploy takes a *workspace* and a fleet machine, not an ssh host: it has
    # to reach into the build to make the archive and onto the board to unpack
    # it, and the board is named the way every other fleet verb names one.
    deploy|bench) : ;;
    # Kept only to say where it went; see below.
    flash) : ;;
    *) pi_usage_page >&2; exit 1 ;;
esac
shift 2 2>/dev/null || true

# setup takes only the ssh-host consumed above; deploy/bench/boot-order parse
# the rest of $@ themselves below.
if [ "$ACTION" = setup ] && [ $# -gt 0 ]; then
    case "$1" in
        -*) die "usage: wk pi setup <ssh-host>; unknown option: $1; see wk pi -h" ;;
        *)  die "usage: wk pi setup <ssh-host>; unexpected argument: $1; see wk pi -h" ;;
    esac
fi

# The board, over ssh. A fleet machine -- named as such, or by its rescue's
# ssh name -- is reached the way every fleet verb reaches it (m_ssh: root,
# the driving key, an unpinned host key); anything else is an ssh
# destination as given, which is how `wk pi setup` meets a board that is not
# in the fleet yet.
PI_FLEET=""
case "$ACTION" in
    setup|boot-order)
        if machine_by_ssh "$HOST" 2>/dev/null; then PI_FLEET=1; HOST="$MACH_SSH"; fi ;;
esac
rsh() {
    if [ -n "$PI_FLEET" ]; then m_ssh "$@"; else ssh -o BatchMode=yes "$HOST" "$@"; fi
}
# The scp destination for the same board (boot/rpi-eeprom.sh stages files).
rsh_dest() { printf '%s%s' "${PI_FLEET:+root@}" "$HOST"; }

if [ "$ACTION" = flash ]; then
    die "'wk pi flash' is gone -- it and 'wk image flash' were one operation.

    Writing a disk is an image operation, so it lives with wk sysimage, and
    the disk is named rather than the machine:

        wk sysimage disks $HOST                  what is attached over there
        wk sysimage write --from <path> --disk $HOST:<device>

    'wk pi' is for the things that are actually about the board: putting it on
    the tailnet, and its EEPROM boot order."
fi

# --- slots ---------------------------------------------------------------------
#
# A *slot* is one built WebKit on the board, beside the WebKit its image
# shipped with and beside any other slot: `/var/wk/slots/<name>/root/` is an
# install tree (usr/lib, usr/libexec, ...) and `slot.json` says what it is --
# the commit, the linker's per-slot build-id, a sha256 of every file
# (lib/wkslot.py). The image is the runtime; a slot is the thing measured.
# Two slots turn an A/B from a reflash-per-side affair on a board whose
# thermal state drifts over that timescale into an alternation with no
# reboot between the arms (cmd_bench's --ab).
#
# A slot is built by `wk sysimage webkit`, the way the image's builder builds
# WebKit; the transport and the proof here are the same for both builders.
PI_SLOTS=/var/wk/slots
pi_slot_dir() { printf '%s/%s' "$PI_SLOTS" "$1"; }

# Registered rather than trapped, for the reason lib/common.sh's wk_atexit
# exists: a `trap ... EXIT` here would replace whatever else is registered.
PI_TMP=""
_pi_tmp_cleanup() { [ -n "${PI_TMP:-}" ] && rm -rf "$PI_TMP"; PI_TMP=""; return 0; }
pi_tmp() { [ -n "$PI_TMP" ] || { PI_TMP=$(mktemp -d); wk_atexit _pi_tmp_cleanup; }; }

# --- wk pi deploy --------------------------------------------------------------
#
#   wk pi deploy <image-profile> <machine> --slot <name>
#
# Put a built WebKit on the board as a slot: the profile's slot `wk sysimage
# webkit` built (image_slot_dir, lib/image.sh -- buildroot or yocto alike).
# Streamed as a tarball over the same ssh channel everything else here uses,
# into `<slot>.part`, checked byte for byte against the manifest with the
# board's own sha256sum, and only then moved into place: a copy that stops
# halfway is never a slot.
cmd_deploy() {
    local profile="${1:-}" machine="${2:-}"; shift $(( $# < 2 ? $# : 2 ))
    local slot=a
    local usage="usage: wk pi deploy <image-profile> <machine> --slot <name>; see wk pi -h"
    while [ $# -gt 0 ]; do
        case "$1" in
            --slot) slot="${2:-}"; shift ;;
            --skeleton|--skeleton-only|--libs-only)
                die "'$1' is gone: nothing runs out of a checkout on the board any more.
    run-benchmark runs on this machine and drives the board's browser over ssh
    (wk pi bench), so a board needs a slot and nothing else:
        wk pi deploy <image-profile> $machine --slot <name>" ;;
            -*) die "$usage; unknown option: $1" ;;
            *)  die "$usage; unexpected argument: $1" ;;
        esac
        shift
    done
    [ -n "$profile" ] && [ -n "$machine" ] || die "$usage"
    image_check_slot_name "$slot"
    case "$profile" in
        yocto-*|buildroot-*) die "'$profile' is a workspace; a slot is named by its image profile:
        wk pi deploy ${profile#*-} $machine --slot $slot" ;;
    esac

    machine_load "$machine" || die "no such machine '$machine' (boot/machines.sh)"
    machine_armed_barrier "A deploy now lands in the system that is answering, and the
    machine is about to leave it -- the build would be on the disk nobody boots."

    ( image_profile_load "$profile" >/dev/null 2>&1 ) \
        || die "'$profile' is not an image profile ('wk sysimage build --list' has them all)."
    image_profile_load "$profile" >/dev/null 2>&1
    local slotdir
    slotdir=$(image_slot_dir "$profile" "$slot") \
        || die "$profile is built by ${IMG_BUILDER:-nothing}, which has no WebKit slots"
    [ -f "$slotdir/slot.json" ] || die "image $profile has no slot '$slot' built.
    Build one first:
        wk sysimage webkit $profile --commit <sha> --slot $slot"

    pi_deploy_slot "$slotdir" "$machine" "$slot"
}

pi_deploy_slot() { # <slot dir> <machine> <slot>
    local slotdir="$1" machine="$2" slot="$3"
    local dest part commit build_id browser size
    dest=$(pi_slot_dir "$slot"); part="$dest.part"
    commit=$(wkslot get "$slotdir/slot.json" commit)
    build_id=$(wkslot get "$slotdir/slot.json" build_id)
    browser=$(wkslot get "$slotdir/slot.json" browser)
    size=$(du -sh "$slotdir/root" | cut -f1)

    info "deploying slot '$slot' to $machine ($browser, WebKit ${commit:0:12}, $size)"
    i_ssh "rm -rf $(sh_quote "$part") && mkdir -p $(sh_quote "$part")" >/dev/null 2>&1 \
        || die "cannot create $part on $machine. Is its root filesystem writable?"
    # `tar | ssh tar` rather than scp: the same channel the rest of this repo
    # uses to move bytes onto a board (boot/disk.sh), needing nothing but tar
    # and gzip on the far side -- as two commands, since a BusyBox tar has
    # no -z.
    tar -C "$slotdir" -cf - root slot.json | gzip -1 \
        | i_ssh "gzip -dc | tar -C $(sh_quote "$part") -xf -" \
        || die "could not copy the slot to $machine ($part is left there)"

    # Proof, not a claim: every file, against the manifest, with the board's
    # own sha256sum. A copy that does not match replaces nothing.
    # The far side is a busybox sh: the status is carried by hand, and only
    # the lines that are not "OK" come back.
    local bad
    if ! bad=$(wkslot sums "$slotdir/slot.json" --prefix "$part/root" \
                 | i_ssh 'out=$(sha256sum -c - 2>&1); rc=$?; printf "%s\n" "$out" | grep -v ": OK$"; exit $rc'); then
        die "the copy on $machine does not match the slot's manifest:
$(printf '%s\n' "$bad" | head -5 | sed 's/^/    /')
    Nothing was replaced; $part is left for inspection."
    fi
    i_ssh "rm -rf $(sh_quote "$dest") && mv $(sh_quote "$part") $(sh_quote "$dest")" \
        || die "could not move $part into place on $machine"

    log "deployed to $machine"
    log "  slot      $slot ($dest)"
    log "  webkit    $commit"
    log "  build-id  $build_id  (what wk pi bench reads back out of the running process)"
    log "  next:     wk pi bench $machine <plan> --slot $slot"
}

# --- wk pi bench ---------------------------------------------------------------
#
#   wk pi bench <machine> <plan> [--slot NAME | --ab A,B [--rounds N]]
#                                 [--count N] [--timeout S] [--cores <set>]
#
# Run a browser benchmark against a booted bench system and bring the
# number back, with the refusals and provenance that make it defensible.
#
# **The harness is WebKit's own `run-benchmark`, run here, driving the
# board's browser over ssh.** Benchmarks keep their score in the DOM, so a
# URL in a browser says only that a run finished; run-benchmark serves the
# benchmark and receives the score. It runs on this machine because a bench
# image is a browser and nothing else -- no python, no checkout -- out of a
# Tools/Scripts tree exported from the mirror (bench_runner_tree, lib/bench.sh)
# with this repo's `wk-board` browser driver beside WebKit's own
# (bench/wk_board_driver.py). The board reaches the server through a
# reverse ssh tunnel, since the tailnet lets a board reach nothing but
# boards; the benchmark's origin is loopback on the board, as it would be
# with a local server.
#
# Every result is checked against the slot it claims: while the web process
# that computed a number is still alive, the driver reads its executable,
# the WebKit library it mapped and that library's build-id off /proc, and
# a mismatch fails the run rather than recording it.

PI_TUNNEL_PID=""
_pi_tunnel_cleanup() { [ -n "$PI_TUNNEL_PID" ] && kill "$PI_TUNNEL_PID" 2>/dev/null; PI_TUNNEL_PID=""; return 0; }

# The ssh command line the driver and the tunnel use, as one string: the
# same options i_ssh applies, spelled out because the driver is python.
pi_ssh_cmd() {
    # shellcheck disable=SC2046
    printf 'ssh -o BatchMode=yes -o ConnectTimeout=%s %s %s' "$(wk_ssh_timeout)" "$(m_ssh_opts)" "$(image_addr)"
}

# A free TCP port here, which is also the port the tunnel listens on there:
# one number on both ends keeps the URL rewrite to a host swap.
pi_free_port() {
    python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])'
}

# The plan is read out of the runner tree (lib/bench.sh asks this).
bench_plan_read() { cat "$BENCH_RUNNER/Tools/Scripts/$1"; }

# Evidence of a display, or nothing. Two kinds of board: one with a DRM
# connector (yocto, vc4) and one that renders through the firmware's
# dispmanx (buildroot, the RPi backend), where tvservice is the only thing
# that knows whether a panel is attached.
pi_display() {
    local drm tv
    drm=$(i_ssh 'grep -l "^connected$" /sys/class/drm/card*-HDMI-*/status 2>/dev/null | head -1' 2>/dev/null | tr -d '\r')
    [ -z "$drm" ] || { printf 'drm:%s' "$(basename "$(dirname "$drm")")"; return 0; }
    tv=$(i_ssh 'tvservice -s 2>/dev/null' 2>/dev/null | tr -d '\r')
    case "$tv" in
        *HDMI*|*DVI*) printf 'tvservice:%s' "$(printf '%s' "$tv" | sed 's/^state [^ ]* //')"; return 0 ;;
    esac
    return 1
}

# Pin the CPU frequency for the run and say what it is: every perf run pins
# unless told otherwise, and a board that throttles readily makes an unpinned
# score a temperature reading. Prints the governor in force afterwards.
pi_pin_governor() {
    i_ssh 'for p in /sys/devices/system/cpu/cpufreq/policy*; do
               [ -w "$p/scaling_governor" ] && echo performance > "$p/scaling_governor"
           done 2>/dev/null; cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null' \
        2>/dev/null | tr -d '\r' | tail -1
}

# The session a browser needs, by the builder of the running image (the
# marker's own word for it). Sets PI_RENDERER and PI_SESSION.
PI_RENDERER=""; PI_SESSION=""
pi_session_up() { # <builder> <display evidence, or empty>
    case "$1" in
        buildroot) pi_session_buildroot "$2" ;;
        yocto)     pi_session_yocto "$2" ;;
        *) die "the image on $machine says builder='$1', and this command knows how to
    bring up a session on a yocto or a buildroot image only." ;;
    esac
}

# The RPi backend: the browser draws through dispmanx, with no compositor to
# start. The image autostarts a cog of its own showing the board's address;
# that one is stopped, since two browsers on one GPU is not a measurement.
# A buildroot image: the RPi backend -- the browser draws through dispmanx
# (wpebackend-rdk), with no compositor to start. The image autostarts a cog of
# its own showing the board's address; that one is stopped, since two browsers
# on one GPU is not a measurement.
pi_session_buildroot() {
    i_ssh '[ -x /etc/init.d/S90cog ] && /etc/init.d/S90cog stop >/dev/null 2>&1
           killall cog WPEWebProcess WPENetworkProcess 2>/dev/null; true' >/dev/null 2>&1 || true
    PI_RENDERER=dispmanx; PI_SESSION=rdk
    log "  session     rdk backend, dispmanx ($([ -n "$1" ] && echo "$1" || echo 'no display evidence'))"
}

# The compositor is up when it reports an output and its shell is running;
# both images' sessions end here.
pi_session_wait_compositor() {
    local i=0 out=""
    while [ "$i" -lt 20 ]; do
        # `|| true`: the remote ends on pidof, which exits 1 while the shell is
        # still coming up -- under pipefail that would end this command.
        out=$(i_ssh 'grep -oiE "Output .[a-z0-9-]+. enabled" /tmp/wk-weston.log 2>/dev/null | tail -1;
                     pidof weston-desktop-shell 2>/dev/null' 2>/dev/null | tr -d '\r' | head -1 || true)
        [ -n "$out" ] && break
        i=$((i + 1)); sleep 2
    done
    [ -n "$out" ] || die "no compositor output on $machine.
    Check:  ssh $(image_addr) 'tail -30 /tmp/wk-weston.log'"
    log "  session     $PI_SESSION, $PI_RENDERER renderer ($out)"
    [ "$PI_RENDERER" = pixman ] && warn "compositing is on the CPU, so this number is not comparable with a
  run on real display hardware. It proves the path, which is what it is for."
    return 0
}

# A yocto image: weston on the panel when there is one, weston's RDP virtual
# head with pixman when there is not (what --force allows), and the fake
# input seat cog asserts without.
PI_SEAT_PY='import fcntl,os,struct,signal
IOC=lambda d,t,nr,size:(d<<30)|(size<<16)|(t<<8)|nr
U=ord("U")
fd=os.open("/dev/uinput",os.O_WRONLY|os.O_NONBLOCK)
fcntl.ioctl(fd,IOC(1,U,100,4),1)
fcntl.ioctl(fd,IOC(1,U,101,4),1)
os.write(fd,struct.pack("=80s4HI256i",b"wk-bench-seat",3,1,1,1,0,*([0]*256)))
fcntl.ioctl(fd,IOC(0,U,1,0),0)
signal.pause()'

pi_session_yocto() {
    # netdata competes for the CPU being measured.
    i_ssh 'systemctl stop netdata 2>/dev/null' >/dev/null 2>&1 || true
    if [ -n "$1" ]; then
        # A real panel: weston's own service, DRM backend, GL renderer. The
        # only configuration whose number is comparable with other hardware.
        PI_RENDERER=gl; PI_SESSION=drm
        i_ssh 'systemctl start --no-block weston' >/dev/null 2>&1 || true
    else
        # "No display" is not "no compositor": weston's RDP backend synthesises
        # a head with no display hardware and no client on the port, so pixman
        # composites it on the CPU with no network in the run. Not the same as
        # forcing a mode with `video=`, which hangs vc4 in probe.
        PI_RENDERER=pixman; PI_SESSION=headless-rdp
        info "  no display attached: RDP virtual head + pixman (software) compositing"
        i_ssh 'mkdir -p /etc/wk-bench && [ -f /etc/wk-bench/rdp.key ] || {
                 openssl req -x509 -newkey rsa:2048 -nodes \
                   -keyout /etc/wk-bench/rdp.key -out /etc/wk-bench/rdp.crt \
                   -days 3650 -subj /CN=wk-bench >/dev/null 2>&1
                 chmod 600 /etc/wk-bench/rdp.key; }' >/dev/null 2>&1 \
            || die "could not create the RDP backend's keys on $machine (needs openssl)"
        # desktop-shell, not fullscreen-shell: the latter serves no xdg-shell,
        # and a browser asking for one gets "invalid object" and exits.
        i_ssh 'pkill -x weston 2>/dev/null; sleep 1
               mkdir -p /run/user/0 && chmod 700 /run/user/0
               XDG_RUNTIME_DIR=/run/user/0 setsid weston \
                 --backend=rdp-backend.so --renderer=pixman \
                 --width=1280 --height=1024 --socket=wk-bench \
                 --rdp-tls-cert=/etc/wk-bench/rdp.crt \
                 --rdp-tls-key=/etc/wk-bench/rdp.key \
                 </dev/null >/tmp/wk-weston.log 2>&1 & sleep 6' >/dev/null 2>&1 || true
    fi

    pi_session_wait_compositor

    # The seat, once, and left running for the whole session: cog aborts at
    # startup with no input seat (assertion: display->seat_default).
    if ! i_ssh 'pgrep -f wk-bench-seat >/dev/null' 2>/dev/null; then
        i_ssh "setsid python3 -c $(sh_quote "$PI_SEAT_PY") </dev/null >/tmp/wk-seat.log 2>&1 & sleep 2" >/dev/null 2>&1 || true
    fi
    i_ssh 'pgrep -f "signal.pause|wk-bench-seat" >/dev/null' 2>/dev/null \
        && log "  input seat  up" \
        || warn "no fake input seat -- cog asserts at startup without one; the run may abort"
}

# The remote shell text that starts a slot's browser at a URL (the driver
# appends the URL), from the slot's own manifest: which browser, and the
# environment that makes it run the slot's WebKit rather than the image's.
pi_launch_cmd() { # <slot> <slot.json> <cores wrap>
    local slot="$1" json="$2" cores="$3" root env browser
    root="$(pi_slot_dir "$slot")/root"
    env=$(wkslot env "$json" "$root" | tr '\n' ' ')
    browser=$(wkslot get "$json" browser)
    case "$browser" in
        cog)
            printf 'cd /tmp && exec %senv %s /usr/bin/cog' "$cores" "$env" ;;
        minibrowser)
            # weston's own environment, read out of the running compositor
            # rather than assumed.
            # POSIX sh, not bash: the driver runs this through the board's
            # /bin/sh, which is busybox ash on every image here.
            printf 'cd /tmp && eval "$(strings /proc/$(pidof weston-desktop-shell)/environ | grep -E "^(XDG_RUNTIME_DIR|WAYLAND_DISPLAY)=")" && export XDG_RUNTIME_DIR WAYLAND_DISPLAY && exec %senv %s %s/bin/MiniBrowser' \
                "$cores" "$env" "$root" ;;
        *) die "slot '$slot' names browser '$browser', which this command cannot launch" ;;
    esac
}

pi_kill_cmd() { # <slot.json>
    case "$(wkslot get "$1" browser)" in
        cog)         printf 'killall cog WPEWebProcess WPENetworkProcess 2>/dev/null; true' ;;
        minibrowser) printf 'killall MiniBrowser WPEWebProcess WPENetworkProcess 2>/dev/null; true' ;;
    esac
}

# Save the run where `wk bench compare` will find it: same directory shape
# and same three axes as every other run (BENCH_DIR, lib/bench.sh), so the
# records are interchangeable: env.json, result.json, run.log.
pi_bench_record() { # <out dir> <slot> <slot.json>
    local dir="$1" slot="$2" json="$3"
    local karch class software="" software_reason=""
    # Which task this run belongs to and, in an A/B, which round and arm:
    # what `wk bench report <task>` pairs the runs by.
    local -a task_args=("task=$PI_TASK")
    [ -z "$PI_AB_ROUND" ] || task_args+=("ab.round=$PI_AB_ROUND" "ab.arm=$PI_AB_ARM" "ab.slot_a=$PI_AB_A" "ab.slot_b=$PI_AB_B")
    karch=$(i_ssh 'uname -m' 2>/dev/null | tr -d '\r')
    class=$(wkdata bench-class "$plan")
    if [ "$PI_RENDERER" = pixman ]; then
        software=1; software_reason="no display attached; weston rdp + pixman"
    fi
    bench_configuration_args
    wkdata env-record "$dir/env.json" \
        plan="$plan" workspace="$(wkslot get "$json" workspace)" config="$(wkslot get "$json" profile)" \
        browser="$(wkslot get "$json" browser)" \
        count="${count:-}" class="$class" runner=browser \
        arch="${karch:-native}" bench_host=image \
        software_reason="$software_reason" \
        session_mode="$PI_SESSION" gpu_renderer="$PI_RENDERER" display="$PI_DISPLAY" \
        machine="$machine" system="$sysid" build_slot="$slot" \
        webkit_sha="$(wkslot get "$json" commit)" build_id="$(wkslot get "$json" build_id)" \
        runner_sha="$BENCH_RUNNER_SHA" local_copy="$PI_SEEDED" \
        host.kernel="$kernel" host.kernel_arch="$karch" host.governor="$gov" \
        host.throttled="$throttled" host.root_device="$root_dev" \
        cores.set="$cores" \
        "${task_args[@]}" \
        ${BENCH_CFG_ARGS[@]+"${BENCH_CFG_ARGS[@]}"} \
        --bool forced="${WK_FORCE:-}" --bool software="$software" --bool cores.pinned="$cores"
}

PI_TASK=""; PI_TASK_OWNED=""
PI_AB_ROUND=""; PI_AB_ARM=""; PI_AB_A=""; PI_AB_B=""
cmd_bench() {
    local machine="${1:-}" plan="${2:-}"; shift $(( $# < 2 ? $# : 2 ))
    local count="" timeout_s="" slot=a ab="" rounds=3 cores="" task=""
    # The request's moment names the task this command becomes, when it is
    # its own: taken now, before any board is probed.
    local stamp; stamp=$(bench_task_stamp)
    local usage="usage: wk pi bench <machine> <plan> [--slot NAME | --ab A,B [--rounds N]] [--count N] [--timeout S] [--cores <set>] [--task NAME]; see wk pi -h"
    while [ $# -gt 0 ]; do
        case "$1" in
            --count)   count="${2:-}"; shift ;;
            --timeout) timeout_s="${2:-}"; shift ;;
            --task)    task="${2:-}"; shift ;;
            --slot)    slot="${2:-}"; image_check_slot_name "$slot"; shift ;;
            # Same cpu-list syntax as `wk bench --cores`, through the same
            # parser (lib/wkdata.py); applied to the board's browser.
            --cores)   cores="${2:-}"; shift ;;
            # Two slots, alternated. See pi_bench_ab. Validated here so a
            # malformed pair is refused as one, not as a missing slot.
            --ab)      ab="${2:-}"
                       case "$ab" in
                           *,*) ;;
                           *) die "$usage; --ab takes two slot names separated by a comma, e.g. --ab base,pr" ;;
                       esac
                       image_check_slot_name "${ab%%,*}"; image_check_slot_name "${ab##*,}"
                       [ "${ab%%,*}" != "${ab##*,}" ] \
                           || die "$usage; --ab needs two different slots (got '${ab%%,*}' twice).
    Two runs from one slot measure the same binary twice, which is a
    repeatability check rather than an A/B -- '--count N' is the way to ask for
    that."
                       shift ;;
            --rounds)  rounds="${2:-}"; shift ;;
            --keep-session) die "'--keep-session' is gone: nothing is torn down between runs any more" ;;
            -*) die "$usage; unknown option: $1" ;;
            *)  die "$usage; unexpected argument: $1" ;;
        esac
        shift
    done
    [ -n "$machine" ] && [ -n "$plan" ] || die "$usage"
    # A plan name is a file name in the runner tree, and lands on command
    # lines this command builds; refused before either.
    valid_name "$plan" || die "'$plan' is not a plan name (letters, digits, '.', '_' and '-')"
    [ -z "$cores" ] || wkdata cores-valid "$cores" \
        || die "--cores '$cores' is not a valid Linux cpu list (e.g. 0-3, 2,3, 0-1,4, 7)"
    case "$rounds" in ''|*[!0-9]*) die "--rounds takes a number (got '$rounds')" ;; esac
    [ -z "$timeout_s" ] || case "$timeout_s" in *[!0-9]*) die "--timeout takes seconds (got '$timeout_s')" ;; esac
    # An existing task is checked before any board is touched: a typo here
    # must not file an hour of runs somewhere nothing describes.
    if [ -n "$task" ]; then
        bench_task_attach "$task"
        PI_TASK="$task"
    fi

    machine_load "$machine" || die "no such machine '$machine' (boot/machines.sh)"
    # One run at a time per board: two would share the browser, the GPU and
    # the tunnel port, reading like a stuck benchmark rather than two of them.
    hold_lock "pi-bench-$machine" -w 5 \
        || die "a benchmark is already running against $machine from this machine."

    # 1. Bench mode or nothing: a run on a machine that never left host mode
    # measures a desktop with a browser on it, a different thing wearing the
    # same number. The evidence is the image's own marker.
    local sysid probe rootdev kind builder
    probe=$(i_ssh "$_b_probe_sh" 2>/dev/null | tr -d '\r') \
        || die "cannot reach $machine's bench system ($(image_addr)) over ssh."
    sysid=$(kv_get id <<<"$probe")
    rootdev=$(kv_get rootdev <<<"$probe")
    builder=$(kv_get builder <<<"$probe")
    [ -n "$sysid" ] || die "$machine is not running a wk bench system (no /etc/wk-image).
    A benchmark runs in bench mode or it does not run:
        wk boot $machine --system <id>   then   wk boot $machine --keep"

    # A marker alone is not enough: every image wk writes carries /etc/wk-image,
    # the rescue included, so a board that fell back to it would still pass
    # the check above. Evidence, not the record: which device the running
    # root is on, and what the marker says its role is.
    kind=$(b_system_kind "$rootdev")
    if [ "$kind" = base ] || [ "$(kv_get role <<<"$probe")" = rescue ]; then
        barrier "$machine is running its rescue system ($sysid, root on $rootdev), not a
    bench system. The rescue exists to keep the board reachable and to let
    another system be written; it is never the thing to measure.
    Arm a bench system and boot it:  wk boot $machine --system <id>"
    fi
    [ "$kind" != unknown ] || warn "cannot tell which medium $machine booted from (root: ${rootdev:-unknown}); check 'wk boot $machine --status'"

    # 1b. A display, before anything is changed on the board: no display is a
    # refusal, not a fallback -- compositing on the CPU puts the CPU under test
    # to work drawing frames, and the score measures the renderer as much as
    # the engine. --force is the one way through, and it is recorded.
    PI_DISPLAY=$(pi_display) || PI_DISPLAY=""
    if [ -z "$PI_DISPLAY" ]; then
        barrier "$machine reports no attached display (no connected DRM connector, and
    tvservice sees no HDMI). $plan would be measuring a software path, and the
    result would be indistinguishable from a real one afterwards.
    Attach a display, or say so on purpose with --force; the run is recorded
    as software-composited either way."
    fi

    # 2. The slot(s) the whole thing measures, all checked before the session
    # is touched: an --ab that discovers its second slot missing after the
    # first half has run has wasted the first half.
    pi_tmp
    local _s _need="$slot"
    [ -z "$ab" ] || _need="${ab%%,*} ${ab##*,}"
    for _s in $_need; do
        i_ssh "cat $(sh_quote "$(pi_slot_dir "$_s")/slot.json")" > "$PI_TMP/slot-$_s.json" 2>/dev/null \
            && [ -s "$PI_TMP/slot-$_s.json" ] \
            || die "$machine has no slot '$_s' ($(pi_slot_dir "$_s")).
    The image is the runtime and a slot is what is measured; deploy one:
        wk pi deploy <image-profile|yocto-workspace> $machine --slot $_s"
    done
    if [ -n "$cores" ]; then
        i_ssh 'command -v taskset >/dev/null' 2>/dev/null \
            || die "--cores: the image on $machine has no taskset, so the browser cannot be
    pinned there. That is the image's business (util-linux's schedutils in the
    defconfig), not something to approximate here."
    fi

    # 3. Provenance, gathered before the run rather than reconstructed after.
    # The governor is pinned first: an unpinned score is a temperature reading.
    local kernel gov throttled root_dev
    kernel=$(i_ssh 'uname -r' 2>/dev/null | tr -d '\r')
    gov=$(pi_pin_governor)
    # The firmware's throttle flags, from the kernel's sysfs rather than
    # vcgencmd: the same bits, and no rpi-userland on the board needed.
    throttled=$(i_ssh 'cat /sys/devices/platform/soc/soc:firmware/get_throttled 2>/dev/null || true' 2>/dev/null | tr -d '\r ')
    [ -z "$throttled" ] || throttled="throttled=0x$throttled"
    root_dev="$rootdev"
    log "$machine: $sysid (builder $builder)"
    log "  kernel      $kernel"
    log "  root        $root_dev"
    log "  display     ${PI_DISPLAY:-none}"
    log "  governor    ${gov:-unknown}$([ "$gov" = performance ] || echo '   <-- not pinned; the score is not a perf result')"
    log "  throttled   ${throttled:-unknown}$(case "$throttled" in ''|throttled=0x0) ;; *) echo '   <-- non-zero: thermally or voltage limited' ;; esac)"

    # 4. Claim the board: a run here can run well past IMG_WATCHDOG seconds
    # (cmd/sysimage), and the image's self-return watchdog reboots the board
    # out from under anything not holding this marker (the same one `wk boot
    # --keep` writes, cmd/boot) -- so this run claims it too, or it is a
    # benchmark the board can rip apart mid-run.
    i_ssh 'mkdir -p /run && touch /run/wk-keep-running' \
        || die "could not claim $machine's bench system (mkdir/touch /run/wk-keep-running failed).
    Without the claim, the image's self-return watchdog reboots the board
    mid-run; a run that long is wasted rather than measured."

    # 5. The runner here, the payload pinned, the tunnel up.
    bench_runner_tree
    log "  runner      run-benchmark @ ${BENCH_RUNNER_SHA:0:12} ($BENCH_RUNNER)"
    PI_SEEDED=$(seed_payload "$plan")
    local port; port=$(pi_free_port)
    # shellcheck disable=SC2046
    $(pi_ssh_cmd) -o ExitOnForwardFailure=yes -N \
        -R "127.0.0.1:$port:127.0.0.1:$port" </dev/null >"$PI_TMP/tunnel.log" 2>&1 &
    PI_TUNNEL_PID=$!
    wk_atexit _pi_tunnel_cleanup
    sleep 2
    kill -0 "$PI_TUNNEL_PID" 2>/dev/null \
        || die "could not open the reverse tunnel to $machine (port $port):
$(sed 's/^/    /' "$PI_TMP/tunnel.log")"
    log "  tunnel      127.0.0.1:$port on $machine -> run-benchmark here"

    # 6. The session, once for every run: bringing it down and up between the
    # halves of an A/B would put a fresh compositor and page cache on one
    # side only.
    info "bringing up the session on $machine"
    pi_session_up "$builder" "$PI_DISPLAY"

    # 7. The task the runs are filed into: wk ab's when given, else this
    # command's own, named for the request and what it measures. Created
    # here, once the slots are known to exist, so a refusal above leaves no
    # empty task behind.
    if [ -z "$PI_TASK" ]; then
        local profile; profile=$(wkslot get "$PI_TMP/slot-${_need%% *}.json" profile)
        if [ -n "$ab" ]; then
            PI_TASK="$stamp-$machine-${ab%%,*}-vs-${ab##*,}"
            bench_task_new "$PI_TASK" subject.kind=slots subject.spec="$ab" \
                devices="$machine=$profile" plans="$plan" rounds="$rounds" slots="${ab%%,*},${ab##*,}" \
                count="$count" timeout="$timeout_s" \
                --command "wk pi bench $machine $plan --ab $ab --rounds $rounds${count:+ --count $count}${timeout_s:+ --timeout $timeout_s}"
        else
            PI_TASK="$stamp-$machine-$slot"
            bench_task_new "$PI_TASK" subject.kind=slots subject.spec="$slot" \
                devices="$machine=$profile" plans="$plan" rounds=1 slots="$slot" \
                count="$count" timeout="$timeout_s" \
                --command "wk pi bench $machine $plan --slot $slot${count:+ --count $count}${timeout_s:+ --timeout $timeout_s}"
        fi
        PI_TASK_OWNED=1
    fi
    log "  task        $PI_TASK ($(bench_task_dir "$PI_TASK"))"

    # 8. The run(s). One slot, or two alternated.
    if [ -n "$ab" ]; then
        pi_bench_ab "$ab" "$rounds"
        return $?
    fi
    pi_bench_once "$slot" || die "benchmark failed on $machine"
    cat "$PI_LAST_RUN/result.json"
}

# One run, from a named slot, recorded. run-benchmark does the run; the
# wk-board driver launches and ends the browser and checks the process that
# reported. Wall-clock silence is watched like a workspace run's
# (run_watched, lib/watchdog.sh).
pi_bench_once() {
    # Two statements: in one `local a=.. b=$a`, $a expands before the first
    # assignment lands, to the caller's slot rather than this run's.
    local slot="$1"
    local json="$PI_TMP/slot-$slot.json"
    local id="$(date -u +%Y%m%dT%H%M%SZ)-$plan-$machine-$slot"
    local out="$(bench_task_dir "$PI_TASK")/runs/$id"
    ensure_dir "$out/diagnose"
    local cores_wrap=""
    [ -z "$cores" ] || cores_wrap=$(wkdata cores-wrap "$cores")

    # Written before the run so it exists even if the run dies.
    pi_bench_record "$out" "$slot" "$json"

    local args="--plan $(sh_quote "$plan") --browser wk-board --platform linux --driver webserver"
    args="$args --http-server-type builtin --http-server-port $port"
    args="$args --output-file $(sh_quote "$out/result.json") --no-adjust-unit --show-iteration-values"
    args="$args --diagnose-directory $(sh_quote "$out/diagnose")"
    [ -z "$count" ]     || args="$args --count $(sh_quote "$count")"
    [ -z "$timeout_s" ] || args="$args --timeout $(sh_quote "$timeout_s")"
    [ -z "$PI_SEEDED" ] || args="$args --local-copy $(sh_quote "$PI_SEEDED")"

    info "running $plan on $machine from slot '$slot' (WebKit $(wkslot get "$json" commit | cut -c1-12))"
    log  "  results: $out"
    local wall_start; wall_start=$(date +%s)
    set +e
    run_watched "$out/run.log" -- \
        env WK_BOARD_SSH="$(pi_ssh_cmd)" \
            WK_BOARD_LAUNCH="$(pi_launch_cmd "$slot" "$json" "$cores_wrap")" \
            WK_BOARD_KILL="$(pi_kill_cmd "$json")" \
            WK_BOARD_URL="127.0.0.1:$port" \
            WK_BOARD_EXPECT="$(wkslot expect "$json" "$(pi_slot_dir "$slot")/root")" \
            WK_BOARD_EVIDENCE="$out/verify.jsonl" \
        bash -c "cd $(sh_quote "$BENCH_RUNNER") && exec python3 Tools/Scripts/run-benchmark $args"
    local rc=$?
    set -e
    # Whatever run-benchmark left behind on the board ends here, not at the
    # next run's prepare_env: a browser that outlives a timed-out run is a
    # second browser on the GPU and in the 623 MB. Then the board's side of
    # the evidence comes over: the browser's own output (moved -- the board
    # keeps nothing of a run) and the tail of its system log (the OOM killer
    # reports there), both beside result.json.
    i_ssh "$(pi_kill_cmd "$json")" >/dev/null 2>&1 || true
    i_ssh 'cat /tmp/wk-browser.log 2>/dev/null; rm -f /tmp/wk-browser.log' > "$out/browser.log" 2>/dev/null || true
    i_ssh 'tail -n 300 /tmp/messages 2>/dev/null' > "$out/board.log" 2>/dev/null || true
    wkdata env-record "$out/env.json" --update wall_time_s="$(( $(date +%s) - wall_start ))"

    # The check the driver made of the process that reported: recorded either
    # way, and a run whose process was not the slot has already failed above.
    local verified
    verified=$(wkslot verified "$out/verify.jsonl" 2>/dev/null) || verified=""
    wkdata env-record "$out/env.json" --update --bool verified="$verified"

    if [ "$rc" -ne 0 ] || [ ! -s "$out/result.json" ]; then
        warn "run-benchmark exited $rc from slot '$slot'$([ -s "$out/result.json" ] || printf ' with no result')"
        first_error "$out/run.log" | sed 's/^/  /' >&2 || true
        log "  full log: $out/run.log"
        PI_LAST_RUN="$out"
        return 1
    fi
    PI_LAST_RUN="$out"
    log "  verified    the reporting WPEWebProcess ran slot '$slot' ($verified check(s), build-id $(wkslot get "$json" build_id | cut -c1-12))"
    tr '\r' '\n' < "$out/run.log" | grep -iE '^(Score|Total|.*Score:)' | tail -3 | sed 's/^/  /' >&2 || true
    log "  recorded    $out"
    return 0
}

# Interleaved A/B: A B A B ..., not AAA then BBB. These boards drift
# monotonically over the tens of minutes an A/B takes (warm-up, SoC
# throttling, SD card cache state); running all of A then all of B would put
# the drift entirely on B, indistinguishable from an effect of the change.
#
# Each half is recorded as its own run, tagged with its round and arm, and
# the comparison is `wk bench report <task>`'s job: it pairs the rounds, keeps
# only those where both arms produced a result -- a round where one arm
# crashed and the other did not is not half a data point, since a crash
# correlates with the heavier binary under a memory ceiling -- and does the
# statistics once, for a finished task and a half-done one alike.
pi_bench_ab() {
    local spec="$1" n="$2" a b i
    a="${spec%%,*}"; b="${spec##*,}"
    [ "$n" -ge 1 ] || die "--rounds needs to be at least 1"

    log "interleaving $n round(s) of $a vs $b -- $((n * 2)) runs"
    log "  alternated rather than blocked, so thermal drift lands on both arms"

    PI_AB_A="$a"; PI_AB_B="$b"
    local ra rb kept=0 lost=0
    i=1
    while [ "$i" -le "$n" ]; do
        log ""
        log "round $i/$n -- slot $a"
        ra=""; rb=""
        PI_AB_ROUND="$i"; PI_AB_ARM=a
        if pi_bench_once "$a"; then ra=1; fi
        log "round $i/$n -- slot $b"
        PI_AB_ARM=b
        if pi_bench_once "$b"; then rb=1; fi

        if [ -n "$ra" ] && [ -n "$rb" ]; then
            kept=$((kept + 1))
        else
            lost=$((lost + 1))
            warn "round $i produced ${ra:+$a }${rb:+$b }only -- the report drops it"
            # A transient OOM is real and recoverable, so carrying on is still
            # right; stopping after three losses keeps a quietly-failing board
            # from burning every remaining round unseen.
            [ "$lost" -lt 3 ] || { warn "three rounds lost; stopping early"; break; }
        fi
        i=$((i + 1))
    done
    PI_AB_ROUND=""; PI_AB_ARM=""

    log ""
    log "$kept round(s) usable, $lost dropped; the runs are in $(bench_task_dir "$PI_TASK")/runs"
    # The task's creator reports it: this command when the task is its own,
    # `wk ab` (which may have other boards still running) when it is not.
    if [ -n "$PI_TASK_OWNED" ]; then
        "$WK_ROOT/wk" bench report "$PI_TASK" --html --text \
            || warn "the report did not complete; the runs are recorded:  wk bench report $PI_TASK"
    else
        log "  report:  wk bench report $PI_TASK"
    fi
    [ "$kept" -ge 1 ] || die "no round produced both halves on $machine; nothing to compare."
}

# --- wk pi boot-order ----------------------------------------------------------
#
# The EEPROM's only writer, and the reason that matters: `BOOT_ORDER` is
# firmware state *shared by both of a machine's modes*, so a wrong value costs
# a trip to the device. There are two orders, the local-boot lane's and its
# undo, because those are the only two boots this fleet asks a board to make.
#
# BOOT_ORDER reads lowest-nibble-first, so the string is written in reverse
# priority: 0xf41 is SD(1), then USB(4), then restart(f). The network nibble
# (2) is stripped by every order here, and so are the TFTP_IP/CLIENT_IP keys
# that go with it: no lane here boots over the network, and a board carrying
# either one would spend every boot on a source nothing answers -- benign, but
# a stale fact that reads as a live one.
#
# The rule: whichever medium the board's bench system boots from tries
# first, and the other medium -- the rescue role -- stays behind it. A medium
# with no bootable filesystem is skipped and the board lands on its rescue
# image, reachable, with no one in the room; firmware that gets as far as
# start4.elf and no further **halts** instead, and a halted board needs a
# person. `usb-first`/`sd-first` name which medium leads; `local` is the
# revert, network removed and nothing else moved.
boot_order_without_net() {
    local order="${1#0x}"
    printf '0x%s' "$(printf '%s' "$order" | sed 's/2//g')"
}

# <order> <nibble>: that nibble moved to the front, network stripped, every
# other nibble left in place -- `usb-first` is `boot_order_first "$order" 4`,
# `sd-first` is `boot_order_first "$order" 1`. `0xf412 4 -> 0xf14`. Derived
# from the current order rather than a constant, so an entry this does not
# know about (6 is NVMe on a Pi 5) keeps it.
boot_order_first() {
    local order="${1#0x}" nibble="$2"
    order=$(printf '%s' "$order" | sed "s/2//g; s/$nibble//g")
    printf '0x%s%s' "$order" "$nibble"
}

# One writer. BOOT_ORDER is firmware state shared by every mode a machine
# has, and two commands that could both write it is two places for a wrong
# value to come from.
cmd_boot_order() {
    local dry="" revert=""
    local order_name="${ORDER_NAME:-}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run)   dry=1 ;;
            --revert)    revert=1 ;;
            -*) die "usage: wk pi boot-order <machine> <usb-first|sd-first|local> [--revert] [--dry-run]; unknown option: $1; see wk pi -h" ;;
            *)  die "usage: wk pi boot-order <machine> <usb-first|sd-first|local> [--revert] [--dry-run]; unexpected argument: $1; see wk pi -h" ;;
        esac
        shift
    done

    if [ -z "$order_name" ]; then
        if [ -n "$revert" ]; then
            order_name=local
        else
            # The order defaults from what the fleet says this machine is,
            # not from a flag the caller has to remember: getting it wrong on
            # a workstation costs a trip to the device. A bench-device's
            # default follows its bench medium's own transport (MACH_DEVICE,
            # disk_tran_of_name -- boot/disk.sh): whichever medium the bench
            # system boots from is the one the firmware should try first.
            if machine_by_ssh "$HOST" && [ "${MACH_ROLE:-workstation}" = bench-device ]; then
                case "$(disk_tran_of_name "${MACH_DEVICE:-}")" in
                    mmc) order_name=sd-first ;;
                    *)   order_name=usb-first ;;
                esac
            else
                order_name=local
            fi
        fi
    fi

    case "$order_name" in
        usb-first|sd-first|local) ;;
        *) die "no such boot order '$order_name'.
    orders:
      usb-first      the USB stick first, then the SD card -- for a bench
                     system on the stick, with the card as the rescue role
      sd-first       the SD card first, then the USB stick -- for a bench
                     system on the card, with the stick as the rescue role
      local          the local disks only, network removed" ;;
    esac

    rsh true >/dev/null 2>&1 || die "cannot ssh to $HOST.
    This writes the board's firmware configuration, so it needs the board
    running and reachable -- a Pi that cannot be reached at all has to be met
    physically first, with a card written by 'wk sysimage write'."

    # Two ways to write an EEPROM, a property of the image the board is
    # running rather than of the board: `onboard` (rpi-eeprom-config --apply,
    # Raspberry Pi OS) edits the *running* image and changes only what was
    # asked; `recovery` (boot/rpi-eeprom.sh, needs nothing on the board)
    # stages recovery.bin + pieeprom.upd and replaces the whole image with a
    # pinned release, for boards without rpi-eeprom-config.
    local method=onboard
    if ! rsh 'command -v rpi-eeprom-config >/dev/null 2>&1'; then
        method=recovery
        eeprom_check_soc
    fi

    local current new
    if [ "$method" = onboard ]; then
        current=$(rsh 'sudo rpi-eeprom-config') || die "could not read $HOST's EEPROM configuration"
    else
        current=$(eeprom_read_config)
    fi

    local order
    order=$(kv_get BOOT_ORDER <<<"$current")
    [ -n "$order" ] || order=0xf41

    # The network-boot keys come out unconditionally: nothing here writes
    # them, and a TFTP_IP left behind on a board is a stale fact that reads as
    # a live one.
    local stripped want
    stripped=$(printf '%s\n' "$current" | grep -vE '^(TFTP_IP|CLIENT_IP|SUBNET|GATEWAY)=')

    case "$order_name" in
        local)     want=$(boot_order_without_net "$order") ;;
        usb-first) want=$(boot_order_first "$order" 4) ;;
        sd-first)  want=$(boot_order_first "$order" 1) ;;
    esac
    new=$(printf '%s\n' "$stripped" | sed "s|^BOOT_ORDER=.*|BOOT_ORDER=$want|")

    # The common case once a board is set up.
    if [ "$current" = "$new" ]; then
        info "$HOST's firmware already says this; nothing to write"
        # If it says this *because* a staged update was applied, the files
        # that carried it have done their job -- the only moment that is
        # knowable, since staging runs before the reboot that consumes it.
        [ "$method" = recovery ] && eeprom_clear_staged
        return 0
    fi

    log "$HOST's firmware configuration would change (boot order: $order_name):"
    diff -u <(printf '%s\n' "$current") <(printf '%s\n' "$new") | sed '1,2d;s/^/  /' || true

    if [ -n "$dry" ]; then
        log "dry run -- the EEPROM was not written."
        return 0
    fi

    warn "this writes $HOST's EEPROM. BOOT_ORDER is shared by both of that"
    warn "machine's roles, and a bad value needs physical access to fix."
    if [ "$method" = recovery ]; then
        warn ""
        warn "$HOST has no rpi-eeprom-config, so this goes through recovery.bin --"
        warn "which replaces the whole bootloader image with rpi-eeprom's pinned"
        warn "$EEPROM_IMAGE, carrying the configuration above onto it. The"
        warn "bootloader is upgraded as well as configured."
    fi
    confirm "write this configuration to $HOST's EEPROM?" || die "not written"

    if [ "$method" = onboard ]; then
        printf '%s\n' "$new" | rsh 'cat > /tmp/wk-boot.conf && sudo rpi-eeprom-config --apply /tmp/wk-boot.conf' \
            || die "rpi-eeprom-config refused the configuration; nothing was written"
        info "$HOST's EEPROM updated; it takes effect on the next boot"
        log  "  verify with: ssh $HOST sudo rpi-eeprom-config"
    else
        eeprom_stage_recovery "$new"
        info "$HOST's EEPROM update is staged; the ROM applies it on the next boot"
        log  "  apply with:  ssh $HOST reboot"
        log  "  verify with: ssh $HOST vcgencmd bootloader_config"
        log  "  the board goes through firmware twice, so allow a few minutes"
    fi
    log  "  undo with:   wk pi boot-order $HOST local"
}

# --- inside a workspace, deploy and bench are requests -------------------------
#
# `wk pi` is host-only and stays host-only: putting a device on the tailnet
# needs an auth key and writing an EEPROM boot order needs the board. Two of
# its verbs, though, are exactly the outcomes a sandboxed benchmark run has to
# have and cannot produce -- put this build on the board, run this plan on it
# -- so in a workspace those two become a request over the socket, performed
# by the broker on the workstation (lib/broker.sh).
#
# Parsed here rather than forwarded as a line, so the broker's vocabulary is
# the limit and not whatever this file happens to accept. An option outside
# that vocabulary is refused by name here rather than silently dropped.
if in_workspace; then
    . "$WK_ROOT/lib/broker.sh"
    case "$ACTION" in
        deploy|bench) ;;
        *) broker_no_route "'wk pi $ACTION'" "wk pi $ACTION ..." ;;
    esac
    broker_present || broker_no_route "'wk pi $ACTION'" "wk pi $ACTION $HOST $*"

    # One bare word is expected after the top-level shift: the machine for
    # `deploy` (whose first argument is the workspace, taken into $HOST), the
    # plan for `bench`. Everything else is either a vocabulary word or a
    # refusal.
    _pos=""; _opts=""; _slot=""; _extra=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --slot)     _slot="${2:-}"; shift ;;
            --count)    _opts="$_opts count=${2:-}"; shift ;;
            -*)         _extra="$_extra $1" ;;
            *)          if [ -n "$_pos" ]; then _extra="$_extra $1"; else _pos="$1"; fi ;;
        esac
        shift
    done
    [ -z "$_extra" ] || die "the request broker's vocabulary does not carry:$_extra
    A request is a fixed set of outcomes, not this command's option list, and
    the set is in container/broker/wk-broker.py -- deliberately smaller than
    what this command accepts at a keyboard, because each argument that crosses
    the boundary is one more thing that has to be validated out there.
    Run it on the workstation instead:  wk pi $ACTION $HOST $_pos$_extra"
    [ -z "$_slot" ] || _opts="$_opts slot=$_slot"

    _rc=0
    # shellcheck disable=SC2086  -- $_opts is a list of validated key=value words
    if [ "$ACTION" = deploy ]; then
        broker_call stage machine="$_pos" workspace="$HOST" $_opts || _rc=$?
    else
        broker_call run machine="$HOST" plan="$_pos" $_opts || _rc=$?
    fi
    exit "$_rc"
fi

# $HOST holds $2, which for `deploy` is the workspace -- the argument order is
# <workspace> <machine>, so the machine is what is left after the top-level
# shift. Named locally rather than reusing $HOST, which means an ssh host
# everywhere else in this file.
if [ "$ACTION" = deploy ]; then
    cmd_deploy "$HOST" "$@"
    exit 0
fi

if [ "$ACTION" = bench ]; then
    cmd_bench "$HOST" "$@"
    exit 0
fi

if [ "$ACTION" = boot-order ]; then
    ORDER_NAME=""
    case "${1:-}" in
        ''|--*) ;;
        *) ORDER_NAME="$1"; shift ;;
    esac
    cmd_boot_order "$@"
    exit 0
fi

info "probing $HOST"
ARCH=$(rsh 'uname -m') || die "cannot ssh to $HOST"
KERNEL=$(rsh 'uname -r')

case "$ARCH" in
    aarch64|arm64) TS_ARCH=arm64 ;;
    armv7l|armv6l) TS_ARCH=arm ;;
    x86_64)        TS_ARCH=amd64 ;;
    *) die "unsupported architecture: $ARCH" ;;
esac
log "  arch=$ARCH kernel=$KERNEL -> tailscale_${TS_VERSION}_${TS_ARCH}"

# A buildroot rootfs is often read-only or tiny, so find somewhere durable to
# put the binaries and the node state rather than assuming /usr/local exists.
DEST=$(rsh 'for d in /opt /data /usr/local /home/root /root; do
              if [ -d "$d" ] && touch "$d/.wk-probe" 2>/dev/null; then
                rm -f "$d/.wk-probe"; echo "$d"; exit 0
              fi
            done
            echo /tmp')
log "  writable prefix: $DEST"

# Kernel-mode Tailscale needs /dev/net/tun. Userspace mode is the fallback and
# needs no kernel support at all, which is what keeps the no-image-change
# promise honest on a buildroot device.
if rsh 'test -c /dev/net/tun'; then
    TS_MODE=kernel
    log "  /dev/net/tun present -> kernel networking"
else
    TS_MODE=userspace
    warn "/dev/net/tun absent -> userspace networking"
    warn "  verify inbound ssh over the tailnet works on this device;"
    warn "  if it does not, fall back to a Pi-originated reverse tunnel (still no image change)"
fi

# The published checksum for this arch, from the same file as the version,
# checked before the tarball is unpacked on a device whose whole job is to run
# other people's code and report numbers about it.
TS_SHA256=$(ts_release_field "TS_SHA256_$TS_ARCH")
[ -n "$TS_SHA256" ] || die "$TS_RELEASE declares no TS_SHA256_$TS_ARCH.
    Add the published checksum for that architecture:
      curl -fsS https://pkgs.tailscale.com/stable/tailscale_${TS_VERSION}_${TS_ARCH}.tgz.sha256"

info "installing tailscale $TS_VERSION on $HOST"
rsh "set -e
    cd '$DEST'
    if [ ! -x '$DEST/tailscaled' ]; then
        url=https://pkgs.tailscale.com/stable/tailscale_${TS_VERSION}_${TS_ARCH}.tgz
        # wget and sha256sum, not curl or openssl: every image this repo builds
        # is at least busybox, and busybox carries the first of each pair and
        # never the second. One path, checked and refused rather than guessed.
        command -v wget >/dev/null \
            || { echo 'no wget on this board; refusing to fetch tailscale unverified' >&2; exit 1; }
        wget -qO ts.tgz \"\$url\"
        # Verified before it is unpacked, not after: an archive that is not the
        # one this fleet pinned must never be written to the disk at all.
        command -v sha256sum >/dev/null \
            || { echo 'no sha256sum on this board; refusing to unpack an unverified tarball' >&2; exit 1; }
        echo '$TS_SHA256  ts.tgz' | sha256sum -c - >/dev/null
        tar xzf ts.tgz --strip-components=1 \
                  'tailscale_${TS_VERSION}_${TS_ARCH}/tailscale' \
                  'tailscale_${TS_VERSION}_${TS_ARCH}/tailscaled'
        rm -f ts.tgz
        chmod +x tailscale tailscaled
    fi
    mkdir -p '$DEST/tailscale-state'"

# BusyBox init: an S-script is the portable option, since buildroot images
# usually have neither systemd nor a service manager with a unit format.
FLAGS="--state=$DEST/tailscale-state/tailscaled.state --socket=$DEST/tailscale-state/tailscaled.sock"
[ "$TS_MODE" = userspace ] && FLAGS="$FLAGS --tun=userspace-networking"

rsh "cat > '$DEST/tailscale-up.sh' <<'EOF'
#!/bin/sh
# Installed by wk pi setup. Starts tailscaled with state on a writable
# partition so nothing in the read-only rootfs has to change.
DEST=$DEST
[ -S \"\$DEST/tailscale-state/tailscaled.sock\" ] && exit 0
\"\$DEST/tailscaled\" $FLAGS >/var/log/tailscaled.log 2>&1 &
EOF
chmod +x '$DEST/tailscale-up.sh'
'$DEST/tailscale-up.sh'"

sleep 2

# Only prompt for an auth key when the node actually needs one: a re-run
# against a device already on the tailnet is routine, and prompts are for
# things that cannot proceed without an answer.
TSIP=$(rsh "'$DEST/tailscale' --socket='$DEST/tailscale-state/tailscaled.sock' ip -4" 2>/dev/null | head -1) || TSIP=""
if [ -n "$TSIP" ]; then
    info "$HOST is already on the tailnet at $TSIP -- no auth key needed"
else
    info "bringing the node up as $TAG"

    # The fleet's one key, from the one place it lives (wk_tailscale_authkey,
    # lib/common.sh) rather than a `read` of its own: a second copy of a
    # credential is state this repository refuses, and a command that stops
    # to ask for a secret cannot be run from a script or handed to an agent.
    KEYFILE=$(wk_tailscale_authkey) || die "no tailscale auth key, so this board cannot join the tailnet.
    It has to: everything wk touches is on the tailnet, and a node is reached by
    its tailnet name with nothing about how to reach it stored anywhere
    (CLAUDE.md, 'Cattle, not pets'). The key must be tagged $TAG."

    # Over the same ssh into a 0600 file, never onto a command line: argv is
    # world readable in /proc, so `--authkey=tskey-...` hands the key to
    # anything with a shell on the board (wk bridge makes the same argument).
    # `--auth-key file:` reads one without argv; the file goes as soon as it
    # has been spent, whether or not the join worked.
    rsh "umask 077; cat > '$DEST/tailscale-state/authkey'" < "$KEYFILE" \
        || die "could not hand the auth key to $HOST"

    UP_RC=0
    rsh "'$DEST/tailscale' --socket='$DEST/tailscale-state/tailscaled.sock' up \
            --auth-key='file:$DEST/tailscale-state/authkey' \
            --advertise-tags='$TAG' --hostname='$(basename "$HOST")'" || UP_RC=$?
    rsh "rm -f '$DEST/tailscale-state/authkey'" || \
        warn "the spent auth key is still at $DEST/tailscale-state/authkey on $HOST"
    [ "$UP_RC" -eq 0 ] || die "tailscale up failed on $HOST (exit $UP_RC).
    A key that is single-use, untagged, or expired fails exactly here; the node
    is left with tailscaled running and no identity, and re-running this is safe."

    TSIP=$(rsh "'$DEST/tailscale' --socket='$DEST/tailscale-state/tailscaled.sock' ip -4" | head -1)
fi
info "$HOST is on the tailnet at $TSIP"

# Add the address to the workspace egress allowlist. Individual addresses, not
# the whole CGNAT range: the workstation is itself an unrestricted tailnet node,
# so allowing 100.64.0.0/10 would let a workspace reach everything it can.
# The file lives in the store, which ./setup never regenerates, so re-running
# setup cannot cut the test devices off.
PI_FILE="$WK_STORE/pi-hosts"
ensure_dir "$(dirname "$PI_FILE")"
if ! grep -qxF "$TSIP" "$PI_FILE" 2>/dev/null; then
    printf '%s\n' "$TSIP" >> "$PI_FILE"
    info "recorded $TSIP in $PI_FILE"
fi

# The file *is* the policy: the egress proxy re-reads it on every request, so
# a device added here is reachable immediately with nothing to reload.
info "allowed $TSIP (the egress proxy re-reads $PI_FILE per request)"

cat >&2 <<EOF

Remaining manual step -- the tailnet ACL. In the admin console, grant tag:wk
full access to itself so workspaces and Pis can reach each other:

  "tagOwners": { "tag:wk": ["autogroup:admin"] },
  "grants": [
    { "src": ["tag:wk"], "dst": ["tag:wk"], "ip": ["*"] },
    { "src": ["autogroup:member"], "dst": ["*"], "ip": ["*"] }
  ]

Note the existing tag:server covers moose, nextcloud, immich, overleaf and the
gateway -- do not reuse it here, or workspaces get all of them.
EOF
