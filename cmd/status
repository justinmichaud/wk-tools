"""what is happening, without guessing

The workspaces on every place this machine knows and the tasks each store records: their state, steps, holds, kill
command and log. Read from the records builds and tasks write, not a process list; what is healthy is `wk doctor`'s.
The table is the default; --json prints the merged document.

Exit status:
  0  idle or last build succeeded
  1  last build failed
  2  busy: a build running or `silent` (no log output for WK_STALL_SECONDS, inside the `abort_after` it recorded), or
     a workspace being created
  3  a build stalled and its watchdog killed it
  4  a workspace needs a person: a creation nothing is driving, a build silent past its `abort_after`, an environment
     removed under the record, an unreadable task record, an unreachable machine, or a workspace that did not answer
     about its job's pid (`unanswered`)
"""
import json
import sys

from wk import images, pgo, places, record, statusview, store
from wk.act import die, info, warn
from wk.clock import Clock
from wk.decl import Command, Opt
from wk.record import Records
from wk.status import Walk, wait

ROOT = images.root()
LOG = dict(name="required", here=False)
COMMAND = Command(name="optional", here=True, readonly=True, group="workspaces", opts=(
    Opt("--records", "the records, one JSON object per line"),
    Opt("--json", "the merged document"),
    Opt("--wait", "block while busy (exit 2), then report"),
    Opt("--timeout", "with --wait: stop waiting without claiming the work stopped", value="<s>"),
    Opt("--holds", "the live tasks in this machine's store holding <res>", value="<res>"),
    Opt("--log", "its newest log (its build, an image stage, its creation), normalised, with the first error and the "
        "last output", sets=LOG),
    Opt("--follow", "with --log: stream it", sets=LOG), Opt("-f", "the same as --follow", sets=LOG),
    Opt("--all", "with --log: print all of it", sets=LOG), Opt("-a", "the same as --all", sets=LOG),
    Opt("--gates", "with --log: the readings this build was collected under", sets=LOG),
    Opt("-g", "the same as --gates", sets=LOG)))
LOG_FLAGS = ("--log", "--follow", "-f", "--all", "-a", "--gates", "-g")


def holders(resource):
    reg = places.Registry(ROOT)
    records = Records(ask_place=lambda n, pid, cap: reg.load(reg.ws_place(n)).pid_alive(n, pid, cap))
    for t in records.holders(resource):
        print(t.line())
    return 0


def show_log(args):
    if not args.flag("--log"):
        die("--follow, --all and --gates read the log: wk status <workspace> --log --follow")
    modes = [m for m, on in (("follow", args.flag("--follow") or args.flag("-f")), ("all", args.flag("--all") or args.flag("-a")),
                             ("gates", args.flag("--gates") or args.flag("-g"))) if on]
    if len(modes) > 1:
        die("--log shows one of --follow, --all or --gates at a time; see wk status -h")
    rest = [o for o in args.order if o not in LOG_FLAGS]
    if rest:
        die("--log shows the log alone: drop %s" % " ".join(rest))
    name = store.ws_name()
    reg = places.Registry(ROOT)
    driver = reg.load(reg.ws_place(name))
    if modes == ["gates"]:
        return pgo.show_gates(driver, name)
    return record.show_log(driver, name, modes[0] if modes else "", "" if reg.in_workspace() else " " + name)


def main(args, inv):
    try:
        if any(args.flag(f) for f in LOG_FLAGS):
            return show_log(args)
        if args.value("--holds") is not None:
            return holders(args.value("--holds"))
        name = store.ws_name() or None
        waited = None
        if args.flag("--wait"):
            waited = wait(lambda: Walk(ROOT, name=name).worst_only(), int(args.value("--timeout") or 0), Clock(), name, info, warn)
        walk = Walk(ROOT, name=name)
        if args.flag("--records"):
            for r in walk.records(markers=False):
                print(json.dumps(r, separators=(",", ":")))
        elif args.flag("--json"):
            json.dump(statusview.merge(walk.records()), sys.stdout, indent=2)
            sys.stdout.write("\n")
        else:
            statusview.render_text_stream(walk.records(), sys.stdout, statusview.colour_wanted())
        return walk.worst if waited is None else waited   # --wait's exit is the answer the wait confirmed
    except LookupError as e:
        die(str(e))
