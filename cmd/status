#!/usr/bin/env bash
#
# wk status [workspace] -- what is happening, without guessing.
#
# This exists because the alternative is inspecting a process list, and that is
# unreliable in both directions: `pgrep -f ninja` matches the pgrep itself, and
# a build between phases has no compiler running while being perfectly healthy.
# Both mistakes cost real time here. So the build records its own state and
# this reads it.
#
# Exit status is meaningful, so a script or an agent can branch on it:
#   0  idle or last build succeeded
#   1  last build failed
#   2  a build is running, or a workspace is still being created
#   3  a build stalled and was killed
#   4  a workspace needs a person: a creation whose driver is gone, an
#      environment removed from under the record, or a machine that will not
#      answer. Distinct from 3 on purpose -- 3 is a build to re-run, 4 is a
#      workspace to repair, and an agent branching on this should not conflate
#      them.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/detach.sh"

worst=0

report() {
    local ws="$1"
    report_ws "$ws"
    report_one "$ws" build "$(wk_ws_dir "$ws")/build.status"
    [ -f "$(wk_ws_dir "$ws")/test.status" ] && report_one "$ws" test "$(wk_ws_dir "$ws")/test.status"
    [ -f "$(wk_ws_dir "$ws")/babysit.status" ] && report_babysit "$(wk_ws_dir "$ws")/babysit.status"
    return 0
}

# The lifecycle line, first and above everything else this workspace has been
# asked to do -- because "is this a workspace at all, and can it be acted on"
# comes before "how did its last build go", and because for three of the five
# answers every line under it is about a workspace that is not there.
#
# Every word of it is derived at read time (ws_state in lib/target.sh): the
# environment as the driver finds it, the completion marker next to the
# workspace, the base pin. The one thing read from ws.status is whether the
# process that claimed to be creating this is still alive -- which is not on
# disk anywhere, and which is exactly the difference between "being made" and
# "was being made when the ssh dropped".
report_ws() {
    local ws="$1" st disp sf stage pid upd
    st=$(ws_state "$ws")
    sf=$(ws_status_file "$ws")

    # `present` is the only state where the environment's own word adds
    # anything (running, exited, present); for the rest it *is* the answer, and
    # asking the driver a second time would cost a probe to be told what we
    # already know.
    if [ "$st" = present ]; then disp=$(t_info "$ws"); else disp="$st"; fi

    printf '%-18s %-16s %-10s %-24s ws=%s\n' \
        "$ws" "$(_col "$TARGET")" "$disp" "$(t_branch "$ws")" "$st"

    # A wrong `origin` is worth a line in the listing rather than only in
    # `wk remotes`: it is silent, it changes what `git log origin/main` means
    # (a local mirror answers for its own last fetch), and it is how a push
    # goes somewhere nobody intended. One question, one exec -- the full wiring
    # check is `wk remotes`, which this points at. Only for a workspace that
    # exists and finished being made, the same condition t_branch uses.
    if [ "$st" = present ]; then
        _origin=$(t_exec "$ws" git -C "$(t_src "$ws")" config --get remote.origin.url \
                    2>/dev/null | tr -d '\r') || _origin=""
        case "$_origin" in
            ''|https://github.com/WebKit/WebKit.git) ;;
            *) warn "  origin is $_origin, not upstream -- 'wk remotes $ws --fix'" ;;
        esac
    fi

    stage=$(status_field "$sf" stage)
    pid=$(status_field "$sf" pid)
    upd=$(status_field "$sf" updated)

    case "$st" in
    creating)
        if detach_alive "$sf"; then
            log "  creating: ${stage:-?} (pid $pid, alive${upd:+, said so $upd})"
            log "  follow:   tail -f $(ws_create_log "$ws")"
            bump 2
        else
            warn "  creation never finished, and nothing is creating it now${pid:+ (pid $pid is gone)}"
            [ -z "$stage" ] || log "  it got as far as: $stage${upd:+ ($upd)}"
            log "  usually there is nothing in one worth keeping -- remake it:"
            log "    $(ws_remake_hint "$ws")"
            log "  or, if the checkout is complete and only the marker is missing,"
            log "  any command that gates on it takes --force"
            bump 4
        fi
        ;;
    broken)
        warn "  the record says a $TARGET workspace and the machine has none -- something
  outside wk removed it (podman rm, tart delete, an rm -rf over there)"
        log "  clear the record:  wk rm $ws"
        [ -d "$(wk_ws_dir "$ws")" ] && \
            log "  what is left of it here: $(wk_ws_dir "$ws")"
        bump 4
        ;;
    unreachable)
        warn "  the machine behind '$TARGET' did not answer within ${WK_SSH_TIMEOUT:-10}s"
        log "  this is not 'absent': nothing about the workspace was checked at all,"
        log "  and anything below is the last thing this machine wrote about it"
        bump 4
        ;;
    esac
    return 0
}

# The babysitter's line. Unlike a build, it has a pid of its own on this host
# -- the detached loop -- so liveness is the process, not the age of a log: a
# state that claims to be running with a dead pid is a crash, and saying
# "fixing" about it would be the status file's word against the process table.
report_babysit() {
    local f="$1" state config model attempt max pid report
    state=$(awk -F= '/^state=/{print $2}' "$f")
    config=$(awk -F= '/^config=/{print $2}' "$f")
    model=$(awk -F= '/^model=/{print $2}' "$f")
    attempt=$(awk -F= '/^attempt=/{print $2}' "$f")
    max=$(awk -F= '/^max=/{print $2}' "$f")
    pid=$(awk -F= '/^pid=/{print $2}' "$f")
    report=$(awk -F= '/^report=/{print $2}' "$f")

    printf '%-18s %-16s %-10s babysit=%s' "" "" "" "${state:-none}"
    [ -n "$config" ] && printf ' (%s, %s, fix %s/%s)' "$config" "$model" "$attempt" "$max"
    echo

    case "$state" in
    starting|building|fixing)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            log "  alive: pid $pid -- follow: tail -f $(dirname "$f")/babysit.log"
            bump 2
        else
            warn "  the babysitter died without writing an outcome -- see $(dirname "$f")/babysit.log"
            bump 1
        fi
        ;;
    gave-up|error|stalled)
        warn "  report: $report"
        bump 1
        ;;
    ok)
        [ "${attempt:-0}" -gt 0 ] 2>/dev/null && log "  fixed $attempt time(s); report: $report"
        ;;
    esac
}

report_one() {
    local ws="$1" kind="$2" status_file="$3"
    local state=none config="" arch="" secs="" rc="" logf=""

    local peak=""
    if [ -f "$status_file" ]; then
        # shellcheck disable=SC1090
        state=$(awk -F= '/^state=/{print $2}' "$status_file")
        peak=$(awk -F= '/^peak_mb=/{print $2}' "$status_file")
        config=$(awk -F= '/^config=/{print $2}' "$status_file")
        # Recorded per build rather than read from the workspace now: what
        # matters here is the architecture the build in question was made with,
        # and for a build predating --arch the field is simply absent.
        arch=$(awk -F= '/^arch=/{print $2}' "$status_file")
        secs=$(awk -F= '/^seconds=/{print $2}' "$status_file")
        rc=$(awk -F= '/^exit=/{print $2}' "$status_file")
        logf=$(awk -F= '/^log=/{print $2}' "$status_file")
    fi

    # No identity columns: the lifecycle line above this one carries them, and
    # a name repeated on every line of a workspace's block reads as several
    # workspaces with the same name.
    printf '%-18s %-16s %-10s %-24s %s=%s' "" "" "" "" "$kind" "${state:-none}"
    case "$arch" in native|'') arch="" ;; *) arch=", $arch" ;; esac
    [ -n "$config" ] && printf ' (%s%s)' "$config" "$arch"
    [ -n "$secs" ] && printf ' %sm%ss' "$(( secs / 60 ))" "$(( secs % 60 ))"
    echo

    case "$state" in
    running)
        # A 'running' status file only means the build did not get to write a
        # final state -- it says nothing about liveness. Age of the log does.
        if [ -f "$logf" ]; then
            local age now mtime
            now=$(date +%s)
            mtime=$(stat -c %Y "$logf" 2>/dev/null || stat -f %m "$logf" 2>/dev/null || echo "$now")
            age=$(( now - mtime ))
            if [ "$age" -gt "${WK_STALL_SECONDS:-300}" ]; then
                warn "  no log output for ${age}s -- likely stalled or killed"
                _stall_report "$logf" "$age"
            else
                log "  alive: $(_progress_line "$logf" || echo 'running') (last output ${age}s ago)"
            fi
        fi
        [ "$worst" -lt 2 ] && worst=2
        ;;
    failed)
        warn "  exit $rc"
        first_error "$logf" 2>/dev/null | sed 's/^/    /' || true
        [ "$worst" -lt 1 ] && worst=1
        ;;
    stalled)
        warn "  killed after no output; see $logf"
        worst=3
        ;;
    # The memory watchdog's verdict, kept distinct from a build that merely
    # failed: the fix is a job count or a per-job working set, not the code.
    oom)
        warn "  killed for memory${peak:+ (peak ${peak}MB)}; see $logf"
        grep -a 'wk: MEMORY LIMIT' "$logf" 2>/dev/null | tail -1 | sed 's/^wk: /    /' >&2 || true
        worst=3
        ;;
    esac

    # Printed for a build that survived too: how close it came is the question
    # asked right after one that nearly did not finish.
    case "$state" in
        ok|running) [ -z "$peak" ] || log "  memory: peak ${peak}MB" ;;
    esac
}

# One named workspace resolves to its own target; the bare listing walks every
# target there is. Loading one target and reporting everything through it --
# which is what this used to do -- silently reported vm workspaces as absent,
# because the container driver has never heard of them.
# A target that is a machine of its own answers for itself.
#
# Not politeness: the build state that matters lives over there. A build can be
# started from here or from a shell on that machine, and only its copy has both
# -- so asking it is the difference between "build=ok, 8m47s" and a confident
# `build=none` about a build that is running in front of you.
#
# Its exit status is the answer too, since this command's whole contract is
# that a script can branch on it.
delegate() {
    local rc=0
    t_wk "$@" || rc=$?
    return "$rc"
}

# This machine's own tooling, once, when this machine is the one driving.
# Everything else in the fleet block is compared against it, so it has to be
# on screen -- and on a macOS host it is the one line no target walk produces,
# because the store and the tooling copies are all somewhere else.
report_self() {
    local ver sha dirty tree
    [ -z "${WK_EXPECT_TREE:-}" ] || return 0
    ver=$("$WK_ROOT/cmd/version" 2>/dev/null) || return 0
    sha=$(printf '%s\n' "$ver"   | sed -n 's/^sha=//p')
    dirty=$(printf '%s\n' "$ver" | sed -n 's/^dirty=//p')
    tree=$(printf '%s\n' "$ver"  | sed -n 's/^tree=//p')
    printf '%-18s %-16s %s\n' "" "wk-tools@here" \
        "$([ "$sha" = - ] || printf '%s%s ' "$sha" "$([ "$dirty" = yes ] && printf '+dirty')")tree $tree  this machine"
}

# --no-fleet: report the workspaces and nothing else. For the half of a
# listing that is being assembled by another machine -- it asks each machine
# for its keys and its version itself, so a delegated status printing its own
# would be the same facts twice, compared against the wrong side.
FLEET=1
if [ "${1:-}" = --no-fleet ]; then FLEET=""; shift; fi

# WK_ROW_LABEL: the name the asking machine knows this one by, for the TARGET
# column. A machine of its own answers in its own vocabulary, and for a peer
# workstation that vocabulary is `container` -- the same word the asking machine
# uses for a different machine's containers. Qualified rather than always
# prefixed: a build box's own target name already *is* the label, and
# `buildbox4:buildbox4` says nothing twice.
#
# An environment variable and not a flag, because the far side may be an older
# checkout of this repository (see t_wk in targets/remote.sh). Same mechanism in
# `wk ls`.
LABEL="${WK_ROW_LABEL:-}"
_col() { if [ -z "$LABEL" ] || [ "$1" = "$LABEL" ]; then printf '%s' "$1"; else printf '%s:%s' "$LABEL" "$1"; fi; }

# Raise the worst-so-far. A function rather than `[ x -gt y ] && worst=x`,
# because that form is the last command of an AND-OR list and returns 1 when
# the test is false -- which under `set -e` ends the walk on the second target
# that reports the same state.
bump() { [ "$1" -gt "$worst" ] && worst="$1"; return 0; }

# What a *machine* is, as opposed to what a workspace is doing: which wk-tools
# it runs, and which push keys it holds.
#
# Both are fleet questions and this is the fleet command. The keys because one
# machine per key is the design (GitHub takes many deploy keys on one
# repository, so every machine gets its own and can be revoked on its own),
# which is only manageable if something lists them side by side. The version
# because every machine runs a *copy* of this repository, pushed by rsync, and
# a stale copy fails as `unknown option --quiet` from a command that works
# perfectly on the machine you typed it on -- three times in one afternoon,
# which is what put this here.
#
# The machine that holds the thing is the machine that answers: a fingerprint
# or a tree hash read from anywhere else would be a copy of a fact. The
# comparison happens here, because only this side sees both.
#
# Read-only throughout -- public keys, a hash of files on disk, and nothing
# started anywhere.
report_machine() {
    local label="$1" ver keys mine theirs sha dirty note

    if [ "$WK_TARGET_KIND" = remote ] && t_has_wk; then
        ver=$(  { t_wk version          2>/dev/null || true; } | tr -d '\r' )
        keys=$( { t_wk key fingerprints  2>/dev/null || true; } | tr -d '\r' )
    elif [ "$label" = "$(default_target)" ]; then
        # This machine's own store and its own tooling. Not every target names
        # a machine we can read: on a macOS host the container store lives in
        # the podman VM, and the VM's own half of this listing reports it.
        ver=$("$WK_ROOT/cmd/version"          2>/dev/null || true)
        keys=$("$WK_ROOT/cmd/key" fingerprints 2>/dev/null || true)
    else
        return 0
    fi

    if [ -n "$ver" ]; then
        theirs=$(printf '%s\n' "$ver" | sed -n 's/^tree=//p')
        sha=$(printf '%s\n' "$ver"    | sed -n 's/^sha=//p')
        dirty=$(printf '%s\n' "$ver"  | sed -n 's/^dirty=//p')
        # Compared against the machine that *pushes* the tooling, which is the
        # workstation -- not against whichever half of the listing happens to
        # be printing. The podman VM's own copy is rsynced from there, so a VM
        # comparing itself with itself would report "in sync" about a tree
        # that is a week behind the machine it came from. WK_EXPECT_TREE is
        # how the workstation says what it has; unset means this is the
        # workstation.
        mine="${WK_EXPECT_TREE:-$("$WK_ROOT/cmd/version" --tree 2>/dev/null || true)}"
        note="in sync"
        [ "$theirs" = "$mine" ] || note="DIFFERS from the workstation ($mine) -- push it there"
        printf '%-18s %-16s %s\n' "" "wk-tools@$label" \
            "$([ "$sha" = - ] || printf '%s%s ' "$sha" "$([ "$dirty" = yes ] && printf '+dirty')")tree $theirs  $note"
    fi

    [ -n "$keys" ] || return 0
    printf '%s\n' "$keys" | while read -r line; do
        [ -n "$line" ] || continue
        printf '%-18s %-16s %s\n' "" "keys@$label" "$line"
    done
}

if [ -n "${1:-}" ]; then
    # In a workspace a bare `wk status` is the whole command: there is one
    # workspace and it is this machine (refuse_ws_name, lib/target.sh).
    refuse_ws_name "$1" status
    require_name "$1"
    TARGET="$(ws_target "$1")"
    load_target "$TARGET"
    if t_has_wk; then
        WK_ROW_LABEL="$TARGET" WK_NO_DELEGATE=1 \
            delegate status --no-fleet "$1"
        exit $?
    fi
    report "$1"
else
    found=0
    _TARGETS=$(walk_targets)
    # Every machine asked at once, before the first row is printed; the walk
    # below is unchanged and finds them already answered (prefetch_targets,
    # lib/target.sh).
    # shellcheck disable=SC2086 -- deliberate word splitting of the target list.
    prefetch_targets $_TARGETS
    trap 'prefetch_done' EXIT
    for TARGET in $_TARGETS; do
        load_target "$TARGET"
        if t_has_wk; then
            found=1
            rc=0
            WK_ROW_LABEL="$TARGET" WK_NO_DELEGATE=1 \
                delegate status --no-fleet || rc=$?
            bump "$rc"
            [ -z "$FLEET" ] || report_machine "$TARGET"
            continue
        fi
        for ws in $(target_workspaces); do found=1; report "$ws"; done
        [ -z "$FLEET" ] || report_machine "$TARGET"
    done
    [ -z "$FLEET" ] || report_self

    # Named when the caller asked about one target in particular -- a macOS
    # host reports the host-side targets one pass at a time, and three bare
    # "(no workspaces)" lines in a row say nothing about which.
    [ "$found" -eq 1 ] || log "(no workspaces${WK_TARGET:+ on $WK_TARGET})"
fi

exit "$worst"
