#!/usr/bin/env python3
#
# wk status [<workspace> [--log]] -- what is happening, without guessing
# wk: where=workspace name=optional here readonly group=workspaces
# wk: opts --no-fleet,--no-devices,--records,--json,--wait,--timeout=,--holds=,--log,--follow,-f,--all,-a,--gates,-g
# wk: flag --log,--follow,-f,--all,-a,--gates,-g name=required here=no
#
# Reads the records builds and tasks write, not a process list.
#
# Exit status:
#   0  idle or last build succeeded
#   1  last build failed
#   2  busy: a build running or `silent` (no log output for WK_STALL_SECONDS,
#      inside the `abort_after` it recorded), or a workspace being created
#   3  a build stalled and its watchdog killed it
#   4  a workspace needs a person: a creation nothing is driving, a build
#      silent past its `abort_after`, an environment removed under the record,
#      an unreadable task record, an unreachable machine, or a workspace that
#      did not answer about its job's pid within WK_TASK_ASK_SECONDS
#      (`unanswered`)
#
# The table is the default; --json prints the merged document.
#
#   --holds <res>   the live tasks in this machine's store holding <res>
#   --no-fleet      the workspaces alone; --no-devices drops boards
#   --records       the records, one JSON object per line
#   --wait          block while busy (exit 2), then report; --timeout=<s>
#                   stops waiting without claiming the work stopped
#
#   <workspace> --log   its newest log (its build, an image stage, its creation),
#                       normalised, with the first error and the last output
#     --follow, -f   stream it
#     --all, -a      print all of it
#     --gates, -g    the readings this build was collected under
#
#   WK_WAIT_TIMEOUT, WK_WAIT_INTERVAL   --wait's defaults (0: forever; 5s)
#   WK_FLEET_TIMEOUT    ceiling on one fleet-device probe (4s)

import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images, store  # noqa: E402

ROOT = images.root()

from wk import decl, pgo, places, record, statusview  # noqa: E402
from wk.act import Refused, die, info, warn  # noqa: E402
from wk.clock import Clock  # noqa: E402
from wk.record import Records  # noqa: E402
from wk.status import Walk, wait_until_idle  # noqa: E402


def holders(resource):
    reg = places.Registry(ROOT)
    records = Records(ask_place=lambda n, pid, cap: reg.load(reg.ws_place(n)).pid_alive(n, pid, cap))
    for row in records.holders(resource):
        print("\t".join(row))
    return 0


LOG_FLAGS = ("--log", "--follow", "-f", "--all", "-a", "--gates", "-g")


def show_log(args):
    if not args.flag("--log"):
        die("--follow, --all and --gates read the log: wk status <workspace> --log --follow")
    modes = [m for m, on in (("follow", args.flag("--follow") or args.flag("-f")), ("all", args.flag("--all") or args.flag("-a")),
                             ("gates", args.flag("--gates") or args.flag("-g"))) if on]
    if len(modes) > 1:
        die("--log shows one of --follow, --all or --gates at a time; see wk status -h")
    rest = [o for o in args.order if o not in LOG_FLAGS]
    if rest:
        die("--log shows the log alone: drop %s" % " ".join(rest))
    name = store.ws_name()
    if not name:
        die("wk status --log needs a workspace name")
    reg = places.Registry(ROOT)
    try:
        driver = reg.load(reg.ws_place(name))
    except LookupError as e:
        die(str(e))
    if modes == ["gates"]:
        return pgo.show_gates(driver, name)
    return record.show_log(driver, name, modes[0] if modes else "", "" if reg.in_workspace() else " " + name)


def main(argv):
    env = os.environ
    args = decl.Args(decl.Decl(__file__), argv)
    if any(args.flag(f) for f in LOG_FLAGS):
        return show_log(args)
    no_fleet = args.flag("--no-fleet")
    if args.value("--holds") is not None:
        return holders(args.value("--holds"))
    name = store.ws_name(env) or None
    wait = args.flag("--wait")
    waited = None
    if wait:
        timeout = int(args.value("--timeout") or env.get("WK_WAIT_TIMEOUT") or 0)
        waited = wait_until_idle(lambda: Walk(ROOT, name=name, fleet=False, devices=False).worst_only(), timeout,
                        float(env.get("WK_WAIT_INTERVAL", "5")), Clock(), name, info, warn)
    walk = Walk(ROOT, name=name, fleet=not no_fleet, devices=not (no_fleet or args.flag("--no-devices")))
    if args.flag("--records"):
        for r in walk.records(markers=False):
            print(json.dumps(r, separators=(",", ":")))
        return verdict(waited, walk)
    if args.flag("--json"):
        json.dump(statusview.merge(walk.records()), sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        statusview.render_text_stream(walk.records(), sys.stdout, statusview.colour_wanted())
    return verdict(waited, walk)


def verdict(waited, walk):
    """--wait's exit is the answer the wait confirmed, not the walk after it."""
    return walk.worst if waited is None else waited


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except LookupError as e:
        sys.stderr.write("error: %s\n" % e)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
