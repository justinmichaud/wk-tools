#!/usr/bin/env bash
#
# wk status [<workspace>] -- what is happening, without guessing
# wk: where=workspace name=optional bare=merged readonly group=workspaces
#
# The build records its own state, not a process list, and this reads it.
#
# Exit status is meaningful, so a script or an agent can branch on it:
#   0  idle or last build succeeded
#   1  last build failed
#   2  a build is running, or a workspace is still being created
#   3  a build stalled and was killed
#   4  a workspace needs a person: a creation whose driver is gone, an
#      environment removed from under the record, or a machine that will not
#      answer (3 is a build to re-run; 4 is a workspace to repair -- don't
#      conflate them). Also what a fleet walk reports for an unreachable peer.
#
# At a terminal, with nothing else said, this opens the page (`--web`).
# Anything else (a pipe, CI, an agent) gets the plain table; `--text` asks
# for the table anyway.
#
#   WK_WAIT_TIMEOUT=<s>     default for --timeout when --wait is given with
#                           none (0, the default, waits forever)
#   WK_WAIT_INTERVAL=<s>    how often --wait polls (default 5)
#   WK_FLEET_TIMEOUT=<s>    ceiling on one fleet-device probe (default 4)
#   WK_BRIDGE_TIMEOUT=<s>   ceiling on one bridge-phone health check
#                           (default 20; slower than a fleet probe on purpose)

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/detach.sh"
. "$WK_ROOT/lib/reach.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/par.sh"
wk_atexit par_cleanup

worst=0

# --- the record stream --------------------------------------------------------
# Everything below emits *records*, one JSON object per line, to fd 3 --
# never stdout, which the renderer (lib/status-view.py) owns and which the
# drivers this calls log to instead. JSON Lines, not one document, because a
# macOS listing is assembled from two processes and two line streams
# concatenate where two JSON documents can't.
#
# A machine running an older wk-tools has never heard of `--records`; its
# text is captured into a `raw` record instead.

# JSON string escaping, in the shell, because the shell is what has the values.
# Only five things can appear here: a backslash, a quote, and the three
# control characters a branch name, a log line or a path can carry.
_jesc() {
    local s="$1"
    # Strip ANSI colour first: a raw ESC in a JSON string is unescapable and
    # `json.loads` would reject the whole record. Walked, not
    # pattern-substituted: a glob can't say "digits and semicolons until an
    # m" without eating the whole line, and `wk` runs under macOS's bash 3.2,
    # so no extglob.
    local head tail
    while [ "${s#*$'\033'}" != "$s" ]; do
        head=${s%%$'\033'*}
        tail=${s#*$'\033'}
        tail=${tail#\[}
        # Shortest prefix up to the first `m`: a CSI colour sequence and
        # nothing beyond it. No `m` at all leaves tail unchanged, still
        # ending the loop.
        case "$tail" in *m*) tail=${tail#*m} ;; esac
        s="$head$tail"
    done
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\t'/\\t}
    s=${s//$'\r'/}
    printf '%s' "$s"
}

_rec=""
_notes=""

# A record under construction. `_notes` resets with it: a note always belongs
# to the record being built, not to whatever is emitted next.
rec_start() { _rec="{\"kind\":\"$1\""; _notes=""; }
rec_set()   { _rec="$_rec,\"$1\":\"$(_jesc "${2:-}")\""; }
# Only when there is something to say: an empty string and an absent field
# mean different things to a renderer.
rec_opt()   { [ -n "${2:-}" ] && rec_set "$1" "$2" || return 0; }
rec_json()  { _rec="$_rec,\"$1\":$2"; }
rec_emit()  {
    [ -z "$_notes" ] || rec_json notes "[$_notes]"
    printf '%s}\n' "$_rec" >&3
    _rec=""; _notes=""
}

note()      { _notes="$_notes${_notes:+,}{\"level\":\"info\",\"text\":\"$(_jesc "$*")\"}"; }
note_warn() { _notes="$_notes${_notes:+,}{\"level\":\"warn\",\"text\":\"$(_jesc "$*")\"}"; }

# The sub-states of one workspace, collected as found and emitted with it,
# rather than as rows of their own with the identity columns blanked.
_subs=""
sub_add() { _subs="$_subs${_subs:+,}$1"; }

# --- which machine, and what kind of thing on it ------------------------------
# WK_ROW_LABEL is the name the asking machine knows this one by: inside the
# podman VM, `hostname` answers `localhost`, which is not a name anybody out
# here can use.
this_machine() { printf '%s' "${WK_ROW_LABEL:-$(wk_machine_name)}"; }

# Whether these records are about the machine the person is sitting at --
# not derivable from the name, so only the caller knows (WK_HOST_SELF).
_is_self() { [ -n "${WK_HOST_SELF:-}" ] || [ -z "${WK_ROW_LABEL:-}" ]; }

method_of() {
    case "$WK_TARGET_KIND" in
        container) echo container ;;
        vm)        echo "macOS guest" ;;
        *)         echo native ;;
    esac
}

# The machine a target's workspaces are on. A remote target *is* a machine,
# named by the name this device calls it; everything else is here.
#
# `t_ssh_host ""` failing is the remote driver saying "this is the machine I
# am" -- and the answer is then this machine, not a second name for it.
machine_of() {
    if [ "$WK_TARGET_KIND" = remote ] && t_ssh_host "" >/dev/null 2>&1; then
        printf '%s' "$1"
    else
        this_machine
    fi
}

# The same answer from outside the job, before its driver is loaded: in a
# subshell, so the driver's overrides die with it (health_owner's idiom).
machine_of_target() { ( load_target "$1" >/dev/null 2>&1; machine_of "$1" ); }

# One record per machine, so a machine with nothing on it still appears --
# the answer that says the podman machine is stopped rather than that the
# workspaces are gone.
_machines_said=" "
machine_seen() {
    local m="$1"
    case "$_machines_said" in *" $m "*) return 0 ;; esac
    _machines_said="$_machines_said$m "
    rec_start machine
    rec_set name "$m"
    if [ "$m" = "$(this_machine)" ] && _is_self; then
        rec_json self true
    else
        # Computed rather than remembered (lib/reach.sh): the tailnet's own
        # answer, and the best path there is without it.
        rec_opt tailnet "$(reach_tailnet "$m")"
        rec_opt direct  "$(reach_without_tailnet "$m")"
    fi
    # Relative to the checkout: an absolute path is one machine's layout.
    _conf=""
    _c=$(target_registry_conf "$m")
    [ -f "$_c" ] && _conf="${_c#$WK_ROOT/}"
    rec_opt conf "$_conf"
    rec_emit
}

# One record per workspace: what it is, and everything it has been asked to
# do. The build, the tests and the babysitter belong to it rather than being
# rows of their own with the identity columns blanked.
report() {
    local ws="$1"
    _subs=""
    rec_start workspace
    rec_set machine "$_group_machine"
    rec_set method  "$_group_method"
    rec_set name    "$ws"
    report_ws "$ws"
    report_claude_rc "$ws"
    report_one "$ws" build "$(wk_ws_dir "$ws")/build.status"
    [ -f "$(wk_ws_dir "$ws")/test.status" ] && report_one "$ws" test "$(wk_ws_dir "$ws")/test.status"
    [ -f "$(wk_ws_dir "$ws")/babysit.status" ] && report_babysit "$(wk_ws_dir "$ws")/babysit.status"
    rec_json subs "[$_subs]"
    rec_emit
    return 0
}

# Claude Code remote-control (`wk claude <ws> --rc`), if this workspace has
# ever had one: its own status file (lib/detach.sh: pid=, state=, updated=).
# The pid names a process `t_spawn` started *inside* the target, so
# liveness is asked through `t_exec`, never a local `kill -0`.
report_claude_rc() {
    local ws="$1" sf pid
    sf="$(wk_ws_dir "$ws")/claude-rc.status"
    [ -f "$sf" ] || return 0
    pid=$(status_field "$sf" pid)
    [ -n "$pid" ] || return 0
    if t_exec "$ws" kill -0 "$pid" >/dev/null 2>&1; then
        note "claude rc: alive (pid $pid)"
    else
        note "claude rc: stopped"
    fi
}

# The lifecycle line, first above everything else. Every word is derived at
# read time (ws_state in lib/target.sh) except one: whether the process
# claiming to create this is still alive, which is not on disk.
report_ws() {
    local ws="$1" st disp sf stage pid upd
    st=$(ws_state "$ws")
    sf=$(ws_status_file "$ws")

    # `present` is the only state where the environment's own word (running,
    # exited, present) adds anything; for the rest it *is* the answer.
    if [ "$st" = present ]; then disp=$(t_info "$ws"); else disp="$st"; fi

    rec_set state  "$disp"
    rec_set ws     "$st"
    rec_opt branch "$(t_branch "$ws")"

    # What is *in* this workspace, in one exec: commits that exist nowhere
    # else, a dirty tree, drift from upstream. A wrong `origin` is worth a
    # line here too: it's how a push goes somewhere nobody intended.
    if [ "$st" = present ]; then
        _probe=$(t_exec "$ws" sh -c "cd $(sh_quote "$(t_src "$ws")") 2>/dev/null || exit 0
            printf 'origin=%s\n' \"\$(git config --get remote.origin.url 2>/dev/null)\"
            printf 'dirty=%s\n' \"\$(git status --porcelain --untracked-files=no 2>/dev/null | wc -l | tr -d ' ')\"
            printf 'untracked=%s\n' \"\$(git ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')\"
            printf 'unpushed=%s\n' \"\$(git rev-list --count HEAD --not --remotes 2>/dev/null)\"
            _u=\$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || _u=origin/main
            printf 'upstream=%s\n' \"\$_u\"
            set -- \$(git rev-list --left-right --count \"\$_u...HEAD\" 2>/dev/null)
            printf 'behind=%s\nahead=%s\n' \"\${1:-}\" \"\${2:-}\"" 2>/dev/null | tr -d '\r') || _probe=""

        _origin=$(kv_get origin <<<"$_probe")
        case "$_origin" in
            ''|https://github.com/WebKit/WebKit.git) ;;
            *) note_warn "origin is $_origin, not upstream -- 'wk remotes $ws --fix'" ;;
        esac

        for _f in dirty untracked unpushed upstream behind ahead; do
            _v=$(kv_get "$_f" <<<"$_probe")
            case "$_f:$_v" in
                *:|*:0) continue ;;   # zero is the ordinary state, and saying so is noise
            esac
            rec_set "$_f" "$_v"
        done
    fi

    # Which snapshot this workspace is standing on: why `wk sync` did not
    # change anything underneath it -- the lower layer is pinned at creation.
    _base=$(ws_base_id "$ws" 2>/dev/null) || _base=""
    if [ -n "$_base" ]; then
        rec_set base "$_base"
        _cur=$(current_base 2>/dev/null) || _cur=""
        if [ -n "$_cur" ] && [ "$_cur" != "$_base" ]; then
            # Counted rather than dated: the timestamp is in the id already.
            _newer=$( { ls -1 "$(wk_base_dir)" 2>/dev/null || true; } \
                      | awk -v b="$_base" '$0 > b' | wc -l | tr -d ' ')
            rec_set base_behind "$_newer"
        fi
    fi

    stage=$(status_field "$sf" stage)
    pid=$(status_field "$sf" pid)
    upd=$(status_field "$sf" updated)

    case "$st" in
    creating)
        if detach_alive "$sf"; then
            note "creating: ${stage:-?} (pid $pid, alive${upd:+, said so $upd})"
            note "follow:   tail -f $(ws_create_log "$ws")"
            bump 2
        else
            note_warn "creation never finished, and nothing is creating it now${pid:+ (pid $pid is gone)}"
            [ -z "$stage" ] || note "it got as far as: $stage${upd:+ ($upd)}"
            note "usually there is nothing in one worth keeping -- remake it:"
            note "  $(ws_remake_hint "$ws")"
            note "or, if the checkout is complete and only the marker is missing,"
            note "any command that gates on it takes --force"
            bump 4
        fi
        ;;
    broken)
        note_warn "the record says a $TARGET workspace and the machine has none --
      something outside wk removed it (podman rm, tart delete, an rm -rf over there)"
        note "clear the record:  wk rm $ws"
        [ -d "$(wk_ws_dir "$ws")" ] && \
            note "what is left of it here: $(wk_ws_dir "$ws")"
        bump 4
        ;;
    unreachable)
        note_warn "the machine behind '$TARGET' did not answer within $(wk_ssh_timeout)s"
        note "this is not 'absent': nothing about the workspace was checked at all,"
        note "and anything below is the last thing this machine wrote about it"
        bump 4
        ;;
    esac
    return 0
}

# The babysitter's line. Unlike a build, it has a pid of its own on this host
# -- the detached loop -- so liveness is the process, not the age of a log: a
# state claiming to be running with a dead pid is a crash.
report_babysit() {
    local f="$1" state config model attempt max pid report
    state=$(awk -F= '/^state=/{print $2}' "$f")
    config=$(awk -F= '/^config=/{print $2}' "$f")
    model=$(awk -F= '/^model=/{print $2}' "$f")
    attempt=$(awk -F= '/^attempt=/{print $2}' "$f")
    max=$(awk -F= '/^max=/{print $2}' "$f")
    pid=$(awk -F= '/^pid=/{print $2}' "$f")
    report=$(awk -F= '/^report=/{print $2}' "$f")

    local sub="{\"kind\":\"babysit\",\"state\":\"$(_jesc "${state:-none}")\""
    [ -n "$config" ] && sub="$sub,\"config\":\"$(_jesc "$config")\",\"model\":\"$(_jesc "$model")\",\"attempt\":\"$(_jesc "$attempt")\",\"max\":\"$(_jesc "$max")\""
    sub_add "$sub}"

    case "$state" in
    starting|building|fixing)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            note "alive: pid $pid -- follow: tail -f $(dirname "$f")/babysit.log"
            bump 2
        else
            note_warn "the babysitter died without writing an outcome -- see $(dirname "$f")/babysit.log"
            bump 1
        fi
        ;;
    gave-up|error|stalled)
        note_warn "report: $report"
        bump 1
        ;;
    ok)
        [ "${attempt:-0}" -gt 0 ] 2>/dev/null && note "fixed $attempt time(s); report: $report"
        ;;
    esac
}

report_one() {
    local ws="$1" kind="$2" status_file="$3"
    local state=none config="" arch="" secs="" rc="" logf=""

    local peak=""
    if [ -f "$status_file" ]; then
        # shellcheck disable=SC1090
        state=$(awk -F= '/^state=/{print $2}' "$status_file")
        peak=$(awk -F= '/^peak_mb=/{print $2}' "$status_file")
        config=$(awk -F= '/^config=/{print $2}' "$status_file")
        # Recorded per build, not read from the workspace now: the
        # architecture the build in question was made with. Absent for a
        # build predating --arch.
        arch=$(awk -F= '/^arch=/{print $2}' "$status_file")
        secs=$(awk -F= '/^seconds=/{print $2}' "$status_file")
        rc=$(awk -F= '/^exit=/{print $2}' "$status_file")
        logf=$(awk -F= '/^log=/{print $2}' "$status_file")
    fi

    # A 'running' status file is a claim, not a fact: the build may have
    # been killed with -9. build_live (lib/detach.sh) turns the claim into
    # evidence from the age of the log, before the record is built.
    local age=""
    if [ "$state" = running ]; then
        # log_age and its threshold are lib/detach.sh's, so `wk bench`'s
        # preflight and this report agree on "is it running".
        [ -f "$logf" ] && age=$(log_age "$logf")
        build_live "$status_file" "$logf" || state=stalled
    fi

    case "$arch" in native) arch="" ;; esac
    local sub="{\"kind\":\"$kind\",\"state\":\"$(_jesc "${state:-none}")\""
    [ -n "$config" ] && sub="$sub,\"config\":\"$(_jesc "$config")\""
    [ -n "$arch" ]   && sub="$sub,\"arch\":\"$(_jesc "$arch")\""
    [ -n "$secs" ]   && sub="$sub,\"seconds\":$secs"
    [ -n "$peak" ]   && sub="$sub,\"peak_mb\":$peak"
    [ -n "$rc" ]     && sub="$sub,\"exit\":\"$(_jesc "$rc")\""
    sub_add "$sub}"

    case "$state" in
    running)
        [ -f "$logf" ] && note "alive: $(_progress_line "$logf" || echo 'running') (last output ${age}s ago)"
        [ "$worst" -lt 2 ] && worst=2
        ;;
    failed)
        note_warn "exit $rc"
        while IFS= read -r _l; do note "  $_l"; done < <(first_error "$logf" 2>/dev/null || true)
        [ "$worst" -lt 1 ] && worst=1
        ;;
    stalled)
        if [ -n "$age" ]; then
            # Derived from a 'running' record the log's age contradicted,
            # not written by the watchdog itself, so a buffered listing
            # doesn't put lib/watchdog's own diagnostic above this row.
            note_warn "no log output for ${age}s -- likely stalled or killed"
            while IFS= read -r _l; do note "$_l"; done \
                < <(_stall_report "$logf" "$age" 2>&1)
        else
            note_warn "killed after no output; see $logf"
        fi
        worst=3
        ;;
    # The memory watchdog's verdict, distinct from a build that merely
    # failed: the fix is a job count or a per-job working set, not the code.
    oom)
        note_warn "killed for memory${peak:+ (peak ${peak}MB)}; see $logf"
        _lim=$(grep -a 'wk: MEMORY LIMIT' "$logf" 2>/dev/null | tail -1 | sed 's/^wk: //') || true
        [ -z "${_lim:-}" ] || note "  $_lim"
        worst=3
        ;;
    esac
}

# A target that's a machine of its own answers for itself, through t_wk: the
# build state that matters lives over there, and a build started from a
# shell on that machine is otherwise a confident `build=none` about work
# running in front of you.
delegate() {
    local rc=0 out a
    local -a args=() plain=()
    for a in "$@"; do
        args+=("$a")
        [ "$a" = --records ] || plain+=("$a")
    done

    # Records first, and captured rather than streamed: what comes back has
    # to be judged before it is passed on.
    out=$( t_wk "${args[@]}" 2>/dev/null ) || rc=$?
    case "$out" in
        "{"*) printf '%s\n' "$out" >&3; return "$rc" ;;
    esac

    # A machine running an older copy has never heard of `--records` and
    # rejects it as a workspace name -- so it is asked again in the
    # vocabulary it has, and its own listing is carried as one `raw` record.
    rc=0
    out=$( t_wk "${plain[@]}" 2>&1 ) || rc=$?
    if [ -n "$out" ]; then
        rec_start raw
        rec_set machine "$_group_machine"
        rec_set text "$out"
        note_warn "this machine runs an older wk-tools, which cannot report itself in
      records -- its own listing is above. 'wk remote setup $_group_machine' pushes
      the current tooling."
        rec_emit
    fi
    return "$rc"
}

# --- what a machine is, apart from the workspaces on it -----------------------
# disk, egress, locks, push, capacity, quiesce, bench: each answers a
# question otherwise asked only after something has gone wrong. All local to
# the machine that reports it, so a machine answering for itself answers
# this too, at no probe cost.
report_health() {
    local m="$1" line pid cmd at f n

    # --- the store's disk
    if [ -d "$WK_STORE" ]; then
        # `df` and not `du`: what matters is whether the next build fits,
        # not a walk of the whole store.
        line=$(df -Pk "$WK_STORE" 2>/dev/null | awk 'NR==2 {print $2, $4, $5}')
        rec_start disk
        rec_set machine "$m"
        rec_set store   "$WK_STORE"
        # A macOS host has two stores: the container one inside the podman
        # VM, where builds actually fill a disk, and the host's own.
        rec_opt where "$([ -z "${WK_IN_VM:-}" ] || printf 'in the podman VM')"
        if [ -n "$line" ]; then
            rec_set total_mb "$(( $(printf '%s' "$line" | awk '{print $1}') / 1024 ))"
            rec_set free_mb  "$(( $(printf '%s' "$line" | awk '{print $2}') / 1024 ))"
            rec_set used_pct "$(printf '%s' "$line" | awk '{print $3}' | tr -d '%')"
        fi
        n=$( { ls -1 "$(wk_base_dir)" 2>/dev/null || true; } | wc -l | tr -d ' ')
        rec_set snapshots "$n"
        # What `wk gc` would take.
        n=$( { unreferenced_bases 2>/dev/null || true; } | wc -l | tr -d ' ')
        rec_set reclaimable "$n"
        [ "$n" = 0 ] || note "wk gc would reclaim $n snapshot(s)"
        rec_emit
    fi

    # --- the request broker: the one door out of the sandbox
    # Whether the door is *open* is the socket; what's *in flight* is
    # derived from the process table (`in_flight` in
    # container/broker/wk-broker.py), since a `running` status file is a
    # claim a killed-mid-request broker leaves behind. Only from the
    # machine itself, never inside the podman VM.
    local _bsock _brdir _bn=0 _brid _bst
    if [ -n "${WK_BROKER_SOCKET:-}" ]; then
        _bsock="$WK_BROKER_SOCKET"
    elif [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        _bsock="$XDG_RUNTIME_DIR/wk/broker.sock"
    else
        _bsock="$(wk_state_dir)/broker.sock"
    fi
    _brdir="$(wk_state_dir)/broker"
    # An `if`, not a `return`: everything after -- proxy, locks, push
    # switch, load -- is reported by both halves on purpose.
    if [ -z "${WK_IN_VM:-}" ] && { [ -S "$_bsock" ] || [ -d "$_brdir" ]; }; then
        if [ -d "$_brdir" ]; then
            for _brid in "$_brdir"/*; do
                [ -f "$_brid/status" ] || continue
                [ "$(kv_field "$_brid/status" state)" = running ] || continue
                _bst=$(kv_field "$_brid/status" pid)
                [ -n "$_bst" ] && kill -0 "$_bst" 2>/dev/null || continue
                _bn=$((_bn + 1))
                note "in flight: $(basename "$_brid") -- $(kv_field "$_brid/status" stage)"
            done
        fi
        rec_start service
        rec_set machine "$m"
        rec_set name    "request broker"
        if [ -S "$_bsock" ]; then
            # The count in the state word: a service line is one word wide.
            rec_set state "open ($_bn in flight)"
        else
            rec_set state "closed"
            rec_set fix   "./setup --stage broker   (a workspace cannot ask for a bench run without it)"
        fi
        rec_emit
    fi

    # --- the egress proxy, where there is one to have
    if have systemctl && systemctl --user cat wk-proxy.service >/dev/null 2>&1; then
        rec_start service
        rec_set machine "$m"
        rec_set name    "egress proxy"
        if systemctl --user is-active --quiet wk-proxy.service; then
            rec_set state running
        else
            rec_set state stopped
            rec_set fix   "systemctl --user start wk-proxy   (workspaces have no network without it)"
        fi
        rec_emit
    fi

    # --- the locks this machine is holding right now
    for f in "$(wk_lock_dir)"/*.lock; do
        [ -e "$f" ] || continue
        line=$(readlink "$f" 2>/dev/null || cat "$f/payload" 2>/dev/null || true)
        pid=$(lock_holder_pid "$f")
        cmd=$(printf '%s' "$line" | sed -n 's/.*cmd=\(.*\)$/\1/p')
        at=$(printf '%s' "$line" | sed -n 's/.*at=\([^ ]*\).*/\1/p')
        rec_start lock
        rec_set machine  "$m"
        rec_set resource "$(basename "$f" .lock)"
        rec_opt pid "$pid"
        rec_opt cmd "$cmd"
        rec_opt at  "$at"
        # A lock is not state: it dies with its holder. One whose holder is
        # gone breaks for the next taker -- looks exactly like one held.
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            rec_json alive true
        else
            rec_json alive false
        fi
        rec_emit
    done

    # --- the push switch, in words
    if [ -d "$WK_STORE" ]; then
        local live=0 held=0 absent=0 r
        for r in $(wk_push_forks | awk 'NF {print $1}'); do
            if   [ -f "$WK_STORE/secrets/build_key_$r" ]; then live=$((live + 1))
            elif [ -f "$WK_STORE/push-keys/build_key_$r" ]; then held=$((held + 1))
            else absent=$((absent + 1)); fi
        done
        if [ "$((live + held + absent))" -gt 0 ]; then
            rec_start switch
            rec_set machine "$m"
            rec_set name    "push"
            rec_opt where   "$([ -z "${WK_IN_VM:-}" ] || printf 'in the podman VM')"
            if   [ "$live" -gt 0 ] && [ "$held" = 0 ]; then rec_set state "on"
            elif [ "$live" = 0 ] && [ "$held" -gt 0 ]; then rec_set state "off"
            elif [ "$live" -gt 0 ]; then rec_set state "partly on"
            else rec_set state "no keys"; fi
            rec_set detail "$live live, $held held back, $absent absent"
            rec_emit
        fi
    fi

    # --- capacity: what decides where a build should go
    # host_cores/host_mem_mb/avail_mem_mb (lib/resources.sh) are the same
    # numbers this machine sizes a build from.
    local _cap_cores _cap_mem _cap_free _cap_ok=1
    _cap_cores=$(host_cores 2>/dev/null)   || _cap_ok=""
    _cap_mem=$(host_mem_mb 2>/dev/null)    || _cap_ok=""
    _cap_free=$(avail_mem_mb 2>/dev/null)  || _cap_ok=""
    [ -n "$_cap_cores" ] && [ -n "$_cap_mem" ] && [ -n "$_cap_free" ] || _cap_ok=""
    rec_start capacity
    rec_set machine "$m"
    rec_opt where   "$([ -z "${WK_IN_VM:-}" ] || printf 'the podman VM')"
    if [ -n "$_cap_ok" ]; then
        rec_set cores   "$_cap_cores"
        rec_set mem_mb  "$_cap_mem"
        rec_set free_mb "$_cap_free"
        if [ -r /proc/loadavg ]; then
            rec_set load "$(awk '{print $1}' /proc/loadavg)"
        elif have sysctl; then
            rec_set load "$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')"
        fi
    else
        rec_set note "could not measure cores/memory on $m"
    fi
    rec_emit

    # --- quiesced? the state a benchmark leaves a machine in
    # WK_QUIESCE_STATE: same override cmd/quiesce reads (its own comment,
    # near its STATE=, has why); tests/test_quiesce.py drives it.
    local qs="${WK_QUIESCE_STATE:-$(wk_state_dir)/quiesce}"
    if [ -d "$qs" ]; then
        local bits=""
        [ -f "$qs/caffeinate.pid" ] && bits="${bits}caffeinate "
        [ -f "$qs/daemons_paused" ] && bits="${bits}daemons-paused "
        [ -f "$qs/raiser.pid" ]     && bits="${bits}raiser "
        if [ -n "$bits" ]; then
            rec_start switch
            rec_set machine "$m"
            rec_set name    "quiesce"
            rec_set state   "on"
            rec_set detail  "${bits% }"
            note_warn "this machine is quiesced -- 'wk quiesce off' puts it back"
            rec_emit
        fi
    fi

    # --- benchmark tasks: every one running now, else the newest, with its
    # state recomputed from its runs (lib/wkdata.py task-status) and
    # "running" decided by its lock (lock_alive) -- nothing is read from a
    # record of progress.
    if [ -d "$WK_STORE/bench" ]; then
        local t running="" shown="" newest=""
        for t in "$WK_STORE/bench"/*/task.json; do
            [ -f "$t" ] || continue
            t=$(basename "$(dirname "$t")")
            newest="$t"
            lock_alive "bench-task-$t" && running="$running $t"
        done
        [ -n "$running" ] && shown="$running" || shown="$newest"
        for t in $shown; do
            local alive=() st
            case " $running " in *" $t "*) alive=(--running) ;; esac
            st=$(python3 "$WK_ROOT/lib/wkdata.py" task-status "$WK_STORE/bench/$t" ${alive[@]+"${alive[@]}"} 2>/dev/null) || continue
            rec_start bench
            rec_set machine "$m"
            rec_set task    "$t"
            rec_set path    "$WK_STORE/bench/$t"
            rec_set state   "$(kv_get state <<<"$st")"
            rec_set summary "$(kv_get summary <<<"$st")"
            rec_set subject "$(kv_get subject <<<"$st")"
            [ "$(kv_get state <<<"$st")" != incomplete ] \
                || note_warn "task $t stopped before every planned run ended -- wk bench report $t says what is there"
            rec_emit
        done
    fi
    return 0
}

_tooling_said=""
report_self() {
    local ver sha dirty tree
    [ -z "${WK_EXPECT_TREE:-}" ] || return 0
    # Not twice: on Linux the container target *is* this machine and
    # report_machine already said it; on macOS no walk produces this line.
    [ -z "$_tooling_said" ] || return 0
    _tooling_said=1
    ver=$("$WK_ROOT/cmd/version" 2>/dev/null) || return 0
    sha=$(kv_get sha <<<"$ver")
    dirty=$(kv_get dirty <<<"$ver")
    tree=$(kv_get tree <<<"$ver")
    rec_start fact
    rec_set machine "$(this_machine)"
    rec_set type    wk-tools
    rec_set sha     "$sha"
    rec_json dirty  "$([ "$dirty" = yes ] && printf true || printf false)"
    rec_set tree    "$tree"
    rec_json insync true
    rec_emit
}

# --no-fleet: report the workspaces and nothing else -- for the half of a
# listing assembled by another machine, which asks each machine for its own
# keys and version separately.
#
# --no-devices: the machine facts, but not the fleet's devices and bridges,
# which the podman VM can't reach over ssh even though its own machine
# facts (mounted tooling, store keys) are worth having.
FLEET=1
DEVICES=1
if [ "${1:-}" = --no-fleet ]; then FLEET=""; DEVICES=""; shift; fi

# How this listing is going to be looked at (one walk feeds all of them):
#   web       the page -- what a bare `wk status` means at a terminal
#   text      plain aligned columns -- what it means elsewhere
#   json      the records, merged into one document every other view draws from
#   html      that document as a page, written to a file
#   records   the raw stream, for whoever is assembling a bigger listing
#
# Called here, not substituted into the assignment: inside a substitution,
# "is stdout a terminal" would ask about the pipe's, not this process's.
status_default_mode
MODE="$WK_STATUS_DEFAULT_MODE"
# Whether the view was *asked for* or merely defaulted to -- a default that
# opens a page must not override an explicit flag.
MODE_ASKED=""
RECORDS=""
WEB_PORT="${WK_STATUS_PORT:-0}"
WEB_INTERVAL="${WK_STATUS_INTERVAL:-20}"
HTML_OUT=""

# --wait: block until this workspace is not busy, then report once, by
# polling `wk status` itself; a timeout still reports "busy", not "failed".
WAIT=""
WAIT_TIMEOUT="${WK_WAIT_TIMEOUT:-0}"
_args=""
while [ $# -gt 0 ]; do
    case "$1" in
        --no-fleet)  FLEET=""; DEVICES=""; shift ;;   # also accepted after --wait, not only first
        --no-devices) DEVICES=""; shift ;;
        --records)   RECORDS=1; shift ;;
        --json)      MODE=json; MODE_ASKED=1; shift ;;
        # The table, from a terminal, where a bare invocation opens the
        # page. Named --text, not --no-web: negating a moving default rots.
        --text|--cli) MODE=text; MODE_ASKED=1; shift ;;
        --html)      MODE=html; MODE_ASKED=1
                     case "${2:-}" in -*|"") ;; *) HTML_OUT="$2"; shift ;; esac
                     shift ;;
        --web)       MODE=web; MODE_ASKED=1; shift ;;
        --port)      WEB_PORT="${2:-0}"; shift 2 ;;
        --port=*)    WEB_PORT="${1#*=}"; shift ;;
        --interval)  WEB_INTERVAL="${2:-20}"; shift 2 ;;
        --interval=*) WEB_INTERVAL="${1#*=}"; shift ;;
        --wait)      WAIT=1; shift ;;
        --timeout)   WAIT_TIMEOUT="${2:-0}"; shift 2 ;;
        --timeout=*) WAIT_TIMEOUT="${1#*=}"; shift ;;
        -*)          die "usage: wk status [<workspace>] [--json|--text|--web|--html [<file>]]
    [--wait] [--timeout <s>] [--port <n>] [--interval <s>] [--records]
    [--no-fleet] [--no-devices]; see wk status -h" ;;
        *)           [ -z "$_args" ] || die "usage: wk status [<workspace>]; unexpected argument: $1; see wk status -h"
                     _args="$1"; shift ;;
    esac
done
# shellcheck disable=SC2086 -- deliberate re-splitting of the collected words (at most one).
set -- $_args

# The dispatcher resolves $WK_NAME wherever it can and strips it there;
# what's left in $1 is put back in the one place everything below reads it.
[ -n "${1:-}" ] || set -- ${WK_NAME:+"$WK_NAME"}

# Two shapes of this command are not "look at the fleet", so for both the
# page default is withdrawn: one named workspace (a board with one row is
# worse than the row) and --wait (the line and exit code answer "is it
# finished"; a server blocking until ctrl-c buries both).
if [ -z "$MODE_ASKED" ] && [ "$MODE" = web ] && { [ $# -gt 0 ] || [ -n "$WAIT" ]; }; then
    MODE=text
fi

# Raise the worst-so-far, folded into 0-4. A function, not `[ x -gt y ] &&
# worst=x`, whose AND-OR form returns 1 when false and ends the walk under
# `set -e`. Anything outside 0-4 (raw ssh exit codes from `delegate`) folds
# to 4, never to 0, since a script branching on this reads 0 as "fine".
bump() {
    local v="$1"
    case "$v" in
        ''|*[!0-9]*) v=4 ;;
        *) [ "$v" -le 4 ] || v=4 ;;
    esac
    [ "$v" -gt "$worst" ] && worst="$v"
    return 0
}

# What a *machine* is, as opposed to what a workspace is doing: which
# wk-tools it runs (a stale copy fails as `unknown option`), and which push
# keys it holds (one machine per key is the design).
report_machine() {
    local label="$1" ver keys mine theirs sha dirty note

    if [ "$WK_TARGET_KIND" = remote ] && t_has_wk; then
        ver=$(  { t_wk version          2>/dev/null || true; } | tr -d '\r' )
        keys=$( { t_wk key fingerprints  2>/dev/null || true; } | tr -d '\r' )
    elif [ "$label" = "$(default_target)" ]; then
        _tooling_said=1
        # This machine's own store and tooling: on a macOS host the
        # container store lives in the podman VM, whose own half reports it.
        ver=$("$WK_ROOT/cmd/version"          2>/dev/null || true)
        keys=$("$WK_ROOT/cmd/key" fingerprints 2>/dev/null || true)
    else
        return 0
    fi

    if [ -n "$ver" ]; then
        theirs=$(kv_get tree <<<"$ver")
        sha=$(kv_get sha <<<"$ver")
        dirty=$(kv_get dirty <<<"$ver")
        # Compared against the machine that *pushes* the tooling -- the
        # workstation -- since the podman VM's copy is rsynced from there
        # and would otherwise report "in sync" against its own stale tree.
        # WK_EXPECT_TREE is how the workstation says what it has.
        mine="${WK_EXPECT_TREE:-$("$WK_ROOT/cmd/version" --tree 2>/dev/null || true)}"
        rec_start fact
        rec_set machine "${_group_machine:-$(this_machine)}"
        rec_set type    wk-tools
        rec_opt copy    "$([ -z "${WK_IN_VM:-}" ] || printf 'in the podman VM')"
        rec_set sha     "$sha"
        rec_json dirty  "$([ "$dirty" = yes ] && printf true || printf false)"
        rec_set tree    "$theirs"
        rec_set expect  "$mine"
        rec_json insync "$([ "$theirs" = "$mine" ] && printf true || printf false)"
        # What to type about it differs per machine:
        #
        #   the podman VM   a copy this machine rsyncs in (`wk sync --tools
        #                   container`).
        #   a build box     the same push, by machine name.
        #   a peer          a workstation pulls rather than being pushed to,
        #                   which needs a committed, pushed tree here first.
        if [ "$theirs" != "$mine" ]; then
            if [ -n "${WK_IN_VM:-}" ]; then
                rec_set fix "wk sync --tools container"
            elif [ -n "${WK_REMOTE_PEER:-}" ]; then
                if [ -n "$(git -C "$WK_ROOT" status --porcelain 2>/dev/null)" ]; then
                    rec_set fix "commit and push here first -- a peer pulls, and this checkout is dirty"
                else
                    rec_set fix "wk sync --tools   (pulls on $label, and says so if it still differs)"
                fi
            else
                rec_set fix "wk sync --tools $label"
            fi
        fi
        rec_emit
    fi

    [ -n "$keys" ] || return 0
    # A pipe would run the loop in a subshell, whose fd 3 is only a copy --
    # harmless here, but would break the day this loop accumulated state.
    while read -r line; do
        [ -n "$line" ] || continue
        rec_start fact
        rec_set machine "${_group_machine:-$(this_machine)}"
        rec_set type    key
        rec_set text    "$line"
        rec_emit
    done <<EOF
$keys
EOF
}

# A delegated machine's load and free memory, over the connection t_has_wk
# just opened (memoized, so this costs nothing extra): the capacity half of
# what `delegate --no-fleet` turned off there. Remote's t_mem_mb is
# MemAvailable, not a total, so only load, cores and free are ever printed.
report_capacity_remote() {
    local m="$1" cores load mem
    rec_start capacity
    rec_set machine "$m"
    if cores=$(t_cores 2>/dev/null) && load=$(t_load 2>/dev/null) \
       && mem=$(t_mem_mb 2>/dev/null) \
       && [ -n "$cores" ] && [ -n "$load" ] && [ -n "$mem" ]; then
        rec_set cores   "$cores"
        rec_set load    "$load"
        rec_set free_mb "$mem"
    else
        rec_set note "could not measure load/memory on $m"
    fi
    rec_emit
}

# --- the fleet devices: role, mode, and the media wk owns ---------------------
# One line per fleet machine: what it is (role), what it is running (mode),
# and what's on the hardware wk manages for it (`wk boot <machine>
# --status` is the deep version). Every machine is probed in its own
# subshell, all at once, so no driver's overrides leak into the next one.
#
# The ceiling is the probe's own, not ssh's: `WK_SSH_TIMEOUT` doesn't reach
# a *jump* hop, and a bridge with no known_hosts line can hang asking "are
# you sure" on a terminal nothing here can answer; dotfiles/ssh/config
# bounds that hop instead.
report_fleet_device() {
    local m="$1" cap role
    cap=$(( ${WK_FLEET_TIMEOUT:-4} * 5 ))
    # stdin from /dev/null so nothing down there can read the terminal, and
    # a process group of its own (capped) so the kill reaches ssh too.
    if capped "$cap" _fleet_probe "$m" </dev/null; then return 0; fi
    # A machine dropped for time still gets a line: an omitted one reads as
    # not in the fleet at all. Its role is declared rather than probed, so
    # the column that doesn't depend on the machine answering still doesn't.
    role=$( . "$WK_ROOT/boot/machines.sh"
            machine_load "$m" >/dev/null 2>&1 && printf '%s' "${MACH_ROLE:-workstation}"
            true )
    rec_start fleet
    rec_set machine "$m"
    rec_set role    "${role:-?}"
    rec_set mode    "no answer within ${cap}s"
    rec_set conf    "boot/machines/$m.conf"
    rec_opt tailnet "$(fleet_tailnet "$m")"
    rec_opt direct  "$(reach_without_tailnet "$m")"
    rec_emit
    return 0
}

# A fleet device has a tailnet node per role -- the rescue (MACH_SSH) and the
# bench system (MACH_BENCH_SSH) -- so the reached line names each, or says
# which has never joined.
fleet_tailnet() { # <machine>
    ( . "$WK_ROOT/boot/machines.sh"
      machine_load "$1" >/dev/null 2>&1 || exit 0
      local n a out=""
      for n in "${MACH_SSH:-$1}" "${MACH_BENCH_SSH:-}"; do
          [ -n "$n" ] || continue
          a=$(reach_tailnet "$n")
          out="${out:+$out; }$n ${a:-not a node}"
      done
      printf '%s' "$out" )
}

_fleet_probe() {
    local m="$1" role mode media armed rec reprov
    (
        set +e
        export WK_SSH_TIMEOUT="${WK_FLEET_TIMEOUT:-4}"
        . "$WK_ROOT/lib/image.sh"
        . "$WK_ROOT/image/profiles.sh"
        . "$WK_ROOT/boot/machines.sh"
        machine_load "$m" || exit 0
        load_driver "$MACH_DRIVER" 2>/dev/null || exit 0
        role="${MACH_ROLE:-workstation}"
        if b_probeable 2>/dev/null; then
            b_probe 2>/dev/null
            case "${MODE:-unreachable}" in
                host)    mode="host mode" ;;
                # Told apart from an armed system by the medium the running
                # root is on (b_system_kind), or an unarmed board reads as
                # benchmarkable.
                base*)   mode="base image -- not a bench system" ;;
                bench*)  mode="bench mode" ;;
                # Naming the bridge is the difference between a dead end and
                # a next command: unreachable can mean the board is off, or
                # the whole segment behind the bridge is down.
                *)       mode="unreachable"
                         [ -z "${MACH_BRIDGE:-}" ] \
                             || mode="unreachable via $MACH_BRIDGE" ;;
            esac
            # A record of intent on a machine still in host mode is the one
            # transition worth shouting about here.
            armed=""
            if [ "${MODE:-}" = host ]; then
                rec=$(record_read 2>/dev/null | kv_get image)
                [ -n "$rec" ] && armed="$rec"
            fi
        else
            MODE=""
            mode="unknown from here"
            armed=""
        fi
        media=$(b_media 2>/dev/null || printf 'unknown')
        # How this machine is made again from nothing, asked of its driver
        # (b_reprovision). Every current recipe opens on MACH_PROFILE, so a
        # conf missing it names the field instead of calling into a driver
        # that would print around the hole.
        if [ -z "${MACH_PROFILE:-}" ]; then
            reprov="missing MACH_PROFILE in boot/machines/$m.conf -- nothing to compose a recipe from"
        else
            reprov=$(b_reprovision 2>/dev/null || true)
        fi
        rec_start fleet
        rec_set machine "$m"
        rec_set role    "$role"
        rec_set mode    "$mode"
        rec_set media   "$media"
        rec_opt armed   "$armed"
        rec_set conf    "boot/machines/$m.conf"
        rec_opt tailnet "$(fleet_tailnet "$m")"
        rec_opt direct  "$(reach_without_tailnet "$m")"
        rec_opt reprovision "$reprov"
        rec_emit
    )
}

# The bridges, from the same registry `wk bridge` reads. Here because the
# fleet block should show every machine wk owns, and a bridge phone is one.
#
# bridge_role_sum -- what the role's files are, right now. `bridge/provision.sh`
# installs bin/* and init.d/* byte for byte, so a checksum of both sides
# answers "is this phone running today's role" without a version to keep in step.
bridge_role_sum() {
    # bin first, then init.d, each sorted -- the same order the probe uses
    # on the phone, since the two directories share basenames and "sorted
    # by name" alone is not an order.
    ( cd "$WK_ROOT/bridge" 2>/dev/null || exit 0
      cat $(ls bin/* 2>/dev/null | sort) $(ls init.d/* 2>/dev/null | sort) 2>/dev/null \
        | cksum | awk '{print $1}' )
}

# Stderr-quiet wrapper around _bridge_probe, for par_run: the probe's own
# ssh calls are the noisy half, and report_bridges must not let that spill
# onto the terminal mid-listing.
_bridge_probe_q() { _bridge_probe "$@" 2>/dev/null; }

# One bridge, probed. Bounded and read-only, costs one ssh. "Declared" says
# nothing about whether the segment behind it is up, so it's probed like
# every fleet device, in parallel and under a ceiling.
_bridge_probe() {
    local n="$1" conf="$2" want="$3" out state="" role="" sum="" health="" line="" _bridge_script
    # One round trip for everything. Root first, then a non-interactive
    # doas -- a provisioned bridge has root with the driving key, while an
    # unprovisioned one answers only as `user`. `doas -n` fails cleanly
    # instead of asking for a tty, which a probe with closed stdin needs.
    _bridge_script='
        printf "reachable=yes\n"
        if [ -x /usr/local/sbin/wk-bridge-healthcheck ]; then
            printf "role=yes\n"
            printf "sum=%s\n" "$(cat $(ls /usr/local/sbin/wk-bridge-* 2>/dev/null | sort) \
                $(ls /etc/init.d/wk-bridge-* 2>/dev/null | sort) 2>/dev/null \
                | cksum | cut -d" " -f1)"
            if [ "$(id -u)" = 0 ]; then
                _h=$(/usr/local/sbin/wk-bridge-healthcheck 2>&1); _rc=$?
            elif command -v doas >/dev/null 2>&1; then
                _h=$(doas -n /usr/local/sbin/wk-bridge-healthcheck 2>&1); _rc=$?
            else
                _h=$(sudo -n /usr/local/sbin/wk-bridge-healthcheck 2>&1); _rc=$?
            fi
            printf "health=%s\n" "$_rc"
            printf "healthline=%s\n" "$(printf "%s" "$_h" | grep -v "^[[:space:]]*$" | tail -1)"
        else
            printf "role=no\n"
        fi'
    # A ceiling of its own, larger than a fleet device's: the health check
    # takes several seconds, and a probe killed mid-run loses everything
    # (the remote shell buffers stdout when it's not a tty).
    out=$( capped "${WK_BRIDGE_TIMEOUT:-20}" ssh -o BatchMode=yes -l root \
             -o ConnectTimeout="${WK_FLEET_TIMEOUT:-4}" "$n" "$_bridge_script" 2>/dev/null ) || out=""
    case "$out" in
        reachable=*) ;;
        *) out=$( capped "${WK_BRIDGE_TIMEOUT:-20}" ssh -o BatchMode=yes \
                    -o ConnectTimeout="${WK_FLEET_TIMEOUT:-4}" "$n" "$_bridge_script" \
                    2>/dev/null ) || out="" ;;
    esac

    state=$(kv_get reachable <<<"$out")
    role=$(kv_get role <<<"$out")
    sum=$(kv_get sum <<<"$out")
    health=$(kv_get health <<<"$out")
    line=$(kv_get healthline <<<"$out")

    rec_start bridge
    rec_set name    "$n"
    rec_set device  "$4"
    rec_set segment "$5"
    rec_opt note    "$6"
    rec_set conf    "${conf#$WK_ROOT/}"
    rec_opt tailnet "$(reach_tailnet "$n")"
    rec_opt direct  "$(reach_without_tailnet "$n")"
    if [ "$state" != yes ]; then
        rec_set state "unreachable"
    elif [ "$role" != yes ]; then
        rec_set state "no bridge role"
        note_warn "it answers, and nothing on it is a bridge -- 'wk bridge setup $n' provisions it"
    else
        # A health check that fails is the bridge saying so about itself; the
        # exit status is the verdict and the last line is the reason.
        case "${health:-1}:$line" in
            0:*)   rec_set state "up" ;;
            # Not a verdict about the bridge, but about this end's route to
            # it: the check needs root or a non-interactive doas, and
            # without either the honest answer is that it was not run.
            *doas*|*sudo*|*"not permitted"*|*"Authentication required"*)
                   rec_set state "role installed"
                   note_warn "its health check needs root and this end has no
      non-interactive route to it -- 'wk bridge status $n' can bootstrap one" ;;
            *)     rec_set state "unhealthy" ;;
        esac
        [ -z "$line" ] || rec_set health "$line"
        if [ -n "$sum" ] && [ "$sum" = "$want" ]; then
            rec_json role_insync true
        else
            rec_json role_insync false
            note_warn "the role on it is not this repository's -- 'wk bridge setup $n' re-provisions it"
        fi
    fi
    rec_emit
}

# The bridges, from the same registry `wk bridge` reads, each one asked how
# it is, in parallel: the wall cost is one bounded probe, not one per phone.
report_bridges() {
    local dir f n dev seg note want
    dir="$WK_ROOT/bridge/hosts"
    [ -d "$dir" ] || return 0
    want=$(bridge_role_sum)
    par_begin
    for f in "$dir"/*.conf; do
        [ -f "$f" ] || continue
        n=$(basename "$f" .conf)
        # Read, not sourced: a report has no business executing a conf file
        # to print one line of it.
        dev=$(kv_field "$f" BR_DEVICE)
        seg=$(kv_field "$f" BR_SEGMENT)
        note=$(kv_field "$f" BR_NOTE | sed 's/^"//; s/"$//')
        par_run "$n" _bridge_probe_q "$n" "$f" "$want" "${dev:-?}" "${seg:-?}" "$note"
    done
    par_join
    return 0
}

# Stderr-quiet wrapper around report_fleet_device, for par_run -- see
# _bridge_probe_q above; the same reason applies to a probe of a fleet board.
_fleet_device_q() { report_fleet_device "$@" 2>/dev/null; }

report_fleet_devices() {
    [ -f "$WK_ROOT/boot/machines.sh" ] || return 0
    # Not from inside a workspace: the fleet is the host's, and a sandbox
    # with no network would spend five probe timeouts saying so.
    ! in_workspace || return 0
    local m
    par_begin
    # shellcheck disable=SC1091
    for m in $(. "$WK_ROOT/boot/machines.sh"; machine_list | awk '{print $1}'); do
        par_run "$m" _fleet_device_q "$m"
    done
    par_join
    return 0
}

# The waiting half, before the reporting half: it drives this same command
# and then falls through to print the final row exactly once.
if [ -n "$WAIT" ]; then
    _interval="${WK_WAIT_INTERVAL:-5}"
    _waited=0
    _last=""
    while :; do
        _rc=0
        "$0" --no-fleet ${1:+"$1"} >/dev/null 2>&1 || _rc=$?
        # 2 is the only state worth waiting through; everything else is an answer.
        [ "$_rc" = 2 ] || break
        if [ "$_last" != running ]; then
            info "waiting for${1:+ '$1'} to finish (wk status says busy)"
            _last=running
        fi
        if [ "$WAIT_TIMEOUT" -gt 0 ] && [ "$_waited" -ge "$WAIT_TIMEOUT" ]; then
            warn "still busy after ${WAIT_TIMEOUT}s -- the work continues; this only stopped waiting"
            break
        fi
        sleep "$_interval"
        _waited=$((_waited + _interval))
    done
fi

# This machine's targets before anybody else's, and within a machine the
# container store before the guests, so the one you are typing on comes
# first. `walk_targets`'s own answer order is not this.
order_targets() {
    local t
    for t in "$@"; do
        case "$(target_kind "$t" 2>/dev/null)" in
            container) printf '0 %s\n' "$t" ;;
            vm)        printf '1 %s\n' "$t" ;;
            local)     printf '2 %s\n' "$t" ;;
            *)         printf '3 %s\n' "$t" ;;
        esac
    done | sort -k1,1 -k2,2 | awk '{print $2}'
}

# Which target reports this machine's own health, decided before the walk
# forks: on Linux the container and vm targets are both this machine, so
# whichever gets there first in a parallel walk isn't a decision. The rule:
# the first target, in walk order, that doesn't delegate and whose
# workspaces are here.
health_owner() {
    local t
    for t in $(order_targets "$@"); do
        case "$(target_kind "$t" 2>/dev/null)" in
            remote) ( load_target "$t" >/dev/null 2>&1
                      [ -n "${WK_REMOTE_LOCAL:-}" ] ) || continue ;;
        esac
        printf '%s\n' "$t"
        return 0
    done
    return 0
}

# One target's workspaces, as records, under the machine and method they
# belong to. The two group fields travel in globals because `report` is
# called per workspace from three places.
_group_machine=""
_group_method=""
_health_owner=""
report_target() {
    local t="$1" rc=0 ws
    _group_machine="$(machine_of "$t")"
    _group_method="$(method_of)"
    machine_seen "$_group_machine"

    if t_has_wk; then
        # The machine answers for itself, in the same records -- see
        # delegate() for the older-copy fallback.
        WK_ROW_LABEL="$t" WK_NO_DELEGATE=1 \
            delegate status --no-fleet --records || rc=$?
        bump "$rc"
        if [ -n "$FLEET" ]; then
            report_machine "$t"
            report_capacity_remote "$_group_machine"
        fi
        return 0
    fi

    if [ -n "${2:-}" ]; then
        report "$2"
    else
        # One workspace's row costs one exec into the container or guest
        # that holds it (report_ws: origin, dirty, unpushed, drift). Those
        # execs share nothing, so run them in parallel.
        par_begin
        for ws in $(target_workspaces); do par_run "$ws" _report_ws_par "$ws"; done
        par_join
    fi
    if [ -n "$FLEET" ]; then
        report_machine "$t"
        # This machine's own tooling belongs to this machine, and the walk
        # is the only place that knows we are on it.
        if [ "$_group_machine" = "$(this_machine)" ] && [ "$t" = "$_health_owner" ]; then
            report_self
            report_health "$_group_machine"
        fi
    fi
    return 0
}

# One workspace, in a process of its own. Its verdict crosses back as the
# job's status (lib/par.sh).
_report_ws_par() { report "$1"; return "$worst"; }

# One target, likewise -- and the driver is loaded *in here*: a driver
# overrides shell functions, so the first driver's t_branch answering for
# the second target's workspaces would be a wrong answer that looks
# entirely plausible.
_report_target_par() {
    local t="$1"
    load_target "$t"
    report_target "$t"
    return "$worst"
}

# The fleet devices and the bridges, as one more par_run job in collect()'s
# batch (see the comment there for why they run together).
_devices_par() {
    report_fleet_devices
    report_bridges
    return "$worst"
}

# --- collection, and then whoever is looking at it ----------------------------
# The walk is a function so that every mode runs the *same* walk: a
# terminal, a browser and `--json` differ only in what they do with fd 3.
collect() {
    if [ -n "${1:-}" ]; then
        # In a workspace a bare `wk status` is the whole command: there is
        # one workspace and it is this machine.
        require_name "$1"
        TARGET="$(ws_target "$1")"
        load_target "$TARGET"
        # One workspace was asked about, so the machine's tooling and keys
        # -- the fleet block's -- are not the question.
        FLEET=""
        report_target "$TARGET" "$1"
    else
        _TARGETS=$(walk_targets)

        # Every machine asked at once, before the first record is written;
        # the walk below finds them already answered (prefetch_targets).
        # shellcheck disable=SC2086 -- deliberate word splitting of the target list.
        prefetch_targets $_TARGETS
        wk_atexit prefetch_done

        # The boards and the phones are one more job in the same batch as
        # the targets, so they stream in wherever they finish, sharing
        # nothing with the target walk. They run inside that one job
        # together, in step, because a bridged board is reached *through*
        # the same phone the bridge block ssh's into.
        #
        # Started after the prefetch, not beside it: the two contend for the
        # resolver, and a wedged one serialises lookups a warm one answers
        # instantly.

        # shellcheck disable=SC2086 -- deliberate word splitting of the target list.
        _health_owner=$(health_owner $_TARGETS)

        # shellcheck disable=SC2086 -- same, and order_targets takes them as words.
        par_begin
        for TARGET in $(order_targets $_TARGETS); do
            # A placeholder a streaming reader can show while this one is
            # still in flight, named for the target -- for a remote one
            # *is* the machine name, so the real block answers to the same.
            printf '{"kind":"probing","name":"%s","machine":"%s"}\n' \
                "$(_jesc "$TARGET")" "$(_jesc "$(machine_of_target "$TARGET")")" >&3
            par_run "$TARGET" _report_target_par "$TARGET"
        done
        if [ -n "$DEVICES" ]; then
            par_run devices _devices_par
        fi
        par_join_stream
    fi

    # The exit status, in the stream: this command's whole contract for a
    # script, and a listing assembled from two machines' records has to
    # carry the worst of them rather than the last.
    rec_start exit
    rec_json code "$worst"
    rec_emit
}

# `--records`: the stream itself, for whoever is assembling a bigger listing
# -- the other half of a macOS run (bare_report in `wk`), or the machine
# that asked this one to answer for itself. Renders nothing.
if [ -n "$RECORDS" ]; then
    exec 3>&1
    collect ${1:+"$1"}
    exit "$worst"
fi

# Everything else renders. json/html/web want the whole listing before they
# say anything; the text renderer starts on whatever has landed so far
# (lib/status-view.py's streaming reader). Both read the same record stream
# -- the difference is only in when each chooses to draw.
#
# A fifo instead of a plain file makes that possible without a second
# collection path: `collect` keeps running in the background, since a fifo
# open for writing blocks until something is reading it.
_recs_dir=$(mktemp -d "${TMPDIR:-/tmp}/wk-status.XXXXXX")
_recs="$_recs_dir/records"
mkfifo "$_recs"
_recs_cleanup() { rm -rf "$_recs_dir"; }
wk_atexit _recs_cleanup

( # A fork's atexit state is a copy of this process's, so this subshell's
  # own exit also runs `_recs_cleanup` and removes the fifo's directory
  # entry before the parent, still reading it, has finished. Harmless: an
  # unlink while a reader still has the fifo open does not disturb it.
  exec 3> "$_recs"
  collect ${1:+"$1"}
  exit "$worst"
) </dev/null &
_collect_pid=$!

# The port, interval and output path travel as environment, not arguments,
# because `wk` renders too (bare_report) without having parsed them.
WK_STATUS_PORT="$WEB_PORT" WK_STATUS_INTERVAL="$WEB_INTERVAL" \
    WK_STATUS_HTML_OUT="$HTML_OUT" status_render "$MODE" "$_recs"

# `collect` ran in its own subshell (mandatory for the fifo above not to
# deadlock this one waiting on a reader), so its `worst` comes back the
# only way a subshell can: its own exit status.
rc=0; wait "$_collect_pid" || rc=$?
bump "$rc"
exit "$worst"
