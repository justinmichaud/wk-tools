#!/usr/bin/env python3
#
# wk status [<workspace>] -- what is happening, without guessing
# wk: where=workspace name=optional here readonly group=workspaces
# wk: opts --no-fleet,--no-devices,--records,--json,--text,--cli,--html=,--web,--port=,--interval=,--wait,--timeout=,--holds=
#
# The build records its own state, not a process list, and this reads it.
#
# Exit status is meaningful, so a script or an agent can branch on it:
#   0  idle or last build succeeded
#   1  last build failed
#   2  a build is running or silent, or a workspace is still being created
#      (`silent`: the record says running and the log has said nothing for
#      WK_STALL_SECONDS. A full-LTO link is silent for minutes, so this is
#      busy and `--wait` waits through it, as far as the `abort_after` the
#      build recorded)
#   3  a build stalled and was killed by its own watchdog
#   4  a workspace needs a person: a creation whose driver is gone, a build
#      silent past its own `abort_after` (its watchdog would have written
#      `stalled` there, so the watchdog is gone too), an environment removed
#      from under the record, or a machine that will not answer (3 is a build
#      whose watchdog reported; 4 is a workspace whose record no longer has a
#      writer -- don't conflate them). Also what a fleet walk reports for an
#      unreachable peer, and a workspace that did not answer about its job's
#      pid within WK_TASK_ASK_SECONDS (default 5): `unanswered`.
#
#   wk status --holds device:rpi5    the live tasks in this machine's store
#                                    holding that resource, one per line, for
#                                    the machine asking. A board is a fleet
#                                    resource, and this is the half of the
#                                    answer this machine owns.
#
# At a terminal, with nothing else said, this opens the page (`--web`).
# Anything else (a pipe, CI, an agent) gets the plain table; `--text` asks
# for the table anyway.
#
#   --no-fleet    the workspaces alone, for the half of a listing another
#                 machine assembles; --no-devices keeps the machine facts and
#                 drops the boards and bridges
#   --records     the records alone, one JSON object per line, rendered by
#                 the wk that asked
#   --wait        block while busy (exit 2) and report once; --timeout stops
#                 waiting without claiming the work stopped
#
#   WK_WAIT_TIMEOUT=<s>     default for --timeout when --wait is given with
#                           none (0, the default, waits forever)
#   WK_WAIT_INTERVAL=<s>    how often --wait polls (default 5)
#   WK_FLEET_TIMEOUT=<s>    ceiling on one fleet-device probe (default 4)
#   WK_BRIDGE_TIMEOUT=<s>   ceiling on one bridge-phone health check
#                           (default 20; slower than a fleet probe on purpose)
#   WK_STATUS_PORT, WK_STATUS_INTERVAL   --web's defaults (0: any free port; 20s)

import json
import os
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import shell, statusview  # noqa: E402
from wk.act import Refused, die, info, warn  # noqa: E402
from wk.clock import Clock  # noqa: E402
from wk.record import Records  # noqa: E402
from wk.status import Walk, wait_until_idle  # noqa: E402


def value(argv, flag):
    i = argv.index(flag) + 1
    return argv[i] if i < len(argv) else ""


def holders(resource):
    records = Records(ask_target=lambda n, pid, cap: shell.target_pid_alive(ROOT, n, pid, cap))
    for row in records.holders(resource):
        print("\t".join(row))
    return 0


def main(argv):
    env = os.environ
    no_fleet = "--no-fleet" in argv
    no_devices = "--no-devices" in argv
    devices = not (no_fleet or no_devices)
    mode, asked = statusview.default_mode(env, sys.stdout.isatty()), False
    if "--json" in argv:
        mode, asked = "json", True
    if "--text" in argv or "--cli" in argv:
        mode, asked = "text", True
    html_out = ""
    if "--html" in argv:
        mode, asked = "html", True
        html_out = value(argv, "--html")
        html_out = "" if html_out == "-" else html_out
    if "--web" in argv:
        mode, asked = "web", True
    port = value(argv, "--port") if "--port" in argv else env.get("WK_STATUS_PORT", "0")
    interval = value(argv, "--interval") if "--interval" in argv else env.get("WK_STATUS_INTERVAL", "20")
    if "--holds" in argv:
        return holders(value(argv, "--holds"))
    name = env.get("WK_NAME") or None
    wait = "--wait" in argv
    if not asked and mode == "web" and (name or wait):
        mode = "text"
    if wait:
        timeout = int((value(argv, "--timeout") if "--timeout" in argv else env.get("WK_WAIT_TIMEOUT", "0")) or 0)
        wait_until_idle(lambda: Walk(ROOT, name=name, fleet=False, devices=False).worst_only(), timeout,
                        float(env.get("WK_WAIT_INTERVAL", "5")), Clock(), name, info, warn)
    walk = Walk(ROOT, name=name, fleet=not no_fleet, devices=devices)
    if "--records" in argv:
        for r in walk.records(markers=False):
            print(statusview.dumps(r))
        return walk.worst
    if mode == "text":
        statusview.render_text_stream(walk.records(), sys.stdout, statusview.colour_wanted())
        return walk.worst
    doc = statusview.merge(walk.records())
    if mode == "json":
        json.dump(doc, sys.stdout, indent=2)
        sys.stdout.write("\n")
    elif mode == "html":
        print(statusview.write_page(doc, html_out))
    elif mode == "web":
        rc = statusview.serve(ROOT, doc, port, interval)
        if rc:
            return rc
    else:
        die("'%s' is not a view: --text, --json, --html or --web" % mode)
    return walk.worst


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except LookupError as e:
        sys.stderr.write("error: %s\n" % e)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
