#!/usr/bin/env bash
#
# wk status [<workspace>] -- what is happening, without guessing
# wk: where=workspace name=optional bare=merged readonly group=workspaces
#
# The build records its own state (not a process list -- `pgrep -f ninja`
# matches itself, and a healthy build between phases runs no compiler) and
# this reads it.
#
# Exit status is meaningful, so a script or an agent can branch on it:
#   0  idle or last build succeeded
#   1  last build failed
#   2  a build is running, or a workspace is still being created
#   3  a build stalled and was killed
#   4  a workspace needs a person: a creation whose driver is gone, an
#      environment removed from under the record, or a machine that will not
#      answer (3 is a build to re-run; 4 is a workspace to repair -- don't
#      conflate them). Also what a fleet walk reports for an unreachable peer.
#
# At a terminal, with nothing else said, this opens the page (`--web`) -- a
# fleet is a thing to look at. Anything else (a pipe, CI, an agent) gets the
# plain table, since stdout there is read and the exit code branched on;
# `--text` asks for the table anyway. One function, status_default_mode in
# lib/common.sh, decides this so a macOS host (which renders elsewhere) and
# here cannot disagree.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/detach.sh"
. "$WK_ROOT/lib/reach.sh"
. "$WK_ROOT/lib/resources.sh"

worst=0

# --- the record stream --------------------------------------------------------
# Three audiences (a terminal, a browser, `--json`) can only agree if the
# gathering has one output none of them is. So everything below emits
# *records*, one JSON object per line, and rendering is somebody else's job
# (lib/status-view.py) -- a number in the terminal but not the browser becomes
# impossible rather than merely unlikely.
#
# JSON Lines, not one document: a macOS listing is assembled by two processes
# (this machine's targets out here, its containers inside the podman VM), and
# two JSON documents can't be concatenated where two line streams can. The
# renderer merges by machine name.
#
# A machine that answers for itself is asked for the same stream; an older
# copy that's never heard of the flag has its text captured into a `raw`
# record instead, so a stale build box still appears, in its own words.
#
# Records go to fd 3, not stdout: the drivers this calls log to stderr, and
# the collector half must write records while the renderer half owns stdout.

# JSON string escaping, in the shell, because the shell is what has the values.
# Only the five things that can appear here: a backslash, a quote, and the three
# control characters a branch name, a log line or a path can carry.
_jesc() {
    local s="$1"
    # Colour first: a health check on a phone prints ANSI sequences, and a raw
    # ESC in a JSON string is unescapable -- `json.loads` rejects the whole
    # record, so the one bridge that answers is the one that disappears.
    # Walked, not pattern-substituted: a glob can't say "digits and semicolons
    # until an m" without eating the whole line, and no extglob -- `wk` runs
    # under macOS's bash 3.2, and a shopt toggled in a helper is uninvited.
    local head tail
    while [ "${s#*$'\033'}" != "$s" ]; do
        head=${s%%$'\033'*}
        tail=${s#*$'\033'}
        tail=${tail#\[}
        # The shortest prefix up to the first `m` -- a CSI colour sequence and
        # nothing beyond it. A sequence with no `m` at all leaves `tail` as it
        # was, and dropping the ESC alone still ends the loop.
        case "$tail" in *m*) tail=${tail#*m} ;; esac
        s="$head$tail"
    done
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\t'/\\t}
    s=${s//$'\r'/}
    printf '%s' "$s"
}

_rec=""
_notes=""

# A record under construction. `_notes` is reset with it, because a note is
# always about the record being built -- a warning belongs to the workspace it
# is about, not to whatever is emitted next.
rec_start() { _rec="{\"kind\":\"$1\""; _notes=""; }
rec_set()   { _rec="$_rec,\"$1\":\"$(_jesc "${2:-}")\""; }
# Only when there is something to say. An empty string and an absent field mean
# different things to a renderer, and most of these fields are simply absent.
rec_opt()   { [ -n "${2:-}" ] && rec_set "$1" "$2" || return 0; }
rec_json()  { _rec="$_rec,\"$1\":$2"; }
rec_emit()  {
    [ -z "$_notes" ] || rec_json notes "[$_notes]"
    printf '%s}\n' "$_rec" >&3
    _rec=""; _notes=""
}

note()      { _notes="$_notes${_notes:+,}{\"level\":\"info\",\"text\":\"$(_jesc "$*")\"}"; }
note_warn() { _notes="$_notes${_notes:+,}{\"level\":\"warn\",\"text\":\"$(_jesc "$*")\"}"; }

# The sub-states of one workspace -- its build, its tests, its babysitter --
# collected as they are found and emitted with it. Rows of their own with the
# identity columns blanked would be a table's way of saying "the same
# workspace" and a renderer's way of saying nothing at all.
_subs=""
sub_add() { _subs="$_subs${_subs:+,}$1"; }

# --- several probes at once, without shuffling the listing --------------------
# A listing is almost entirely waiting (an ssh timeout, a container round
# trip, a board's own ceiling), and done serially that is the *sum* of every
# wait rather than the longest one. The fleet-device and bridge blocks were
# already shaped this way; everything else was not.
#
# Four things make the shape safe, each a way it has gone wrong:
#
#   a file per writer   fd 3 is a byte stream; two writers on one descriptor
#                       interleave mid-line into an unparseable record.
#   a fixed order       the parent concatenates in start order, not finish
#                       order -- a reshuffling listing can't be read at a glance.
#   the worst status    a subshell can't raise the parent's `worst`; each
#                       carries its own out as its exit status via `wait <pid>`.
#   stdin from /dev/null   several ssh at once must not compete for a terminal,
#                       or a background job reading one is stopped by SIGTTIN.
#
# `wait` is always by pid, never bare: a bare `wait` would also wait for the
# fleet probes deliberately left running beside the walk.
_par_dir=""
_par_names=""
_par_pids=""

par_begin() {
    _par_dir=$(mktemp -d "${TMPDIR:-/tmp}/wk-status.XXXXXX")
    _par_names=""
    _par_pids=""
}

# par_run <name> <command...> -- <name> is both the file and the position in the
# finished listing, so it must be unique among the batch. Target and workspace
# names are (valid_name, lib/common.sh), which is why they are what is used.
#
# Each job also drops a marker (`$n.rc`, its exit status) the instant it's
# done -- par_join ignores it (name order is still what it wants), but
# par_join_stream polls for it, which is what lets that one hand a finished
# job's records to fd 3 without waiting on the jobs still running beside it.
par_run() {
    local n="$1"; shift
    ( "$@" 3> "$_par_dir/$n"; _rc=$?
      printf '%s' "$_rc" > "$_par_dir/$n.rc"
      exit "$_rc" ) </dev/null &
    _par_names="$_par_names $n"
    _par_pids="$_par_pids $!"
}

par_join() {
    local n p rc
    for p in $_par_pids; do rc=0; wait "$p" || rc=$?; bump "$rc"; done
    for n in $_par_names; do cat "$_par_dir/$n" >&3 2>/dev/null || true; done
    rm -rf "$_par_dir"
    _par_dir=""; _par_names=""; _par_pids=""
    return 0
}

# par_join_stream -- the same batch, but a job's records reach fd 3 the moment
# that job finishes, in the order jobs actually complete rather than the order
# they were started in -- so a slow one in the middle of the batch no longer
# holds back everything started after it. A `{"kind":"flush"}` record follows
# each job's records: the signal a streaming reader (lib/status-view.py's text
# renderer) uses to know a batch just landed and it is safe to draw whatever
# has accumulated so far.
#
# Polled, not `wait -n` -- this shell is bash 3.2 on a macOS host, which has no
# such builtin, and every board and build box runs whatever bash it has. The
# `.rc` marker par_run now drops is the portable stand-in; a tenth of a second
# between checks is nothing next to an ssh round trip.
par_join_stream() {
    local n p rc pending="$_par_names" next
    while [ -n "$pending" ]; do
        next=""
        for n in $pending; do
            if [ -f "$_par_dir/$n.rc" ]; then
                rc=$(cat "$_par_dir/$n.rc" 2>/dev/null); rc="${rc:-4}"
                bump "$rc"
                cat "$_par_dir/$n" >&3 2>/dev/null || true
                printf '{"kind":"flush"}\n' >&3
            else
                next="$next $n"
            fi
        done
        pending="$next"
        [ -z "$pending" ] || sleep 0.1
    done
    for p in $_par_pids; do wait "$p" 2>/dev/null || true; done
    rm -rf "$_par_dir"
    _par_dir=""; _par_names=""; _par_pids=""
    return 0
}

# --- which machine, and what kind of thing on it ------------------------------
#
# Two questions that were squashed into one `moose:container` column: where the
# workspace is, and how it was made. They are separate fields now, and the
# renderers group by the first and then the second.
#
# WK_ROW_LABEL is the name the asking machine knows this one by. A machine
# answering for itself cannot know what to call itself in somebody else's
# listing -- and inside the podman VM `hostname` answers `localhost`, which is
# not a name anybody out here can use.
this_machine() { printf '%s' "${WK_ROW_LABEL:-$(wk_machine_name)}"; }

# Whether these records are about the machine the person is sitting at. Not
# derivable from the name: a delegated `wk status` on moose is told to call
# itself moose, and so is the podman VM told to call itself the Mac it runs in.
# Only the caller knows which of them is home (WK_HOST_SELF).
_is_self() { [ -n "${WK_HOST_SELF:-}" ] || [ -z "${WK_ROW_LABEL:-}" ]; }

# The method a target makes workspaces by, in the word a person would use for
# it: a podman container, a macOS guest, or the machine itself.
method_of() {
    case "$WK_TARGET_KIND" in
        container) echo container ;;
        vm)        echo "macOS guest" ;;
        *)         echo native ;;
    esac
}

# The machine a target's workspaces are on. A remote target *is* a machine and
# is named by the name this device calls it; everything else is here.
#
# `t_ssh_host ""` failing is the remote driver saying "this is the machine I am"
# -- the local mode a shared build box's own `wk status` runs in -- and then the
# answer is this machine, not a second name for it.
machine_of() {
    if [ "$WK_TARGET_KIND" = remote ] && t_ssh_host "" >/dev/null 2>&1; then
        printf '%s' "$1"
    else
        this_machine
    fi
}

# One record per machine, so a machine with nothing on it still appears. "This
# machine, and nothing on it" is an answer, and it is the one that says the
# podman machine is stopped rather than that the workspaces are gone.
_machines_said=" "
machine_seen() {
    local m="$1"
    case "$_machines_said" in *" $m "*) return 0 ;; esac
    _machines_said="$_machines_said$m "
    rec_start machine
    rec_set name "$m"
    if [ "$m" = "$(this_machine)" ] && _is_self; then
        rec_json self true
    else
        # How to get there, computed rather than remembered (lib/reach.sh): the
        # tailnet's own answer, and the best path there is without it. A machine
        # this device is *sitting on* needs neither.
        rec_opt tailnet "$(reach_tailnet "$m")"
        rec_opt direct  "$(reach_without_tailnet "$m")"
    fi
    # Which file said this machine exists -- the registry in this repository,
    # which every device gets by pulling. Relative to the checkout: a path under
    # this repository is a file anybody reading this can open, and the absolute
    # form is one machine's layout rather than the fact.
    _conf=""
    _c=$(target_registry_conf "$m")
    [ -f "$_c" ] && _conf="${_c#$WK_ROOT/}"
    rec_opt conf "$_conf"
    rec_emit
}

# One record per workspace: what it is, and everything it has been asked to do.
# The build, the tests and the babysitter belong to it rather than being rows of
# their own with the identity columns blanked -- which is a table's way of saying
# "still the same workspace" and means nothing to a renderer that is not a table.
report() {
    local ws="$1"
    _subs=""
    rec_start workspace
    rec_set machine "$_group_machine"
    rec_set method  "$_group_method"
    rec_set name    "$ws"
    report_ws "$ws"
    report_claude_rc "$ws"
    report_one "$ws" build "$(wk_ws_dir "$ws")/build.status"
    [ -f "$(wk_ws_dir "$ws")/test.status" ] && report_one "$ws" test "$(wk_ws_dir "$ws")/test.status"
    [ -f "$(wk_ws_dir "$ws")/babysit.status" ] && report_babysit "$(wk_ws_dir "$ws")/babysit.status"
    rec_json subs "[$_subs]"
    rec_emit
    return 0
}

# Claude Code remote-control (`wk claude <ws> --rc`), if this workspace has
# ever had one: its own status file, next to build.status/test.status
# (cmd/status's rc_status_file, lib/detach.sh's schema: pid=, state=,
# updated=). Nothing when the file is absent -- most workspaces have never
# run `--rc`, and that is not a fact worth a line.
#
# The pid it names is not this host's own process table's to answer for: it
# is a process `t_spawn` started *inside* the target, so liveness is asked
# through `t_exec`, never a local `kill -0` -- the same move image/yocto.sh's
# yocto_running makes for a driven pid, for the same reason.
report_claude_rc() {
    local ws="$1" sf pid
    sf="$(wk_ws_dir "$ws")/claude-rc.status"
    [ -f "$sf" ] || return 0
    pid=$(status_field "$sf" pid)
    [ -n "$pid" ] || return 0
    if t_exec "$ws" kill -0 "$pid" >/dev/null 2>&1; then
        note "claude rc: alive (pid $pid)"
    else
        note "claude rc: stopped"
    fi
}

# The lifecycle line, first above everything else: "is this a workspace at
# all" comes before "how did its last build go", and for three of the five
# states everything under it is about a workspace that isn't there.
#
# Every word is derived at read time (ws_state in lib/target.sh) except one:
# whether the process claiming to create this is still alive, which is not on
# disk -- the difference between "being made" and "was, when the ssh dropped".
report_ws() {
    local ws="$1" st disp sf stage pid upd
    st=$(ws_state "$ws")
    sf=$(ws_status_file "$ws")

    # `present` is the only state where the environment's own word adds
    # anything (running, exited, present); for the rest it *is* the answer, and
    # asking the driver a second time would cost a probe to be told what we
    # already know.
    if [ "$st" = present ]; then disp=$(t_info "$ws"); else disp="$st"; fi

    rec_set state  "$disp"
    rec_set ws     "$st"
    rec_opt branch "$(t_branch "$ws")"

    # What is *in* this workspace, in one exec: answers a question asked
    # before something destructive (wipe-over-repair, `wk rm` and remake) --
    # commits that exist nowhere else, a dirty tree, drift from upstream.
    #
    # One exec: each is a container round trip, already paid for the origin
    # check alone (in a WebKit checkout: status -uno ~520ms, ls-files ~400ms,
    # the two rev-lists ~50ms).
    #
    # A wrong `origin` is worth a line here, not only in `wk remotes`: it's
    # silent, it changes what `git log origin/main` means, and it's how a
    # push goes somewhere nobody intended.
    if [ "$st" = present ]; then
        _probe=$(t_exec "$ws" sh -c "cd $(sh_quote "$(t_src "$ws")") 2>/dev/null || exit 0
            printf 'origin=%s\n' \"\$(git config --get remote.origin.url 2>/dev/null)\"
            printf 'dirty=%s\n' \"\$(git status --porcelain --untracked-files=no 2>/dev/null | wc -l | tr -d ' ')\"
            printf 'untracked=%s\n' \"\$(git ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')\"
            printf 'unpushed=%s\n' \"\$(git rev-list --count HEAD --not --remotes 2>/dev/null)\"
            _u=\$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || _u=origin/main
            printf 'upstream=%s\n' \"\$_u\"
            set -- \$(git rev-list --left-right --count \"\$_u...HEAD\" 2>/dev/null)
            printf 'behind=%s\nahead=%s\n' \"\${1:-}\" \"\${2:-}\"" 2>/dev/null | tr -d '\r') || _probe=""

        _origin=$(kv_get origin <<<"$_probe")
        case "$_origin" in
            ''|https://github.com/WebKit/WebKit.git) ;;
            *) note_warn "origin is $_origin, not upstream -- 'wk remotes $ws --fix'" ;;
        esac

        for _f in dirty untracked unpushed upstream behind ahead; do
            _v=$(kv_get "$_f" <<<"$_probe")
            case "$_f:$_v" in
                *:|*:0) continue ;;   # zero is the ordinary state, and saying so is noise
            esac
            rec_set "$_f" "$_v"
        done
    fi

    # Which snapshot this workspace is standing on, and how far behind the
    # current one it is. This is the honest explanation of why a `wk sync` did
    # not change anything underneath it: the lower layer is pinned at creation
    # and only a new workspace gets a new one.
    _base=$(ws_base_id "$ws" 2>/dev/null) || _base=""
    if [ -n "$_base" ]; then
        rec_set base "$_base"
        _cur=$(current_base 2>/dev/null) || _cur=""
        if [ -n "$_cur" ] && [ "$_cur" != "$_base" ]; then
            # Counted rather than dated: "three snapshots old" is the thing that
            # decides whether to remake it; the timestamp is in the id already.
            _newer=$( { ls -1 "$(wk_base_dir)" 2>/dev/null || true; } \
                      | awk -v b="$_base" '$0 > b' | wc -l | tr -d ' ')
            rec_set base_behind "$_newer"
        fi
    fi

    stage=$(status_field "$sf" stage)
    pid=$(status_field "$sf" pid)
    upd=$(status_field "$sf" updated)

    case "$st" in
    creating)
        if detach_alive "$sf"; then
            note "creating: ${stage:-?} (pid $pid, alive${upd:+, said so $upd})"
            note "follow:   tail -f $(ws_create_log "$ws")"
            bump 2
        else
            note_warn "creation never finished, and nothing is creating it now${pid:+ (pid $pid is gone)}"
            [ -z "$stage" ] || note "it got as far as: $stage${upd:+ ($upd)}"
            note "usually there is nothing in one worth keeping -- remake it:"
            note "  $(ws_remake_hint "$ws")"
            note "or, if the checkout is complete and only the marker is missing,"
            note "any command that gates on it takes --force"
            bump 4
        fi
        ;;
    broken)
        note_warn "the record says a $TARGET workspace and the machine has none --
      something outside wk removed it (podman rm, tart delete, an rm -rf over there)"
        note "clear the record:  wk rm $ws"
        [ -d "$(wk_ws_dir "$ws")" ] && \
            note "what is left of it here: $(wk_ws_dir "$ws")"
        bump 4
        ;;
    unreachable)
        note_warn "the machine behind '$TARGET' did not answer within ${WK_SSH_TIMEOUT:-10}s"
        note "this is not 'absent': nothing about the workspace was checked at all,"
        note "and anything below is the last thing this machine wrote about it"
        bump 4
        ;;
    esac
    return 0
}

# The babysitter's line. Unlike a build, it has a pid of its own on this host
# -- the detached loop -- so liveness is the process, not the age of a log: a
# state that claims to be running with a dead pid is a crash, and saying
# "fixing" about it would be the status file's word against the process table.
report_babysit() {
    local f="$1" state config model attempt max pid report
    state=$(awk -F= '/^state=/{print $2}' "$f")
    config=$(awk -F= '/^config=/{print $2}' "$f")
    model=$(awk -F= '/^model=/{print $2}' "$f")
    attempt=$(awk -F= '/^attempt=/{print $2}' "$f")
    max=$(awk -F= '/^max=/{print $2}' "$f")
    pid=$(awk -F= '/^pid=/{print $2}' "$f")
    report=$(awk -F= '/^report=/{print $2}' "$f")

    local sub="{\"kind\":\"babysit\",\"state\":\"$(_jesc "${state:-none}")\""
    [ -n "$config" ] && sub="$sub,\"config\":\"$(_jesc "$config")\",\"model\":\"$(_jesc "$model")\",\"attempt\":\"$(_jesc "$attempt")\",\"max\":\"$(_jesc "$max")\""
    sub_add "$sub}"

    case "$state" in
    starting|building|fixing)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            note "alive: pid $pid -- follow: tail -f $(dirname "$f")/babysit.log"
            bump 2
        else
            note_warn "the babysitter died without writing an outcome -- see $(dirname "$f")/babysit.log"
            bump 1
        fi
        ;;
    gave-up|error|stalled)
        note_warn "report: $report"
        bump 1
        ;;
    ok)
        [ "${attempt:-0}" -gt 0 ] 2>/dev/null && note "fixed $attempt time(s); report: $report"
        ;;
    esac
}

report_one() {
    local ws="$1" kind="$2" status_file="$3"
    local state=none config="" arch="" secs="" rc="" logf=""

    local peak=""
    if [ -f "$status_file" ]; then
        # shellcheck disable=SC1090
        state=$(awk -F= '/^state=/{print $2}' "$status_file")
        peak=$(awk -F= '/^peak_mb=/{print $2}' "$status_file")
        config=$(awk -F= '/^config=/{print $2}' "$status_file")
        # Recorded per build rather than read from the workspace now: what
        # matters here is the architecture the build in question was made with,
        # and for a build predating --arch the field is simply absent.
        arch=$(awk -F= '/^arch=/{print $2}' "$status_file")
        secs=$(awk -F= '/^seconds=/{print $2}' "$status_file")
        rc=$(awk -F= '/^exit=/{print $2}' "$status_file")
        logf=$(awk -F= '/^log=/{print $2}' "$status_file")
    fi

    # A 'running' status file is a claim, not a fact: the build may have been
    # killed with -9, leaving the word behind for good. build_live (lib/detach.sh)
    # is the one place that turns the claim into evidence, from the age of the
    # log, and it runs before the JSON record is built -- so a build the
    # evidence contradicts is reported as 'stalled' everywhere at once: the
    # exit code (below), the record a renderer classifies (lib/status-view.py),
    # and the note a person reads. Nothing downstream ever sees the bare word
    # "running" without having checked it.
    local age=""
    if [ "$state" = running ]; then
        # log_age and the threshold are lib/detach.sh's, so `wk bench`'s
        # preflight and this report answer "is it running" the same way.
        [ -f "$logf" ] && age=$(log_age "$logf")
        build_live "$status_file" "$logf" || state=stalled
    fi

    case "$arch" in native) arch="" ;; esac
    local sub="{\"kind\":\"$kind\",\"state\":\"$(_jesc "${state:-none}")\""
    [ -n "$config" ] && sub="$sub,\"config\":\"$(_jesc "$config")\""
    [ -n "$arch" ]   && sub="$sub,\"arch\":\"$(_jesc "$arch")\""
    [ -n "$secs" ]   && sub="$sub,\"seconds\":$secs"
    [ -n "$peak" ]   && sub="$sub,\"peak_mb\":$peak"
    [ -n "$rc" ]     && sub="$sub,\"exit\":\"$(_jesc "$rc")\""
    sub_add "$sub}"

    case "$state" in
    running)
        [ -f "$logf" ] && note "alive: $(_progress_line "$logf" || echo 'running') (last output ${age}s ago)"
        [ "$worst" -lt 2 ] && worst=2
        ;;
    failed)
        note_warn "exit $rc"
        while IFS= read -r _l; do note "  $_l"; done < <(first_error "$logf" 2>/dev/null || true)
        [ "$worst" -lt 1 ] && worst=1
        ;;
    stalled)
        if [ -n "$age" ]; then
            # Derived from a 'running' record the log's age contradicted,
            # rather than written by the watchdog itself (cmd/build:551) --
            # the same outcome, so the same note, with the evidence attached.
            # Captured into notes rather than printed: it is lib/watchdog's
            # own diagnostic, shared with the build that kills a stall, and
            # it writes as it goes -- which in a buffered listing would put
            # it above the row it is about.
            note_warn "no log output for ${age}s -- likely stalled or killed"
            while IFS= read -r _l; do note "$_l"; done \
                < <(_stall_report "$logf" "$age" 2>&1)
        else
            note_warn "killed after no output; see $logf"
        fi
        worst=3
        ;;
    # The memory watchdog's verdict, kept distinct from a build that merely
    # failed: the fix is a job count or a per-job working set, not the code.
    oom)
        note_warn "killed for memory${peak:+ (peak ${peak}MB)}; see $logf"
        _lim=$(grep -a 'wk: MEMORY LIMIT' "$logf" 2>/dev/null | tail -1 | sed 's/^wk: //') || true
        [ -z "${_lim:-}" ] || note "  $_lim"
        worst=3
        ;;
    esac

    # The peak is a field of the build now (`peak_mb` above), so every renderer
    # shows it next to the build it belongs to rather than as a line underneath.
}

# One named workspace resolves to its own target; the bare listing walks
# every target there is. Loading one target and reporting through it would
# silently report vm workspaces as absent, since the container driver has
# never heard of them. A target that's a machine of its own answers for itself.
#
# Not politeness: the build state that matters lives over there -- a build
# started from a shell on that machine is otherwise a confident `build=none`
# about work running in front of you. The exit status is the answer too,
# since this command's whole contract is that a script can branch on it.
delegate() {
    local rc=0 out a
    local -a args=() plain=()
    for a in "$@"; do
        args+=("$a")
        [ "$a" = --records ] || plain+=("$a")
    done

    # Records first, and captured rather than streamed, because what comes back
    # has to be judged before it is passed on.
    out=$( t_wk "${args[@]}" 2>/dev/null ) || rc=$?
    case "$out" in
        "{"*) printf '%s\n' "$out" >&3; return "$rc" ;;
    esac

    # A machine running an older copy of this repository has never heard of
    # `--records` and rejects it as a workspace name -- so it is asked again in
    # the vocabulary it has, and its own listing is carried as one `raw` record.
    # The machine still appears, in its own words, instead of vanishing from a
    # listing that would look complete without it. Two round trips, and only to
    # a stale machine: `wk remote setup <machine>` ends it.
    #
    # Version skew is not an edge case here (t_wk in targets/remote.sh): a peer
    # runs a git checkout of its own, and a build box runs whatever was last
    # rsynced to it.
    rc=0
    out=$( t_wk "${plain[@]}" 2>&1 ) || rc=$?
    if [ -n "$out" ]; then
        rec_start raw
        rec_set machine "$_group_machine"
        rec_set text "$out"
        note_warn "this machine runs an older wk-tools, which cannot report itself in
      records -- its own listing is above. 'wk remote setup $_group_machine' pushes
      the current tooling."
        rec_emit
    fi
    return "$rc"
}

# This machine's own tooling, once, when this machine is the one driving --
# on a macOS host it's the one line no target walk produces, since the store
# and tooling copies live elsewhere. Everything else in the fleet block is
# compared against it.
# --- what a machine is, apart from the workspaces on it -----------------------
# Answers questions otherwise asked only after something has gone wrong:
#
#   disk      a full store kills a 39 GB build in a way that reads as a
#             compiler error.
#   egress    a down proxy fails every workspace's network, looking from in
#             here like a hundred unrelated fetch errors.
#   locks     "waiting for the store lock" names no holder unless this does.
#   push      the switch is global; its state was otherwise unreadable.
#   capacity  what decides where to send a build.
#   quiesce   whether this machine is pretending to be a measurement
#             instrument -- worth knowing before starting work on it.
#   bench     a run with no result yet is a machine not to touch.
#
# All local to the machine that reports it (a `df`, a directory listing, a
# file test), so a machine answering for itself answers this too, at no
# probe cost.
report_health() {
    local m="$1" line pid cmd at f n

    # --- the store's disk
    if [ -d "$WK_STORE" ]; then
        # -P for the portable single-line format, -k so the numbers mean the
        # same thing on both platforms. `df` and not `du`: what matters is
        # whether the next build fits, and walking a 200 GB store to find that
        # out would cost more than the build.
        line=$(df -Pk "$WK_STORE" 2>/dev/null | awk 'NR==2 {print $2, $4, $5}')
        rec_start disk
        rec_set machine "$m"
        rec_set store   "$WK_STORE"
        # Which store, when a machine has two: on a macOS host the container
        # store is inside the podman VM (and is where builds actually fill a
        # disk), while the host's own holds the guests' state, the Tart images
        # and the VM's disk image. Both fill up, for different reasons, and a
        # single number labelled "disk" would be answering about whichever half
        # happened to report last.
        rec_opt where "$([ -z "${WK_IN_VM:-}" ] || printf 'in the podman VM')"
        if [ -n "$line" ]; then
            rec_set total_mb "$(( $(printf '%s' "$line" | awk '{print $1}') / 1024 ))"
            rec_set free_mb  "$(( $(printf '%s' "$line" | awk '{print $2}') / 1024 ))"
            rec_set used_pct "$(printf '%s' "$line" | awk '{print $3}' | tr -d '%')"
        fi
        n=$( { ls -1 "$(wk_base_dir)" 2>/dev/null || true; } | wc -l | tr -d ' ')
        rec_set snapshots "$n"
        # What `wk gc` would take. `unreferenced_bases` refuses to answer while a
        # workspace has no recorded base, which is the honest answer there too.
        n=$( { unreferenced_bases 2>/dev/null || true; } | wc -l | tr -d ' ')
        rec_set reclaimable "$n"
        [ "$n" = 0 ] || note "wk gc would reclaim $n snapshot(s)"
        rec_emit
    fi

    # --- the request broker: the one door out of the sandbox
    # Two facts, asked differently: whether the door is *open* is the socket
    # (a service active without one serves nobody), and what's *in flight* is
    # derived from the process table the way the broker itself does it
    # (`in_flight` in container/broker/wk-broker.py) -- a `running` status
    # file is a claim, and a broker killed mid-request leaves one behind.
    #
    # Only from the machine itself, never inside the podman VM: the broker is
    # the *workstation's* door, unlike the disk and push switch, which this
    # machine genuinely has two of.
    local _bsock _brdir _bn=0 _brid _bst
    # Resolved the way the broker itself resolves it (socket_path in
    # container/broker/wk-broker.py): the runtime directory when there is
    # one, else the state directory on macOS -- guessing here would report
    # the door closed while it's open two feet away.
    if [ -n "${WK_BROKER_SOCKET:-}" ]; then
        _bsock="$WK_BROKER_SOCKET"
    elif [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        _bsock="$XDG_RUNTIME_DIR/wk/broker.sock"
    else
        _bsock="$(wk_state_dir)/broker.sock"
    fi
    _brdir="$(wk_state_dir)/broker"
    # An `if` around this block and not a `return`: everything after it -- the
    # proxy, the locks, the push switch, the load -- is reported by both halves
    # on purpose, and returning early took the podman VM's half of all of it
    # away along with the broker line.
    if [ -z "${WK_IN_VM:-}" ] && { [ -S "$_bsock" ] || [ -d "$_brdir" ]; }; then
        if [ -d "$_brdir" ]; then
            for _brid in "$_brdir"/*; do
                [ -f "$_brid/status" ] || continue
                [ "$(kv_field "$_brid/status" state)" = running ] || continue
                _bst=$(kv_field "$_brid/status" pid)
                [ -n "$_bst" ] && kill -0 "$_bst" 2>/dev/null || continue
                _bn=$((_bn + 1))
                note "in flight: $(basename "$_brid") -- $(kv_field "$_brid/status" stage)"
            done
        fi
        rec_start service
        rec_set machine "$m"
        rec_set name    "request broker"
        if [ -S "$_bsock" ]; then
            # The count in the state word rather than beside it: a service line
            # is one word wide in both renderers, and "open" alone answers a
            # narrower question than the one being asked.
            rec_set state "open ($_bn in flight)"
        else
            rec_set state "closed"
            rec_set fix   "./setup --stage broker   (a workspace cannot ask for a bench run without it)"
        fi
        rec_emit
    fi

    # --- the egress proxy, where there is one to have
    if have systemctl && systemctl --user cat wk-proxy.service >/dev/null 2>&1; then
        rec_start service
        rec_set machine "$m"
        rec_set name    "egress proxy"
        if systemctl --user is-active --quiet wk-proxy.service; then
            rec_set state running
        else
            rec_set state stopped
            rec_set fix   "systemctl --user start wk-proxy   (workspaces have no network without it)"
        fi
        rec_emit
    fi

    # --- the locks this machine is holding right now
    for f in "$(wk_lock_dir)"/*.lock; do
        [ -e "$f" ] || continue
        line=$(readlink "$f" 2>/dev/null || cat "$f/payload" 2>/dev/null || true)
        pid=$(printf '%s' "$line" | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p')
        cmd=$(printf '%s' "$line" | sed -n 's/.*cmd=\(.*\)$/\1/p')
        at=$(printf '%s' "$line" | sed -n 's/.*at=\([^ ]*\).*/\1/p')
        rec_start lock
        rec_set machine  "$m"
        rec_set resource "$(basename "$f" .lock)"
        rec_opt pid "$pid"
        rec_opt cmd "$cmd"
        rec_opt at  "$at"
        # A lock is not state: it dies with its holder. One whose holder is gone
        # is therefore not a lock at all, and the next taker breaks it -- which
        # is worth saying, because it looks exactly like a lock that is held.
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            rec_json alive true
        else
            rec_json alive false
        fi
        rec_emit
    done

    # --- the push switch, in words
    if [ -d "$WK_STORE" ]; then
        local live=0 held=0 absent=0 r
        for r in $(wk_push_forks | awk 'NF {print $1}'); do
            if   [ -f "$WK_STORE/secrets/build_key_$r" ]; then live=$((live + 1))
            elif [ -f "$WK_STORE/push-keys/build_key_$r" ]; then held=$((held + 1))
            else absent=$((absent + 1)); fi
        done
        if [ "$((live + held + absent))" -gt 0 ]; then
            rec_start switch
            rec_set machine "$m"
            rec_set name    "push"
            rec_opt where   "$([ -z "${WK_IN_VM:-}" ] || printf 'in the podman VM')"
            if   [ "$live" -gt 0 ] && [ "$held" = 0 ]; then rec_set state "on"
            elif [ "$live" = 0 ] && [ "$held" -gt 0 ]; then rec_set state "off"
            elif [ "$live" -gt 0 ]; then rec_set state "partly on"
            else rec_set state "no keys"; fi
            rec_set detail "$live live, $held held back, $absent absent"
            rec_emit
        fi
    fi

    # --- capacity: what decides where a build should go
    #
    # host_cores/host_mem_mb/avail_mem_mb (lib/resources.sh) are the same
    # numbers this machine sizes a build from, so a mismatch between what
    # `wk status` shows and what `wk build` actually did is impossible by
    # construction. A probe that fails says so in a note rather than leaving
    # a blank a renderer could mistake for zero (CLAUDE.md: never make data up).
    local _cap_cores _cap_mem _cap_free _cap_ok=1
    _cap_cores=$(host_cores 2>/dev/null)   || _cap_ok=""
    _cap_mem=$(host_mem_mb 2>/dev/null)    || _cap_ok=""
    _cap_free=$(avail_mem_mb 2>/dev/null)  || _cap_ok=""
    [ -n "$_cap_cores" ] && [ -n "$_cap_mem" ] && [ -n "$_cap_free" ] || _cap_ok=""
    rec_start capacity
    rec_set machine "$m"
    rec_opt where   "$([ -z "${WK_IN_VM:-}" ] || printf 'the podman VM')"
    if [ -n "$_cap_ok" ]; then
        rec_set cores   "$_cap_cores"
        rec_set mem_mb  "$_cap_mem"
        rec_set free_mb "$_cap_free"
        if [ -r /proc/loadavg ]; then
            rec_set load "$(awk '{print $1}' /proc/loadavg)"
        elif have sysctl; then
            rec_set load "$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')"
        fi
    else
        rec_set note "could not measure cores/memory on $m"
    fi
    rec_emit

    # --- quiesced? the state a benchmark leaves a machine in
    local qs="${WK_QUIESCE_STATE:-$(wk_state_dir)/quiesce}"
    if [ -d "$qs" ]; then
        local bits=""
        [ -f "$qs/caffeinate.pid" ] && bits="${bits}caffeinate "
        [ -f "$qs/daemons_paused" ] && bits="${bits}daemons-paused "
        [ -f "$qs/raiser.pid" ]     && bits="${bits}raiser "
        if [ -n "$bits" ]; then
            rec_start switch
            rec_set machine "$m"
            rec_set name    "quiesce"
            rec_set state   "on"
            rec_set detail  "${bits% }"
            note_warn "this machine is quiesced -- 'wk quiesce off' puts it back"
            rec_emit
        fi
    fi

    # --- the newest benchmark run, and whether it finished
    if [ -d "$WK_STORE/bench" ]; then
        local newest
        newest=$( { ls -1 "$WK_STORE/bench" 2>/dev/null || true; } | sort | tail -1)
        if [ -n "$newest" ]; then
            rec_start bench
            rec_set machine "$m"
            rec_set run     "$newest"
            # env.json is written when a run starts and result.json when it
            # produces a number, so a run with the first and not the second is
            # either happening now or died -- and either way it is a machine not
            # to touch.
            if [ -f "$WK_STORE/bench/$newest/result.json" ]; then
                rec_set state "finished"
            elif [ -f "$WK_STORE/bench/$newest/env.json" ]; then
                rec_set state "no result"
                note_warn "the newest run has no result.json -- it is either running now or it died"
            else
                rec_set state "empty"
            fi
            rec_emit
        fi
    fi
    return 0
}

_tooling_said=""
report_self() {
    local ver sha dirty tree
    [ -z "${WK_EXPECT_TREE:-}" ] || return 0
    # Not twice. On a Linux workstation the container target *is* this machine,
    # so report_machine has already said it; on a macOS host no target walk
    # produces this line at all, which is what this is for.
    [ -z "$_tooling_said" ] || return 0
    _tooling_said=1
    ver=$("$WK_ROOT/cmd/version" 2>/dev/null) || return 0
    sha=$(kv_get sha <<<"$ver")
    dirty=$(kv_get dirty <<<"$ver")
    tree=$(kv_get tree <<<"$ver")
    rec_start fact
    rec_set machine "$(this_machine)"
    rec_set type    wk-tools
    rec_set sha     "$sha"
    rec_json dirty  "$([ "$dirty" = yes ] && printf true || printf false)"
    rec_set tree    "$tree"
    rec_json insync true
    rec_emit
}

# --no-fleet: report the workspaces and nothing else, for the half of a
# listing assembled by another machine -- it asks each machine for its own
# keys and version, so a delegated status printing its own would double them.
#
# --no-devices: the machine facts, but not the fleet's devices and bridges.
# Those are reached over ssh from the machine a person sits at; the podman VM
# can see none of them (asked anyway, it printed "unknown from here" for
# every board), but its own machine facts (mounted tooling, store keys) are
# worth having -- hence a second flag rather than reusing --no-fleet.
FLEET=1
DEVICES=1
if [ "${1:-}" = --no-fleet ]; then FLEET=""; DEVICES=""; shift; fi

# How this listing is going to be looked at. One walk feeds all of them
# (`collect` at the bottom); this only decides where the records go afterwards.
#
#   web       the page, served and refreshed -- what a bare `wk status` means
#             at a terminal (status_default_mode, lib/common.sh)
#   text      plain aligned columns; what a bare `wk status` means elsewhere,
#             and what `--text` asks for from a terminal
#   json      the records, merged into one document every other view draws
#             from, so they cannot disagree
#   html      that document as a page, written to a file
#   records   the raw stream, for whoever is assembling a bigger listing
#
# Called here, not substituted into the assignment: it asks whether *this*
# stdout is a terminal, and inside a substitution that's the pipe's.
status_default_mode
MODE="$WK_STATUS_DEFAULT_MODE"
# Whether the view was *asked for* or merely defaulted to. Two things below
# override a default that would open a page and must not override a flag: one
# named workspace, and --wait.
MODE_ASKED=""
RECORDS=""
WEB_PORT="${WK_STATUS_PORT:-0}"
WEB_INTERVAL="${WK_STATUS_INTERVAL:-20}"
HTML_OUT=""

# --wait: block until this workspace is not busy, then report once.
# A pid is not a fact here (a build can be driven from either end of an ssh),
# and a log is a second copy of `build.status`, so this polls `wk status`
# itself -- and a timeout still reports "busy" rather than "failed".
WAIT=""
WAIT_TIMEOUT="${WK_WAIT_TIMEOUT:-0}"
_args=""
while [ $# -gt 0 ]; do
    case "$1" in
        --no-fleet)  FLEET=""; DEVICES=""; shift ;;   # also accepted after --wait, not only first
        --no-devices) DEVICES=""; shift ;;
        --records)   RECORDS=1; shift ;;
        --json)      MODE=json; MODE_ASKED=1; shift ;;
        # The table, from a terminal, where a bare invocation would open the
        # page. Named for what it is rather than --no-web: a flag whose name is
        # a negation of a default is a flag that has to be re-read every time
        # the default moves.
        --text|--cli) MODE=text; MODE_ASKED=1; shift ;;
        --html)      MODE=html; MODE_ASKED=1
                     case "${2:-}" in -*|"") ;; *) HTML_OUT="$2"; shift ;; esac
                     shift ;;
        --web)       MODE=web; MODE_ASKED=1; shift ;;
        --port)      WEB_PORT="${2:-0}"; shift 2 ;;
        --port=*)    WEB_PORT="${1#*=}"; shift ;;
        --interval)  WEB_INTERVAL="${2:-20}"; shift 2 ;;
        --interval=*) WEB_INTERVAL="${1#*=}"; shift ;;
        --wait)      WAIT=1; shift ;;
        --timeout)   WAIT_TIMEOUT="${2:-0}"; shift 2 ;;
        --timeout=*) WAIT_TIMEOUT="${1#*=}"; shift ;;
        *)           _args="$_args $1"; shift ;;
    esac
done
# shellcheck disable=SC2086 -- deliberate re-splitting of the collected words.
set -- $_args

# The dispatcher resolves $WK_NAME wherever it can (inside a workspace always,
# on a host naming one that exists) and strips it there. What's left in $1 is
# only a name that arrived some other way; everything below still reads the
# workspace name as $1, so it's put back in that one place.
[ -n "${1:-}" ] || set -- ${WK_NAME:+"$WK_NAME"}

# Two shapes of this command are not "look at the fleet", so for both the
# page default is withdrawn:
#
#   one named workspace   a board with one row is worse than the row, and it
#                         arrives differently by target (a container one is
#                         answered inside the podman VM, with no browser).
#   --wait                the question is "is it finished" -- the line and
#                         exit code answer it; a server blocking until ctrl-c
#                         buries both.
if [ -z "$MODE_ASKED" ] && [ "$MODE" = web ] && { [ $# -gt 0 ] || [ -n "$WAIT" ]; }; then
    MODE=text
fi

# The heading says the machine and the method separately, not squashed into
# one `moose:container` column. WK_ROW_LABEL travels as an environment
# variable, not a flag, since the far side may be an older wk-tools checkout
# (t_wk in targets/remote.sh) -- same mechanism `wk ls` uses for its column.

# Raise the worst-so-far, folded into the documented 0-4. A function rather
# than `[ x -gt y ] && worst=x`: that form is the last command of an AND-OR
# list and returns 1 when false, which under `set -e` would end the walk on
# the second target reporting the same state.
#
# `delegate` feeds this raw ssh exit codes (255 on a dropped connection, a
# signal's leftover) rather than this command's 0-4, so anything outside that
# range folds to 4 -- "a machine that will not answer" already names this
# case. Never folded to 0: a script branching on this reads 0 as "fine".
bump() {
    local v="$1"
    case "$v" in
        ''|*[!0-9]*) v=4 ;;
        *) [ "$v" -le 4 ] || v=4 ;;
    esac
    [ "$v" -gt "$worst" ] && worst="$v"
    return 0
}

# What a *machine* is, as opposed to what a workspace is doing: which
# wk-tools it runs, and which push keys it holds.
#
# The keys because one machine per key is the design (GitHub takes many
# deploy keys, each revocable on its own), manageable only if something
# lists them side by side. The version because every machine runs a *copy*
# of this repository, and a stale one fails as `unknown option` from a
# command that works fine where it was typed.
#
# The machine that holds the thing is the machine that answers: a
# fingerprint or tree hash read elsewhere would be a copy of a fact.
# Read-only throughout -- public keys, a hash of files on disk.
report_machine() {
    local label="$1" ver keys mine theirs sha dirty note

    if [ "$WK_TARGET_KIND" = remote ] && t_has_wk; then
        ver=$(  { t_wk version          2>/dev/null || true; } | tr -d '\r' )
        keys=$( { t_wk key fingerprints  2>/dev/null || true; } | tr -d '\r' )
    elif [ "$label" = "$(default_target)" ]; then
        _tooling_said=1
        # This machine's own store and its own tooling. Not every target names
        # a machine we can read: on a macOS host the container store lives in
        # the podman VM, and the VM's own half of this listing reports it.
        ver=$("$WK_ROOT/cmd/version"          2>/dev/null || true)
        keys=$("$WK_ROOT/cmd/key" fingerprints 2>/dev/null || true)
    else
        return 0
    fi

    if [ -n "$ver" ]; then
        theirs=$(kv_get tree <<<"$ver")
        sha=$(kv_get sha <<<"$ver")
        dirty=$(kv_get dirty <<<"$ver")
        # Compared against the machine that *pushes* the tooling, which is the
        # workstation -- not against whichever half of the listing happens to
        # be printing. The podman VM's own copy is rsynced from there, so a VM
        # comparing itself with itself would report "in sync" about a tree
        # that is a week behind the machine it came from. WK_EXPECT_TREE is
        # how the workstation says what it has; unset means this is the
        # workstation.
        mine="${WK_EXPECT_TREE:-$("$WK_ROOT/cmd/version" --tree 2>/dev/null || true)}"
        # Which copy, when it is not the machine's own checkout: inside the
        # podman VM this is the tree every container bind-mounts, and it belongs
        # to the same machine as the host's checkout -- two copies of one
        # repository on one machine, which is exactly the thing that goes stale
        # unnoticed. The `copy` field says so on purpose, rather than leaving
        # it to be inferred from a label.
        rec_start fact
        # The machine, not the target: `container` is how this device *reaches*
        # a machine's workspaces, and a fact about a copy of wk-tools belongs to
        # the machine that holds it -- otherwise the listing grows a machine
        # called "container" with nothing on it.
        rec_set machine "${_group_machine:-$(this_machine)}"
        rec_set type    wk-tools
        rec_opt copy    "$([ -z "${WK_IN_VM:-}" ] || printf 'in the podman VM')"
        rec_set sha     "$sha"
        rec_json dirty  "$([ "$dirty" = yes ] && printf true || printf false)"
        rec_set tree    "$theirs"
        rec_set expect  "$mine"
        rec_json insync "$([ "$theirs" = "$mine" ] && printf true || printf false)"
        # And what to type about it -- "push it there" names no command, and
        # the answer differs per machine:
        #
        #   the podman VM   a copy this machine rsyncs in (`wk sync --target
        #                   container`, which also refreshes the containers'
        #                   egress policy).
        #   a build box     the same push, by machine name.
        #   a peer          a workstation runs its own checkout and nothing
        #                   pushes to it -- it pulls, which needs a committed,
        #                   pushed tree here first, or the pull is a no-op.
        if [ "$theirs" != "$mine" ]; then
            if [ -n "${WK_IN_VM:-}" ]; then
                rec_set fix "wk sync --target container"
            elif [ -n "${WK_REMOTE_PEER:-}" ]; then
                if [ -n "$(git -C "$WK_ROOT" status --porcelain 2>/dev/null)" ]; then
                    rec_set fix "commit and push here first -- a peer pulls, and this checkout is dirty"
                else
                    rec_set fix "wk sync --tools   (pulls on $label, and says so if it still differs)"
                fi
            else
                rec_set fix "wk sync --target $label"
            fi
        fi
        rec_emit
    fi

    [ -n "$keys" ] || return 0
    # A pipe would run the loop in a subshell, and a record emitted there goes
    # to a copy of this shell's fd 3 -- which works, and would stop working the
    # day anything here accumulated state.
    while read -r line; do
        [ -n "$line" ] || continue
        rec_start fact
        rec_set machine "${_group_machine:-$(this_machine)}"
        rec_set type    key
        rec_set text    "$line"
        rec_emit
    done <<EOF
$keys
EOF
}

# A delegated machine's load and free memory, over the connection t_has_wk
# just opened: t_load/t_cores/t_mem_mb (lib/target.sh, targets/remote.sh)
# memoize the probe per process, so this costs nothing beyond what t_has_wk
# already paid for.
#
# `delegate` asks the far side with --no-fleet, which turns off its own
# report_health there (report_health's capacity block is gated on $FLEET) --
# on purpose, since that call also turns off the fleet-device and bridge
# walk that machine cannot see. This is the other half of it, asked from
# here instead, the same way report_machine already asks for its version
# and keys rather than trusting what the far side said about itself.
#
# Remote's t_mem_mb is MemAvailable, not a total (_remote_probe_try,
# targets/remote.sh) -- there is no "total" to report for a machine reached
# this way, so only load, cores and free are ever printed for one. A probe
# that fails (the machine stopped answering between t_has_wk and here) says
# so in a note rather than a blank a renderer could read as zero.
report_capacity_remote() {
    local m="$1" cores load mem
    rec_start capacity
    rec_set machine "$m"
    if cores=$(t_cores 2>/dev/null) && load=$(t_load 2>/dev/null) \
       && mem=$(t_mem_mb 2>/dev/null) \
       && [ -n "$cores" ] && [ -n "$load" ] && [ -n "$mem" ]; then
        rec_set cores   "$cores"
        rec_set load    "$load"
        rec_set free_mb "$mem"
    else
        rec_set note "could not measure load/memory on $m"
    fi
    rec_emit
}

# --- the fleet devices: role, mode, and the media wk owns ---------------------
# One line per fleet machine: what it is (role), what it is running (mode),
# and what's on the hardware wk manages for it (the rpi4's USB stick, the
# Mac's bench volume). `wk help` is the prose version; `wk boot
# <machine> --status` is the deep one.
#
# Every machine is probed in its own subshell, all at once: one bounded
# probe instead of one per machine, and no driver's overrides can leak into
# the next machine's answers. A short timeout of its own, since these are
# LAN neighbours and a powered-off board should cost seconds, not the ssh
# default.
#
# The ceiling is the probe's own, not ssh's: `WK_SSH_TIMEOUT` bounds one TCP
# connect, not a driver making four, and it doesn't reach a *jump* hop at all
# -- ssh command-line options aren't passed to the ProxyJump child. A bridge
# whose tailnet name has no known_hosts line can make that hop ask "are you
# sure" on a terminal nothing in this block's budget can answer, which stops
# `wk status` outright.
#
# dotfiles/ssh/config bounds that hop, since a jump host reads only its own
# stanza. `capped` is here because a probe that overruns loses its line, not
# the listing.
report_fleet_device() {
    local m="$1" cap role
    cap=$(( ${WK_FLEET_TIMEOUT:-4} * 5 ))
    # stdin from /dev/null so nothing down there can read the terminal, and a
    # process group of its own (capped, lib/common.sh) so the kill reaches the
    # ssh and not only the subshell that started it.
    if capped "$cap" _fleet_probe "$m" </dev/null; then return 0; fi
    # A machine dropped for time still gets a line. An omitted one reads as a
    # machine that is not in the fleet, which is the single thing this block
    # exists to be able to say it is. Its role is declared rather than probed,
    # so the column that does not depend on the machine answering still does not.
    role=$( . "$WK_ROOT/boot/machines.sh"
            machine_load "$m" >/dev/null 2>&1 && printf '%s' "${MACH_ROLE:-workstation}"
            true )
    rec_start fleet
    rec_set machine "$m"
    rec_set role    "${role:-?}"
    rec_set mode    "no answer within ${cap}s"
    rec_set conf    "boot/machines/$m.conf"
    rec_opt tailnet "$(reach_tailnet "$m")"
    rec_opt direct  "$(reach_without_tailnet "$m")"
    rec_emit
    return 0
}

_fleet_probe() {
    local m="$1" role mode media armed rec reprov
    (
        set +e
        export WK_SSH_TIMEOUT="${WK_FLEET_TIMEOUT:-4}"
        . "$WK_ROOT/lib/image.sh"
        . "$WK_ROOT/image/profiles.sh"
        . "$WK_ROOT/boot/machines.sh"
        machine_load "$m" || exit 0
        load_driver "$MACH_DRIVER" 2>/dev/null || exit 0
        role="${MACH_ROLE:-workstation}"
        if b_probeable 2>/dev/null; then
            b_probe 2>/dev/null
            case "${MODE:-unreachable}" in
                host)    mode="host mode" ;;
                # The base image the board falls back to, told apart from a
                # system somebody armed by the medium the running root is on
                # (b_system_kind, boot/machines.sh). Reading it as "bench
                # mode" is how an unarmed board gets benchmarked.
                base*)   mode="base image -- not a bench system" ;;
                bench*)  mode="bench mode" ;;
                # Which bridge, when there is one. A board behind a phone's USB
                # ethernet is unreachable for two very different reasons -- the
                # board is off, or the segment it lives on does not exist right
                # now -- and the second takes every board on that cable down
                # together. Naming the bridge is the whole difference between a
                # dead end and a next command; `wk bridge status` is the one
                # that pays an ssh to answer it, and this block deliberately
                # does not (see report_bridges).
                *)       mode="unreachable"
                         [ -z "${MACH_BRIDGE:-}" ] \
                             || mode="unreachable via $MACH_BRIDGE" ;;
            esac
            # A record of intent on a machine still in host mode is the one
            # transition worth shouting about here (the spent/unspent nuance
            # is `wk boot --status`'s).
            armed=""
            if [ "${MODE:-}" = host ]; then
                rec=$(record_read 2>/dev/null | kv_get image)
                [ -n "$rec" ] && armed="$rec"
            fi
        else
            MODE=""
            mode="unknown from here"
            armed=""
        fi
        media=$(b_media 2>/dev/null || printf 'unknown')
        # How this machine is made again from nothing, asked of its driver
        # rather than kept anywhere: each lane composes its own steps from the
        # fields the conf already declares (b_reprovision, boot/<driver>.sh).
        # A driver with none contributes no line, which is the honest answer for
        # a lane whose recipe nobody has written yet.
        #
        # Every current driver's recipe opens on the profile (MACH_PROFILE,
        # boot/machines.sh's own field list): a conf missing it has nothing to
        # compose a command from, and inventing one would be exactly the made-up
        # data CLAUDE.md refuses -- so the line names the missing field instead
        # of calling into a driver that would print around the hole.
        if [ -z "${MACH_PROFILE:-}" ]; then
            reprov="missing MACH_PROFILE in boot/machines/$m.conf -- nothing to compose a recipe from"
        else
            reprov=$(b_reprovision 2>/dev/null || true)
        fi
        rec_start fleet
        rec_set machine "$m"
        rec_set role    "$role"
        rec_set mode    "$mode"
        rec_set media   "$media"
        rec_opt armed   "$armed"
        rec_set conf    "boot/machines/$m.conf"
        rec_opt tailnet "$(reach_tailnet "$m")"
        rec_opt direct  "$(reach_without_tailnet "$m")"
        rec_opt reprovision "$reprov"
        rec_emit
    )
}

# The bridges, from the same registry `wk bridge` reads.
#
# Here because the fleet block should show every machine wk owns, and a
# bridge phone is one: this repo defines, provisions and depends on it, so
# it belongs where a person looks, not only where `wk bridge ls` does.
# CLAUDE.md's cattle rule puts a bridge in `bridge/hosts/<name>.conf` rather
# than `boot/machines/` (it's not a machine `wk boot` drives into a bench
# system) -- but "enumerated somewhere" and "visible where a person looks"
# are different claims.
#
# bridge_role_sum -- what the role's files are, in this repository, right now.
# `bridge/provision.sh` installs bin/* and init.d/* byte for byte, so a
# checksum of both sides answers "is this phone running today's role"
# without a version number to keep in step -- the same trick `wk status`
# plays with wk-tools' tree hash, since a stamp somebody has to remember to
# bump is a stamp that lies.
bridge_role_sum() {
    # bin first, then init.d, each sorted -- the same order the probe uses on
    # the phone. A checksum only answers the question if both sides concatenate
    # the same bytes in the same order, and the two directories share basenames
    # (wk-bridge-camera is both a script and a service), so "sorted by name"
    # alone is not an order.
    ( cd "$WK_ROOT/bridge" 2>/dev/null || exit 0
      cat $(ls bin/* 2>/dev/null | sort) $(ls init.d/* 2>/dev/null | sort) 2>/dev/null \
        | cksum | awk '{print $1}' )
}

# Stderr-quiet wrapper around _bridge_probe, for par_run: the probe's own ssh
# calls are the noisy half (a dropped connection, a jump host's own chatter),
# and report_bridges must not let that spill onto the terminal mid-listing.
_bridge_probe_q() { _bridge_probe "$@" 2>/dev/null; }

# One bridge, probed. Bounded and read-only, costs one ssh.
# "Declared" says nothing about whether the segment behind it is up, so it's
# probed like every fleet device, in parallel and under a ceiling -- a phone
# in a drawer costs its own line, not the listing.
_bridge_probe() {
    local n="$1" conf="$2" want="$3" out state="" role="" sum="" health="" line="" _bridge_script
    # One round trip for everything: reachable, role present, which role, and
    # what its own health check says. `doas` because a provisioned bridge has no
    # root login and the health check reads privileged state (cmd/bridge takes
    # the same route).
    # Root first, then the config's user with a non-interactive doas -- the
    # order `wk bridge` uses, and for its reason: a provisioned bridge has root
    # with the driving key (bridge_bootstrap_root), while an unprovisioned one
    # answers only as `user`. `doas -n` fails cleanly instead of asking for a
    # tty, which is what a probe running with its stdin closed needs.
    _bridge_script='
        printf "reachable=yes\n"
        if [ -x /usr/local/sbin/wk-bridge-healthcheck ]; then
            printf "role=yes\n"
            printf "sum=%s\n" "$(cat $(ls /usr/local/sbin/wk-bridge-* 2>/dev/null | sort) \
                $(ls /etc/init.d/wk-bridge-* 2>/dev/null | sort) 2>/dev/null \
                | cksum | cut -d" " -f1)"
            if [ "$(id -u)" = 0 ]; then
                _h=$(/usr/local/sbin/wk-bridge-healthcheck 2>&1); _rc=$?
            elif command -v doas >/dev/null 2>&1; then
                _h=$(doas -n /usr/local/sbin/wk-bridge-healthcheck 2>&1); _rc=$?
            else
                _h=$(sudo -n /usr/local/sbin/wk-bridge-healthcheck 2>&1); _rc=$?
            fi
            printf "health=%s\n" "$_rc"
            printf "healthline=%s\n" "$(printf "%s" "$_h" | grep -v "^[[:space:]]*$" | tail -1)"
        else
            printf "role=no\n"
        fi'
    # A ceiling of its own, larger than a fleet device's: the health check
    # itself takes several seconds, and a probe killed mid-run loses
    # everything (the remote shell buffers stdout when it's not a tty). A
    # short ConnectTimeout still keeps a phone in a drawer cheap.
    out=$( capped "${WK_BRIDGE_TIMEOUT:-20}" ssh -o BatchMode=yes -l root \
             -o ConnectTimeout="${WK_FLEET_TIMEOUT:-4}" "$n" "$_bridge_script" 2>/dev/null ) || out=""
    case "$out" in
        reachable=*) ;;
        *) out=$( capped "${WK_BRIDGE_TIMEOUT:-20}" ssh -o BatchMode=yes \
                    -o ConnectTimeout="${WK_FLEET_TIMEOUT:-4}" "$n" "$_bridge_script" \
                    2>/dev/null ) || out="" ;;
    esac

    state=$(kv_get reachable <<<"$out")
    role=$(kv_get role <<<"$out")
    sum=$(kv_get sum <<<"$out")
    health=$(kv_get health <<<"$out")
    line=$(kv_get healthline <<<"$out")

    rec_start bridge
    rec_set name    "$n"
    rec_set device  "$4"
    rec_set segment "$5"
    rec_opt note    "$6"
    rec_set conf    "${conf#$WK_ROOT/}"
    rec_opt tailnet "$(reach_tailnet "$n")"
    rec_opt direct  "$(reach_without_tailnet "$n")"
    if [ "$state" != yes ]; then
        rec_set state "unreachable"
    elif [ "$role" != yes ]; then
        rec_set state "no bridge role"
        note_warn "it answers, and nothing on it is a bridge -- 'wk bridge setup $n' provisions it"
    else
        # A health check that fails is the bridge saying so about itself; the
        # exit status is the verdict and the last line is the reason.
        case "${health:-1}:$line" in
            0:*)   rec_set state "up" ;;
            # Not a verdict about the bridge: a verdict about this end's route to
            # it. The check reads privileged state, and if neither root nor a
            # non-interactive doas is available from here, the honest answer is
            # that it was not run -- not that the bridge is unhealthy.
            *doas*|*sudo*|*"not permitted"*|*"Authentication required"*)
                   rec_set state "role installed"
                   note_warn "its health check needs root and this end has no
      non-interactive route to it -- 'wk bridge status $n' can bootstrap one" ;;
            *)     rec_set state "unhealthy" ;;
        esac
        [ -z "$line" ] || rec_set health "$line"
        if [ -n "$sum" ] && [ "$sum" = "$want" ]; then
            rec_json role_insync true
        else
            rec_json role_insync false
            note_warn "the role on it is not this repository's -- 'wk bridge setup $n' re-provisions it"
        fi
    fi
    rec_emit
}

# The bridges, from the same registry `wk bridge` reads, each one asked how it
# is. Probed in parallel for the fleet block's reason: the wall cost is one
# bounded probe rather than one per phone.
report_bridges() {
    local dir f n dev seg note want
    dir="$WK_ROOT/bridge/hosts"
    [ -d "$dir" ] || return 0
    want=$(bridge_role_sum)
    par_begin
    for f in "$dir"/*.conf; do
        [ -f "$f" ] || continue
        n=$(basename "$f" .conf)
        # Read, not sourced: this is a report, and a conf is a shell file that
        # a report has no business executing to print one line of it.
        dev=$(kv_field "$f" BR_DEVICE)
        seg=$(kv_field "$f" BR_SEGMENT)
        note=$(kv_field "$f" BR_NOTE | sed 's/^"//; s/"$//')
        par_run "$n" _bridge_probe_q "$n" "$f" "$want" "${dev:-?}" "${seg:-?}" "$note"
    done
    par_join
    return 0
}

# Stderr-quiet wrapper around report_fleet_device, for par_run -- see
# _bridge_probe_q above; the same reason applies to a probe of a fleet board.
_fleet_device_q() { report_fleet_device "$@" 2>/dev/null; }

report_fleet_devices() {
    [ -f "$WK_ROOT/boot/machines.sh" ] || return 0
    # Not from inside a workspace: the fleet is the host's, and a sandbox with
    # no network would spend five probe timeouts saying so.
    ! in_workspace || return 0
    local m
    par_begin
    # shellcheck disable=SC1091
    for m in $(. "$WK_ROOT/boot/machines.sh"; machine_list | awk '{print $1}'); do
        par_run "$m" _fleet_device_q "$m"
    done
    par_join
    return 0
}

# The waiting half, before the reporting half: it drives this same command and
# then falls through to print the final row exactly once.
if [ -n "$WAIT" ]; then
    _interval="${WK_WAIT_INTERVAL:-5}"
    _waited=0
    _last=""
    while :; do
        _rc=0
        "$0" --no-fleet ${1:+"$1"} >/dev/null 2>&1 || _rc=$?
        # 2 is "a build is running, or a workspace is still being created" --
        # the only state worth waiting through. Everything else is an answer.
        [ "$_rc" = 2 ] || break
        if [ "$_last" != running ]; then
            info "waiting for${1:+ '$1'} to finish (wk status says busy)"
            _last=running
        fi
        if [ "$WAIT_TIMEOUT" -gt 0 ] && [ "$_waited" -ge "$WAIT_TIMEOUT" ]; then
            warn "still busy after ${WAIT_TIMEOUT}s -- the work continues; this only stopped waiting"
            break
        fi
        sleep "$_interval"
        _waited=$((_waited + _interval))
    done
fi

# This machine's targets before anybody else's, and within a machine the
# container store before the guests -- so a machine's groups are adjacent and
# the one you are typing on comes first. `walk_targets` answers "which targets
# are there"; the order it happens to answer in was never part of that, and it
# put this Mac's own containers *after* every shared build machine.
order_targets() {
    local t
    for t in "$@"; do
        case "$(target_kind "$t" 2>/dev/null)" in
            container) printf '0 %s\n' "$t" ;;
            vm)        printf '1 %s\n' "$t" ;;
            local)     printf '2 %s\n' "$t" ;;
            *)         printf '3 %s\n' "$t" ;;
        esac
    done | sort -k1,1 -k2,2 | awk '{print $2}'
}

# Which target reports this machine's own health, decided before the walk
# forks -- not whichever gets there first, which a parallel walk can't mean:
# on Linux the container and vm targets are both this machine, so both would
# emit a disk and load figure whose *store* depends on subshell timing.
#
# The rule: the first target, in walk order, that doesn't delegate (a
# machine answering for itself reports its own health) and whose workspaces
# are here. Both readable from the conf alone (WK_REMOTE_LOCAL marks a
# remote target as this machine), so deciding costs no probe.
health_owner() {
    local t
    for t in $(order_targets "$@"); do
        case "$(target_kind "$t" 2>/dev/null)" in
            remote) ( load_target "$t" >/dev/null 2>&1
                      [ -n "${WK_REMOTE_LOCAL:-}" ] ) || continue ;;
        esac
        printf '%s\n' "$t"
        return 0
    done
    return 0
}

# One target's workspaces, as records, under the machine and method they belong
# to. The two group fields travel in globals because `report` is called per
# workspace from three places and threading them through every call would say
# the same thing three times.
_group_machine=""
_group_method=""
_health_owner=""
report_target() {
    local t="$1" rc=0 ws
    _group_machine="$(machine_of "$t")"
    _group_method="$(method_of)"
    machine_seen "$_group_machine"

    if t_has_wk; then
        # The machine answers for itself, in the same records. An older copy
        # over there has never heard of the flag, so `delegate` captures its
        # text instead and emits it as one `raw` record -- see delegate().
        WK_ROW_LABEL="$t" WK_NO_DELEGATE=1 \
            delegate status --no-fleet --records || rc=$?
        bump "$rc"
        if [ -n "$FLEET" ]; then
            report_machine "$t"
            report_capacity_remote "$_group_machine"
        fi
        return 0
    fi

    if [ -n "${2:-}" ]; then
        report "$2"
    else
        # One workspace's row costs one exec into the container or guest that
        # holds it (report_ws: origin, dirty, unpushed, drift -- deliberately
        # one round trip, and half a second of it in a WebKit checkout). Those
        # execs share nothing, so the target's cost is one of them rather than
        # all of them.
        par_begin
        for ws in $(target_workspaces); do par_run "$ws" _report_ws_par "$ws"; done
        par_join
    fi
    if [ -n "$FLEET" ]; then
        report_machine "$t"
        # This machine's own tooling belongs to this machine, and the walk is
        # the only place that knows we are on it.
        if [ "$_group_machine" = "$(this_machine)" ] && [ "$t" = "$_health_owner" ]; then
            report_self
            report_health "$_group_machine"
        fi
    fi
    return 0
}

# One workspace, in a process of its own. Its verdict is the only thing that
# crosses back, and it crosses as an exit status because that is the one channel
# a subshell has (par_run).
_report_ws_par() { report "$1"; exit "$worst"; }

# One target, likewise -- and the driver is loaded *in here*, which is the same
# reason prefetch_targets forks per target: a driver overrides shell functions,
# a function definition outlives the load, and the first driver's t_branch
# answering for the second target's workspaces is a wrong answer that looks
# entirely plausible (lib/target.sh).
_report_target_par() {
    local t="$1"
    load_target "$t"
    report_target "$t"
    exit "$worst"
}

# The fleet devices and the bridges, as one more par_run job in collect()'s
# batch -- see the comment there for why they run as one job together and not
# each as a job of its own.
_devices_par() {
    report_fleet_devices
    report_bridges
    exit "$worst"
}

# --- collection, and then whoever is looking at it ----------------------------
#
# The walk is a function so that every mode runs the *same* walk: a terminal, a
# browser and `--json` differ in what they do with fd 3 and in nothing else.
collect() {
    if [ -n "${1:-}" ]; then
        # In a workspace a bare `wk status` is the whole command: there is one
        # workspace and it is this machine, and the dispatcher already refuses
        # an explicit, redundant name for it before this runs.
        require_name "$1"
        TARGET="$(ws_target "$1")"
        load_target "$TARGET"
        # One workspace was asked about, so the machine's tooling and keys are
        # not the question: they belong to the fleet block, and this is the one
        # workspace's.
        FLEET=""
        report_target "$TARGET" "$1"
    else
        _TARGETS=$(walk_targets)

        # Every machine asked at once, before the first record is written; the
        # walk below is unchanged and finds them already answered
        # (prefetch_targets, lib/target.sh).
        # shellcheck disable=SC2086 -- deliberate word splitting of the target list.
        prefetch_targets $_TARGETS
        wk_atexit prefetch_done

        # The boards and the phones are one more job in the same batch as the
        # targets, not a walk apart from it -- so they stream in wherever they
        # finish rather than always being the thing appended after everything
        # else has already rendered. They are the listing's longest pole (an
        # off board costs its ceiling, a bridge health-checks a phone over a
        # radio) and share nothing with the target walk -- no driver, no
        # store, no shared ssh -- so paying for them *beside* it costs nothing
        # extra, and being last to finish is exactly the case par_join_stream
        # exists for.
        #
        # The boards and the phones run inside one job, in step, because a
        # bridged board is reached *through* the same phone the bridge block
        # ssh's into -- run separately they contend for that link and disagree
        # with themselves between runs (measured: 26s/50s and flapping
        # answers vs. 18s and consistent ones in step).
        #
        # Started after the prefetch, not beside it: the two don't contend for
        # a machine, but they do contend for the resolver, and a wedged one
        # serialises lookups a warm one answers instantly (measured:
        # `wk status --json` 21.1s -> 26.3s/29.6s when started together on a
        # wedged tailnet). The prefetch gets the resolver to itself first.

        # shellcheck disable=SC2086 -- deliberate word splitting of the target list.
        _health_owner=$(health_owner $_TARGETS)

        # shellcheck disable=SC2086 -- same, and order_targets takes them as words.
        par_begin
        for TARGET in $(order_targets $_TARGETS); do
            # A placeholder a streaming reader can show while this one is
            # still in flight -- named for the target, which for a remote one
            # *is* the machine name (machine_of returns it unchanged), so the
            # real block that follows answers to the same name. A local
            # target settles fast enough that the placeholder rarely shows.
            printf '{"kind":"probing","name":"%s"}\n' "$(_jesc "$TARGET")" >&3
            par_run "$TARGET" _report_target_par "$TARGET"
        done
        if [ -n "$DEVICES" ]; then
            par_run devices _devices_par
        fi
        par_join_stream
    fi

    # The exit status, in the stream. It is this command's whole contract for a
    # script, and a listing assembled from two machines' records has to be able
    # to carry the worst of them rather than the last.
    rec_start exit
    rec_json code "$worst"
    rec_emit
}

# `--records`: the stream itself, for whoever is assembling a bigger listing --
# the other half of a macOS run (bare_report in `wk`), or the machine that asked
# this one to answer for itself. It renders nothing, because it is not the thing
# a person is looking at.
if [ -n "$RECORDS" ]; then
    exec 3>&1
    collect ${1:+"$1"}
    exit "$worst"
fi

# Everything else renders. json/html/web still want the whole listing before
# they say anything -- a column no wider than its heading until the last
# machine has answered, one page written once -- but the text renderer wants
# to start before that, on whatever has landed so far (lib/status-view.py's
# streaming reader). Both read the same record stream; the difference is
# entirely in when each one chooses to draw, not in a second way of collecting.
#
# A fifo instead of a plain file is what makes that possible without a second
# collection path: `collect` keeps running -- in the background, since a fifo
# open for writing blocks until something is reading it -- while the renderer
# reads as it goes. json/html/web read to EOF before producing anything, which
# is the same wait they always did; only text sees the difference.
_recs_dir=$(mktemp -d "${TMPDIR:-/tmp}/wk-status.XXXXXX")
_recs="$_recs_dir/records"
mkfifo "$_recs"
_recs_cleanup() { rm -rf "$_recs_dir"; }
wk_atexit _recs_cleanup

( # A fork's atexit state is a copy of this process's, taken at the fork --
  # so this subshell's own exit also runs `_recs_cleanup` (registered above)
  # and removes the fifo's directory entry, before the parent, which is
  # still reading it, has finished. Left alone rather than fought (only
  # lib/common.sh may touch `trap ... EXIT` or `_WK_ATEXIT` --
  # wk_atexit, above): harmless, since an unlink while a reader still has the
  # fifo open does not disturb that reader, and the parent's own copy of the
  # same handler -- untouched by anything this subshell does to its own,
  # forked copy -- still runs the real cleanup once this process actually
  # ends.
  exec 3> "$_recs"
  collect ${1:+"$1"}
  exit "$worst"
) </dev/null &
_collect_pid=$!

# The port, the interval and the output path travel as environment rather than
# as arguments, because `wk` renders too (bare_report) and it has not parsed
# them -- it hands over whatever the person typed.
WK_STATUS_PORT="$WEB_PORT" WK_STATUS_INTERVAL="$WEB_INTERVAL" \
    WK_STATUS_HTML_OUT="$HTML_OUT" status_render "$MODE" "$_recs"

# `collect` ran in its own subshell (mandatory for the fifo above not to
# deadlock this one waiting on a reader), so its `worst` never touched this
# process's -- it comes back the one way a subshell can hand one back, its
# own exit status.
rc=0; wait "$_collect_pid" || rc=$?
bump "$rc"
exit "$worst"
