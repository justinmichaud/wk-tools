#!/usr/bin/env bash
#
# wk sysimage -- build and manage bootable systems.
#
#   wk sysimage build <profile> [--dry-run] [--keep-rubble]
#   wk sysimage ls
#   wk sysimage show <id>
#   wk sysimage disks <machine>
#   wk sysimage write --from <path> --disk <machine>:<device>
#   wk sysimage rm <id>
#
# An image is a whole machine, built from a spec in this repo, that a machine
# can be put into for one boot and taken out of again. It exists because four
# later steps all need the same thing -- a machine with no sandbox, whose
# kernel knobs are ours to set -- and each was otherwise going to invent its
# own way to get a binary onto hardware (docs/HANDOFF-boot.md).
#
# The build runs entirely unprivileged. Nothing here mounts anything: the
# seed files go into the image's FAT partition with mtools at a byte offset
# read out of the partition table, which is the whole reason the workstation
# still has no privileged component. The one operation that does need root is
# writing the image to a device, and that happens on the target machine, over
# ssh, where sudo is passwordless.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/image.sh"
. "$WK_ROOT/image/profiles.sh"
. "$WK_ROOT/boot/machines.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/boot/disk.sh"
. "$WK_ROOT/image/yocto.sh"
. "$WK_ROOT/image/buildroot.sh"
. "$WK_ROOT/image/pmos.sh"
. "$WK_ROOT/image/fetch.sh"

# Both of these act on physical machines: a boot device, a firmware register, a
# disk image measured in gigabytes. None of that exists in a workspace, and the
# sandbox cannot reach the machine that has it. The rule now lives in `wk`'s
# is_host_only list, where it is one line next to every other command of the
# same kind; this stays as the second half of it, for the case the dispatcher
# cannot cover -- cmd/image run directly, which is how a hook or a script that
# knows the path invokes it.
if in_workspace; then
    die "'wk $(basename "$0")' acts on a host and its hardware, and this is
    workspace '$(wk_self)'. Run it on the workstation instead."
fi

usage() {
    cat >&2 <<'EOF'
usage: wk sysimage <sub>

  build <profile> [--dry-run]     build an image from the spec in this repo
                                  (a yocto profile also takes --workspace,
                                   --stage, --detach, --stop, --keep-work,
                                   --no-import; a pmos profile takes --detach
                                   and --resume, and builds on a Linux aarch64
                                   machine over ssh)
  ls                              every image a workspace here has built, and
                                  where it is. There is no store: the workspace
                                  that built an image is its name
                                  (wk help images)
  show <id>                       what an image is, and whether it still is
  disks <machine>                 removable disks attached to that machine
  write --from <path> --disk <machine>:<device>
                                  write that image onto that disk; --from takes
                                  a path 'wk sysimage ls' printed
      --rescue                    write it as the board's rescue system: the
                                  units that hand a machine back stay inert,
                                  and the rest of the card is left for the
                                  bench system that goes beside it. One image
                                  serves both roles -- this is the only
                                  difference between them
      --grow | --no-grow          fill the disk with the root partition, or
                                  leave it at its built size
  retarget <id>                   make an imported image bootable from the
                                  disk its machine actually boots, and give it
                                  the driving ssh key
  rm <id>                         delete an image

Two things about `write`, because neither is guessable:

  It never touches a machine's own system disk. That is refused, by several
  independent checks -- what gets written is a removable disk that happens to
  be plugged into the machine. The machine is where the disk is, not the target.

  Writing a disk does not make anything boot it. Booting is `wk boot
  <machine>`, and it is one-shot: the machine boots the disk once and returns
  to host mode by itself.

profiles:
EOF
    image_profile_list | sed 's/^/  /' >&2
    exit 2
}

_seed_cleanup() { [ -n "${SEED:-}" ] && rm -rf "$SEED"; SEED=""; return 0; }

# --- the seed ----------------------------------------------------------------

# The public key the image will accept. The board is reached over Tailscale SSH
# today, which authenticates with no key at all -- so the key that works now is
# not evidence of the key the image needs, and it has to be named here.
driving_key() {
    local k="${WK_IMAGE_KEY:-$HOME/.ssh/id_ed25519.pub}"
    [ -r "$k" ] || die "no public key at $k
    The image has to accept an ssh key on first boot, or it comes up
    unreachable. Set WK_IMAGE_KEY to the one this machine should use."
    cat "$k"
}

# What the image is, in the image, so "which OS am I talking to" is never a
# guess -- and so `wk boot --status` can tell the two roles apart from the
# outside by evidence rather than by trusting its own record.
#
# This is the only record of what an image is (wk help images): everything else
# about one is either here, derivable from `profile` plus this repo, or
# recomputable from the bytes, so a second copy could only ever disagree. Read
# back out of the image with debugfs, and off a booted board by `b_probe` --
# the same fact from the same place.
#
# `builder` is recorded rather than inferred: it is the difference between two
# perf numbers, so a run should never have to guess it from the profile name.
#
# `role` is the one field here that a later step may rewrite, and the only one
# that is not a property of the bytes. Every image is built as a bench system;
# writing a card with --rescue stamps `rescue` here, on the card, because one
# artifact serves both roles and the disk is the only place the two facts are
# ever in the same room (disk_seed_role, boot/disk.sh).
marker_file() {
    cat <<EOF
id=$ID
profile=$IMG_PROFILE
machine=$IMG_MACHINE
builder=$IMG_BUILDER
role=bench
base=${YOC_TARGET:-${BR_DEFCONFIG:-none}}
built=${BUILT:-${built:-unknown}}
built_by=$(hostname)
wk_tools=$(git -C "$WK_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)
EOF
}

# --- FAT surgery, without a mount --------------------------------------------
#
# mtools addresses a filesystem inside an image file directly, at a byte
# offset, which is what keeps this whole command unprivileged. MTOOLS_SKIP_CHECK
# is needed because an image's sector count is rarely a whole
# number of tracks, and mtools refuses such an image by default.
mt() {
    local prog="$1"; shift
    MTOOLS_SKIP_CHECK=1 "$prog" -i "$DISK@@$FAT_OFFSET" "$@"
}

# Byte offset of a partition, from the table in the file itself. No loop
# device, no root -- the same trick the FAT seeding relies on, and e2fsprogs
# speaks it natively through `file?offset=N`.
part_offset() {
    local img="$1" n="$2"
    sfdisk -J "$img" | python3 -c '
import json, sys
p = json.load(sys.stdin)["partitiontable"]["partitions"]
print(p[int(sys.argv[1]) - 1]["start"] * 512)' "$n"
}

fat_offset() {
    local img="$1"
    # sfdisk reads the partition table straight out of the file; no loop
    # device, no root. Partition 1 is the firmware/boot FAT on every Pi image.
    sfdisk -J "$img" \
        | sed -n 's/.*"start": *\([0-9]*\).*/\1/p' \
        | head -1 \
        | awk '{ print $1 * 512 }'
}

# Install a systemd unit into the image's rootfs, enabled, without cloud-init.
#
# This exists because of a hole that cost two trips to the machine. The
# self-return watchdog was armed by cloud-init, so every failure *earlier* than
# cloud-init -- a seed that was not read, a datasource that did not initialise,
# a stage that hung -- produced a board that was stranded with nothing to hand
# it back. The watchdog protected exactly the boots that did not need it.
#
# So the units are written into the rootfs at build time, with their
# <target>.wants symlinks, and systemd starts them whether cloud-init ever runs
# or not. Everything that can be installed this way should be: the only things
# left to cloud-init are the ones that genuinely need it (a user with an
# authorized key, and the rendered network configuration).
#
#   install_unit <rootfs-offset> <name> <body> [target]
#
# The target is a real argument and not a constant, because `systemctl enable`
# never runs here -- nothing reads the unit's own `[Install] WantedBy=`, so a
# unit that asks for one target and is symlinked into another gets the symlink
# and silently loses the ordering it was written for. That happened to
# wk-self-disarm.service, which wants to run before sysinit.target and was
# linked from multi-user.target.wants -- an ordering systemd cannot satisfy,
# since multi-user comes *after* sysinit. Defaulting to multi-user.target keeps
# every existing caller as it was.
install_unit() {
    local roff="$1" name="$2" body="$3" target="${4:-multi-user.target}"
    printf '%s' "$body" > "$SEED/$name"
    debugfs -w -R "mkdir /etc/systemd/system/$target.wants" \
        "$DISK?offset=$roff" >/dev/null 2>&1 || true
    debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
cd /etc/systemd/system
rm $name
write $SEED/$name $name
sif $name mode 0100644
sif $name uid 0
sif $name gid 0
symlink /etc/systemd/system/$target.wants/$name /etc/systemd/system/$name
EOF
    debugfs -R "stat /etc/systemd/system/$name" "$DISK?offset=$roff" 2>/dev/null \
        | grep -q '^Inode:' || die "could not install $name into the image"
}

# --- making an image bootable from the disk it is written to -------------------

# The MBR partition UUID of one partition: the disk signature, then the
# partition number, which is the form the *kernel* resolves with no help from
# userspace.
#
# `LABEL=` would read better and is not available here: resolving a filesystem
# label at boot needs an initramfs to do the lookup, and a Yocto wic image has
# none -- the firmware loads kernel8.img and the kernel mounts its root
# directly. `PARTUUID=` is resolved inside the kernel (`devt_from_partuuid`), so
# it works with nothing in front of it.
image_partuuid() {
    local img="$1" n="$2" sig
    sig=$(sfdisk -J "$img" 2>/dev/null | sed -n 's/.*"id": *"0x\([0-9a-fA-F]*\)".*/\1/p' | head -1)
    [ -n "$sig" ] || return 1
    printf '%08x-%02d' "$((0x$sig))" "$n"
}

# Give an image a root reference that survives being written to a different
# kind of device than the one its recipe assumed.
#
# The problem this solves is a wic image's baked-in root. bitbake writes
# `root=/dev/mmcblk0p2` because its wks file says so, and that is a promise
# about a device rather than about a filesystem: written to a USB stick the
# firmware loads the kernel from partition 1 and the kernel then looks for its
# root on an SD card that is not there. `image_check_root` (lib/image.sh)
# refuses that write, correctly -- and refusing is all it can do, because the
# fix is not on the writing side.
#
# The fix is here: rewrite the two places that name a device by path so they
# name a *partition* instead. Then one image boots from the card or the stick,
# `image_root_class` calls it `portable`, and the check passes because there is
# nothing left to catch.
#
# Both halves matter and they are resolved by different code. `root=` on the
# kernel command line is resolved by the kernel; `/boot` in /etc/fstab is
# resolved by mount(8) after userspace is up. Rewriting only the first gives a
# system that boots and then has an empty /boot -- which looks fine until
# something writes a kernel there.
#
# Unprivileged, in place, nothing mounted: mtools for the FAT, debugfs for the
# ext4. e2fsprogs takes `file?offset=N` on any of its tools, so a filesystem
# inside an image is editable without a loop device or a mount.
retarget_root() {
    local seed="$1" roff spec class uuid_root uuid_boot cmdline_path
    roff=$(part_offset "$DISK" 2)

    spec=$(cmdline_root_spec)
    [ -n "$spec" ] || die "$DISK has no cmdline.txt to read a root from"
    class=$(image_root_class "$spec")
    case "$class" in
        portable)
            debug "root is already portable ($spec); nothing to retarget"
            return 0 ;;
        network)
            die "$DISK names a network root ($spec). Nothing here boots that way." ;;
    esac

    uuid_root=$(image_partuuid "$DISK" 2) \
        || die "could not read the disk signature out of $DISK's partition table"
    uuid_boot=$(image_partuuid "$DISK" 1)

    info "retargeting the root: $spec -> PARTUUID=$uuid_root (boots from any device)"

    # The kernel command line.
    for cmdline_path in ::/current/cmdline.txt ::cmdline.txt; do
        if mt mtype "$cmdline_path" > "$seed/cmdline.txt" 2>/dev/null; then
            sed -i "s|root=$spec|root=PARTUUID=$uuid_root|" "$seed/cmdline.txt"
            grep -q "root=PARTUUID=$uuid_root" "$seed/cmdline.txt" \
                || die "could not rewrite root= in $cmdline_path"
            mt mcopy -o "$seed/cmdline.txt" "$cmdline_path"
            debug "rewrote $cmdline_path"
            break
        fi
    done

    # /etc/fstab, for every device path in it. The root line is usually
    # `/dev/root`, which the kernel fills in and which is right already; it is
    # the /boot line that names a card.
    if debugfs -R "cat /etc/fstab" "$DISK?offset=$roff" 2>/dev/null > "$seed/fstab.old"; then
        sed -e "s|^/dev/mmcblk0p1[[:space:]]|PARTUUID=$uuid_boot\t|" \
            -e "s|^/dev/sda1[[:space:]]|PARTUUID=$uuid_boot\t|" \
            -e "s|^/dev/mmcblk0p2[[:space:]]|PARTUUID=$uuid_root\t|" \
            -e "s|^/dev/sda2[[:space:]]|PARTUUID=$uuid_root\t|" \
            "$seed/fstab.old" > "$seed/fstab"
        if ! cmp -s "$seed/fstab.old" "$seed/fstab"; then
            debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
rm /etc/fstab
cd /etc
write $seed/fstab fstab
sif fstab mode 0100644
sif fstab uid 0
sif fstab gid 0
EOF
            e2fsck -fy "$DISK?offset=$roff" >/dev/null 2>&1 || true
            debugfs -R "cat /etc/fstab" "$DISK?offset=$roff" 2>/dev/null \
                | grep -q "PARTUUID=$uuid_boot" \
                || die "/etc/fstab did not survive the rewrite"
            info "  and /etc/fstab's /boot -> PARTUUID=$uuid_boot"
        fi
    fi
}

# The image's own cmdline root=, read from $DISK rather than from the store, so
# this works mid-build before there is a manifest to look it up by.
cmdline_root_spec() {
    local p
    for p in ::/current/cmdline.txt ::cmdline.txt; do
        mt mtype "$p" 2>/dev/null | tr ' ' '\n' | sed -n 's/^root=//p' | head -1 \
            | grep . && return 0
    done
    return 1
}

# The image's identity, on the **boot partition** -- a different file from
# /etc/wk-image in the rootfs, and not a duplicate of it. This one is FAT, so
# `b_device_image` (boot/machines.sh) can read it off a disk that is not
# running, from the other role, without mounting anything ext4. That is the
# question "what is on this stick", which is not the question "what is this
# machine running".
#
# The obvious check -- does the device still byte-match the image -- is wrong
# after the first boot: a booted image writes to its own boot partition (the
# diagnostics dump, cloud-init's own state), so bit-identity stops holding the
# moment the thing works. Identity is what the question actually means.
#
# One writer, called from every builder. Inside a single builder it would be an
# id every other builder's images lack, and `wk boot` refuses a disk with no id
# on its boot partition -- "holds no wk system", about a disk that was just
# written and verified.
install_disk_id() {
    printf '%s\n' "$ID" > "$SEED/wk-image.id"
    mt mcopy -o "$SEED/wk-image.id" ::wk-image.id
    mt mtype ::wk-image.id 2>/dev/null | grep -qxF "$ID" \
        || die "the identity did not survive the write to the boot partition"
}

# Kernel command-line additions this profile declares, appended to whatever the
# image already had.
#
# A profile's `config.txt.append` says what the *firmware* has to be told; this
# is the same idea one layer up, for the *kernel*. It exists
# because the rpi4 is headless and Speedometer is gpu-class: forcing a KMS
# output is a kernel cmdline setting, and doing it by hand on a stick would be
# exactly the un-reproducible tinkering the fleet rules forbid.
#
# Appended rather than replacing, and idempotent: the marker keeps a second
# import from adding the same options twice.
CMDLINE_MARKER='# wk:'
apply_cmdline_append() {
    local seed="$1" add f path
    f="$IMG_SPEC_DIR/cmdline.txt.append"
    [ -f "$f" ] || return 0
    add=$(grep -vE '^\s*(#|$)' "$f" | tr '\n' ' ' | sed 's/ *$//')
    [ -n "$add" ] || return 0

    for path in ::/current/cmdline.txt ::cmdline.txt; do
        if mt mtype "$path" > "$seed/cmdline.txt" 2>/dev/null; then
            if grep -qF "$add" "$seed/cmdline.txt"; then
                debug "cmdline already carries: $add"
                return 0
            fi
            info "kernel cmdline += $add  (from $(basename "$IMG_SPEC_DIR")/cmdline.txt.append)"
            # One line, always: the firmware reads the first line only, so a
            # trailing newline from the spec file would silently drop it all.
            printf '%s %s\n' "$(tr -d '\r\n' < "$seed/cmdline.txt")" "$add" > "$seed/cmdline.new"
            mv "$seed/cmdline.new" "$seed/cmdline.txt"
            mt mcopy -o "$seed/cmdline.txt" "$path"
            CMDLINE_APPENDED="$add"
            return 0
        fi
    done
    die "no cmdline.txt in the image's boot partition to append to"
}

# Firmware settings this profile declares, appended to whatever config.txt the
# image already had.
#
# The sibling of apply_cmdline_append one layer down: that one tells the
# *kernel* something, this one tells the *firmware*, and on a Raspberry Pi the
# firmware reads config.txt off the boot partition whatever the OS on it is.
#
# What it carries is what a *board* needs to be measured, which is why it is a
# property of the profile rather than of the builder. The rpi4's clock pinning
# is the case that matters: a Pi 4 idles at 600 MHz and ramps on demand, so a
# run that starts cold spends its first samples on a CPU that is still climbing,
# and DVFS ramping inside a measurement is variance that has nothing to do with
# the code under test. A setting that does not land fails no build -- it makes
# every number on that board worse, with nothing to notice it by, which is why
# the block is read back.
#
# Appended, never replacing: the image's own copy is what makes it bootable.
# Idempotent by marker, so re-running an edit does not stack the block up.
apply_config_append() {
    local seed="$1" f path
    f="$IMG_SPEC_DIR/config.txt.append"
    [ -f "$f" ] || return 0

    for path in ::/current/config.txt ::config.txt; do
        mt mtype "$path" > "$seed/config.txt" 2>/dev/null || continue
        if grep -qF "# --- wk sysimage: $IMG_PROFILE ---" "$seed/config.txt"; then
            debug "config.txt already carries $IMG_PROFILE's block"
            return 0
        fi
        info "config.txt += $(basename "$IMG_SPEC_DIR")/config.txt.append (firmware settings)"
        printf '\n' >> "$seed/config.txt"
        cat "$f" >> "$seed/config.txt"
        mt mcopy -o "$seed/config.txt" "$path"
        # Read back, because a firmware setting that did not land is a board
        # that measures at whatever clock it felt like -- and nothing says so.
        mt mtype "$path" 2>/dev/null | grep -qF "# --- wk sysimage: $IMG_PROFILE ---" \
            || die "config.txt did not take $IMG_PROFILE's firmware block"
        return 0
    done
    die "no config.txt in the image's boot partition to append to"
}

# The ssh key that makes the fleet integration usable on an image with no
# cloud-init.
#
# `install_fleet_integration` writes the identity marker and the watchdog, and
# every one of those is read or driven **over ssh** -- `b_probe` reads
# /etc/wk-image, `wk boot --back` disarms, `wk bench` runs the benchmark. A
# Yocto image ships `PermitRootLogin yes` with an empty root password, so a
# person can get in and nothing automated can: an empty password is not
# something `ssh -o BatchMode=yes` can offer. Without a key the image boots
# perfectly and is invisible to every verb here -- the exact failure that
# handoff calls out, arrived at from the other side.
install_driving_key() {
    local roff="$1" home ssh
    # Asked of the image rather than assumed: Yocto puts root in /home/root,
    # Debian and Ubuntu in /root, and writing the key into a directory the
    # sshd will not look in fails exactly as silently as not writing it.
    home=$(debugfs -R "cat /etc/passwd" "$DISK?offset=$roff" 2>/dev/null \
        | awk -F: '$1 == "root" { print $6 }' | head -1)
    [ -n "$home" ] || die "no root entry in the image's /etc/passwd"
    ssh="$home/.ssh"

    driving_key > "$SEED/authorized_keys"
    info "installing the driving ssh key into the image ($ssh)"
    debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
mkdir $ssh
cd $ssh
rm authorized_keys
write $SEED/authorized_keys authorized_keys
sif authorized_keys mode 0100600
sif authorized_keys uid 0
sif authorized_keys gid 0
sif $ssh mode 040700
sif $ssh uid 0
sif $ssh gid 0
EOF
    e2fsck -fy "$DISK?offset=$roff" >/dev/null 2>&1 || true
    debugfs -R "cat $ssh/authorized_keys" "$DISK?offset=$roff" 2>/dev/null \
        | grep -q 'ssh-' || die "the driving key did not survive the write into the image"
}

# Write a plain file into the image's rootfs at build time.
#
# Same reasoning as install_unit and the same hole behind it, found on the
# rpi4's first real boot: cloud-init is *late*. `systemd-sysctl` ran at
# 18:33:04 and cloud-init-local wrote /etc/sysctl.d/90-wk-perf.conf at
# 18:33:21, so the file was correct on disk and seventeen seconds too late to
# be read. On a one-shot image, which boots once and hands the machine back,
# "takes effect on the second boot" means "never" -- and the settings in
# question are the entire reason the image exists.
install_file() {
    local roff="$1" path="$2" body="$3" mode="${4:-0100644}"
    local dir base tmp
    dir=$(dirname "$path"); base=$(basename "$path")
    tmp="$SEED/.rootfs-$base"
    printf '%s' "$body" > "$tmp"
    debugfs -w -R "mkdir $dir" "$DISK?offset=$roff" >/dev/null 2>&1 || true
    debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
cd $dir
rm $base
write $tmp $base
sif $base mode $mode
sif $base uid 0
sif $base gid 0
EOF
    debugfs -R "stat $path" "$DISK?offset=$roff" 2>/dev/null \
        | grep -q '^Inode:' || die "could not install $path into the image"
    rm -f "$tmp"
}

# Everything a rootfs needs to be a *fleet* system rather than merely a
# bootable one, for whichever builder made it.
#
# Split out because the two builders shared nothing after the manifest, and the
# consequence was invisible until a Yocto image was wanted as a bench system:
# it has no `/etc/wk-image`, so `b_probe` cannot tell the board apart from its
# host mode, and `wk boot --status` reports a machine running the image as
# though it never left. It also has no self-return watchdog, which on a
# medium-armed machine means the stick stays armed and the board never comes
# back on its own.
#
# None of that is a property of any one builder, which is why the integration
# lives here, beside all of them, rather than inside one.
install_fleet_integration() {
    local roff="$1"

    # The identity marker, in the rootfs rather than only in cloud-init's
    # write_files: "which OS am I talking to" has to be answerable on a boot
    # where cloud-init did not run -- and on a Yocto image there is no
    # cloud-init at all, so this is the *only* copy.
    marker_file > "$SEED/wk-image"
    debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
cd /etc
rm wk-image
write $SEED/wk-image wk-image
sif wk-image mode 0100644
sif wk-image uid 0
sif wk-image gid 0
EOF
    debugfs -R "stat /etc/wk-image" "$DISK?offset=$roff" 2>/dev/null \
        | grep -q '^Inode:' || die "could not write the identity marker into the image"

    install_units "$roff"
}

install_units() {
    local roff="$1"
    # The machine's boot driver, for b_self_disarm_sh. Loaded here rather than
    # at the top of the file because most profiles have no machine at all (the
    # yocto ones name a target, not a fleet entry), and a missing driver is not
    # an error -- it just means this image has nothing to disarm.
    if machine_load "${IMG_MACHINE:-}" 2>/dev/null && [ -n "${MACH_DRIVER:-}" ]; then
        load_driver "$MACH_DRIVER" 2>/dev/null || true
    fi
    # Every unit below goes into every image, and the two that hand a machine
    # *back* are gated at runtime on /etc/wk/rescue instead of being left out
    # here. That is what makes one built artifact serve both roles.
    #
    # The role is a property of the card, not of the build: a rescue system and
    # the bench system beside it are the same distribution, built once, and the
    # only difference between them is a marker `wk sysimage write --rescue`
    # leaves on the disk. Baking the difference in would mean two bitbakes and
    # two multi-gigabyte artifacts for one line of behaviour -- and a second
    # build of the same inputs is the second copy of a fact that CLAUDE.md
    # forbids, in its most expensive form.
    #
    # What the gate protects is real. Both units exist to return a machine to
    # the system it was already sitting on: the watchdog reboots it out of the
    # system somebody armed, and the self-disarm parks the arming medium so the
    # next boot falls through to the rescue. A rescue is what both fall back
    # *to* -- so on one, the watchdog would reboot the helper every
    # IMG_WATCHDOG seconds for no reason, in the middle of whatever card it was
    # writing, and the self-disarm would park a medium this image is not on.

    # Which init this image actually runs, read out of the image rather than
    # assumed. Every unit below is a systemd unit, and an image without systemd
    # would take all of them without complaint: the files land in
    # /etc/systemd/system, nothing ever starts them, and `wk sysimage` reports
    # that it installed a self-return watchdog onto a board that has none. A
    # board that reports itself protected and is not is worse than one that
    # says it is not -- the whole point of the watchdog is the run nobody is
    # watching.
    #
    # This is not hypothetical: the rpi3's WPE 2.38 image is buildroot with
    # BusyBox init (docs/TESTING.md §7), so it is the first image here whose
    # answer is "no". What it needs instead is S-scripts, and they are not
    # written yet -- there is nothing for a self-disarm to disarm on that board
    # until its card has a second root slot, and a watchdog with nowhere to
    # return to is a reboot loop. So this refuses to pretend, and says which
    # half is missing.
    if ! debugfs -R "stat /lib/systemd/systemd" "$DISK?offset=$roff" 2>/dev/null | grep -q '^Inode:' \
       && ! debugfs -R "stat /usr/lib/systemd/systemd" "$DISK?offset=$roff" 2>/dev/null | grep -q '^Inode:'; then
        warn "$IMG_PROFILE has no systemd, so the self-return watchdog and the self-disarm
  were NOT installed. This image carries its identity marker and the driving key
  and nothing else: a run that wedges the board will not hand it back, and on a
  medium-armed machine the medium stays armed until something disarms it."
        return 0
    fi

    # The .wants directory need not exist in a stock image.
    debugfs -w -R "mkdir /etc/systemd/system/multi-user.target.wants" \
        "$DISK?offset=$roff" >/dev/null 2>&1 || true

    info "installing the self-return watchdog and the diagnostics dump into the rootfs"

    # TimeoutStartSec=infinity is load-bearing: systemd's default 90 s start
    # timeout kills a Type=oneshot that sleeps longer than that before it can
    # ever fire.
    # Skipped rather than written empty when a profile names no watchdog: the
    # unit would be `sleep ` with no argument, which fails on every boot and
    # looks in the journal exactly like a watchdog that ran.
    if [ -z "${IMG_WATCHDOG:-}" ]; then
        warn "$IMG_PROFILE sets no IMG_WATCHDOG, so this image will not hand its machine back"
    else
    install_unit "$roff" wk-self-return.service "[Unit]
Description=Hand the machine back to host mode unless claimed
# Inert on a rescue system, which is what this would be handing the machine
# back *to*. The marker is written by 'wk sysimage write --rescue'.
ConditionPathExists=!/etc/wk/rescue
[Service]
Type=oneshot
ExecStart=/bin/sh -c 'sleep $IMG_WATCHDOG; [ -f /run/wk-keep-running ] || systemctl reboot'
TimeoutStartSec=infinity
[Install]
WantedBy=multi-user.target
"
    fi

    # A medium-armed machine's image disarms itself, which is what makes an
    # arming that lives on a file behave like a one-shot: the stick stops being
    # bootable the moment the image is up, so every later reboot falls through
    # to the rescue role. Asked of the machine's boot driver rather than
    # spelled out here -- boot/pi-usb.sh owns the filenames, and this is its
    # b_arm read backwards.
    #
    # Ordered before sysinit rather than at multi-user: the window this closes
    # is "the image came up and then wedged", and the earlier it closes the
    # smaller the window is. DefaultDependencies=no with an explicit
    # After=local-fs.target is the standard shape for that, and it is safe here
    # for the reason the bootcmd deadlock was not -- a rename on an
    # already-mounted filesystem cannot block on systemd.
    if command -v b_self_disarm_sh >/dev/null 2>&1; then
        info "installing the self-disarm into the rootfs (the stick stops booting once this image is up)"
        install_unit "$roff" wk-self-disarm.service "[Unit]
Description=Park this image's second-stage firmware so the next boot is the rescue role
# A rescue is not on the medium this parks, so on one it would disarm somebody
# else's arming.
ConditionPathExists=!/etc/wk/rescue
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '$(b_self_disarm_sh)'
[Install]
WantedBy=sysinit.target
" sysinit.target
    fi

    # The reason this image exists. No sandbox, no host to ask: the profiling
    # knobs are simply ours here -- and in the rootfs, so systemd-sysctl reads
    # them on the boot that matters rather than on a second boot a one-shot
    # image never gets.
    install_file "$roff" /etc/sysctl.d/90-wk-perf.conf "kernel.perf_event_paranoid = -1
kernel.kptr_restrict = 0
"

    # The firmware already pins the ARM clock (force_turbo in the profile's
    # config.txt.append), and this is the other half of the same intent: with
    # `ondemand` still selected, the kernel is entitled to ask for a lower
    # operating point, and "the firmware happens to win" is not a property to
    # measure against. Best-effort -- a kernel with no cpufreq driver for this
    # board has nothing to set, and that is not a reason to fail the boot.
    install_unit "$roff" wk-cpu-governor.service "[Unit]
Description=Pin every CPU to the performance governor for the duration
After=local-fs.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do \
  [ -w \"\$g\" ] && echo performance > \"\$g\"; done; true'
[Install]
WantedBy=multi-user.target
"

    # A run that swaps is a run whose number means nothing, so the image
    # refuses to carry any. The Ubuntu raspi base ships none, which makes this
    # a guard rather than a change -- and a guard is the point: swap that
    # appears later (a package, a stray dphys-swapfile) would otherwise be
    # invisible until it showed up as variance nobody could explain.
    install_unit "$roff" wk-no-swap.service "[Unit]
Description=Refuse to carry swap, so a benchmark cannot page
After=local-fs.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/swapoff -a
[Install]
WantedBy=multi-user.target
"

    # Written where the driving machine can read it offline, by mounting the
    # boot device from the machine's other role. This is the channel that
    # works precisely when the network is the thing that failed.
    install_unit "$roff" wk-diag.service "[Unit]
Description=Dump boot and network state where it can be read offline
After=network.target cloud-init.service
[Service]
Type=oneshot
TimeoutStartSec=600
ExecStart=/bin/sh -c 'wk_bootfs() { for d in /boot/firmware /boot; do \
  [ -d \"\$d\" ] && findmnt -no TARGET \"\$d\" >/dev/null 2>&1 && { echo \"\$d\"; return; }; done; echo /boot; }; \
  sleep 90; { date -Is; cat /etc/wk-image 2>/dev/null; \
  echo; findmnt -no SOURCE,TARGET /; findmnt -no SOURCE,TARGET \"\$(wk_bootfs)\"; \
  echo; rfkill list 2>&1; iw reg get 2>&1; ip -br addr; ip route; \
  echo; networkctl status --no-pager 2>&1 | head -40; \
  echo; cloud-init status --long 2>&1; \
  echo; journalctl -b -u systemd-networkd -u wpa_supplicant -u cloud-init \
    -u cloud-init-local --no-pager 2>&1 | tail -120; } \
  > \"\$(wk_bootfs)/wk-diag.txt\" 2>&1; sync'
[Install]
WantedBy=multi-user.target
"
}

# --- build -------------------------------------------------------------------

cmd_build() {
    local profile="${1:-}"
    [ -n "$profile" ] || usage

    # Every configuration there is, and nothing built. `wk sysimage ls` answers
    # the other question -- which images *exist* -- and the two are not the same
    # question now that an image is bytes in a workspace rather than a row in a
    # catalogue: a configuration can be buildable and have been built never.
    if [ "$profile" = --list ]; then
        image_profile_list
        exit 0
    fi

    image_profile_load "$profile" || die "unknown profile '$profile'.
    'wk sysimage build --list' has every configuration; 'wk sysimage ls' has
    every image a workspace here has already built."
    shift

    # A configuration that declares what it is missing is refused here, in the
    # first second, rather than in hour four of a bitbake or hour eight of a
    # buildroot run. CFG_NEEDS is the config file's own statement of the input it
    # does not have -- a defconfig nobody has written, a targets.conf section
    # that is not on the branch -- and it names the remedy because a refusal that
    # does not is a dead end (CLAUDE.md, "Refusals").
    [ -z "${CFG_NEEDS:-}" ] || die "'$profile' cannot be built yet:

    $CFG_NEEDS

    The configuration is declared in $(image_config_file "$profile"), which is
    where the missing piece goes once it exists."

    # One verb, dispatched on the profile rather than on a flag: which mechanism
    # makes an image is a property of the image, and asking the caller to say it
    # as well would be a second copy of one fact -- and one that can disagree.
    #
    # No default: a profile that names no builder is refused by name rather than
    # falling through to whichever path is written first. Every builder produces
    # its image where it builds it -- a workspace, or a build host -- so "the
    # image lives where the builder left it" holds with no exception.
    case "${IMG_BUILDER:-}" in
        # Downloaded rather than built: no workspace, no source, and the pin is
        # by content. The only builder whose output is an input.
        fetch)     fetch_build "$profile" "$@"; return $? ;;
        # A phone, built by pmbootstrap on a Linux machine over ssh. Not a
        # machine and not a workspace: the build host holds the output.
        pmos)      pmos_build  "$profile" "$@"; return $? ;;
        # Both need a workspace target resolved before the builder can refuse a
        # remote or VM one, and load_target is this file's business.
        buildroot) load_target "${WK_TARGET:-$(default_target)}"; buildroot_build "$profile" "$@"; return $? ;;
        yocto)     load_target "${WK_TARGET:-$(default_target)}"; yocto_build     "$profile" "$@"; return $? ;;
        '')  die "profile '$profile' names no builder.
    Every profile declares IMG_BUILDER and there is no default (wk help images).
    image/profiles.sh is where this one is defined." ;;
        *)   die "profile '$profile' names builder '$IMG_BUILDER', which does not exist.
    There are four: yocto, buildroot, pmos, fetch." ;;
    esac
}

# --- the rest ----------------------------------------------------------------

# What a workspace's build is doing right now, from the pid the detached build
# recorded. Evidence, not a claim: `yocto.status` says `state=running` for ever
# on a detached build (docs/TESTING.md, defects), so it is not asked.
_ws_building() { # <workspace>
    local pid
    pid=$(cat "$(wk_ws_dir "$1")/home/yocto-image.pid" 2>/dev/null) || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

# The profile a workspace was made for. `yocto-<profile>` is what image/yocto.sh
# names its workspaces, so this is derivable rather than a second record.
_ws_profile() { case "$1" in yocto-*) printf '%s' "${1#yocto-}" ;; *) return 1 ;; esac; }

cmd_ls() {
    local n=0 builder ws path bytes mtime prof machine note
    local rows; rows=$(image_workspace_scan)

    while IFS="$(printf '\t')" read -r builder ws path bytes mtime; do
        [ -n "${builder:-}" ] || continue
        n=$((n + 1))

        prof=$(_ws_profile "$ws" || printf '')
        machine=""; note=""
        if [ -n "$prof" ]; then
            # In a subshell: loading a profile sets a screenful of globals, and
            # this is a listing, not a command acting on one image.
            machine=$( image_profile_load "$prof" >/dev/null 2>&1 \
                       && printf '%s' "${IMG_MACHINE:-}" ) || true
            [ -n "$machine" ] || note="this checkout does not define '$prof'"
        fi

        printf '%-40s %-10s %-8s %-8s %s\n' \
            "$ws" "${machine:-?}" "$builder" "$(human_bytes "$bytes")" "$mtime"
        # Where it is. The whole point of there being no store: this path is the
        # image, and nothing copied it anywhere.
        printf '    %s\n' "$path"
        _ws_building "$ws" && printf '    %s\n' "a build is running in this workspace -- these bytes may be the previous one"
        [ -z "$note" ] || printf '    %s\n' "$note"
    done <<ROWS
$rows
ROWS

    if [ "$n" -eq 0 ]; then
        log "no workspace here has built an image."
        log "  'wk sysimage build <profile>' builds one; it stays in the workspace"
        log "  that built it (wk help images)."
        return 0
    fi

    log ""
    log "$n image$([ "$n" = 1 ] || printf s), each in the workspace that built it."
    log "  There is no image store: the workspace is the name (wk help images)."
    log "  To write one:  wk sysimage write --from <path above> --disk <machine>:<device>"
    log "                 add --rescue for the system a board falls back to"
    return 0
}

cmd_show() {
    local id="${1:-}"
    [ -n "$id" ] || usage
    image_complete "$id" || die "no such image: $id"
    cat "$(image_manifest "$id")"
    image_verify "$id" && log "disk.img matches its manifest"
}

cmd_rm() {
    local id="${1:-}"
    [ -n "$id" ] || usage
    [ -d "$(image_dir "$id")" ] || die "no such image: $id"
    confirm "delete image $id?" || die "not deleted"
    rm -rf "$(image_dir "$id")"
    info "deleted $id"
}

# --- write -------------------------------------------------------------------

cmd_disks() {
    local machine="${1:-}"
    [ -n "$machine" ] || die "usage: wk sysimage disks <machine>
    machines:
$(machine_list | sed 's/^/      /')"
    machine_load "$machine" || die "unknown machine '$machine'"
    m_reachable || die "$machine is not reachable over ssh"
    log "removable disks attached to $machine:"
    disk_list
    log ""
    log "  write one with:  wk sysimage write --from <path> --disk $machine:<device>"
    log "  ('wk sysimage ls' prints the paths)"
    log "  a machine's own system disk is never listed and never writable."
}

# wk sysimage write <image> --disk <machine>:<device>
#
# One verb, whether the disk is the one the machine is configured to boot from
# or any other removable disk plugged into it: same verification, same unmount,
# same refusals, and the stricter device policy is the right one for both.
# boot/disk.sh has the naming argument.

# What the dry run says about an image's root, including when it says nothing.
#
# An image whose bootloader is not a Raspberry Pi's firmware -- a phone's -- has
# no cmdline.txt to read, and that is a question that does not apply to it
# rather than a fault in it. Saying so is the difference.
_root_line() {
    local spec; spec=$(image_root_spec "$1")
    if [ -z "$spec" ]; then
        printf 'not declared in a cmdline.txt -- this image does not boot that way'
    else
        printf '%s -- %s' "$spec" "$(image_root_word "$(image_root_class "$spec")")"
    fi
}

# Writing an image that is not in a store, because there is no store.
#
# `--from` is the whole of the model in `wk help images`: a workspace built an
# image, the bytes are wherever it put them, and this moves them onto a card and
# then edits the card. Nothing is imported, catalogued or hashed into a
# directory of artifacts on the way.
#
# Two spellings of where the bytes are, and the second is not a convenience:
#
#   --from /path                a file this machine can read
#   --from vm:/path             a file inside this machine's podman VM, which is
#                               where a container workspace's build output lives
#                               and which a macOS driver cannot open directly.
#
# The identity written onto the card is derived here rather than looked up:
# `<name>-<first 12 of the sha256>`. That names the content instead of a slot in
# a catalogue, which is what makes a catalogue unnecessary -- and the hash is
# read off the source before the write, so the marker describes the bytes that
# actually went on.
# The decompressor a path needs, by what it is, or `cat`.
#
# A yocto build leaves its image as `<recipe>.wic.xz` and nothing decompresses it
# on the way to a card any more -- the store used to, on import, and there is no
# store (wk help images). Writing the compressed stream straight to a disk
# produces a card that is not bootable and a sha256 that describes the wrong
# bytes, and neither failure says anything at the time.
#
# Named extensions rather than sniffing content: what the builders here produce
# is known (yocto: .wic.xz; buildroot: an uncompressed .img from genimage), and a
# reader that guesses is a reader that guesses wrong on the day somebody adds a
# format. Anything unrecognised is passed through unchanged, which is correct for
# a raw image and is what the refusal below catches when it is not.
_from_filter() { # <path> -- prints the command that turns those bytes into an image
    case "$1" in
        *.xz)  printf 'xz -dc'  ;;
        *.zst) printf 'zstd -dc' ;;
        *.gz)  printf 'gzip -dc' ;;
        *)     printf 'cat' ;;
    esac
}

_from_reader() { # <spec> -- prints a command that emits the image on stdout
    local filter
    filter=$(_from_filter "${1#vm:}")
    case "$1" in
        vm:*) is_macos || die "--from vm:<path> is for reading a container workspace's
    output out of this machine's podman VM, and this is not a macOS host. Give a
    plain path."
              printf 'podman machine ssh %s -- sudo cat %s | %s' \
                  "${WK_MACHINE:-wk}" "$(sh_quote "${1#vm:}")" "$filter" ;;
        *)    [ -r "$1" ] || die "no image at $1
    An image lives where the workspace that built it put it (wk help images). If
    that is inside this machine's podman VM, say so: --from vm:$1"
              if [ "$filter" = cat ]; then
                  printf 'cat %s' "$(sh_quote "$1")"
              else
                  printf '%s %s' "$filter" "$(sh_quote "$1")"
              fi ;;
    esac
}

# The profile a path implies, from the workspace in it.
#
# `image/yocto.sh` names its workspaces `yocto-<profile>` and the image sits
# under `$WK_STORE/ws/<workspace>/...`, so the path already carries the answer
# and asking for --profile as well is asking somebody to retype a fact. Only
# used when --profile was not given; an explicit one always wins.
_profile_from_path() { # <path>
    local ws
    ws=$(printf '%s' "$1" | sed -n 's|.*/ws/\([^/]*\)/.*|\1|p')
    case "$ws" in
        yocto-*) printf '%s' "${ws#yocto-}" ;;
        *) return 1 ;;
    esac
}

cmd_write_from() { # <from-spec> <disk-spec> <dry> <grow> <profile> <role>
    local from="$1" spec="$2" dry="$3" grow="$4" profile="$5" role="$6"
    local reader sha size marker base

    reader=$(_from_reader "$from")

    # Derived before the profile is used for anything, so that the machine the
    # image is for -- which decides the tailnet name the card is seeded with --
    # is known on a write that named only a path.
    if [ -z "$profile" ]; then
        profile=$(_profile_from_path "${from#vm:}" || true)
        [ -z "$profile" ] || debug "profile '$profile' derived from the path"
    fi
    # Probed in a subshell before it is loaded for real, and that is not
    # defensiveness: image_profile_load *dies* on a name it does not define --
    # every tombstone in image/profiles.sh is a `die` -- and `die` exits. An
    # `|| warn` cannot catch an exit, so calling it directly here ends the whole
    # command, silently if its output was redirected. The subshell turns that
    # exit into a status, and the message it would have printed is worth showing.
    if [ -n "$profile" ]; then
        local _perr
        if _perr=$( image_profile_load "$profile" 2>&1 >/dev/null ); then
            image_profile_load "$profile" >/dev/null 2>&1 || true
        else
            warn "this write cannot tell which machine the card is for, so there is no
  firmware check and no tailnet name to seed. Pass --profile with a
  configuration this checkout defines."
            [ -z "$_perr" ] || printf '%s\n' "$_perr" | sed 's/^/    /' >&2
        fi
    fi

    disk_parse "$spec"
    machine_load "$DISK_MACHINE" || die "unknown machine '$DISK_MACHINE'
    machines:
$(machine_list | sed 's/^/      /')"
    m_reachable || die "$DISK_MACHINE is not reachable over ssh, and the disk is attached to it."
    [ -n "$DISK_DEV" ] || { log "disks attached to $DISK_MACHINE:"; disk_list
        die "say which one: --disk $DISK_MACHINE:<device>"; }

    # Read once for the size and the hash, before anything is written: the
    # marker has to describe the bytes that go on the card, and a card that
    # cannot fit them should be refused before it is erased.
    info "reading $from"
    sha=$(eval "$reader" | shasum -a 256 2>/dev/null | cut -d' ' -f1)
    [ -n "$sha" ] || die "could not read the image through: $reader"
    size=$(eval "$reader" | wc -c | tr -d ' ')
    disk_refuse_unless_safe "$DISK_DEV" "$size"

    # The id names what this is and which bytes it is, and nothing else -- there
    # is no catalogue for it to be a slot in (wk help images). The profile when
    # there is one, because that is what the image *is*; otherwise the file's
    # own name with the compression suffix taken off, since the bytes that reach
    # the card are the decompressed ones and an id ending `.wic.xz` would
    # describe a stream nobody wrote.
    base=$(basename "${from#vm:}")
    base=${base%.xz}; base=${base%.zst}; base=${base%.gz}
    base=${base%.wic}; base=${base%.img}
    marker="id=${profile:-$base}-$(printf '%s' "$sha" | cut -c1-12)
profile=${profile:-unknown}
machine=${IMG_MACHINE:-}
role=$role
built_by=$(hostname)
wk_tools=$(git -C "$WK_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)
source=$from
sha256=$sha"

    if [ -n "$dry" ]; then
        cat >&2 <<EOF
would write
  image     $from ($(human_bytes "$size"))
  identity  $(printf '%s' "$marker" | sed -n 's/^id=//p')
  onto      $DISK_DEV attached to $DISK_MACHINE
  then      unique disk identity, fleet integration (marker + driving key),
            tailnet identity, $([ "$grow" = 1 ] && echo "grow to fill" || echo "NO grow -- the rest of the card is left for a second system")
EOF
        log "dry run -- nothing was written."
        return 0
    fi

    warn "this ERASES $DISK_DEV on $DISK_MACHINE, whatever is on it now."
    confirm "write $from onto $DISK_DEV attached to $DISK_MACHINE?" || die "not written"

    disk_unmount "$DISK_DEV"
    eval "$reader" | disk_write_stream "$DISK_DEV"
    disk_unique_identity "$DISK_DEV" "$(_card_root_spec "$DISK_DEV")"
    disk_install_fleet "$DISK_DEV" "$marker" "$(driving_key)"
    disk_seed_role "$DISK_DEV" "$role"
    disk_seed_tailnet "$DISK_DEV" "$(_tailnet_name_for "${IMG_MACHINE:-}")"

    # Growing is opt-in here and that is the point. A card grown to fill has no
    # room for a second system, and a board with one system has no rescue -- so
    # it cannot install anything without a person, which is the state this whole
    # design exists to leave behind (wk help hardware).
    if [ "$grow" = 1 ]; then
        disk_grow "$DISK_DEV"
    else
        log "  the root partition was left at its built size, so the rest of the card"
        log "  is free for a second system. --grow fills it instead."
    fi
    disk_eject "$DISK_DEV"
    info "$DISK_DEV on $DISK_MACHINE now holds $(printf '%s' "$marker" | sed -n 's/^id=//p')"
}

# The `root=` the freshly written card's own cmdline names, read off the card.
#
# `disk_unique_identity` stamps a new disk identity and rewrites every reference
# to the old one, so it has to be told what the old one was. With a store that
# came from the manifest; without one it comes from the only place that is
# certainly right -- the boot partition that was just written.
_card_root_spec() { # <device>
    local p1; p1=$(disk_part "$1" 1)
    m_ssh "set -e
        m=\$(mktemp -d)
        sudo mount -o ro $(sh_quote "$p1") \$m
        for f in \$m/cmdline.txt \$m/current/cmdline.txt; do
            [ -f \"\$f\" ] || continue
            tr ' ' '\n' < \"\$f\" | sed -n 's/^root=//p' | head -1
            break
        done
        sudo umount \$m; rmdir \$m" 2>/dev/null | tr -d '\r' | head -1
}

# The fleet's name for a machine, without clobbering the MACH_* of the machine
# every remote command here is talking to.
_tailnet_name_for() {
    [ -n "${1:-}" ] || return 0
    ( machine_load "$1" >/dev/null 2>&1 && printf '%s' "${MACH_SSH:-}" ) || true
}

cmd_write() {
    local id="" spec="" dry="" grow=1 grow_set="" from="" profile="" role=bench
    while [ $# -gt 0 ]; do
        case "$1" in
            --disk)    spec="${2:-}"; [ -n "$spec" ] || die "--disk needs <machine>:<device>"; shift 2 ;;
            --from)    from="${2:-}"; [ -n "$from" ] || die "--from needs a path, or vm:<path>"; shift 2 ;;
            --profile) profile="${2:-}"; shift 2 ;;
            --rescue)  role=rescue; shift ;;
            --dry-run) dry=1; shift ;;
            --grow)    grow=1; grow_set=1; shift ;;
            --no-grow) grow=0; grow_set=1; shift ;;
            -*) die "unknown option: $1" ;;
            *)  [ -z "$id" ] || die "unexpected argument: $1"; id="$1"; shift ;;
        esac
    done

    # A rescue leaves the rest of the card alone unless told otherwise, because
    # on the board where that matters most -- the rpi3, one medium holding both
    # systems -- growing the rescue to fill the card is what makes the board
    # unable to install a bench system without a person in the room
    # (`wk help hardware`). Explicit --grow still wins.
    if [ "$role" = rescue ] && [ -z "$grow_set" ]; then grow=0; fi

    # A store-free write is a different path from top to bottom: no manifest to
    # gate on, no id to look up, and the edits happen on the card afterwards.
    if [ -n "$from" ]; then
        [ -z "$id" ] || die "give --from <path> or an image id, not both"
        [ -n "$spec" ] || die "usage: wk sysimage write --from <path|vm:path> --disk <machine>:<device>"
        # Default for a store-free write: leave the rest of the card alone, so
        # there is room for the second system that makes the board able to
        # provision itself. The id path keeps its grow-to-fill default.
        [ -n "$grow_set" ] || grow=0
        cmd_write_from "$from" "$spec" "$dry" "$grow" "$profile" "$role"
        return $?
    fi

    [ -n "$id" ] || die "usage: wk sysimage write --from <path> --disk <machine>:<device>
    An image is bytes a workspace produced, not an id in a catalogue
    (wk help images), so what identifies one is its path.
    'wk sysimage ls' lists every image a workspace here has built, with the
    path to pass to --from."
    [ -n "$spec" ] || die "usage: wk sysimage write $id --disk <machine>:<device>
    'wk sysimage disks <machine>' lists what is attached where."

    image_complete "$id" || die "no such image: $id
    Nothing here is addressed by id any more (wk help images). 'wk sysimage ls'
    lists what the workspaces have built; pass its path to --from."

    disk_parse "$spec"
    machine_load "$DISK_MACHINE" || die "unknown machine '$DISK_MACHINE'
    machines:
$(machine_list | sed 's/^/      /')"
    m_reachable || die "$DISK_MACHINE is not reachable over ssh, and the disk is attached to it."
    machine_armed_barrier "Writing a disk now would overwrite the medium that boot is aimed at,
    and the machine would come up on whatever this write left behind."

    # No device: say what is there rather than guessing. Guessing which /dev/sd*
    # is the card is the mistake this command exists to make impossible.
    if [ -z "$DISK_DEV" ]; then
        log "disks attached to $DISK_MACHINE:"
        disk_list
        die "say which one: --disk $DISK_MACHINE:<device>"
    fi

    local bytes; bytes=$(file_bytes "$(image_disk "$id")")
    disk_refuse_unless_safe "$DISK_DEV" "$bytes"
    # Two checks, in the order the board will hit them: can the firmware reach
    # a kernel at all, and then can that kernel reach its root. The first is
    # the one that costs a trip to the device (lib/image.sh), so it goes first.
    # Only when the image is *for* this machine. The check asks whether this
    # machine's firmware can find a kernel on the disk, which is the right
    # question when the card stays where it is being written -- and the wrong
    # one for a card that is about to be carried somewhere else. A bridge image
    # is written on whichever machine holds the reader and then goes into a
    # phone, so checking it against the reader's firmware would refuse a
    # perfectly good image for a machine that is never going to boot it.
    local img_machine boot_checked=""; img_machine=$(manifest_get "$id" machine)
    if [ -n "$img_machine" ] && [ "$img_machine" = "$DISK_MACHINE" ]; then
        image_check_boot_files "$id" "$DISK_MACHINE"
        boot_checked=1
    elif [ -n "$img_machine" ]; then
        log "  (not checking $DISK_MACHINE's boot files: $id is $img_machine's image, so this card goes elsewhere)"
    else
        log "  (not checking $DISK_MACHINE's boot files: $id names no machine -- $(manifest_get "$id" device \
             | sed 's/^$/it/;s/^\(.\)/a \1/') image, and the card goes into it, not into $DISK_MACHINE)"
    fi
    image_check_root "$id" "$DISK_DEV" "$DISK_MACHINE"

    local mounted
    mounted=$(disk_mounted "$DISK_DEV")

    if [ -n "$dry" ]; then
        cat >&2 <<EOF
would write
  image     $id ($(human_bytes "$bytes"))
  its root  $(_root_line "$id")
  boot part $([ -n "$boot_checked" ] \
      && printf 'every file a %s'"'"'s firmware asks for resolves (checked before this line)' "$DISK_MACHINE" \
      || printf 'not checked -- this image is not %s'"'"'s, so its firmware is not the one that will read it' "$DISK_MACHINE")
  onto      $DISK_DEV attached to $DISK_MACHINE ($(m_ssh "lsblk -dno SIZE,TRAN,MODEL $DISK_DEV" 2>/dev/null | tr -s ' '))
  mounted   ${mounted:-nothing}
  method    zstd stream through the card helper, then read back and compare sha256
  grow      $([ "$grow" = 1 ] && echo "yes, partition 2 to fill the disk" || echo "no -- the rest of the card is left for a second system")
  role      $role$([ "$role" = rescue ] \
      && printf ' -- the self-return watchdog and the self-disarm stay inert on it' \
      || printf ' -- it returns itself after %s s unless claimed' "${IMG_WATCHDOG:-?}")
EOF
        [ "$DISK_DEV" = "${MACH_DEVICE:-}" ] && log "  note      $DISK_MACHINE is configured to boot from this disk (wk boot $DISK_MACHINE)"
        log "dry run -- nothing was written."
        return 0
    fi

    image_verify "$id" || die "refusing to write an image that does not match its manifest"

    warn "this ERASES $DISK_DEV on $DISK_MACHINE, whatever is on it now."
    [ -n "$mounted" ] && printf '%s\n' "$mounted" | sed 's/^/    /' >&2
    confirm "write $id onto $DISK_DEV attached to $DISK_MACHINE?" || die "not written"

    disk_unmount "$DISK_DEV"
    disk_write_dd "$(image_disk "$id")" "$DISK_DEV"
    [ -n "${WK_NO_VERIFY:-}" ] || disk_verify_dd "$(image_disk "$id")" "$DISK_DEV"
    disk_unique_identity "$DISK_DEV" "$(image_root_spec "$id")"

    # The name this card's board answers to on the tailnet, which is the fleet's
    # ssh name for the machine the image is *for* -- not for $DISK_MACHINE,
    # which is only whoever holds the reader. Read in a subshell on purpose:
    # machine_load would otherwise overwrite the MACH_* of the machine every
    # remote command in this function is talking to.
    disk_seed_role "$DISK_DEV" "$role"
    disk_seed_tailnet "$DISK_DEV" "$(_tailnet_name_for "$img_machine")"

    [ "$grow" = 1 ] && disk_grow "$DISK_DEV"
    disk_eject "$DISK_DEV"

    info "$DISK_DEV on $DISK_MACHINE now holds $id"
    if [ "$DISK_DEV" = "${MACH_DEVICE:-}" ]; then
        # "Writing did not arm anything" is true of a one-shot, whose arming is
        # a firmware call nobody made. It is *false* of a medium-armed machine
        # unless this makes it true: the arming there is the presence of the
        # second-stage firmware on the boot partition, and the image being
        # written brings its own. So a plain write would leave the board booting
        # the new image on its next reboot, whoever caused it, with no record
        # and nobody having asked -- which is precisely the surprise `wk boot`
        # exists to make deliberate.
        if load_driver "${MACH_DRIVER:-}" 2>/dev/null \
           && [ "${BOOT_ARMING:-one-shot}" = medium ] \
           && command -v b_disarm >/dev/null 2>&1; then
            b_disarm
            debug "$DISK_MACHINE's $DISK_DEV was left disarmed"
        fi
        log "  $DISK_MACHINE is configured to boot from this disk, but writing it"
        log "  did not arm anything. To boot it -- once, reverting by itself:"
        log "      wk boot $DISK_MACHINE"
    else
        log "  nothing boots this yet. Move it to the board it is for, or point a"
        log "  machine at it; 'wk boot <machine>' is the one-shot."
    fi
}

# `flash` is gone, and the message says why rather than just where.
#
# It named the wrong thing twice over: "flash <machine>" reads as reflashing the
# machine, which never happened and is refused; and "flash" implies permanence,
# where a machine boots one of these disks once and reverts on its own. See
# boot/disk.sh.
cmd_flash() {
    local machine="${1:-<machine>}"
    die "'wk sysimage flash' does not exist -- it named the wrong thing twice.

    'flash <machine>' reads as reflashing $machine. That never happened: the
    machine's own system disk is refused, and what gets written is a removable
    disk plugged into it. And nothing here is permanent -- a machine boots such
    a disk once, by a firmware one-shot, and returns to host mode by itself.

    So the disk is named, and the verb says what it does to it:

        wk sysimage disks $machine                  what is attached over there
        wk sysimage write --from <path> --disk $machine:<device>

    Booting it is still a separate step, and still one-shot:  wk boot $machine"
}

# --- wk sysimage retarget -----------------------------------------------------
#
# Apply to an image already in the store what the import now does on the way in:
# a root reference that survives being written to a different kind of device, the
# driving ssh key, and a compressed copy that matches the result.
#
# It exists because a Yocto build is hours and this is seconds. An image built
# before the import learned any of it is not wrong -- it is a distribution,
# faithfully imported -- it just cannot be written to the disk its machine
# actually boots. Rebuilding to change two text files would be the wrong trade.
#
# Idempotent: an image that is already portable and already carries the key is
# reported as such and nothing is written.
cmd_retarget() {
    local id="${1:-}"
    [ -n "$id" ] || die "usage: wk sysimage retarget <id>"
    image_complete "$id" || die "no such image '$id' (wk sysimage ls)"

    image_lock

    # Before, so that a mismatch is reported as a mismatch rather than quietly
    # becoming this command's output.
    image_verify "$id" || die "'$id' does not match its manifest, so there is no
    known image here to retarget. Rebuild it."

    local dir; dir=$(image_dir "$id")
    DISK="$dir/disk.img"
    FAT_OFFSET=$(fat_offset "$DISK")
    [ -n "$FAT_OFFSET" ] && [ "$FAT_OFFSET" -gt 0 ] \
        || die "could not find the boot partition in $DISK"

    local was; was=$(image_root_spec "$id")

    # The profile, so that the fleet integration below has the fields it
    # records: which machine, which watchdog, which driver's self-disarm.
    # Loaded from the manifest rather than asked for, because the image already
    # knows what it is.
    local profile; profile=$(manifest_get "$id" profile)
    image_profile_load "$profile" \
        || die "'$id' records profile '$profile', which this checkout does not define"
    ID="$id"
    built=$(manifest_get "$id" built)

    SEED=$(mktemp -d)
    wk_atexit _seed_cleanup

    local roff; roff=$(part_offset "$DISK" 2)

    # The identity marker is what every other verb here reads to tell a booted
    # bench system from a machine that never left host mode, so an image
    # without one is invisible: `wk boot --status` cannot see it, and on a
    # medium-armed machine the stick therefore stays armed for ever. Installed
    # when it is absent rather than assumed present -- images imported before
    # the yocto builder learned to do this have none.
    if debugfs -R "stat /etc/wk-image" "$DISK?offset=$roff" 2>/dev/null | grep -q '^Inode:'; then
        debug "the image already carries its identity marker"
    else
        info "adding the fleet integration (identity marker, watchdog, self-disarm)"
        install_fleet_integration "$roff"
    fi

    install_driving_key "$roff"
    install_disk_id
    retarget_root "$SEED"
    apply_cmdline_append "$SEED"
    rm -rf "$SEED"; SEED=""

    info "hashing the image"
    local sha; sha=$(sha256sum "$DISK" | cut -d' ' -f1)

    # The manifest last and atomically, the same publishing gate as a build:
    # a crash before this leaves the old manifest, which `image_verify` then
    # reports as a mismatch -- loudly, and without having destroyed anything.
    local m; m=$(image_manifest "$id")
    {
        grep -vE '^(disk_sha256|disk_bytes|retargeted_from)=' "$m"
        echo "disk_bytes=$(file_bytes "$DISK")"
        echo "disk_sha256=$sha"
        [ "$was" = "$(cmdline_root_spec)" ] || echo "retargeted_from=$was"
        case "${CMDLINE_APPENDED:-}" in
            *video=*) echo "display_forced=${CMDLINE_APPENDED#*video=}" ;;
        esac
    } > "$m.new"
    mv "$m.new" "$m"

    local now; now=$(cmdline_root_spec)
    log "$id"
    log "  root      $now  ($(image_root_word "$(image_root_class "$now")"))"
    log "  next:  wk sysimage write $id --disk <machine>:<device>"
}

case "${1:-}" in
    build) shift; cmd_build "$@" ;;
    ls|list) shift; cmd_ls "$@" ;;
    show) shift; cmd_show "$@" ;;
    disks) shift; cmd_disks "$@" ;;
    write) shift; cmd_write "$@" ;;
    flash) shift; cmd_flash "$@" ;;
    retarget) shift; cmd_retarget "$@" ;;
    rm) shift; cmd_rm "$@" ;;
    *) usage ;;
esac
