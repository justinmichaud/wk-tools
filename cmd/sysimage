#!/usr/bin/env bash
#
# wk sysimage <sub> [args] -- build and manage bootable systems
#
# wk: where=host name=none group=hosts
# wk: readonly ls,disks
#
# An image is a whole machine, built from a spec in this repo, that a machine
# can be put into for one boot and taken out of again. It exists because four
# later steps all need the same thing -- a machine with no sandbox, whose
# kernel knobs are ours to set (docs/HANDOFF-boot.md).
#
# There is no image store (`wk help`): a build leaves its bytes wherever its
# builder put them -- a workspace, a build host -- and `wk sysimage write
# --from` streams those bytes onto a card in one pass. The card takes the
# image's own bytes; every edit an image needs is made afterwards, on the
# card, by the machine holding the reader (admin/wk-card-priv) -- so this
# machine needs no tooling that can read a Linux filesystem.
#
#   build <profile> [--dry-run]  build from the spec in this repo. A yocto
#                                profile also takes --workspace, --stage,
#                                --detach, --stop, --keep-work; a pmos profile
#                                takes --detach and --resume and builds on a
#                                Linux aarch64 machine over ssh
#   webkit <profile> --commit <sha> --slot <name> [--detach] [--dry-run]
#                                build one WebKit commit into a named slot
#                                beside the image, the way its builder builds
#                                WebKit: buildroot's own wpewebkit package, or
#                                WebKit's build-webkit --cross-target on a
#                                yocto image's toolchain.
#                                A board running the image carries any number
#                                of slots and 'wk pi bench --ab' alternates
#                                two of them with no reflash and no reboot
#   ls | list                   every image a workspace here has built, its
#                                slots, and
#                                where it is -- there is no store; the
#                                workspace that built an image is its name
#                                (wk help)
#   disks <machine>             removable disks attached to that machine
#   write --from <path> --disk <machine>:<device>[@second]
#                                write that image to that disk, and make it a
#                                fleet system on the card;
#                                --from takes a path 'wk sysimage ls' printed
#                                (or vm:<path>, inside this machine's podman
#                                VM). Never touches a machine's own system
#                                disk -- only a removable disk plugged into
#                                it -- and writing it does not make anything
#                                boot it ('wk boot' does).
#                                <device>@second writes the image into
#                                partitions 3 and 4 beside a rescue on 1-2
#                                (a board with one medium, the rpi3), from a
#                                reader or from that rescue itself
#       --profile <name>         which configuration this image is, when the
#                                path does not already say (a yocto path does)
#       --machine <name>         the fleet machine (boot/machines/<name>.conf)
#                                the card is for, when --profile does not
#                                already say -- the tailnet name the card
#                                joins under comes from here
#       --rescue                 write it as the board's rescue system: the
#                                units that hand a machine back stay inert
#       --grow | --no-grow       fill the disk with the root partition, or
#                                leave it at its built size
#   rm <name>                   tombstone -- the image lives in the workspace
#                                that built it; 'wk rm <workspace>' removes it

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/image.sh"
. "$WK_ROOT/image/profiles.sh"
. "$WK_ROOT/boot/machines.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/resources.sh"

wkslot() { python3 "$WK_ROOT/lib/wkslot.py" "$@"; }
. "$WK_ROOT/boot/disk.sh"
. "$WK_ROOT/image/yocto.sh"
. "$WK_ROOT/image/buildroot.sh"
. "$WK_ROOT/image/pmos.sh"
. "$WK_ROOT/image/fetch.sh"

# Acts on physical machines -- a boot device, a firmware register, a disk
# image -- and the sandbox cannot reach any of it. `wk`'s is_host_only list
# covers the dispatcher path; this covers cmd/sysimage run directly.
if in_workspace; then
    die "'wk $(basename "$0")' acts on a host and its hardware, and this is
    workspace '$(wk_self)'. Run it on the workstation instead."
fi

# Where the units are composed before they are handed to the card as one
# archive (disk_install_units): scratch, removed either way the process ends.
_seed_cleanup() { [ -n "${SEED:-}" ] && rm -rf "$SEED"; SEED=""; return 0; }

# Where the streamed write leaves the byte count and hash of what went past
# (disk_stream_meter, boot/disk.sh): the image itself is never materialized
# here, but the read-back verify needs something to compare against.
_disk_cleanup() { [ -n "${WRITE_META:-}" ] && rm -f "$WRITE_META"; WRITE_META=""; return 0; }

# --- what a written system is called, and whose key it takes -------------------

# The name a written system is known by: the profile it was built from (or,
# with no profile, the source file's own name), and the first 12 hex of the
# sha256 of the bytes that went onto the card. One expression, so the dry run
# and the write cannot name a system differently -- before the write there is
# no hash to name it by, and it says so.
_image_id() { # <name> <sha256 of the written bytes, empty before the write>
    if [ -n "${2:-}" ]; then
        printf '%s-%.12s' "$1" "$2"
    else
        printf '%s-<the written image sha256>' "$1"
    fi
}

# The public key the image will accept. Reaching the board over Tailscale SSH
# needs no key at all, so a working session is not evidence the image has the
# right one -- it has to be named here.
driving_key() {
    local k="${WK_IMAGE_KEY:-$HOME/.ssh/id_ed25519.pub}"
    [ -r "$k" ] || die "no public key at $k
    The image has to accept an ssh key on first boot, or it comes up
    unreachable. Set WK_IMAGE_KEY to the one this machine should use."
    cat "$k"
}

# --- what a fleet system carries -----------------------------------------------
#
# The bodies below are composed here, where the profile's values are
# (IMG_WATCHDOG, the machine's driver, the spec's own append files), and land
# on the card through a card-helper verb (boot/disk.sh): nothing on this
# machine opens a filesystem inside an image, so a driving machine needs no
# mtools, debugfs or sfdisk.

# One unit, staged for `disk_install_units`, under the name systemd will know
# it by. `systemctl enable` never runs against a card, so the unit's own
# WantedBy= is what decides which <target>.wants it is symlinked into -- the
# same fact systemd reads, stated once, in the unit.
stage_unit() { # <staging dir> <name> <body>
    printf '%s' "$3" > "$1/systemd/$2"
}

# A file for /etc/sysctl.d on the card, same staging, same one verb.
stage_sysctl() { # <staging dir> <name> <body>
    printf '%s' "$3" > "$1/sysctl.d/$2"
}

# What an image runs to park its own arming, from the driver of the machine
# the *image* is for: a board that arms a medium (pi-mbr) has one, a board
# whose card swap is hands-on has none, and neither is an error.
#
# In a subshell, like _tailnet_name_for and for the same reason: MACH_* names
# the machine holding the card reader, which is what every card edit is
# addressed to, and loading another machine here sends the rest of the write
# to the wrong board.
_self_disarm_for() { # <machine>
    [ -n "${1:-}" ] || return 0
    ( machine_load "$1" >/dev/null 2>&1 || exit 0
      [ -n "${MACH_DRIVER:-}" ] || exit 0
      load_driver "$MACH_DRIVER" >/dev/null 2>&1 || exit 0
      command -v b_self_disarm_sh >/dev/null 2>&1 || exit 0
      b_self_disarm_sh ) || true
}

# A BusyBox init's script for one of those jobs: /etc/init.d/S<nn><name>,
# run with `start` by rcS, in name order. Gated on the rescue marker like
# the units are.
stage_init() { # <staging dir> <name> <body -- runs on start, as root>
    printf '#!/bin/sh\n# %s -- staged onto the card by wk sysimage write.\ncase "$1" in start) ;; *) exit 0 ;; esac\n[ -f /etc/wk/rescue ] && exit 0\n%s\n' \
        "$2" "$3" > "$1/init.d/$2"
}

# Everything a rootfs needs to be a *fleet* system rather than merely a
# bootable one: no self-return watchdog means a medium-armed stick stays armed
# forever. Staged at write time, not baked in per builder, and for both inits
# a fleet image runs: systemd units and BusyBox init.d scripts for the same
# two jobs, the card helper installing whichever set the image's init reads
# (disk_install_units).
#
# Everything here goes into every image; the two that hand a machine *back*
# are gated at runtime on /etc/wk/rescue (a marker `wk sysimage write
# --rescue` leaves), which is what makes one built artifact serve both roles.
# Ungated, the watchdog would reboot the helper every IMG_WATCHDOG seconds
# mid-write, and self-disarm would park a medium the image isn't on.
stage_units() { # <staging dir> <self-disarm command, empty when nothing to park>
    local seed="$1" disarm="${2:-}"

    # TimeoutStartSec=infinity is load-bearing: systemd's default 90 s start
    # timeout kills a Type=oneshot that sleeps longer than that before it can
    # ever fire.
    # Skipped rather than written empty when a profile names no watchdog: the
    # unit would be `sleep ` with no argument, which fails on every boot and
    # looks in the journal exactly like a watchdog that ran.
    if [ -z "${IMG_WATCHDOG:-}" ]; then
        warn "$IMG_PROFILE sets no IMG_WATCHDOG, so this image will not hand its machine back"
    else
    stage_unit "$seed" wk-self-return.service "[Unit]
Description=Hand the machine back to host mode unless claimed
# Inert on a rescue system, which is what this would be handing the machine
# back *to*. The marker is written by 'wk sysimage write --rescue'.
ConditionPathExists=!/etc/wk/rescue
[Service]
Type=oneshot
ExecStart=/bin/sh -c 'sleep $IMG_WATCHDOG; [ -f /run/wk-keep-running ] || systemctl reboot'
TimeoutStartSec=infinity
[Install]
WantedBy=multi-user.target
"
    # Last in rcS, so the network and the browser are up when the clock
    # starts; backgrounded, so init does not wait the watchdog out.
    stage_init "$seed" S99wk-self-return \
        "( sleep $IMG_WATCHDOG; [ -f /run/wk-keep-running ] || reboot ) </dev/null >/dev/null 2>&1 &"
    fi

    # A medium-armed machine's image disarms itself: the medium stops being
    # bootable the moment the image is up, so every later reboot falls
    # through to the rescue (b_self_disarm_sh, the machine's driver). `$` is
    # doubled for systemd, which would otherwise expand the script's own
    # variables before sh saw them. Ordered before sysinit, not at multi-user, to keep the
    # "image came up and then wedged" window as small as possible;
    # DefaultDependencies=no with After=local-fs.target is safe because a
    # rename on an already-mounted filesystem cannot block on systemd.
    if [ -n "$disarm" ]; then
        info "staging the self-disarm (the medium stops booting once this image is up)"
        stage_unit "$seed" wk-self-disarm.service "[Unit]
Description=Park this image's second-stage firmware so the next boot is the rescue role
# A rescue is not on the medium this parks, so on one it would disarm somebody
# else's arming.
ConditionPathExists=!/etc/wk/rescue
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '$(printf '%s' "$disarm" | sed 's/[$]/$$/g')'
[Install]
WantedBy=sysinit.target
"
        # Right after udev (S10udev) has made the /dev/disk links the
        # command finds its medium by, and before anything else.
        stage_init "$seed" S11wk-self-disarm "$disarm"
    fi

    # The profiling knobs this image exists for, in the rootfs so
    # systemd-sysctl reads them on the boot that matters.
    stage_sysctl "$seed" 90-wk-perf.conf "kernel.perf_event_paranoid = -1
kernel.kptr_restrict = 0
"

    # The other half of the profile's firmware clock pin (force_turbo in
    # config.txt.append): with `ondemand` still selected, the kernel can ask
    # for a lower operating point regardless. Best-effort -- a kernel with no
    # cpufreq driver for this board has nothing to set.
    stage_unit "$seed" wk-cpu-governor.service "[Unit]
Description=Pin every CPU to the performance governor for the duration
After=local-fs.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do \
  [ -w \"\$g\" ] && echo performance > \"\$g\"; done; true'
[Install]
WantedBy=multi-user.target
"

    # A run that swaps is a run whose number means nothing. A guard, not a
    # change (the base ships none): swap added later by a package or a stray
    # dphys-swapfile would otherwise be invisible variance.
    stage_unit "$seed" wk-no-swap.service "[Unit]
Description=Refuse to carry swap, so a benchmark cannot page
After=local-fs.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/swapoff -a
[Install]
WantedBy=multi-user.target
"

    # Written where the driving machine can read it offline, by mounting the
    # boot device from the machine's other role -- the channel that still
    # works when the network is what failed.
    stage_unit "$seed" wk-diag.service "[Unit]
Description=Dump boot and network state where it can be read offline
After=network.target cloud-init.service
[Service]
Type=oneshot
TimeoutStartSec=600
ExecStart=/bin/sh -c 'wk_bootfs() { for d in /boot/firmware /boot; do \
  [ -d \"\$d\" ] && findmnt -no TARGET \"\$d\" >/dev/null 2>&1 && { echo \"\$d\"; return; }; done; echo /boot; }; \
  sleep 90; { date -Is; cat /etc/wk-image 2>/dev/null; \
  echo; findmnt -no SOURCE,TARGET /; findmnt -no SOURCE,TARGET \"\$(wk_bootfs)\"; \
  echo; rfkill list 2>&1; iw reg get 2>&1; ip -br addr; ip route; \
  echo; networkctl status --no-pager 2>&1 | head -40; \
  echo; cloud-init status --long 2>&1; \
  echo; journalctl -b -u systemd-networkd -u wpa_supplicant -u cloud-init \
    -u cloud-init-local --no-pager 2>&1 | tail -120; } \
  > \"\$(wk_bootfs)/wk-diag.txt\" 2>&1; sync'
[Install]
WantedBy=multi-user.target
"
}

# Kernel command-line additions this profile declares, as one line: the
# sibling of `config.txt.append`, one layer up -- that tells the firmware,
# this tells the kernel (e.g. forcing a KMS output on a headless board for a
# gpu-class benchmark). The file is in this repo, so it is read here; the
# card is where it is appended, idempotently (disk_cmdline_append).
cmdline_append_text() {
    local f="${IMG_SPEC_DIR:-}/cmdline.txt.append"
    [ -f "$f" ] || return 0
    grep -vE '^\s*(#|$)' "$f" | tr '\n' ' ' | sed 's/ *$//' || true
}

# Firmware settings this profile declares, as the block they are appended as.
# Clock pinning matters: a board that idles low and ramps on demand turns DVFS
# ramping into measurement variance. The block carries its own
# `# --- wk sysimage: <profile> ---` first line, which is what makes appending
# it twice a no-op.
config_append_text() {
    local f="${IMG_SPEC_DIR:-}/config.txt.append"
    [ -f "$f" ] || return 0
    cat "$f"
}

# --- build -------------------------------------------------------------------

cmd_build() {
    local profile="${1:-}"
    [ -n "$profile" ] || die "usage: wk sysimage <sub> [args]; see wk sysimage -h"

    # Every configuration there is, not what has been built: `wk sysimage ls`
    # answers that -- an image is bytes in a workspace, not a row in a
    # catalogue, so a configuration can be buildable and never yet built.
    if [ "$profile" = --list ]; then
        image_profile_list
        exit 0
    fi

    image_profile_load "$profile" || die "unknown profile '$profile'.
    'wk sysimage build --list' has every configuration; 'wk sysimage ls' has
    every image a workspace here has already built."
    shift

    # A configuration that declares what it is missing (CFG_NEEDS: a
    # defconfig nobody has written) is refused here, in the first second,
    # rather than hours into the build.
    [ -z "${CFG_NEEDS:-}" ] || die "'$profile' cannot be built yet:

    $CFG_NEEDS

    The configuration is declared in $(image_config_file "$profile"), which is
    where the missing piece goes once it exists."

    # Dispatched on the profile, not a flag: which mechanism makes an image
    # is a property of the image. No default: a profile that names no
    # builder is refused by name.
    case "${IMG_BUILDER:-}" in
        # Downloaded rather than built: no workspace, no source, pinned by content.
        fetch)     fetch_build "$profile" "$@"; return $? ;;
        # A phone, built by pmbootstrap on a Linux machine over ssh; the
        # build host holds the output.
        pmos)      pmos_build  "$profile" "$@"; return $? ;;
        # Both need a workspace target resolved first, so the builder can
        # refuse a remote or VM one.
        buildroot) load_target "${WK_TARGET:-$(default_target)}"; buildroot_build "$profile" "$@"; return $? ;;
        yocto)     load_target "${WK_TARGET:-$(default_target)}"; yocto_build     "$profile" "$@"; return $? ;;
        '')  die "profile '$profile' names no builder.
    Every profile declares IMG_BUILDER and there is no default (wk help).
    image/profiles.sh is where this one is defined." ;;
        *)   die "profile '$profile' names builder '$IMG_BUILDER', which does not exist.
    There are four: yocto, buildroot, pmos, fetch." ;;
    esac
}

# --- the rest ----------------------------------------------------------------

# What a workspace's build is doing right now, from the pid the detached build
# recorded. Evidence, not a claim: `yocto.status` says `state=running` for ever
# on a detached build, so it is not asked.
# A slot is a builder's concern the way an image is: dispatched on
# IMG_BUILDER. buildroot builds the image's own wpewebkit package from the
# commit (image/buildroot-webkit.sh); yocto runs WebKit's own build-webkit
# --cross-target against the image's toolchain, its `webkit` stage
# (image/yocto-build.sh). Both land under image_slot_dir (lib/image.sh).
cmd_webkit() {
    local profile="${1:-}"
    [ -n "$profile" ] || die "usage: wk sysimage webkit <profile> --commit <sha> --slot <name> [--detach] [--dry-run]; see wk sysimage -h"
    image_profile_load "$profile" || die "unknown profile '$profile'.
    'wk sysimage build --list' has every configuration."
    shift
    case "${IMG_BUILDER:-}" in
        buildroot) load_target "${WK_TARGET:-$(default_target)}"; buildroot_webkit "$profile" "$@"; return $? ;;
        yocto)     load_target "${WK_TARGET:-$(default_target)}"; yocto_build "$profile" --stage webkit "$@"; return $? ;;
        *) die "'$profile' is built by ${IMG_BUILDER:-no builder}, and only a buildroot or yocto image takes WebKit slots" ;;
    esac
}

# The profile a workspace was made for, derivable from its name
# (`yocto-<profile>`, `buildroot-<profile>`) rather than a second record.
# `_profile_from_path` derives the same thing from a full path.
_ws_profile() {
    case "$1" in
        yocto-*)     printf '%s' "${1#yocto-}" ;;
        buildroot-*) printf '%s' "${1#buildroot-}" ;;
        *) return 1 ;;
    esac
}

# Either builder's detached stage (yocto-image.pid, buildroot-*.pid), alive in
# the workspace's own pid namespace: ws_busy_reason (lib/target.sh) asks the
# workspace, which is the only place the pid means anything.
_ws_building() { # <workspace>
    # stdin closed: this runs inside cmd_ls's `while read` loop, and the
    # podman exec underneath would otherwise eat the remaining rows.
    ( load_target "$(ws_target "$1" 2>/dev/null)" >/dev/null 2>&1 && ws_busy_reason "$1" >/dev/null ) </dev/null
}

cmd_ls() {
    local n=0 builder ws path bytes mtime prof machine note
    local rows; rows=$(image_workspace_scan)

    while IFS="$(printf '\t')" read -r builder ws path bytes mtime; do
        [ -n "${builder:-}" ] || continue
        n=$((n + 1))

        prof=$(_ws_profile "$ws" || printf '')
        machine=""; note=""
        if [ -n "$prof" ]; then
            # In a subshell: loading a profile sets a screenful of globals, and
            # this is a listing, not a command acting on one image.
            machine=$( image_profile_load "$prof" >/dev/null 2>&1 \
                       && printf '%s' "${IMG_MACHINE:-}" ) || true
            [ -n "$machine" ] || note="this checkout does not define '$prof'"
        fi

        printf '%-40s %-10s %-8s %-8s %s\n' \
            "$ws" "${machine:-?}" "$builder" "$(human_bytes "$bytes")" "$mtime"
        # This path is the image; nothing copied it anywhere.
        printf '    %s\n' "$path"
        _ws_building "$ws" && printf '    %s\n' "a build is running in this workspace -- these bytes may be the previous one"
        # The image's WebKit slots, from their own manifests (wk sysimage webkit).
        local sj
        for sj in $( [ -n "$prof" ] && ( image_profile_load "$prof" >/dev/null 2>&1 && dirname "$(image_slot_dir "$prof" x)" ) )/*/slot.json; do
            [ -f "$sj" ] || continue
            printf '    slot %-12s %s  built %s  (%s)\n' \
                "$(wkslot get "$sj" slot)" "$(wkslot get "$sj" commit | cut -c1-12)" \
                "$(wkslot get "$sj" built_at)" "$(dirname "$sj")"
        done
        [ -z "$note" ] || printf '    %s\n' "$note"
    done <<ROWS
$rows
ROWS

    if [ "$n" -eq 0 ]; then
        log "no workspace here has built an image."
        log "  'wk sysimage build <profile>' builds one; it stays in the workspace"
        log "  that built it (wk help)."
        return 0
    fi

    log ""
    log "$n image$([ "$n" = 1 ] || printf s), each in the workspace that built it."
    log "  There is no image store: the workspace is the name (wk help)."
    log "  To write one:  wk sysimage write --from <path above> --disk <machine>:<device>"
    log "                 add --rescue for the system a board falls back to"
    return 0
}

cmd_rm() {
    die "'wk sysimage rm' does not exist -- there is no image store to remove from
    (wk help). An image lives in the workspace that built it, so removing it
    is removing that workspace:

        wk rm <workspace>                 (buildroot, or a yocto image workspace)

    'wk sysimage ls' names the workspace beside each image it lists."
}

# --- write -------------------------------------------------------------------

cmd_disks() {
    local machine="${1:-}"
    [ -n "$machine" ] || die "usage: wk sysimage disks <machine>
    machines:
$(machine_list | sed 's/^/      /')"
    machine_load "$machine" || die "unknown machine '$machine'"
    m_reachable || die "$machine is not reachable over ssh"
    log "removable disks attached to $machine:"
    disk_list
    log ""
    log "  write one with:  wk sysimage write --from <path> --disk $machine:<device>"
    log "  ('wk sysimage ls' prints the paths)"
    log "  a machine's own system disk is never listed and never writable."
}

# wk sysimage write <image> --disk <machine>:<device>
#
# One verb, whether the disk is the one the machine is configured to boot
# from or any other removable disk plugged into it: same verification, same
# unmount, same refusals, and the stricter device policy is right for both.

# `--from` is the whole write model: a workspace built an image, the bytes
# are wherever it put them, and this moves them onto a card and edits it.
# Two spellings of where the bytes are:
#
#   --from /path                a file this machine can read
#   --from vm:/path             a file inside this machine's podman VM, which
#                               is where a container workspace's build output
#                               lives and a macOS driver cannot open directly.

# The decompressor a path needs, by what it is, or `cat`: a yocto build
# leaves its image as `<recipe>.wic.xz`, and writing that compressed stream
# straight to a disk produces a card that is not bootable, silently. Named
# extensions rather than sniffed content -- what the builders here produce
# is known (yocto: .wic.xz; buildroot: an uncompressed .img) -- and anything
# unrecognised passes through unchanged, caught by the refusal below.
_from_filter() { # <path> -- prints the command that turns those bytes into an image
    case "$1" in
        *.xz)  printf 'xz -dc'  ;;
        *.zst) printf 'zstd -dc' ;;
        *.gz)  printf 'gzip -dc' ;;
        *)     printf 'cat' ;;
    esac
}

# The device to write, when the caller named a machine but no device.
# Resolved from the *image's own* target machine (disk_for_machine,
# boot/disk.sh): a serial is a property of the hardware, matched against
# what is plugged in, where `/dev/sdb` is a property of enumeration order.
# Silent when it can't answer: the caller gets the listing instead.

# The tailnet key, asked for *before* anything is erased: the worst place to
# discover it is missing is after the card is already erased and half
# provisioned, with no terminal to answer a prompt. Unconditional, no
# --force: a card with no tailnet identity is reachable only over whatever
# LAN it lands on. This preflight decides it; disk_seed_tailnet
# (boot/disk.sh) assumes it and only writes.
_tailnet_key_preflight() { # <IMG_MACHINE> <role>
    local name; name=$(_tailnet_name_for "${1:-}" "${2:-bench}")
    [ -n "$name" ] || die "this image joins the tailnet on first boot, and nothing here
    knows what name it should answer to -- the image records no machine, so the
    card would join under the image's own hostname and come up unreachable by
    its fleet name.
    Give it one:  --machine <name>"
    wk_tailscale_authkey_present && return 0
    wk_tailscale_authkey >/dev/null 2>&1 && return 0
    die "there is no tailnet auth key on this machine, so the card this is about
    to write would boot with no tailnet identity -- reachable only over whatever
    LAN it lands on, unreachable by its fleet name, which is the state the fleet
    rule exists to end.
    Set one first:  wk key tailnet"
}

# $DISK_MACHINE's own WiFi connection, asked for before anything is erased --
# same reason as _tailnet_key_preflight, and like it a `die` no --force
# crosses. There is no credential file to check: the card takes its
# credential from the machine holding the reader, not from IMG_MACHINE (the
# board being imaged), so this asks $DISK_MACHINE (already loaded by
# cmd_write_from) rather than reading anything local.
_wifi_creds_preflight() { # <IMG_MACHINE>
    local out
    _image_wants_wifi "${1:-}" || return 0
    out=$(card_priv wifi-host 2>&1) \
        || die "could not tell whether $DISK_MACHINE is on WiFi:
$(printf '%s\n' "$out" | sed 's/^/    /')
    A board with no uplink is unreachable, which is worse than refusing, so
    there is no --force past this."
    case "$out" in
        *'wifi-host: yes'*) return 0 ;;
    esac
    die "$1 has no cable at the bench, and its rescue/bench images bring up WiFi
    from a credential taken from $DISK_MACHINE's own connection -- $DISK_MACHINE
    is not on WiFi. A board with no uplink is unreachable, which is worse than
    refusing, so there is no --force past this.
    Join $DISK_MACHINE to the WiFi the board will use; the card takes its
    credential from that machine's own connection."
}

# <name> already on the tailnet, online or offline -- exact, or as the
# collision suffix tailscale itself would rename a repeat join to
# (<name>-1, <name>-2, ...). Over the TSV wk_tailscale_peers (lib/reach.sh)
# produces, on stdin, so a test can feed it synthetic peer lines.
_tailnet_name_collides() { # <name> -- peer TSV (name<TAB>ip<TAB>state) on stdin
    local name="${1:-}"
    [ -n "$name" ] || return 1
    # Names this checks against are hostnames (MACH_SSH), always plain --
    # checked against what they are allowed to be, per admin/wk-card-priv's
    # own rule, rather than escaped into an awk regex.
    case "$name" in
        [a-zA-Z0-9]*) ;;
        *) return 1 ;;
    esac
    case "$name" in
        *[!a-zA-Z0-9-]*) return 1 ;;
    esac
    awk -F'\t' -v want="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" '
        {
            n = tolower($1)
            if (n == want)               { print "exact:" $1; found=1; exit }
            if (n ~ "^" want "-[0-9]+$") { print "suffixed:" $1; found=1; exit }
        }
        END { exit (found ? 0 : 1) }
    '
}

# A name already on the tailnet blocks the write, before anything is
# erased: Tailscale silently renames a colliding join to "$name-1", and
# everything here reaches a board by its tailnet name. Cannot be skipped --
# a failure to ask is not evidence the name is free. The one barrier: a
# rescue written onto a board's other medium from the rescue it replaces,
# where the name is held by the very system doing the writing (MACH_* is the
# card machine, IMG_MACHINE the image's board). --force crosses it and is
# recorded; the old node still has to go before the new card's first boot.
_tailnet_name_preflight() { # <name> <bench|rescue>
    local name="${1:-}" role="${2:-bench}" peers hit=""
    [ -n "$name" ] || return 0

    peers=$(wk_tailscale_peers)
    [ -n "$peers" ] || die "could not read this machine's tailnet view (tailscale status --json
    returned nothing -- no CLI, not logged in, or the daemon did not answer), so
    there is no way to tell whether '$name' is already on the tailnet. This
    check cannot be skipped: writing anyway could join renamed to '$name-1',
    and everything here reaches a board by its tailnet name."

    hit=$(printf '%s\n' "$peers" | _tailnet_name_collides "$name") || hit=""
    [ -n "$hit" ] || return 0
    if [ "$role" = rescue ] && [ "${hit%%:*}" = exact ] \
       && [ "${IMG_MACHINE:-}" = "${MACH_NAME:-}" ] && [ "$name" = "${MACH_SSH:-}" ]; then
        barrier "'$name' is $MACH_NAME's running rescue -- the system this card replaces.
    The card joins under that name only if the old node is gone by its first
    boot: after this write, remove '$name' from the tailnet admin console
    (https://login.tailscale.com/admin/machines -> $name -> Remove) before
    rebooting; a card that boots while the node exists joins renamed '$name-1'
    and nothing here can find it."
        return 0
    fi
    die "'$name' is already on the tailnet (${hit#*:}), online or offline.
    Joining under it again does not keep the name -- Tailscale renames the
    collision to '$name-1', and everything here reaches a board by its
    tailnet name, so a card that joins renamed is a card nothing here can
    find. There is no --force past this.
    Remedy: remove the stale node from the tailnet admin console
    (https://login.tailscale.com/admin/machines -> $name -> Remove; there is
    no API credential in this repo, so it is a hand step), or give this board
    a different name in boot/machines/<name>.conf (MACH_SSH)."
}

_resolve_disk_dev() { # <image machine>
    local m="${1:-}" dev
    [ -n "$m" ] || return 1
    dev=$(disk_for_machine "$m" 2>/dev/null) || return 1
    [ -n "$dev" ] || return 1
    info "$m's medium is $dev on $DISK_MACHINE (matched by serial, not by name)"
    DISK_DEV="$dev"
}

_from_reader() { # <spec> -- prints a command that emits the image on stdout
    local filter
    filter=$(_from_filter "${1#vm:}")
    case "$1" in
        vm:*) is_macos || die "--from vm:<path> is for reading a container workspace's
    output out of this machine's podman VM, and this is not a macOS host. Give a
    plain path."
              printf 'podman machine ssh %s -- sudo cat %s | %s' \
                  "${WK_MACHINE:-wk}" "$(sh_quote "${1#vm:}")" "$filter" ;;
        *)    [ -r "$1" ] || die "no image at $1
    An image lives where the workspace that built it put it (wk help). If
    that is inside this machine's podman VM, say so: --from vm:$1"
              if [ "$filter" = cat ]; then
                  printf 'cat %s' "$(sh_quote "$1")"
              else
                  printf '%s %s' "$filter" "$(sh_quote "$1")"
              fi ;;
    esac
}

# The profile a path implies: the image sits under `$WK_STORE/ws/<workspace>/
# ...`, so the path already carries what `_ws_profile` derives from a bare
# workspace name. Only used when --profile was not given.
_profile_from_path() { # <path>
    _ws_profile "$(printf '%s' "$1" | sed -n 's|.*/ws/\([^/]*\)/.*|\1|p')"
}

cmd_write_from() { # <from-spec> <disk-spec> <dry> <grow> <profile> <role> <machine override>
    local from="$1" spec="$2" dry="$3" grow="$4" profile="$5" role="$6" mach="${7:-}"
    local reader marker base fleet_edit="" bytes="" sha="" cmdline_add="" config_add=""

    reader=$(_from_reader "$from")

    # Derived before the profile is used for anything, so the machine the
    # image is for -- which decides the tailnet name the card is seeded with --
    # is known on a write that named only a path.
    if [ -z "$profile" ]; then
        profile=$(_profile_from_path "${from#vm:}" || true)
        [ -z "$profile" ] || debug "profile '$profile' derived from the path"
    fi
    # Probed in a subshell: image_profile_load *dies* on a name it does not
    # define, and `die` exits in a way `|| warn` cannot catch. The subshell
    # turns that exit into a status, and its message is worth showing.
    if [ -n "$profile" ]; then
        local _perr
        if _perr=$( image_profile_load "$profile" 2>&1 >/dev/null ); then
            image_profile_load "$profile" >/dev/null 2>&1 || true
        else
            warn "this write cannot tell which machine the card is for, so there is no
  firmware check and no tailnet name to seed. Pass --profile with a
  configuration this checkout defines."
            [ -z "$_perr" ] || printf '%s\n' "$_perr" | sed 's/^/    /' >&2
        fi
    fi
    # --machine wins over whatever the profile said (or failed to say): the
    # remedy the write preflight names for an unresolved machine.
    [ -z "$mach" ] || IMG_MACHINE="$mach"

    disk_parse "$spec"
    machine_load "$DISK_MACHINE" || die "unknown machine '$DISK_MACHINE'
    machines:
$(machine_list | sed 's/^/      /')"
    m_reachable || die "$DISK_MACHINE is not reachable over ssh, and the disk is attached to it."
    machine_armed_barrier "Writing a disk now would overwrite the medium that boot is aimed at,
    and the machine would come up on whatever this write left behind."
    [ -n "$DISK_DEV" ] || _resolve_disk_dev "${IMG_MACHINE:-}" || true
    [ -n "$DISK_DEV" ] || { log "disks attached to $DISK_MACHINE:"; disk_list
        die "say which one: --disk $DISK_MACHINE:<device>"; }

    # A fleet board built by this repo (yocto, buildroot) gets the whole
    # integration on the card once the image is on it: systemd units, a root
    # retargeted to survive a different device than the recipe assumed, the
    # profile's cmdline and firmware additions, and the firmware check. An
    # image this repo did not build -- Jumpdrive (fetch), a phone (pmos) --
    # gets the identity marker and the driving key, which every wk-written
    # disk carries, and nothing else.
    case "${IMG_BUILDER:-}" in yocto|buildroot) fleet_edit=1 ;; esac

    # The profile's own files, read here because they are in this checkout;
    # they are applied on the card (disk_cmdline_append, disk_config_append).
    if [ -n "$fleet_edit" ]; then
        cmdline_add=$(cmdline_append_text)
        config_add=$(config_append_text)
    fi

    # The name this system will be known by, once its bytes have been through
    # (the hash is of the bytes actually written): the profile when there is
    # one, otherwise the source file's own name with the compression suffix
    # taken off.
    base=$(basename "${from#vm:}")
    base=${base%.xz}; base=${base%.zst}; base=${base%.gz}
    base=${base%.wic}; base=${base%.img}

    # May this device be written at all -- asked before anything is erased,
    # and the last question this end can answer about the disk on its own.
    disk_refuse_unless_safe "$DISK_DEV"

    # A second system being rewritten keeps its tailnet node (disk_tailnet_save):
    # the name it already holds on the tailnet is then its own, not a collision.
    local kept=no
    if disk_is_second "$DISK_DEV"; then kept=$(disk_tailnet_save "$DISK_DEV"); fi

    if [ -n "$dry" ]; then
        cat >&2 <<EOF
would write
  image     $from
            streamed as it is read: the card takes the image's own bytes, and
            every edit is made afterwards, on the card
  onto      $DISK_DEV attached to $DISK_MACHINE
  identity  $(_image_id "${profile:-$base}" "")
  as        $([ -n "$fleet_edit" ] \
                && echo "a fleet system: identity marker, driving key, systemd units, retargeted root" \
                || echo "written as built -- not a fleet board build (${IMG_BUILDER:-unknown profile}); identity marker and driving key only")
  tailnet   $(wk_tailscale_authkey_present \
                && printf 'auth key present -- the card joins as this board on first boot' \
                || printf 'NO auth key -- the real write refuses here (wk key tailnet)')
  wifi      $(_image_wants_wifi "${IMG_MACHINE:-}" \
                && { card_priv wifi-host 2>&1 | grep -q 'wifi-host: yes' \
                       && printf '%s is on WiFi -- the card brings up WiFi on every boot, from its credential' "$DISK_MACHINE" \
                       || printf 'NO -- %s is not on WiFi; the real write refuses here (no --force)' "$DISK_MACHINE"; } \
                || printf 'not needed -- this board has a cable')
EOF
        [ "$DISK_DEV" = "${MACH_DEVICE:-}" ] && log "  note      $DISK_MACHINE is configured to boot from this disk (wk boot $DISK_MACHINE)"
        log "then, in order:"
        # The steps report themselves from here down (disk_would,
        # boot/disk.sh) rather than being described a second time.
        DISK_DRY=1
    else
        _tailnet_key_preflight "${IMG_MACHINE:-}" "$role"
        if [ "$kept" = yes ]; then
            log "  '$(_tailnet_name_for "${IMG_MACHINE:-}" "$role")' on the tailnet is this system's own node, kept across the rewrite"
        else
            _tailnet_name_preflight "$(_tailnet_name_for "${IMG_MACHINE:-}" "$role")" "$role"
        fi
        _wifi_creds_preflight "${IMG_MACHINE:-}"

        if disk_is_second "$DISK_DEV"; then
            warn "this ERASES partitions 3 and 4 of ${DISK_DEV%@second} on $DISK_MACHINE (the rescue on 1-2 stays)."
        else
            warn "this ERASES $DISK_DEV on $DISK_MACHINE, whatever is on it now."
        fi
        confirm "write $from onto $DISK_DEV attached to $DISK_MACHINE?" || die "not written"
    fi

    # --- the card, from here down --------------------------------------------
    disk_unmount "$DISK_DEV"

    WRITE_META=$(mktemp)
    wk_atexit _disk_cleanup
    disk_write_source "$DISK_DEV" "$reader" "$WRITE_META"
    if [ -z "$DISK_DRY" ]; then
        read -r bytes sha < "$WRITE_META"
        [ "${bytes:-0}" -gt 0 ] || die "$from read as 0 bytes through: $reader"
    fi

    # Before anything else touches the card: every step after this reads the
    # partition table the image was supposed to bring, so a bad write shows up
    # as a confusing failure in whichever of them runs first.
    [ -n "${WK_NO_VERIFY:-}" ] || disk_verify_stream "$DISK_DEV" "$WRITE_META"
    _disk_cleanup
    disk_parts_present "$DISK_DEV"
    if [ "$kept" = yes ]; then disk_tailnet_restore "$DISK_DEV"; fi

    ID=$(_image_id "${profile:-$base}" "$sha")
    marker="id=$ID
profile=${profile:-unknown}
machine=${IMG_MACHINE:-}
builder=${IMG_BUILDER:-}
role=$role
built_by=$(hostname)
wk_tools=$(git -C "$WK_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)
source=$from"

    if [ -n "$fleet_edit" ]; then
        disk_retarget_root "$DISK_DEV"
        disk_cmdline_append "$DISK_DEV" "$cmdline_add"
        disk_config_append "$DISK_DEV" "$config_add"
        disk_boot_id "$DISK_DEV" "$ID"
    fi

    disk_unique_identity "$DISK_DEV"
    disk_install_fleet "$DISK_DEV" "$marker" "$(driving_key)"

    if [ -n "$fleet_edit" ]; then
        SEED=$(mktemp -d)
        wk_atexit _seed_cleanup
        mkdir -p "$SEED/systemd" "$SEED/sysctl.d" "$SEED/init.d"
        stage_units "$SEED" "$(_self_disarm_for "${IMG_MACHINE:-}")"
        disk_install_units "$DISK_DEV" "$SEED"
        _seed_cleanup

        # Two checks, in the order the board will hit them, and against the
        # card as the edits above left it: can the firmware reach a kernel,
        # then can that kernel reach its root. The first is only worth asking
        # when the image is *for* this machine -- the wrong question about a
        # card that is about to be carried elsewhere.
        local img_machine="${IMG_MACHINE:-}"
        if [ -n "$img_machine" ] && [ "$img_machine" = "$DISK_MACHINE" ]; then
            disk_check_boot_files "$DISK_DEV" "$DISK_MACHINE" "$(image_dtb_for "$DISK_MACHINE")"
        elif [ -n "$img_machine" ]; then
            log "  (not checking $DISK_MACHINE's boot files: this is $img_machine's image, so this card goes elsewhere)"
        else
            log "  (not checking $DISK_MACHINE's boot files: no machine is known for this image)"
        fi
        disk_check_root "$DISK_DEV" "$DISK_MACHINE"
    fi

    disk_seed_role "$DISK_DEV" "$role"
    disk_seed_tailnet "$DISK_DEV" "$(_tailnet_name_for "${IMG_MACHINE:-}" "$role")"
    disk_seed_wifi "$DISK_DEV" "${IMG_MACHINE:-}"

    # Growing is opt-in: a card grown to fill has no room for a second
    # system, and a board with one system has no rescue -- it cannot install
    # anything without a person in the room.
    if [ "$grow" = 1 ]; then
        disk_grow "$DISK_DEV"
    else
        log "  the root partition is left at its built size, so the rest of the card"
        log "  is free for a second system. --grow fills it instead."
    fi
    disk_eject "$DISK_DEV"

    if [ -n "$dry" ]; then
        log "dry run -- nothing was written."
        return 0
    fi
    info "$DISK_DEV on $DISK_MACHINE now holds $ID"

    if [ "${DISK_DEV%@second}" = "${MACH_DEVICE:-}" ]; then
        # "Writing did not arm anything" is false of a medium-armed machine
        # unless this makes it true: its arming is the presence of
        # second-stage firmware on the boot partition, which the image being
        # written brings its own copy of. Left alone, the board would boot
        # the new image on its next reboot with nobody having asked -- the
        # surprise `wk boot` exists to make deliberate.
        if load_driver "${MACH_DRIVER:-}" 2>/dev/null \
           && [ "${BOOT_ARMING:-one-shot}" = medium ] \
           && command -v b_disarm >/dev/null 2>&1; then
            b_disarm
            debug "$DISK_MACHINE's $DISK_DEV was left disarmed"
        fi
        log "  $DISK_MACHINE is configured to boot from this disk, but writing it"
        log "  did not arm anything. To boot it -- once, reverting by itself:"
        log "      wk boot $DISK_MACHINE"
    elif [ -n "${MACH_ROOT:-}" ] && [ "$DISK_DEV" = "$(disk_of_part "$MACH_ROOT")" ]; then
        log "  this is $DISK_MACHINE's rescue medium: it boots whenever ${MACH_DEVICE:-the bench medium} is"
        log "  disarmed. To boot it now:  wk boot $DISK_MACHINE --disarm   then power-cycle the board"
        log "  (if this write was forced past the running rescue's name, remove that node"
        log "  from the admin console between the two)."
    else
        log "  nothing boots this yet. Move it to the board it is for, or point a"
        log "  machine at it; 'wk boot <machine>' is the one-shot."
    fi
}

# The name a system written for a machine joins the tailnet as, by role: a
# bench system as MACH_BENCH_SSH (`<board>-bench`), a rescue as MACH_SSH --
# the board's host mode, which on a bench device is the rescue itself
# (`<board>-rescue`), and on a workstation is its own install, which is never
# written. Two names because each written system joins as its own node, and
# a second join under an existing name comes up renamed. In a subshell: the
# MACH_* of the machine holding the card reader stay loaded.
_tailnet_name_for() { # <machine> <bench|rescue>
    [ -n "${1:-}" ] || return 0
    ( machine_load "$1" >/dev/null 2>&1 || exit 0
      case "${2:-bench}" in
          rescue) printf '%s' "${MACH_SSH:-}" ;;
          *)      printf '%s' "${MACH_BENCH_SSH:-}" ;;
      esac ) || true
}

cmd_write() {
    local spec="" dry="" grow=1 grow_set="" from="" profile="" role=bench mach=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --disk)    spec="${2:-}"; [ -n "$spec" ] || die "--disk needs <machine>:<device>"; shift 2 ;;
            --from)    from="${2:-}"; [ -n "$from" ] || die "--from needs a path, or vm:<path>"; shift 2 ;;
            --profile) profile="${2:-}"; shift 2 ;;
            --machine) mach="${2:-}"; [ -n "$mach" ] || die "--machine needs a name"; shift 2 ;;
            --rescue)  role=rescue; shift ;;
            --dry-run) dry=1; shift ;;
            --grow)    grow=1; grow_set=1; shift ;;
            --no-grow) grow=0; grow_set=1; shift ;;
            -*) die "unknown option: $1" ;;
            *)  die "unexpected argument: $1
    An image is bytes a workspace produced, not an id in a catalogue
    (wk help), so what identifies one is its path -- pass it to --from.
    'wk sysimage ls' lists every image a workspace here has built, with the
    path to pass." ;;
        esac
    done
    # Validated here, before anything is read or erased: the tailnet name a
    # card is seeded with (_tailnet_name_for) comes from
    # boot/machines/<name>.conf.
    [ -z "$mach" ] || machine_load "$mach" >/dev/null 2>&1 || die "unknown machine '$mach' for --machine
    machines:
$(machine_list | sed 's/^/      /')"

    [ -n "$from" ] || die "usage: wk sysimage write --from <path|vm:path> --disk <machine>:<device>[@second]
    An image is bytes a workspace produced, not an id in a catalogue
    (wk help), so what identifies one is its path.
    'wk sysimage ls' lists every image a workspace here has built, with the
    path to pass to --from."
    [ -n "$spec" ] || die "usage: wk sysimage write --from $from --disk <machine>:<device>[@second]
    'wk sysimage disks <machine>' lists what is attached where."

    # Leave the rest of the card alone by default, so there is room for the
    # second system that makes the board able to provision itself. The
    # second system itself is the last thing on the card, so it takes the
    # rest by default: a bench system's slots are what the space is for.
    # Explicit --grow / --no-grow still win.
    if [ -z "$grow_set" ]; then
        if disk_is_second "${spec#*:}"; then grow=1; else grow=0; fi
    fi
    disk_is_second "${spec#*:}" && [ "$role" = rescue ] \
        && die "a rescue is the system on partitions 1 and 2; '@second' names the bench
    system beside it. Drop --rescue, or drop @second."
    cmd_write_from "$from" "$spec" "$dry" "$grow" "$profile" "$role" "$mach"
}

# Tombstone: 'flash' named the wrong thing twice over (see the die message).
cmd_flash() {
    local machine="${1:-<machine>}"
    die "'wk sysimage flash' does not exist -- it named the wrong thing twice.

    'flash <machine>' reads as reflashing $machine. That never happened: the
    machine's own system disk is refused, and what gets written is a removable
    disk plugged into it. And nothing here is permanent -- a machine boots such
    a disk once, by a firmware one-shot, and returns to host mode by itself.

    So the disk is named, and the verb says what it does to it:

        wk sysimage disks $machine                  what is attached over there
        wk sysimage write --from <path> --disk $machine:<device>

    Booting it is still a separate step, and still one-shot:  wk boot $machine"
}


case "${1:-}" in
    build) shift; cmd_build "$@" ;;
    webkit) shift; cmd_webkit "$@" ;;
    ls|list) shift; cmd_ls "$@" ;;
    disks) shift; cmd_disks "$@" ;;
    write) shift; cmd_write "$@" ;;
    flash) shift; cmd_flash "$@" ;;
    rm) shift; cmd_rm "$@" ;;
    *) die "usage: wk sysimage <sub> [args]; see wk sysimage -h" ;;
esac
