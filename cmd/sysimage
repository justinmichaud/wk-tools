#!/usr/bin/env bash
#
# wk sysimage <sub> [args] -- build and manage bootable systems
#
# wk: where=host name=none group=hosts
# wk: readonly ls,disks
#
# An image is a whole machine, built from a spec in this repo, that a machine
# can be put into for one boot and taken out of again. It exists because four
# later steps all need the same thing -- a machine with no sandbox, whose
# kernel knobs are ours to set (docs/HANDOFF-boot.md).
#
# There is no image store (`wk help`): a build leaves its bytes wherever its
# builder put them -- a workspace, a build host -- and `wk sysimage write
# --from` edits and streams them onto a card in one pass, unprivileged except
# for the write itself, which happens on the target machine, over ssh, where
# sudo is passwordless.
#
#   build <profile> [--dry-run]  build from the spec in this repo. A yocto
#                                profile also takes --workspace, --stage,
#                                --detach, --stop, --keep-work; a pmos profile
#                                takes --detach and --resume and builds on a
#                                Linux aarch64 machine over ssh
#   ls | list                   every image a workspace here has built, and
#                                where it is -- there is no store; the
#                                workspace that built an image is its name
#                                (wk help)
#   disks <machine>             removable disks attached to that machine
#   write --from <path> --disk <machine>:<device>
#                                edit and write that image to that disk;
#                                --from takes a path 'wk sysimage ls' printed
#                                (or vm:<path>, inside this machine's podman
#                                VM). Never touches a machine's own system
#                                disk -- only a removable disk plugged into
#                                it -- and writing it does not make anything
#                                boot it ('wk boot' does)
#       --profile <name>         which configuration this image is, when the
#                                path does not already say (a yocto path does)
#       --machine <name>         the fleet machine (boot/machines/<name>.conf)
#                                the card is for, when --profile does not
#                                already say -- the tailnet name the card
#                                joins under comes from here
#       --rescue                 write it as the board's rescue system: the
#                                units that hand a machine back stay inert
#       --grow | --no-grow       fill the disk with the root partition, or
#                                leave it at its built size
#   rm <name>                   tombstone -- the image lives in the workspace
#                                that built it; 'wk rm <workspace>' removes it

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/image.sh"
. "$WK_ROOT/image/profiles.sh"
. "$WK_ROOT/boot/machines.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/boot/disk.sh"
. "$WK_ROOT/image/yocto.sh"
. "$WK_ROOT/image/buildroot.sh"
. "$WK_ROOT/image/pmos.sh"
. "$WK_ROOT/image/fetch.sh"

# Acts on physical machines -- a boot device, a firmware register, a disk
# image -- and the sandbox cannot reach any of it. `wk`'s is_host_only list
# covers the dispatcher path; this covers cmd/sysimage run directly.
if in_workspace; then
    die "'wk $(basename "$0")' acts on a host and its hardware, and this is
    workspace '$(wk_self)'. Run it on the workstation instead."
fi

_seed_cleanup() { [ -n "${SEED:-}" ] && rm -rf "$SEED"; SEED=""; return 0; }

# The local, materialized copy of a --from write's source, decompressed once
# and edited in place before streaming to the card: scratch, removed either
# way the process ends.
_disk_cleanup() { [ -n "${WRITE_TMP:-}" ] && rm -f "$WRITE_TMP"; WRITE_TMP=""; return 0; }

# --- the seed ----------------------------------------------------------------

# The public key the image will accept. Reaching the board over Tailscale SSH
# needs no key at all, so a working session is not evidence the image has the
# right one -- it has to be named here.
driving_key() {
    local k="${WK_IMAGE_KEY:-$HOME/.ssh/id_ed25519.pub}"
    [ -r "$k" ] || die "no public key at $k
    The image has to accept an ssh key on first boot, or it comes up
    unreachable. Set WK_IMAGE_KEY to the one this machine should use."
    cat "$k"
}

# --- FAT surgery, without a mount --------------------------------------------
#
# mtools addresses a filesystem inside an image file directly, at a byte
# offset, which keeps this whole command unprivileged. MTOOLS_SKIP_CHECK is
# needed because an image's sector count is rarely a whole number of tracks,
# which mtools otherwise refuses.
mt() {
    local prog="$1"; shift
    MTOOLS_SKIP_CHECK=1 "$prog" -i "$DISK@@$FAT_OFFSET" "$@"
}

# Byte offset of a partition, from the table in the file itself. No loop
# device, no root -- the same trick the FAT seeding relies on, and e2fsprogs
# speaks it natively through `file?offset=N`.
part_offset() {
    local img="$1" n="$2"
    sfdisk -J "$img" | python3 -c '
import json, sys
p = json.load(sys.stdin)["partitiontable"]["partitions"]
print(p[int(sys.argv[1]) - 1]["start"] * 512)' "$n"
}

fat_offset() {
    local img="$1"
    # Partition 1 is the firmware/boot FAT on every Pi image.
    sfdisk -J "$img" \
        | sed -n 's/.*"start": *\([0-9]*\).*/\1/p' \
        | head -1 \
        | awk '{ print $1 * 512 }'
}

# Install a systemd unit into the image's rootfs, enabled, without cloud-init:
# a failure earlier than cloud-init (an unread seed, a hung stage) would
# strand a board with nothing to hand it back if the watchdog depended on it
# to arm. Units are written with their <target>.wants symlinks at build time
# and start whether cloud-init runs or not; only what genuinely needs it (an
# authorized key, rendered network config) is left to it.
#
#   install_unit <rootfs-offset> <name> <body> [target]
#
# `target` is a real argument, not a constant: `systemctl enable` never runs
# here, so a unit asking for one target but symlinked into another silently
# loses its ordering.
install_unit() {
    local roff="$1" name="$2" body="$3" target="${4:-multi-user.target}"
    printf '%s' "$body" > "$SEED/$name"
    debugfs -w -R "mkdir /etc/systemd/system/$target.wants" \
        "$DISK?offset=$roff" >/dev/null 2>&1 || true
    debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
cd /etc/systemd/system
rm $name
write $SEED/$name $name
sif $name mode 0100644
sif $name uid 0
sif $name gid 0
symlink /etc/systemd/system/$target.wants/$name /etc/systemd/system/$name
EOF
    debugfs -R "stat /etc/systemd/system/$name" "$DISK?offset=$roff" 2>/dev/null \
        | grep -q '^Inode:' || die "could not install $name into the image"
}

# --- making an image bootable from the disk it is written to -------------------

# The MBR partition UUID of one partition: the disk signature, then the
# partition number. `PARTUUID=` is resolved inside the kernel
# (`devt_from_partuuid`) with no help from userspace; `LABEL=` needs an
# initramfs to do the lookup, and a Yocto wic image has none -- the firmware
# loads kernel8.img and the kernel mounts its root directly.
image_partuuid() {
    local img="$1" n="$2" sig
    sig=$(sfdisk -J "$img" 2>/dev/null | sed -n 's/.*"id": *"0x\([0-9a-fA-F]*\)".*/\1/p' | head -1)
    [ -n "$sig" ] || return 1
    printf '%08x-%02d' "$((0x$sig))" "$n"
}

# Give an image a root reference that survives being written to a different
# kind of device than its recipe assumed. bitbake writes `root=/dev/mmcblk0p2`
# because its wks file says so -- a promise about a device, not a filesystem;
# written to a USB stick, the kernel looks for root on an SD card that isn't
# there. Rewrites both places that name a device by path to name a
# *partition* instead: kernel `root=` is resolved by the kernel, `/boot` in
# /etc/fstab by mount(8) after userspace is up, so fixing only the first
# leaves an empty /boot. Unprivileged, in place, nothing mounted: mtools for
# the FAT, debugfs for the ext4, both addressing a filesystem at a byte offset.
retarget_root() {
    local seed="$1" roff spec class uuid_root uuid_boot cmdline_path
    roff=$(part_offset "$DISK" 2)

    spec=$(cmdline_root_spec)
    [ -n "$spec" ] || die "$DISK has no cmdline.txt to read a root from"
    class=$(image_root_class "$spec")
    case "$class" in
        portable)
            debug "root is already portable ($spec); nothing to retarget"
            return 0 ;;
        network)
            die "$DISK names a network root ($spec). Nothing here boots that way." ;;
    esac

    uuid_root=$(image_partuuid "$DISK" 2) \
        || die "could not read the disk signature out of $DISK's partition table"
    uuid_boot=$(image_partuuid "$DISK" 1)

    info "retargeting the root: $spec -> PARTUUID=$uuid_root (boots from any device)"

    # The kernel command line.
    for cmdline_path in ::/current/cmdline.txt ::cmdline.txt; do
        if mt mtype "$cmdline_path" > "$seed/cmdline.txt" 2>/dev/null; then
            sed -i "s|root=$spec|root=PARTUUID=$uuid_root|" "$seed/cmdline.txt"
            grep -q "root=PARTUUID=$uuid_root" "$seed/cmdline.txt" \
                || die "could not rewrite root= in $cmdline_path"
            mt mcopy -o "$seed/cmdline.txt" "$cmdline_path"
            debug "rewrote $cmdline_path"
            break
        fi
    done

    # /etc/fstab, for every device path in it. The root line is usually
    # `/dev/root`, which the kernel fills in and which is right already; it is
    # the /boot line that names a card.
    if debugfs -R "cat /etc/fstab" "$DISK?offset=$roff" 2>/dev/null > "$seed/fstab.old"; then
        sed -e "s|^/dev/mmcblk0p1[[:space:]]|PARTUUID=$uuid_boot\t|" \
            -e "s|^/dev/sda1[[:space:]]|PARTUUID=$uuid_boot\t|" \
            -e "s|^/dev/mmcblk0p2[[:space:]]|PARTUUID=$uuid_root\t|" \
            -e "s|^/dev/sda2[[:space:]]|PARTUUID=$uuid_root\t|" \
            "$seed/fstab.old" > "$seed/fstab"
        if ! cmp -s "$seed/fstab.old" "$seed/fstab"; then
            debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
rm /etc/fstab
cd /etc
write $seed/fstab fstab
sif fstab mode 0100644
sif fstab uid 0
sif fstab gid 0
EOF
            e2fsck -fy "$DISK?offset=$roff" >/dev/null 2>&1 || true
            debugfs -R "cat /etc/fstab" "$DISK?offset=$roff" 2>/dev/null \
                | grep -q "PARTUUID=$uuid_boot" \
                || die "/etc/fstab did not survive the rewrite"
            info "  and /etc/fstab's /boot -> PARTUUID=$uuid_boot"
        fi
    fi
}

# The image's own cmdline root=, read from $DISK rather than looked up, so
# this works mid-build.
cmdline_root_spec() {
    local p
    for p in ::/current/cmdline.txt ::cmdline.txt; do
        mt mtype "$p" 2>/dev/null | tr ' ' '\n' | kv_get root \
            | grep . && return 0
    done
    return 1
}

# The image's identity, on the **boot partition** (FAT), a different file
# from /etc/wk-image in the rootfs: `b_device_image` (boot/machines.sh) reads
# it off a disk that is not running, without mounting anything ext4. Not
# byte-matched against the image, which stops holding the moment a booted
# image writes to its own boot partition. One writer, called from every
# write (cmd_write_from): `wk boot` refuses a disk with no id.
install_disk_id() {
    printf '%s\n' "$ID" > "$SEED/wk-image.id"
    mt mcopy -o "$SEED/wk-image.id" ::wk-image.id
    mt mtype ::wk-image.id 2>/dev/null | grep -qxF "$ID" \
        || die "the identity did not survive the write to the boot partition"
}

# Kernel command-line additions this profile declares, appended to whatever
# the image already had. The sibling of `config.txt.append`, one layer up:
# that tells the firmware, this tells the kernel (e.g. forcing a KMS output
# on a headless board for a gpu-class benchmark). Appended, not replacing,
# and idempotent by marker.
CMDLINE_MARKER='# wk:'
apply_cmdline_append() {
    local seed="$1" add f path
    f="$IMG_SPEC_DIR/cmdline.txt.append"
    [ -f "$f" ] || return 0
    add=$(grep -vE '^\s*(#|$)' "$f" | tr '\n' ' ' | sed 's/ *$//')
    [ -n "$add" ] || return 0

    for path in ::/current/cmdline.txt ::cmdline.txt; do
        if mt mtype "$path" > "$seed/cmdline.txt" 2>/dev/null; then
            if grep -qF "$add" "$seed/cmdline.txt"; then
                debug "cmdline already carries: $add"
                return 0
            fi
            info "kernel cmdline += $add  (from $(basename "$IMG_SPEC_DIR")/cmdline.txt.append)"
            # One line, always: the firmware reads the first line only, so a
            # trailing newline from the spec file would silently drop it all.
            printf '%s %s\n' "$(tr -d '\r\n' < "$seed/cmdline.txt")" "$add" > "$seed/cmdline.new"
            mv "$seed/cmdline.new" "$seed/cmdline.txt"
            mt mcopy -o "$seed/cmdline.txt" "$path"
            CMDLINE_APPENDED="$add"
            return 0
        fi
    done
    die "no cmdline.txt in the image's boot partition to append to"
}

# Firmware settings this profile declares, appended to config.txt, which a
# Raspberry Pi's firmware reads off the boot partition regardless of the OS
# on it. Clock pinning matters: a board that idles low and ramps on demand
# turns DVFS ramping into measurement variance, and a setting that fails to
# land fails no build -- it just makes every number worse with nothing to
# notice by, which is why the block is read back below.
apply_config_append() {
    local seed="$1" f path
    f="$IMG_SPEC_DIR/config.txt.append"
    [ -f "$f" ] || return 0

    for path in ::/current/config.txt ::config.txt; do
        mt mtype "$path" > "$seed/config.txt" 2>/dev/null || continue
        if grep -qF "# --- wk sysimage: $IMG_PROFILE ---" "$seed/config.txt"; then
            debug "config.txt already carries $IMG_PROFILE's block"
            return 0
        fi
        info "config.txt += $(basename "$IMG_SPEC_DIR")/config.txt.append (firmware settings)"
        printf '\n' >> "$seed/config.txt"
        cat "$f" >> "$seed/config.txt"
        mt mcopy -o "$seed/config.txt" "$path"
        # Read back, because a firmware setting that did not land is a board
        # that measures at whatever clock it felt like -- and nothing says so.
        mt mtype "$path" 2>/dev/null | grep -qF "# --- wk sysimage: $IMG_PROFILE ---" \
            || die "config.txt did not take $IMG_PROFILE's firmware block"
        return 0
    done
    die "no config.txt in the image's boot partition to append to"
}

# The ssh key that makes the fleet integration usable: `b_probe`, `wk boot
# --back` and `wk bench` all drive the board **over ssh**. A Yocto image
# ships `PermitRootLogin yes` with an empty root password, which
# `ssh -o BatchMode=yes` cannot offer -- without a key the image boots
# perfectly and is invisible to every verb here.
install_driving_key() {
    local roff="$1" home ssh
    # Asked of the image rather than assumed: Yocto puts root in /home/root,
    # Debian and Ubuntu in /root, and the wrong directory fails as silently
    # as writing nothing.
    home=$(debugfs -R "cat /etc/passwd" "$DISK?offset=$roff" 2>/dev/null \
        | awk -F: '$1 == "root" { print $6 }' | head -1)
    [ -n "$home" ] || die "no root entry in the image's /etc/passwd"
    ssh="$home/.ssh"

    driving_key > "$SEED/authorized_keys"
    info "installing the driving ssh key into the image ($ssh)"
    debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
mkdir $ssh
cd $ssh
rm authorized_keys
write $SEED/authorized_keys authorized_keys
sif authorized_keys mode 0100600
sif authorized_keys uid 0
sif authorized_keys gid 0
sif $ssh mode 040700
sif $ssh uid 0
sif $ssh gid 0
EOF
    e2fsck -fy "$DISK?offset=$roff" >/dev/null 2>&1 || true
    debugfs -R "cat $ssh/authorized_keys" "$DISK?offset=$roff" 2>/dev/null \
        | grep -q 'ssh-' || die "the driving key did not survive the write into the image"
}

# Write a plain file into the image's rootfs at build time -- same reasoning
# as install_unit: cloud-init is late enough that a file it writes can land
# after the reader that wants it has already run, and on a one-shot image
# "takes effect on the second boot" means "never."
install_file() {
    local roff="$1" path="$2" body="$3" mode="${4:-0100644}"
    local dir base tmp
    dir=$(dirname "$path"); base=$(basename "$path")
    tmp="$SEED/.rootfs-$base"
    printf '%s' "$body" > "$tmp"
    debugfs -w -R "mkdir $dir" "$DISK?offset=$roff" >/dev/null 2>&1 || true
    debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
cd $dir
rm $base
write $tmp $base
sif $base mode $mode
sif $base uid 0
sif $base gid 0
EOF
    debugfs -R "stat $path" "$DISK?offset=$roff" 2>/dev/null \
        | grep -q '^Inode:' || die "could not install $path into the image"
    rm -f "$tmp"
}

# Everything a rootfs needs to be a *fleet* system rather than merely a
# bootable one: no `/etc/wk-image` leaves `b_probe` unable to tell the board
# apart from host mode, and no self-return watchdog means a medium-armed
# stick stays armed forever. Applied once at write time (cmd_write_from),
# not baked in per builder.
#   install_fleet_integration <rootfs-offset> <marker text>
install_fleet_integration() {
    local roff="$1" marker="$2"

    # In the rootfs, not only in cloud-init's write_files: "which OS am I
    # talking to" must be answerable on a boot where cloud-init did not run
    # -- a Yocto image has no cloud-init at all.
    printf '%s\n' "$marker" > "$SEED/wk-image"
    debugfs -w -f - "$DISK?offset=$roff" >/dev/null 2>&1 <<EOF
cd /etc
rm wk-image
write $SEED/wk-image wk-image
sif wk-image mode 0100644
sif wk-image uid 0
sif wk-image gid 0
EOF
    debugfs -R "stat /etc/wk-image" "$DISK?offset=$roff" 2>/dev/null \
        | grep -q '^Inode:' || die "could not write the identity marker into the image"

    install_units "$roff"
}

install_units() {
    local roff="$1"
    # For b_self_disarm_sh. A missing driver is not an error -- most profiles
    # (the yocto ones) name a target, not a fleet entry, and just have
    # nothing to disarm.
    if machine_load "${IMG_MACHINE:-}" 2>/dev/null && [ -n "${MACH_DRIVER:-}" ]; then
        load_driver "$MACH_DRIVER" 2>/dev/null || true
    fi
    # Every unit below goes into every image; the two that hand a machine
    # *back* are gated at runtime on /etc/wk/rescue (a marker `wk sysimage
    # write --rescue` leaves), which is what makes one built artifact serve
    # both roles. Ungated, the watchdog would reboot the helper every
    # IMG_WATCHDOG seconds mid-write, and self-disarm would park a medium
    # the image isn't on.

    # Which init this image runs, read out of the image rather than assumed:
    # an image without systemd would take these units without complaint,
    # land them where they never start, and report a watchdog installed on
    # a board that has none. TODO: buildroot/BusyBox-init images need
    # S-scripts instead; until then they get neither watchdog nor self-disarm.
    if ! debugfs -R "stat /lib/systemd/systemd" "$DISK?offset=$roff" 2>/dev/null | grep -q '^Inode:' \
       && ! debugfs -R "stat /usr/lib/systemd/systemd" "$DISK?offset=$roff" 2>/dev/null | grep -q '^Inode:'; then
        warn "$IMG_PROFILE has no systemd, so the self-return watchdog and the self-disarm
  were NOT installed. This image carries its identity marker and the driving key
  and nothing else: a run that wedges the board will not hand it back, and on a
  medium-armed machine the medium stays armed until something disarms it."
        return 0
    fi

    # The .wants directory need not exist in a stock image.
    debugfs -w -R "mkdir /etc/systemd/system/multi-user.target.wants" \
        "$DISK?offset=$roff" >/dev/null 2>&1 || true

    info "installing the self-return watchdog and the diagnostics dump into the rootfs"

    # TimeoutStartSec=infinity is load-bearing: systemd's default 90 s start
    # timeout kills a Type=oneshot that sleeps longer than that before it can
    # ever fire.
    # Skipped rather than written empty when a profile names no watchdog: the
    # unit would be `sleep ` with no argument, which fails on every boot and
    # looks in the journal exactly like a watchdog that ran.
    if [ -z "${IMG_WATCHDOG:-}" ]; then
        warn "$IMG_PROFILE sets no IMG_WATCHDOG, so this image will not hand its machine back"
    else
    install_unit "$roff" wk-self-return.service "[Unit]
Description=Hand the machine back to host mode unless claimed
# Inert on a rescue system, which is what this would be handing the machine
# back *to*. The marker is written by 'wk sysimage write --rescue'.
ConditionPathExists=!/etc/wk/rescue
[Service]
Type=oneshot
ExecStart=/bin/sh -c 'sleep $IMG_WATCHDOG; [ -f /run/wk-keep-running ] || systemctl reboot'
TimeoutStartSec=infinity
[Install]
WantedBy=multi-user.target
"
    fi

    # A medium-armed machine's image disarms itself: the stick stops being
    # bootable the moment the image is up, so every later reboot falls
    # through to the rescue role (b_self_disarm_sh; boot/pi-usb.sh owns the
    # filenames). Ordered before sysinit, not at multi-user, to keep the
    # "image came up and then wedged" window as small as possible;
    # DefaultDependencies=no with After=local-fs.target is safe because a
    # rename on an already-mounted filesystem cannot block on systemd.
    if command -v b_self_disarm_sh >/dev/null 2>&1; then
        info "installing the self-disarm into the rootfs (the stick stops booting once this image is up)"
        install_unit "$roff" wk-self-disarm.service "[Unit]
Description=Park this image's second-stage firmware so the next boot is the rescue role
# A rescue is not on the medium this parks, so on one it would disarm somebody
# else's arming.
ConditionPathExists=!/etc/wk/rescue
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '$(b_self_disarm_sh)'
[Install]
WantedBy=sysinit.target
" sysinit.target
    fi

    # The profiling knobs this image exists for, in the rootfs so
    # systemd-sysctl reads them on the boot that matters.
    install_file "$roff" /etc/sysctl.d/90-wk-perf.conf "kernel.perf_event_paranoid = -1
kernel.kptr_restrict = 0
"

    # The other half of the profile's firmware clock pin (force_turbo in
    # config.txt.append): with `ondemand` still selected, the kernel can ask
    # for a lower operating point regardless. Best-effort -- a kernel with no
    # cpufreq driver for this board has nothing to set.
    install_unit "$roff" wk-cpu-governor.service "[Unit]
Description=Pin every CPU to the performance governor for the duration
After=local-fs.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do \
  [ -w \"\$g\" ] && echo performance > \"\$g\"; done; true'
[Install]
WantedBy=multi-user.target
"

    # A run that swaps is a run whose number means nothing. A guard, not a
    # change (the base ships none): swap added later by a package or a stray
    # dphys-swapfile would otherwise be invisible variance.
    install_unit "$roff" wk-no-swap.service "[Unit]
Description=Refuse to carry swap, so a benchmark cannot page
After=local-fs.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/swapoff -a
[Install]
WantedBy=multi-user.target
"

    # Written where the driving machine can read it offline, by mounting the
    # boot device from the machine's other role -- the channel that still
    # works when the network is what failed.
    install_unit "$roff" wk-diag.service "[Unit]
Description=Dump boot and network state where it can be read offline
After=network.target cloud-init.service
[Service]
Type=oneshot
TimeoutStartSec=600
ExecStart=/bin/sh -c 'wk_bootfs() { for d in /boot/firmware /boot; do \
  [ -d \"\$d\" ] && findmnt -no TARGET \"\$d\" >/dev/null 2>&1 && { echo \"\$d\"; return; }; done; echo /boot; }; \
  sleep 90; { date -Is; cat /etc/wk-image 2>/dev/null; \
  echo; findmnt -no SOURCE,TARGET /; findmnt -no SOURCE,TARGET \"\$(wk_bootfs)\"; \
  echo; rfkill list 2>&1; iw reg get 2>&1; ip -br addr; ip route; \
  echo; networkctl status --no-pager 2>&1 | head -40; \
  echo; cloud-init status --long 2>&1; \
  echo; journalctl -b -u systemd-networkd -u wpa_supplicant -u cloud-init \
    -u cloud-init-local --no-pager 2>&1 | tail -120; } \
  > \"\$(wk_bootfs)/wk-diag.txt\" 2>&1; sync'
[Install]
WantedBy=multi-user.target
"
}

# --- build -------------------------------------------------------------------

cmd_build() {
    local profile="${1:-}"
    [ -n "$profile" ] || die "usage: wk sysimage <sub> [args]; see wk sysimage -h"

    # Every configuration there is, not what has been built: `wk sysimage ls`
    # answers that -- an image is bytes in a workspace, not a row in a
    # catalogue, so a configuration can be buildable and never yet built.
    if [ "$profile" = --list ]; then
        image_profile_list
        exit 0
    fi

    image_profile_load "$profile" || die "unknown profile '$profile'.
    'wk sysimage build --list' has every configuration; 'wk sysimage ls' has
    every image a workspace here has already built."
    shift

    # A configuration that declares what it is missing (CFG_NEEDS: a
    # defconfig nobody has written) is refused here, in the first second,
    # rather than hours into the build.
    [ -z "${CFG_NEEDS:-}" ] || die "'$profile' cannot be built yet:

    $CFG_NEEDS

    The configuration is declared in $(image_config_file "$profile"), which is
    where the missing piece goes once it exists."

    # Dispatched on the profile, not a flag: which mechanism makes an image
    # is a property of the image. No default: a profile that names no
    # builder is refused by name.
    case "${IMG_BUILDER:-}" in
        # Downloaded rather than built: no workspace, no source, pinned by content.
        fetch)     fetch_build "$profile" "$@"; return $? ;;
        # A phone, built by pmbootstrap on a Linux machine over ssh; the
        # build host holds the output.
        pmos)      pmos_build  "$profile" "$@"; return $? ;;
        # Both need a workspace target resolved first, so the builder can
        # refuse a remote or VM one.
        buildroot) load_target "${WK_TARGET:-$(default_target)}"; buildroot_build "$profile" "$@"; return $? ;;
        yocto)     load_target "${WK_TARGET:-$(default_target)}"; yocto_build     "$profile" "$@"; return $? ;;
        '')  die "profile '$profile' names no builder.
    Every profile declares IMG_BUILDER and there is no default (wk help).
    image/profiles.sh is where this one is defined." ;;
        *)   die "profile '$profile' names builder '$IMG_BUILDER', which does not exist.
    There are four: yocto, buildroot, pmos, fetch." ;;
    esac
}

# --- the rest ----------------------------------------------------------------

# What a workspace's build is doing right now, from the pid the detached build
# recorded. Evidence, not a claim: `yocto.status` says `state=running` for ever
# on a detached build, so it is not asked.
_ws_building() { # <workspace>
    local pid
    pid=$(cat "$(wk_ws_dir "$1")/home/yocto-image.pid" 2>/dev/null) || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

# The profile a workspace was made for, derivable from its name
# (`yocto-<profile>`, `buildroot-<profile>`) rather than a second record.
# `_profile_from_path` derives the same thing from a full path.
_ws_profile() {
    case "$1" in
        yocto-*)     printf '%s' "${1#yocto-}" ;;
        buildroot-*) printf '%s' "${1#buildroot-}" ;;
        *) return 1 ;;
    esac
}

cmd_ls() {
    local n=0 builder ws path bytes mtime prof machine note
    local rows; rows=$(image_workspace_scan)

    while IFS="$(printf '\t')" read -r builder ws path bytes mtime; do
        [ -n "${builder:-}" ] || continue
        n=$((n + 1))

        prof=$(_ws_profile "$ws" || printf '')
        machine=""; note=""
        if [ -n "$prof" ]; then
            # In a subshell: loading a profile sets a screenful of globals, and
            # this is a listing, not a command acting on one image.
            machine=$( image_profile_load "$prof" >/dev/null 2>&1 \
                       && printf '%s' "${IMG_MACHINE:-}" ) || true
            [ -n "$machine" ] || note="this checkout does not define '$prof'"
        fi

        printf '%-40s %-10s %-8s %-8s %s\n' \
            "$ws" "${machine:-?}" "$builder" "$(human_bytes "$bytes")" "$mtime"
        # This path is the image; nothing copied it anywhere.
        printf '    %s\n' "$path"
        _ws_building "$ws" && printf '    %s\n' "a build is running in this workspace -- these bytes may be the previous one"
        [ -z "$note" ] || printf '    %s\n' "$note"
    done <<ROWS
$rows
ROWS

    if [ "$n" -eq 0 ]; then
        log "no workspace here has built an image."
        log "  'wk sysimage build <profile>' builds one; it stays in the workspace"
        log "  that built it (wk help)."
        return 0
    fi

    log ""
    log "$n image$([ "$n" = 1 ] || printf s), each in the workspace that built it."
    log "  There is no image store: the workspace is the name (wk help)."
    log "  To write one:  wk sysimage write --from <path above> --disk <machine>:<device>"
    log "                 add --rescue for the system a board falls back to"
    return 0
}

cmd_rm() {
    die "'wk sysimage rm' does not exist -- there is no image store to remove from
    (wk help). An image lives in the workspace that built it, so removing it
    is removing that workspace:

        wk rm <workspace>                 (buildroot, or a yocto image workspace)

    'wk sysimage ls' names the workspace beside each image it lists."
}

# --- write -------------------------------------------------------------------

cmd_disks() {
    local machine="${1:-}"
    [ -n "$machine" ] || die "usage: wk sysimage disks <machine>
    machines:
$(machine_list | sed 's/^/      /')"
    machine_load "$machine" || die "unknown machine '$machine'"
    m_reachable || die "$machine is not reachable over ssh"
    log "removable disks attached to $machine:"
    disk_list
    log ""
    log "  write one with:  wk sysimage write --from <path> --disk $machine:<device>"
    log "  ('wk sysimage ls' prints the paths)"
    log "  a machine's own system disk is never listed and never writable."
}

# wk sysimage write <image> --disk <machine>:<device>
#
# One verb, whether the disk is the one the machine is configured to boot
# from or any other removable disk plugged into it: same verification, same
# unmount, same refusals, and the stricter device policy is right for both.

# What the dry run says about an image's root, including when it says
# nothing: a phone's bootloader has no cmdline.txt to read, which is a
# question that does not apply to it rather than a fault in it.
_root_line() {
    local spec; spec=$(image_root_spec "$1")
    if [ -z "$spec" ]; then
        printf 'not declared in a cmdline.txt -- this image does not boot that way'
    else
        printf '%s -- %s' "$spec" "$(image_root_word "$(image_root_class "$spec")")"
    fi
}

# `--from` is the whole write model: a workspace built an image, the bytes
# are wherever it put them, and this moves them onto a card and edits it.
# Two spellings of where the bytes are:
#
#   --from /path                a file this machine can read
#   --from vm:/path             a file inside this machine's podman VM, which
#                               is where a container workspace's build output
#                               lives and a macOS driver cannot open directly.

# The decompressor a path needs, by what it is, or `cat`: a yocto build
# leaves its image as `<recipe>.wic.xz`, and writing that compressed stream
# straight to a disk produces a card that is not bootable, silently. Named
# extensions rather than sniffed content -- what the builders here produce
# is known (yocto: .wic.xz; buildroot: an uncompressed .img) -- and anything
# unrecognised passes through unchanged, caught by the refusal below.
_from_filter() { # <path> -- prints the command that turns those bytes into an image
    case "$1" in
        *.xz)  printf 'xz -dc'  ;;
        *.zst) printf 'zstd -dc' ;;
        *.gz)  printf 'gzip -dc' ;;
        *)     printf 'cat' ;;
    esac
}

# The device to write, when the caller named a machine but no device.
# Resolved from the *image's own* target machine (disk_for_machine,
# boot/disk.sh): a serial is a property of the hardware, matched against
# what is plugged in, where `/dev/sdb` is a property of enumeration order.
# Silent when it can't answer: the caller gets the listing instead.

# The tailnet key, asked for *before* anything is erased: the worst place to
# discover it is missing is after the card is already erased and half
# provisioned, with no terminal to answer a prompt. Unconditional, no
# --force: a card with no tailnet identity is reachable only over whatever
# LAN it lands on. This preflight decides it; disk_seed_tailnet
# (boot/disk.sh) assumes it and only writes.
_tailnet_key_preflight() { # <IMG_MACHINE>
    local name; name=$(_tailnet_name_for "${1:-}")
    [ -n "$name" ] || die "this image joins the tailnet on first boot, and nothing here
    knows what name it should answer to -- the image records no machine, so the
    card would join under the image's own hostname and come up unreachable by
    its fleet name.
    Give it one:  --machine <name>"
    wk_tailscale_authkey_present && return 0
    wk_tailscale_authkey >/dev/null 2>&1 && return 0
    die "there is no tailnet auth key on this machine, so the card this is about
    to write would boot with no tailnet identity -- reachable only over whatever
    LAN it lands on, unreachable by its fleet name, which is the state the fleet
    rule exists to end.
    Set one first:  wk key tailnet"
}

# The fleet's WiFi identity, asked for before anything is erased -- same
# reason as _tailnet_key_preflight, and like it a `die` no --force crosses.
_wifi_creds_preflight() { # <IMG_MACHINE>
    _image_wants_wifi "${1:-}" || return 0
    disk_wifi_creds_present && return 0
    die "$1 has no cable at the bench, and its rescue/bench images bring up WiFi
    from a credential seeded onto the card -- there is none here. A board with
    no uplink is unreachable, which is worse than refusing, so there is no
    --force past this.
    Set it:
        printf 'ssid=<network>\npsk=<passphrase>\n' > $(disk_wifi_creds_path)"
}

# <name> already on the tailnet, online or offline -- exact, or as the
# collision suffix tailscale itself would rename a repeat join to
# (<name>-1, <name>-2, ...). Over the TSV wk_tailscale_peers (lib/reach.sh)
# produces, on stdin, so a test can feed it synthetic peer lines.
_tailnet_name_collides() { # <name> -- peer TSV (name<TAB>ip<TAB>state) on stdin
    local name="${1:-}"
    [ -n "$name" ] || return 1
    # Names this checks against are hostnames (MACH_SSH), always plain --
    # checked against what they are allowed to be, per admin/wk-card-priv's
    # own rule, rather than escaped into an awk regex.
    case "$name" in
        [a-zA-Z0-9]*) ;;
        *) return 1 ;;
    esac
    case "$name" in
        *[!a-zA-Z0-9-]*) return 1 ;;
    esac
    awk -F'\t' -v want="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" '
        {
            n = tolower($1)
            if (n == want)               { print "exact:" $1; found=1; exit }
            if (n ~ "^" want "-[0-9]+$") { print "suffixed:" $1; found=1; exit }
        }
        END { exit (found ? 0 : 1) }
    '
}

# A name already on the tailnet blocks the write, before anything is
# erased: Tailscale silently renames a colliding join to "$name-1", and
# everything here reaches a board by its tailnet name. Cannot be skipped --
# a failure to ask is not evidence the name is free.
_tailnet_name_preflight() { # <name>
    local name="${1:-}" peers hit=""
    [ -n "$name" ] || return 0

    peers=$(wk_tailscale_peers)
    [ -n "$peers" ] || die "could not read this machine's tailnet view (tailscale status --json
    returned nothing -- no CLI, not logged in, or the daemon did not answer), so
    there is no way to tell whether '$name' is already on the tailnet. This
    check cannot be skipped: writing anyway could join renamed to '$name-1',
    and everything here reaches a board by its tailnet name."

    hit=$(printf '%s\n' "$peers" | _tailnet_name_collides "$name") || hit=""
    [ -z "$hit" ] || die "'$name' is already on the tailnet (${hit#*:}), online or offline.
    Joining under it again does not keep the name -- Tailscale renames the
    collision to '$name-1', and everything here reaches a board by its
    tailnet name, so a card that joins renamed is a card nothing here can
    find. There is no --force past this.
    Remedy: remove the stale node from the tailnet admin console
    (https://login.tailscale.com/admin/machines -> $name -> Remove; there is
    no API credential in this repo, so it is a hand step), or give this board
    a different name in boot/machines/<name>.conf (MACH_SSH)."
}

_resolve_disk_dev() { # <image machine>
    local m="${1:-}" dev
    [ -n "$m" ] || return 1
    dev=$(disk_for_machine "$m" 2>/dev/null) || return 1
    [ -n "$dev" ] || return 1
    info "$m's medium is $dev on $DISK_MACHINE (matched by serial, not by name)"
    DISK_DEV="$dev"
}

_from_reader() { # <spec> -- prints a command that emits the image on stdout
    local filter
    filter=$(_from_filter "${1#vm:}")
    case "$1" in
        vm:*) is_macos || die "--from vm:<path> is for reading a container workspace's
    output out of this machine's podman VM, and this is not a macOS host. Give a
    plain path."
              printf 'podman machine ssh %s -- sudo cat %s | %s' \
                  "${WK_MACHINE:-wk}" "$(sh_quote "${1#vm:}")" "$filter" ;;
        *)    [ -r "$1" ] || die "no image at $1
    An image lives where the workspace that built it put it (wk help). If
    that is inside this machine's podman VM, say so: --from vm:$1"
              if [ "$filter" = cat ]; then
                  printf 'cat %s' "$(sh_quote "$1")"
              else
                  printf '%s %s' "$filter" "$(sh_quote "$1")"
              fi ;;
    esac
}

# The profile a path implies: the image sits under `$WK_STORE/ws/<workspace>/
# ...`, so the path already carries what `_ws_profile` derives from a bare
# workspace name. Only used when --profile was not given.
_profile_from_path() { # <path>
    _ws_profile "$(printf '%s' "$1" | sed -n 's|.*/ws/\([^/]*\)/.*|\1|p')"
}

cmd_write_from() { # <from-spec> <disk-spec> <dry> <grow> <profile> <role> <machine override>
    local from="$1" spec="$2" dry="$3" grow="$4" profile="$5" role="$6" mach="${7:-}"
    local reader size marker base fleet_edit=""

    reader=$(_from_reader "$from")

    # Derived before the profile is used for anything, so the machine the
    # image is for -- which decides the tailnet name the card is seeded with --
    # is known on a write that named only a path.
    if [ -z "$profile" ]; then
        profile=$(_profile_from_path "${from#vm:}" || true)
        [ -z "$profile" ] || debug "profile '$profile' derived from the path"
    fi
    # Probed in a subshell: image_profile_load *dies* on a name it does not
    # define, and `die` exits in a way `|| warn` cannot catch. The subshell
    # turns that exit into a status, and its message is worth showing.
    if [ -n "$profile" ]; then
        local _perr
        if _perr=$( image_profile_load "$profile" 2>&1 >/dev/null ); then
            image_profile_load "$profile" >/dev/null 2>&1 || true
        else
            warn "this write cannot tell which machine the card is for, so there is no
  firmware check and no tailnet name to seed. Pass --profile with a
  configuration this checkout defines."
            [ -z "$_perr" ] || printf '%s\n' "$_perr" | sed 's/^/    /' >&2
        fi
    fi
    # --machine wins over whatever the profile said (or failed to say): the
    # remedy the write preflight names for an unresolved machine.
    [ -z "$mach" ] || IMG_MACHINE="$mach"

    disk_parse "$spec"
    machine_load "$DISK_MACHINE" || die "unknown machine '$DISK_MACHINE'
    machines:
$(machine_list | sed 's/^/      /')"
    m_reachable || die "$DISK_MACHINE is not reachable over ssh, and the disk is attached to it."
    machine_armed_barrier "Writing a disk now would overwrite the medium that boot is aimed at,
    and the machine would come up on whatever this write left behind."
    [ -n "$DISK_DEV" ] || _resolve_disk_dev "${IMG_MACHINE:-}" || true
    [ -n "$DISK_DEV" ] || { log "disks attached to $DISK_MACHINE:"; disk_list
        die "say which one: --disk $DISK_MACHINE:<device>"; }

    # A fleet board built by this repo (yocto, buildroot) is edited locally
    # before it goes on the card: identity marker, systemd units, driving
    # key, root retargeted to survive a different device than the recipe
    # assumed. An image this repo did not build -- Jumpdrive (fetch), a
    # phone (pmos) -- gets only the identity marker and driving key, on the
    # card (disk_install_fleet).
    case "${IMG_BUILDER:-}" in yocto|buildroot) fleet_edit=1 ;; esac

    # Read once, decompressing on the way, into a local scratch file: one
    # read of the source instead of two, and every check below reads the
    # exact bytes about to be written rather than a hypothesis about them.
    info "reading $from"
    WRITE_TMP=$(mktemp)
    wk_atexit _disk_cleanup
    eval "$reader" > "$WRITE_TMP" || die "could not read the image through: $reader"
    size=$(file_bytes "$WRITE_TMP")
    [ "$size" -gt 0 ] || die "$from read as 0 bytes through: $reader"
    disk_refuse_unless_safe "$DISK_DEV" "$size"

    # A container exec or ssh session can print something of its own ahead
    # of the bytes -- an initialisation log, a shell banner -- and a
    # contaminated image would hash perfectly and fail on the board.
    sfdisk -J "$WRITE_TMP" >/dev/null 2>&1 \
        || die "$from has no readable partition table once decompressed.
    Something was written ahead of the image bytes on the way out, or this is
    not a disk image at all."

    # The id names what this is and which bytes it was read from: the
    # profile when there is one, otherwise the file's own name with the
    # compression suffix taken off. From the *source* bytes, computed once,
    # so it does not chase the edits below around.
    base=$(basename "${from#vm:}")
    base=${base%.xz}; base=${base%.zst}; base=${base%.gz}
    base=${base%.wic}; base=${base%.img}
    ID="${profile:-$base}-$(shasum -a 256 "$WRITE_TMP" | cut -c1-12)"
    marker="id=$ID
profile=${profile:-unknown}
machine=${IMG_MACHINE:-}
builder=${IMG_BUILDER:-}
role=$role
built_by=$(hostname)
wk_tools=$(git -C "$WK_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)
source=$from"

    local boot_checked="" root_line=""
    if [ -n "$fleet_edit" ]; then
        DISK="$WRITE_TMP"
        FAT_OFFSET=$(fat_offset "$DISK")
        [ -n "$FAT_OFFSET" ] && [ "$FAT_OFFSET" -gt 0 ] \
            || die "could not find the boot partition in $from"
        SEED=$(mktemp -d)
        wk_atexit _seed_cleanup

        info "adding the fleet integration (identity marker, watchdog, self-disarm)"
        install_fleet_integration "$(part_offset "$DISK" 2)" "$marker"
        install_driving_key "$(part_offset "$DISK" 2)"
        install_disk_id

        # Keyed off cmdline.txt, which only a Raspberry Pi firmware image
        # has: checked once, non-fatally, rather than letting retarget_root's
        # own `die` fire on an image with no such file.
        if cmdline_root_spec >/dev/null 2>&1; then
            retarget_root "$SEED"
            apply_cmdline_append "$SEED"
            apply_config_append "$SEED"
        else
            debug "no cmdline.txt in this image; not retargeting root or appending cmdline/config"
        fi
        rm -rf "$SEED"; SEED=""

        # Two checks, in the order the board will hit them: can the firmware
        # reach a kernel, then can that kernel reach its root. Only when the
        # image is *for* this machine -- the wrong question for a card about
        # to be carried elsewhere.
        local img_machine="${IMG_MACHINE:-}"
        if [ -n "$img_machine" ] && [ "$img_machine" = "$DISK_MACHINE" ]; then
            image_check_boot_files "$DISK" "$DISK_MACHINE"
            boot_checked=1
        elif [ -n "$img_machine" ]; then
            log "  (not checking $DISK_MACHINE's boot files: this is $img_machine's image, so this card goes elsewhere)"
        else
            log "  (not checking $DISK_MACHINE's boot files: no machine is known for this image)"
        fi
        image_check_root "$DISK" "$DISK_DEV" "$DISK_MACHINE"
        root_line=" ($(_root_line "$DISK"))"
    fi
    # The final bytes' own hash, for disk_verify_stream's post-write
    # read-back -- distinct from $ID's hash, which names the *source*.
    local sha; sha=$(shasum -a 256 "$WRITE_TMP" | cut -d' ' -f1)

    if [ -n "$dry" ]; then
        cat >&2 <<EOF
would write
  image     $from ($(human_bytes "$size"))
  identity  $ID
  onto      $DISK_DEV attached to $DISK_MACHINE
  edited    $([ -n "$fleet_edit" ] \
                && echo "yes -- identity marker, systemd units, driving key, retargeted root$root_line" \
                || echo "no -- not a fleet board build (${IMG_BUILDER:-unknown profile}); written as built")
  boot part $([ -n "$fleet_edit" ] \
                && { [ -n "$boot_checked" ] \
                       && printf 'every file a %s'"'"'s firmware asks for resolves (checked before this line)' "$DISK_MACHINE" \
                       || printf 'not checked -- see above' ; } \
                || printf 'not checked -- not a fleet board build')
  then      unique disk identity, tailnet identity,
            $([ "$grow" = 1 ] && echo "grow to fill" || echo "NO grow -- the rest of the card is left for a second system")
  tailnet   $(wk_tailscale_authkey_present \
                && printf 'auth key present -- the card joins as this board on first boot' \
                || printf 'NO auth key -- the real write refuses here (wk key tailnet)')
  wifi      $(_image_wants_wifi "${IMG_MACHINE:-}" \
                && { disk_wifi_creds_present \
                       && printf 'credentials present -- the card brings up WiFi on every boot' \
                       || printf 'NO credentials -- the real write refuses here (no --force)'; } \
                || printf 'not needed -- this board has a cable')
EOF
        [ "$DISK_DEV" = "${MACH_DEVICE:-}" ] && log "  note      $DISK_MACHINE is configured to boot from this disk (wk boot $DISK_MACHINE)"
        log "dry run -- nothing was written."
        return 0
    fi

    _tailnet_key_preflight "${IMG_MACHINE:-}"
    _tailnet_name_preflight "$(_tailnet_name_for "${IMG_MACHINE:-}")"
    _wifi_creds_preflight "${IMG_MACHINE:-}"

    warn "this ERASES $DISK_DEV on $DISK_MACHINE, whatever is on it now."
    confirm "write $from onto $DISK_DEV attached to $DISK_MACHINE?" || die "not written"

    disk_unmount "$DISK_DEV"
    disk_write_stream "$DISK_DEV" < "$WRITE_TMP"
    # Before anything else touches the card: every step after this reads the
    # partition table the image was supposed to bring, so a bad write shows
    # up as a confusing failure in whichever of them runs first.
    [ -n "${WK_NO_VERIFY:-}" ] || disk_verify_stream "$DISK_DEV" "$size" "$sha"
    disk_unique_identity "$DISK_DEV" "$(_card_root_spec "$DISK_DEV")"
    # A fleet board already carries its marker and driving key, written into
    # the bytes above; an image this repo did not build still needs them.
    [ -n "$fleet_edit" ] || disk_install_fleet "$DISK_DEV" "$marker" "$(driving_key)"
    disk_seed_role "$DISK_DEV" "$role"
    disk_seed_tailnet "$DISK_DEV" "$(_tailnet_name_for "${IMG_MACHINE:-}")"
    disk_seed_wifi "$DISK_DEV" "${IMG_MACHINE:-}"
    _disk_cleanup

    # Growing is opt-in: a card grown to fill has no room for a second
    # system, and a board with one system has no rescue -- it cannot install
    # anything without a person in the room.
    if [ "$grow" = 1 ]; then
        disk_grow "$DISK_DEV"
    else
        log "  the root partition was left at its built size, so the rest of the card"
        log "  is free for a second system. --grow fills it instead."
    fi
    disk_eject "$DISK_DEV"
    info "$DISK_DEV on $DISK_MACHINE now holds $ID"

    if [ "$DISK_DEV" = "${MACH_DEVICE:-}" ]; then
        # "Writing did not arm anything" is false of a medium-armed machine
        # unless this makes it true: its arming is the presence of
        # second-stage firmware on the boot partition, which the image being
        # written brings its own copy of. Left alone, the board would boot
        # the new image on its next reboot with nobody having asked -- the
        # surprise `wk boot` exists to make deliberate.
        if load_driver "${MACH_DRIVER:-}" 2>/dev/null \
           && [ "${BOOT_ARMING:-one-shot}" = medium ] \
           && command -v b_disarm >/dev/null 2>&1; then
            b_disarm
            debug "$DISK_MACHINE's $DISK_DEV was left disarmed"
        fi
        log "  $DISK_MACHINE is configured to boot from this disk, but writing it"
        log "  did not arm anything. To boot it -- once, reverting by itself:"
        log "      wk boot $DISK_MACHINE"
    else
        log "  nothing boots this yet. Move it to the board it is for, or point a"
        log "  machine at it; 'wk boot <machine>' is the one-shot."
    fi
}

# The `root=` the freshly written card's own cmdline names, read off the
# card: `disk_unique_identity` stamps a new disk identity and rewrites every
# reference to the old one, so it needs the old one read fresh, not trusted
# from what retarget_root computed before the write.
_card_root_spec() { # <device>
    local p1; p1=$(disk_part "$1" 1)
    m_ssh "set -e
        m=\$(mktemp -d)
        sudo mount -o ro $(sh_quote "$p1") \$m
        for f in \$m/cmdline.txt \$m/current/cmdline.txt; do
            [ -f \"\$f\" ] || continue
            tr ' ' '\n' < \"\$f\" | sed -n 's/^root=//p' | head -1
            break
        done
        sudo umount \$m; rmdir \$m" 2>/dev/null | tr -d '\r' | head -1
}

# The fleet's name for a machine, without clobbering the MACH_* of the machine
# every remote command here is talking to.
_tailnet_name_for() {
    [ -n "${1:-}" ] || return 0
    ( machine_load "$1" >/dev/null 2>&1 && printf '%s' "${MACH_SSH:-}" ) || true
}

cmd_write() {
    local spec="" dry="" grow=1 grow_set="" from="" profile="" role=bench mach=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --disk)    spec="${2:-}"; [ -n "$spec" ] || die "--disk needs <machine>:<device>"; shift 2 ;;
            --from)    from="${2:-}"; [ -n "$from" ] || die "--from needs a path, or vm:<path>"; shift 2 ;;
            --profile) profile="${2:-}"; shift 2 ;;
            --machine) mach="${2:-}"; [ -n "$mach" ] || die "--machine needs a name"; shift 2 ;;
            --rescue)  role=rescue; shift ;;
            --dry-run) dry=1; shift ;;
            --grow)    grow=1; grow_set=1; shift ;;
            --no-grow) grow=0; grow_set=1; shift ;;
            -*) die "unknown option: $1" ;;
            *)  die "unexpected argument: $1
    An image is bytes a workspace produced, not an id in a catalogue
    (wk help), so what identifies one is its path -- pass it to --from.
    'wk sysimage ls' lists every image a workspace here has built, with the
    path to pass." ;;
        esac
    done
    # Validated here, before anything is read or erased: the tailnet name a
    # card is seeded with (_tailnet_name_for) comes from
    # boot/machines/<name>.conf.
    [ -z "$mach" ] || machine_load "$mach" >/dev/null 2>&1 || die "unknown machine '$mach' for --machine
    machines:
$(machine_list | sed 's/^/      /')"

    # A rescue leaves the rest of the card alone unless told otherwise: on a
    # board with one medium holding both systems, growing the rescue to fill
    # it leaves no room to install a bench system. Explicit --grow still wins.
    if [ "$role" = rescue ] && [ -z "$grow_set" ]; then grow=0; fi

    [ -n "$from" ] || die "usage: wk sysimage write --from <path|vm:path> --disk <machine>:<device>
    An image is bytes a workspace produced, not an id in a catalogue
    (wk help), so what identifies one is its path.
    'wk sysimage ls' lists every image a workspace here has built, with the
    path to pass to --from."
    [ -n "$spec" ] || die "usage: wk sysimage write --from $from --disk <machine>:<device>
    'wk sysimage disks <machine>' lists what is attached where."

    # Leave the rest of the card alone by default, so there is room for the
    # second system that makes the board able to provision itself.
    [ -n "$grow_set" ] || grow=0
    cmd_write_from "$from" "$spec" "$dry" "$grow" "$profile" "$role" "$mach"
}

# Tombstone: 'flash' named the wrong thing twice over (see the die message).
cmd_flash() {
    local machine="${1:-<machine>}"
    die "'wk sysimage flash' does not exist -- it named the wrong thing twice.

    'flash <machine>' reads as reflashing $machine. That never happened: the
    machine's own system disk is refused, and what gets written is a removable
    disk plugged into it. And nothing here is permanent -- a machine boots such
    a disk once, by a firmware one-shot, and returns to host mode by itself.

    So the disk is named, and the verb says what it does to it:

        wk sysimage disks $machine                  what is attached over there
        wk sysimage write --from <path> --disk $machine:<device>

    Booting it is still a separate step, and still one-shot:  wk boot $machine"
}


case "${1:-}" in
    build) shift; cmd_build "$@" ;;
    ls|list) shift; cmd_ls "$@" ;;
    disks) shift; cmd_disks "$@" ;;
    write) shift; cmd_write "$@" ;;
    flash) shift; cmd_flash "$@" ;;
    rm) shift; cmd_rm "$@" ;;
    *) die "usage: wk sysimage <sub> [args]; see wk sysimage -h" ;;
esac
