#!/usr/bin/env bash
#
# wk find [<machine>] [options] -- every device on every segment this machine can reach
#
# wk: where=host name=none readonly group=hosts
#
#   (no argument)      every device on every segment this machine can reach
#   <machine>          only the device that is that fleet machine, and say which
#                      segment it was found on
#
#   --segment <cidr>   sweep this instead of the ones that are derived
#   --vantage <name>   sweep from this machine only (a fleet name, or 'local')
#   --no-ssh           do not ask anything that answers; MACs and names only
#   --timeout <s>      per-sweep ceiling (default 60)
#   --json             one JSON document (vantages, hits, summary) instead of
#                      the report; nothing else on stdout
#
# The question this answers is the 2am one: a board is not answering to its
# name, and the name is all there is (CLAUDE.md, "a node is reached by its
# tailnet name..."). A machine not on the tailnet, or on it and not
# answering, has no address anybody may write down -- the rpi3 (mDNS,
# unreliable) and rpi4 (a phone's USB-ethernet segment) are that case. So
# this derives the answer instead of storing it, by looking, now, from
# wherever there is to look from (lib/reach.sh does the same for the tailnet).
#
# --- the shape ---------------------------------------------------------------
#
#   a vantage    a place a sweep can run: this machine, for every subnet it
#                has an address on, and each bridge phone, for the segment
#                it routes. A segment nothing here sits on can't be swept,
#                and saying so is the useful answer.
#
#   the sweep    nmap, and only nmap, so a device found on one segment means
#                the same as one found on another. No ping-loop fallback.
#
#   the answer   the neighbour table, not nmap's verdict: unprivileged nmap
#                probes tcp/80 and 443 and calls a host with both closed
#                `down` while the board it just ARPed for sits right there.
#                The table needs no privilege, so it runs over a plain ssh.
#
#   heuristics   everything this repo already declares, joined to what was
#                found: a MAC that's a fleet machine's, a MAC a bridge pins a
#                lease for, an OUI that's a Raspberry Pi, an address the
#                tailnet knows a peer at. Nothing is stored here; all of it
#                is read from the confs that own it.
#
#   ssh          and then the device is asked. A board that answers has
#                /etc/wk-image, naming its image, builder and role.
#
# Read-only from end to end, and every probe is bounded -- a scan that
# overruns loses its own line, not the listing.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/reach.sh"
. "$WK_ROOT/image/profiles.sh"
. "$WK_ROOT/boot/machines.sh"

WANT=""; ONE_SEGMENT=""; ONE_VANTAGE=""; NO_SSH=""; SWEEP_TIMEOUT=60; WANT_JSON=""
while [ $# -gt 0 ]; do
    case "$1" in
        --segment) ONE_SEGMENT="${2:-}"; [ -n "$ONE_SEGMENT" ] || die "--segment needs a CIDR"; shift 2 ;;
        --vantage) ONE_VANTAGE="${2:-}"; [ -n "$ONE_VANTAGE" ] || die "--vantage needs a machine, or 'local'"; shift 2 ;;
        --no-ssh)  NO_SSH=1; shift ;;
        --timeout) SWEEP_TIMEOUT="${2:-}"; shift 2 ;;
        --json)    WANT_JSON=1; shift ;;
        -*) die "usage: wk find [<machine>] [options]; see wk find -h" ;;
        *)  [ -z "$WANT" ] || die "unexpected argument: $1"; WANT="$1"; shift ;;
    esac
done

case "$SWEEP_TIMEOUT" in ''|*[!0-9]*) die "--timeout takes seconds" ;; esac

# --- what this repo already declares ----------------------------------------
# Read, never sourced: a conf is a shell file and a report has no business
# executing one to print a line of it.

# <mac> <machine>, for every fleet machine that declares one.
fleet_macs() {
    local f m mac
    for f in "$WK_ROOT"/boot/machines/*.conf; do
        [ -f "$f" ] || continue
        m=$(basename "$f" .conf)
        mac=$(kv_field "$f" MACH_MAC | tr -d '"'"'"' ' | tr 'A-Z' 'a-z')
        [ -n "$mac" ] && printf '%s %s\n' "$mac" "$m"
    done
}

# <mac> <ip> <name> <bridge>, for every lease a bridge pins.
bridge_leases() {
    local f b
    for f in "$WK_ROOT"/bridge/hosts/*.conf; do
        [ -f "$f" ] || continue
        b=$(basename "$f" .conf)
        sed -n '/^BR_LEASES=/,/"[[:space:]]*$/p' "$f" 2>/dev/null \
            | tr -d '"' | tr ' \t' '\n\n' \
            | awk -F, -v b="$b" 'NF>=3 { print tolower($1), $2, $3, b }'
    done
}

# The OUI, for the vendors that matter here. Not a database: three prefixes
# the Raspberry Pi Foundation owns and the one the phones' USB adapters
# synthesise -- a full IEEE table would be a megabyte of fact nobody reads.
oui_vendor() {
    case "$(printf '%s' "$1" | tr 'A-Z' 'a-z' | cut -c1-8)" in
        b8:27:eb)             echo "Raspberry Pi (pre-4)" ;;
        d8:3a:dd|dc:a6:32|e4:5f:01|2c:cf:67)
                              echo "Raspberry Pi" ;;
        00:00:00)             echo "synthesised (USB adapter, no EEPROM)" ;;
        *)                    echo "" ;;
    esac
}

# --- vantages ----------------------------------------------------------------
# "<name> <cidr>" per line. `local` is this machine, first because a segment
# it sits on needs no hop and no other machine to be up. tailscale0 is
# deliberately not swept: it's a /32 on a mesh, not a broadcast domain, and
# the tailnet already answers for itself (reach_tailnet).
#
# Every bridge that declares a segment, reached at its own ssh name. A
# bridge that is down contributes a vantage that cannot be swept, which is
# the answer rather than an omission: a listing that silently dropped the
# segment would report its boards as absent.
bridge_segments() {
    local f b seg ssh
    for f in "$WK_ROOT"/bridge/hosts/*.conf; do
        [ -f "$f" ] || continue
        b=$(basename "$f" .conf)
        seg=$(kv_field "$f" BR_SEGMENT | tr -d '"'"'"' ')
        ssh=$(kv_field "$f" BR_SSH     | tr -d '"'"'"' ')
        [ -n "$seg" ] || continue
        printf '%s %s %s\n' "${ssh:-$b}" "$seg" "$b"
    done
}

vantages() {
    if [ -n "$ONE_SEGMENT" ]; then
        printf '%s %s %s\n' "${ONE_VANTAGE:-local}" "$ONE_SEGMENT" "given"
        return 0
    fi
    { reach_segments_local | sed 's/^/local /'; bridge_segments; } \
        | while read -r name cidr via; do
              [ -z "$ONE_VANTAGE" ] || [ "$name" = "$ONE_VANTAGE" ] || continue
              printf '%s %s %s\n' "$name" "$cidr" "$via"
          done
}

# --- the sweep ---------------------------------------------------------------
# The sweep is lib/reach.sh's (reach_sweep), deliberately not a second copy:
# `wk status` falls back to the same primitive, and two implementations of
# "what is on this wire" would eventually disagree. What this file adds is
# the *vantages* -- which segments there are and who can see them.
vantage_can_sweep() { # <vantage>
    [ "$1" = local ] && { have nmap; return $?; }
    ssh -o BatchMode=yes -o ConnectTimeout="${WK_SSH_TIMEOUT:-10}" "$1" \
        'PATH=$PATH:/usr/sbin:/sbin; command -v nmap >/dev/null 2>&1' </dev/null >/dev/null 2>&1
}

# --- asking a device what it is ----------------------------------------------
# Two destinations, tried in order, and the order is the whole subtlety.
#
# A fleet machine in host mode is reached over Tailscale SSH, which
# authenticates through the tailnet and has no authorized key at all -- so
# the same machine that answers instantly to `ssh rpi5` refuses its own LAN
# address with "Permission denied (publickey)". A *bench* system on the same
# board is the opposite: it carries no tailscale, so the address plus the
# driving key is the only way in. Which of the two a board is running is the
# thing being found out, so the declared name is tried first, then the
# address -- two different machines sharing a socket, not a fallback.
#
# The host key is deliberately not checked on the address: these boards boot
# a different image on demand and each brings its own key at the same
# address, so pinning one here could only produce the man-in-the-middle
# warning it looks exactly like.
_probe_cmd='cat /etc/wk-image 2>/dev/null
    echo "uname=$(uname -srm 2>/dev/null)"
    echo "host=$(hostname 2>/dev/null)"
    command -v tailscale >/dev/null 2>&1 && echo "tailscale=yes" || echo "tailscale=no"
    [ -e /etc/wk/rescue ] && echo "marker=rescue" || echo "marker=none"'

probe_ssh() { # <ip> [declared-ssh-name]
    [ -z "$NO_SSH" ] || return 0
    local ip="$1" name="${2:-}" out=""

    if [ -n "$name" ]; then
        out=$(capped 8 ssh -o BatchMode=yes -o ConnectTimeout=4 -o LogLevel=ERROR \
                  "$name" "$_probe_cmd" 2>/dev/null) || out=""
        [ -z "$out" ] || { printf '%s\n' "$out"; return 0; }
    fi

    capped 8 ssh -o BatchMode=yes -o ConnectTimeout=4 \
        -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR \
        "$(id -un)@$ip" "$_probe_cmd" 2>/dev/null || true
}

# The ssh name a fleet machine declares, if this device is one.
declared_ssh() { # <machine>
    [ -n "${1:-}" ] || return 0
    ( machine_load "$1" >/dev/null 2>&1 && printf '%s' "${MACH_SSH:-}" ) || true
}

field() { printf '%s\n' "$1" | sed -n "s/^$2=//p" | head -1; }

# --- report ------------------------------------------------------------------
# The inner loop over addresses is itself a subshell (rows are sorted before
# they are printed), so what it found is recorded in a file rather than a
# variable. One line per device.
HITS=$(mktemp)
_hits_cleanup() { rm -f "$HITS"; }
wk_atexit _hits_cleanup

# --json: one JSON object per line, written as it is found, read back and
# merged into one document at the end (like `wk status --records`).
if [ -n "$WANT_JSON" ]; then
    VANTAGES_JSON=$(mktemp)
    HITS_JSON=$(mktemp)
    _json_cleanup() { rm -f "$VANTAGES_JSON" "$HITS_JSON"; }
    wk_atexit _json_cleanup
fi

# No-ops outside --json, so every call site stays unconditional.
vantage_json() { # <swept: true|false>
    [ -n "$WANT_JSON" ] || return 0
    python3 -c 'import json, sys
print(json.dumps({"vantage": sys.argv[1], "segment": sys.argv[2], "via": sys.argv[3],
                   "swept": sys.argv[4] == "true"}))' "$vname" "$cidr" "$via" "$1"
}
hit_json() {
    [ -n "$WANT_JSON" ] || return 0
    python3 -c 'import json, sys
k = ["ip", "mac", "state", "machine", "vendor", "lease", "bridge", "hostname",
     "tailnet_peer", "wk_image_id", "wk_role", "wk_profile", "wk_builder",
     "tailscale", "marker", "uname"]
print(json.dumps(dict(zip(k, sys.argv[1:]))))' \
        "$ip" "$mac" "$state" "${machine:-}" "${vendor:-}" "${leasename:-}" "${bridgename:-}" \
        "${hn:-}" "${peer:-}" "${id:-}" "${role:-}" "${prof:-}" "${bld:-}" "${ts:-}" "${mk:-}" "${un:-}"
}

FLEET=$(fleet_macs)
LEASES=$(bridge_leases)
PEERS=$(wk_tailscale_peers)

# "<ip> <name>" for the nodes that declare no MAC anywhere. A bridge phone
# is the case: its downstream adapter belongs to whichever dock is plugged
# in, and a stale MAC in a conf is a bridge that comes up with no segment at
# all, so it cannot be recognised the way a board is -- only by the address
# it is answering at right now (reach_without_tailnet, lib/reach.sh),
# rebuilt every run.
declared_addrs() {
    local f b addr
    for f in "$WK_ROOT"/bridge/hosts/*.conf; do
        [ -f "$f" ] || continue
        b=$(basename "$f" .conf)
        addr=$(reach_without_tailnet "$b" 2>/dev/null | awk '{print $1}')
        case "$addr" in
            [0-9]*.[0-9]*) printf '%s %s\n' "$addr" "$b" ;;
        esac
    done
}
ADDRS=$(declared_addrs)

# Resolve a wanted machine to its MAC up front, so that "not found" can say
# what was being looked for rather than merely printing nothing.
WANT_MAC=""
if [ -n "$WANT" ]; then
    WANT_MAC=$(printf '%s\n' "$FLEET" | awk -v m="$WANT" '$2 == m { print $1; exit }')
    [ -n "$WANT_MAC" ] || die "'$WANT' is not a fleet machine with a declared MAC.
    A machine is found here by its hardware address, which is the one fact a
    board keeps across every image it boots -- so a machine that declares none
    cannot be looked for.
    machines:
$(machine_list | sed 's/^/      /')"
fi

# A here-string rather than a pipe: `vantages | while` puts the loop in a
# subshell, where every count it keeps is lost at the closing `done`.
SEEN=0; SWEPT=0; BLIND=0
while read -r vname cidr via; do
    [ -n "$vname" ] || continue
    label="$cidr"
    case "$via" in
        given) where="as asked" ;;
        *)     [ "$vname" = local ] && where="from this machine" \
                                   || where="through $via" ;;
    esac

    if ! vantage_can_sweep "$vname"; then
        warn "$label ($where): cannot be swept"
        if [ "$vname" = local ]; then
            log  "  nmap is not installed here, and there is deliberately no second sweeper."
            log  "  './setup' installs it."
        else
            log  "  $vname is unreachable, or has no nmap. Every device on this segment is"
            log  "  reached through it, so none of them is at fault for being absent here."
            log  "  wk bridge status $via"
        fi
        BLIND=$((BLIND + 1))
        vantage_json false >> "${VANTAGES_JSON:-/dev/null}"
        continue
    fi

    rows=$(WK_SWEEP_TIMEOUT="$SWEEP_TIMEOUT" reach_sweep "$cidr" "$vname" 2>/dev/null || true)
    SWEPT=$((SWEPT + 1))
    vantage_json true >> "${VANTAGES_JSON:-/dev/null}"

    if [ -z "$rows" ]; then
        info "$label ($where): nothing answered"
        continue
    fi

    info "$label ($where)"
    printf '%s\n' "$rows" | sort -t. -k4 -n | while read -r ip mac state; do
        [ -z "$WANT_MAC" ] || [ "$mac" = "$WANT_MAC" ] || continue

        machine=$(printf '%s\n' "$FLEET"  | awk -v m="$mac" '$1 == m { print $2; exit }')
        lease=$(printf '%s\n' "$LEASES"   | awk -v m="$mac" '$1 == m { print $3 " (" $4 " pins " $2 ")"; exit }')
        leasename=$(printf '%s\n' "$LEASES" | awk -v m="$mac" '$1 == m { print $3; exit }')
        bridgename=$(printf '%s\n' "$ADDRS" | awk -v i="$ip" '$1 == i { print $2; exit }')
        vendor=$(oui_vendor "$mac")

        # Asked before the tailnet lookup: a bridge phone declares no MAC
        # anywhere (the adapter belongs to whichever dock is plugged in), so
        # the only thing that ties the address on the wire to the peer on
        # the mesh is what the machine calls itself.
        info_out=$(probe_ssh "$ip" "${bridgename:-$(declared_ssh "$machine")}")
        hn=$(field "$info_out" host)
        # Unconditional (field() degrades to empty on an empty info_out): the
        # JSON hit below needs these whether or not the text report is built.
        id=$(field "$info_out" id); role=$(field "$info_out" role)
        prof=$(field "$info_out" profile); bld=$(field "$info_out" builder)
        ts=$(field "$info_out" tailscale); mk=$(field "$info_out" marker)
        un=$(field "$info_out" uname)

        # Joined on the *name*, never the address: a peer's tailnet address
        # is a 100.64/10 one on a mesh and this is a LAN address on a wire,
        # never equal, so matching them would report every machine here as
        # absent from a tailnet it is sitting on.
        peer=""
        for _n in $machine $leasename $bridgename $hn; do
            peer=$(printf '%s\n' "$PEERS" | awk -F'\t' -v n="$_n" '$1 == n { print $1 " at " $2 " (" $3 ")"; exit }')
            [ -z "$peer" ] || break
        done

        if [ -n "$WANT_JSON" ]; then
            hit_json >> "$HITS_JSON"
        else
            # The identifying line: what it is, if this repo knows, and otherwise
            # what its hardware says it is.
            printf '  %-15s %-17s %-9s %s\n' "$ip" "$mac" "$state" \
                "${machine:-${bridgename:-${hn:-$vendor}}}"

            [ -z "$machine" ] || printf '    %-16s %s\n' "fleet machine" \
                "$machine -- boot/machines/$machine.conf${vendor:+, $vendor}"
            [ -n "$machine" ] || [ -z "$vendor" ] || printf '    %-16s %s\n' "hardware" "$vendor"
            [ -z "$lease" ]   || printf '    %-16s %s\n' "reserved as" "$lease"
            [ -z "$bridgename" ] || printf '    %-16s %s\n' "tailnet bridge" \
                "$bridgename -- bridge/hosts/$bridgename.conf"

            # Only claimed about a device this repo can put a name to: "not
            # on the tailnet" is meaningless about a neighbour's printer.
            if [ -n "$machine" ] || [ -n "$leasename" ] || [ -n "$bridgename" ] || [ -n "$hn" ]; then
                if [ -n "$peer" ]; then
                    printf '    %-16s %s\n' "on the tailnet" "as $peer"
                else
                    printf '    %-16s %s\n' "on the tailnet" \
                        "not as any name this repo knows -- this address is how it is reached"
                fi
            fi

            if [ -n "$info_out" ]; then
                [ -z "$hn" ] || printf '    %-16s %s\n' "answers ssh as" "$hn${un:+  ($un)}"
                if [ -n "$id" ]; then
                    printf '    %-16s %s\n' "running" "$id"
                    printf '    %-16s %s\n' "  profile" "${prof:-not in its marker}${bld:+, built by $bld}"
                    printf '    %-16s %s\n' "  role" \
                        "${role:-not in its marker -- a card written before roles existed; rewrite it}$([ "$mk" = rescue ] && printf ' (the card carries the rescue marker)')"
                else
                    printf '    %-16s %s\n' "running" \
                        "no /etc/wk-image -- not a system wk wrote"
                fi
                [ "$ts" = yes ] || printf '    %-16s %s\n' "tailscale" \
                    "not installed on it, so its name cannot be how it is reached"
            elif [ -z "$NO_SSH" ] && { [ -n "$machine" ] || [ -n "$leasename" ] || [ -n "$bridgename" ]; }; then
                # Said only about a machine that should have answered.
                printf '    %-16s %s\n' "ssh" "no answer as $(id -un)"
            fi
        fi
        echo "$ip" >> "$HITS"
    done
done <<VANTAGES
$(vantages)
VANTAGES

SEEN=$(wc -l < "$HITS" | tr -d ' ')

if [ -n "$WANT_JSON" ]; then
    python3 -c 'import json, sys
def docs(path):
    with open(path) as f:
        return [json.loads(l) for l in f if l.strip()]
want, want_mac, seen, swept, blind = sys.argv[1:6]
print(json.dumps({
    "want": want or None, "want_mac": want_mac or None,
    "seen": int(seen), "swept": int(swept), "blind": int(blind),
    "vantages": docs(sys.argv[6]), "hits": docs(sys.argv[7]),
}))' "$WANT" "$WANT_MAC" "$SEEN" "$SWEPT" "$BLIND" "$VANTAGES_JSON" "$HITS_JSON"
    exit 0
fi

# The summary's whole job is to make an empty listing mean something.
# "Nothing was found" and "there was nowhere to look" are different answers,
# and the second one is the one that names a remedy.
log ""
if [ -n "$WANT" ]; then
    if [ "$SEEN" -gt 0 ]; then
        info "$WANT is up, at the address above ($WANT_MAC)"
    else
        warn "$WANT ($WANT_MAC) is on none of the $SWEPT segment$([ "$SWEPT" = 1 ] || printf s) that could be swept"
        log  "  Either it is powered off, or it is on a segment nothing here can see."
        [ "$BLIND" -eq 0 ] || log "  $BLIND segment$([ "$BLIND" = 1 ] && printf ' was' || printf 's were') unsweepable -- see above; the board may be on one of those."
        log  "  A board is found by its hardware address, so this is a fact about the"
        log  "  wire and not about a name: nothing here is stale."
    fi
else
    info "$SEEN device$([ "$SEEN" = 1 ] || printf s) on $SWEPT segment$([ "$SWEPT" = 1 ] || printf s)$(
        [ "$BLIND" -eq 0 ] || printf ', %s unsweepable' "$BLIND")"
fi

exit 0
