#!/usr/bin/env bash
#
# wk pr [<workspace>] <user>:<branch>|<n>|wpe:<n> -- check out a PR head, from either project
# wk: where=workspace name=optional ready=yes group=sources
#
# Three spellings, all pasted straight from a GitHub page:
#
#   wk pr justinmichaud:eng/non-cocoa-fuzz-Frame-cache-evicted-or-unparsed-frames-dereferenced
#   wk pr 1234          # WebKit/WebKit pull request #1234
#   wk pr wpe:1234      # WPEWebKit's pull request #1234
#
# <user>:<branch> is a fork's branch. The branch alone does not say which
# project it belongs to -- WebKit and WPEWebKit are separate repositories
# that share a history -- so both are tried: whichever fork of the two has
# that branch is the one it comes from, and a branch that exists in both is
# refused by name rather than guessed at.
#
# A bare number is a pull request against WebKit/WebKit; `wpe:<number>` is
# one against WPEWebKit. Neither needs the fork-discovery round trip above:
# GitHub serves a pull request's head under the base repository itself
# (refs/pull/<n>/head), so the project is already known from the spelling.
#
# Either way the branch or pull request is fetched once into this machine's
# mirror (the same one 'wk sync' keeps, under refs/remotes/pr/...) and the
# workspace then fetches that one ref from there -- local and near-instant --
# rather than going to GitHub again on every re-run and every workspace. A
# workspace with no /mirror (a remote build machine, a guest predating the
# mount) falls back to fetching straight from GitHub, exactly as before.
#
# The remote is added if it is not there (a fork of a project this tooling
# already knows), the branch is checked out tracking it, and that is all. No
# confirmation for any of it: fetching, adding a remote and checking out are
# routine and reversible, and a command that asks four times is a command that
# gets answered without reading.
#
# The exception, and the only warning this prints, is *your* work:
#
#   uncommitted changes in the tree are named before anything moves, because a
#   checkout carries them across and they are easy to forget;
#   a local branch of the same name that has commits the PR head does not is
#   never overwritten -- it is checked out as it is, and what would be lost is
#   named. `--force` takes the remote version instead, discarding yours.
#
# A fourth form, not a PR at all:
#
#   wk pr rebase [<workspace>]
#
# fetches this machine's mirror (just enough for origin/main) into the
# workspace and rebases the current branch onto origin/main -- the reminder
# 'wk sync' prints after every fetch, as a command rather than a suggestion.
# Either order works: 'wk pr <ws> rebase' resolves <ws> the ordinary way;
# 'wk pr rebase <ws>' and a bare 'wk pr rebase' (inside the workspace) are
# handled here, since "rebase" itself is never mistaken for a workspace name.
#
# Runs in the workspace, like `wk build`: from a host, name it; from inside
# one, do not.
#
#   --force   take the PR head even when the local branch has commits it
#             does not, discarding them
#
# TODO: 'wk pr open' -- opening this branch as a PR on GitHub needs gh wired
# in and is not implemented here.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# The workspace name arrives as $WK_NAME (the dispatcher resolves it inside a
# workspace, and on a host by checking the first word against the registry).
NAME="${WK_NAME:-}"
SPEC="${1:-}"

# 'rebase' is never a workspace name the dispatcher could have resolved (slot
# 1 only matches a real one), so it always survives as $1 here, whichever
# order it was typed in. A workspace named afterwards is $2 only when $NAME
# is still empty -- 'wk pr <ws> rebase' already consumed <ws> as $NAME.
if [ "$SPEC" = rebase ]; then
    [ -n "$NAME" ] || NAME="${2:-}"
    [ -n "$NAME" ] || die "usage: wk pr rebase [<workspace>]; run inside a workspace, or name one; see wk pr -h"
    shift $#
    require_name "$NAME"
    load_target "$(ws_target "$NAME")"
    SRC=$(t_src "$NAME")

    info "fetching in '$NAME' from the mirror, then rebasing onto origin/main"
    if t_exec "$NAME" bash -c "
        set -e
        cd $(sh_quote "$SRC")
        if [ -d /mirror/WebKit.git ]; then
            git fetch --prune --quiet /mirror/WebKit.git '+refs/heads/*:refs/remotes/origin/*'
        else
            git fetch --prune --quiet origin
        fi
        git rebase origin/main
    "; then
        info "'$NAME' is rebased onto origin/main"
        log  "  $(t_exec "$NAME" bash -c "cd $(sh_quote "$SRC") && git --no-pager log --oneline -1" 2>/dev/null | tr -d '\r')"
        exit 0
    else
        warn "the rebase stopped -- almost always a conflict, and the sequencer holds where."
        log  "  in the workspace:  git status; git rebase --continue   (or --abort)"
        exit 1
    fi
fi

[ -n "$NAME" ] && [ -n "$SPEC" ] \
    || die "usage: wk pr [<workspace>] <user>:<branch>|<n>|wpe:<n>, or 'wk pr rebase [<ws>]'; see wk pr -h"
shift $#

require_name "$NAME"
load_target "$(ws_target "$NAME")"

# Everything else -- resolving the spec, fetching it into the mirror once,
# and checking it out in the workspace from there -- is one function shared
# with `wk new --pr`, so the two commands cannot drift apart (lib/store.sh).
wk_pr_checkout "$NAME" "$SPEC"
