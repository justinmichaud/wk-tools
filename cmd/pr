"""check out a PR head, from either project

  wk pr justinmichaud:eng/non-cocoa-fuzz-Frame-cache-evicted-or-unparsed-frames-dereferenced
  wk pr 1234                                 WebKit/WebKit pull request #1234
  wk pr wpe:1234                             WPEWebKit's pull request #1234
  wk pr rebase [<workspace>]                 rebase the current branch onto origin/main
  wk pr open <workspace> [--draft] [--web]   push the branch and open it as a PR

<user>:<branch> is a fork's branch; both projects are tried, and a branch existing in both is refused by name. The one
ref is fetched from GitHub straight into the workspace's checkout (not the mirror), and a remote for an account that has
none yet is added there. Uncommitted changes are named before anything moves, and a local branch with commits the PR
head lacks is kept, only named; --force takes the PR head anyway, discarding them.

'rebase' fetches origin/main from the mirror into the workspace and rebases the current branch onto it; a bare
'wk pr rebase' runs inside a workspace.

'open' pushes the workspace's current branch to its fork and opens it as a pull request with `gh pr create --fill`;
host only. The project comes from the upstream the branch tracks; no upstream, `main`, a detached HEAD, or a dirty tree
is refused by name. The push goes through the push service, as a person's own run. A build box's branch is fetched over
ssh into this machine's mirror and pushed from here: no key reaches a box.
"""
from wk import pr, store
from wk.decl import Command, Opt

COMMAND = Command(name="optional", ready=True, repos=("webkit",), default="checkout", group="sources", subs={
    "checkout": dict(takes=("<user>:<branch>|<n>|wpe:<n>",)), "rebase": {},
    "open": dict(where="host", needs=("gh", "gh-auth"), opts=(Opt("--draft", "open it as a draft"),
                                                              Opt("--web", "open the browser's new-PR form instead")))})


def main(args, inv):
    name = store.ws_name() or args.name or ""
    return pr.main(name, args.positionals, args.flag("--draft"), args.flag("--web"))
