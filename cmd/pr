#!/usr/bin/env python3
#
# wk pr [<workspace>] <user>:<branch>|<n>|wpe:<n> -- check out a PR head, from either project
# wk: where=workspace name=optional takes=1 ready=yes group=sources
# wk: sub open where=host name=optional@2 takes=0 opts=--draft,--web needs=gh,gh-auth
# wk: sub rebase name=optional@2 takes=0
#
#   wk pr justinmichaud:eng/non-cocoa-fuzz-Frame-cache-evicted-or-unparsed-frames-dereferenced
#   wk pr 1234                                 # WebKit/WebKit pull request #1234
#   wk pr wpe:1234                             # WPEWebKit's pull request #1234
#   wk pr rebase [<workspace>]                 # rebase the current branch onto origin/main
#   wk pr open <workspace> [--draft] [--web]   # push the branch and open it as a PR
#
# <user>:<branch> is a fork's branch; both projects are tried, and a branch existing in both is
# refused by name. A bare number is a WebKit/WebKit pull request, `wpe:<number>` a WPEWebKit one.
#
# Either way the one ref is fetched from GitHub straight into the workspace's checkout, and a
# remote for an account that has none yet is added there. The machine's mirror is not involved:
# it exists to hold the history the workspaces share, and a PR head is neither shared nor in it.
# The fetch is thin -- the checkout already has the history those commits sit on -- and it is the
# same from the host and from inside a workspace.
#
# Uncommitted changes are named before anything moves, and a local branch with commits the PR head
# lacks is never overwritten, only named.
#
#   --force   take the PR head even when the local branch has commits it does not, discarding them
#
# 'rebase' fetches just enough of the mirror for origin/main into the workspace and rebases the
# current branch onto it; either argument order works, and a bare 'wk pr rebase' runs inside a
# workspace.
#
# 'open' pushes the workspace's current branch to its fork and opens it as a pull request with
# `gh pr create --fill`. Runs on the host only and refuses inside a workspace. The project comes
# from which upstream the branch tracks; no upstream, `main`, a detached HEAD, or a dirty tree is
# refused by name. Pushing needs `wk push on`, which is never flipped here.
#
#   --draft   open it as a draft
#   --web     open the browser's new-PR form instead of creating it directly

import os
import re
import subprocess
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import shell, targets  # noqa: E402
from wk.act import Refused, die, info, log, warn  # noqa: E402
from wk.targets import show  # noqa: E402
from wk.workspace import require_name  # noqa: E402

WK = os.path.join(ROOT, "wk")


class PrOpenError(Exception):
    pass


def _run_local(argv):
    cp = subprocess.run(argv, capture_output=True, text=True)
    return cp.returncode, cp.stdout, cp.stderr


def _owner_of(url):
    m = re.search(r"[:/]([^/]+)/[^/]+$", re.sub(r"\.git$", "", url))
    return m.group(1) if m else ""


def _repo_of(url):
    return re.sub(r"(\.git)?$", "", url).rsplit("/", 1)[-1]


def pr_open_target(src, run=_run_local, remotes=None, push_forks=None):
    """(base-repo, "<owner>:<branch>", fork-remote, branch) for the checkout at `src`, or PrOpenError naming what stops it."""
    def git(*args):
        rc, out, _ = run(["git", "-C", str(src)] + list(args))
        return rc, out.strip()

    rc, branch = git("symbolic-ref", "--quiet", "--short", "HEAD")
    if rc != 0 or not branch:
        raise PrOpenError("'wk pr open' needs a branch checked out, not a detached HEAD")
    if branch == "main":
        raise PrOpenError("'wk pr open' cannot open 'main' as a pull request -- create a branch first")
    _, dirty = git("status", "--porcelain")
    if dirty:
        raise PrOpenError("the tree has uncommitted changes -- commit or stash them: git -C %s status" % src)
    rc, up = git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if rc != 0 or not up:
        raise PrOpenError("'%s' has no upstream, so 'wk pr open' cannot tell which project it belongs to -- "
                          "track one first: git branch -u origin/main (WebKit) or wpe/main (WPEWebKit)" % branch)
    up_remote = up.split("/", 1)[0]
    # Not `git remote get-url`: through the mirror's insteadOf every remote reads as the mirror, and both projects as one.
    _, up_url = git("config", "--get", "remote.%s.url" % up_remote)
    up_repo = _repo_of(up_url)
    if push_forks is None:
        push_forks = shell.wk_push_forks(ROOT)
    fork_names = {r for r, _, _ in push_forks}
    # The project's upstream, not the remote the branch happens to track: `wk pr` leaves a
    # branch tracking the fork it came from, and a pull request against that is one against yourself.
    fork = next((r for r, repo, _ in push_forks if _repo_of(repo) == up_repo), None)
    if not fork:
        raise PrOpenError("'%s' tracks '%s' (%s), not a known upstream (origin or wpe) -- "
                          "'wk pr open' only knows WebKit and WPEWebKit" % (branch, up, up_url))
    rc, url = git("config", "--get", "remote.%s.url" % fork)
    if rc != 0 or not url:
        raise PrOpenError("no '%s' remote here -- 'wk sync --fix' wires it" % fork)
    owner = _owner_of(url)
    if remotes is None:
        remotes = shell.wk_remotes(ROOT)
    base = ""
    for name, remote_url in remotes:
        if name in fork_names:
            continue
        if remote_url.endswith("/%s.git" % up_repo):
            base = re.sub(r"^https://github\.com/", "", remote_url)
            base = re.sub(r"\.git$", "", base)
            break
    if not base:
        raise PrOpenError("no upstream in wk_remotes for the project '%s', so there is nothing to open '%s' against"
                          % (up_repo, branch))
    return base, "%s:%s" % (owner, branch), fork, branch


def pr_open_gh_args(base, head, *flags):
    args = ["--repo", base, "--head", head, "--fill"]
    args += [f for f in flags if f in ("--draft", "--web")]
    return args


def pr_rebase(target, name):
    src, mirror = target.src(name), target.mirror_dir()
    info("fetching in '%s' from the mirror, then rebasing onto origin/main" % name)
    if mirror and target.exec(name, ["test", "-d", mirror]).ok:
        r = target.exec(name, ["git", "-C", src, "fetch", "--prune", "--quiet", mirror,
                               "+refs/heads/*:refs/remotes/origin/*"])
    else:
        r = target.exec(name, ["git", "-C", src, "fetch", "--prune", "--quiet", "origin"])
    if r.ok:
        r = target.exec(name, ["git", "-C", src, "rebase", "origin/main"])
    if r.ok:
        info("'%s' is rebased onto origin/main" % name)
        r = target.exec(name, ["git", "-C", src, "--no-pager", "log", "--oneline", "-1"])
        log("  %s" % r.out.replace("\r", "").strip())
        return 0
    show(r)
    warn("the rebase stopped -- almost always a conflict, and the sequencer holds where.")
    log("  in the workspace:  git status; git rebase --continue   (or --abort)")
    return 1


def pr_open(target, name, draft, web):
    src = target.src(name)
    info("reading '%s's branch and remotes" % name)

    def _target_run(argv):
        r = target.exec(name, argv)
        return r.rc, r.out, r.err

    try:
        base, head, fork, branch = pr_open_target(src, run=_target_run)
    except PrOpenError as e:
        sys.stderr.write("error: %s\n" % e)
        die("'%s' is not ready to open as a pull request -- see above" % name)

    if subprocess.run([WK, "push", "status"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        die("'wk pr open' pushes '%s' to '%s', and the deploy key is held back.\n    wk push on" % (branch, fork))

    info("pushing '%s' to '%s'" % (branch, fork))
    r = target.exec(name, ["git", "-C", src, "push", "-u", fork, branch])
    show(r)
    if not r.ok:
        die("the push to '%s' failed -- see above.\n    If the deploy key is the problem:  wk push on" % fork)

    flags = (["--draft"] if draft else []) + (["--web"] if web else [])
    info("opening a pull request: %s <- %s" % (base, head))
    return subprocess.run(["gh", "pr", "create"] + pr_open_gh_args(base, head, *flags)).returncode


def _load(reg, name):
    try:
        return reg.load(reg.ws_target(name))
    except LookupError as e:
        die(str(e))


def main(argv):
    name = os.environ.get("WK_NAME", "")
    spec = argv[0] if argv else ""
    reg = targets.Registry(ROOT)

    # 'rebase' never matches a workspace name, so it survives as argv[0] and a name after it is argv[1].
    if spec == "rebase":
        if not name:
            name = argv[1] if len(argv) > 1 else ""
        if not name:
            die("usage: wk pr rebase [<workspace>]; run inside a workspace, or name one; see wk pr -h")
        require_name(name)
        target = _load(reg, name)
        return pr_rebase(target, name)

    if spec == "open":
        rest = argv[1:]
        draft = "--draft" in rest
        web = "--web" in rest
        name2 = ""
        for a in rest:
            if a not in ("--draft", "--web"):
                name2 = a
        if not name:
            name = name2
        if not name:
            die("usage: wk pr open <workspace> [--draft] [--web]; see wk pr -h")
        require_name(name)
        target = _load(reg, name)
        return pr_open(target, name, draft, web)

    if not spec:
        die("usage: wk pr [<workspace>] <user>:<branch>|<n>|wpe:<n>, or 'wk pr rebase [<ws>]', or "
            "'wk pr open <ws> [--draft] [--web]' (from the host); see wk pr -h")
    # takes=1 means the ref is never read as a workspace name, so what is missing is the workspace.
    if not name:
        die("'wk pr %s' does not say which workspace to check it out into.\n"
            "    Name one:        wk pr <workspace> %s   ('wk ls' lists them)\n"
            "    or run it in one: wk pr %s" % (spec, spec, spec))

    require_name(name)
    try:
        tname = reg.ws_target(name)
        reg.load(tname)
    except LookupError as e:
        die(str(e))
    shell.pr_checkout(ROOT, reg.machine, tname, name, spec)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
