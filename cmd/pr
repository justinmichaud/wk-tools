#!/usr/bin/env bash
#
# wk pr [workspace] <user>:<branch> -- check out a PR head, from either project.
#
# GitHub's own syntax for a PR head, pasted straight from the page:
#
#   wk pr justinmichaud:eng/non-cocoa-fuzz-Frame-cache-evicted-or-unparsed-frames-dereferenced
#
# The branch alone does not say which project it belongs to -- WebKit and
# WPEWebKit are separate repositories that share a history -- so both are
# tried: whichever fork of the two has that branch is the one it comes from,
# and a branch that exists in both is refused by name rather than guessed at.
# Nothing about the name is parsed for meaning; `eng/…` with slashes in it is
# an ordinary branch name.
#
# The remote is added if it is not there (a fork of a project this tooling
# already knows), the branch is checked out tracking it, and that is all. No
# confirmation for any of it: fetching, adding a remote and checking out are
# routine and reversible, and a command that asks four times is a command that
# gets answered without reading.
#
# The exception, and the only warning this prints, is *your* work:
#
#   uncommitted changes in the tree are named before anything moves, because a
#   checkout carries them across and they are easy to forget;
#   a local branch of the same name that has commits the PR head does not is
#   never overwritten -- it is checked out as it is, and what would be lost is
#   named. `--force` takes the remote version instead, discarding yours.
#
# Runs in the workspace, like `wk build`: from a host, name it; from inside
# one, do not.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

usage() {
    if in_workspace; then log "usage: wk pr <user>:<branch>"
    else log "usage: wk pr <workspace> <user>:<branch>"; fi
    exit 2
}

# The workspace name is optional inside one, exactly as in `wk build`: there is
# one workspace in here and it is this machine. A PR argument always contains a
# colon, which is what tells the two forms apart -- a workspace name cannot
# contain one (valid_name).
NAME=""; SPEC=""
case "${1:-}" in
    '') usage ;;
    *:*) SPEC="$1"; in_workspace && NAME=$(wk_self) || usage ;;
    *)  refuse_ws_name "$1" pr "<user>:<branch>"
        NAME="$1"; SPEC="${2:-}"; [ -n "$SPEC" ] || usage ;;
esac
shift $#

case "$SPEC" in *:*) ;; *) usage ;; esac
PR_USER="${SPEC%%:*}"
BRANCH="${SPEC#*:}"
[ -n "$PR_USER" ] && [ -n "$BRANCH" ] || die "expected <user>:<branch>, got '$SPEC'"

require_name "$NAME"
TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

# The same gate as build, run, test and claude (wait_ready, lib/target.sh):
# this checks out a branch *in* the workspace, so it needs one that finished
# being made. `absent` is still refused by name; a creation that died, an
# environment removed by hand and a machine that will not answer each get the
# words that fit -- this said "no such workspace" about all four.
wait_ready "$NAME"

SRC=$(t_src "$NAME")

# --- 1. which project, and what is here already ------------------------------
#
# One round trip that changes nothing: which of the projects has this branch,
# what the head is, whether a remote for that user already exists, and what
# the local side looks like. Everything that follows is decided from this, out
# here, where the answers can be reported.
#
# `git ls-remote` over HTTPS is anonymous and needs no credential -- the same
# reason fetching a fork works while `wk push` is off.
probe=$(t_exec "$NAME" bash -c "
    cd $(sh_quote "$SRC") || exit 1
    for repo in $(wk_pr_repos | tr '\n' ' '); do
        url=https://github.com/$(sh_quote "$PR_USER")/\$repo.git
        sha=\$(git ls-remote \"\$url\" refs/heads/$(sh_quote "$BRANCH") 2>/dev/null | awk '{print \$1}')
        [ -n \"\$sha\" ] && echo \"found=\$repo \$url \$sha\"
    done
    # A remote that already points at this user's copy of one of them, so a
    # second one is not added beside it under a different name.
    for r in \$(git remote); do
        u=\$(git remote get-url \"\$r\")
        case \"\$u\" in
            *[:/]$(sh_quote "$PR_USER")/*) echo \"remote=\$r \$u\" ;;
        esac
    done
    echo \"head=\$(git rev-parse --abbrev-ref HEAD 2>/dev/null)\"
    echo \"local=\$(git rev-parse --verify --quiet refs/heads/$(sh_quote "$BRANCH") || true)\"
    echo \"dirty=\$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')\"
" 2>/dev/null | tr -d '\r') || die "could not reach the checkout in '$NAME'"

found=$(printf '%s\n' "$probe" | sed -n 's/^found=//p')
n=$(printf '%s\n' "$found" | grep -c . || true)
case "$n" in
0) die "no branch '$BRANCH' in $(wk_pr_repos | tr '\n' '/' | sed 's|/$||') under '$PR_USER'.
    Checked: $(wk_pr_repos | sed "s|^|https://github.com/$PR_USER/|;s|\$|.git|" | tr '\n' ' ')" ;;
1) ;;
*) die "'$BRANCH' exists in more than one of $PR_USER's repositories:
$(printf '%s\n' "$found" | sed 's/^/    /')
    They are different projects; check the PR page for which one it is and
    fetch that remote by hand." ;;
esac

REPO=$(printf '%s' "$found" | awk '{print $1}')
URL=$(printf '%s' "$found"  | awk '{print $2}')
HEAD_SHA=$(printf '%s' "$found" | awk '{print $3}')
LOCAL_SHA=$(printf '%s\n' "$probe" | sed -n 's/^local=//p')
DIRTY=$(printf '%s\n' "$probe" | sed -n 's/^dirty=//p')
REMOTE=$(printf '%s\n' "$probe" | sed -n 's/^remote=//p' | awk -v u="$URL" '$2 == u {print $1; exit}')

# The name a new remote gets. The user's, with the project appended when it is
# not the one `origin` is -- one user can have a PR in both, and two remotes
# cannot share a name.
if [ -z "$REMOTE" ]; then
    REMOTE="$PR_USER"
    [ "$REPO" = "$(wk_pr_repos | head -1)" ] || REMOTE="$PR_USER-$(printf '%s' "$REPO" | tr 'A-Z' 'a-z')"
fi

# --- 2. what this would cost -------------------------------------------------
if [ "${DIRTY:-0}" -gt 0 ] 2>/dev/null; then
    warn "'$NAME' has $DIRTY uncommitted change(s); the checkout carries them across"
fi

RESET=""
if [ -n "$LOCAL_SHA" ] && [ "$LOCAL_SHA" != "$HEAD_SHA" ]; then
    # Whether it is *your* work at stake is the whole question, so it is asked
    # of git rather than assumed: commits on the local branch that the PR head
    # does not have. None of them means the branch is simply behind, and
    # fast-forwarding it costs nothing.
    ahead=$(t_exec "$NAME" bash -c "
        cd $(sh_quote "$SRC") &&
        git fetch --quiet $(sh_quote "$URL") $(sh_quote "$BRANCH") 2>/dev/null &&
        git rev-list --count FETCH_HEAD..$(sh_quote "$BRANCH") 2>/dev/null || echo unknown
    " 2>/dev/null | tr -d '\r' | tail -1)

    case "$ahead" in
        0)  RESET=1 ;;   # behind or equal: taking the PR head loses nothing
        unknown)
            barrier "cannot tell whether '$BRANCH' in '$NAME' has work the PR head does not.
    Checking it out will leave it as it is."
            ;;
        *)
            if [ -n "${WK_FORCE:-}" ]; then
                barrier "discarding $ahead local commit(s) on '$BRANCH' in '$NAME'."
                RESET=1
            else
                warn "local '$BRANCH' has $ahead commit(s) the PR head does not have"
                log  "  it is checked out as it is; nothing is discarded."
                log  "  to take the PR head instead and lose those commits:"
                log  "    wk pr${NAME:+ $NAME} $SPEC --force"
            fi
            ;;
    esac
fi

# --- 3. do it ----------------------------------------------------------------
t_exec "$NAME" bash -c "
    set -e
    cd $(sh_quote "$SRC")
    git remote get-url $(sh_quote "$REMOTE") >/dev/null 2>&1 \
        || git remote add $(sh_quote "$REMOTE") $(sh_quote "$URL")
    git remote set-url $(sh_quote "$REMOTE") $(sh_quote "$URL")
    git fetch --quiet $(sh_quote "$REMOTE") $(sh_quote "$BRANCH")
    if git show-ref --verify --quiet refs/heads/$(sh_quote "$BRANCH"); then
        git checkout --quiet $(sh_quote "$BRANCH")
        ${RESET:+git reset --hard --quiet $(sh_quote "$REMOTE")/$(sh_quote "$BRANCH")}
    else
        git checkout --quiet -b $(sh_quote "$BRANCH") --track $(sh_quote "$REMOTE")/$(sh_quote "$BRANCH")
    fi
    git branch --quiet --set-upstream-to=$(sh_quote "$REMOTE")/$(sh_quote "$BRANCH") $(sh_quote "$BRANCH") 2>/dev/null || true
" || die "could not check out '$BRANCH' in '$NAME'"

info "'$NAME' is on $BRANCH ($REPO, from $REMOTE)"
# --no-pager, and it is not cosmetic: the driver's exec gives the command a
# terminal, so `git log` starts a pager and waits for a keystroke that is never
# coming -- which looks exactly like a fetch that will not finish. Measured
# once, at seven minutes.
log  "  $(t_exec "$NAME" bash -c "cd $(sh_quote "$SRC") && git --no-pager log --oneline -1" 2>/dev/null | tr -d '\r')"
