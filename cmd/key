#!/usr/bin/env bash
#
# wk key check|setup|set|deploy|show|ensure -- the credentials this machine holds
# wk: where=host name=none group=sources needs gh,gh-auth takes=1 destructive setup,deploy,--replace
# wk: sub show,ensure,pub,sshtest,fingerprints,set,register,claude,tailnet,tailnet-api,share,adopt,verdict,give needs=
# wk: sub set,pub,sshtest,adopt,verdict,give takes=2
# wk: sub set opts=--replace,--paste
# wk: sub deploy,setup opts=--rotate
#
#   wk key setup      every credential this machine needs, and one working
#                     credential of each kind on every workstation. The one
#                     command a new machine needs, and the one that keeps the
#                     fleet holding the same keys:
#                       the deploy keys, the GitHub API token and the Bugzilla
#                       API key are elected. Every workstation is asked what it
#                       holds and whether its issuer still accepts it, at that
#                       moment, and the best working answer wins -- age counts
#                       for nothing. The winner is put on every workstation
#                       holding a different one, and a tie goes to this machine,
#                       so a fleet that already agrees is left alone.
#                       When no workstation holds one that works, this machine
#                       mints or is asked for one, and that one is fanned out.
#                       The claude.ai login is never copied: a workstation
#                       without a usable one is logged in for here and sent only
#                       its own. The rest -- claude, litellm, tailnet,
#                       tailnet-api, ntfy -- are this machine's own, stored if
#                       missing and asked for again if their issuer now refuses
#                       them.
#                     A build machine is sent nothing: it keeps no credential at
#                     rest and reaches the elected deploy key through an
#                     ssh-agent forwarded from whoever drives the push. One line
#                     per credential -- stored, minted, taken, skipped or
#                     refused -- and then `wk key check`'s table. It overwrites
#                     what the other workstations hold, so it asks once, first,
#                     and it can be killed and re-run
#                       --rotate  turn every credential over rather than elect
#                                 one: the deploy keys as `wk key deploy
#                                 --rotate` does, then each stored credential
#                                 replaced as `wk key set <name> --replace`
#                                 does, and the fresh ones fanned out
#   wk key set <name> [--replace] [--paste]
#                     one credential by name, or the report on it when it is
#                     already here.
#                       --replace  rotate it: the old one is removed first
#                       --paste    take the value on stdin instead of minting
#                                  one, so a second machine can hold the same
#                                  minted credential as the first
#                     <name> is a row of lib/credcheck.py:
#
#                       github-pat    what `git-webkit pr` opens a pull request
#                                     with. Never enters a workspace: only the credential
#                                     injector reads it, which reads GitHub
#                                     with it whatever position `wk push` is in
#                                     and writes only while it is on. Refused
#                                     unless it reaches exactly the forks in
#                                     wk_push_forks: the token page cannot
#                                     preselect them, so its own answer to
#                                     `GET /user/repos` is what decides
#                       bugzilla-api-key
#                                     what `git-webkit pr` files and updates the
#                                     bug with. Never enters a workspace either:
#                                     the injector adds it to every
#                                     bugs.webkit.org request while `wk push` is
#                                     on and to none while it is off. Judged as
#                                     the login WebKit's contributors.json gives
#                                     this GitHub account
#                       claude        the Claude Code token a build box's agent
#                                     starts authenticated with (`claude
#                                     setup-token` prints one); inference only
#                       claude-login  the claude.ai login every container and
#                                     guest here shares,
#                                     made once here in a browser with the
#                                     shared directory as the CLI's config home,
#                                     so the credential and the account record
#                                     remote control reads land beside each
#                                     other; separate from this machine's own
#                                     login so neither refresh invalidates the
#                                     other. The second of Claude's two, and
#                                     what `wk ai claude <ws> --rc` needs
#                       litellm       the API key `wk ai pi` reaches your
#                                     LiteLLM endpoint with
#                       tailnet       the fleet's tailnet auth key, seeded onto
#                                     every card written here
#                       tailnet-api   the tailnet API token this machine
#                                     retires a stale fleet node with; never
#                                     written to a card
#                       ntfy          the ntfy.sh topic `wk notify` publishes
#                                     to, so the fleet can tell you it wants
#                                     you. Minted here, never invented: the
#                                     topic name is the whole credential, so it
#                                     is printed once, as it is minted, and
#                                     never written to a card or held by a
#                                     workspace
#
#   wk key deploy     the deploy keys alone, elected and converged the way
#                     `setup` does them: the key each fork's repository accepts
#                     wins, it is registered on GitHub with write access under a
#                     single title, and every workstation holding a different
#                     one takes it. --rotate removes the old keys from GitHub
#                     and mints fresh ones instead of electing. Asks once, first
#   wk key check      what every credential this machine holds can do and how
#                     far it reaches, what each other workstation holds of the
#                     ones the fleet shares, and whether each holds a claude.ai
#                     login of its own -- every line asked again at that moment.
#                     Read-only, and what a bare `wk key` runs
#   wk key show       print the public halves
#   wk key ensure     create missing push keys without registering them
#
# One key per fork, the same on every workstation and shared by every workspace:
# GitHub deploy keys are scoped to a single repository and refuse the same key on
# a second one, so a compromised workspace can push to the forks in wk_push_forks
# and nowhere else. The one key per fork is registered once and held on every
# workstation. Which key that is, and which GitHub API token and Bugzilla API
# key the fleet uses, is decided by evidence taken at that moment rather than by
# where one was last stored: 'wk key setup' asks every workstation what it holds
# and whether its issuer still accepts it, and the best working answer is put
# everywhere. Rotating ('wk key setup --rotate', or 'wk key deploy --rotate' for
# the keys alone) turns the whole fleet over from one command.
#
# A shared build machine holds no key at all: it reaches the deploy key through
# an ssh-agent forwarded from the workstation that drives it, so nothing private
# rests on a machine other people are root on (remote/provision.sh, targets/remote.sh).
# Registration goes through the GitHub API, which takes the title, key and
# read_only=false directly.
#
# The rest are meant for another machine to call over the tailnet, or for `wk
# status`, rather than to type by hand:
#
#   wk key pub <fork>        print that fork's public key
#   wk key sshtest <fork>    does that fork's key authenticate, and as what
#   wk key fingerprints      every key here, its fingerprint and its state
#   wk key verdict <name>    one stored credential's verdict and detail, as
#                            `check` prints them, on one tab-separated line,
#                            with the fingerprint an election compares
#   wk key adopt <fork>      take a shared deploy key's private half on stdin
#   wk key adopt claude-login
#                            take a login made for this workstation: a tar of
#                            its two files on stdin, judged before it is kept
#   wk key give <fork>|<name>
#                            print that credential, for the workstation running
#                            `wk key setup` to take -- the other half of
#                            `adopt`. Never the claude.ai login: that one is
#                            made per machine and never copied
#
# <fork> is one of wk_push_forks' short names (lib/store.sh).
#
# Every credential is put to a rule before it is stored, and to the same rule
# again whenever one is reported (`wk key check`, `wk doctor`): the rules are
# lib/credcheck.py, one row each, and that row is also what a prompt here asks
# for and where it sends you to mint one. One that cannot do its job is refused
# and nothing is stored; one that reaches further than wk spends it is kept with
# that reach named; one no network could be reached to judge is kept and
# reported unverified.
#
# Runs on the machine that holds the keys: the secrets directory is this device's
# (wk_secrets_dir), and on macOS the podman machine reads it as a mount, so every
# subverb here is ssh-keygen, a file and `gh`, with no VM in the path.
#
# `setup`, `deploy` and `check` are the only ones that call the GitHub API, which
# is why the rest clear `needs`: that is what lets `wk key ensure` run over ssh
# on a build machine with no `gh` on it, and `wk key set tailnet` store a key on
# a machine whose gh login has expired.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/par.sh"

load_target "$(default_target)" 2>/dev/null || true

ACTION="${1:-check}"
ROTATE=""   # --rotate: the fleet takes this machine's fresh credential instead of electing one
case "${2:-}" in
    --rotate) ROTATE=1 ;;
esac

ensure_keys() { "$0" ensure 2>&1 | sed 's/^/  /'; }

PEERS=""; WORKSTATIONS=""
fleet_resolve() {   # asking whether a machine is a peer is an ssh round trip (peer_workstations, lib/target.sh), so a run asks once and every arm reads these
    PEERS=$(peer_workstations)
    WORKSTATIONS=$(printf 'local\n%s' "$PEERS")
}

m_label() {
    [ "$1" = local ] && { hostname -s; return 0; }
    printf '%s' "$1"
}

# Every question to a workstation goes through here, so an election asks all of them the same one. `|| true`: a machine with no credential answers non-zero, and under `set -o pipefail` that would end the command.
m_ask() { # <machine> <args...> -- its answer on stdout, never a failure
    if [ "$1" = local ]; then shift; "$0" "$@" 2>/dev/null || true; return 0; fi
    local m="$1"; shift
    { ( load_target "$m"; t_wk key "$@" ) 2>/dev/null || true; } | tr -d '\r'
    return 0
}

m_tell() { # <machine> <args...> -- non-zero when it did not take what arrived; the value is on stdin, never an argument in `ps` over there
    if [ "$1" = local ]; then shift; "$0" "$@" >/dev/null 2>&1; return; fi
    local m="$1"; shift
    ( load_target "$m"; t_wk key "$@" ) >/dev/null 2>&1
}
pub_of() { # <fork>
    cat "$(wk_secrets_dir)/build_key_$1.pub" 2>/dev/null
    return 0
}

priv_of() { # <fork>
    [ -f "$(wk_push_held_dir)/build_key_$1" ] \
        && printf '%s\n' "$(wk_push_held_dir)/build_key_$1"
    return 0
}

# The CLI rotates the refresh token in the file it writes, so a copy of this machine's own login is a second holder of one token and the first refresh on either side locks the other out: the shared directory logs in for itself. It is the config home for that login (CLAUDE_CONFIG_DIR), not only the credential store: the account record remote control reads (oauthAccount) goes into the config file, and pointed at the store alone the CLI wrote it into this machine's own ~/.claude.json (measured 2026-09-11).
_claude_login_run() { # <name> [dir] -- log in where the containers read it, or into a directory bound for another workstation
    local _dir="${2:-$(wk_agent_rw_dir)}"
    have claude || { warn "$(cred_line "$1" skipped \
        "the Claude CLI makes this login and is not on PATH -- install it, then: wk key set $1")"; return 1; }
    [ -t 0 ] || { warn "$(cred_line "$1" skipped \
        "this login opens a browser and needs a terminal -- re-run interactively: wk key set $1")"; return 1; }
    ensure_dir "$_dir" 0700
    # On a Mac the CLI puts a login in the login Keychain when `security` reaches one, and has no switch to the file every workspace reads; lib/no-keychain/security answers as a locked Keychain does (exit 36), so the CLI writes the file -- what it does in a guest reached over ssh.
    PATH="$WK_ROOT/lib/no-keychain:$PATH" CLAUDE_CONFIG_DIR="$_dir" CLAUDE_SECURESTORAGE_CONFIG_DIR="$_dir" claude auth login \
        || { warn "$(cred_line "$1" skipped "'claude auth login' did not finish")"; return 1; }
}

CRED_VERDICT=""

cred_admit() { # <name> <value>
    CRED_VERDICT=$(printf '%s' "$2" | wk_cred_check "$1")
    [ "$(wk_cred_verdict "$CRED_VERDICT")" != bad ] \
        || die "$(cred_line "$1" refused "$(wk_cred_detail "$CRED_VERDICT")")"
}

cred_look() { # <name>   what the stored one can do, asked now
    CRED_VERDICT=$(wk_cred_check "$1" --stored)
}

cred_stale() { # <name> -- stored, and its issuer refuses it now; `unverified` (no network to ask) is not stale
    wk_cred_present "$1" || return 1
    cred_look "$1"
    [ "$(wk_cred_verdict "$CRED_VERDICT")" = bad ]
}

cred_print() { # <name>  non-zero when it cannot do its job
    local v d
    v=$(wk_cred_verdict "$CRED_VERDICT"); d=$(wk_cred_detail "$CRED_VERDICT")
    case "$v" in
        ok)         log  "  $d" ;;
        wide)       warn "$1 reaches further than wk spends it: $d" ;;
        unverified) warn "$1 is unverified: $d" ;;
        bad)        warn "$1 cannot do its job: $d"; return 1 ;;
    esac
}

cred_known() { wk_cred_settable | grep -qxF "$1"; }

cred_line() { # <name> <stored|minted|taken|skipped|refused> <path or one-line reason>
    local var; var=$(wk_agent_secret_field "$1" 4)
    [ "$var" = - ] && var=""
    printf '%-13s %-8s %s%s' "$1" "$2" "$3" "${var:+  (\$$var in a workspace)}"
}

# One row of `wk key check`, in a column-aligned table: the verdict's summary line, and the fix when the detail carries one (lib/credcheck.py writes it as a `fix:` line for a credential that cannot do its job). The rest of the detail -- what it must be able to do, what it must not -- is what `wk key show <name>` prints.
cred_row() { # <verdict line>
    printf '%s\n' "$(wk_cred_detail "$1" | sed -n '1p; /^ *fix: /p')"
}

fork_verdict() { # <machine> <fork> <repo> -- judged now: what that key authenticates as there, and whether its public half is registered with write access
    local machine="$1" remote="$2" repo="$3" pub b64 ro line
    pub=$(m_ask "$machine" pub "$remote")
    [ -n "$pub" ] || { printf 'absent\tno key -- run: wk key deploy\n'; return 0; }

    # Matched on the base64 body, which is unique and jq-safe. `|| ro=""` keeps this a report: pipefail would end it on a refused API call.
    b64=$(printf '%s' "$pub" | awk '{print $2}')
    ro=$(gh api "repos/$repo/keys" </dev/null 2>/dev/null \
         --jq ".[] | select(.key | contains(\"$b64\")) | .read_only" | head -1) || ro=""
    line=$(wk_cred_check deploy-key --repos "$repo" \
               --evidence "ssh=$(m_ask "$machine" sshtest "$remote")" \
               --evidence "read_only=$ro" </dev/null)
    printf '%s\n    fingerprint: %s\n' "$line" "$(pub_fingerprint "$pub")"
}

cred_verdict_of() { # <machine> <name> -- a verdict line; a peer that cannot be asked says so rather than looking empty (peer_cred_verdict, lib/target.sh)
    [ "$1" != local ] || { "$0" verdict "$2"; return 0; }
    peer_cred_verdict "$1" "$2" || true
}

# One row of `wk key check`, whole, in its own par job: the rows are independent probes, so they are asked at once and the table replays them in its own order.
check_fork_row() { # <machine> <remote> <repo>
    local line
    printf '    %-28s ' "$3" >&3
    line=$(fork_verdict "$1" "$2" "$3")
    cred_row "$line" >&3
    [ "$(wk_cred_verdict "$line")" = ok ]
}

check_cred_row() { # <name>
    printf '    %-28s ' "$1" >&3
    cred_look "$1"
    cred_row "$CRED_VERDICT" >&3
    [ "$(wk_cred_verdict "$CRED_VERDICT")" != bad ]
}

check_peer_row() { # <peer> <name> -- one command is the remedy for every fault here, because one command puts all of it there
    local line v fp
    printf '    %-28s ' "$1 $2" >&3
    line=$(cred_verdict_of "$1" "$2")
    v=$(wk_cred_verdict "$line")
    if [ "$2" = claude-login ] && [ "$v" = absent ]; then
        printf "no login: from a terminal here, 'wk key setup' logs in for it\n" >&3
        return 1
    fi
    cred_row "$line" >&3
    case "$v" in
        absent) printf "    fix: 'wk key setup' here puts the fleet's %s there\n" "$2" >&3; return 1 ;;
        bad)    printf "    fix: from a terminal here, 'wk key setup' replaces it\n" >&3; return 1 ;;
    esac
    # Whether the fleet agrees, not whether each machine is separately fine. Never a fault: both can work, and the next election settles it.
    [ "$2" != claude-login ] || return 0   # each machine's own, so there is nothing to differ from
    fp=$(wk_cred_fact "$line" fingerprint)
    [ -n "$fp" ] && [ "$fp" != "$(wk_cred_fingerprint "$2")" ] \
        && printf "    it is not the one this machine holds; 'wk key setup' elects between them\n" >&3
    return 0
}

# Deliberately not delivered into a workspace like the wk_agent_secrets rows: only the credential injector, on the machine that runs the workspaces, ever reads the token.
cred_deliver() { # <name> -- carry a stored, rotated or withdrawn one to where it is read
    [ "$1" = github-pat ] || return 0
    push_agent_pat_deliver && return 0
    warn "an injector on this machine did not take the read token, so a read from
    the workspaces it serves answers 401 until it does. './setup' converges the
    one in the podman machine (the vmtools stage on macOS, sdk on Linux) and
    'wk vm start <guest>' the one that serves the guests."
}

# Every reader of a stored credential redacts it, so this print is the only chance to point a phone at one wk mints.
cred_minted_once() { # <name> <value>
    log  "  printed once: $(wk_cred_rule "$1" url)$2"
    log  "  $(wk_cred_rule "$1" remedy)"
}

cred_report() { # <name> -- non-zero when what is stored cannot do its job
    log "$(cred_line "$1" stored "$(wk_cred_path "$1")")"
    cred_look "$1"
    cred_print "$1"
}

SHARED_KEY_TITLE="wk shared deploy key"   # rotation finds the old key to remove by this one title

SHARED_VALUES="github-pat bugzilla-api-key"   # the credentials the fleet holds one of, elected and fanned out; the deploy keys are elected per fork and the claude.ai login is made per machine

# An election settles a disagreement between workstations, so with no peer, or with the question declined, every arm does this machine alone.
FLEET=""    # another workstation exists and may be written to

cred_shared() { case " $SHARED_VALUES " in *" $1 "*) return 0 ;; esac; return 1; }

peers_named() { echo $PEERS; }

pub_fingerprint() { # <public half> -- what says two workstations hold one key
    printf '%s\n' "$1" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}'
}

ELECT_ROWS=""; ELECT_WINNER=""; ELECT_HELD=""
elect_clear() { ELECT_ROWS=""; ELECT_WINNER=""; ELECT_HELD=""; }

# Every workstation is asked at once, and the best working answer wins: `ok` over
# `wide`, and one that cannot do its job never travels. Age is not evidence -- a
# token minted this morning that reaches nothing loses to the one that works --
# and a tie goes to this machine, so a fleet that already agrees moves nothing.
elect() { # <verdict-fn> <args...> -- fills ELECT_WINNER, ELECT_HELD and ELECT_ROWS
    local m line v rank best=0
    elect_clear
    par_begin
    for m in $WORKSTATIONS; do par_run "elect-$m" elect_ask "$m" "$@"; done
    par_wait
    for m in $WORKSTATIONS; do
        line=$(par_record "elect-$m")
        v=$(wk_cred_verdict "$line")
        [ "$v" != unverified ] || ELECT_HELD=1
        ELECT_ROWS="$ELECT_ROWS$m $v $(wk_cred_fact "$line" fingerprint)
"
        rank=0
        case "$v" in ok) rank=3 ;; wide) rank=2 ;; esac
        [ "$rank" -le "$best" ] || { best="$rank"; ELECT_WINNER="$m"; }
    done
    par_end
}

elect_ask() { # <machine> <verdict-fn> <args...> -- one candidate, on its own fd
    local m="$1" fn="$2"; shift 2
    "$fn" "$m" "$@" >&3
}

elect_fingerprint() { # <machine> -- what the election found that one holding
    printf '%s\n' "$ELECT_ROWS" | awk -v m="$1" '$1 == m { print $3; exit }'
}

fleet_fork() { # <fork> <repo> -- the elected key taken from whoever holds it, registered once, and on every workstation; non-zero when it could not be settled
    local remote="$1" repo="$2" failed=0
    elect_clear
    if [ -n "$FLEET" ] && [ -z "$ROTATE" ]; then
        elect fork_verdict "$remote" "$repo"
        if [ -n "$ELECT_WINNER" ] && [ "$ELECT_WINNER" != local ]; then
            info "$repo: $ELECT_WINNER holds the deploy key GitHub accepts -- taking it"
            m_ask "$ELECT_WINNER" give "$remote" | m_tell local adopt "$remote" \
                || { warn "$repo: $ELECT_WINNER's deploy key did not arrive, so nothing was changed (an older wk-tools there has no 'give': wk sync --tools $ELECT_WINNER)"; return 1; }
            log "  an ssh-agent already holding the old key keeps offering it:  wk push off && wk push on"
        fi
    fi
    # Not a move: it adds this key to the one repository it is scoped to, whatever the others hold, and does nothing when it is already there.
    register_fork "$remote" "$repo" || failed=1
    [ -n "$FLEET" ] || return "$failed"
    if [ -z "$ELECT_WINNER" ] && [ -n "$ELECT_HELD" ]; then
        warn "$repo: no workstation's deploy key could be judged, so none was written over another's"
        return 1
    fi
    fan_out_fork "$remote" "$repo" || failed=1
    return "$failed"
}

fan_out_fork() { # <fork> <repo> -- onto every peer holding a different key
    local repo="$2" m mine failed=0
    mine=$(pub_fingerprint "$(pub_of "$1")")
    [ -n "$mine" ] || return 1
    for m in $PEERS; do
        if [ "$(elect_fingerprint "$m")" = "$mine" ]; then
            unchanged "$m: already holds the $repo deploy key"
        elif wk_push_key "$1" | m_tell "$m" adopt "$1"; then
            changed "$m: took the $repo deploy key"
        else
            warn "$m: could not take the $repo deploy key"
            failed=1
        fi
    done
    return "$failed"
}

fleet_cred() { # <name> -- the elected value taken from whoever holds it, asked for here when nobody holds one, and on every workstation
    local name="$1" failed=0
    elect_clear
    if [ -n "$ROTATE" ]; then
        rotate_here "$name" || return 1
    else
        elect cred_verdict_of "$name"
        if [ -n "$ELECT_WINNER" ] && [ "$ELECT_WINNER" != local ]; then
            info "$name: $ELECT_WINNER holds one its issuer accepts -- taking it"
            m_ask "$ELECT_WINNER" give "$name" | "$0" set "$name" --paste >/dev/null \
                || { warn "$name: what $ELECT_WINNER sent was not stored, so nothing here was changed (an older wk-tools there has no 'give': wk sync --tools $ELECT_WINNER)"; return 1; }
            log "$(cred_line "$name" taken "$(wk_cred_path "$name")")"
        elif [ -z "$ELECT_WINNER" ]; then
            if [ -n "$ELECT_HELD" ]; then
                # Being offline is a state, not a verdict: nothing is known to be broken, so nothing is replaced and nothing is written over another machine's.
                ! wk_cred_present "$name" \
                    || log "$(cred_line "$name" stored "$(wk_cred_path "$name")")"
                warn "$name: no workstation's could be judged, so none was written over another's"
                return 1
            fi
            warn "$name: no workstation holds one its issuer accepts"
            cred_refresh "$name" || return 1
        else
            log "$(cred_line "$name" stored "$(wk_cred_path "$name")")"
        fi
    fi
    fan_out_cred "$name" || failed=1
    return "$failed"
}

fan_out_cred() { # <name> -- onto every peer holding a different one
    local m mine failed=0
    mine=$(wk_cred_fingerprint "$1")
    [ -n "$mine" ] || { warn "$1: nothing is stored here, so the other workstations were left as they are"; return 1; }
    for m in $PEERS; do
        if [ "$(elect_fingerprint "$m")" = "$mine" ]; then
            unchanged "$m: already holds the $1 the fleet uses"
        elif wk_cred_read "$1" | m_tell "$m" set "$1" --paste; then
            changed "$m: took the $1"
        else
            warn "$m: could not take the $1"
            failed=1
        fi
    done
    return "$failed"
}

cred_setup() { # <name> -- the fleet holds one of the shared two; the rest are this machine's own
    if [ -n "$FLEET" ] && cred_shared "$1"; then fleet_cred "$1"; return; fi
    local_cred "$1"
}

# The one question, asked before any credential is overwritten on another
# workstation or any key removed from GitHub. Registering a key and storing one
# here take nothing away, so a lone machine that is not rotating is asked nothing.
fleet_confirm() { # <question> -- non-zero only when it was asked and declined
    [ -n "$ROTATE" ] || [ -n "$FLEET" ] || return 0
    confirm "$1"
}

local_cred() { # <name> -- one this machine holds for itself
    [ -z "$ROTATE" ] || { rotate_here "$1"; return; }
    if ! wk_cred_present "$1"; then "$0" set "$1"; return; fi
    if cred_stale "$1"; then
        warn "$1 is stored here but refused: $(wk_cred_detail "$CRED_VERDICT" | sed -n 1p)"
        cred_refresh "$1"
        return
    fi
    log "$(cred_line "$1" stored "$(wk_cred_path "$1")")"
}

cred_refresh() { # <name> -- a fresh one here, nowhere in the fleet holding one that works; typed at a prompt, so no terminal means it is named and left
    wk_cred_present "$1" || { "$0" set "$1"; return; }
    [ -t 0 ] || { warn "a replacement is typed at a prompt, and there is no terminal here:  wk key set $1 --replace"; return 1; }
    "$0" set "$1" --replace
}

rotate_here() { # <name> -- this machine's fresh one, which the fleet then takes
    if wk_cred_present "$1"; then "$0" set "$1" --replace; else "$0" set "$1"; fi
}

# The claude.ai login is one holder's, so a peer without a usable one is logged in for here, in a directory of its own, and that login is sent to it and kept nowhere else.
share_login() { # <machine>
    local machine="$1" line dir
    line=$(cred_verdict_of "$machine" claude-login)
    case "$(wk_cred_verdict "$line")" in
        ok|wide|unverified) unchanged "$machine: holds a claude.ai login of its own"; return 0 ;;
    esac
    have claude || { warn "$machine: has no usable claude.ai login, and the Claude CLI that makes one is not on PATH here"; return 1; }
    [ -t 0 ] || { warn "$machine: has no usable claude.ai login; making one is a browser flow, so from a terminal:  wk key setup"; return 1; }
    dir=$(mktemp -d "${TMPDIR:-/tmp}/wk-login.XXXXXX") || return 1
    SHARE_LOGIN_DIR="$dir"; wk_atexit _share_login_cleanup
    info "$machine: logging in for it -- the browser opens once; what it leaves goes to $machine and stays nowhere else"
    _claude_login_run claude-login "$dir" || { rm -rf "$dir"; return 1; }
    line=$(wk_login_made_in "$dir")
    if [ "$(wk_cred_verdict "$line")" = bad ]; then
        warn "$machine: the login made here is not one a workspace can use, so it was not sent: $(wk_cred_detail "$line" | sed -n 1p)"
        rm -rf "$dir"; return 1
    fi
    if line=$(wk_login_pack "$dir" \
                | ( load_target "$machine"; t_wk key adopt claude-login ) 2>/dev/null | tr -d '\r' | sed -n 1p) \
       && [ "$(wk_cred_verdict "$line")" != bad ] && [ -n "$line" ]; then
        rm -rf "$dir"
        changed "$machine: logged in for it -- $(wk_cred_detail "$line")"
    else
        rm -rf "$dir"
        warn "$machine: did not take the login, so it is discarded here (an older wk-tools there has no 'adopt claude-login': wk sync --tools $machine)"
        return 1
    fi
}
_share_login_cleanup() { [ -z "${SHARE_LOGIN_DIR:-}" ] || rm -rf "$SHARE_LOGIN_DIR"; }

fleet_logins() { # each workstation's own login, made here for any without one
    local m failed=0
    for m in $PEERS; do share_login "$m" || failed=1; done
    return "$failed"
}

registered_key_body() { # <repo> -- the registered keys, matched on the jq-safe base64 body
    gh api "repos/$1/keys" --jq '.[].key' </dev/null 2>/dev/null \
        | awk '{print $1" "$2}'
}

# Remove every key registered under the shared title, so a rotation leaves no stale key with write access behind.
revoke_shared_keys() { # <repo>
    local id
    for id in $(gh api "repos/$1/keys" </dev/null 2>/dev/null \
                --jq ".[] | select(.title == \"$SHARED_KEY_TITLE\") | .id"); do
        gh api -X DELETE "repos/$1/keys/$id" </dev/null >/dev/null 2>&1 \
            && changed "$1: removed the old shared deploy key ($id)" \
            || warn "$1: could not remove the old shared deploy key ($id)"
    done
}

register_fork() { # <fork> <repo> -- the elected key on GitHub, once, with write access
    local pub body
    pub=$(pub_of "$1")
    [ -n "$pub" ] || { warn "no key for $2 here -- 'wk key ensure' makes it"; return 1; }
    body=$(printf '%s' "$pub" | awk '{print $1" "$2}')
    if registered_key_body "$2" | grep -qxF "$body"; then
        unchanged "$2: the shared deploy key is already registered"
        return 0
    fi
    info "registering the shared deploy key on $2"
    # read_only=false: a key registered read-only looks fine until the first push fails.
    if gh api "repos/$2/keys" \
         -f "title=$SHARED_KEY_TITLE" -f "key=$pub" \
         -F read_only=false </dev/null >/dev/null 2>&1; then
        changed "$2: the shared deploy key is registered with write access"
        return 0
    fi
    warn "$2: could not register the shared key automatically"
    log  "  add it at https://github.com/$2/settings/keys/new, ticking 'Allow write access':"
    printf '%s\n' "$pub"
    return 1
}

rotate_keys() {   # the old keys off GitHub first (one left there keeps write access), then a fresh one is minted and fanned out
    local remote repo alias
    while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        revoke_shared_keys "$repo"
        rm -f "$(wk_push_held_dir)/build_key_$remote" "$(wk_secrets_dir)/build_key_$remote.pub"
    done <<EOF
$(wk_push_forks)
EOF
}

converge_forks() { # one elected deploy key per fork, registered, on every workstation
    local remote repo alias failed=0
    [ -z "$ROTATE" ] || { info "rotating: removing the old shared keys from GitHub"; rotate_keys; }
    ensure_keys
    while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        fleet_fork "$remote" "$repo" || failed=1
    done <<EOF
$(wk_push_forks)
EOF
    return "$failed"
}

if [ "$ACTION" = ensure ]; then
    ensure_dir "$(wk_secrets_dir)" 0700
    ensure_dir "$(wk_push_held_dir)" 0700
    wk_push_forks | while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        key="$(wk_push_held_dir)/build_key_$remote"
        if [ -f "$key" ]; then
            unchanged "key for $repo"
        else
            # No passphrase: used unattended by agents, and one stored beside the key protects nothing. Per-repo scoping is the control.
            ssh-keygen -t ed25519 -N '' -C "wk deploy key for $repo" -f "$key" >/dev/null
            chmod 0600 "$key"
            changed "generated key for $repo"
        fi
        wk_push_pub_publish "$remote" || die "$key is not a usable private key, so no public half was published for $repo"
    done
    exit 0
fi

case "$ACTION" in
setup)
    wk_atexit par_cleanup
    fleet_resolve
    _peers=$(peers_named)
    FLEET=""; [ -z "$_peers" ] || FLEET=1
    if [ -n "$ROTATE" ]; then
        fleet_confirm "turn every credential over -- the shared deploy keys removed from GitHub and minted afresh, every credential stored here replaced${_peers:+, and what $_peers hold(s) overwritten with the fresh ones}?" \
            || die "not done -- nothing was changed"
    else
        fleet_confirm "put one working deploy key, GitHub API token and Bugzilla API key on this machine and on $_peers, overwriting what differs, and log in here for any of them without a claude.ai login?" \
            || FLEET=""
        [ -z "$_peers" ] || [ -n "$FLEET" ] \
            || warn "$_peers was left exactly as it is -- this machine's own credentials are still set up"
    fi
    converge_forks || true
    # A credential declined, or one that cannot be asked for without a terminal,
    # is not a reason to leave the rest of them unset.
    for _name in $(wk_cred_settable); do cred_setup "$_name" || true; done
    [ -z "$FLEET" ] || fleet_logins || true
    "$0" check
    ;;

set)
    _name="${2:-}"; _replace=""; _paste=""; _mints=""; _minted=""; _val=""
    _state=stored
    [ -n "$_name" ] || die "usage: wk key set <name> [--replace] [--paste]
    names: $(wk_cred_settable | tr '\n' ' ')"
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --replace) _replace=1 ;;
            --paste)   _paste=1 ;;
        esac
        shift
    done
    [ "$_name" != deploy-key ] \
        || die "a deploy key is generated here and never pasted:  wk key deploy"
    cred_known "$_name" \
        || die "there is no credential called '$_name'.
    This checkout knows: $(wk_cred_settable | tr '\n' ' ')
    Each is a row of lib/credcheck.py, which is also what says where to mint
    one and what it must be able to do."

    if wk_cred_mints "$_name"; then _mints=1; fi
    # --paste takes any credential's value on stdin, so a second workstation holds the same one as the first (this is how an election puts the winner everywhere). The one it cannot carry is the claude.ai login: that is a browser flow, not a value.
    [ -z "$_paste" ] || [ "$_name" != claude-login ] \
        || die "--paste cannot carry a claude.ai login -- it is made in a browser:
    wk key set claude-login here, or 'wk key setup' from a workstation with one"

    if [ -n "$_replace" ]; then
        wk_cred_present "$_name" \
            || die "there is no $_name credential here to replace ($(wk_cred_path "$_name")).
    'wk key set $_name' stores one."
        # Cleared before the new one is made, so an abandoned replace leaves nothing behind.
        wk_cred_clear "$_name"
        cred_deliver "$_name"
        info "removed the old $_name credential -- revoke it too if it is still live"
    fi

    # A pasted value always overwrites: it is an explicit "hold this one", the fan-out's way of rotating a workstation onto the fleet's current credential. Otherwise a bare `set` of one already here just reports it.
    if wk_cred_present "$_name" && [ -z "$_paste" ]; then
        cred_report "$_name" || exit 1
        exit 0
    fi

    if [ "$_name" = claude-login ]; then
        _claude_login_run "$_name" || exit 1
        wk_cred_present "$_name" \
            || die "$(cred_line "$_name" skipped \
                "'claude auth login' left nothing at $(wk_cred_path "$_name")")"
        cred_report "$_name" || exit 1
        exit 0
    fi

    # A minted row is made here; one on stdin is a minted credential a first machine already holds. Both are put to the rule first.
    if [ -n "$_paste" ]; then
        _val=$(cat)
        [ -n "$_val" ] || die "nothing arrived on stdin, so nothing is stored.
    To mint one here instead:  wk key set $_name"
    elif [ -n "$_mints" ]; then
        _val=$(wk_cred_mint "$_name"); _minted=1
    else
        _val=$(prompt_secret_value "$(wk_cred_rule "$_name" what)" \
                   "$(wk_cred_rule "$_name" url)" \
                   "$(wk_cred_rule "$_name" remedy)") || _val=""
        [ -n "$_val" ] || die "$(cred_line "$_name" skipped \
            "nothing stored, so nothing here can $(wk_cred_rule "$_name" needs)")"
    fi

    # Before anything is written, so a credential the far side refuses is refused here rather than hours later by whatever spends it.
    cred_admit "$_name" "$_val"
    # Down a pipe: an argument would be in `ps` for everyone on the machine.
    printf '%s\n' "$_val" | wk_cred_store "$_name" \
        || die "could not write $(wk_cred_path "$_name")"
    cred_deliver "$_name"
    [ -z "$_minted" ] || _state=minted
    log "$(cred_line "$_name" "$_state" "$(wk_cred_path "$_name")")"
    [ -z "$_minted" ] || cred_minted_once "$_name" "$_val"
    unset _val
    cred_print "$_name" || true
    ;;

pub)
    remote="${2:-}"
    [ -n "$remote" ] || die "wk key $ACTION needs a fork: $(wk_push_forks | awk 'NF{printf "%s ",$1}')"
    out=$(pub_of "$remote")
    [ -n "$out" ] || exit 1
    printf '%s\n' "$out"
    ;;

sshtest)
    remote="${2:-}"
    [ -n "$remote" ] || die "wk key $ACTION needs a fork: $(wk_push_forks | awk 'NF{printf "%s ",$1}')"
    priv=$(priv_of "$remote")
    [ -n "$priv" ] || { echo "no key"; exit 1; }
    ssh -o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes \
        -o BatchMode=yes -i "$priv" \
        -T git@github.com 2>&1 </dev/null || true
    ;;

fingerprints)
    wk_push_forks | while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        pub=$(pub_of "$remote")
        [ -n "$pub" ] || { printf '%-9s %-50s %s\n' "$remote" "-" "no key"; continue; }
        fp=$(pub_fingerprint "$pub")
        # A private half is always in the one directory nothing mounts, so where it is says nothing about the switch (`wk push status` does).
        priv=$(priv_of "$remote")
        [ -n "$priv" ] && state="private half here ('wk push status')" \
                       || state="no private half"
        printf '%-9s %-50s %s\n' "$remote" "${fp:-unreadable}" "$state"
    done
    ;;

show)
    wk_push_forks | while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        printf '# %s\n%s\n' "$repo" "$(pub_of "$remote")"
    done
    ;;

adopt)
    remote="${2:-}"
    [ -n "$remote" ] || die "usage: wk key adopt <fork>|claude-login   (the private key, or a tar of the login's two files, on stdin)"
    if [ "$remote" = claude-login ]; then
        line=$(wk_login_adopt) \
            || die "what arrived on stdin is not a claude.ai login a workspace here can use: $(wk_cred_detail "$line" | sed -n 1p)"
        printf '%s\n' "$line"
        log "adopted a claude.ai login made for this workstation"
        exit 0
    fi
    wk_push_forks | awk 'NF {print $1}' | grep -qxF "$remote" \
        || die "no fork called '$remote'; this checkout knows: $(wk_push_forks | awk 'NF{printf "%s ",$1}')"
    wk_push_key_adopt "$remote" \
        || die "what arrived on stdin is not a usable private key for $remote"
    log "adopted the shared deploy key for $remote"
    ;;

deploy)
    wk_atexit par_cleanup
    fleet_resolve
    _peers=$(peers_named)
    FLEET=""; [ -z "$_peers" ] || FLEET=1
    if [ -n "$ROTATE" ]; then
        fleet_confirm "remove the shared deploy keys from GitHub, mint fresh ones and register them${_peers:+, and put them on $_peers}?" \
            || die "not done -- nothing was changed"
    else
        fleet_confirm "register the shared deploy keys on GitHub and put the elected one on $_peers?" \
            || die "not done -- nothing was changed"
    fi
    converge_forks || true
    echo >&2
    "$0" check
    ;;

check)
    rc=0
    fleet_resolve
    _machines="$WORKSTATIONS"
    _forks=$(wk_push_forks)
    _creds=$(wk_cred_settable)
    _boxes=$(build_boxes)

    wk_atexit par_cleanup
    par_begin
    for machine in $_machines; do
      while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        par_run "fork-$machine-$remote" check_fork_row "$machine" "$remote" "$repo"
      done <<EOF
$_forks
EOF
    done
    for _cname in $_creds; do par_run "cred-$_cname" check_cred_row "$_cname"; done
    _peers="$PEERS"
    _shared="$SHARED_VALUES claude-login"
    for machine in $_peers; do
        for _cname in $_shared; do
            par_run "peer-$machine-$_cname" check_peer_row "$machine" "$_cname"
        done
    done
    par_wait

    for machine in $_machines; do
      label=$(m_label "$machine")
      section_printed=""
      while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        [ -n "$section_printed" ] || { printf '  %s\n' "$label:"; section_printed=1; }
        par_record "fork-$machine-$remote"
        [ "$(par_rc "fork-$machine-$remote")" = 0 ] || rc=1
      done <<EOF
$_forks
EOF
    done

    if [ -n "$_boxes" ]; then
        printf '  build machines (nothing at rest -- reached by a forwarded agent):\n'
        for machine in $_boxes; do
            printf '    %-28s %s\n' "$machine" "holds no credential; 'wk push' forwards the elected key"
        done
    fi

    printf '  credentials:\n'
    for _cname in $_creds; do
        par_record "cred-$_cname"
        [ "$(par_rc "cred-$_cname")" = 0 ] || rc=1
    done
    if [ -n "$_peers" ]; then
        printf '  the other workstations (the fleet holds one of each, and each its own login):\n'
        for machine in $_peers; do
            for _cname in $_shared; do
                par_record "peer-$machine-$_cname"
                [ "$(par_rc "peer-$machine-$_cname")" = 0 ] || rc=1
            done
        done
    fi
    par_end
    exit $rc
    ;;

give)
    _what="${2:-}"
    [ -n "$_what" ] \
        || die "usage: wk key give <fork>|<name>   (it prints on stdout, for the workstation electing one to take)"
    [ "$_what" != claude-login ] \
        || die "a claude.ai login is never handed over: a copy is a second holder of one
    refresh token, and the first refresh on either side locks the other out.
    'wk key setup' on a workstation that has one logs in for this machine instead."
    if wk_push_forks | awk 'NF {print $1}' | grep -qxF "$_what"; then
        wk_push_key "$_what"
    elif cred_known "$_what"; then
        wk_cred_read "$_what"
    else
        die "there is no fork or credential called '$_what'.
    This checkout knows: $(wk_push_forks | awk 'NF{printf "%s ",$1}')$(wk_cred_settable | tr '\n' ' ')"
    fi
    ;;

verdict)
    _name="${2:-}"
    cred_known "$_name" || die "usage: wk key verdict <name>
    names: $(wk_cred_settable | tr '\n' ' ')"
    # It travels with the verdict because that is what an election on another workstation compares.
    wk_cred_check "$_name" --stored
    _fp=$(wk_cred_fingerprint "$_name")
    [ -z "$_fp" ] || printf '    fingerprint: %s\n' "$_fp"
    ;;

register|claude|tailnet|tailnet-api|share)
    case "$ACTION" in
        register) _now="wk key deploy" ;;
        share)    _now="wk key setup   (it elects the credential the fleet holds rather than pushing this machine's)" ;;
        claude)   _now="wk key set claude   (the account login beside it is 'wk key set claude-login')" ;;
        *)        _now="wk key set $ACTION" ;;
    esac
    die "'wk key $ACTION' is now:  $_now
    'wk key setup' does every credential this machine has not got yet."
    ;;

*)
    die "'$ACTION' is not a verb of wk key; see wk key -h"
    ;;
esac
