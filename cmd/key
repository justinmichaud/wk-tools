#!/usr/bin/env python3
#
# wk key check|setup|set|deploy|show|ensure|sudo|backup -- the credentials this machine holds, its sudo policy and its settings backup
# wk: where=host name=none group=sources needs gh,gh-auth takes=1 default=check verbs=check,setup,deploy,show,ensure,pub,sshtest,fingerprints,set,adopt,verdict,give,sudo,backup destructive setup,deploy,--replace dryrun setup,deploy,set,sudo,ensure,adopt,backup readonly check,show,pub,sshtest,fingerprints,verdict,give
# wk: sub show,ensure,pub,sshtest,fingerprints,set,adopt,verdict,give,sudo,backup needs=
# wk: sub set,pub,sshtest,adopt,verdict,give takes=2
# wk: sub set opts=--replace,--paste
# wk: sub deploy,setup opts=--rotate
# wk: sub sudo takes=2 opts=--on=,--all destructive=
# wk: sub backup opts=--candidates
#
#   wk key setup [--rotate]   every credential this machine needs, and one working credential of each kind on
#                     every workstation: the one its issuer accepts wins (a tie goes to this machine) and is put on
#                     every workstation holding another; when none works, this machine mints or asks for one. A build
#                     machine is sent nothing. Asks once, first; can be killed and re-run
#                       --rotate  turn every credential over instead: `deploy --rotate`, then `set <name> --replace`
#   wk key set <name> [--replace] [--paste]
#                     store one credential by name, or report on the one already here
#                       --replace  rotate it: the old one is removed first
#                       --paste    take the value on stdin instead of minting or asking for one
#                     <name> is a row of lib/credcheck.py:
#                       github-pat        a classic 'public_repo' token `git-webkit pr` opens a pull request with
#                       bugzilla-api-key  what `git-webkit pr` files the bug with
#                       claude            the Claude Code token (`claude setup-token`) a build box starts with
#                       litellm           the API key `wk ai pi` reaches your LiteLLM endpoint with
#                       tailnet           the fleet's tailnet auth key, seeded onto every card written here
#                       tailnet-api       the tailnet API token that retires a stale fleet node
#                       ntfy              the ntfy.sh topic notifications go to; minted here
#   wk key deploy [--rotate]  the deploy keys alone, as `setup` does them, registered on GitHub with write
#                     access. Asks once, first
#                       --rotate  remove the old keys from GitHub and mint fresh ones
#   wk key check      what every credential here and on each other workstation can do, asked now, and what needs
#                     doing under `needs you:`. Read-only; what a bare `wk key` runs
#   wk key show       the public halves, and the ntfy topic URL for a phone
#   wk key ensure     create missing push keys without registering them
#   wk key sudo [status|setup] [--on <machine>|--all]
#                     root costs a password with a 30-second window (WK_SUDO_TIMEOUT_MIN), through
#                     /etc/sudoers.d/zz-<user>-passwd. `status` (the default) reports; `setup` installs it,
#                     checked by `visudo -c` before and after. Exits 0 when that policy holds, 1 otherwise
#                       --on <machine>  the same, on a configured machine
#                       --all           every configured machine, and this one
#   wk key backup [--candidates]
#                     write this host's desktop settings back into the repo, never a credential:
#                     host/macos/defaults.conf and symbolichotkeys.plist, or host/linux/config.dconf
#                       --candidates  macOS, read-only: every `defaults` value off Apple's default and not yet kept
#
# For another workstation or `wk status` to call:
#   wk key pub <key>         that deploy key's public half
#   wk key sshtest <key>     does that deploy key authenticate, and as what
#   wk key fingerprints      every key here, its fingerprint and its state
#   wk key verdict <name>    one stored credential's verdict and fingerprint
#   wk key adopt <key>       take a shared deploy key's private half on stdin
#   wk key give <key>|<name> print that credential, the other half of `adopt`
#
# <key> is a deploy key of a repo in lib/wk/project.json's REPOS. Every credential is put to its lib/credcheck.py
# rule when stored and when reported: one that cannot do its job is refused, one that reaches further is kept with
# that reach named, one no network could judge is kept as unverified.

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images  # noqa: E402

ROOT = images.root()

from wk import backup, decl, sudo  # noqa: E402
from wk.key import cli  # noqa: E402
from wk.act import Refused  # noqa: E402
from wk.machine import Local, is_macos  # noqa: E402
from wk.places import Registry  # noqa: E402


def main(argv, env=None, reg=None, machine=None, macos=None):
    args = decl.Args(decl.Decl(__file__), argv)
    words = args.positionals
    verb = words[0]
    if verb == "sudo":
        return sudo.main(words[1:], args.value("--on"), args.flag("--all"),
                         reg or Registry(ROOT, os.environ if env is None else env, Local()), env=env)
    if verb == "backup":
        return backup.main(ROOT, args.flag("--candidates"), machine or Local(), is_macos() if macos is None else macos)
    return cli.main(ROOT, verb, words[1] if len(words) > 1 else "", rotate=args.flag("--rotate"),
                    replace=args.flag("--replace"), paste=args.flag("--paste"))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
