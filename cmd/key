#!/usr/bin/env bash
#
# wk key register|check|show|ensure|claude|tailnet|tailnet-api -- the credentials a workspace needs
# wk: where=host name=none group=sources needs gh,gh-auth
# wk: sub show,ensure,pub,sshtest,fingerprints,claude,tailnet,tailnet-api needs=
#
# One key per fork, shared by every workspace. GitHub deploy keys are
# scoped to a single repository and refuses the same key on a second one,
# so multiple push targets means multiple keys -- worth keeping rather than
# working around: a compromised workspace can push to the forks in
# wk_push_forks and nowhere else.
#
# Registration goes through the GitHub API, not a browser: the deploy-key
# page accepts no query-string prefill, and the API takes the title, key
# and read_only=false directly -- no chance of leaving the write checkbox
# unticked, the easy mistake that only shows up much later at push time.
#
#   wk key register   create the keys and register them (idempotent)
#   wk key check      verify each key authenticates with write access
#   wk key show       print the public keys
#   wk key ensure     create missing keys without registering them
#   wk key claude [--replace]
#                     the Claude Code token every workspace this machine makes
#                     starts authenticated with. `claude setup-token` prints
#                     one; this stores it, and each target driver hands it to
#                     the workspaces it brings up
#   wk key tailnet-api [--replace]
#                               the tailnet API access token this machine
#                               administers with: retiring a fleet node whose
#                               name a new card needs. Never written to a card.
#   wk key tailnet [--replace]   the fleet's tailnet auth key: report it, ask
#                     for it, or (--replace) rotate it
#
# Three more, addressed to one fork rather than every one of them, meant for
# another machine or `wk status` to call rather than to type by hand:
#
#   wk key pub <fork>        print that fork's public key
#   wk key sshtest <fork>    does that fork's key authenticate, and as what
#   wk key fingerprints      every key here, its fingerprint and its state
#
# <fork> is one of wk_push_forks' short names (lib/store.sh) -- 'wk key show'
# prints each fork's full repository alongside its key.
#
# The tailnet key is the odd one here and belongs anyway: not a deploy key,
# never reaching GitHub, but a credential this repository must never
# contain, kept per machine -- asked for here rather than as a prompt from
# whatever needs it, since for a card write that need appears only after
# the card has already been erased.
#
# Runs on the host: `gh` and its credentials are here, while the private keys
# stay in the VM and are never copied out.
#
# `register` and `check` are the two that call the GitHub API, so they are the
# only two that need `gh` and a token that works; the rest is ssh-keygen, a
# file and an ssh connection, and clearing `needs` for them is what lets
# `wk key ensure` run over ssh on a build machine with no `gh` on it at all,
# and `wk key tailnet` store a key on a machine whose gh login has expired.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# The store this machine keeps its own keys in: /var/lib/wk inside the podman
# VM, the remote root on a build machine. The driver is what knows, so ask it
# rather than letting the default answer for a machine it is wrong about.
load_target "$(default_target)" 2>/dev/null || true

WK_MACHINE="${WK_MACHINE:-wk}"
ACTION="${1:-register}"

# The keys live in the VM. Read the *public* halves out; the private halves are
# never copied to the host.
#
# Decided once, because two things depend on it: whether in_vm crosses into the
# podman machine at all, and where the tooling sits on the far side -- the VM's
# read-only mount at /opt/wk-tools, or this checkout when the far side is just a
# local shell on a Linux workstation.
if is_macos && [ -z "${WK_IN_VM:-}" ]; then
    IN_VM_SSH=1
    IN_VM_ROOT=/opt/wk-tools
    IN_VM_ENV="WK_IN_VM=1 "
else
    IN_VM_SSH=
    IN_VM_ROOT="$WK_ROOT"
    IN_VM_ENV=
fi

in_vm() {
    # </dev/null is essential, not defensive: both podman-machine-ssh and
    # bash -c read stdin, and every caller here sits inside a `while read`
    # loop fed by a heredoc -- without it the first iteration swallows the
    # remaining forks.
    if [ -n "$IN_VM_SSH" ]; then
        podman machine ssh "$WK_MACHINE" "$@" </dev/null
    else
        bash -c "$*" </dev/null
    fi
}

ensure_keys() { in_vm "$IN_VM_ENV$(sh_quote "$IN_VM_ROOT/cmd/key") ensure" 2>&1 | sed 's/^/  /'; }

# --- one key per machine, not one key everywhere ------------------------------
# GitHub is happy with several keys on one repository, so every machine
# that pushes gets its own key, registered under its own name, revocable on
# its own. Copying one key between machines would put a private key on the
# wire. The machines: this workstation's store (the podman VM on macOS,
# local on Linux) and every configured build machine with wk-tools.
key_machines() {
    echo local
    for_each_machine _key_has_wk
    return 0
}

_key_has_wk() {
    ( load_target "$1"; t_has_wk ) 2>/dev/null && echo "$1"
    return 0
}

# The label a key is registered under, so a key list on GitHub says which
# machine each one lets in.
m_label() {
    [ "$1" = local ] && { hostname -s; return 0; }
    printf '%s' "$1"
}

m_ensure() {
    if [ "$1" = local ]; then ensure_keys; return 0; fi
    ( load_target "$1"; t_wk key ensure ) 2>&1 | sed 's/^/  /'
}

# `|| true` on both: a machine with no key yet answers non-zero, and under
# `set -o pipefail` that becomes the caller's assignment status and ends the
# command. An absent key is an answer here, not a failure.
m_pub() {
    if [ "$1" = local ]; then pub_of "$2"; return 0; fi
    { ( load_target "$1"; t_wk key pub "$2" ) 2>/dev/null || true; } | tr -d '\r'
}

m_sshtest() {
    if [ "$1" = local ]; then "$0" sshtest "$2" 2>/dev/null || true; return 0; fi
    { ( load_target "$1"; t_wk key sshtest "$2" ) 2>/dev/null || true; } | tr -d '\r'
    return 0
}
# `wk push off` moves only the *private* half out of the mounted directory,
# so this normally finds the public half where it always was; the second
# path is for a key generated while push was off.
pub_of()      { in_vm "cat $WK_STORE/secrets/build_key_$1.pub 2>/dev/null \
                       || cat $WK_STORE/push-keys/build_key_$1.pub 2>/dev/null" | tr -d '\r'; }

# Where the private half is right now, or empty when there is none. `wk key
# check` needs it to authenticate, and needs to say *why* when it cannot.
priv_of()     { in_vm "for d in secrets push-keys; do \
                          p=$WK_STORE/\$d/build_key_$1; \
                          [ -f \"\$p\" ] && { echo \"\$p\"; break; }; \
                       done" | tr -d '\r'; }

# --- ensure runs inside the VM, where the secrets are ------------------------
if [ "$ACTION" = ensure ] && { ! is_macos || [ -n "${WK_IN_VM:-}" ]; }; then
    [ -z "${2:-}" ] || die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    ensure_dir "$WK_STORE/secrets" 0700
    wk_push_forks | while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        key="$WK_STORE/secrets/build_key_$remote"
        # A key held back by `wk push off` is still this machine's key, in
        # $WK_STORE/push-keys. Generating a second one here would register a
        # new deploy key and leave the switch pointing at a dead one.
        if [ -f "$WK_STORE/push-keys/build_key_$remote" ]; then
            unchanged "key for $repo (held back -- 'wk push on' to expose it)"
        elif [ -f "$key" ]; then
            unchanged "key for $repo"
        else
            # No passphrase: used unattended by agents, and a passphrase stored
            # beside the key protects nothing. Per-repo scoping is the control.
            ssh-keygen -t ed25519 -N '' -C "wk deploy key for $repo" -f "$key" >/dev/null
            chmod 0600 "$key"
            changed "generated key for $repo"
        fi
    done
    exit 0
fi

case "$ACTION" in
# The agent's own credential. Not a deploy key and never reaching GitHub, but
# the same shape of problem the tailnet key has: something this repository must
# never contain, kept per machine, asked for here rather than as a surprise
# prompt from whatever needed it first.
#
# In the store rather than host-local, unlike the tailnet keys, because the
# consumers are the workspaces: a container reads it live through the read-only
# /secrets mount, and a guest or a build box is handed a copy when its
# workspace comes up. Nothing here, or anywhere else, ever prints it.
claude)
    [ -z "${3:-}" ] || die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    case "${2:-}" in
        --replace)
            [ -n "$(wk_agent_token)" ] \
                || die "there is no Claude token here to replace ($(wk_agent_token_path)).
    'wk key claude' asks for one."
            # Cleared before asking, so a replace that is then abandoned leaves
            # nothing behind claiming to be current.
            wk_agent_token_clear
            info "removed the old token -- revoke it too if it is still live"
            ;;
        "") ;;
        *) die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h" ;;
    esac

    if [ -n "$(wk_agent_token)" ]; then
        info "claude token: present ($(wk_agent_token_path))"
        log  "  every workspace this machine makes starts authenticated with it:"
        log  "    a container reads it live from the read-only /secrets mount"
        log  "    a macOS guest and a build box are handed a copy at start"
        log  "  whether it still works is not checkable from here -- only Claude"
        log  "  can say, and asking would spend a request. A workspace reporting"
        log  "  'Not logged in' is the evidence that it does not."
        log  "  'wk key claude --replace' rotates it"
        exit 0
    fi

    _tok=$(prompt_secret_value \
        "a Claude Code token, so a workspace starts authenticated instead of asking for /login" \
        "run 'claude setup-token' here and paste what it prints") || _tok=""
    [ -n "$_tok" ] || die "no Claude token stored, so a new workspace will ask you to run /login
    inside it. To store one:  claude setup-token   then  wk key claude"

    # Down a pipe, never as an argument: an argument is in `ps` for everyone on
    # the machine for as long as the command runs.
    printf '%s\n' "$_tok" | wk_agent_token_store \
        || die "could not write $(wk_agent_token_path)"
    unset _tok
    info "stored -- every workspace made from now on starts authenticated"
    log  "  the ones that already exist pick it up on their next 'wk start'"
    ;;

# The tailnet API access token: what retires a fleet node whose name a new
# card needs, so a reprovision does not stop at a person with a browser. Host
# -local like the auth key, and unlike it never seeded onto a card -- it
# administers the whole tailnet, which is why wk_tailscale_key_reject refuses
# it wherever an auth key is wanted.
tailnet-api)
    [ -z "${3:-}" ] || die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    _tsapi=$(wk_tailscale_api_path)
    case "${2:-}" in
        --replace)
            wk_tailscale_api_present \
                || die "there is no tailnet API token here to replace ($_tsapi).
    'wk key tailnet-api' asks for one."
            rm -f "$_tsapi"
            info "removed the old token; nothing on the tailnet is affected"
            ;;
        "") ;;
        *) die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h" ;;
    esac

    if wk_tailscale_api_present; then
        info "tailnet API token: present ($_tsapi)"
        log  "  starts $(head -c 10 "$_tsapi")…, mode $(stat -c '%a' "$_tsapi" 2>/dev/null || stat -f '%Lp' "$_tsapi" 2>/dev/null)"
        # Presence is not usability, and this command is the one place a
        # person is looking at the credential: ask the tailnet.
        if _out=$(WK_TS_API_SECRET_FILE="$_tsapi" python3 "$WK_ROOT/lib/tailnet.py" check 2>&1); then
            log  "  $_out"
        else
            warn "  $_out"
            log  "  'wk key tailnet-api --replace' rotates it"
            exit 1
        fi
        log  "  'wk key tailnet-api --replace' rotates it"
        exit 0
    fi

    if wk_tailscale_api_key >/dev/null; then
        info "stored -- a write that needs a stale fleet node retired can now do it itself"
        exit 0
    fi
    die "no tailnet API token, so retiring a stale fleet node is a person's job at
    https://login.tailscale.com/admin/machines -- a hand step in the middle of a
    lane built to be repeatable (CLAUDE.md, 'Cattle, not pets').
    Make one (tag:wk devices scope is enough):
        https://login.tailscale.com/admin/settings/keys"
    ;;

# The fleet's tailnet auth key. Host-local, and deliberately not in the VM with
# the deploy keys: the machine that writes a card is the machine that needs it.
tailnet)
    [ -z "${3:-}" ] || die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    _tspath=$(wk_tailscale_authkey_path)
    case "${2:-}" in
        --replace)
            wk_tailscale_authkey_present \
                || die "there is no tailnet key here to replace ($_tspath).
    'wk key tailnet' asks for one."
            # Removed before asking: prompt_secret returns an existing file
            # untouched, so a replace that did not clear first would report
            # success and change nothing.
            rm -f "$_tspath"
            info "removed the old key; the nodes already on the tailnet are unaffected"
            log  "  a tagged node does not key-expire, so rotating this costs nothing"
            ;;
        "") ;;
        *) die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h" ;;
    esac

    if wk_tailscale_authkey_present; then
        info "tailnet auth key: present ($_tspath)"
        log  "  starts $(head -c 16 "$_tspath")…, mode $(stat -c '%a' "$_tspath" 2>/dev/null || stat -f '%Lp' "$_tspath" 2>/dev/null)"
        # Split deliberately into what this can prove and what it cannot: the
        # scope is readable from the key, and every other property of it lives
        # in the admin console behind a credential this machine must not hold
        # (wk_tailscale_key_reject, lib/common.sh). Saying "checked" about the
        # second group would be a claim with no evidence under it.
        log  "  checked here: it is an auth key (tskey-auth-), so it can enroll a"
        log  "                node and nothing else -- not an API token or an OAuth"
        log  "                client secret, either of which could administer the tailnet"
        log  "  NOT checkable from the key, and worth a look in the console:"
        log  "                tagged tag:wk, reusable, NOT ephemeral, longest expiry"
        log  "                https://login.tailscale.com/admin/settings/keys"
        log  "  'wk key tailnet --replace' rotates it"
        exit 0
    fi

    # prompt_secret does the asking, the mode and the storing -- one
    # implementation, so this cannot disagree with the prompt some other
    # command shows when it needs the key first.
    if wk_tailscale_authkey >/dev/null; then
        info "stored -- 'wk sysimage write' will seed it onto the cards it writes"
        exit 0
    fi
    die "no tailnet auth key, so a card written now would boot with no tailnet
    identity -- reachable only over whatever LAN it lands on, which is the state
    the fleet rule exists to end (CLAUDE.md, 'Cattle, not pets').
    It must be tagged tag:wk, reusable and NOT ephemeral, longest expiry:
        https://login.tailscale.com/admin/settings/keys
    Then run this again, from a terminal."
    ;;

# What a workstation reads over ssh when registering this machine's key.
# `show` is the human version.
pub)
    remote="${2:-}"
    [ -n "$remote" ] || die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    [ -z "${3:-}" ] || die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    out=$(pub_of "$remote")
    [ -n "$out" ] || exit 1
    printf '%s\n' "$out"
    ;;

# Does the key on *this* machine authenticate, and as what? Printed raw for
# a caller to interpret, since only the workstation has `gh` and only the
# machine with the key can offer it.
sshtest)
    remote="${2:-}"
    [ -n "$remote" ] || die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    [ -z "${3:-}" ] || die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    priv=$(priv_of "$remote")
    [ -n "$priv" ] || { echo "no key"; exit 1; }
    case "$priv" in */push-keys/*) echo "push is off"; exit 3 ;; esac
    in_vm "ssh -o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes \
              -o BatchMode=yes -i $(sh_quote "$priv") \
              -T git@github.com 2>&1 </dev/null || true"
    ;;

# The keys this machine holds, one per line, with the fingerprint that
# identifies them on GitHub and where they currently are:
#
#   fork     SHA256:…  allowed
#   forkwpe  SHA256:…  held
#
# For `wk status`, which lists them per machine -- "which keys can push from
# where" is a question about the fleet, and reading a fingerprint off a screen
# beats reading a public key off one.
fingerprints)
    [ -z "${2:-}" ] || die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    wk_push_forks | while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        pub=$(pub_of "$remote")
        [ -n "$pub" ] || { printf '%-9s %-50s %s\n' "$remote" "-" "no key"; continue; }
        fp=$(printf '%s\n' "$pub" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')
        priv=$(priv_of "$remote")
        case "$priv" in
            '')             state="no private half" ;;
            */push-keys/*)  state="held back (wk push on)" ;;
            *)              state="push allowed" ;;
        esac
        printf '%-9s %-50s %s\n' "$remote" "${fp:-unreadable}" "$state"
    done
    ;;

show)
    [ -z "${2:-}" ] || die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    wk_push_forks | while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        printf '# %s\n%s\n' "$repo" "$(pub_of "$remote")"
    done
    ;;

register)
    [ -z "${2:-}" ] || die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    failed=0
    for machine in $(key_machines); do
        label=$(m_label "$machine")
        info "keys for $label"
        m_ensure "$machine"

    while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        pub=$(m_pub "$machine" "$remote")
        [ -n "$pub" ] || { warn "no key for $repo on $label"; failed=1; continue; }

        # The machine's name, because a deploy-key list on GitHub with three
        # identical titles is a list you cannot revoke selectively.
        title="wk build key ($label)"

        # Already registered? Compare the key body, ignoring title and comment.
        body=$(printf '%s' "$pub" | awk '{print $1" "$2}')
        if gh api "repos/$repo/keys" --jq '.[].key' </dev/null 2>/dev/null \
             | awk '{print $1" "$2}' | grep -qxF "$body"; then
            unchanged "$repo: $label's key already registered"
            continue
        fi

        info "registering $label's deploy key on $repo"
        # read_only=false is the whole point: a key registered read-only looks
        # fine until the first push fails.
        if gh api "repos/$repo/keys" \
             -f "title=$title" \
             -f "key=$pub" \
             -F read_only=false </dev/null >/dev/null 2>&1; then
            changed "$repo: $label's deploy key registered with write access"
        else
            warn "$repo: could not register $label's key automatically"
            log  "  add it by hand at https://github.com/$repo/settings/keys/new"
            log  "  (tick 'Allow write access')"
            printf '%s\n' "$pub"
            failed=1
        fi
    done <<EOF
$(wk_push_forks)
EOF
    done

    echo >&2
    "$0" check
    ;;

check)
    [ -z "${2:-}" ] || die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    # Two questions, two sources.
    #
    # ssh answers "is this key registered and scoped to the right repo?" -- a
    # deploy key replies "Hi owner/repo!", a user key replies without a repo.
    # It says nothing about write access, so that comes from the API where
    # read_only is explicit. Checking ssh alone would happily pass a read-only
    # key and fail at the first push instead.
    rc=0
    for machine in $(key_machines); do
      label=$(m_label "$machine")
      section_printed=""
      while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        [ -n "$section_printed" ] || { printf '  %s\n' "$label:"; section_printed=1; }
        printf '    %-28s ' "$repo"
        pub=$(m_pub "$machine" "$remote")
        [ -n "$pub" ] || { echo "no key -- run: wk key register"; rc=1; continue; }

        # The ssh half runs on the machine that holds the key -- it is the only
        # one that can offer it -- and the answer comes back here, where `gh`
        # and its credential are. Neither half can be done from the other end.
        out=$(m_sshtest "$machine" "$remote")
        case "$out" in
            "push is off"*)
                echo "registered, but push is OFF there -- 'wk push on' allows it"
                continue ;;
            "no key"*)
                echo "no key -- run: wk key register"; rc=1; continue ;;
        esac

        case "$out" in
            *"Hi $repo!"*) ;;
            *"Permission denied"*) echo "not registered on $repo"; rc=1; continue ;;
            *"successfully authenticated"*)
                echo "authenticates, but not scoped to $repo"; rc=1; continue ;;
            *) echo "unexpected: $(printf '%s' "$out" | head -1)"; rc=1; continue ;;
        esac

        # Registered and correctly scoped. Read-only or writable?
        # Match on the base64 body, which is unique and jq-safe.
        #
        # `|| ro=""` keeps this a report rather than an assertion: under
        # `set -o pipefail` a refused API call is the assignment's status and
        # would end the whole command mid-line, leaving every fork after this
        # one unreported. An unknown answer about one repository is the fault;
        # silence about the others is a second, larger one.
        b64=$(printf '%s' "$pub" | awk '{print $2}')
        ro=$(gh api "repos/$repo/keys" </dev/null 2>/dev/null \
             --jq ".[] | select(.key | contains(\"$b64\")) | .read_only" | head -1) || ro=""
        case "$ro" in
            false) echo "ok (write)" ;;
            true)  echo "READ-ONLY -- delete it on GitHub and re-run 'wk key register'"; rc=1 ;;
            *)     echo "registered, but gh could not read $repo's key list, so write access is unconfirmed"; rc=1 ;;
        esac
      done <<EOF
$(wk_push_forks)
EOF
    done
    exit $rc
    ;;

*)
    die "usage: wk key register|check|show|ensure|claude|tailnet|tailnet-api; see wk key -h"
    ;;
esac
