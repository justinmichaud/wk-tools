#!/usr/bin/env bash
#
# wk key setup|set|deploy|check|show|ensure -- the credentials this machine holds
# wk: where=host name=none group=sources needs gh,gh-auth
# wk: sub show,ensure,pub,sshtest,fingerprints,set,register,claude,tailnet,tailnet-api,share,adopt needs=
#
#   wk key setup      store every credential this machine has not got yet, and
#                     report what each one can do. The one command a new
#                     machine needs: it asks for the ones wk is given, mints
#                     the ones wk makes itself, leaves the ones already here
#                     alone, and can be re-run. One line per credential --
#                     stored, minted, skipped or refused, with the path or the
#                     reason -- and then `wk key check`'s table
#   wk key set <name> [--replace] [--paste]
#                     one credential by name, or the report on it when it is
#                     already here.
#                       --replace  rotate it: the old one is removed first
#                       --paste    take the value on stdin instead of minting
#                                  one, so a second machine can hold the same
#                                  minted credential as the first
#                     <name> is a row of lib/credcheck.py:
#
#                       github-pat    what `git-webkit pr` opens a pull request
#                                     with. The one credential that never
#                                     enters a workspace: only the credential
#                                     injector reads it, which reads GitHub
#                                     with it whatever position `wk push` is in
#                                     and writes only while it is on. Refused
#                                     unless it reaches exactly the forks in
#                                     wk_push_forks: the token page cannot
#                                     preselect them, so its own answer to
#                                     `GET /user/repos` is what decides
#                       claude        the Claude Code token every workspace
#                                     this machine makes starts authenticated
#                                     with (`claude setup-token` prints one)
#                       claude-login  the claude.ai login the containers share,
#                                     made once here in a browser with the
#                                     shared directory as the CLI's config home,
#                                     so the credential and the account record
#                                     remote control reads land beside each
#                                     other; separate from this machine's own
#                                     login so neither refresh invalidates the
#                                     other. The second of Claude's two, and
#                                     what `wk ai claude <ws> --rc` needs
#                       litellm       the API key `wk ai pi` reaches your
#                                     LiteLLM endpoint with
#                       tailnet       the fleet's tailnet auth key, seeded onto
#                                     every card written here
#                       tailnet-api   the tailnet API token this machine
#                                     retires a stale fleet node with; never
#                                     written to a card
#                       ntfy          the ntfy.sh topic `wk notify` publishes
#                                     to, so the fleet can tell you it wants
#                                     you. Minted here, never invented: the
#                                     topic name is the whole credential, so it
#                                     is printed once, as it is minted, and
#                                     never written to a card or held by a
#                                     workspace
#
#   wk key deploy     the push keys: one deploy key per fork, the same on every
#                     workstation, registered on GitHub with write access, and
#                     fanned out over the tailnet to the other workstations so
#                     they all hold the one key. --rotate makes a fresh key,
#                     removes the old one from GitHub, and fans the new one out
#   wk key share      fan this machine's deploy keys and API token out to every
#                     other workstation over the tailnet, without touching
#                     GitHub -- what a new workstation runs to catch up
#   wk key check      what every credential this machine holds can do and how
#                     far it reaches, each one asked again at that moment
#   wk key show       print the public halves
#   wk key ensure     create missing push keys without registering them
#
# One key per fork, the same on every workstation and shared by every workspace:
# GitHub deploy keys are scoped to a single repository and refuse the same key on
# a second one, so a compromised workspace can push to the forks in wk_push_forks
# and nowhere else. The one key per fork is registered once, and the same private
# half is held on every workstation -- fanned out over the tailnet by 'wk key
# share', which 'deploy' calls after it registers. Rotating on any workstation
# ('wk key deploy --rotate') removes the old key from GitHub, mints a new one,
# and fans it out, so the whole fleet turns over from one command.
#
# A shared build machine holds no key at all: it reaches the deploy key through
# an ssh-agent forwarded from the workstation that drives it, so nothing private
# rests on a machine other people are root on (remote/provision.sh, targets/remote.sh).
# Registration goes through the GitHub API, which takes the title, key and
# read_only=false directly.
#
# Three more, addressed to one fork rather than every one of them, meant for
# another machine or `wk status` to call rather than to type by hand:
#
#   wk key pub <fork>        print that fork's public key
#   wk key sshtest <fork>    does that fork's key authenticate, and as what
#   wk key fingerprints      every key here, its fingerprint and its state
#
# <fork> is one of wk_push_forks' short names (lib/store.sh).
#
# Every credential is put to a rule before it is stored, and to the same rule
# again whenever one is reported (`wk key check`, `wk doctor`): the rules are
# lib/credcheck.py, one row each, and that row is also what a prompt here asks
# for and where it sends you to mint one. One that cannot do its job is refused
# and nothing is stored; one that reaches further than wk spends it is kept with
# that reach named; one no network could be reached to judge is kept and
# reported unverified.
#
# Runs on the machine that holds the keys: the secrets directory is this device's
# (wk_secrets_dir), and on macOS the podman machine reads it as a mount, so every
# subverb here is ssh-keygen, a file and `gh`, with no VM in the path.
#
# `setup`, `deploy` and `check` are the only ones that call the GitHub API, which
# is why the rest clear `needs`: that is what lets `wk key ensure` run over ssh
# on a build machine with no `gh` on it, and `wk key set tailnet` store a key on
# a machine whose gh login has expired.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/par.sh"

load_target "$(default_target)" 2>/dev/null || true

ACTION="${1:-setup}"

USAGE="usage: wk key setup|set|deploy|check|show|ensure; see wk key -h"

ensure_keys() { "$0" ensure 2>&1 | sed 's/^/  /'; }

# Every workstation that holds the shared key: this one, and the peers. A shared build machine is not one -- it holds no key and reaches ours through a forwarded agent (build_boxes below).
workstations() {
    echo local
    for_each_machine _peer_workstation
    return 0
}

# The shared build machines: a wk over there, but not a peer, so no key rests on them.
build_boxes() {
    for_each_machine _build_box
    return 0
}

_build_box() {
    ( load_target "$1"
      [ -z "${WK_REMOTE_PEER:-}" ] && t_has_wk ) 2>/dev/null && echo "$1"
    return 0
}

m_label() {
    [ "$1" = local ] && { hostname -s; return 0; }
    printf '%s' "$1"
}

# `|| true` on both: a machine with no key yet answers non-zero, and under `set -o pipefail` that would end the command.
m_pub() {
    if [ "$1" = local ]; then pub_of "$2"; return 0; fi
    { ( load_target "$1"; t_wk key pub "$2" ) 2>/dev/null || true; } | tr -d '\r'
}

m_sshtest() {
    if [ "$1" = local ]; then "$0" sshtest "$2" 2>/dev/null || true; return 0; fi
    { ( load_target "$1"; t_wk key sshtest "$2" ) 2>/dev/null || true; } | tr -d '\r'
    return 0
}
pub_of() { # <fork>
    cat "$(wk_secrets_dir)/build_key_$1.pub" 2>/dev/null
    return 0
}

priv_of() { # <fork>
    [ -f "$(wk_push_held_dir)/build_key_$1" ] \
        && printf '%s\n' "$(wk_push_held_dir)/build_key_$1"
    return 0
}

# The CLI rotates the refresh token in the file it writes, so a copy of this machine's own login is a second holder of one token and the first refresh on either side locks the other out: the shared directory logs in for itself. It is the config home for that login (CLAUDE_CONFIG_DIR), not only the credential store: the account record remote control reads (oauthAccount) goes into the config file, and pointed at the store alone the CLI wrote it into this machine's own ~/.claude.json (measured 2026-09-11).
_claude_login_run() { # <name> -- log in where the containers read it
    have claude || die "$(cred_line "$1" skipped \
        "the Claude CLI makes this login and is not on PATH -- install it, then: wk key set $1")"
    [ -t 0 ] || die "$(cred_line "$1" skipped \
        "this login opens a browser and needs a terminal -- re-run interactively: wk key set $1")"
    ensure_dir "$(wk_agent_rw_dir)" 0700
    CLAUDE_CONFIG_DIR="$(wk_agent_rw_dir)" CLAUDE_SECURESTORAGE_CONFIG_DIR="$(wk_agent_rw_dir)" claude auth login \
        || die "$(cred_line "$1" skipped "'claude auth login' did not finish")"
}

CRED_VERDICT=""

cred_admit() { # <name> <value>
    CRED_VERDICT=$(printf '%s' "$2" | wk_cred_check "$1")
    [ "$(wk_cred_verdict "$CRED_VERDICT")" != bad ] \
        || die "$(cred_line "$1" refused "$(wk_cred_detail "$CRED_VERDICT")")"
}

cred_look() { # <name>   what the stored one can do, asked now
    CRED_VERDICT=$(wk_cred_check "$1" --stored)
}

cred_print() { # <name>  non-zero when it cannot do its job
    local v d
    v=$(wk_cred_verdict "$CRED_VERDICT"); d=$(wk_cred_detail "$CRED_VERDICT")
    case "$v" in
        ok)         log  "  $d" ;;
        wide)       warn "$1 reaches further than wk spends it: $d" ;;
        unverified) warn "$1 is unverified: $d" ;;
        bad)        warn "$1 cannot do its job: $d"; return 1 ;;
    esac
}

cred_known() { wk_cred_settable | grep -qxF "$1"; }

cred_line() { # <name> <stored|minted|skipped|refused> <path or one-line reason>
    local var; var=$(wk_agent_secret_field "$1" 4)
    [ "$var" = - ] && var=""
    printf '%-13s %-8s %s%s' "$1" "$2" "$3" "${var:+  (\$$var in a workspace)}"
}

# One row of `wk key check`, in a column-aligned table: the verdict's summary line, and the fix when the detail carries one (lib/credcheck.py writes it as a `fix:` line for a credential that cannot do its job). The rest of the detail -- what it must be able to do, what it must not -- is what `wk key show <name>` prints.
cred_row() { # <verdict line>
    printf '%s\n' "$(wk_cred_detail "$1" | sed -n '1p; /^ *fix: /p')"
}

# One row of `wk key check`, whole, in its own par job: the rows are independent probes, so they are asked at once and the table replays them in its own order.
check_fork_row() { # <machine> <remote> <repo>
    local machine="$1" remote="$2" repo="$3" pub b64 ro line
    printf '    %-28s ' "$repo" >&3
    pub=$(m_pub "$machine" "$remote")
    [ -n "$pub" ] || { echo "no key -- run: wk key deploy" >&3; return 1; }

    # Matched on the base64 body, which is unique and jq-safe. `|| ro=""` keeps this a report: pipefail would end it on a refused API call.
    b64=$(printf '%s' "$pub" | awk '{print $2}')
    ro=$(gh api "repos/$repo/keys" </dev/null 2>/dev/null \
         --jq ".[] | select(.key | contains(\"$b64\")) | .read_only" | head -1) || ro=""
    line=$(wk_cred_check deploy-key --repos "$repo" \
               --evidence "ssh=$(m_sshtest "$machine" "$remote")" \
               --evidence "read_only=$ro" </dev/null)
    cred_row "$line" >&3
    [ "$(wk_cred_verdict "$line")" = ok ]
}

check_cred_row() { # <name>
    printf '    %-28s ' "$1" >&3
    cred_look "$1"
    cred_row "$CRED_VERDICT" >&3
    [ "$(wk_cred_verdict "$CRED_VERDICT")" != bad ]
}

# Deliberately not delivered into a workspace like the wk_agent_secrets rows: only the credential injector, on the machine that runs the workspaces, ever reads the token.
cred_deliver() { # <name> -- carry a stored, rotated or withdrawn one to where it is read
    [ "$1" = github-pat ] || return 0
    push_agent_pat_deliver && return 0
    warn "an injector on this machine did not take the read token, so a read from
    the workspaces it serves answers 401 until it does. './setup' converges the
    one in the podman machine (the vmtools stage on macOS, sdk on Linux) and
    'wk vm start <guest>' the one that serves the guests."
}

# Every reader of a stored credential redacts it, so this print is the only chance to point a phone at one wk mints.
cred_minted_once() { # <name> <value>
    log  "  printed once: $(wk_cred_rule "$1" url)$2"
    log  "  $(wk_cred_rule "$1" remedy)"
}

cred_report() { # <name> -- non-zero when what is stored cannot do its job
    log "$(cred_line "$1" stored "$(wk_cred_path "$1")")"
    cred_look "$1"
    cred_print "$1"
}

SHARED_KEY_TITLE="wk shared deploy key"   # rotation finds the old key to remove by this one title

# The other workstations: a peer with a wk over there. A build machine is not one (build_boxes) -- it holds no key.
peer_workstations() {
    for_each_machine _peer_workstation
    return 0
}

_peer_workstation() {
    ( load_target "$1"
      [ -n "${WK_REMOTE_PEER:-}" ] && t_has_wk ) 2>/dev/null && echo "$1"
    return 0
}

share_to() { # <machine> -- each value on stdin, never an argument in `ps` over there
    local machine="$1" remote repo alias pat
    while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        [ -n "$(wk_push_key "$remote")" ] || continue
        if wk_push_key "$remote" | ( load_target "$machine"; t_wk key adopt "$remote" ) >/dev/null 2>&1; then
            changed "$machine: shared the $repo deploy key"
        else
            warn "$machine: could not share the $repo deploy key"
            return 1
        fi
    done <<EOF
$(wk_push_forks)
EOF
    pat=$(wk_github_pat)
    if [ -n "$pat" ]; then
        if printf '%s\n' "$pat" | ( load_target "$machine"; t_wk key set github-pat --paste ) >/dev/null 2>&1; then
            changed "$machine: shared the GitHub API token"
        else
            warn "$machine: could not share the GitHub API token"
            return 1
        fi
    fi
}

share_keys() {
    local machine failed=0
    for machine in $(peer_workstations); do
        info "sharing to $machine"
        share_to "$machine" || failed=1
    done
    return "$failed"
}

registered_key_body() { # <repo> -- the registered keys, matched on the jq-safe base64 body
    gh api "repos/$1/keys" --jq '.[].key' </dev/null 2>/dev/null \
        | awk '{print $1" "$2}'
}

# Remove every key registered under the shared title, so a rotation leaves no stale key with write access behind.
revoke_shared_keys() { # <repo>
    local id
    for id in $(gh api "repos/$1/keys" </dev/null 2>/dev/null \
                --jq ".[] | select(.title == \"$SHARED_KEY_TITLE\") | .id"); do
        gh api -X DELETE "repos/$1/keys/$id" </dev/null >/dev/null 2>&1 \
            && changed "$1: removed the old shared deploy key ($id)" \
            || warn "$1: could not remove the old shared deploy key ($id)"
    done
}

register_shared_keys() { # 0 unless a fork could not be registered
    local remote repo alias pub body failed=0
    while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        pub=$(pub_of "$remote")
        [ -n "$pub" ] || { warn "no key for $repo here -- 'wk key ensure' makes it"; failed=1; continue; }
        body=$(printf '%s' "$pub" | awk '{print $1" "$2}')
        if registered_key_body "$repo" | grep -qxF "$body"; then
            unchanged "$repo: the shared deploy key is already registered"
            continue
        fi
        info "registering the shared deploy key on $repo"
        # read_only=false: a key registered read-only looks fine until the first push fails.
        if gh api "repos/$repo/keys" \
             -f "title=$SHARED_KEY_TITLE" -f "key=$pub" \
             -F read_only=false </dev/null >/dev/null 2>&1; then
            changed "$repo: the shared deploy key is registered with write access"
        else
            warn "$repo: could not register the shared key automatically"
            log  "  add it at https://github.com/$repo/settings/keys/new, ticking 'Allow write access':"
            printf '%s\n' "$pub"
            failed=1
        fi
    done <<EOF
$(wk_push_forks)
EOF
    return "$failed"
}

rotate_keys() {   # the old keys off GitHub first (one left there keeps write access), then deploy_keys makes and fans out fresh ones
    local remote repo alias
    while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        revoke_shared_keys "$repo"
        rm -f "$(wk_push_held_dir)/build_key_$remote" "$(wk_secrets_dir)/build_key_$remote.pub"
    done <<EOF
$(wk_push_forks)
EOF
}

deploy_keys() {
    local failed=0
    ensure_keys
    register_shared_keys || failed=1
    share_keys || failed=1
    return "$failed"
}

if [ "$ACTION" = ensure ]; then
    [ -z "${2:-}" ] || die "$USAGE"
    ensure_dir "$(wk_secrets_dir)" 0700
    ensure_dir "$(wk_push_held_dir)" 0700
    wk_push_forks | while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        key="$(wk_push_held_dir)/build_key_$remote"
        pub="$(wk_secrets_dir)/build_key_$remote.pub"
        if [ -f "$key" ]; then
            unchanged "key for $repo"
        else
            # No passphrase: used unattended by agents, and one stored beside the key protects nothing. Per-repo scoping is the control.
            ssh-keygen -t ed25519 -N '' -C "wk deploy key for $repo" -f "$key" >/dev/null
            chmod 0600 "$key"
            changed "generated key for $repo"
        fi
        # Re-asserted rather than written once: a machine whose secrets directory was recreated would otherwise name an identity that is not there.
        if [ -f "$key.pub" ] && ! cmp -s "$key.pub" "$pub"; then
            install -m 0644 "$key.pub" "$pub"
        fi
    done
    secrets_publish_view container
    exit 0
fi

case "$ACTION" in
setup)
    [ -z "${2:-}" ] || die "$USAGE"
    deploy_keys || true
    for _name in $(wk_cred_settable); do
        if wk_cred_present "$_name"; then
            log "$(cred_line "$_name" stored "$(wk_cred_path "$_name")")"
            continue
        fi
        # A credential declined, or one that cannot be asked for without a
        # terminal, is not a reason to leave the rest of them unset.
        "$0" set "$_name" || true
    done
    "$0" check
    ;;

set)
    _name="${2:-}"; _replace=""; _paste=""; _mints=""; _minted=""; _val=""
    _state=stored
    [ -n "$_name" ] || die "usage: wk key set <name> [--replace] [--paste]
    names: $(wk_cred_settable | tr '\n' ' ')"
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --replace) _replace=1 ;;
            --paste)   _paste=1 ;;
            *)         die "$USAGE" ;;
        esac
        shift
    done
    [ "$_name" != deploy-key ] \
        || die "a deploy key is generated here and never pasted:  wk key deploy"
    cred_known "$_name" \
        || die "there is no credential called '$_name'.
    This checkout knows: $(wk_cred_settable | tr '\n' ' ')
    Each is a row of lib/credcheck.py, which is also what says where to mint
    one and what it must be able to do."

    if wk_cred_mints "$_name"; then _mints=1; fi
    # --paste takes any credential's value on stdin, so a second workstation holds the same one as the first (wk key share fans them out this way). The one it cannot carry is the claude.ai login: that is a browser flow, not a value.
    [ -z "$_paste" ] || [ "$_name" != claude-login ] \
        || die "--paste cannot carry a claude.ai login -- it is made in a browser:
    wk key set claude-login"

    if [ -n "$_replace" ]; then
        wk_cred_present "$_name" \
            || die "there is no $_name credential here to replace ($(wk_cred_path "$_name")).
    'wk key set $_name' stores one."
        # Cleared before the new one is made, so an abandoned replace leaves nothing behind.
        wk_cred_clear "$_name"
        cred_deliver "$_name"
        info "removed the old $_name credential -- revoke it too if it is still live"
    fi

    # A pasted value always overwrites: it is an explicit "hold this one", the fan-out's way of rotating a workstation onto the fleet's current credential. Otherwise a bare `set` of one already here just reports it.
    if wk_cred_present "$_name" && [ -z "$_paste" ]; then
        cred_report "$_name" || exit 1
        exit 0
    fi

    if [ "$_name" = claude-login ]; then
        _claude_login_run "$_name"
        wk_cred_present "$_name" \
            || die "$(cred_line "$_name" skipped \
                "'claude auth login' left nothing at $(wk_cred_path "$_name")")"
        cred_report "$_name" || exit 1
        exit 0
    fi

    # A minted row is made here; one on stdin is a minted credential a first machine already holds. Both are put to the rule first.
    if [ -n "$_paste" ]; then
        _val=$(cat)
        [ -n "$_val" ] || die "nothing arrived on stdin, so nothing is stored.
    To mint one here instead:  wk key set $_name"
    elif [ -n "$_mints" ]; then
        _val=$(wk_cred_mint "$_name"); _minted=1
    else
        _val=$(prompt_secret_value "$(wk_cred_rule "$_name" what)" \
                   "$(wk_cred_rule "$_name" url)" \
                   "$(wk_cred_rule "$_name" remedy)") || _val=""
        [ -n "$_val" ] || die "$(cred_line "$_name" skipped \
            "nothing stored, so nothing here can $(wk_cred_rule "$_name" needs)")"
    fi

    # Before anything is written, so a credential the far side refuses is refused here rather than hours later by whatever spends it.
    cred_admit "$_name" "$_val"
    # Down a pipe: an argument would be in `ps` for everyone on the machine.
    printf '%s\n' "$_val" | wk_cred_store "$_name" \
        || die "could not write $(wk_cred_path "$_name")"
    cred_deliver "$_name"
    [ -z "$_minted" ] || _state=minted
    log "$(cred_line "$_name" "$_state" "$(wk_cred_path "$_name")")"
    [ -z "$_minted" ] || cred_minted_once "$_name" "$_val"
    unset _val
    cred_print "$_name" || true
    ;;

pub)
    remote="${2:-}"
    [ -n "$remote" ] || die "$USAGE"
    [ -z "${3:-}" ] || die "$USAGE"
    out=$(pub_of "$remote")
    [ -n "$out" ] || exit 1
    printf '%s\n' "$out"
    ;;

sshtest)
    remote="${2:-}"
    [ -n "$remote" ] || die "$USAGE"
    [ -z "${3:-}" ] || die "$USAGE"
    priv=$(priv_of "$remote")
    [ -n "$priv" ] || { echo "no key"; exit 1; }
    ssh -o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes \
        -o BatchMode=yes -i "$priv" \
        -T git@github.com 2>&1 </dev/null || true
    ;;

fingerprints)
    [ -z "${2:-}" ] || die "$USAGE"
    wk_push_forks | while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        pub=$(pub_of "$remote")
        [ -n "$pub" ] || { printf '%-9s %-50s %s\n' "$remote" "-" "no key"; continue; }
        fp=$(printf '%s\n' "$pub" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')
        # A private half is always in the one directory nothing mounts, so where it is says nothing about the switch (`wk push status` does).
        priv=$(priv_of "$remote")
        [ -n "$priv" ] && state="private half here ('wk push status')" \
                       || state="no private half"
        printf '%-9s %-50s %s\n' "$remote" "${fp:-unreadable}" "$state"
    done
    ;;

show)
    [ -z "${2:-}" ] || die "$USAGE"
    wk_push_forks | while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        printf '# %s\n%s\n' "$repo" "$(pub_of "$remote")"
    done
    ;;

adopt)
    remote="${2:-}"
    [ -n "$remote" ] || die "usage: wk key adopt <fork>   (the private key on stdin)"
    [ -z "${3:-}" ] || die "$USAGE"
    wk_push_forks | awk 'NF {print $1}' | grep -qxF "$remote" \
        || die "no fork called '$remote'; this checkout knows: $(wk_push_forks | awk 'NF{printf "%s ",$1}')"
    wk_push_key_adopt "$remote" \
        || die "what arrived on stdin is not a usable private key for $remote"
    log "adopted the shared deploy key for $remote"
    ;;

share)
    [ -z "${2:-}" ] || die "$USAGE"
    _peers=$(peer_workstations)
    [ -n "$_peers" ] || { info "no other workstation to share with (a peer with wk over the tailnet)"; exit 0; }
    share_keys || die "one or more workstations did not take the shared keys (above)"
    info "every workstation now holds this machine's deploy keys and API token"
    ;;

deploy)
    _rotate=""
    case "${2:-}" in
        --rotate) _rotate=1 ;;
        "")       ;;
        *)        die "usage: wk key deploy [--rotate]; see wk key -h" ;;
    esac
    [ -z "${3:-}" ] || die "$USAGE"
    [ -z "$_rotate" ] || { info "rotating: removing the old shared keys from GitHub"; rotate_keys; }
    deploy_keys || true
    echo >&2
    "$0" check
    ;;

check)
    [ -z "${2:-}" ] || die "$USAGE"
    rc=0
    _machines=$(workstations)
    _forks=$(wk_push_forks)
    _creds=$(wk_cred_settable)
    _boxes=$(build_boxes)

    wk_atexit par_cleanup
    par_begin
    for machine in $_machines; do
      while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        par_run "fork-$machine-$remote" check_fork_row "$machine" "$remote" "$repo"
      done <<EOF
$_forks
EOF
    done
    for _cname in $_creds; do par_run "cred-$_cname" check_cred_row "$_cname"; done
    par_wait

    for machine in $_machines; do
      label=$(m_label "$machine")
      section_printed=""
      while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        [ -n "$section_printed" ] || { printf '  %s\n' "$label:"; section_printed=1; }
        par_record "fork-$machine-$remote"
        [ "$(par_rc "fork-$machine-$remote")" = 0 ] || rc=1
      done <<EOF
$_forks
EOF
    done

    if [ -n "$_boxes" ]; then
        printf '  build machines (no key at rest -- reached by forwarded agent):\n'
        for machine in $_boxes; do
            printf '    %-28s %s\n' "$machine" "holds no deploy key; 'wk push' forwards yours"
        done
    fi

    printf '  credentials:\n'
    for _cname in $_creds; do
        par_record "cred-$_cname"
        [ "$(par_rc "cred-$_cname")" = 0 ] || rc=1
    done
    par_end
    exit $rc
    ;;

register|claude|tailnet|tailnet-api)
    case "$ACTION" in
        register) _now="wk key deploy" ;;
        claude)   _now="wk key set claude   (the account login beside it is 'wk key set claude-login')" ;;
        *)        _now="wk key set $ACTION" ;;
    esac
    die "'wk key $ACTION' is now:  $_now
    'wk key setup' does every credential this machine has not got yet."
    ;;

*)
    die "$USAGE"
    ;;
esac
