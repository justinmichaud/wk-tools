#!/usr/bin/env bash
#
# wk key register|check|show|ensure|set|claude|tailnet|tailnet-api -- the credentials a workspace needs
# wk: where=host name=none group=sources needs gh,gh-auth
# wk: sub show,ensure,pub,sshtest,fingerprints,set,claude,tailnet,tailnet-api needs=
#
# One key per fork, shared by every workspace. GitHub deploy keys are
# scoped to a single repository and refuses the same key on a second one,
# so multiple push targets means multiple keys -- worth keeping rather than
# working around: a compromised workspace can push to the forks in
# wk_push_forks and nowhere else.
#
# Registration goes through the GitHub API, not a browser: the deploy-key
# page accepts no query-string prefill, and the API takes the title, key
# and read_only=false directly -- no chance of leaving the write checkbox
# unticked, the easy mistake that only shows up much later at push time.
#
#   wk key register   create the keys and register them (idempotent)
#   wk key check      verify each key authenticates with write access
#   wk key show       print the public keys
#   wk key ensure     create missing keys without registering them
#   wk key set <name> [--replace]
#                     an agent's own credential, for every workspace this
#                     machine makes: `claude` is the Claude Code token a
#                     workspace starts authenticated with (`claude setup-token`
#                     prints one), `litellm` is the API key `wk ai pi` reaches
#                     your LiteLLM endpoint with, and `claude-login` is the
#                     claude.ai account credential `claude auth login` leaves
#                     on this machine -- read from where the Claude CLI put it,
#                     never pasted, and what Claude Code Remote Control
#                     (`wk ai claude <ws> --rc`) refuses to start without,
#                     the token above being inference-only. The names are
#                     wk_agent_secrets (lib/store.sh); each target driver hands
#                     what it holds to the workspaces it brings up.
#                     `github-pat` is the one name that is not in that table
#                     and never enters a workspace: it is what `git-webkit pr`
#                     opens a pull request with, held beside the deploy keys
#                     and read only by the credential injector on the machine,
#                     which reads GitHub with it whatever position 'wk push' is
#                     in and writes only while it is on
#   wk key claude [--replace]
#                     `wk key set claude`, the same arm and the same store --
#                     the spelling `wk doctor` prints as its remedy
#   wk key tailnet-api [--replace]
#                               the tailnet API access token this machine
#                               administers with: retiring a fleet node whose
#                               name a new card needs. Never written to a card.
#   wk key tailnet [--replace]   the fleet's tailnet auth key: report it, ask
#                     for it, or (--replace) rotate it
#
# Three more, addressed to one fork rather than every one of them, meant for
# another machine or `wk status` to call rather than to type by hand:
#
#   wk key pub <fork>        print that fork's public key
#   wk key sshtest <fork>    does that fork's key authenticate, and as what
#   wk key fingerprints      every key here, its fingerprint and its state
#
# <fork> is one of wk_push_forks' short names (lib/store.sh) -- 'wk key show'
# prints each fork's full repository alongside its key.
#
# The tailnet key is the odd one here and belongs anyway: not a deploy key,
# never reaching GitHub, but a credential this repository must never
# contain, kept per machine -- asked for here rather than as a prompt from
# whatever needs it, since for a card write that need appears only after
# the card has already been erased.
#
# Runs on the machine that holds the keys, which is this one: the secrets
# directory is this device's (wk_secrets_dir, lib/store.sh), and on macOS the
# podman machine reads it as a mount rather than holding a copy -- so every
# subverb here is ssh-keygen, a file and `gh`, with no VM in the path.
#
# `register` and `check` are the two that call the GitHub API, so they are the
# only two that need `gh` and a token that works; the rest is ssh-keygen, a
# file and an ssh connection, and clearing `needs` for them is what lets
# `wk key ensure` run over ssh on a build machine with no `gh` on it at all,
# and `wk key tailnet` store a key on a machine whose gh login has expired.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# The store this machine keeps its own state in: /var/lib/wk inside the podman
# VM, the remote root on a build machine. The driver is what knows, so ask it.
load_target "$(default_target)" 2>/dev/null || true

ACTION="${1:-register}"

# One usage line for every refusal in here, so a new subverb cannot be forgotten
# in fifteen literal strings.
USAGE="usage: wk key register|check|show|ensure|set|claude|tailnet|tailnet-api; see wk key -h"

ensure_keys() { "$0" ensure 2>&1 | sed 's/^/  /'; }

# --- one key per machine, not one key everywhere ------------------------------
# GitHub accepts several keys on one repository, so every machine that pushes
# gets its own, revocable on its own. Copying one between machines would put a
# private key on the wire.
key_machines() {
    echo local
    for_each_machine _key_has_wk
    return 0
}

_key_has_wk() {
    ( load_target "$1"; t_has_wk ) 2>/dev/null && echo "$1"
    return 0
}

# The label a key is registered under, so a key list on GitHub says which machine
# each one lets in.
m_label() {
    [ "$1" = local ] && { hostname -s; return 0; }
    printf '%s' "$1"
}

m_ensure() {
    if [ "$1" = local ]; then ensure_keys; return 0; fi
    ( load_target "$1"; t_wk key ensure ) 2>&1 | sed 's/^/  /'
}

# `|| true` on both: a machine with no key yet answers non-zero, and under
# `set -o pipefail` that would end the command. An absent key is an answer.
m_pub() {
    if [ "$1" = local ]; then pub_of "$2"; return 0; fi
    { ( load_target "$1"; t_wk key pub "$2" ) 2>/dev/null || true; } | tr -d '\r'
}

m_sshtest() {
    if [ "$1" = local ]; then "$0" sshtest "$2" 2>/dev/null || true; return 0; fi
    { ( load_target "$1"; t_wk key sshtest "$2" ) 2>/dev/null || true; } | tr -d '\r'
    return 0
}
# The public half goes where every workspace reads it (wk_secrets_dir, a
# read-only mount in there), the private half where nothing mounts it at all
# (wk_push_held_dir).
pub_of() { # <fork>
    cat "$(wk_secrets_dir)/build_key_$1.pub" 2>/dev/null
    return 0
}

# Where the private half is, or empty when there is none. `wk key check` needs it
# to authenticate, and needs to say *why* when it cannot.
priv_of() { # <fork>
    [ -f "$(wk_push_held_dir)/build_key_$1" ] \
        && printf '%s\n' "$(wk_push_held_dir)/build_key_$1"
    return 0
}

# --- the claude.ai login credential, captured rather than pasted -------------
# `claude auth login` leaves the account credential where the Claude CLI keeps
# it, and that is platform-specific: on macOS a login-Keychain item whose service
# name the CLI builds as "Claude Code-credentials", on Linux the file
# ${CLAUDE_CONFIG_DIR:-~/.claude}/.credentials.json. Never read through an
# argument, which `ps` shows to everyone here.
#
# On macOS, CLAUDE_CONFIG_DIR set changes that Keychain service name -- the CLI
# appends a hash of the directory -- so the item read below is not the one it
# wrote. Refused before the read: a `die` in a command substitution ends only the
# subshell. On Linux the same variable names the directory, and the read follows.
_claude_login_refuse_relocated_store() {
    is_macos || return 0
    [ -z "${CLAUDE_CONFIG_DIR:-}" ] \
        || die "CLAUDE_CONFIG_DIR is set here ($CLAUDE_CONFIG_DIR), and the Claude CLI
    then keeps its login under a Keychain item named for that directory, not
    the default one this reads. Run this in a shell without it set."
}

# Nothing at all when there is no login here, and that is not an error: the
# caller says what to do about it. Same contract as _wk_secret_read.
_claude_login_read() {
    # `|| true` on both: "there is no such item" is how each of these says there
    # is no login here, and under `set -e` that status would end the command.
    if is_macos; then
        security find-generic-password -a "$USER" -w -s "Claude Code-credentials" 2>/dev/null || true
    else
        cat "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json" 2>/dev/null || true
    fi
}

# Is it the credential remote control needs? One line back: `ok:<scopes>` or
# `bad:<why>`. The shape is the CLI's own (claudeAiOauth: {accessToken,
# refreshToken, expiresAt, scopes, ...}), and the two things checked decide
# whether an agent can use it: a refreshToken, which a `claude setup-token` token
# has none of, and the user:profile scope. Reads stdin; prints no part of it.
# `python3 -c`, not a heredoc: a heredoc *is* python's stdin.
_claude_login_check() {
    python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception as e:
    print("bad:not JSON at all (%s)" % e.__class__.__name__); raise SystemExit(0)
o = d.get("claudeAiOauth") if isinstance(d, dict) else None
if not isinstance(o, dict):
    print("bad:no claudeAiOauth object -- not a claude.ai login credential")
    raise SystemExit(0)
if not isinstance(o.get("accessToken"), str) or not o["accessToken"]:
    print("bad:no accessToken"); raise SystemExit(0)
if not isinstance(o.get("refreshToken"), str) or not o["refreshToken"]:
    print("bad:no refreshToken -- an inference-only token, not a login")
    raise SystemExit(0)
scopes = o.get("scopes")
if not isinstance(scopes, list) or "user:profile" not in scopes:
    print("bad:scopes are %s -- remote control needs user:profile" % (scopes,))
    raise SystemExit(0)
print("ok:" + " ".join(str(s) for s in scopes))
'
}

# --- ensure runs where the secrets are, which is this machine ----------------
if [ "$ACTION" = ensure ]; then
    [ -z "${2:-}" ] || die "$USAGE"
    ensure_dir "$(wk_secrets_dir)" 0700
    ensure_dir "$(wk_push_held_dir)" 0700
    wk_push_forks | while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        # The private half is generated where it lives for good, in the directory
        # nothing mounts; only the public half is copied to the one every
        # workspace reads (wk_ssh_alias_blocks names it).
        key="$(wk_push_held_dir)/build_key_$remote"
        pub="$(wk_secrets_dir)/build_key_$remote.pub"
        if [ -f "$key" ]; then
            unchanged "key for $repo"
        else
            # No passphrase: used unattended by agents, and a passphrase stored
            # beside the key protects nothing. Per-repo scoping is the control.
            ssh-keygen -t ed25519 -N '' -C "wk deploy key for $repo" -f "$key" >/dev/null
            chmod 0600 "$key"
            changed "generated key for $repo"
        fi
        # Re-asserted rather than written once: a machine whose secrets directory
        # was recreated would otherwise name an identity that is not there.
        if [ -f "$key.pub" ] && ! cmp -s "$key.pub" "$pub"; then
            install -m 0644 "$key.pub" "$pub"
        fi
    done
    exit 0
fi

case "$ACTION" in
# An agent's own credential, by name (wk_agent_secrets, lib/store.sh). Not a
# deploy key and never reaching GitHub, but the same shape of problem the tailnet
# key has: something this repository must never contain, kept per machine. It
# sits beside the deploy keys because the consumers are the workspaces: a
# container reads it live through the read-only /secrets mount, a guest or build
# box is handed a copy. Nothing here ever prints one. `wk key claude` is this arm
# with the name filled in, not a second one.
set|claude)
    if [ "$ACTION" = set ]; then
        _name="${2:-}"; _flag="${3:-}"; _tail="${4:-}"
        [ -n "$_name" ] || die "usage: wk key set <name> [--replace]
    names: $(wk_agent_secret_names | tr '\n' ' ')github-pat"
    else
        _name=claude; _flag="${2:-}"; _tail="${3:-}"
    fi
    [ -z "$_tail" ] || die "$USAGE"

    # Deliberately *not* a row in wk_agent_secrets: every row in that table is
    # delivered into the workspace, and this one must never be. It lives in
    # wk_push_held_dir, and the only thing that reads it is the credential injector
    # on the machine that runs the workspaces (container/proxy/github-inject.py).
    if [ "$_name" = github-pat ]; then
        # Reading GitHub is open whatever position `wk push` is in, so the
        # machine keeps a standing copy. Best effort: ./setup converges it too.
        _deliver_read_pat() {
            push_agent_pat_sync push_agent_exec "$(push_agent_machine_read_pat)" \
                && return 0
            warn "the machine that runs the workspaces did not take the read token,
    so a read from a workspace answers 401 until it does. './setup' converges it
    (the vmtools stage on macOS, sdk on Linux); start that machine and re-run it."
        }

        case "$_flag" in
            --replace)
                [ -n "$(wk_github_pat)" ] \
                    || die "there is no GitHub token here to replace ($(wk_github_pat_path)).
    'wk key set github-pat' asks for one."
                rm -f "$(wk_github_pat_path)"
                _deliver_read_pat
                info "removed the old token -- revoke it on GitHub too if it is still live"
                ;;
            "") ;;
            *) die "$USAGE" ;;
        esac

        if [ -n "$(wk_github_pat)" ]; then
            info "github-pat: present ($(wk_github_pat_path))"
            log  "  the injector reads GitHub with it whatever position 'wk push' is in;"
            log  "  a write spends it only while 'wk push on'"
            log  "  no workspace ever holds it: the injector puts it in the Authorization"
            log  "  header, and the workspace sends a placeholder ('wk verify' measures that)"
            log  "  whether GitHub still accepts it is not checkable without spending a"
            log  "  request; 'git-webkit pr' answering 401 is the evidence that it does not"
            log  "  'wk key set github-pat --replace' rotates it"
            exit 0
        fi

        _val=$(prompt_secret_value \
            "a GitHub personal access token, so 'git-webkit pr' in a workspace can open a pull request" \
            "github.com/settings/tokens: a classic token with the 'repo' scope, or a fine-grained one with Contents and Pull requests on $(wk_push_forks | awk 'NF {printf "%s ", $2}')") || _val=""
        [ -n "$_val" ] || die "nothing stored, so 'git-webkit pr' in a workspace gets 401.
    To store one:  wk key set github-pat"

        ensure_dir "$(wk_push_held_dir)" 0700
        # Down a pipe into a file this shell creates under umask 077, never as
        # an argument: an argument is in `ps` for everyone on the machine.
        ( umask 077; printf '%s\n' "$_val" > "$(wk_github_pat_path)" ) \
            || die "could not write $(wk_github_pat_path)"
        unset _val
        _deliver_read_pat
        info "stored -- a workspace can read GitHub with it now, and 'wk push on'
    is what lets one write; no workspace ever holds it"
        exit 0
    fi

    wk_agent_secret_known "$_name" \
        || die "there is no agent credential called '$_name'.
    This checkout knows: $(wk_agent_secret_names | tr '\n' ' ')github-pat
    Each but the last is a row in wk_agent_secrets (lib/store.sh), which is
    also what delivers it to a workspace and names the variable its agent
    reads; github-pat is the one that never enters a workspace at all."

    # What the person is being asked for, and how a person gets one: the whole of
    # what differs per name.
    case "$_name" in
        claude)
            _what="a Claude Code token, so a workspace starts authenticated instead of asking for /login"
            _how="run 'claude setup-token' here and paste what it prints"
            ;;
        litellm)
            _what="your LiteLLM API key, so 'wk ai pi' in a workspace can reach that endpoint"
            _how="a virtual key from your own LiteLLM deployment (its web UI, or POST /key/generate)"
            ;;
        claude-login)
            _what="your claude.ai login credential, so remote control works in a workspace"
            _how="run 'claude auth login' here; this reads what it stored, nothing is pasted"
            ;;
    esac

    case "$_flag" in
        --replace)
            wk_agent_secret_present "$_name" \
                || die "there is no $_name credential here to replace ($(wk_agent_secret_path "$_name")).
    'wk key set $_name' asks for one."
            # Cleared before asking, so an abandoned replace leaves nothing behind.
            wk_agent_secret_clear "$_name"
            info "removed the old $_name credential -- revoke it too if it is still live"
            ;;
        "") ;;
        *) die "$USAGE" ;;
    esac

    if wk_agent_secret_present "$_name"; then
        info "$_name: present ($(wk_agent_secret_path "$_name"))"
        if [ "$(wk_agent_secret_kind "$_name")" = file ]; then
            log  "  $(wk_agent_secret_bytes "$_name" | _claude_login_check \
                      | sed 's/^ok:/scopes: /; s/^bad:/UNUSABLE: /')"
        else
            log  "  every workspace this machine makes gets it as \$$(wk_agent_secret_field "$_name" 4)"
        fi
        case "$_name" in
            claude)
                log  "    a container reads it live from the read-only /secrets mount"
                log  "    a macOS guest and a build box are handed a copy at start"
                log  "  whether it still works is not checkable from here -- only Claude"
                log  "  can say, and asking would spend a request. A workspace reporting"
                log  "  'Not logged in' is the evidence that it does not."
                ;;
            litellm)
                log  "    a container reads it live from the read-only /secrets mount"
                log  "    (a macOS guest and a build box carry the Claude token only)"
                log  "  pi finds the endpoint itself in ~/.pi/agent/models.json, whose"
                log  "  apiKey is the string \$LITELLM_API_KEY -- so the key is in one"
                log  "  place and the URL and model list are in that file. 'wk ai pi'"
                log  "  prints the file to write when a workspace has none."
                ;;
            claude-login)
                log  "    one shared file, not a copy each: every container on this"
                log  "    machine reads and rewrites it. A macOS guest is never given"
                log  "    a copy -- a refresh in one would invalidate this file -- so"
                log  "    it runs 'claude auth login' in there for itself, once."
                ;;
        esac
        log  "  'wk key set $_name --replace' rotates it"
        exit 0
    fi

    # A value row is pasted; a file row is read out of where its own tool keeps it
    # and checked before it is believed. Both go to the store down a pipe, never as
    # an argument. The file row goes in byte for byte -- its tool parses it.
    if [ "$(wk_agent_secret_kind "$_name")" = file ]; then
        _claude_login_refuse_relocated_store
        _val=$(_claude_login_read)
        [ -n "$_val" ] || die "there is no claude.ai login on this machine to read.
    $_how
    Then:  wk key set $_name"
        _verdict=$(printf '%s' "$_val" | _claude_login_check)
        case "$_verdict" in
            ok:*) ;;
            *) unset _val
               die "what this machine holds is not a login credential an agent can spend:
    ${_verdict#bad:}
    Remote control refuses anything but a full-scope login, so nothing was
    stored. $_how" ;;
        esac
        printf '%s' "$_val" | wk_agent_secret_store "$_name" \
            || die "could not write $(wk_agent_secret_path "$_name")"
        unset _val
        info "stored -- scopes: ${_verdict#ok:}"
        log  "  every workspace this machine makes can use it; the ones that"
        log  "  already exist pick it up on their next 'wk start'"
        unset _verdict
    else
        _val=$(prompt_secret_value "$_what" "$_how") || _val=""
        [ -n "$_val" ] || die "nothing stored for '$_name', so no workspace has it.
    To store one:  wk key set $_name"
        printf '%s\n' "$_val" | wk_agent_secret_store "$_name" \
            || die "could not write $(wk_agent_secret_path "$_name")"
        unset _val
        info "stored -- every workspace made from now on has \$$(wk_agent_secret_field "$_name" 4)"
        log  "  the ones that already exist pick it up on their next 'wk start'"
    fi
    ;;

# The tailnet API access token: what retires a fleet node whose name a new card
# needs. Host-local like the auth key, and unlike it never seeded onto a card --
# it administers the whole tailnet (wk_tailscale_key_reject).
tailnet-api)
    [ -z "${3:-}" ] || die "$USAGE"
    _tsapi=$(wk_tailscale_api_path)
    case "${2:-}" in
        --replace)
            wk_tailscale_api_present \
                || die "there is no tailnet API token here to replace ($_tsapi).
    'wk key tailnet-api' asks for one."
            rm -f "$_tsapi"
            info "removed the old token; nothing on the tailnet is affected"
            ;;
        "") ;;
        *) die "$USAGE" ;;
    esac

    if wk_tailscale_api_present; then
        info "tailnet API token: present ($_tsapi)"
        log  "  starts $(head -c 10 "$_tsapi")…, mode $(file_mode "$_tsapi")"
        # Presence is not usability, and this is the one place a person is looking
        # at the credential: ask the tailnet.
        if _out=$(WK_TS_API_SECRET_FILE="$_tsapi" python3 "$WK_ROOT/lib/tailnet.py" check 2>&1); then
            log  "  $_out"
        else
            warn "  $_out"
            log  "  'wk key tailnet-api --replace' rotates it"
            exit 1
        fi
        log  "  'wk key tailnet-api --replace' rotates it"
        exit 0
    fi

    if wk_tailscale_api_key >/dev/null; then
        info "stored -- a write that needs a stale fleet node retired can now do it itself"
        exit 0
    fi
    die "no tailnet API token, so retiring a stale fleet node is a person's job at
    https://login.tailscale.com/admin/machines -- a hand step in the middle of a
    lane built to be repeatable (CLAUDE.md, 'Cattle, not pets').
    Make one (tag:wk devices scope is enough):
        https://login.tailscale.com/admin/settings/keys"
    ;;

# The fleet's tailnet auth key. Host-local, and deliberately not in the VM with
# the deploy keys: the machine that writes a card is the machine that needs it.
tailnet)
    [ -z "${3:-}" ] || die "$USAGE"
    _tspath=$(wk_tailscale_authkey_path)
    case "${2:-}" in
        --replace)
            wk_tailscale_authkey_present \
                || die "there is no tailnet key here to replace ($_tspath).
    'wk key tailnet' asks for one."
            # Removed before asking: prompt_secret returns an existing file
            # untouched, so a replace that did not clear first would change nothing.
            rm -f "$_tspath"
            info "removed the old key; the nodes already on the tailnet are unaffected"
            log  "  a tagged node does not key-expire, so rotating this costs nothing"
            ;;
        "") ;;
        *) die "$USAGE" ;;
    esac

    if wk_tailscale_authkey_present; then
        info "tailnet auth key: present ($_tspath)"
        log  "  starts $(head -c 16 "$_tspath")…, mode $(file_mode "$_tspath")"
        # Split into what this can prove and what it cannot: the scope is readable
        # from the key, everything else lives in the admin console behind a
        # credential this machine must not hold.
        log  "  checked here: it is an auth key (tskey-auth-), so it can enroll a"
        log  "                node and nothing else -- not an API token or an OAuth"
        log  "                client secret, either of which could administer the tailnet"
        log  "  NOT checkable from the key, and worth a look in the console:"
        log  "                tagged tag:wk, reusable, NOT ephemeral, longest expiry"
        log  "                https://login.tailscale.com/admin/settings/keys"
        log  "  'wk key tailnet --replace' rotates it"
        exit 0
    fi

    if wk_tailscale_authkey >/dev/null; then
        info "stored -- 'wk sysimage write' will seed it onto the cards it writes"
        exit 0
    fi
    die "no tailnet auth key, so a card written now would boot with no tailnet
    identity -- reachable only over whatever LAN it lands on, which is the state
    the fleet rule exists to end (CLAUDE.md, 'Cattle, not pets').
    It must be tagged tag:wk, reusable and NOT ephemeral, longest expiry:
        https://login.tailscale.com/admin/settings/keys
    Then run this again, from a terminal."
    ;;

# What a workstation reads over ssh when registering this machine's key; `show`
# is the human version.
pub)
    remote="${2:-}"
    [ -n "$remote" ] || die "$USAGE"
    [ -z "${3:-}" ] || die "$USAGE"
    out=$(pub_of "$remote")
    [ -n "$out" ] || exit 1
    printf '%s\n' "$out"
    ;;

# Printed raw for a caller to interpret: only the workstation has `gh`, and only
# the machine with the key can offer it.
sshtest)
    remote="${2:-}"
    [ -n "$remote" ] || die "$USAGE"
    [ -z "${3:-}" ] || die "$USAGE"
    priv=$(priv_of "$remote")
    [ -n "$priv" ] || { echo "no key"; exit 1; }
    case "$priv" in */push-keys/*) echo "push is off"; exit 3 ;; esac
    ssh -o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes \
        -o BatchMode=yes -i "$priv" \
        -T git@github.com 2>&1 </dev/null || true
    ;;

# The keys this machine holds, one per line, with the fingerprint that identifies
# them on GitHub and where they currently are, for `wk status`:
#
#   fork     SHA256:…  allowed
#   forkwpe  SHA256:…  held
fingerprints)
    [ -z "${2:-}" ] || die "$USAGE"
    wk_push_forks | while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        pub=$(pub_of "$remote")
        [ -n "$pub" ] || { printf '%-9s %-50s %s\n' "$remote" "-" "no key"; continue; }
        fp=$(printf '%s\n' "$pub" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')
        # A private half is always in the one directory nothing mounts, so where
        # it is says nothing about the switch. Whether a push works is `wk push
        # status`.
        priv=$(priv_of "$remote")
        [ -n "$priv" ] && state="private half here ('wk push status')" \
                       || state="no private half"
        printf '%-9s %-50s %s\n' "$remote" "${fp:-unreadable}" "$state"
    done
    ;;

show)
    [ -z "${2:-}" ] || die "$USAGE"
    wk_push_forks | while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        printf '# %s\n%s\n' "$repo" "$(pub_of "$remote")"
    done
    ;;

register)
    [ -z "${2:-}" ] || die "$USAGE"
    failed=0
    for machine in $(key_machines); do
        label=$(m_label "$machine")
        info "keys for $label"
        m_ensure "$machine"

    while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        pub=$(m_pub "$machine" "$remote")
        [ -n "$pub" ] || { warn "no key for $repo on $label"; failed=1; continue; }

        # The machine's name: a deploy-key list on GitHub with three identical
        # titles cannot be revoked selectively.
        title="wk build key ($label)"

        # Already registered? Compare the key body, ignoring title and comment.
        body=$(printf '%s' "$pub" | awk '{print $1" "$2}')
        if gh api "repos/$repo/keys" --jq '.[].key' </dev/null 2>/dev/null \
             | awk '{print $1" "$2}' | grep -qxF "$body"; then
            unchanged "$repo: $label's key already registered"
            continue
        fi

        info "registering $label's deploy key on $repo"
        # read_only=false: a key registered read-only looks fine until the first
        # push fails.
        if gh api "repos/$repo/keys" \
             -f "title=$title" \
             -f "key=$pub" \
             -F read_only=false </dev/null >/dev/null 2>&1; then
            changed "$repo: $label's deploy key registered with write access"
        else
            warn "$repo: could not register $label's key automatically"
            log  "  add it by hand at https://github.com/$repo/settings/keys/new"
            log  "  (tick 'Allow write access')"
            printf '%s\n' "$pub"
            failed=1
        fi
    done <<EOF
$(wk_push_forks)
EOF
    done

    echo >&2
    "$0" check
    ;;

check)
    [ -z "${2:-}" ] || die "$USAGE"
    # ssh answers "is this key registered and scoped to the right repo?" -- a
    # deploy key replies "Hi owner/repo!", a user key replies without a repo. It
    # says nothing about write access, so that comes from the API.
    rc=0
    for machine in $(key_machines); do
      label=$(m_label "$machine")
      section_printed=""
      while read -r remote repo alias; do
        [ -n "$remote" ] || continue
        [ -n "$section_printed" ] || { printf '  %s\n' "$label:"; section_printed=1; }
        printf '    %-28s ' "$repo"
        pub=$(m_pub "$machine" "$remote")
        [ -n "$pub" ] || { echo "no key -- run: wk key register"; rc=1; continue; }

        # The ssh half runs on the machine that holds the key -- the only one that
        # can offer it -- and the answer comes back here, where `gh` is.
        out=$(m_sshtest "$machine" "$remote")
        case "$out" in
            "push is off"*)
                echo "registered, but push is OFF there -- 'wk push on' allows it"
                continue ;;
            "no key"*)
                echo "no key -- run: wk key register"; rc=1; continue ;;
        esac

        case "$out" in
            *"Hi $repo!"*) ;;
            *"Permission denied"*) echo "not registered on $repo"; rc=1; continue ;;
            *"successfully authenticated"*)
                echo "authenticates, but not scoped to $repo"; rc=1; continue ;;
            *) echo "unexpected: $(printf '%s' "$out" | head -1)"; rc=1; continue ;;
        esac

        # Matched on the base64 body, which is unique and jq-safe. `|| ro=""` keeps
        # this a report: under `set -o pipefail` a refused API call would end the
        # whole command mid-line, leaving every fork after this unreported.
        b64=$(printf '%s' "$pub" | awk '{print $2}')
        ro=$(gh api "repos/$repo/keys" </dev/null 2>/dev/null \
             --jq ".[] | select(.key | contains(\"$b64\")) | .read_only" | head -1) || ro=""
        case "$ro" in
            false) echo "ok (write)" ;;
            true)  echo "READ-ONLY -- delete it on GitHub and re-run 'wk key register'"; rc=1 ;;
            *)     echo "registered, but gh could not read $repo's key list, so write access is unconfirmed"; rc=1 ;;
        esac
      done <<EOF
$(wk_push_forks)
EOF
    done
    exit $rc
    ;;

*)
    die "$USAGE"
    ;;
esac
