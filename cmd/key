#!/usr/bin/env python3
#
# wk key check|setup|set|deploy|show|ensure|push|sudo|backup -- the credentials this machine holds, whether a workspace can push, its sudo policy and its settings backup
# wk: where=host name=none group=sources needs gh,gh-auth takes=1 default=check verbs=check,setup,deploy,show,ensure,pub,sshtest,fingerprints,set,adopt,verdict,give,push,sudo,backup destructive setup,deploy,--replace dryrun setup,deploy,set,sudo,ensure,adopt,backup readonly check,show,pub,sshtest,fingerprints,verdict,give
# wk: sub show,ensure,pub,sshtest,fingerprints,set,adopt,verdict,give,sudo,backup needs=
# wk: sub set,pub,sshtest,adopt,verdict,give takes=2
# wk: sub set opts=--replace,--paste
# wk: sub deploy,setup opts=--rotate
# wk: sub sudo takes=2 opts=--target=,--all destructive=
# wk: sub backup opts=--candidates
# wk: sub push where=local takes=2 needs= opts=--target=,--all destructive=on dryrun=yes
#
#   wk key setup      every credential this machine needs, and one working
#                     credential of each kind on every workstation. The one
#                     command a new machine needs, and the one that keeps the
#                     fleet holding the same keys:
#                       the deploy keys and every credential are elected.
#                       Every workstation is asked what it
#                       holds and whether its issuer still accepts it, at that
#                       moment, and the best working answer wins -- age counts
#                       for nothing. The winner is put on every workstation
#                       holding a different one, and a tie goes to this machine,
#                       so a fleet that already agrees is left alone.
#                       When no workstation holds one that works, this machine
#                       mints or is asked for one, and that one is fanned out.
#                     A build machine is sent nothing: it keeps no credential at
#                     rest and reaches the elected deploy key through an
#                     ssh-agent forwarded from whoever drives the push. One line
#                     per credential -- stored, minted, taken, skipped or
#                     refused -- and then `wk key check`'s table. It overwrites
#                     what the other workstations hold, so it asks once, first,
#                     and it can be killed and re-run
#                       --rotate  turn every credential over rather than elect
#                                 one: the deploy keys as `wk key deploy
#                                 --rotate` does, then each stored credential
#                                 replaced as `wk key set <name> --replace`
#                                 does, and the fresh ones fanned out
#   wk key set <name> [--replace] [--paste]
#                     one credential by name, or the report on it when it is
#                     already here.
#                       --replace  rotate it: the old one is removed first
#                       --paste    take the value on stdin instead of minting
#                                  one, so a second machine can hold the same
#                                  minted credential as the first
#                     <name> is a row of lib/credcheck.py:
#
#                       github-pat    what `git-webkit pr` opens a pull request
#                                     with. Never enters a workspace: only the credential
#                                     injector reads it, which reads GitHub
#                                     with it whatever position `wk key push` is in
#                                     and writes only while it is on. A classic
#                                     token with 'public_repo': a fine-grained
#                                     one opens a pull request on every fork and
#                                     on no project, because it reaches only
#                                     repositories this account owns. Refused
#                                     unless it can open one on each fork and on
#                                     the project that fork belongs to, each
#                                     asked with the write itself. Rotating it
#                                     while `wk key push` is on hands the new one
#                                     straight to the injector
#                       bugzilla-api-key
#                                     what `git-webkit pr` files and updates the
#                                     bug with. Never enters a workspace either:
#                                     the injector adds it to every
#                                     bugs.webkit.org request while `wk key push` is
#                                     on and to none while it is off. Judged as
#                                     the login WebKit's contributors.json gives
#                                     this GitHub account
#                       claude        the Claude Code token a build box's agent
#                                     starts authenticated with (`claude
#                                     setup-token` prints one); inference only
#                       litellm       the API key `wk ai pi` reaches your
#                                     LiteLLM endpoint with
#                       tailnet       the fleet's tailnet auth key, seeded onto
#                                     every card written here
#                       tailnet-api   the tailnet API token a workstation
#                                     retires a stale fleet node with; never
#                                     written to a card
#                       ntfy          the ntfy.sh topic lib/wk/notify.py publishes to
#                                     to, so the fleet can tell you it wants
#                                     you. Minted here, never invented: the
#                                     topic name is the whole credential, so it
#                                     is printed as it is minted and by `wk key
#                                     show`, and never written to a card or held
#                                     by a workspace
#
#   wk key deploy     the deploy keys alone, elected and converged the way
#                     `setup` does them: the key each fork's repository accepts
#                     wins, it is registered on GitHub with write access under a
#                     single title, and every workstation holding a different
#                     one takes it. --rotate removes the old keys from GitHub
#                     and mints fresh ones instead of electing. Asks once, first
#   wk key check      what every credential this machine holds can do and how
#                     far it reaches and what each other workstation holds of
#                     each of them -- every line asked again at that moment.
#                     One row each: a state, the name, and what its issuer
#                     just said; a workstation holding the same credential as
#                     this one says so rather than repeating its reach.
#                     Anything that needs doing ends up under `needs you:`, the
#                     command to type first and where to get what it wants
#                     second. Read-only, and what a bare `wk key` runs
#   wk key show       print the public halves, and the ntfy topic URL to point a
#                     phone at
#   wk key ensure     create missing push keys without registering them
#   wk key push [on|off|status] [--target <machine>|--all] [--force]
#                     whether a workspace can push to git at all (`status`,
#                     the default, asks). Only the person at the keyboard
#                     pushes: an agent in a workspace cannot publish anything,
#                     while a shell there run by a human pushes normally. It is
#                     a switch over credentials nothing in a workspace ever
#                     holds: the deploy keys sit in an ssh-agent outside it, the
#                     GitHub token and the Bugzilla key in the injector that
#                     terminates TLS for api.github.com and bugs.webkit.org
#                     (README.md has the mechanism).
#                       on     the keys are in the agent and the token and the
#                              Bugzilla key where the injector reads them:
#                              `git push` and `git-webkit pr` work, the bug
#                              included. A claude session in any workspace
#                              would be handed that push, so `on` asks once and
#                              ends every one of them
#                       off    `ssh-add -D` empties the agent and both files go:
#                              ssh has no identity to offer, and the injector
#                              refuses a write with a 412 naming this switch
#                     `status` asks the agent what it holds (`ssh-add -l`) and
#                     the machine whether the credential files are there; there
#                     is no state file. A machine runs an agent per kind of
#                     workspace -- one in the podman machine the containers
#                     mount its socket from, and on macOS one here for the
#                     guests, reached through a forward (lib/wk/guest.py). `on`
#                     and `off` switch every one or name the one they could not
#                     reach; `status` says ON while any holds a key. It runs on
#                     this machine (where=local), a build box included, and
#                     `wk ai claude` turns it off before handing over control.
#                       --target <machine>   ask that fleet machine, through its
#                                            own wk. A build box holds no deploy
#                                            key (`wk enter` forwards this
#                                            machine's agent), so it reports off
#                       --all                this machine and every other one
#                                            (wk boot --list names them)
#                       --force              `on` leaves a running claude session
#                                            alone; it can push until it exits
#                     Exit: 0 on (status) or done; 1 off (status) or failed, or
#                     a build box with no key at rest; 3 a machine did not
#                     answer, so its position is unknown -- never "off" (in the
#                     podman machine, `on`/`off` switched its half and not the
#                     host's guests'); 4 no deploy keys here at all; 5 no
#                     switch here: no key, or one live at rest
#   wk key sudo [status|setup] [--target <t>|--all]
#                     make root cost a password, on a short leash: no blanket
#                     NOPASSWD, and a 30-second cached-credential window
#                     (WK_SUDO_TIMEOUT_MIN, in minutes), from one drop-in,
#                     /etc/sudoers.d/zz-<user>-passwd, which sudoers' last-match
#                     rule lets override an earlier NOPASSWD without touching a
#                     file the sysadmins own. `status` (the default) says what
#                     this machine does today. `setup` installs the drop-in and
#                     asks for your password: it never edits or removes an
#                     existing file, validates with `visudo -c` before and after
#                     installing, then clears the timestamp and checks that sudo
#                     asks. Exits 0 when a password is required and the window
#                     is 30 seconds or less, 1 otherwise
#                       --target <t>  the same, on a configured machine
#                       --all         every configured machine's, and this
#                                     one's status
#   wk key backup [--candidates]
#                     write this host's live desktop settings back into the
#                     repo, the inverse of ./setup: on macOS
#                     host/macos/defaults.conf (refreshed value by value,
#                     comments and ordering kept) and
#                     host/macos/symbolichotkeys.plist; on Linux
#                     host/linux/config.dconf, filtered of machine-specific and
#                     secret entries, its leading comment block kept. Only
#                     deliberate choices are captured, never a credential. Each
#                     write is a tmp file beside the target, then `mv`
#                       --candidates  macOS only, read-only: every `defaults`
#                                     value that differs from Apple's default
#                                     and is not in defaults.conf yet, minus
#                                     window positions, timestamps, UUIDs and
#                                     other per-run noise, as "domain key
#                                     value", for a maintainer to decide on
#
# One key per fork, the same on every workstation and shared by every workspace:
# GitHub deploy keys are scoped to a single repository and refuse the same key on
# a second one, so a compromised workspace can push to the forks in secrets.FORKS
# and nowhere else. The one key per fork is registered once and held on every
# workstation. Which key that is, and which of every other credential the fleet
# holds, is decided by evidence taken at that moment rather than by where one
# was last stored: 'wk key setup' asks every workstation what it holds
# and whether its issuer still accepts it, and the best working answer is put
# everywhere. Rotating ('wk key setup --rotate', or 'wk key deploy --rotate' for
# the keys alone) turns the whole fleet over from one command.
#
# A shared build machine holds no key at all: it reaches the deploy key through
# an ssh-agent forwarded from the workstation that drives it, so nothing private
# rests on a machine other people are root on (remote/provision.sh, lib/wk/targets.py's Remote).
# Registration goes through the GitHub API, which takes the title, key and
# read_only=false directly.
#
# The rest are meant for another machine to call over the tailnet, or for `wk
# status`, rather than to type by hand:
#
#   wk key pub <fork>        print that fork's public key
#   wk key sshtest <fork>    does that fork's key authenticate, and as what
#   wk key fingerprints      every key here, its fingerprint and its state
#   wk key verdict <name>    one stored credential's verdict and detail, as
#                            `check` prints them, on one tab-separated line,
#                            with the fingerprint an election compares
#   wk key adopt <fork>      take a shared deploy key's private half on stdin
#   wk key give <fork>|<name>
#                            print that credential, for the workstation running
#                            `wk key setup` to take -- the other half of
#                            `adopt`
#
# <fork> is one of the short names in lib/wk/secrets.py's FORKS.
#
# Every credential is put to a rule before it is stored, and to the same rule
# again whenever one is reported (`wk key check`, `wk doctor`): the rules are
# lib/credcheck.py, one row each, and that row is also what a prompt here asks
# for and where it sends you to mint one. One that cannot do its job is refused
# and nothing is stored; one that reaches further than wk spends it is kept with
# that reach named; one no network could be reached to judge is kept and
# reported unverified.
#
# Runs on the machine that holds the keys: the keyring is this device's
# (Store.keyring_dir), and on macOS the podman machine reads it as a mount, so every
# subverb here is ssh-keygen, a file and `gh`, with no VM in the path.
#
# `setup`, `deploy` and `check` are the only ones that call the GitHub API, which
# is why the rest clear `needs`: that is what lets `wk key ensure` run over ssh
# on a build machine with no `gh` on it, and `wk key set tailnet` store a key on
# a machine whose gh login has expired.

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images  # noqa: E402

ROOT = images.root()

from wk import backup, decl, pushswitch, sudo  # noqa: E402
from wk.key import cli  # noqa: E402
from wk.act import Refused  # noqa: E402
from wk.clock import Clock  # noqa: E402
from wk.machine import Local, is_macos  # noqa: E402
from wk.targets import Registry  # noqa: E402


def push_target(args):
    """The last of --target <machine> and --all as typed, or ""."""
    named = {"--all": "--all" if args.flag("--all") else None, "--target": args.value("--target")}
    target = ""
    for opt in args.order:
        if named.get(opt) is not None:
            target = named[opt]
    return target


def main(argv, env=None, reg=None, machine=None, macos=None, clock=None, out=None):
    args = decl.Args(decl.Decl(__file__), argv)
    words = args.positionals
    verb = words[0]
    if verb == "push":
        return pushswitch.main(ROOT, words[1:], push_target(args), reg or Registry(ROOT, os.environ if env is None else env),
                               clock or Clock(), out)
    if verb == "sudo":
        return sudo.main(words[1:], args.value("--target"), args.flag("--all"),
                         reg or Registry(ROOT, os.environ if env is None else env, Local()), env=env)
    if verb == "backup":
        return backup.main(ROOT, args.flag("--candidates"), machine or Local(), is_macos() if macos is None else macos)
    return cli.main(ROOT, verb, words[1] if len(words) > 1 else "", rotate=args.flag("--rotate"),
                    replace=args.flag("--replace"), paste=args.flag("--paste"))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
