#!/usr/bin/env bash
#
# wk verify <workspace> -- prove the sandbox is what it claims to be
# wk: where=workspace name=required ready=yes outside group=workspaces
#
# Refused inside a workspace: a workspace cannot certify its own sandbox,
# and half the properties below are only visible from the host.
#
# Every property here is checked by testing it from inside the workspace,
# not by reading the config that was supposed to produce it: a firewall
# that failed to load, a hand-recreated container, or a dead proxy all look
# fine from the host's config and all fail open.
#
#   0  every check passed
#   1  a check failed -- the sandbox is not intact
#
#   --gpu   fail if there is no hardware-accelerated GPU (informational otherwise)
#
# `wk ai claude` runs this before handing over control, because relaxed permissions
# are only defensible while these hold.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/arch.sh"

NAME="${WK_NAME:-}"
require_name "$NAME"

WANT_GPU=""
case "${1:-}" in
    "") ;;
    --gpu) WANT_GPU=1 ;;
    *) die "usage: wk verify <workspace> [--gpu]; see wk verify -h" ;;
esac
[ $# -le 1 ] || die "usage: wk verify <workspace> [--gpu]; see wk verify -h"

# Resolved from the registry: a fixed default would load the container
# driver for a vm workspace and report "no such workspace" about one that exists.
TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

[ "$(t_info "$NAME")" != absent ] || die "no such workspace: $NAME"

# A remote target claims none of the container properties checked below.
# Running the checks would report failure against promises never made.
if [ "$WK_TARGET_KIND" = remote ]; then
    die "'wk verify' proves a sandbox holds, and a remote target has none:
    a plain checkout on a shared machine, no container, no firewall, no
    disposable layer. There is nothing here to measure and nothing it
    promised. 'wk ai claude' refuses on this target for the same reason."
fi

# The vm target's egress boundary is Softnet on the host rather than any
# container property, so the block guarded by $WK_SANDBOX below does not apply
# to a guest. The credential checks do, and are measured the same way in both:
# from inside, over t_exec.
# TODO: measure the guest's *egress* from inside it; `wk ai claude` carries the
# vm-side network checks for now.
if [ "$WK_TARGET_KIND" = vm ]; then
    warn "a guest's egress filter is Softnet on the host (checked by wk ai claude);
  what runs here is the credential and GPU checks, not the network ones."
fi

fails=0
pass() { printf '  \033[32mok\033[0m    %s\n' "$*" >&2; }
fail() { printf '  \033[31mFAIL\033[0m  %s\n' "$*" >&2; fails=$((fails + 1)); }
note() { printf '        %s\n' "$*" >&2; }

inside() { t_exec "$NAME" bash -lc "$*" 2>/dev/null || true; }   # never fails the script

info "verifying workspace '$NAME' (${WK_SANDBOX:-$TARGET})"

# --- the container is running ------------------------------------------------
state=$(t_info "$NAME")
[ "$state" = running ] && pass "container running" || fail "container state: $state"

if [ "${WK_SANDBOX:-}" = rootless-proxy ]; then
    # --- no privilege ---------------------------------------------------------
    # A rootful container would mean a container escape is a root escape.
    # Captured rather than piped into `grep -q`: under `set -o pipefail` a
    # `grep -q` that exits early makes the whole pipeline report failure.
    rootless=$(_hpodman info --format '{{.Host.Security.Rootless}}' 2>/dev/null || echo unknown)
    if [ "$rootless" = true ]; then
        pass "podman is rootless"
    else
        fail "podman is NOT rootless -- an escape from this container is an escape as root"
    fi

    # --- no network interface -------------------------------------------------
    # /proc/net/dev rather than `ip`: iproute2 is not in the SDK image, and a
    # missing-tool false pass would fail in the direction that looks fine.
    ifaces=$(inside "awk -F: 'NR>2 {gsub(/ /,\"\",\$1); printf \"%s \", \$1}' /proc/net/dev")
    case "$(echo "$ifaces" | tr -d ' ')" in
        lo) pass "no network interface but loopback ($ifaces)" ;;
        "") fail "could not enumerate interfaces inside the workspace" ;;
        *)  fail "workspace has network interfaces: $ifaces" ;;
    esac

    # --- the proxy is up ------------------------------------------------------
    if systemctl --user is-active --quiet wk-proxy.service; then
        pass "egress proxy running"
    else
        fail "egress proxy is not running (systemctl --user status wk-proxy)"
    fi

    # --- egress, measured -----------------------------------------------------
    # Allowed: the API the agent needs. Denied: a host off the list, and the
    # local network. Direct: with the proxy bypassed there must be no path at all.
    code=$(inside "curl -sS -m 20 -o /dev/null -w '%{http_code}' https://github.com/ 2>/dev/null")
    [ "$code" = 200 ] && pass "github reachable through the proxy (HTTP $code)" \
                      || fail "github unreachable through the proxy (got '${code:-nothing}')"

    denied=$(inside "curl -sS -m 15 -o /dev/null https://example.com/ 2>&1")
    if printf '%s' "$denied" | grep -qi '403'; then
        pass "a host outside the allowlist is refused"
    else
        fail "example.com was NOT refused -- the allowlist is not being enforced"
    fi

    lan=$(inside "curl -sS -m 10 -o /dev/null -w '%{http_code}' http://192.168.1.1/ 2>&1 | tail -1")
    case "$lan" in
        *403*|*000*|*"Received HTTP code 403"*) pass "the local network is refused" ;;
        *) fail "reaching the LAN gateway returned '$lan'" ;;
    esac

    direct=$(inside "curl -sS --noproxy '*' -m 8 -o /dev/null -w '%{http_code}' https://1.1.1.1/ 2>&1 | tail -1")
    case "$direct" in
        *000*|*"Could not resolve"*|*"Failed to connect"*|*"Network is unreachable"*|"")
            pass "no direct egress with the proxy bypassed" ;;
        *)  fail "direct egress succeeded, bypassing the proxy: '$direct'" ;;
    esac

    # --- no host filesystem ---------------------------------------------------
    # wkdev mounts the host home at /host/home and the runtime directory
    # (session D-Bus socket included) at /host/run. --isolated turns both
    # off; this confirms it rather than assuming it.
    for path in /host/home /host/run /run/user/*/bus /run/dbus/system_bus_socket; do
        found=$(inside "ls -d $path 2>/dev/null | head -1")
        if [ -n "$found" ]; then
            fail "host path visible inside the workspace: $found"
        fi
    done
    [ "$fails" -eq 0 ] && pass "no host home, runtime directory or D-Bus socket" || true

    # --- the commit wall works here ------------------------------------------
    # `wk ai claude` runs the agent under bwrap with the checkout's .git commit
    # parts read-only (WK_COMMIT_WALL_PATHS, lib/common.sh); this proves, in
    # this container, that the recipe blocks a commit and leaves an ordinary
    # write alone, against a throwaway repo in /tmp -- never the real checkout.
    # No bwrap here means `wk ai claude` refuses, so the sandbox is not whole.
    if inside "command -v bwrap >/dev/null 2>&1 && echo WKBWRAP" | grep -q WKBWRAP; then
        probe=$(inside 'set -e
            D=$(mktemp -d /tmp/wk-wall.XXXXXX); cd "$D"
            git init -q; git config user.email a@b; git config user.name a
            echo hi > f; git add f; git commit -qm one >/dev/null
            ro=""; for p in '"$WK_COMMIT_WALL_PATHS"'; do ro="$ro --ro-bind-try $D/.git/$p $D/.git/$p"; done
            W="bwrap --dev-bind / / $ro --"
            echo two >> f
            $W sh -c "git add f && git commit -qm two" >/dev/null 2>&1 && echo COMMITTED || echo BLOCKED
            $W sh -c "echo three >> f" >/dev/null 2>&1 && echo WROTE || echo NOWRITE
            rm -rf "$D"')
        if printf '%s' "$probe" | grep -q BLOCKED; then
            printf '%s' "$probe" | grep -q WROTE \
                && pass "commit wall blocks a commit; an ordinary write still works (bwrap)" \
                || fail "commit wall blocks an ordinary write too -- too much"
        else
            fail "commit wall did NOT block a commit under bwrap: '$(printf '%s' "$probe" | tr '\n' ' ')'"
        fi
    else
        fail "no bwrap in the workspace -- 'wk ai claude' cannot wall off commits and refuses to start"
    fi


    # --- the tooling tree is read-only ---------------------------------------
    probe_write=$(inside "touch /opt/wk-tools/.wk-write-probe 2>&1")
    if printf '%s' "$probe_write" | grep -qi 'read-only\|permission denied'; then
        pass "/opt/wk-tools is read-only"
    else
        inside "rm -f /opt/wk-tools/.wk-write-probe" >/dev/null
        fail "/opt/wk-tools is writable from inside the workspace"
    fi
fi

# --- what an agent in here can spend -----------------------------------------
# Informational, and deliberately not a `fail`: this reports the blast radius
# rather than the boundary. A workspace with the claude.ai login can act as
# the account -- that is what remote control needs and what an agent in here
# is being handed. Presence only: whether it still works is Anthropic's to
# say, and asking would spend a request.
if wk_agent_secret_present claude-login; then
    note "this workspace has your claude.ai login (account scope, not just inference)"
else
    note "no claude.ai login here -- 'wk key set claude-login' stores one, and"
    note "remote control refuses to start without it"
fi

# --- the two credentials, and that neither one is in here ---------------------
# An agent's blast radius ends at the workspace only if nothing inside it can
# publish. Two things could: an ssh key that pushes, and a GitHub API token
# that posts. Neither is a file in here at all -- the keys are in an ssh-agent
# outside the workspace (push_agent_*, lib/store.sh) and the token is in the
# injector (container/proxy/github-inject.py) -- so what is measured is that no
# key material is present, that the switch is where the host says it is, and
# that the workspace holds the placeholder rather than a token.
#
# Both targets. A container reaches the agent through a bind-mounted socket and
# a guest through an `ssh -R` forward, but every probe below is the same
# command run inside by t_exec.

# The host's own answer, once. Both positions are correct states -- what would
# be wrong is the workspace disagreeing with the host about which one it is in.
PUSH_ON=0
"$WK_ROOT/wk" push status >/dev/null 2>&1 && PUSH_ON=1
[ "$PUSH_ON" = 1 ] && note "the host says push is ON" || note "the host says push is OFF"

# Not the checkout: WebKit ships PEM test fixtures of its own, so a recursive
# grep there reports the upstream tree rather than this boundary. Home,
# /secrets and the socket directory are where a key delivered or copied by
# anything here would land.
material=$(inside "grep -rl 'PRIVATE KEY' \$HOME /secrets /run/wk 2>/dev/null | head -5")
if [ -z "$material" ]; then
    pass "no private key material in the workspace (home, /secrets, /run/wk)"
else
    fail "private key material inside the workspace: $(printf '%s' "$material" | tr '\n' ' ')"
fi

# The agent, asked from inside. The socket is there whichever way the switch is
# set -- the service owns it -- so what it *holds* is the question, and
# `ssh-add -l` is how a workspace would find out too.
agent_sock=$(t_agent_sock 2>/dev/null) || agent_sock=""
if [ -z "$agent_sock" ]; then
    fail "the '$TARGET' target names no ssh-agent socket (t_agent_sock), so a push
        from in here would use a credential wk does not control"
else
    # `command -v` first, for the reason the interface probe above gives: a
    # missing tool would answer "no identities" and fail in the direction that
    # looks fine.
    ident=$(inside "command -v ssh-add >/dev/null 2>&1 \
        && (SSH_AUTH_SOCK=$agent_sock ssh-add -l 2>/dev/null | grep -c . || true) \
        || echo MISSING")
    if [ "$ident" = MISSING ]; then
        fail "no ssh-add in the workspace, so what the agent holds cannot be measured
        from in here -- and a push from in here would not work either"
    elif [ "$PUSH_ON" = 1 ]; then
        [ "$ident" -gt 0 ] \
            && pass "$ident deploy key(s) reach this workspace through $agent_sock, and push is on" \
            || fail "push is ON but no identity reaches $agent_sock in here"
    else
        [ "$ident" = 0 ] \
            && pass "no identity reaches this workspace ($agent_sock is empty): a push is refused" \
            || fail "push is off, yet $ident identity/identities reach this workspace:  wk push off"
    fi
fi

# The API. Reaching it is the new state and is not itself a fault: the injector
# strips whatever the workspace sent, so an unauthenticated call is answered by
# GitHub exactly as it would be from anywhere.
code=$(inside "curl -sS -m 20 -o /dev/null -w '%{http_code}' https://api.github.com/ 2>/dev/null")
[ "$code" = 200 ] \
    && pass "api.github.com reachable through the injector (HTTP $code)" \
    || fail "api.github.com answered '${code:-nothing}' -- the injector is not in the path
        (systemctl --user status wk-github-inject; the CA is /run/wk/wk-github-ca.pem)"

# And the switch, measured on an endpoint that needs an account.
code=$(inside "curl -sS -m 20 -o /dev/null -w '%{http_code}' -H 'Authorization: Basic d2s6d2s=' https://api.github.com/user 2>/dev/null")
if [ "$PUSH_ON" = 1 ]; then
    [ "$code" = 200 ] \
        && pass "an authenticated API call succeeds (HTTP $code), and push is on" \
        || fail "push is ON but api.github.com/user answered '${code:-nothing}' -- 'wk key set github-pat'"
else
    [ "$code" = 401 ] \
        && pass "an authenticated API call is refused (HTTP 401): nothing in here can post" \
        || fail "push is off, yet api.github.com/user answered '${code:-nothing}' -- expected 401"
fi

# The placeholder, never its value: printing what the workspace holds would
# print a token on the one run where this check matters.
tok=$(inside 'printf %s "${GITHUB_COM_TOKEN:-}"')
case "$tok" in
    wk-injects-this) pass "GITHUB_COM_TOKEN in the workspace is the placeholder" ;;
    "")              fail "GITHUB_COM_TOKEN is unset in here, so 'git-webkit pr' has nothing to send
        ('wk push on' or 'wk push off' writes /secrets/github-user, which sets it)" ;;
    *)               fail "GITHUB_COM_TOKEN in the workspace is not the placeholder -- something
        put a real credential in here; find it and remove it" ;;
esac

ghcred=$(inside "test -e ~/.config/gh/hosts.yml && echo ~/.config/gh/hosts.yml; env | grep -E '^(GH_TOKEN|GITHUB_TOKEN|GH_ENTERPRISE_TOKEN)=' | cut -d= -f1")
[ -z "$ghcred" ] && pass "no gh credential inside (gh has nothing to post with)" \
                 || fail "GitHub credential inside the workspace: $ghcred -- remove it (rm ~/.config/gh/hosts.yml; unset the token) before an agent runs"

# `gh` authenticates with a token of its own and would bypass the injector
# entirely, so it must not be logged in -- whether or not it is installed.
ghauth=$(inside "command -v gh >/dev/null 2>&1 && (gh auth status >/dev/null 2>&1 && echo AUTHED || echo REFUSED) || echo ABSENT")
case "$ghauth" in
    ABSENT)  pass "gh is not installed in the workspace" ;;
    REFUSED) pass "gh is installed but not authenticated: it can post nothing" ;;
    *)       fail "gh IS authenticated inside the workspace -- it bypasses the injector:  gh auth logout" ;;
esac

# --- GPU ---------------------------------------------------------------------
# Informational unless --gpu (the benchmark runner's flag: a Speedometer or
# MotionMark number from llvmpipe is a different measurement, not a slow
# one). Probe exit status: 0 hardware, 1 software only, 2 no EGL, 3 build
# failed. Skipped on another architecture: the NVIDIA userspace is
# aarch64-only, and probing would just print Mesa errors about a device
# that was never there.
if ! arch_has_gpu "$(t_arch "$NAME")"; then
    note "no GPU: an $(t_arch "$NAME") workspace gets none (the NVIDIA userspace is aarch64-only)"
    [ -n "$WANT_GPU" ] && fail "--gpu on an $(t_arch "$NAME") workspace, which cannot have one"
else
    set +e
    probe=$(t_exec "$NAME" bash -lc "/opt/wk-tools/container/gpu/gpu-probe.sh" 2>&1)
    prc=$?
    set -e
    [ -n "$probe" ] && printf '%s\n' "$probe" | sed 's/^/        /' >&2

    case "$prc" in
        0) pass "GPU acceleration available" ;;
        1) [ -n "$WANT_GPU" ] && fail "only software rendering inside the workspace" \
                              || note "software rendering only -- benchmarks would measure llvmpipe" ;;
        *) [ -n "$WANT_GPU" ] && fail "no usable EGL inside the workspace (probe exit $prc)" \
                              || note "no usable EGL inside the workspace (probe exit $prc)" ;;
    esac
fi

echo >&2
if [ "$fails" -eq 0 ]; then
    info "sandbox intact"
    exit 0
fi
warn "$fails check(s) failed -- the sandbox is not intact"
exit 1
