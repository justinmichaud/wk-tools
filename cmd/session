#!/usr/bin/env bash
#
# wk session on [--bmc|--mirror] | gdm [--bmc|--mirror] | off | status -- a real graphical session for benchmark runs, or a real desktop, on real hardware
#
# wk: where=host name=none group=hosts needs quiesce-helper
# wk: sub status needs=
#
# GPU benchmarks need a real DRM session on real hardware: Speedometer and
# MotionMark under llvmpipe, or headless, are a different measurement.
#
#   on [--bmc]   the benchmark session: a single-client kiosk compositor
#                (cage), nothing else on seat0. A no-op if someone is already
#                logged in, or if the wanted mode is already running.
#                Unattended (nobody logged in) it stops the display manager
#                and starts cage; that is the only case needing privilege.
#                --mirror is an accepted synonym for --bmc.
#   gdm [--bmc]  a real, loggable-into desktop instead of a kiosk, for
#                debugging that needs more than one window.
#   off          the opposite of `on`/`gdm`: outputs modeset off (the CRTC
#                disabled, not painted black -- a compositor painting black
#                is still scanning out a lit signal) and a placeholder
#                compositor left holding the device (so the kernel's fbcon
#                can't repaint the now-masterless outputs on top). It does
#                not bring anything back -- `wk session gdm` does that.
#   status       unit, socket, display manager and DRM state, read without
#                privilege wherever possible.
#
# This machine has two DRM devices: the GPU, and the ASPEED BMC's display-only
# `ast` chip, served over KVM-over-IP. The default session names the GPU alone;
# --bmc moves the session onto the ast chip instead (software-rendered -- ast has
# no render node) and the monitor goes dark. The mode is in /run/wk-session-mode.
#
# cage takes its device from WLR_DRM_DEVICES; gdm's mutter has none, so `gdm
# --bmc` strips the GPU's seat-member udev tags instead. That only reaches a
# compositor taking devices from logind (Wayland) -- NVIDIA's Xorg driver uses
# /dev/nvidia* -- so both gdm modes force the greeter onto Wayland and check it.
#
# The compositor's Wayland socket is $XDG_RUNTIME_DIR/wk/display/wayland-0,
# separate from the user runtime directory so a workspace can be handed the
# socket without the session D-Bus socket next to it.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"

is_linux || die "wk session is Linux-only (macOS workspaces have no GPU to reach)"

PRIV=/usr/local/libexec/wk-quiesce-priv
ACTION="${1:-status}"
shift || true
BMC=""
while [ $# -gt 0 ]; do
    case "$1" in
        --bmc|--mirror) BMC=1; shift ;;
        *) die "usage: wk session on [--bmc] | gdm [--bmc] | off | status -- a real graphical session for benchmark runs, or a real desktop, on real hardware.; see wk session -h" ;;
    esac
done
# --bmc/--mirror only chooses a chip for 'on'/'gdm'; accepting it elsewhere and
# doing nothing would hide a typo'd invocation.
case "$ACTION" in
    off|status) [ -z "$BMC" ] || die "usage: wk session on [--bmc] | gdm [--bmc] | off | status; --bmc/--mirror only applies to 'on'/'gdm'; see wk session -h" ;;
esac

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wk/display"
SOCKET="$RUNTIME/wayland-0"

# `session-on-bmc` is *allowed* to fail, so whether sudo needs a password is
# asked once with a read-only verb rather than inferred from a verb that did
# something.
PRIV_SUDO=""
run_priv() {
    [ -x "$PRIV" ] || die "$PRIV is not installed -- run: ./setup --stage quiesce"
    if [ -z "$PRIV_SUDO" ]; then
        if sudo -n "$PRIV" session-status >/dev/null 2>&1; then
            PRIV_SUDO=-n
        else
            warn "passwordless sudo unavailable for the helper; re-run ./setup --stage quiesce"
            PRIV_SUDO=ask
        fi
    fi
    if [ "$PRIV_SUDO" = -n ]; then
        sudo -n "$PRIV" "$1"
    else
        sudo "$PRIV" "$1"
    fi
}

# --- which connector belongs to which chip -----------------------------------
# Not shared with the privileged helper: a root script sourcing a file from this
# user-writable checkout would be the escalation the arrangement avoids. The
# kernel driver is the discriminator, never the card number -- card1 is the ast
# here only because of PCI enumeration order.
drm_driver() {
    local link
    link=$(readlink -f "/sys/class/drm/$1/device/driver" 2>/dev/null) || true
    [ -n "$link" ] && basename "$link" || echo none
}

# Prints "NAME status" per connector. $1: ast, or not-ast for everything else.
_connectors() {
    local which="$1" card drv conn name
    for card in /sys/class/drm/card[0-9]*; do
        [ -d "$card" ] || continue
        card=$(basename "$card")
        # /sys/class/drm holds cardN and cardN-CONNECTOR-M side by side.
        case "$card" in *-*) continue ;; esac
        drv=$(drm_driver "$card")
        case "$which" in
            ast)     [ "$drv" = ast ] || continue ;;
            not-ast) case "$drv" in ast|none) continue ;; esac ;;
        esac
        for conn in "/sys/class/drm/$card"-*; do
            [ -d "$conn" ] || continue
            name=$(basename "$conn")
            printf '%s %s\n' "${name#"$card"-}" "$(cat "$conn/status" 2>/dev/null || echo unknown)"
        done
    done
}

# Connected connectors still being driven -- the difference between "black" and
# "off" without a monitor in front of you. Both files are needed: `dpms` reads
# On for a connector whose CRTC was never enabled.
_lit_connectors() {
    local which="${1:-all}" card drv conn name out=""
    for card in /sys/class/drm/card[0-9]*; do
        [ -d "$card" ] || continue
        card=$(basename "$card")
        case "$card" in *-*) continue ;; esac
        drv=$(drm_driver "$card")
        case "$which" in
            ast)     [ "$drv" = ast ] || continue ;;
            not-ast) case "$drv" in ast|none) continue ;; esac ;;
        esac
        for conn in "/sys/class/drm/$card"-*; do
            [ -d "$conn" ] || continue
            [ "$(cat "$conn/status" 2>/dev/null)" = connected ] || continue
            [ "$(cat "$conn/enabled" 2>/dev/null)" = enabled ] || continue
            [ "$(cat "$conn/dpms" 2>/dev/null)" = On ] || continue
            name=$(basename "$conn")
            out="${out:+$out }${name#"$card"-}"
        done
    done
    printf '%s' "$out"
}

# wlroots is free to drop a device it cannot render for, silently, so this is
# the only way to know which outputs it actually took.
session_outputs() {
    { WAYLAND_DISPLAY="$SOCKET" wayland-info 2>/dev/null || true; } \
        | sed -n 's/^[[:space:]]*name: \([A-Za-z][A-Za-z0-9]*-[0-9][0-9]*\)$/\1/p'
}

session_display_mode() {
    { WAYLAND_DISPLAY="$SOCKET" wayland-info 2>/dev/null || true; } \
        | sed -n 's/.*width: \([0-9]*\) px, height: \([0-9]*\) px, refresh: \([0-9.]*\) Hz.*/\1x\2 @ \3Hz/p' \
        | head -1
}

# The greeter's session type on seat0, which decides whether `gdm --bmc` means
# anything. $1: how many quarter-seconds to keep looking.
_greeter_type() {
    have loginctl || return 1
    local i sid class typ
    for i in $(seq 1 "${1:-40}"); do
        for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '$4 == "seat0" {print $1}'); do
            class=$(loginctl show-session "$sid" -p Class --value 2>/dev/null || echo)
            [ "$class" = greeter ] || continue
            typ=$(loginctl show-session "$sid" -p Type --value 2>/dev/null || echo)
            [ -n "$typ" ] && { printf '%s' "$typ"; return 0; }
        done
        sleep 0.25
    done
    return 1
}

# cage gets its seat from PAMName=login (without it libseat cannot take DRM
# master and the compositor exits), producing a Class=user, Type=wayland session
# on seat0 -- a logged-in desktop in every field logind exposes. The unit's
# ExecStart `exec`s cage, so its MainPID *is* the leader.
wk_session_leader() {
    local pid
    pid=$(systemctl show wk-session -p MainPID --value 2>/dev/null || true)
    case "$pid" in ''|0) return 1 ;; esac
    printf '%s' "$pid"
}

# A graphical session belonging to a logged-in *person*. Class matters as much
# as Type: the greeter is itself a graphical session on seat0, and treating it as
# somebody's desktop would make `wk session on` decline on exactly the machine
# state it was written for. Our own compositor is excluded by name.
foreign_session() {
    have loginctl || return 1
    local sid typ class leader ours=""
    ours=$(wk_session_leader) || ours=""
    for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '$0 ~ /seat0/ {print $1}'); do
        typ=$(loginctl show-session "$sid" -p Type --value 2>/dev/null || echo)
        class=$(loginctl show-session "$sid" -p Class --value 2>/dev/null || echo)
        [ "$class" = user ] || continue
        if [ -n "$ours" ]; then
            leader=$(loginctl show-session "$sid" -p Leader --value 2>/dev/null || echo)
            [ "$leader" = "$ours" ] && continue
        fi
        case "$typ" in
            wayland|x11) echo "$sid $typ"; return 0 ;;
        esac
    done
    return 1
}

case "$ACTION" in
on)
    # The socket file can outlive the compositor after a crash.
    if [ -S "$SOCKET" ] && systemctl is-active --quiet wk-session 2>/dev/null; then
        # Asking for a benchmark session and getting "already running" for a
        # software one is how an afternoon of numbers turns out to have
        # measured llvmpipe.
        wanted=gpu; [ -n "$BMC" ] && wanted=bmc
        running=$(session_mode)
        if [ "$wanted" = "$running" ]; then
            info "wk session already running ($SOCKET, mode $running)"
            session_mode_warn || true
            exit 0
        fi
        info "a '$running' session is running; restarting it as '$wanted'"
        run_priv session-stop
    elif [ -S "$SOCKET" ]; then
        warn "stale compositor socket at $SOCKET -- starting a new session"
    fi

    if session=$(foreign_session); then
        info "a graphical session is already active on seat0 (session $session)"
        log  "  leaving it alone; run 'wk session off' first if you want a clean"
        log  "  benchmark compositor instead of a full desktop"
        exit 0
    fi

    # Without wayland-info a started compositor could not be told apart from a
    # broken one.
    have wayland-info || die "wayland-info missing -- a session nobody can verify is real is not started; ./setup --stage tools installs wayland-utils"

    if [ -z "$BMC" ]; then
        info "starting the benchmark compositor on seat0 (GPU only, BMC excluded)"
        run_priv session-on || die "the compositor did not start; journalctl -u wk-session"
        [ -S "$SOCKET" ] || die "no Wayland socket at $SOCKET after start"
    else
        # The BMC's chip becomes the compositor's only modesetting device.
        log "  the monitor goes dark: the session moves to the BMC, it is not duplicated"
        info "starting a BMC session on seat0 (software-rendered)"
        run_priv session-on-bmc || die "the compositor did not start; journalctl -u wk-session"
        [ -S "$SOCKET" ] || die "no Wayland socket at $SOCKET after start"

        # The compositor coming up is not proof the output it took is the BMC's
        # -- a blank remote console is the one failure this can't miss.
        outs=$(session_outputs)
        bmc_names=$(_connectors ast | awk '{print $1}')
        found=""
        for name in $bmc_names; do
            case " $(echo "$outs" | tr '\n' ' ') " in *" $name "*) found=1 ;; esac
        done
        [ -n "$found" ] || warn "the session is up but not on a BMC connector (outputs: ${outs:-none})"
    fi

    info "session up: $SOCKET (mode $(session_mode))"
    log  "  outputs: $(session_outputs | tr '\n' ' ')  display: $(session_display_mode)"
    log  "  workspaces see it at /run/wk/display/wayland-0"
    log  "  launch a browser in it with:  wk gui <workspace> [url]"
    [ -n "$BMC" ] && log  "  watch it on the BMC's KVM-over-IP console" || true
    session_mode_warn || true
    ;;

gdm)
    if session=$(foreign_session); then
        info "a graphical session is already active on seat0 (session $session)"
        log  "  leaving it alone; run 'wk session off' first if you want a clean start"
        exit 0
    fi

    if systemctl is-active --quiet wk-session 2>/dev/null; then
        info "stopping the benchmark compositor to start a desktop instead"
    fi

    if [ -z "$BMC" ]; then
        info "starting gdm on seat0 (GPU only, the BMC's chip hidden from seat0)"
        run_priv session-gdm || die "gdm did not start; journalctl -u gdm"
    else
        log "  the monitor goes dark: the GPU is hidden from seat0, not just idle"
        info "starting gdm on seat0 (BMC only, software-rendered)"
        run_priv session-gdm-bmc || die "gdm did not start; journalctl -u gdm"
    fi

    # Only enforced if the greeter takes its devices from logind; not on Xorg,
    # where NVIDIA's DDX drives the card through /dev/nvidia*, which carries no
    # seat tags to strip.
    greeter=$(_greeter_type) || greeter=""
    case "$greeter" in
        wayland)
            info "gdm is up on seat0 (wayland greeter) -- log in at the console"
            ;;
        "")
            warn "gdm was started but no greeter session appeared on seat0"
            log  "  journalctl -u gdm"
            ;;
        *)
            warn "the greeter came up on $greeter, not wayland -- the mode is not enforced"
            log  "  hiding a device from seat0 constrains a compositor that asks logind for"
            log  "  its devices. NVIDIA's Xorg driver doesn't: it drives the card through"
            log  "  /dev/nvidia0 and /dev/nvidia-modeset, character devices with no udev"
            log  "  properties and no seat tags for the hide to remove. So the desktop is"
            log  "  wherever that driver put it, whichever mode was asked for."
            log  "  gdm chose Xorg via 61-gdm.rules (nvidia_drm + modeset=Y falls through"
            log  "  to gdm_prefer_xorg); wk overrides it, so this means the override"
            log  "  didn't take -- check: sudo $PRIV session-status"
            ;;
    esac
    [ -n "$BMC" ] && log "  or over the BMC's KVM-over-IP console" || true
    ;;

off)
    run_priv session-off || die "the helper failed to turn the screen off"

    # Two claims, easily conflated: the placeholder compositor is running (so
    # fbcon can't repaint the console), *and* its outputs are modeset off.
    lit=$(_lit_connectors not-ast)
    if [ -n "$lit" ]; then
        warn "the screen is black but still lit: $lit"
        log  "  a compositor holding an output and painting it black is not an"
        log  "  output that is off -- the CRTC keeps scanning out, so the monitor"
        log  "  keeps its signal. The modeset that darkens it needs wlr-randr:"
        log  "    ./setup --stage tools   (then: wk session off)"
    else
        info "screen off -- outputs modeset off, placeholder compositor holding the seat"
        log  "  both halves are load-bearing: disabling the outputs is what darkens"
        log  "  the monitor, holding the device is what stops fbcon repainting the"
        log  "  console over the top of it"
    fi

    # The placeholder covers one DRM device, so the BMC's chip keeps its frame.
    bmc_lit=$(_lit_connectors ast)
    [ -n "$bmc_lit" ] && log "  still lit on the BMC's chip: $bmc_lit (its console keeps its last frame)"
    log  "  a desktop back:  wk session gdm      a benchmark session:  wk session on"
    ;;

status)
    # Readable without privilege, so status doesn't go through the helper: a
    # failure inside it would mean no status output at all.
    unit=$(systemctl is-active wk-session 2>/dev/null | head -1 || true)
    dm=$(systemctl is-active gdm3 2>/dev/null | head -1 || true)
    [ -n "$dm" ] || dm=$(systemctl is-active gdm 2>/dev/null | head -1 || true)

    printf 'session:   %s\n' "${unit:-unknown}"
    printf 'socket:    %s\n' "$([ -S "$SOCKET" ] && echo "$SOCKET" || echo none)"
    printf 'dm:        %s\n' "${dm:-unknown}"

    # A few root-only facts, not worth a password for any of them.
    priv_status=$(sudo -n "$PRIV" session-status 2>/dev/null || true)
    modeset=$(printf '%s\n' "$priv_status" | awk '/^modeset:/ {print $2}')
    desktop=$(printf '%s\n' "$priv_status" | awk '/^desktop:/ {print $2}')
    seathide=$(printf '%s\n' "$priv_status" | awk '/^seat-hide:/ {print $2}')
    printf 'modeset:   %s\n' "${modeset:-unknown}"

    printf 'mode:      %s\n' "$(session_mode)"
    # In `off` mode this must be empty; anything listed while the mode says off
    # is a bug, visible from a shell rather than from a monitor.
    lit=$(_lit_connectors)
    printf 'lit:       %s\n' "${lit:-none}"
    printf 'gpu:       %s\n' "$(_connectors not-ast | tr '\n' ' ' | sed 's/ *$//')"
    printf 'bmc:       %s\n' "$(_connectors ast | tr '\n' ' ' | sed 's/ *$//')"
    printf 'desktop:   %s\n' "${desktop:-none}"

    # A desktop mode is only enforced when the greeter takes its devices from
    # logind. `x11` means `desktop:` above is intent, not fact.
    greeter=$(_greeter_type 1) || greeter=""
    [ -n "$greeter" ] && printf 'greeter:   %s%s\n' "$greeter" \
        "$([ "$greeter" = wayland ] || echo '  (mode NOT enforced -- see gdm notes)')"
    [ -n "$seathide" ] && printf 'seat-hide: %s (hidden from seat0)\n' "$seathide"

    # Blank would read as "no output", indistinguishable from "cannot ask".
    if [ -S "$SOCKET" ]; then
        if have wayland-info; then
            printf 'outputs:   %s\n' "$(session_outputs | tr '\n' ' ')"
        else
            printf 'outputs:   unknown (wayland-utils missing)\n'
        fi
    fi

    # MotionMark scores scale with surface size, so two runs on different display
    # modes are not comparable; cage takes the connector's preferred mode.
    if [ -S "$SOCKET" ]; then
        if have wayland-info; then
            mode=$(session_display_mode)
            [ -n "$mode" ] && printf 'display:   %s\n' "$mode"
        else
            printf 'display:   unknown (wayland-utils missing)\n'
        fi
    fi

    # Our own compositor is a logind session too, so it matches foreign_session
    # exactly -- checked only when our socket is absent.
    if [ ! -S "$SOCKET" ] && session=$(foreign_session); then
        printf 'foreign:   session %s\n' "$session"
    fi
    session_mode_warn || true
    exit 0
    ;;

*)
    die "usage: wk session on [--bmc] | gdm [--bmc] | off | status -- a real graphical session for benchmark runs, or a real desktop, on real hardware.; see wk session -h"
    ;;
esac
