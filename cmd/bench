#!/usr/bin/env bash
#
# wk bench <workspace> <plan> [options] -- run a benchmark and keep the result defensible
#
# wk: where=workspace name=required ready=yes group=workspaces needs python3
# wk: sub stage,staged,mac,mac-volume,mac-ab,ab-summary,compare,report where=host
# wk: sub seed where=dynamic
# wk: sub ls,compare,report name=none
# wk: sub seed name=required@2
#
#   wk bench <workspace> <plan> [--config C] [--count N] [--subtests "A B"]
#                                [--software] [--force] [--browser-args "..."]
#                                [--cores <set>]
#       --count N                          iterations per run (default: run-benchmark's own)
#       --cores 0-3                       pin the run to this Linux cpu list
#                                          (taskset -c) -- 0-3, 2,3, 0-1,4, 7.
#                                          Refused on a macOS guest or host:
#                                          there is no per-run pin there, only
#                                          the vCPU count chosen at boot.
#   wk bench seed <workspace> <plan>       fetch the benchmark payload only
#   wk bench stage <ws> --to <machine>     put a build where a bare-metal role
#                                          will find it (build in the guest,
#                                          run on the machine itself)
#       [--config C] [--plan P] [--payload <dir>] [--dry-run]
#   wk bench staged                        run a staged build, in bench mode
#       [--plan P] [--id <staged-id>] [--count N] [--timeout S]
#       [--subtests "A B"] [--payload <dir>] [--browser-args "..."]
#       --ls                               what is staged here, and what ran
#       --dry-run                          resolve everything; run nothing
#       --force                            record it despite a preflight fail
#                                          (still refuses to run outside bench
#                                          mode -- nothing does)
#   wk bench mac <ws> [--plan P]           the whole macOS lane in one command,
#                                          driven from another machine: build,
#                                          stage, arm, wait for the one step a
#                                          person has to do, run, come back
#   wk bench mac-ab <ws> [--rounds N]      an interleaved A/B on the Mac's
#                                          benchmark install, with nobody in the
#                                          room: plant a job, reboot, read it
#                                          back. --preflight/--status/--collect
#   wk bench ab-summary --runs <tsv>       the A/B's own verdict, per arm
#   wk bench report <task> [--html]        the task's A/B: one Score+Time per
#                                          subtest table, Welch/FDR, histograms
#                                          and variance per device and plan,
#                                          out of the rounds recorded so far --
#                                          a task still running is reported as
#                                          partial and says what is missing;
#                                          --html writes report-<device>-<plan>.html
#                                          into the task's directory
#   wk bench report <run-a> <run-b>        the same report for any two runs
#       [--html out.html] [--text]        (either side may be comma-separated
#                                          run directories, pooled)
#   wk bench compare <run-a> <run-b> [ws]  `wk bench report` in text mode; the
#                                          third argument is accepted and
#                                          ignored
#   wk bench ls                            every task -- one per wk ab, wk pi
#                                          bench or wk bench invocation, named
#                                          for when it was requested and what
#                                          it measures -- with its state and
#                                          each run's directory
#
#   --config decides the runner: a browser port (wpe-release, gtk-release) runs
#   the plan in MiniBrowser, a JSCOnly port (jsc-release) runs it in the jsc
#   shell. The plan decides whether a GPU is required at all.
#
#   WK_BENCH_ASLR=off          disable ASLR for the run (Linux; setarch -R)
#   WK_BENCH_ENV_PAD=<bytes>   export a dummy env var of this size first
#   WK_BENCH_PATH_PAD=<n>      run through a symlink padded to <n> characters
#   WK_BENCH_SHARED_CACHE=avoid   disable macOS's dyld shared cache (variance probe)
#   every knob is off by default and is recorded into the result's
#   `configuration`, which `wk bench report` groups variance by.
#
#   WK_BENCH_MACHINE=<mbp|benchvm>   which fleet Mac this is, in host mode --
#                              nothing here can tell on its own
#   WK_BENCH_ROOT=<dir>        where staged payloads live, instead of the
#                              bench volume (host-mode testing)
#   WK_BENCH_PYTHON=<path>     the python3 to run staged benchmarks with,
#                              instead of searching for one with `objc`
#   WK_BENCH_MAX_LOAD=<n>      1-minute load average above which preflight
#                              calls the machine busy (default 4)
#   WK_STALL_SECONDS=<s>       silence before preflight warns (default 900;
#                              longer than a build's, since a benchmark
#                              reports once per subtest)
#   WK_ABORT_SECONDS=<s>       silence before a run is given up on (default 5400)
#
# Tools/Scripts/run-benchmark does the run; everything here decides whether
# the number means anything: the environment is checked before the run (a
# Speedometer score from llvmpipe is a different measurement, not a slow
# one), the payload is seeded once and pinned so the benchmark cannot
# silently change between two runs, and the environment -- kernel, driver,
# governor, compositor, sha, limits, architecture -- is recorded with the
# result.
#
# Three axes decide what a run needs and what it may be compared with, are
# derived rather than flagged, and are recorded with every result; `wk bench
# compare` warns when two runs differ on any of them:
#
#   class     what the benchmark measures. gpu-class (Speedometer, MotionMark)
#             needs a real compositor and GPU; cpu-class (JetStream and the
#             other JS benchmarks) does not, which is what lets a workspace
#             with no GPU measure anything at all. Derived from the plan.
#
#   runner    what executes it: `browser` is run-benchmark driving
#             MiniBrowser, the official number for every plan; `jsc` is the
#             jsc shell running the benchmark's own cli.js, the only thing a
#             JSCOnly build can do. Derived from the config's port.
#
#   host      where the run happened: bench_host=container (a workspace) or
#             bench_host=image (a bootable bench system) -- not comparable
#             with each other.
#
# Preflight failures are fatal; --force downgrades them to warnings and
# records that in the run's metadata.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
# The result store, seeded payloads and the variance knobs' record, shared
# with `wk pi bench`.
. "$WK_ROOT/lib/bench.sh"
# Raised before lib/watchdog.sh is sourced: see its header.
WK_STALL_SECONDS="${WK_STALL_SECONDS:-900}"
WK_ABORT_SECONDS="${WK_ABORT_SECONDS:-5400}"
. "$WK_ROOT/lib/watchdog.sh"
# Shared with `wk quiesce`, which does the quieting: one answer to "is it
# quiet", not two that can disagree.
. "$WK_ROOT/lib/quiet.sh"
. "$WK_ROOT/build/configs.sh"

. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/arch.sh"
# build_live: one rule for "is that build actually running", shared with
# `wk status` rather than re-derived here.
. "$WK_ROOT/lib/detach.sh"

# `wk bench --where <args>`: seed is workspace-scoped for one argument shape
# and host-scoped for another, so the dispatcher asks rather than being told
# once in the declaration. compare and report are plain where=host and never
# reach here.
_bench_where() { # <verb> <args...> -- prints host or workspace
    case "${1:-}" in
        seed)
            if [ "$(ws_target "${2:-}" 2>/dev/null)" = container ]; then
                printf workspace
            else
                printf host
            fi ;;
        *) printf host ;;
    esac
}
if [ "${1:-}" = --where ]; then
    shift
    _bench_where "$@"
    exit 0
fi


# bench's paths (/bench, /cache/bench, /src/WebKit) are container mounts, so
# only container workspaces are supported; refused by name rather than
# failing on a path that doesn't exist.
load_bench_target() {
    local ws="$1" t
    t="$(ws_target "$ws")"
    [ "$t" = container ] || die "wk bench supports container workspaces only ('$ws' has target '$t')"
    load_target "$t"
}

# One value here: `wk bench` refuses every target but the container.
# `wk bench staged` and `wk pi bench` write bench_host=image instead.
BENCH_HOST=container

# The storage the run read from, described rather than named: a run off a
# USB stick and one off an NVMe are two series, not two samples, same rule
# as bench_host. Reports the parent disk with the three facts that decide it
# (transport, spins or not, takes a discard or not). Best-effort: unknown
# storage is recorded as unknown, and nothing refuses a run over it.
bench_root_device() { # <path>
    local path="${1:-/}"
    if is_macos; then
        # Answers for the mount point directly, including the synthesised
        # APFS case where the "device" is a volume in a container.
        local out; out=$(diskutil info "$path" 2>/dev/null) || { echo unknown; return 0; }
        local node proto ssd
        node=$(printf '%s' "$out" | sed -n 's/^ *Device Node: *//p' | head -1)
        proto=$(printf '%s' "$out" | sed -n 's/^ *Protocol: *//p' | head -1)
        ssd=$(printf '%s' "$out" | sed -n 's/^ *Solid State: *//p' | head -1)
        [ -n "$node" ] || { echo unknown; return 0; }
        printf '%s (%s, %s)\n' "$node" "${proto:-unknown}" \
            "$([ "$ssd" = Yes ] && echo ssd || echo rotational)"
        return 0
    fi
    local src disk line rota tran model
    src=$(findmnt -no SOURCE --target "$path" 2>/dev/null | head -1) || true
    [ -n "$src" ] || { echo unknown; return 0; }
    # -s walks *up* to the parent disk, which carries the model and
    # transport (a partition, LVM volume or device-mapper name reports
    # neither). -l as well as -s: the tree form draws glyphs into the NAME
    # column, and `/sys/block/<glyphs>nvme0n1` resolves to nothing, which
    # reads as a disk that takes no discard.
    line=$(lsblk -nlo NAME,TYPE,ROTA,TRAN,MODEL -s "$src" 2>/dev/null \
             | awk '$2 == "disk" { print; exit }') || true
    [ -n "$line" ] || { echo "$src"; return 0; }
    disk=$(printf '%s' "$line" | awk '{print $1}')
    rota=$(printf '%s' "$line" | awk '{print $3}')
    tran=$(printf '%s' "$line" | awk '{print $4}')
    model=$(printf '%s' "$line" | awk '{ $1=""; $2=""; $3=""; $4=""; sub(/^ +/,""); print }')
    local trim=no-trim
    [ "$(cat "/sys/block/$disk/queue/discard_max_bytes" 2>/dev/null || echo 0)" -gt 0 ] \
        && trim=trim
    printf '%s %s(%s, %s, %s)\n' "$disk" "${model:+$model }" \
        "${tran:-unknown}" "$([ "$rota" = 0 ] && echo ssd || echo rotational)" "$trim"
}

# What the benchmark measures. gpu-class is the default for anything
# unclassified: guessing gpu fails as an easy refusal, guessing cpu fails as
# a MotionMark score from llvmpipe that looks like a regression. Speedometer
# is gpu-class despite being mostly script, since its score depends on the
# rendering it drives. The classifier is `wkdata.py bench-class`, not a case
# statement here, so `wk pi bench` can share it.
bench_class() {
    wkdata bench-class "$1"
}

# --- variance knobs -----------------------------------------------------
# WK_BENCH_ASLR, WK_BENCH_ENV_PAD and WK_BENCH_PATH_PAD are listed above (wk
# bench -h). Turning one on is recorded into `configuration`
# (bench_configuration_args below) so `wk bench report` can group variance
# by it. ASLR (Linux only, setarch -R) fixes the address layout every
# iteration. ENV_PAD and PATH_PAD both move where the initial stack starts:
# envp's size and the executable's own path both land on it.

# bench_aslr_wrap -- the command prefix that pins the address layout, or
# nothing. Interpolated straight into a `bash -lc "..."` string built by the
# caller (run_jsc, the browser run in cmd_run), which already builds one
# shell command as text.
bench_aslr_wrap() {
    [ "${WK_BENCH_ASLR:-}" = off ] && printf 'setarch $(uname -m) -R -- '
}

# --cores: taskset -c <set>, not podman --cpuset-cpus -- one pin that works
# on every Linux target this file execs into.

# bench_cores_valid <set> -- delegates to `wkdata.py cores-valid`, the one
# cpu-list parser (also used by bench_cores_wrap below).
bench_cores_valid() {
    wkdata cores-valid "$1"
}

# bench_cores_refusal <target> <os> -- prints why --cores cannot be
# honoured, or nothing if it can. <target> is the workspace's `ws_target`;
# <os> is `wk_os` for the machine that runs the benchmark. A `vm` target and
# `local` on macOS both have no per-run pin, only the vCPU count chosen when
# the guest was created.
bench_cores_refusal() {
    local target="$1" os="$2"
    if [ "$target" = vm ] || { [ "$target" = local ] && [ "$os" = macos ]; }; then
        printf "no pin exists on macOS; the guest's vCPU count is not a pin"
    fi
}

# bench_cores_wrap -- the command prefix that pins the run via taskset, or
# nothing; same interpolation contract as bench_aslr_wrap. `wkdata.py
# cores-wrap` only prints for a set cores-valid already accepted, so it
# needs no shell quoting here.
bench_cores_wrap() {
    [ -n "$CORES" ] && wkdata cores-wrap "$CORES"
}

# bench_env_pad_prelude -- a shell fragment exporting a dummy variable of
# WK_BENCH_ENV_PAD bytes, or nothing. Emitted as source, same reason as
# bench_aslr_wrap: it has to land in the same shell as the benchmark.
bench_env_pad_prelude() {
    local n="${WK_BENCH_ENV_PAD:-0}"
    case "$n" in ''|*[!0-9]*) return 0 ;; esac
    [ "$n" -gt 0 ] || return 0
    printf 'export WK_BENCH_ENV_PAD_DUMMY="$(head -c %d /dev/zero | tr "\\0" x)"; ' "$n"
}

# bench_padded_path <run-fn-or-empty> <target> -- a symlink to <target> whose
# own path is WK_BENCH_PATH_PAD characters longer than <target>'s, created
# through <run-fn> (empty runs locally, for the staged macOS tree) if the
# knob is set, <target> unchanged otherwise.
bench_padded_path() {
    local runner="$1" target="$2" n="${WK_BENCH_PATH_PAD:-0}"
    case "$n" in ''|*[!0-9]*) n=0 ;; esac
    if [ "$n" -le 0 ]; then
        printf '%s' "$target"
        return 0
    fi
    local pad=""
    while [ "${#pad}" -lt "$n" ]; do pad="${pad}p"; done
    # Two statements, not `local dir=X link=$dir/Y`: bash expands every
    # value in one `local` before assigning any of them, so a combined form
    # gives link=$target's basename at the filesystem root, not under $dir.
    local dir="/tmp/wk-bench-pad-$pad"
    local link="$dir/$(basename "$target")"
    if [ -n "$runner" ]; then
        "$runner" mkdir -p "$dir" >/dev/null 2>&1
        "$runner" ln -sf "$target" "$link" >/dev/null 2>&1
    else
        mkdir -p "$dir" 2>/dev/null
        ln -sf "$target" "$link" 2>/dev/null
    fi
    printf '%s' "$link"
}


CONFIG="${WK_CONFIG:-wpe-release}"
# Defaulted from the config's port below: the two ports have different
# run-benchmark drivers (minibrowser-wpe, minibrowser-gtk), and picking the
# wrong one fails in a way that looks like a broken build. `--browser` is
# the one override point (below); an env var would be a second one.
BROWSER=""
COUNT=""
# --force is consumed by `wk` and arrives as WK_FORCE.
FORCE="${WK_FORCE:-}"
SUBTESTS=""
SOFTWARE=""
# Why the software path was taken: --software is deliberate, a cpu-class
# run with no display is derived, and a result must tell them apart.
SOFTWARE_REASON=""
BROWSER_ARGS=""
# The Linux cpu list to pin the run to (taskset -c), or empty for unpinned --
# the default and, on macOS, the only option.
CORES=""

# --- saved tasks and their runs -----------------------------------------------
# Everything but "which tasks are running" is read off the store by
# lib/wkdata.py; running is the task's lock, checked here (lock_alive).
cmd_ls() {
    [ -d "$BENCH_DIR" ] || { log "(no tasks yet)"; return 0; }
    wkdata ls "$BENCH_DIR" --running "$(bench_running_tasks)"
}

# --- the payload -------------------------------------------------------------
# Read the plan from the workspace's own checkout (through t_src, not the
# container's /src/WebKit: `wk bench stage` reads a plan out of a macOS
# guest, where that path doesn't exist), since a workspace may be testing a
# change to the plan itself.
# lib/bench.sh's plan resolver reads plans through this: the workspace's
# own checkout, so a seeded payload is the one its run-benchmark names.
bench_plan_read() { # <path under Tools/Scripts>
    t_exec "$SEED_WS" cat "$(t_src "$SEED_WS")/Tools/Scripts/$1"
}

# --- preflight ---------------------------------------------------------------
# Each check answers one question otherwise answered by "the number looked
# odd, I wonder why".
PREFLIGHT_FAILS=0
PREFLIGHT_NOTES=""

check() {
    local ok="$1" what="$2" detail="${3:-}"
    if [ "$ok" = yes ]; then
        printf '  \033[32mok\033[0m    %-34s %s\n' "$what" "$detail" >&2
    else
        printf '  \033[31mFAIL\033[0m  %-34s %s\n' "$what" "$detail" >&2
            PREFLIGHT_FAILS=$((PREFLIGHT_FAILS + 1))
        # Quotes and backslashes would land inside generated JSON.
        PREFLIGHT_NOTES="$PREFLIGHT_NOTES$what: $(printf '%s' "$detail" | tr -d '"\\'); "
    fi
}

# preflight <workspace> <build-dir> <class> <runner>
preflight() {
    local ws="$1" build_dir="$2" class="$3" runner="$4"

    info "preflight"

    # 1. the build exists. Which binary depends on the runner: a JSCOnly tree
    #    has no MiniBrowser, so looking for one there would report a missing
    #    browser when nothing is actually missing.
    if [ "$runner" = jsc ]; then
        if t_exec "$ws" test -x "$build_dir/bin/jsc" 2>/dev/null; then
            check yes "build present" "$build_dir/bin/jsc"
        else
            check no  "build present" "no jsc in $build_dir -- wk build $ws $CONFIG"
        fi
    elif t_exec "$ws" test -x "$build_dir/bin/MiniBrowser" 2>/dev/null \
       || t_exec "$ws" test -x "$build_dir/bin/WPEWebProcess" 2>/dev/null; then
        check yes "build present" "$build_dir"
    else
        check no  "build present" "no MiniBrowser in $build_dir -- wk build $ws $CONFIG"
    fi

    # 2. the sandbox, and with it the GPU: --gpu makes a software renderer
    #    fatal rather than a footnote (MotionMark on llvmpipe measures
    #    llvmpipe). --software skips this and the compositor check and
    #    records the run as software, so it is never mistaken for comparable.
    if [ "$class" = cpu ]; then
        # Not having a GPU is not a finding for a cpu-class benchmark: this run
        # is directly comparable with every other cpu-class run. The sandbox
        # check still runs -- it catches a network interface or host mount,
        # not rendering.
        check yes "class" "cpu -- no GPU or compositor required"
        "$WK_ROOT/cmd/verify" "$ws" >/dev/null 2>&1 \
            || check no "sandbox intact" "wk verify $ws"
    elif [ -n "$SOFTWARE" ]; then
        check yes "sandbox (software rendering)" "not comparable with a GPU run"
        "$WK_ROOT/cmd/verify" "$ws" >/dev/null 2>&1 \
            || check no "sandbox intact" "wk verify $ws"
        PREFLIGHT_NOTES="${PREFLIGHT_NOTES}software rendering; "
    elif "$WK_ROOT/cmd/verify" "$ws" --gpu >/tmp/.wk-bench-verify.$$ 2>&1; then
        check yes "sandbox and GPU" "$(awk -F'renderer=' '/renderer=/{print substr($2,1,44); exit}' /tmp/.wk-bench-verify.$$)"
    else
        check no  "sandbox and GPU" "$(grep FAIL /tmp/.wk-bench-verify.$$ | head -2 | tr '\n' ' ')"
    fi
    # awk rather than grep|head: a pipeline whose reader exits early trips
    # `set -o pipefail`, and this is inside a command substitution under
    # `set -e`, so it would abort the run rather than leave a field blank.
    GPU_RENDERER=$(awk -F'renderer=' '/renderer=/{sub(/ *\|.*/,"",$2); print $2; exit}' /tmp/.wk-bench-verify.$$ 2>/dev/null || true)
    rm -f /tmp/.wk-bench-verify.$$

    # 3. a real compositor: the socket says one is there, not what it is
    #    drawing on. `wk session on --bmc` puts the session on the BMC's
    #    software-rendered display chip, invisible both from the socket and
    #    from the GPU probe above (which asks the *client* its EGL vendor,
    #    still NVIDIA when the compositor behind it is llvmpipe). The mode
    #    `wk session` recorded is the only place the difference shows.
    local sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wk/display/wayland-0"
    SESSION_MODE=$(session_mode)
    if [ "$class" = cpu ] || [ -n "$SOFTWARE" ]; then
        :
    elif [ ! -S "$sock" ]; then
        check no  "graphical session" "no compositor -- wk session on"
    else
        case "$SESSION_MODE" in
            # none: a session wk did not start, i.e. somebody's own desktop --
            # the renderer check above already answers whether it's on the GPU.
            gpu|none) check yes "graphical session" "$sock ($SESSION_MODE)" ;;
            *)        check no  "graphical session" \
                          "session mode '$SESSION_MODE' -- watchable over the BMC, not measurable; wk session on" ;;
        esac
    fi

    # 4. quiesced: the governor is what actually moves scores.
    local gov
    gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo unknown)
    if [ "$gov" = performance ]; then
        check yes "cpu governor" "$gov"
    else
        check no  "cpu governor" "$gov -- wk quiesce on"
    fi

    # 5. idle: a build in another workspace is the single most likely
    #    reason a benchmark run is quietly wrong here.
    local load busy f
    load=$(awk '{print $1}' /proc/loadavg)

    # Counted in a loop rather than `... | wc -l`: with `set -o pipefail`, a
    # grep matching nothing fails the pipeline, the assignment, and then
    # `set -e` aborts the run before printing anything.
    busy=0
    for f in "$WK_STORE"/ws/*/build.status; do
        [ -f "$f" ] || continue
        # `build_live`, not a grep for the state: a build killed with -9 leaves
        # `state=running` behind for ever (lib/detach.sh).
        if build_live "$f"; then
            busy=$((busy + 1))
        fi
    done
    if [ "$busy" != 0 ]; then
        check no "no builds running" "$busy build(s) in progress"
    elif [ "$(printf '%.0f' "$load")" -gt "${WK_BENCH_MAX_LOAD:-4}" ]; then
        check no "machine idle" "1-minute load average is $load"
    else
        check yes "machine idle" "load $load, no wk builds"
    fi

    # 6. thermals, informational.
    local temp=""
    for z in /sys/class/thermal/thermal_zone*/temp; do
        [ -r "$z" ] || continue
        temp="$(( $(cat "$z") / 1000 ))C"
        break
    done
    # An `x && y` as the last statement of a function is a `set -e` landmine:
    # a board with no thermal zones makes the test false and the non-zero
    # status aborts the run silently.
    if [ -n "$temp" ]; then
        PREFLIGHT_NOTES="${PREFLIGHT_NOTES}temp $temp; "
    fi

    echo >&2
    if [ "$PREFLIGHT_FAILS" -eq 0 ]; then
        info "preflight clean"
        return 0
    fi
    if [ -n "$FORCE" ]; then
        warn "$PREFLIGHT_FAILS preflight check(s) failed -- continuing because --force was given"
        warn "the run will be recorded as forced, and is not comparable with a clean run"
        return 0
    fi
    die "$PREFLIGHT_FAILS preflight check(s) failed -- refusing to produce a number that cannot be defended.
    Fix the above, or re-run with --force to record a result anyway."
}

# --- the jsc runner ----------------------------------------------------------
# JetStream and the other JS benchmarks ship a cli.js that drives the whole
# suite inside a JavaScript shell -- the only way to benchmark a JSCOnly
# build, since there is no browser in the tree.
#
# The output is deliberately byte-compatible with run-benchmark's: it's the
# same object the browser driver's resultsJSON() POSTs to run-benchmark's
# /report endpoint -- {"<suite>": {"tests": {"<test>": {"metrics": {"Score":
# {"current": [...]}}}}}} -- so compare-results, `wk bench compare` and
# container/bench/js3-ci.py all read it with no special case.
#
# run_jsc <workspace> <plan> <out-dir> <run-id> <payload-host> <payload-in-target> <src>
run_jsc() {
    local ws="$1" plan="$2" out="$3" payload="$4" payload_ctr="$5" src="$6"

    [ -n "$payload" ] || die "$plan has no seeded payload, and the jsc runner has
    nothing to run without one. 'wk bench seed $ws $plan' fetches it; a plan
    whose source cannot be pre-seeded can only be run with a browser config."
    [ -f "$payload/cli.js" ] || die "$payload has no cli.js, so $plan cannot be driven
    from a JavaScript shell. Run it with a browser config instead
    (--config wpe-release), which is the official number for every plan anyway."

    local jsc var dir
    jsc=$(config_jsc_path "$src")
    var=$(config_run_var)
    dir=$(config_run_dir "$src")

    # Through the same t_exec this runner already uses, so the symlink lives
    # in the container the binary will actually run in.
    if [ "${WK_BENCH_PATH_PAD:-0}" -gt 0 ] 2>/dev/null; then
        _bench_pad_runner() { t_exec "$ws" "$@"; }
        jsc=$(bench_padded_path _bench_pad_runner "$jsc")
    fi
    local aslr; aslr=$(bench_aslr_wrap)
    local cores_wrap; cores_wrap=$(bench_cores_wrap)
    local pad_prelude; pad_prelude=$(bench_env_pad_prelude)

    # cli.js takes its options from the shell's script arguments, everything
    # after `--`. Passed as flags rather than set as globals: the driver
    # reads them off a JetStreamParams object built from these arguments and
    # ignores a global of the same name (JetStreamDriver.js:3263,
    # utils/params.js), and rejects a flag it does not know, so a payload
    # too old for this interface fails loudly here.
    local cliargs="--dump-json-results"
    if [ -n "$SUBTESTS" ]; then
        cliargs="$cliargs --test=$(printf '%s' "$SUBTESTS" | tr ' ' ',')"
    fi

    # One jsc invocation per iteration, not one invocation asked to repeat
    # itself: a fresh process per iteration keeps a warmed-up heap or JIT
    # tier from the previous pass out of the next one's numbers.
    local n="${COUNT:-1}" i=1 rc=0
    info "running $plan in '$ws' ($CONFIG, jsc shell, $n iteration(s))"
    log  "  results: $out"
    while [ "$i" -le "$n" ]; do
        [ "$n" -gt 1 ] && info "iteration $i/$n"
        set +e
        run_watched "$out/run-$i.log" -- \
            t_exec "$ws" bash -lc "export $var=\"$dir\${${var}:+:\${${var}}}\"; \
                ${pad_prelude}cd $(sh_quote "$payload_ctr") && \
                exec ${cores_wrap}${aslr}$(sh_quote "$jsc") cli.js -- $cliargs"
        rc=$?
        set -e
        if [ "$rc" -ne 0 ]; then
            warn "jsc exited $rc on iteration $i"
            first_error "$out/run-$i.log" | sed 's/^/  /' >&2 || true
            log "  full log: $out/run-$i.log"
            return "$rc"
        fi
        i=$((i + 1))
    done

    # Appends each pass's score to the same "current" list, what
    # run-benchmark's --count does and what compare-results needs for variance.
    wkdata merge-jsc-logs "$out/result.json" "$out"/run-*.log
    return 0
}

# --- the run -----------------------------------------------------------------
cmd_run() {
    local ws="$1" plan="$2"
    require_name "$ws"
    load_bench_target "$ws"
    [ "$(t_info "$ws")" != absent ] || die "no such workspace: $ws"

    if [ -n "$CORES" ]; then
        bench_cores_valid "$CORES" \
            || die "--cores '$CORES' is not a valid Linux cpu list (e.g. 0-3, 2,3, 0-1,4, 7)"
        local cores_refusal; cores_refusal=$(bench_cores_refusal "$(ws_target "$ws" 2>/dev/null)" "$(wk_os)")
        [ -z "$cores_refusal" ] || die "--cores: $cores_refusal"
    fi

    config_load "$CONFIG" || die "unknown config '$CONFIG' (wk build --list)"

    # class, runner and arch (see header) are derived here, never taken as
    # flags: a flag for any of them would let the record disagree with what
    # happened.
    local class runner arch
    class=$(bench_class "$plan")
    arch=$(t_arch "$ws")
    case "$CFG_PORT" in
        --jsc-only) runner=jsc ;;
        *)          runner=browser ;;
    esac

    # A JSCOnly tree has no browser and no flag changes that.
    if [ "$runner" = jsc ] && [ "$class" = gpu ]; then
        die "$plan is a gpu-class benchmark and $CONFIG builds no browser.
    Either build a browser port (wk build $ws wpe-release) and pass
    --config wpe-release, or run a cpu-class plan -- jetstream3, octane,
    kraken, sunspider, ares6 -- which the jsc shell can drive directly."
    fi

    # An armhf workspace is permanently software-rendering (the NVIDIA
    # userspace is aarch64-only), so a rendering benchmark here measures
    # llvmpipe wearing MotionMark's name. A real 32-bit rendering number
    # needs the device, not a container -- `wk pi bench`.
    if [ "$class" = gpu ] && ! arch_has_gpu "$arch"; then
        die "$plan is gpu-class and '$ws' is an $arch workspace, which has no GPU.
    cpu-class plans (jetstream3, octane, kraken, sunspider) do run in here,
    with either a browser or a JSCOnly config. For a 32-bit rendering number
    boot a bench system on the board and use `wk pi bench` -- that is a device,
    not a container."
    fi

    local build_dir; build_dir=$(config_build_dir)

    if [ "$runner" = browser ] && [ -z "$BROWSER" ]; then
        case "$CFG_PORT" in
            --wpe) BROWSER=minibrowser-wpe ;;
            --gtk) BROWSER=minibrowser-gtk ;;
            *)     die "no benchmark browser for port $CFG_PORT" ;;
        esac
    fi
    [ -n "$SOFTWARE" ] && SOFTWARE_REASON="--software"

    # A cpu-class benchmark still needs a window: with no usable display it
    # runs headless rather than not at all, since the display isn't the
    # measurement, and is still recorded as software so comparing it warns.
    if [ "$runner" = browser ] && [ "$class" = cpu ] && [ -z "$SOFTWARE" ]; then
        local sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wk/display/wayland-0"
        if ! arch_has_gpu "$arch" || [ ! -S "$sock" ]; then
            SOFTWARE=1; SOFTWARE_REASON="cpu-class, no usable display"
        else
            case "$(session_mode)" in
                gpu|none) ;;
                *) SOFTWARE=1; SOFTWARE_REASON="cpu-class, session not on the GPU" ;;
            esac
        fi
        [ -n "$SOFTWARE" ] && info "cpu-class: running headless ($SOFTWARE_REASON)"
    fi

    preflight "$ws" "$build_dir" "$class" "$runner"

    # Both host paths under the store; the container sees the same trees at
    # /cache/bench and /bench.
    local seeded seeded_ctr
    SEED_WS="$ws"
    seeded=$(seed_payload "$plan")
    seeded_ctr=""
    [ -n "$seeded" ] && seeded_ctr="/cache/bench/$(basename "$seeded")"

    # One task per invocation, one run in it; the container sees the store
    # at /bench, so the run's store-relative path is what run-benchmark is
    # told to write to.
    local id="$(date -u +%Y%m%dT%H%M%SZ)-$plan-$ws"
    local task="$(bench_task_stamp)-$ws"
    bench_task_new "$task" subject.kind=workspace subject.spec="$ws" \
        devices="container=$CONFIG" plans="$plan" rounds=1 slots="$ws" count="$COUNT" \
        --command "wk bench $ws $plan --config $CONFIG${COUNT:+ --count $COUNT}"
    local rel="$task/runs/$id"
    local out="$BENCH_DIR/$rel"
    ensure_dir "$out"

    local sha; sha=$(t_exec "$ws" git -C /src/WebKit rev-parse HEAD 2>/dev/null | tr -d '\r\n')

    # Written before the run so it exists even if the run dies.
    local display cpu_model
    display=$(for c in /sys/class/drm/*/status; do
                  [ "$(cat "$c" 2>/dev/null)" = connected ] || continue
                  d=$(dirname "$c")
                  printf '%s %s; ' "$(basename "$d")" "$(head -1 "$d/modes" 2>/dev/null)"
              done)
    cpu_model=$(awk -F: '/Model name/ {gsub(/^ +/,"",$2); print $2; exit}' <(lscpu) 2>/dev/null || true)

    # session_mode is which chip the compositor was on: gpu, bmc (the BMC's
    # chip, software rendered), or none for somebody's own desktop. display
    # matters since MotionMark scores scale with the surface being animated,
    # a fullscreen browser's surface being the display mode. host.kernel_arch
    # is the *kernel's* width, beside the build's arch above: an armhf build
    # on an armhf kernel and one on an arm64 kernel both report arch=armhf
    # but are different measurements. A container borrows the host's kernel,
    # so this is the host's answer.
    bench_configuration_args
    wkdata env-record "$out/env.json" \
        plan="$plan" workspace="$ws" config="$CONFIG" browser="$BROWSER" task="$task" \
        webkit_sha="$sha" count="$COUNT" local_copy="$seeded" \
        software_reason="$SOFTWARE_REASON" \
        class="$class" runner="$runner" arch="$arch" bench_host="$BENCH_HOST" \
        preflight_notes="$PREFLIGHT_NOTES" gpu_renderer="${GPU_RENDERER:-}" \
        session_mode="${SESSION_MODE:-$(session_mode)}" display="$display" \
        host.kernel="$(uname -r)" host.cpu="$cpu_model" host.cores="$(host_cores)" \
        host.kernel_arch="$(uname -m)" \
        host.governor="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo unknown)" \
        host.nvidia_driver="$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1 || true)" \
        host.root_device="$(bench_root_device "$WK_STORE")" \
        host.container_cpus="$(envelope_cores)" host.container_mem_mb="$(envelope_mem_mb)" \
        cores.set="$CORES" \
        ${BENCH_CFG_ARGS[@]+"${BENCH_CFG_ARGS[@]}"} \
        --bool forced="$FORCE" --bool software="$SOFTWARE" --bool cores.pinned="$CORES"

    local wall_start; wall_start=$(date +%s)

    # The jsc runner writes its own result.json and reports for itself.
    if [ "$runner" = jsc ]; then
        set +e
        run_jsc "$ws" "$plan" "$out" "$seeded" "$seeded_ctr" /src/WebKit
        local jrc=$?
        set -e
        wkdata env-record "$out/env.json" --update wall_time_s="$(( $(date +%s) - wall_start ))"
        [ "$jrc" -eq 0 ] || exit "$jrc"

        info "BENCH OK  $plan -> $out/result.json"
        tr '\r' '\n' < "$out/run-1.log" | grep -iE '^(Score|Total|.*Score:)' \
            | tail -5 | sed 's/^/  /' >&2 || true
        log ""
        log "  compare with:  wk bench report <other-run> $out"
        return 0
    fi

    info "running $plan in '$ws' ($CONFIG, $BROWSER)"
    log  "  results: $out"

    # Software rendering: llvmpipe through Mesa, the dmabuf renderer off, and no
    # Wayland display -- so WPE and GTK both fall back to their headless paths
    # instead of failing to connect to a compositor that is not there.
    local run_env=""
    local browser_args="$BROWSER_ARGS"
    if [ -n "$SOFTWARE" ]; then
        # __EGL_VENDOR_LIBRARY_FILENAMES is what actually decides it.
        # LIBGL_ALWAYS_SOFTWARE and GALLIUM_DRIVER only steer Mesa; with the
        # NVIDIA vendor still listed in /usr/share/glvnd/egl_vendor.d, glvnd
        # loads it for the GBM and device platforms and the run is quietly
        # hardware-accelerated while calling itself software. Pinning glvnd
        # to the Mesa vendor is what makes the label true.
        run_env="WAYLAND_DISPLAY= WEBKIT_DISABLE_DMABUF_RENDERER=1"
        run_env="$run_env LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe"
        run_env="$run_env __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json"
        browser_args="--headless $browser_args"
    fi

    # Padding the build directory, not one binary inside it: run-benchmark
    # resolves MiniBrowser/WPEWebProcess relative to --build-directory, so
    # padding that one path pads every binary it launches.
    local run_build_dir="$build_dir"
    if [ "${WK_BENCH_PATH_PAD:-0}" -gt 0 ] 2>/dev/null; then
        _bench_pad_runner() { t_exec "$ws" "$@"; }
        run_build_dir=$(bench_padded_path _bench_pad_runner "$build_dir")
    fi

    local args="--plan $plan --browser $BROWSER --build-directory $run_build_dir"
    args="$args --output-file /bench/$rel/result.json --no-adjust-unit --show-iteration-values"
    [ -n "$COUNT" ] && args="$args --count $COUNT"
    [ -n "$seeded_ctr" ] && args="$args --local-copy $seeded_ctr"
    [ -n "$SUBTESTS" ] && args="$args --subtests $SUBTESTS"
    # Positional and last: run-benchmark passes these straight to the
    # browser, and anything starting with a dash needs the -- separator.
    [ -n "$browser_args" ] && args="$args -- $browser_args"

    local aslr; aslr=$(bench_aslr_wrap)
    local cores_wrap; cores_wrap=$(bench_cores_wrap)
    local pad_prelude; pad_prelude=$(bench_env_pad_prelude)

    set +e
    run_watched "$out/run.log" -- \
        t_exec "$ws" bash -lc "cd /src/WebKit && ${pad_prelude} \
            $run_env ${cores_wrap}${aslr}Tools/Scripts/run-benchmark $args"
    local rc=$?
    set -e

    if [ "$rc" -ne 0 ]; then
        warn "run-benchmark exited $rc"
        first_error "$out/run.log" | sed 's/^/  /' >&2 || true
        log "  full log: $out/run.log"
        exit "$rc"
    fi

    wkdata env-record "$out/env.json" --update wall_time_s="$(( $(date +%s) - wall_start ))"

    info "BENCH OK  $plan -> $out/result.json"
    # Surfaces the score line out of run-benchmark's own summary table.
    tr '\r' '\n' < "$out/run.log" | grep -iE '^(Score|Total|.*Score:)' | tail -5 | sed 's/^/  /' >&2 || true
    log ""
    log "  compare with:  wk bench report <other-run> $out"
}

# --- comparison --------------------------------------------------------------
# `wkdata.py report` does the statistics; this only resolves run directories
# to result.json files and refuses a comparison naming nothing. Either side
# may be a comma-separated list of runs, pooled into the same subtest arrays.
# A run is a directory: the path `wk bench ls` prints, or that path relative
# to the store (<task>/runs/<run>). One path per line, never space-joined:
# the benchmark volume is named `WK Bench` by default, so a result path on
# it contains spaces and cannot be word-split back apart.
_compare_files() {
    local spec="$1" which="$2" n=0 one d
    local IFS=,
    for one in $spec; do
        [ -n "$one" ] || continue
        d="$one"
        [ -d "$d" ] || d="$BENCH_DIR/$one"
        [ -f "$d/result.json" ] || die "no such run in $which: $one (a run directory, from 'wk bench ls')"
        printf '%s\n' "$d/result.json"
        n=$((n + 1))
    done
    [ "$n" -gt 0 ] || die "no runs given for $which"
}

# Newline-separated paths into an array. Spelled out rather than `mapfile`
# because this half runs on the Mac, where `wk` is bash 3.2.
_lines_into() {  # $1 = array name, $2 = newline-separated string
    local __name="$1" __one
    eval "$__name=()"
    while IFS= read -r __one; do
        [ -n "$__one" ] || continue
        eval "$__name+=(\"\$__one\")"
    done <<EOF
$2
EOF
}

# wk bench report <task> [--html] [--text]
# wk bench report <run-a> <run-b> [--html out.html] [--text]
# One argument is a task: `wkdata.py task-report` pairs its rounds by the
# round and arm each run recorded, reports what is there, and says whether
# the task is running (its lock), complete or stopped short. Two are run
# directories (aspec/bspec, comma-separated to pool), handed to `wkdata.py
# report`. Both read results directly from the store or a macOS staged tree,
# no workspace needed; `wk bench compare` is the two-run call in text mode.
_REPORT_USAGE="usage: wk bench report <task> [--html] [--text]
       wk bench report <run-a> <run-b> [--html out.html] [--text]; see wk bench -h"
cmd_report() {
    local aspec="" bspec="" html="" text=""
    local positional=()
    while [ $# -gt 0 ]; do
        case "$1" in
            # `--html out.html` names a file in the two-run form; a bare
            # `--html` is the task form's, whose files are named for it.
            --html) case "${2:-}" in *.html) html="$2"; shift 2 ;; *) html=1; shift ;; esac ;;
            --text) text=1; shift ;;
            -*) die "$_REPORT_USAGE" ;;
            # A third bare word is `wk bench compare`'s <ws> -- accepted here
            # (this function backs both) and ignored below; a fourth is not.
            *) positional+=("$1"); shift ;;
        esac
    done
    [ ${#positional[@]} -le 3 ] || die "$_REPORT_USAGE; unexpected argument: ${positional[3]}"
    [ ${#positional[@]} -ge 1 ] || die "$_REPORT_USAGE"

    if [ ${#positional[@]} -eq 1 ]; then
        local task="${positional[0]}" dir running=()
        dir=$(bench_task_dir "$task")
        [ -f "$dir/task.json" ] \
            || die "no such task '$task' ($dir has no task.json). 'wk bench ls' lists the tasks;
    two run directories compare any two runs."
        [ "$html" != 1 ] && [ -n "$html" ] \
            && die "a task's html reports are named for it (report-<device>-<plan>.html, in $dir); --html takes no file here"
        lock_alive "bench-task-$task" && running=(--running)
        wkdata task-report "$dir" ${running[@]+"${running[@]}"} ${html:+--html} ${text:+--text}
        return
    fi
    aspec="${positional[0]}"; bspec="${positional[1]:-}"
    [ -n "$bspec" ] || die "$_REPORT_USAGE"
    [ "$html" != 1 ] || die "the two-run form writes where it is told: --html out.html"

    local ca_s cb_s ca cb
    ca_s=$(_compare_files "$aspec" "-a"); cb_s=$(_compare_files "$bspec" "-b")
    _lines_into ca "$ca_s"; _lines_into cb "$cb_s"

    # A single-iteration run has no variance, so its p-values are all "-".
    # Said here rather than left to be noticed in the table.
    local r
    for r in "${ca[0]}" "${cb[0]}"; do
        if [ "$(wkdata get "$(dirname "$r")/env.json" count 2>/dev/null)" = 1 ]; then
            warn "run '$(basename "$(dirname "$r")")' has count=1: no p-value can be computed"
            log  "  re-run with --count 2 or more for a comparison with statistics"
        fi
    done

    local join; join=$(IFS=,; printf '%s' "${ca[*]}")
    local join_b; join_b=$(IFS=,; printf '%s' "${cb[*]}")
    local extra=()
    [ -n "$html" ] && extra+=("--html" "$html")
    [ -n "$text" ] && extra+=("--text")
    wkdata report "$join" "$join_b" ${extra[@]+"${extra[@]}"}
}

# Two arms from different sessions differ by ~2% on identical builds; arms
# interleaved in one session hold to 0.4%. A comparison across sessions is
# reported with that caveat, never as a measurement of the change.
cmd_compare() {
    cmd_report "$@" --text
}

# --- staging a build onto a machine that will run it --------------------------
# Builds inside the VM, runs outside on bare metal (docs/HANDOFF-mac-perf-mode.md).
# Staging is a copy -- rsync onto a fixed path the other role finds when it
# boots, while this machine is in host mode and the benchmark volume is
# mounted. What is staged:
#
#   WebKitBuild/<config>   the product being measured.
#   Tools/                 run-benchmark, webkitpy, plan files -- the
#                          smallest tree that can drive a run; the install
#                          has no checkout and must not grow one.
#   stage.json             workspace, sha, config, build/stage time,
#                          wk-tools version -- decided here, since the
#                          other role can't ask a guest anything.
#
# Carries bench_host=image, which `wk bench compare` refuses to compare
# against a container run.
# TODO: exercise the run half end to end; only staging (layout, provenance,
# refusals) is tested so far.
cmd_stage() {
    local ws="$1" machine="" config="" plan="" payload="" dry=""
    shift

    # This copies a build onto a disk mounted on the workstation, so it
    # cannot run from inside a workspace. The device lane's staging verb is
    # `wk pi deploy`, which puts a build on a machine over the network
    # instead. Checked here rather than left to fail as a missing
    # b_bench_root further down.
    if in_workspace; then
        die "'wk bench stage' copies a build onto a benchmark volume attached to the
    workstation, and this is workspace '$(wk_self)' -- there is no such volume
    here and no route to one.
    To put a build on a bench *device* from in here, which is a request the
    broker does serve:  wk pi deploy $ws <machine>
    For the macOS lane, run it on the Mac:  wk bench stage $ws --to <machine>"
    fi
    while [ $# -gt 0 ]; do
        case "$1" in
            --to)      machine="${2:-}"; shift 2 ;;
            --config)  config="${2:-}"; shift 2 ;;
            --plan)    plan="${2:-}"; shift 2 ;;
            # A directory on this machine, copied in beside the build so the
            # run needs no network and cannot silently measure a different
            # benchmark revision than last time -- same argument `wk bench
            # seed` makes for a container run.
            --payload) payload="${2:-}"; shift 2 ;;
            --dry-run) dry=1; shift ;;
            *) die "unknown option: $1
    usage: wk bench stage <workspace> --to <machine> [--config C] [--plan P]
                          [--payload <dir>] [--dry-run]" ;;
        esac
    done
    require_name "$ws"
    [ -n "$machine" ] || die "which machine is going to run it? --to <machine> (wk boot --list)"

    # The machine, and its other role's disk. Loaded through the same
    # registry and driver `wk boot` uses: where a staged payload goes is a
    # property of the machine's boot arrangement, not this runner's opinion.
    . "$WK_ROOT/boot/machines.sh"
    machine_load "$machine" || die "unknown machine '$machine' (wk boot --list)"
    load_driver "$MACH_DRIVER"
    command -v b_bench_root >/dev/null 2>&1 \
        || die "$machine has no place to stage a build onto from here.
    Its other role is reached over the network rather than mounted, so the
    payload is pushed to it while it runs rather than copied to it while it
    does not -- see docs/HANDOFF-boot.md, 'Storage'."
    local root
    root=$(b_bench_root) || die "$machine's benchmark disk is not attached, so there is nowhere to
    stage a build onto. 'wk boot $machine --status' says what it can see."

    # Is that path reachable from here, or does the payload have to be sent?
    # The MBP's benchmark disk is *mounted* while it is being staged onto,
    # which is what makes staging a copy; every other machine in the fleet
    # has to be sent the payload over the network.
    local deliver=""
    if command -v b_bench_local >/dev/null 2>&1 && ! b_bench_local; then
        command -v b_bench_put >/dev/null 2>&1 \
            || die "$machine's staging root is not reachable from here and its driver
    has no way to send a payload to it (b_bench_put)."
        deliver=1
    fi

    # Deliberately not load_bench_target, which refuses everything but a
    # container: right for running a benchmark here, wrong for staging one
    # whose whole point is that the build came from a macOS guest.
    local t; t="$(ws_target "$ws")"
    load_target "$t"
    wait_ready "$ws"

    [ -n "$config" ] || config="${WK_CONFIG:-$(default_config)}"
    config_load "$config" || die "unknown config '$config' (wk build --list)"

    local src build_dir
    src=$(t_src "$ws")
    build_dir=$(config_build_dir "$src")
    t_exec "$ws" test -d "$build_dir" 2>/dev/null \
        || die "'$ws' has no $config build to stage ($build_dir).
    Build it first:  wk build $ws $config"

    # Asked of the checkout now, not read from any record: a staged payload
    # naming the wrong commit is worse than one naming none, since it's the
    # only thing the other role can say about what it measured.
    local sha; sha=$(t_exec "$ws" bash -lc "cd $(sh_quote "$src") && git rev-parse HEAD" 2>/dev/null | tr -d '\r' | tail -1) || sha=""

    local stamp dest
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    dest="$root/staged/$stamp-$config"

    # How this machine is put into bench mode, in its own words: the arming
    # models arrive at the same place by different routes.
    local arm_hint run_hint
    case "${BOOT_ARMING:-one-shot}" in
        hands-on) arm_hint="wk boot $machine        arm it; it prints the ritual (you pick the disk)"
                  run_hint="wk bench staged${plan:+ --plan $plan}       once it has booted, over there" ;;
        guest)    arm_hint="wk boot $machine        start the guest -- for a guest that *is* the transition"
                  run_hint="wk enter ${MACH_GUEST:-<guest>} -- wk bench staged${plan:+ --plan $plan}" ;;
        *)        arm_hint="wk boot $machine        arm the one-shot and reboot into it"
                  run_hint="wk bench staged${plan:+ --plan $plan}       on the machine, once it is up" ;;
    esac

    if [ -n "$dry" ]; then
        info "dry run -- nothing was staged"
        log  "  from:   '$ws' ($t), $config at ${sha:0:12}"
        log  "          $build_dir"
        log  "          $src/Tools"
        log  "  to:     $dest   (on $machine${MACH_VOLUME:+, $MACH_VOLUME})"
        [ -n "$payload" ] && log "  payload: $payload -- copied in, so the run needs no network"
        log  "  then:   $arm_hint"
        return 0
    fi

    info "staging $config from '$ws' onto $machine${MACH_VOLUME:+ ($MACH_VOLUME)}"

    # Where the tree is assembled: the destination itself for a mounted
    # disk, or a directory here that is then delivered and removed.
    local build assemble="$dest"
    if [ -n "$deliver" ]; then
        assemble="$(wk_state_dir)/bench-stage/$stamp-$config"
        rm -rf "$assemble"
    fi
    mkdir -p "$assemble"

    # Products, not the build tree. A full `WebKitBuild/Release` runs tens of
    # gigabytes, almost all intermediates (*.build, XCBuildData, static
    # libs) -- a machine that will never compile anything needs only the
    # frameworks, dylibs, XPC services and MiniBrowser.app that the browser
    # driver launches and DYLD_FRAMEWORK_PATH resolves against.
    log  "  the build product (frameworks and MiniBrowser.app; no intermediates)"
    build="$assemble/WebKitBuild/$(basename "$build_dir")"
    t_pull_dir "$ws" "$build_dir" "$build" \
        --exclude '*.build' --exclude 'XCBuildData' --exclude 'DerivedSources' \
        --exclude 'PrecompiledHeaders' --exclude 'compile_commands' \
        --exclude '*.a' --exclude '*.dSYM' --exclude '*.noindex'
    log  "  Tools/ -- run-benchmark, webkitpy and the plans"
    t_pull_dir "$ws" "$src/Tools" "$assemble/Tools"

    if [ -n "$payload" ]; then
        [ -d "$payload" ] || die "no such payload directory: $payload"
        log  "  the benchmark itself, pinned ($(basename "$payload"))"
        rm -rf "$assemble/payload"
        mkdir -p "$assemble/payload"
        # --exclude .git: `--payload <dir>` takes any directory, and a
        # working clone can carry git's fsmonitor socket, which no copy tool
        # can reproduce. `wk bench seed` itself already leaves no .git.
        rsync -a --exclude '.git' "$payload/" "$assemble/payload/"
    fi

    # Written last, the publishing protocol every store in this repo uses
    # (lib/image.sh, lib/store.sh): until it exists this directory is rubble.
    cat > "$assemble/stage.json" <<EOF
{
  "staged_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "staged_by": "$(hostname)",
  "workspace": "$ws",
  "workspace_target": "$t",
  "config": "$config",
  "webkit_sha": "$sha",
  "plan": "${plan:-}",
  "payload_pinned": $([ -n "$payload" ] && echo true || echo false),
  "machine": "$machine",
  "volume": "${MACH_VOLUME:-}",
  "wk_tools": "$("$WK_ROOT/cmd/version" --tree 2>/dev/null || echo unknown)",
  "bench_host": "image"
}
EOF

    if [ -n "$deliver" ]; then
        info "sending it to $machine ($(du -sh "$assemble" 2>/dev/null | cut -f1))"
        # The manifest crosses last, on its own: a delivery is minutes of
        # rsync with no order guarantee, so a stage.json carried along with
        # the bulk could arrive before the payload and a half-delivered
        # payload would look finished.
        mv "$assemble/stage.json" "$assemble/.stage.json.pending"
        b_bench_put "$assemble" "$dest" || die "could not deliver the payload to $machine"
        mv "$assemble/.stage.json.pending" "$assemble/stage.json"
        b_bench_put_file "$assemble/stage.json" "$dest/stage.json" \
            || die "delivered the payload to $machine but could not publish its manifest.
    Nothing will use it until one is there -- re-run the stage."
        rm -rf "$assemble"
    fi

    info "staged: $dest${MACH_VOLUME:+ on $MACH_VOLUME}"
    [ -n "$deliver" ] || log "  $(du -sh "$dest" 2>/dev/null | cut -f1) on $MACH_VOLUME"
    log  ""
    log  "  next:"
    log  "    $arm_hint"
    log  "    $run_hint"
    log  "    wk boot $machine --back   leave the role again; the result stays"
    log  "                              on the machine that took it"
}

# --- running a staged build, in the role that was booted for it ---------------
# The other half of `wk bench stage`: the machine has rebooted into its
# benchmark install, the payload is on the volume that is now `/`, and this
# runs it and records what it ran on.
#
#   run-benchmark drives from a *partial* tree: plan files and patches
#   resolve relative to webkitpy itself, not against a checkout, so
#   `Tools/Scripts` alone is enough.
#   `--build-directory <dir>` makes the driver launch MiniBrowser.app itself
#   with DYLD_FRAMEWORK_PATH set, instead of going through
#   Tools/Scripts/run-minibrowser, which would need a checkout; it requires
#   the build directory contain a *.framework.
#   the interpreter must have PyObjC: prepare_env's first import is a bare
#   `import objc`, and pyobjc-core is not autoinstalled. Which python3 has
#   it varies by machine, so the interpreter is found by property and named
#   explicitly (staged_python below), not left to `#!/usr/bin/env python3`.
#   everything else webkitpy needs it installs itself into the staged tree
#   on first use, needing the network once.
#
# The refusal --force does not open: a benchmark runs in bench mode or it
# does not run, since a workstation run shares the machine with a desktop,
# a podman VM, whatever else is open, and produces a number indistinguishable
# on paper from a bare-metal one. `--dry-run` still describes it.
staged_python() {
    local p
    for p in "${WK_BENCH_PYTHON:-}" /usr/bin/python3 \
             /Library/Developer/CommandLineTools/usr/bin/python3 \
             /usr/local/bin/python3 /opt/homebrew/bin/python3; do
        [ -n "$p" ] || continue
        [ -x "$p" ] || continue
        "$p" -c 'import objc' >/dev/null 2>&1 || continue
        printf '%s' "$p"; return 0
    done
    return 1
}

# The fallback, so every message and dry run has something to name even when
# nothing on the machine qualifies.
STAGED_PY="$(staged_python || echo /usr/bin/python3)"

# Where the staged payloads are: `/` in bench mode, a mounted disk in host
# mode -- the same b_bench_root `wk bench stage` writes into.
staged_root() {
    # An explicit answer wins: this is also how the runner is exercised from
    # host mode, by pointing it at a disposable volume -- the only way to
    # reach bench mode's code path without rebooting into it.
    [ -n "${WK_BENCH_ROOT:-}" ] && { printf '%s' "$WK_BENCH_ROOT"; return 0; }
    if in_bench_mode; then
        printf '/var/wk'
        return 0
    fi
    . "$WK_ROOT/boot/machines.sh"
    # No default: host mode has two macOS machines in the registry (mbp,
    # benchvm) and nothing here can tell which one this process is running
    # on, so the caller has to say.
    if [ -z "${WK_BENCH_MACHINE:-}" ]; then
        debug "WK_BENCH_MACHINE is not set -- staged_root cannot pick between this fleet's macOS machines"
        return 1
    fi
    machine_load "$WK_BENCH_MACHINE" || return 1
    load_driver "$MACH_DRIVER"
    command -v b_bench_root >/dev/null 2>&1 || return 1
    b_bench_root
}

# The newest staged payload with a manifest, or the one named. The manifest
# is written last by `wk bench stage`, so a payload without one is an
# interrupted copy and is ignored rather than measured.
staged_pick() {
    local root="$1" want="${2:-}" d
    if [ -n "$want" ]; then
        [ -f "$root/staged/$want/stage.json" ] || return 1
        printf '%s' "$root/staged/$want"; return 0
    fi
    for d in $(ls -1r "$root/staged" 2>/dev/null); do
        [ -f "$root/staged/$d/stage.json" ] || continue
        printf '%s' "$root/staged/$d"; return 0
    done
    return 1
}

staged_field() {
    wkdata get "$1/stage.json" "$2" 2>/dev/null
}

cmd_staged() {
    local id="" plan="" dry="" list="" PAYLOAD="" TIMEOUT=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --id)       id="${2:-}"; shift 2 ;;
            --plan)     plan="${2:-}"; shift 2 ;;
            --count)    COUNT="${2:-}"; shift 2 ;;
            --subtests) SUBTESTS="${2:-}"; shift 2 ;;
            --browser-args) BROWSER_ARGS="${2:-}"; shift 2 ;;
            # Pinned, same argument as `wk bench seed` for a container run:
            # left alone, run-benchmark clones the benchmark from GitHub on
            # every run.
            --payload)  PAYLOAD="${2:-}"; shift 2 ;;
            --timeout)  TIMEOUT="${2:-}"; shift 2 ;;
                --dry-run)  dry=1; shift ;;
            --ls)       list=1; shift ;;
            *) die "unknown option: $1
    usage: wk bench staged [--plan P] [--id <staged-id>] [--count N]
                           [--subtests \"A B\"] [--ls] [--dry-run] [--force]" ;;
        esac
    done

    is_macos || die "'wk bench staged' is macOS bench mode. The Linux systems
    run their benchmark from the machine that drives them -- `wk pi bench`."

    local root
    root=$(staged_root) || die "this machine has no benchmark volume to read.
    In host mode, set WK_BENCH_MACHINE to which fleet machine this is (mbp or
    benchvm -- 'wk boot --list') and make sure its volume is attached ('wk boot
    mbp --status'); in bench mode /etc/wk-image says which system is running."

    if [ -n "$list" ]; then
        local d
        [ -d "$root/staged" ] || { log "(nothing staged on $root)"; return 0; }
        for d in $(ls -1 "$root/staged" 2>/dev/null | sort); do
            [ -f "$root/staged/$d/stage.json" ] || { printf '  %-34s (incomplete)\n' "$d" >&2; continue; }
            printf '  %-34s %s %s\n' "$d" \
                "$(staged_field "$root/staged/$d" config)" \
                "$(staged_field "$root/staged/$d" webkit_sha | cut -c1-10)" >&2
        done
        [ -d "$root/results" ] && { log ""; log "  results:"; ls -1 "$root/results" 2>/dev/null | sed 's/^/    /' >&2; }
        return 0
    fi

    local dir
    dir=$(staged_pick "$root" "$id") || die "nothing staged on this machine's benchmark volume${id:+ under '$id'}.
    Stage a build from the workspace that built it:
        wk bench stage <workspace> --to mbp --config mac-release"

    local config sha ws
    config=$(staged_field "$dir" config)
    sha=$(staged_field "$dir" webkit_sha)
    ws=$(staged_field "$dir" workspace)
    [ -n "$plan" ] || plan=$(staged_field "$dir" plan)
    [ -n "$plan" ] || die "which benchmark? --plan <name>
    (the staged payload does not name one; 'wk bench staged --ls' shows what
    is here, and Tools/Scripts/run-benchmark --list-plans what it can run)"

    local build_dir runner_script out_id out
    build_dir=$(ls -d "$dir"/WebKitBuild/* 2>/dev/null | head -1)
    runner_script="$dir/Tools/Scripts/run-benchmark"
    out_id="$(date -u +%Y%m%dT%H%M%SZ)-$plan-$(basename "$dir")"
    out="$root/results/$out_id"

    # --- what has to be true, measured -------------------------------------
    info "preflight"

    local role marker_faked=""
    if in_bench_mode; then
        role=$(wk_image_id)
        # The override exists so this code path can be exercised on a
        # machine that hasn't been rebooted (lib/common.sh, WK_IMAGE_MARKER).
        # It is announced and recorded rather than merely allowed: a
        # workstation run must never be *reported* as a benchmark-role run.
        if [ "$WK_IMAGE_MARKER" != /etc/wk-image ]; then
            marker_faked=1
            warn "WK_IMAGE_MARKER points at $WK_IMAGE_MARKER, not /etc/wk-image"
            log  "  this run is being told it is in bench mode. If that is"
            log  "  not true, the number is a workstation number. Recorded as such."
        fi
        check yes "bench mode" "${role:-image}${marker_faked:+ (marker overridden)}"
    elif [ -n "$dry" ]; then
        # A dry run describes; it does not refuse.
        check no "bench mode" "this is host mode -- a real run refuses"
    else
        # Not forceable: the workstation and the benchmark install produce
        # results indistinguishable on paper and incomparable in fact.
        die "this is host mode, and a benchmark does not run here.
    Nothing about a run on this machine-as-workstation is comparable with one
    on the benchmark install -- same command, same plan, same shape of result,
    a different machine underneath it -- and there is no way to tell the two
    apart afterwards. So it does not run.
        wk boot mbp        arm it; it prints the two clicks
        ... boot the benchmark volume, then run this there ...
    'wk bench staged --dry-run' still shows what it would do from here."
    fi

    if [ -x "$runner_script" ]; then
        check yes "run-benchmark" "$runner_script"
    else
        check no  "run-benchmark" "not in the staged tree: $runner_script"
    fi

    if [ -n "$build_dir" ] && [ -x "$build_dir/MiniBrowser.app/Contents/MacOS/MiniBrowser" ]; then
        if ls "$build_dir"/*.framework >/dev/null 2>&1; then
            check yes "the build" "$(basename "$build_dir") ${sha:+@${sha:0:10}}"
        else
            # The driver raises on this, deep inside python.
            check no "the build" "no *.framework in $build_dir -- the driver refuses it"
        fi
    else
        check no "the build" "no MiniBrowser.app in ${build_dir:-$dir/WebKitBuild}"
    fi

    if "$STAGED_PY" -c 'import objc' >/dev/null 2>&1; then
        check yes "python with PyObjC" "$STAGED_PY ($("$STAGED_PY" -V 2>&1))"
    else
        check no "python with PyObjC" "no python3 here can 'import objc' (tried /usr/bin, the CLT, Homebrew)"
        log  "        the browser driver needs it and does not autoinstall it. Either:"
        log  "          xcode-select --install                      (the CLT python3 ships it)"
        log  "          $STAGED_PY -m pip install --user pyobjc-framework-Quartz pyobjc-framework-Cocoa"
        log  "        or point WK_BENCH_PYTHON at one that has it."
    fi

    # A benchmark needs the *console* session: driven over ssh with nobody
    # logged in at the screen, MiniBrowser has nowhere to draw and the run
    # hangs rather than failing.
    local console; console=$(stat -f %Su /dev/console 2>/dev/null)
    if [ "$console" = "$(id -un)" ]; then
        check yes "the console session" "$console is logged in at the screen"
    else
        check no "the console session" "the screen belongs to '${console:-nobody}', not $(id -un)"
    fi

    # A session that exists is not one that's usable: an onboarding pane
    # (Setup Assistant after a major upgrade, among others) owns the
    # frontmost window until answered, and a background browser is throttled
    # silently -- no error, just no progress until run-benchmark times out.
    # A process check rather than AppleScript: window-title queries need
    # assistive access a fresh install hasn't granted. The .app suffix
    # excludes the always-running SoftwareUpdateSubscriber XPC service.
    local blocker; blocker=$(screen_blocker)
    if [ -n "$blocker" ]; then
        check no "the screen is free" "'$blocker' is running and owns the front window"
        log  "        a benchmark in a background window is throttled, so the run would"
        log  "        time out rather than fail. Answer it at the screen, or for an"
        log  "        install that should never show it:"
        log  "          sudo touch /var/db/.AppleSetupDone   (before its first boot)"
    else
        check yes "the screen is free" "no onboarding or installer pane in front"
    fi

    # The panel that is not an application: screen_blocker cannot see a
    # modal authentication sheet, since macOS draws it from SecurityAgent,
    # which never becomes the frontmost *application*.
    local panel; panel=$(auth_panel)
    if [ -n "$panel" ]; then
        check no "no auth panel" "$panel has a modal dialog up -- it is above the browser"
        log  "        it does not answer SIGTERM (it holds XPC transactions open while its"
        log  "        sheet is modal), so dismissing it means:"
        log  "          sudo killall -9 SecurityAgent"
    else
        check yes "no auth panel" "no modal authentication dialog"
    fi

    # A laptop on battery throttles silently. A machine with no battery --
    # a desktop, or a guest -- is on AC by construction.
    local _batt; _batt=$(pmset -g batt 2>/dev/null | head -1)
    case "$_batt" in
        *"AC Power"*)      check yes "power" "AC" ;;
        *"Battery Power"*) check no  "power" "on battery -- the CPU is not the same CPU" ;;
        *)                 check yes "power" "no battery (a desktop, or a guest)" ;;
    esac

    # Everything the machine is doing that a run cannot pause (lib/quiet.sh).
    log "  the machine itself:"
    local quiet=yes
    macos_noise || quiet=no
    [ "$quiet" = yes ] || check no "quiet machine" "see above -- 'wk quiesce on' first"

    if [ "$PREFLIGHT_FAILS" -gt 0 ]; then
        if [ -n "$dry" ]; then
            warn "$PREFLIGHT_FAILS preflight check(s) would fail -- a real run would stop here"
        elif [ -z "$FORCE" ]; then
            die "$PREFLIGHT_FAILS preflight check(s) failed. Fix them, or --force to
    record the result with the failures attached to it."
        else
            warn "$PREFLIGHT_FAILS preflight failure(s) FORCED -- recorded with the result"
        fi
    fi

    # --- the run ------------------------------------------------------------
    # Padding the build directory (same reasoning as the Linux browser run in
    # cmd_run). Local, not through a runner function: this role has no
    # t_exec, it *is* the machine.
    local run_build_dir="$build_dir"
    if [ "${WK_BENCH_PATH_PAD:-0}" -gt 0 ] 2>/dev/null; then
        run_build_dir=$(bench_padded_path "" "$build_dir")
    fi

    local args="--plan $plan --browser minibrowser --platform osx"
    args="$args --build-directory $(sh_quote "$run_build_dir")"
    args="$args --output-file $(sh_quote "$out/result.json") --no-adjust-unit --show-iteration-values"
    [ -n "$COUNT" ] && args="$args --count $COUNT"
    [ -n "$TIMEOUT" ] && args="$args --timeout $TIMEOUT"
    [ -n "$SUBTESTS" ] && args="$args --subtests $SUBTESTS"
    # Use the pinned payload only when it matches *this* plan: it's one
    # benchmark's checkout, and using it for a mismatched plan can fail
    # loudly inside `patch`, or -- worse, for a related plan like
    # speedometer3.0 vs 3.1 -- patch cleanly and produce a number for the
    # wrong benchmark labelled with the right one. So the manifest's plan is
    # checked, not just the directory's existence; a mismatch fetches instead.
    if [ -z "$PAYLOAD" ] && [ -d "$dir/payload" ]; then
        local payload_plan; payload_plan=$(staged_field "$dir" plan)
        if [ -z "$payload_plan" ] || [ "$payload_plan" = "$plan" ]; then
            PAYLOAD="$dir/payload"
        else
            warn "the pinned payload in this staged tree is for '$payload_plan', not '$plan'"
            log  "  ignoring it -- run-benchmark will fetch $plan itself, which needs the"
            log  "  network. To pin this plan instead:"
            log  "    wk bench stage <ws> --to <machine> --plan $plan --payload \\"
            log  "        \"\$(wk bench seed <ws> $plan)\""
        fi
    fi
    [ -n "$PAYLOAD" ] && args="$args --local-copy $(sh_quote "$PAYLOAD")"
    [ -n "$BROWSER_ARGS" ] && args="$args -- $BROWSER_ARGS"

    if [ -n "$dry" ]; then
        info "dry run -- nothing was benchmarked"
        log  "  staged:  $dir"
        log  "  from:    workspace '$ws', $config${sha:+ @${sha:0:10}}"
        log  "  results: $out"
        log  "  would run, in $dir:"
        # The same string the run builds, quoting included: the default
        # volume name "WK Bench" has a space, so an unquoted preview would
        # show something that would not actually work.
        printf '    %s\n' "$(sh_quote "$STAGED_PY") $(sh_quote "$runner_script") $args" >&2
        return 0
    fi

    ensure_dir "$out"
    staged_env_json "$out/env.json" "$dir" "$plan" "$config" "$sha" "$ws" "$role" "$marker_faked"

    info "$plan on $(sysctl -n hw.model), from '$ws' ($config${sha:+ @${sha:0:10}})"
    log  "  results: $out"

    # WK_BENCH_ENV_PAD's dummy variable and WK_BENCH_SHARED_CACHE=avoid's
    # DYLD_SHARED_REGION both have to land in the same shell as run-benchmark.
    local pad_prelude; pad_prelude=$(bench_env_pad_prelude)
    local shared_cache_env=""
    [ "${WK_BENCH_SHARED_CACHE:-}" = avoid ] && shared_cache_env="DYLD_SHARED_REGION=avoid "

    # In the staged tree: webkitpy resolves plans and patches relative to
    # itself and autoinstalls into it.
    local wall_start; wall_start=$(date +%s)
    set +e
    run_watched "$out/run.log" -- \
        bash -lc "cd $(sh_quote "$dir") && ${pad_prelude}${shared_cache_env}$(sh_quote "$STAGED_PY") $(sh_quote "$runner_script") $args"
    local rc=$?
    set -e
    wkdata env-record "$out/env.json" --update wall_time_s="$(( $(date +%s) - wall_start ))" \
        configuration.aslr="$(mac_aslr_probe)"

    staged_restore_desktop

    if [ "$rc" -ne 0 ]; then
        warn "run-benchmark exited $rc"
        # first_error knows what a *build* failure looks like; a benchmark
        # fails with a python traceback, so fall back to the tail.
        local _err; _err=$(first_error "$out/run.log" || true)
        if [ -n "$_err" ]; then
            printf '%s\n' "$_err" | sed 's/^/  /' >&2
        else
            tr '\r' '\n' < "$out/run.log" | tail -3 | sed 's/^/  /' >&2 || true
        fi
        log "  full log: $out/run.log"
        exit "$rc"
    fi

    info "BENCH OK  $plan -> $out/result.json"
    tr '\r' '\n' < "$out/run.log" | grep -iE '^(Score|Total|.*Score:)' | tail -5 | sed 's/^/  /' >&2 || true
    log ""
    log "  it is on the benchmark volume, so it survives the way back:"
    log "    wk boot mbp --back        reboot back into host mode"
    log "    wk bench staged --ls      list it from over there"
    log "    wk bench report <other> $out/result.json"
}

# The macOS browser driver turns the Dock's launch animation off before a
# run (prepare_env) and back on after it (restore_env) -- but restore_env
# does not run when the run raises, which a timed-out benchmark does. Put
# back here, and only when it is actually off, so this never fights webkitpy
# for it.
staged_restore_desktop() {
    [ "$(defaults read com.apple.dock launchanim 2>/dev/null)" = 0 ] || return 0
    defaults write com.apple.dock launchanim -bool true 2>/dev/null || return 0
    killall Dock 2>/dev/null || true
    info "restored the Dock's launch animation (the run left it off)"
}

# The record, in the same shape `wk bench` writes for a container run, so
# `wk bench compare` can warn about what differs. bench_host is always
# "image" here. `system` is the artifact that booted; `profile` is what it
# was built from, so a stock and an overclocked profile read as two series,
# not noise. role_marker_overridden is true when the role was asserted by
# an override rather than by having booted the image -- a run marked this
# way is a rehearsal. aslr starts "unset" and is updated to the real answer
# after the run (cmd_staged, below): there is no live browser process to
# probe until then.
staged_env_json() {
    local f="$1" dir="$2" plan="$3" config="$4" sha="$5" ws="$6" role="$7" faked="${8:-}"
    local therm disp
    therm=$(pmset -g therm 2>/dev/null | sed -n 's/.*CPU_Speed_Limit *= *//p' | head -1)
    disp=$("$STAGED_PY" -c 'from AppKit import NSScreen; f=NSScreen.mainScreen().frame(); print("%dx%d" % (f.size.width, f.size.height))' 2>/dev/null)

    bench_configuration_args
    local shared_bool=()
    [ "${WK_BENCH_SHARED_CACHE:-}" = avoid ] && shared_bool=(--bool "configuration.shared_cache=")

    wkdata env-record "$f" \
        plan="$plan" workspace="$ws" config="$config" browser="minibrowser" \
        webkit_sha="$sha" count="$COUNT" preflight_notes="$PREFLIGHT_NOTES" \
        class="$(bench_class "$plan")" runner="browser" arch="native" \
        bench_host="image" role="$role" system="$role" \
        profile="$(wk_image_profile)" staged_from="$dir" display="$disp" \
        host.model="$(sysctl -n hw.model 2>/dev/null)" \
        host.cores="$(sysctl -n hw.ncpu 2>/dev/null)" \
        host.memory_mb="$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1024 / 1024 ))" \
        host.macos="$(sw_vers -productVersion 2>/dev/null)" \
        host.kernel_arch="$(uname -m)" host.root_device="$(bench_root_device /)" \
        host.power="$(pmset -g batt 2>/dev/null | head -1)" \
        host.cpu_speed_limit="${therm:-100}" \
        ${BENCH_CFG_ARGS[@]+"${BENCH_CFG_ARGS[@]}"} ${shared_bool[@]+"${shared_bool[@]}"} \
        --bool forced="$FORCE" --bool role_marker_overridden="$faked"
}

# ASLR cannot be turned off on Apple Silicon, so the axis worth recording is
# what layout actually happened: the load address slide of the browser
# process, read with `vmmap -slide` while it's still findable by name; else
# "os-randomised".
mac_aslr_probe() {
    local pid slide
    pid=$(pgrep -n MiniBrowser 2>/dev/null | head -1)
    if [ -n "$pid" ]; then
        slide=$(vmmap -slide "$pid" 2>/dev/null | sed -n 's/^Load Address Slide: *//p' | head -1 | tr -d ' \r')
        [ -n "$slide" ] && { printf '%s' "$slide"; return 0; }
    fi
    printf 'os-randomised'
}

# --- dispatch ----------------------------------------------------------------
case "${1:-}" in
    ls)      shift; cmd_ls; exit 0 ;;
    compare) shift; [ $# -ge 2 ] || die "usage: wk bench compare <run-a> <run-b> [ws]; see wk bench -h"
             cmd_compare "$@"; exit 0 ;;
    report)  shift; cmd_report "$@"; exit 0 ;;
    staged)  shift; cmd_staged "$@"; exit 0 ;;
    # The whole macOS lane, not one step of it: build, stage, arm, wait for
    # the person at the startup manager, run, come back, read the result.
    # Own file: it outlives a reboot and shares none of this script's
    # preflight. exec, not a function: nothing below is wanted.
    mac)     shift; exec "$WK_ROOT/bench/mac-lane.sh" "$@" ;;
    # Making the benchmark install, as opposed to using it: acts on the Mac's
    # own disk and reboots it, while the lane is driven from elsewhere
    # precisely to outlive that reboot.
    mac-volume) shift; exec "$WK_ROOT/bench/mac-bench-volume.sh" "$@" ;;
    # The unattended A/B: plants a job bench mode runs by itself, rather than
    # the lane's ssh-per-phase. See bench/mac-ab.sh for which constraint
    # forces which shape.
    mac-ab)  shift; exec "$WK_ROOT/bench/mac-ab.sh" "$@" ;;
    # The verdict, computed where the results are. Called by the planted job at
    # the end of a run, and again from host mode to re-read it afterwards.
    ab-summary) shift; exec "$WK_ROOT/bench/mac-ab-summary.sh" "$@" ;;
    stage)   shift
             [ $# -ge 1 ] || die "usage: wk bench stage <workspace> --to <machine> [--config C] [--plan P] [--payload <dir>] [--dry-run]; see wk bench -h"
             cmd_stage "$@"; exit 0 ;;
    # Seeding is not running, and must not inherit running's refusal
    # (load_bench_target, container workspaces only): the build the macOS
    # lane measures comes from a macOS guest, so `wk bench seed <guest-ws>
    # speedometer3.0` must be able to read the plan from a guest, even though
    # the benchmark volume it's seeding for has no network at run time. The
    # clone itself happens here, on the workstation, which has a route to
    # GitHub.
    #
    # Prints the directory: the path is what a caller passes to
    # `wk bench stage --payload`; progress lines go to stderr.
    seed)    shift
             # The dispatcher resolves the workspace into WK_NAME when the seed
             # runs against a container workspace; for any other target the
             # name is still the first argument.
             if [ -n "${WK_NAME:-}" ]; then SEED_WS="$WK_NAME"; else SEED_WS="${1:-}"; shift 2>/dev/null || true; fi
             [ -n "$SEED_WS" ] && [ $# -ge 1 ] || die "usage: wk bench seed <workspace> <plan>; see wk bench -h"
             [ -z "${2:-}" ] || die "usage: wk bench seed <workspace> <plan>; unexpected argument: $2; see wk bench -h"
             load_target "$(ws_target "$SEED_WS")"
             [ -n "${WK_NAME:-}" ] || wait_ready "$SEED_WS"
             seed_payload "$1"; exit 0 ;;
    '') die "usage: wk bench <workspace> <plan> [options]; see wk bench -h" ;;
esac

WS="${WK_NAME:-}"
PLAN="${1:-}"; shift 2>/dev/null || true
[ -n "$WS" ] && [ -n "$PLAN" ] || die "usage: wk bench <workspace> <plan> [options]; see wk bench -h"

while [ $# -gt 0 ]; do
    case "$1" in
        --config)   CONFIG="${2:-}"; shift 2 ;;
        --count)    COUNT="${2:-}"; shift 2 ;;
        --browser)  BROWSER="${2:-}"; shift 2 ;;
        --subtests) SUBTESTS="${2:-}"; shift 2 ;;
        --software) SOFTWARE=1; shift ;;
        --browser-args) BROWSER_ARGS="${2:-}"; shift 2 ;;
        --cores)    CORES="${2:-}"; shift 2 ;;
        *) die "usage: wk bench <workspace> <plan> [--config C] [--count N] [--subtests \"A B\"]
    [--software] [--browser-args \"...\"] [--cores <set>]; see wk bench -h
    unexpected argument: $1" ;;
    esac
done

ensure_dir "$BENCH_DIR"
ensure_dir "$SEED_DIR"
cmd_run "$WS" "$PLAN"
