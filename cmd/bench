#!/usr/bin/env bash
#
# wk bench -- run a benchmark and keep the result defensible.
#
#   wk bench <workspace> <plan> [--config C] [--count N] [--subtests "A B"]
#                                [--software] [--force] [--browser-args "..."]
#   wk bench seed <workspace> <plan>       fetch the benchmark payload only
#   wk bench stage <ws> --to <machine>     put a build where a bare-metal role
#                                          will find it (build in the guest,
#                                          run on the machine itself)
#   wk bench staged [--plan P]             run it, in the role that was booted
#                                          for it; --ls lists what is there
#   wk bench compare <run-a> <run-b>       compare-results on two saved runs
#   wk bench ls                            saved runs
#
#   --config decides the runner: a browser port (wpe-release, gtk-release) runs
#   the plan in MiniBrowser, a JSCOnly port (jsc-release) runs it in the jsc
#   shell. The plan decides whether a GPU is required at all.
#
# The work is done by Tools/Scripts/run-benchmark and Tools/Scripts/
# compare-results. Everything this script adds is around them, and it is the
# part that decides whether a number means anything:
#
#   the environment is checked before the run, not explained afterwards. A
#   Speedometer score from llvmpipe, or from a machine with another build
#   running on it, is not a slow result -- it is a different measurement, and
#   the only way to tell later is to have refused at the time.
#
#   the payload is seeded once and pinned. run-benchmark otherwise clones
#   Speedometer, or fetches MotionMark file by file from the GitHub API, on
#   every single run: minutes of variance, and a benchmark that can silently
#   change under you between two runs you meant to compare.
#
#   the environment is recorded with the result. Kernel, driver, governor,
#   compositor, WebKit sha, container limits, architecture. Two JSONs with no
#   provenance are not a comparison.
#
# Three axes decide what a run needs and what it may be compared with. They are
# recorded with every result and `wk bench compare` warns when two runs differ
# on any of them:
#
#   class     what the benchmark measures. gpu-class (Speedometer, MotionMark)
#             is a rendering measurement and needs a real compositor on a real
#             GPU; cpu-class (JetStream and the other JS benchmarks) is not,
#             and demanding a GPU for it would rule out every workspace that
#             has no business having one -- starting with armhf, where the
#             NVIDIA userspace does not exist. Derived from the plan, not a
#             flag, because it is a property of the benchmark.
#
#   runner    what actually executes it. `browser` is run-benchmark driving
#             MiniBrowser, which is the official number for every plan;
#             `jsc` is the jsc shell running the benchmark's own cli.js, which
#             is the only thing a JSCOnly build can do and is what makes a
#             JSC-only workspace measurable at all. Derived from the config's
#             port.
#
#   host      where the run happened. Everything here is bench_host=container:
#             a workspace on this machine, with its cgroup limits and its
#             shared kernel. The bootable benchmark image
#             (docs/HANDOFF-benchmarking.md) will be bench_host=image, and the
#             two are not comparable -- one has a desktop underneath it and one
#             is the whole machine. Recorded now, before that exists, so the
#             day it does there is no ambiguity about what the old numbers were.
#
# Preflight failures are fatal by design. --force downgrades them to warnings
# and records that in the run's metadata, because a result taken under protest
# should say so.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
# How quiet the machine is, measured. Shared with `wk quiesce`, which does the
# quieting: two answers to "is it quiet" is how a number ends up with a
# footnote nobody can check.
. "$WK_ROOT/lib/quiet.sh"
. "$WK_ROOT/build/configs.sh"

# A benchmark is legitimately silent for much longer than a build: MotionMark
# reports once per subtest and a subtest can run for minutes. The build
# watchdog's 1800 s abort would kill a healthy full-suite run, so raise both
# thresholds here rather than teaching the watchdog about benchmarks.
WK_STALL_SECONDS="${WK_STALL_SECONDS:-900}"
WK_ABORT_SECONDS="${WK_ABORT_SECONDS:-5400}"

. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/arch.sh"

BENCH_DIR="$WK_STORE/bench"
SEED_DIR="$WK_STORE/cache/bench"

# The driver is loaded per workspace, from the registry -- but bench's paths
# (/bench, /cache/bench, /src/WebKit) are container mounts, so only container
# workspaces are supported and anything else is refused by name rather than
# failing on a path that does not exist.
load_bench_target() {
    local ws="$1" t
    t="$(ws_target "$ws")"
    [ "$t" = container ] || die "wk bench supports container workspaces only ('$ws' has target '$t')"
    load_target "$t"
}

# Where this run happened, as recorded in the metadata. One value today,
# because `wk bench` refuses every target but the container -- but the bootable
# benchmark image (docs/HANDOFF-benchmarking.md) is a second one, and a field
# that only ever holds one value is exactly what you want to have added before
# the second appears. Runs from different hosts are not comparable and
# `wk bench compare` says so.
BENCH_HOST=container

# What the benchmark measures, and therefore what the machine has to provide.
#
# gpu-class is the default for anything not named here, deliberately: a plan
# nobody has classified is more likely to be a rendering benchmark than not,
# and the failure mode of guessing gpu is a refusal that is easy to understand,
# while the failure mode of guessing cpu is a MotionMark score from llvmpipe
# that looks like a regression.
#
# Speedometer is gpu-class even though it is mostly script: its score depends
# on the rendering it drives, and measuring it without a real display path is
# measuring something else. That is the same rule the jsc-jetstream-compare
# skill states for Speedometer and MotionMark rounds.
bench_class() {
    case "$1" in
        jetstream*|octane*|kraken*|sunspider*|ares6*|jsbench*) echo cpu ;;
        *) echo gpu ;;
    esac
}

CONFIG="${WK_CONFIG:-wpe-release}"
# Defaulted from the config's port below rather than fixed: the two ports have
# different run-benchmark drivers (minibrowser-wpe, minibrowser-gtk) and picking
# the wrong one launches the wrong browser against the right build directory,
# which fails in a way that looks like a broken build.
BROWSER="${WK_BENCH_BROWSER:-}"
COUNT=""
# `wk <command> --force` is taken off the line by the dispatcher and passed as
# WK_FORCE (see `wk`, main): a command that also parses its own --force has to
# honour the variable, or the flag works everywhere except the one command that
# documented it first.
FORCE="${WK_FORCE:-}"
SUBTESTS=""
SOFTWARE=""
# Why the software path was taken, when it was. --software is a deliberate act;
# a cpu-class run on a machine with no display is a derived one, and a result
# that cannot tell them apart cannot be judged later.
SOFTWARE_REASON=""
BROWSER_ARGS=""

# The synopsis, from the file's own header, so there is one copy of it. Taken
# by *shape* rather than by line number, which is what it used to be: adding a
# verb to the header pushed the last lines out of a fixed `sed -n 3,16p` and
# the usage ended mid-sentence. Everything indented under the header, up to the
# first line of prose, is the synopsis; the `# ` markers go.
usage() {
    awk 'NR < 3 { next }
         !/^#/ { exit }                       # past the header
         started && /^# [^ ]/ { exit }        # prose again: the synopsis ended
         /^#   / { started = 1 }
         { sub(/^# ?/, ""); print }' "$0" >&2
    exit 2
}

# --- saved runs --------------------------------------------------------------
cmd_ls() {
    [ -d "$BENCH_DIR" ] || { log "(no runs yet)"; return 0; }
    local d
    for d in $(ls -1 "$BENCH_DIR" 2>/dev/null | sort); do
        local meta="$BENCH_DIR/$d/env.json"
        printf '%-40s' "$d"
        if [ -f "$meta" ]; then
            python3 -c "
import json,sys
m=json.load(open('$meta'))
axes = m.get('runner','browser')
if m.get('arch','native') != 'native': axes += '/' + m['arch']
if m.get('bench_host','container') != 'container': axes += '/' + m['bench_host']
print('%-14s %-12s %-12s %s%s' % (m.get('plan','?'), m.get('config','?'), axes,
      (m.get('webkit_sha') or '?')[:10], '  [FORCED]' if m.get('forced') else ''))"
        else
            echo
        fi
    done
}

# --- the payload -------------------------------------------------------------
# Read the plan from the workspace's own checkout rather than from the repo:
# (through t_src rather than the container's /src/WebKit: `wk bench stage`
# reads a plan out of a macOS guest, where that path does not exist.)
# a workspace may be testing a change to the plan itself, and seeding a
# different payload than the one the run will use is a silent lie.
plan_json() {
    local ws="$1" plan="$2" body seen=0
    while [ "$seen" -lt 5 ]; do
        body=$(t_exec "$ws" cat "$(t_src "$ws")/Tools/Scripts/webkitpy/benchmark_runner/data/plans/${plan}.plan" 2>/dev/null) \
            || die "no such plan: $plan (plans live in Tools/Scripts/webkitpy/benchmark_runner/data/plans)"
        # A plan file may contain nothing but the name of another plan.
        case "$(printf '%s' "$body" | head -c 1)" in
            '{') printf '%s' "$body"; return 0 ;;
            *)   plan=$(printf '%s' "$body" | tr -d ' \n' | sed 's/\.plan$//'); seen=$((seen + 1)) ;;
        esac
    done
    die "plan $plan indirects too many times"
}

# Seeded copies are keyed by the exact commit, so a moved upstream branch
# produces a new directory rather than quietly changing an existing one.
seed_payload() {
    local ws="$1" plan="$2" json
    json=$(plan_json "$ws" "$plan")

    local spec
    spec=$(printf '%s' "$json" | python3 -c "
import json,sys,re
p = json.load(sys.stdin)
if 'git_repository' in p:
    g = p['git_repository']
    print('git', g['url'], g.get('branch', 'main'), '.')
elif 'github_source' in p:
    m = re.match(r'https://github.com/([^/]+/[^/]+)/tree/([0-9a-f]+)/?(.*)', p['github_source'])
    if not m:
        sys.exit('unparseable github_source: ' + p['github_source'])
    print('git', 'https://github.com/%s.git' % m.group(1), m.group(2), m.group(3) or '.')
elif 'local_copy' in p:
    print('local', p['local_copy'], '', '')
else:
    sys.exit('plan has no fetchable source; run-benchmark will handle it')
" 2>/dev/null) || { warn "cannot pre-seed $plan; run-benchmark will fetch it itself"; echo ""; return 0; }

    # shellcheck disable=SC2086
    set -- $spec
    local kind="$1" url="$2" ref="$3" subdir="$4"
    [ "$kind" = git ] || { echo ""; return 0; }

    # Resolve the ref to a commit before deciding whether the cache is current.
    local sha
    sha=$(git ls-remote "$url" "$ref" 2>/dev/null | awk '{print $1; exit}')
    [ -n "$sha" ] || sha="$ref"     # already a commit

    local dest="$SEED_DIR/$plan-${sha:0:12}"
    if [ -d "$dest/.wk-seeded" ]; then
        debug "payload cached: $dest"
        echo "$dest"; return 0
    fi

    info "seeding $plan payload from $url@${sha:0:12}"
    local tmp; tmp=$(mktemp -d "$SEED_DIR/.tmp-XXXXXX")
    if ! git clone -q "$url" "$tmp/repo" 2>/dev/null; then
        rm -rf "$tmp"
        warn "could not clone $url; run-benchmark will fetch the payload itself"
        echo ""; return 0
    fi
    git -C "$tmp/repo" checkout -q "$sha" 2>/dev/null || git -C "$tmp/repo" checkout -q "$ref"

    rm -rf "$dest"
    if [ "$subdir" = "." ]; then
        mv "$tmp/repo" "$dest"
    else
        mv "$tmp/repo/$subdir" "$dest"
    fi
    rm -rf "$tmp"
    mkdir -p "$dest/.wk-seeded"
    printf 'url=%s\nref=%s\nsha=%s\nsubdir=%s\n' "$url" "$ref" "$sha" "$subdir" > "$dest/.wk-seeded/origin"
    info "seeded $dest"
    echo "$dest"
}

# --- preflight ---------------------------------------------------------------
# Each check answers one question that would otherwise be answered by "the
# number looked odd, I wonder why".
PREFLIGHT_FAILS=0
PREFLIGHT_NOTES=""

check() {
    local ok="$1" what="$2" detail="${3:-}"
    if [ "$ok" = yes ]; then
        printf '  \033[32mok\033[0m    %-34s %s\n' "$what" "$detail" >&2
    else
        printf '  \033[31mFAIL\033[0m  %-34s %s\n' "$what" "$detail" >&2
            PREFLIGHT_FAILS=$((PREFLIGHT_FAILS + 1))
        # Quotes and backslashes would land inside generated JSON.
        PREFLIGHT_NOTES="$PREFLIGHT_NOTES$what: $(printf '%s' "$detail" | tr -d '"\\'); "
    fi
}

# preflight <workspace> <build-dir> <class> <runner>
preflight() {
    local ws="$1" build_dir="$2" class="$3" runner="$4"

    info "preflight"

    # 1. the build exists, and is the one we are about to measure. Which binary
    #    that is depends on the runner: a JSCOnly tree has no MiniBrowser and
    #    never will, so looking for one there reports a missing browser when
    #    what is missing is nothing at all.
    if [ "$runner" = jsc ]; then
        if t_exec "$ws" test -x "$build_dir/bin/jsc" 2>/dev/null; then
            check yes "build present" "$build_dir/bin/jsc"
        else
            check no  "build present" "no jsc in $build_dir -- wk build $ws $CONFIG"
        fi
    elif t_exec "$ws" test -x "$build_dir/bin/MiniBrowser" 2>/dev/null \
       || t_exec "$ws" test -x "$build_dir/bin/WPEWebProcess" 2>/dev/null; then
        check yes "build present" "$build_dir"
    else
        check no  "build present" "no MiniBrowser in $build_dir -- wk build $ws $CONFIG"
    fi

    # 2. the sandbox, and with it the GPU. --gpu makes a software renderer fatal
    #    rather than a footnote: MotionMark on llvmpipe measures llvmpipe.
    #
    #    --software is the exception, and exists for one narrow purpose: proving
    #    the runner itself works when there is no display to be had. It skips
    #    this check and the compositor check, and the run is recorded as
    #    software so it can never be mistaken for a comparable result.
    if [ "$class" = cpu ]; then
        # A CPU-class benchmark is not a degraded GPU-class one. It does not
        # need the device, so not having it is not a finding, and a run taken
        # this way is directly comparable with every other cpu-class run --
        # which is what makes an armhf workspace, or any machine without a
        # display, a place where JetStream numbers can be taken at all.
        #
        # The sandbox check still runs. It is not about rendering: it is the
        # one that catches a workspace that has quietly been given a network
        # interface or a host mount, which changes what the machine is doing
        # while the benchmark runs.
        check yes "class" "cpu -- no GPU or compositor required"
        "$WK_ROOT/cmd/verify" "$ws" >/dev/null 2>&1 \
            || check no "sandbox intact" "wk verify $ws"
    elif [ -n "$SOFTWARE" ]; then
        check yes "sandbox (software rendering)" "not comparable with a GPU run"
        "$WK_ROOT/cmd/verify" "$ws" >/dev/null 2>&1 \
            || check no "sandbox intact" "wk verify $ws"
        PREFLIGHT_NOTES="${PREFLIGHT_NOTES}software rendering; "
    elif "$WK_ROOT/cmd/verify" "$ws" --gpu >/tmp/.wk-bench-verify.$$ 2>&1; then
        check yes "sandbox and GPU" "$(awk -F'renderer=' '/renderer=/{print substr($2,1,44); exit}' /tmp/.wk-bench-verify.$$)"
    else
        check no  "sandbox and GPU" "$(grep FAIL /tmp/.wk-bench-verify.$$ | head -2 | tr '\n' ' ')"
    fi
    # awk rather than grep|head: a pipeline whose reader exits early trips
    # `set -o pipefail`, and this is inside a command substitution under
    # `set -e`, so it would abort the run rather than leave a field blank.
    GPU_RENDERER=$(awk -F'renderer=' '/renderer=/{sub(/ *\|.*/,"",$2); print $2; exit}' /tmp/.wk-bench-verify.$$ 2>/dev/null || true)
    rm -f /tmp/.wk-bench-verify.$$

    # 3. a real compositor on the real monitor -- and the right kind of one.
    #
    #    The socket says a compositor is there, not what it is drawing on. `wk
    #    session on --bmc` puts the session on the BMC's display chip so it can
    #    be watched over KVM-over-IP, and that session is software-rendered --
    #    not visible from the socket, and not visible in the GPU probe above
    #    either: the probe asks the *client* which EGL vendor it got, and the
    #    answer is still NVIDIA when the compositor behind it is llvmpipe. The
    #    mode `wk session` recorded is the only place the difference shows.
    local sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wk/display/wayland-0"
    SESSION_MODE=$(session_mode)
    if [ "$class" = cpu ] || [ -n "$SOFTWARE" ]; then
        :
    elif [ ! -S "$sock" ]; then
        check no  "graphical session" "no compositor -- wk session on"
    else
        case "$SESSION_MODE" in
            # none: a session wk did not start, i.e. somebody's own desktop.
            # Whether that one is on the GPU is what the renderer check above
            # answers; there is no recorded mode to judge.
            gpu|none) check yes "graphical session" "$sock ($SESSION_MODE)" ;;
            *)        check no  "graphical session" \
                          "session mode '$SESSION_MODE' -- watchable over the BMC, not measurable; wk session on" ;;
        esac
    fi

    # 4. quiesced. The governor is the one that actually moves scores; the rest
    #    is recorded so a surprising result can be explained later.
    local gov
    gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo unknown)
    if [ "$gov" = performance ]; then
        check yes "cpu governor" "$gov"
    else
        check no  "cpu governor" "$gov -- wk quiesce on"
    fi

    # 5. the machine is actually idle. A build in another workspace is the
    #    single most likely reason a benchmark run is quietly wrong here.
    local load busy f
    load=$(awk '{print $1}' /proc/loadavg)

    # Counted in a loop rather than `... | wc -l` in a command substitution:
    # with `set -o pipefail`, a grep that matches nothing makes the pipeline
    # fail, the assignment fails, and `set -e` aborts the whole run before
    # printing anything. The same trap as `lsmod | grep -q` in host/linux/gpu.sh.
    busy=0
    for f in "$WK_STORE"/ws/*/build.status; do
        [ -f "$f" ] || continue
        if grep -q '^state=running' "$f"; then
            busy=$((busy + 1))
        fi
    done
    if [ "$busy" != 0 ]; then
        check no "no builds running" "$busy build(s) in progress"
    elif [ "$(printf '%.0f' "$load")" -gt "${WK_BENCH_MAX_LOAD:-4}" ]; then
        check no "machine idle" "1-minute load average is $load"
    else
        check yes "machine idle" "load $load, no wk builds"
    fi

    # 6. thermals, informational: an aarch64 workstation under a long
    #    MotionMark run is the case where this matters.
    local temp=""
    for z in /sys/class/thermal/thermal_zone*/temp; do
        [ -r "$z" ] || continue
        temp="$(( $(cat "$z") / 1000 ))C"
        break
    done
    # An `x && y` as the last statement of a function is a `set -e` landmine:
    # this board exposes no thermal zones, the test is false, and the non-zero
    # status aborts the whole run with no message at all.
    if [ -n "$temp" ]; then
        PREFLIGHT_NOTES="${PREFLIGHT_NOTES}temp $temp; "
    fi

    echo >&2
    if [ "$PREFLIGHT_FAILS" -eq 0 ]; then
        info "preflight clean"
        return 0
    fi
    if [ -n "$FORCE" ]; then
        warn "$PREFLIGHT_FAILS preflight check(s) failed -- continuing because --force was given"
        warn "the run will be recorded as forced, and is not comparable with a clean run"
        return 0
    fi
    die "$PREFLIGHT_FAILS preflight check(s) failed -- refusing to produce a number that cannot be defended.
    Fix the above, or re-run with --force to record a result anyway."
}

# --- the jsc runner ----------------------------------------------------------
# JetStream and the other JS benchmarks ship a cli.js that drives the whole
# suite inside a JavaScript shell. That is the only way a JSCOnly build can be
# benchmarked -- there is no browser in the tree -- and it is what makes a
# JSC-only workspace, armhf or otherwise, a place where a number can be taken.
#
# It is not a substitute for the browser number and is not compared with one:
# the metadata records runner=jsc and `wk bench compare` warns across the two.
# No page, no compositor, no multi-process WebKit -- the same JavaScript, in a
# different machine.
#
# The output is deliberately byte-compatible with run-benchmark's. The driver's
# own resultsJSON() is what it POSTs to run-benchmark's /report endpoint when
# it runs in a browser, so dumping it in the shell instead produces the same
# structure -- {"<suite>": {"tests": {"<test>": {"metrics": {"Score":
# {"current": [...]}}}}}} -- and compare-results, `wk bench compare` and
# container/bench/js3-ci.py all keep working with no special case for it.
#
# run_jsc <workspace> <plan> <out-dir> <run-id> <payload-host> <payload-in-target> <src>
run_jsc() {
    local ws="$1" plan="$2" out="$3" id="$4" payload="$5" payload_ctr="$6" src="$7"

    [ -n "$payload" ] || die "$plan has no seeded payload, and the jsc runner has
    nothing to run without one. 'wk bench seed $ws $plan' fetches it; a plan
    whose source cannot be pre-seeded can only be run with a browser config."
    [ -f "$payload/cli.js" ] || die "$payload has no cli.js, so $plan cannot be driven
    from a JavaScript shell. Run it with a browser config instead
    (--config wpe-release), which is the official number for every plan anyway."

    local jsc var dir
    jsc=$(config_jsc_path "$src")
    var=$(config_run_var)
    dir=$(config_run_dir "$src")

    # cli.js takes its options from the shell's script arguments -- everything
    # after `--`, which jsc hands to the script as `scriptArgs`. Its own
    # --help lists them; two are used here.
    #
    # --dump-json-results is what makes this interchangeable with a browser run:
    # the driver prints the same object it would POST to run-benchmark's
    # /report endpoint, so compare-results, `wk bench compare` and
    # container/bench/js3-ci.py all read it without a special case.
    #
    # The flags are passed rather than set as globals because the driver reads
    # them off a JetStreamParams object built from these arguments; a global of
    # the same name is simply ignored (JetStreamDriver.js:3263, utils/params.js).
    # It also rejects a flag it does not know, so a payload too old for this
    # interface fails loudly here rather than running the whole suite and
    # producing nothing -- which is exactly what it did before this was written
    # the other way round.
    local cliargs="--dump-json-results"
    if [ -n "$SUBTESTS" ]; then
        cliargs="$cliargs --test=$(printf '%s' "$SUBTESTS" | tr ' ' ',')"
    fi

    # One jsc invocation per iteration, each a complete pass over the suite.
    # Not one invocation asked to repeat itself: a fresh process per iteration
    # is what keeps a warmed-up heap or a JIT tier from the previous pass out of
    # the next one's numbers.
    local n="${COUNT:-1}" i=1 rc=0
    info "running $plan in '$ws' ($CONFIG, jsc shell, $n iteration(s))"
    log  "  results: $out"
    while [ "$i" -le "$n" ]; do
        [ "$n" -gt 1 ] && info "iteration $i/$n"
        set +e
        run_watched "$out/run-$i.log" -- \
            t_exec "$ws" bash -lc "export $var=\"$dir\${${var}:+:\${${var}}}\"; \
                cd $(sh_quote "$payload_ctr") && \
                exec $(sh_quote "$jsc") cli.js -- $cliargs"
        rc=$?
        set -e
        if [ "$rc" -ne 0 ]; then
            warn "jsc exited $rc on iteration $i"
            first_error "$out/run-$i.log" | sed 's/^/  /' >&2 || true
            log "  full log: $out/run-$i.log"
            return "$rc"
        fi
        i=$((i + 1))
    done

    # Merge the iterations into one result, appending each pass's score to the
    # same "current" list -- which is exactly what run-benchmark's --count does,
    # and what compare-results needs to have any variance to work with.
    python3 - "$out/result.json" "$out"/run-*.log <<'PYEOF'
import json, sys

def extract(path):
    """The driver prints resultsJSON() on one line. Take the last line that
    parses as an object: anything after it is jsc's own exit noise, and
    anything before it may be a previous partial report."""
    with open(path, errors="replace") as f:
        lines = f.read().splitlines()
    for line in reversed(lines):
        line = line.strip()
        if not (line.startswith("{") and line.endswith("}")):
            continue
        try:
            parsed = json.loads(line)
        except ValueError:
            continue
        if isinstance(parsed, dict):
            return parsed
    return None

def merge(into, other):
    for key, value in other.items():
        if key not in into:
            into[key] = value
        elif isinstance(value, dict) and isinstance(into[key], dict):
            merge(into[key], value)
        elif key == "current" and isinstance(value, list) and isinstance(into[key], list):
            into[key].extend(value)
    return into

out = sys.argv[1]
merged = None
missing = []
for path in sys.argv[2:]:
    one = extract(path)
    if one is None:
        missing.append(path)
        continue
    merged = one if merged is None else merge(merged, one)

if merged is None:
    sys.exit("no results in any iteration log -- the suite printed no JSON. "
             "Check the run-*.log files: a payload whose cli.js does not accept "
             "--dump-json-results will have run the whole suite and reported "
             "only in its own text format.")
if missing:
    print("warning: no results in %s" % ", ".join(missing), file=sys.stderr)

with open(out, "w") as f:
    json.dump(merged, f, indent=2)
PYEOF
    return 0
}

# --- the run -----------------------------------------------------------------
cmd_run() {
    local ws="$1" plan="$2"
    require_name "$ws"
    load_bench_target "$ws"
    [ "$(t_info "$ws")" != absent ] || die "no such workspace: $ws"

    config_load "$CONFIG" || die "unknown config '$CONFIG' (wk build --list)"

    # The three axes, every one of them derived. class from the plan, runner
    # from the config's port, arch from the workspace -- because each is a fact
    # about what is being run, and a flag for any of them would be a way for
    # the record to disagree with what happened.
    local class runner arch
    class=$(bench_class "$plan")
    arch=$(t_arch "$ws")
    case "$CFG_PORT" in
        --jsc-only) runner=jsc ;;
        *)          runner=browser ;;
    esac

    # A JSCOnly tree has no browser, so it cannot render anything, and no flag
    # changes that. Said here rather than discovered as a missing binary.
    if [ "$runner" = jsc ] && [ "$class" = gpu ]; then
        die "$plan is a gpu-class benchmark and $CONFIG builds no browser.
    Either build a browser port (wk build $ws wpe-release) and pass
    --config wpe-release, or run a cpu-class plan -- jetstream3, octane,
    kraken, sunspider, ares6 -- which the jsc shell can drive directly."
    fi

    # An armhf workspace is a software-rendering workspace, permanently: the
    # NVIDIA userspace has to match the host kernel driver and is published for
    # aarch64 only, and wkdev-create skips GPU injection for any --arch
    # container for the same reason. So a rendering benchmark in here measures
    # llvmpipe, which is a different benchmark wearing MotionMark's name.
    #
    # cpu-class plans are unaffected and are the point of allowing benchmarking
    # in a container at all. A real 32-bit *rendering* number needs the device
    # rather than a container -- that is the bootable benchmark image, and it
    # will record bench_host=image (docs/HANDOFF-benchmarking.md).
    if [ "$class" = gpu ] && ! arch_has_gpu "$arch"; then
        die "$plan is gpu-class and '$ws' is an $arch workspace, which has no GPU.
    cpu-class plans (jetstream3, octane, kraken, sunspider) do run in here,
    with either a browser or a JSCOnly config. For a 32-bit rendering number
    see docs/HANDOFF-benchmarking.md -- that is a device, not a container."
    fi

    local build_dir; build_dir=$(config_build_dir)

    if [ "$runner" = browser ] && [ -z "$BROWSER" ]; then
        case "$CFG_PORT" in
            --wpe) BROWSER=minibrowser-wpe ;;
            --gtk) BROWSER=minibrowser-gtk ;;
            *)     die "no benchmark browser for port $CFG_PORT" ;;
        esac
    fi
    [ -n "$SOFTWARE" ] && SOFTWARE_REASON="--software"

    # A cpu-class benchmark in a browser still needs somewhere to put a window.
    # Where there is no usable display -- no compositor, a session on the BMC's
    # chip, or a workspace with no GPU at all -- it runs headless rather than
    # not running, because for a JavaScript benchmark the display is not the
    # measurement. It is recorded as a software run all the same, so comparing
    # it against one that had the GPU still warns.
    if [ "$runner" = browser ] && [ "$class" = cpu ] && [ -z "$SOFTWARE" ]; then
        local sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wk/display/wayland-0"
        if ! arch_has_gpu "$arch" || [ ! -S "$sock" ]; then
            SOFTWARE=1; SOFTWARE_REASON="cpu-class, no usable display"
        else
            case "$(session_mode)" in
                gpu|none) ;;
                *) SOFTWARE=1; SOFTWARE_REASON="cpu-class, session not on the GPU" ;;
            esac
        fi
        [ -n "$SOFTWARE" ] && info "cpu-class: running headless ($SOFTWARE_REASON)"
    fi

    preflight "$ws" "$build_dir" "$class" "$runner"

    # The seeded payload and the run directory are both host paths under the
    # store, and the container sees the same trees at /cache/bench and /bench.
    local seeded seeded_ctr
    seeded=$(seed_payload "$ws" "$plan")
    seeded_ctr=""
    [ -n "$seeded" ] && seeded_ctr="/cache/bench/$(basename "$seeded")"

    local id="$(date -u +%Y%m%dT%H%M%SZ)-$plan-$ws"
    local out="$BENCH_DIR/$id"
    ensure_dir "$out"

    local sha; sha=$(t_exec "$ws" git -C /src/WebKit rev-parse HEAD 2>/dev/null | tr -d '\r\n')

    # Everything needed to judge the result later, written before the run so it
    # exists even if the run dies.
    #
    # Values are collected in the shell and handed to python through the
    # environment rather than interpolated into the script text: an unquoted
    # heredoc expands $c and $d in the snippets below, which under `set -u` is
    # not a mangled string but an abort.
    local display cpu_model
    display=$(for c in /sys/class/drm/*/status; do
                  [ "$(cat "$c" 2>/dev/null)" = connected ] || continue
                  d=$(dirname "$c")
                  printf '%s %s; ' "$(basename "$d")" "$(head -1 "$d/modes" 2>/dev/null)"
              done)
    cpu_model=$(awk -F: '/Model name/ {gsub(/^ +/,"",$2); print $2; exit}' <(lscpu) 2>/dev/null || true)

    WK_M_PLAN="$plan" WK_M_WS="$ws" WK_M_CONFIG="$CONFIG" WK_M_BROWSER="$BROWSER" \
    WK_M_CLASS="$class" WK_M_RUNNER="$runner" WK_M_ARCH="$arch" WK_M_HOST="$BENCH_HOST" \
    WK_M_SHA="$sha" WK_M_COUNT="$COUNT" WK_M_LOCAL="$seeded" \
    WK_M_FORCED="$FORCE" WK_M_SOFTWARE="$SOFTWARE" WK_M_SWREASON="$SOFTWARE_REASON" \
    WK_M_NOTES="$PREFLIGHT_NOTES" \
    WK_M_SESSION_MODE="${SESSION_MODE:-$(session_mode)}" \
    WK_M_RENDERER="${GPU_RENDERER:-}" WK_M_DISPLAY="$display" WK_M_CPU="$cpu_model" \
    WK_M_KERNEL="$(uname -r)" WK_M_CORES="$(host_cores)" \
    WK_M_GOV="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo unknown)" \
    WK_M_DRIVER="$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1 || true)" \
    WK_M_CPUS="$(envelope_cores)" WK_M_MEM="$(envelope_mem_mb)" \
    python3 - "$out/env.json" <<'PYEOF'
import json, os, sys
g = os.environ.get
json.dump({
    "plan": g("WK_M_PLAN"), "workspace": g("WK_M_WS"), "config": g("WK_M_CONFIG"),
    "browser": g("WK_M_BROWSER"), "webkit_sha": g("WK_M_SHA"),
    "count": g("WK_M_COUNT"), "local_copy": g("WK_M_LOCAL"),
    "forced": bool(g("WK_M_FORCED")), "software": bool(g("WK_M_SOFTWARE")),
    "software_reason": g("WK_M_SWREASON"),
    # The three axes a comparison has to agree on before the statistics mean
    # anything: what was measured, what executed it, and on what.
    # bench_host is "container" for everything wk can currently run; the
    # bootable benchmark image will be "image" and is not comparable with it.
    "class": g("WK_M_CLASS"), "runner": g("WK_M_RUNNER"),
    "arch": g("WK_M_ARCH"), "bench_host": g("WK_M_HOST"),
    "preflight_notes": g("WK_M_NOTES"), "gpu_renderer": g("WK_M_RENDERER"),
    # Which chip the compositor was on: gpu, bmc (the BMC's chip, software
    # rendered), or none for somebody's own desktop.
    "session_mode": g("WK_M_SESSION_MODE"),
    # MotionMark scores scale with the size of the surface being animated, and a
    # fullscreen browser's surface is the display mode -- so two runs on
    # different modes are not comparable and nothing else here would record why.
    "display": g("WK_M_DISPLAY"),
    "host": {
        "kernel": g("WK_M_KERNEL"), "cpu": g("WK_M_CPU"), "cores": g("WK_M_CORES"),
        "governor": g("WK_M_GOV"), "nvidia_driver": g("WK_M_DRIVER"),
        "container_cpus": g("WK_M_CPUS"), "container_mem_mb": g("WK_M_MEM"),
    },
}, open(sys.argv[1], "w"), indent=2)
PYEOF

    # The jsc runner writes its own result.json and reports for itself.
    if [ "$runner" = jsc ]; then
        set +e
        run_jsc "$ws" "$plan" "$out" "$id" "$seeded" "$seeded_ctr" /src/WebKit
        local jrc=$?
        set -e
        [ "$jrc" -eq 0 ] || exit "$jrc"

        info "BENCH OK  $plan -> $out/result.json"
        tr '\r' '\n' < "$out/run-1.log" | grep -iE '^(Score|Total|.*Score:)' \
            | tail -5 | sed 's/^/  /' >&2 || true
        log ""
        log "  compare with:  wk bench compare <other-run> $id"
        return 0
    fi

    info "running $plan in '$ws' ($CONFIG, $BROWSER)"
    log  "  results: $out"

    # Software rendering: llvmpipe through Mesa, the dmabuf renderer off, and no
    # Wayland display -- so WPE and GTK both fall back to their headless paths
    # instead of failing to connect to a compositor that is not there.
    local run_env=""
    local browser_args="$BROWSER_ARGS"
    if [ -n "$SOFTWARE" ]; then
        # __EGL_VENDOR_LIBRARY_FILENAMES is the one that actually decides it.
        # LIBGL_ALWAYS_SOFTWARE and GALLIUM_DRIVER only steer Mesa; with the
        # NVIDIA vendor still listed in /usr/share/glvnd/egl_vendor.d, glvnd
        # loads it for the GBM and device platforms and the run is quietly
        # hardware-accelerated while calling itself software. Pinning glvnd to
        # the Mesa vendor is what makes the label true -- verified with
        # container/gpu/gpu-probe.sh, which then reports llvmpipe.
        run_env="WAYLAND_DISPLAY= WEBKIT_DISABLE_DMABUF_RENDERER=1"
        run_env="$run_env LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe"
        run_env="$run_env __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json"
        browser_args="--headless $browser_args"
    fi

    local args="--plan $plan --browser $BROWSER --build-directory $build_dir"
    args="$args --output-file /bench/$id/result.json --no-adjust-unit --show-iteration-values"
    [ -n "$COUNT" ] && args="$args --count $COUNT"
    [ -n "$seeded_ctr" ] && args="$args --local-copy $seeded_ctr"
    [ -n "$SUBTESTS" ] && args="$args --subtests $SUBTESTS"
    # Positional, and after everything else: run-benchmark passes these straight
    # to the browser, and anything starting with a dash needs the -- separator.
    [ -n "$browser_args" ] && args="$args -- $browser_args"

    set +e
    run_watched "$out/run.log" -- \
        t_exec "$ws" bash -lc "cd /src/WebKit && \
            WK_BENCH_RUN=$id $run_env Tools/Scripts/run-benchmark $args"
    local rc=$?
    set -e

    if [ "$rc" -ne 0 ]; then
        warn "run-benchmark exited $rc"
        first_error "$out/run.log" | sed 's/^/  /' >&2 || true
        log "  full log: $out/run.log"
        exit "$rc"
    fi

    info "BENCH OK  $plan -> $out/result.json"
    # run-benchmark prints its own summary table; surface the score line rather
    # than making it be looked up.
    tr '\r' '\n' < "$out/run.log" | grep -iE '^(Score|Total|.*Score:)' | tail -5 | sed 's/^/  /' >&2 || true
    log ""
    log "  compare with:  wk bench compare <other-run> $id"
}

# --- comparison --------------------------------------------------------------
# compare-results does the statistics; this only resolves run ids to files and
# refuses comparisons that are not like for like.
cmd_compare() {
    local a="$1" b="$2" ws="${3:-}"
    local fa="$BENCH_DIR/$a/result.json" fb="$BENCH_DIR/$b/result.json"
    [ -f "$fa" ] || fa="$a"
    [ -f "$fb" ] || fb="$b"
    [ -f "$fa" ] || die "no such run: $a"
    [ -f "$fb" ] || die "no such run: $b"
    # Inside the workspace the run directory is /bench, not the store path.
    local ca="${fa/#$BENCH_DIR//bench}" cb="${fb/#$BENCH_DIR//bench}"

    # The record sits next to the result, so a run named by path -- which is
    # how a result on a benchmark volume is named, since it is not in this
    # machine's store -- gets its axes checked like any other. Without this the
    # one comparison the bench_host axis exists for (image against container)
    # was the one that silently skipped the check.
    local ea="$BENCH_DIR/$a/env.json" eb="$BENCH_DIR/$b/env.json"
    [ -f "$ea" ] || ea="$(dirname "$fa")/env.json"
    [ -f "$eb" ] || eb="$(dirname "$fb")/env.json"

    # Comparing a forced run, or two different plans, is almost never what was
    # meant. Say so rather than printing a confident p-value.
    python3 - "$ea" "$eb" <<'PYEOF' >&2 || true
import json, sys, os
def load(p):
    try:
        return json.load(open(p))
    except Exception:
        return {}
a, b = load(sys.argv[1]), load(sys.argv[2])
if not a or not b:
    sys.exit(0)
if a.get("plan") != b.get("plan"):
    print("warning: different plans (%s vs %s)" % (a.get("plan"), b.get("plan")))
if a.get("config") != b.get("config"):
    print("warning: different build configs (%s vs %s)" % (a.get("config"), b.get("config")))
# The three axes. A runner or host mismatch is not a caveat on a comparison --
# it means the two runs measured different machines doing different work, and
# the statistics below will still happily produce a p-value for them.
if a.get("runner", "browser") != b.get("runner", "browser"):
    print("warning: different runners (%s vs %s) -- the jsc shell and MiniBrowser "
          "are not the same measurement" % (a.get("runner", "browser"), b.get("runner", "browser")))
if a.get("bench_host", "container") != b.get("bench_host", "container"):
    print("warning: different benchmark hosts (%s vs %s) -- a container shares a kernel "
          "and a desktop with everything else on the machine; an image does not"
          % (a.get("bench_host", "container"), b.get("bench_host", "container")))
if a.get("arch", "native") != b.get("arch", "native"):
    print("warning: different architectures (%s vs %s)" % (a.get("arch", "native"), b.get("arch", "native")))
# No default for class: runs predating the field say nothing about what they
# measured, and "absent" is not "different".
if a.get("class") and b.get("class") and a["class"] != b["class"]:
    print("warning: different benchmark classes (%s vs %s)" % (a["class"], b["class"]))
# The renderer and the session are only evidence for a gpu-class run. Warning
# that a JetStream run in the jsc shell had no renderer is noise, and noise in
# front of real warnings is how the real ones stop being read.
gpu_class = a.get("class") != "cpu" and b.get("class") != "cpu"
if gpu_class and a.get("gpu_renderer") != b.get("gpu_renderer"):
    print("warning: different renderers (%s vs %s)" % (a.get("gpu_renderer"), b.get("gpu_renderer")))
if gpu_class and a.get("session_mode") != b.get("session_mode"):
    print("warning: different session modes (%s vs %s) -- only 'gpu' is a measurable display path"
          % (a.get("session_mode"), b.get("session_mode")))
if bool(a.get("software")) != bool(b.get("software")):
    print("warning: one run is software-rendered and the other is not -- these are not comparable")
if a.get("forced") or b.get("forced"):
    print("warning: at least one run was taken with failing preflight checks (--force)")
# A rehearsal: bench mode was asserted by an override rather than by
# the machine having booted the image, so the number came off a workstation
# however it is labelled (cmd_staged, WK_IMAGE_MARKER).
if a.get("role_marker_overridden") or b.get("role_marker_overridden"):
    print("warning: at least one run only *claimed* bench mode "
          "(WK_IMAGE_MARKER was overridden) -- it was measured on a workstation")
if a.get("local_copy") != b.get("local_copy"):
    print("warning: different benchmark payloads (%s vs %s)" % (a.get("local_copy"), b.get("local_copy")))
PYEOF

    # A staged tree can do the statistics itself, and in bench mode it
    # is the only thing that can: that machine has no workspace, no container
    # and no checkout -- it has the Tools/ tree the run came with. Taken before
    # the workspace path below, because when both exist the staged one is the
    # one that matches the results being compared.
    local staged_cmp=""
    if is_macos && staged_cmp=$(staged_compare_tool); then
        if ! "$STAGED_PY" -c 'import scipy' >/dev/null 2>&1; then
            die "compare-results needs scipy, and $STAGED_PY does not have it.
    On a benchmark install:  $STAGED_PY -m pip install --user scipy
    (it is a 30 MB download and the only thing here that needs the network)"
        fi
        "$STAGED_PY" -u "$staged_cmp" -a "$fa" -b "$fb" --breakdown
        return 0
    fi

    # compare-results is a WebKit script and needs webkitpy, so it runs in the
    # workspace like everything else.
    if [ -z "$ws" ]; then
        ws=$(python3 -c "
import json,sys
try: print(json.load(open('$BENCH_DIR/$b/env.json'))['workspace'])
except Exception: print('')")
    fi
    [ -n "$ws" ] || die "cannot find a workspace to run compare-results in (pass one as the third argument)"
    load_bench_target "$ws"
    [ "$(t_info "$ws")" != absent ] \
        || die "cannot find a workspace to run compare-results in (pass one as the third argument)"

    # A single-iteration run has no variance, so every p-value is NaN and
    # compare-results dies inside its own significance sort with a bare
    # AssertionError. Say so here rather than letting a traceback be the
    # explanation.
    for r in "$a" "$b"; do
        if [ "$(python3 -c "
import json
try: print(json.load(open('$BENCH_DIR/$r/env.json')).get('count') or '')
except Exception: print('')" 2>/dev/null)" = 1 ]; then
            warn "run '$r' has count=1: compare-results cannot compute significance"
            log  "  re-run with --count 2 or more for a comparison with statistics"
        fi
    done

    # compare-results needs scipy for its significance test, and the SDK image
    # does not carry it. Installed on demand rather than in firstrun.sh: it is
    # a 30 MB download that most workspaces never need, and the egress policy
    # already allows PyPI because build-webkit depends on it.
    if ! t_exec "$ws" python3 -c 'import scipy' >/dev/null 2>&1; then
        info "installing scipy for compare-results (once per workspace)"
        t_exec "$ws" bash -lc 'pip3 install --user --quiet scipy' \
            || die "could not install scipy; compare-results cannot run"
    fi

    # Invoked through python3 rather than executed: compare-results' shebang is
    # `#!/usr/bin/env python3 -u`, and Linux env does not split arguments in a
    # shebang, so running it directly fails with "env: 'python3 -u': No such
    # file or directory". It works on macOS, which is presumably why it is
    # still there.
    t_exec "$ws" bash -lc "cd /src/WebKit && python3 -u Tools/Scripts/compare-results \
        -a '$ca' -b '$cb' --breakdown"
}

# The compare-results that belongs to the staged tree, if there is one on this
# machine. Printed rather than returned so the caller can test for it, and
# resolved through the same staged_root/staged_pick the runner uses -- one
# answer to "which staged tree", not two.
staged_compare_tool() {
    local root dir
    root=$(staged_root 2>/dev/null) || return 1
    dir=$(staged_pick "$root" "") || return 1
    [ -f "$dir/Tools/Scripts/compare-results" ] || return 1
    printf '%s' "$dir/Tools/Scripts/compare-results"
}

# --- staging a build onto a machine that will run it --------------------------
#
# The macOS half of docs/HANDOFF-benchmarking.md, and the shape the user asked
# for: **build inside the VM, run outside on bare metal.** Both halves are
# necessary and neither is negotiable. A guest cannot produce a number worth
# keeping -- it shares a CPU with a desktop, its GPU is paravirtualised and its
# scheduler is somebody else's -- and the bare-metal role cannot build, because
# a benchmark install with Xcode and a checkout on it is no longer a benchmark
# install: it is a second workstation, drifting from the first.
#
# So the build stays where builds are cheap and reproducible, and what crosses
# the boundary is the product. Which is a *copy*, not a transfer: while this
# machine is in host mode the benchmark volume is simply mounted, so
# staging is rsync from the guest onto a directory that the other role will
# find at a fixed path when it boots.
#
# What is staged, and why each part:
#
#   WebKitBuild/<config>   the product. The thing being measured.
#   Tools/                 run-benchmark, webkitpy and the plan files. The
#                          benchmark install has no checkout and must not grow
#                          one; this is the smallest tree that can drive a run.
#   stage.json             which workspace, which sha, which config, built
#                          when, staged when, by which wk-tools. Provenance
#                          decided *here*, where it is all still known -- the
#                          other role cannot ask a guest anything.
#
# The result carries `bench_host=image`, which `wk bench compare` already
# refuses to compare against a container run (that field was added before
# anything could produce it, for exactly this day).
#
# NOT YET VERIFIED end to end: there is no benchmark volume on this machine and
# no guest to build in, so what has been exercised is the staging itself --
# layout, provenance, refusals -- against a local workspace and a disposable
# volume. The run in the other role is written up in
# docs/HANDOFF-benchmarking.md and is deliberately not guessed at here.
cmd_stage() {
    local ws="$1" machine="" config="" plan="" payload="" dry=""
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --to)      machine="${2:-}"; shift 2 ;;
            --config)  config="${2:-}"; shift 2 ;;
            --plan)    plan="${2:-}"; shift 2 ;;
            # A directory on this machine, copied in beside the build. The run
            # then needs no network at all and cannot silently measure a
            # different revision of the benchmark than the last run did --
            # which is the same argument `wk bench seed` makes for a container
            # run, applied to a machine that may have no route out.
            --payload) payload="${2:-}"; shift 2 ;;
            --dry-run) dry=1; shift ;;
            *) die "unknown option: $1
    usage: wk bench stage <workspace> --to <machine> [--config C] [--plan P]
                          [--payload <dir>] [--dry-run]" ;;
        esac
    done
    require_name "$ws"
    [ -n "$machine" ] || die "which machine is going to run it? --to <machine> (wk boot --list)"

    # The machine, and its other role's disk. Loaded through the same registry
    # and driver `wk boot` uses, because "where does a staged payload go on
    # this machine" is a property of the machine's boot arrangement and not
    # something a benchmark runner should have its own opinion about.
    . "$WK_ROOT/boot/machines.sh"
    machine_load "$machine" || die "unknown machine '$machine' (wk boot --list)"
    load_driver "$MACH_DRIVER"
    command -v b_bench_root >/dev/null 2>&1 \
        || die "$machine has no place to stage a build onto from here.
    Its other role is reached over the network rather than mounted, so the
    payload is pushed to it while it runs rather than copied to it while it
    does not -- see docs/HANDOFF-netboot.md, 'Storage'."
    local root
    root=$(b_bench_root) || die "$machine's benchmark disk is not attached, so there is nowhere to
    stage a build onto. 'wk boot $machine --status' says what it can see."

    # Is that path reachable from here, or does the payload have to be sent?
    # The MBP's benchmark disk is *mounted* while it is being staged onto,
    # which is what makes staging a copy; every other machine in the fleet has
    # to be sent the payload over the network. A driver that does not say
    # counts as local, which is what the only local driver does.
    local deliver=""
    if command -v b_bench_local >/dev/null 2>&1 && ! b_bench_local; then
        command -v b_bench_put >/dev/null 2>&1 \
            || die "$machine's staging root is not reachable from here and its driver
    has no way to send a payload to it (b_bench_put)."
        deliver=1
    fi

    # The workspace, through its own driver -- and deliberately *not*
    # load_bench_target, which refuses everything but a container. That refusal
    # is right for running a benchmark here and exactly wrong for staging one:
    # the whole point is that the build came from a macOS guest.
    local t; t="$(ws_target "$ws")"
    load_target "$t"
    wait_ready "$ws"

    [ -n "$config" ] || config="${WK_CONFIG:-$(default_config)}"
    config_load "$config" || die "unknown config '$config' (wk build --list)"

    local src build_dir
    src=$(t_src "$ws")
    build_dir=$(config_build_dir "$src")
    t_exec "$ws" test -d "$build_dir" 2>/dev/null \
        || die "'$ws' has no $config build to stage ($build_dir).
    Build it first:  wk build $ws $config"

    # The sha is asked of the checkout, now, rather than read from any record:
    # a staged payload that names the wrong commit is worse than one that names
    # none, because it is the only thing the other role will be able to say
    # about what it measured.
    local sha; sha=$(t_exec "$ws" bash -lc "cd $(sh_quote "$src") && git rev-parse HEAD" 2>/dev/null | tr -d '\r' | tail -1) || sha=""

    local stamp dest
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    dest="$root/staged/$stamp-$config"

    # How this machine is put into bench mode, in its own words. The
    # three arming models arrive at the same place by different routes, and a
    # "next step" that names the wrong one is worse than none.
    local arm_hint run_hint
    case "${BOOT_ARMING:-one-shot}" in
        hands-on) arm_hint="wk boot $machine        arm it; it prints the ritual (you pick the disk)"
                  run_hint="wk bench staged${plan:+ --plan $plan}       once it has booted, over there" ;;
        guest)    arm_hint="wk boot $machine        start the guest -- for a guest that *is* the transition"
                  run_hint="wk enter ${MACH_GUEST:-<guest>} -- wk bench staged${plan:+ --plan $plan}" ;;
        server)   arm_hint="wk serve --system …      the machine boots what this machine serves"
                  run_hint="wk bench staged${plan:+ --plan $plan}       on the machine, once it is up" ;;
        *)        arm_hint="wk boot $machine        arm the one-shot and reboot into it"
                  run_hint="wk bench staged${plan:+ --plan $plan}       on the machine, once it is up" ;;
    esac

    if [ -n "$dry" ]; then
        info "dry run -- nothing was staged"
        log  "  from:   '$ws' ($t), $config at ${sha:0:12}"
        log  "          $build_dir"
        log  "          $src/Tools"
        log  "  to:     $dest   (on $machine${MACH_VOLUME:+, $MACH_VOLUME})"
        [ -n "$payload" ] && log "  payload: $payload -- copied in, so the run needs no network"
        log  "  then:   $arm_hint"
        return 0
    fi

    info "staging $config from '$ws' onto $machine${MACH_VOLUME:+ ($MACH_VOLUME)}"

    # Where the tree is assembled. For a mounted disk that is the destination
    # itself; for a machine that has to be sent the payload it is a directory
    # here, which is then delivered and removed.
    local build assemble="$dest"
    if [ -n "$deliver" ]; then
        assemble="$(wk_state_dir)/bench-stage/$stamp-$config"
        rm -rf "$assemble"
    fi
    mkdir -p "$assemble"

    # Products, not the build tree -- and the exclusions are worth writing down
    # exactly, because the obvious guesses are wrong. Measured in the rehearsal
    # guest, `WebKitBuild/Release` was 37 GB:
    #
    #     WebCore.build 16G   WebKit.build 7.1G   JavaScriptCore.build 3.3G
    #     libJavaScriptCore.a 2.8G   TestWebKitAPI.build 1.4G
    #     XCBuildData 856M    WebKitLegacy.build 861M   libwebrtc.build 829M
    #
    # All of it link-time or compile-time only. The first attempt excluded
    # `*.noindex` and `DerivedData`, which live under `WebKitBuild/DerivedData`
    # -- a *sibling* of Release, not inside it -- so it excluded nothing at all
    # and started sending 37 GB across the wire.
    #
    # What a machine that will never compile anything needs is the frameworks,
    # the dylibs, the XPC services and MiniBrowser.app: what the browser driver
    # launches, and what DYLD_FRAMEWORK_PATH resolves against.
    log  "  the build product (frameworks and MiniBrowser.app; no intermediates)"
    build="$assemble/WebKitBuild/$(basename "$build_dir")"
    t_pull_dir "$ws" "$build_dir" "$build" \
        --exclude '*.build' --exclude 'XCBuildData' --exclude 'DerivedSources' \
        --exclude 'PrecompiledHeaders' --exclude 'compile_commands' \
        --exclude '*.a' --exclude '*.dSYM' --exclude '*.noindex'
    log  "  Tools/ -- run-benchmark, webkitpy and the plans"
    t_pull_dir "$ws" "$src/Tools" "$assemble/Tools"

    if [ -n "$payload" ]; then
        [ -d "$payload" ] || die "no such payload directory: $payload"
        log  "  the benchmark itself, pinned ($(basename "$payload"))"
        rm -rf "$assemble/payload"
        mkdir -p "$assemble/payload"
        rsync -a "$payload/" "$assemble/payload/"
    fi

    # Written last, and that is the publishing protocol every other store in
    # this repo uses (lib/image.sh, lib/store.sh): until it exists this
    # directory is rubble, and the other role ignores it.
    cat > "$assemble/stage.json" <<EOF
{
  "staged_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "staged_by": "$(hostname)",
  "workspace": "$ws",
  "workspace_target": "$t",
  "config": "$config",
  "webkit_sha": "$sha",
  "plan": "${plan:-}",
  "payload_pinned": $([ -n "$payload" ] && echo true || echo false),
  "machine": "$machine",
  "volume": "${MACH_VOLUME:-}",
  "wk_tools": "$("$WK_ROOT/cmd/version" --tree 2>/dev/null || echo unknown)",
  "bench_host": "image"
}
EOF

    if [ -n "$deliver" ]; then
        info "sending it to $machine ($(du -sh "$assemble" 2>/dev/null | cut -f1))"
        # The manifest crosses last, on its own, and that is the whole point of
        # it: a delivery is minutes of rsync and can be interrupted, and rsync
        # gives no order guarantee -- so a stage.json carried along with the
        # bulk arrives at some arbitrary moment and a half-delivered payload
        # looks finished. Measured 2026-08-20: a killed `wk bench stage` left
        # 13 GB in the guest with a perfectly good manifest on top of it.
        mv "$assemble/stage.json" "$assemble/.stage.json.pending"
        b_bench_put "$assemble" "$dest" || die "could not deliver the payload to $machine"
        mv "$assemble/.stage.json.pending" "$assemble/stage.json"
        b_bench_put_file "$assemble/stage.json" "$dest/stage.json" \
            || die "delivered the payload to $machine but could not publish its manifest.
    Nothing will use it until one is there -- re-run the stage."
        rm -rf "$assemble"
    fi

    info "staged: $dest${MACH_VOLUME:+ on $MACH_VOLUME}"
    [ -n "$deliver" ] || log "  $(du -sh "$dest" 2>/dev/null | cut -f1) on $MACH_VOLUME"
    log  ""
    log  "  next:"
    log  "    $arm_hint"
    log  "    $run_hint"
    log  "    wk boot $machine --back   leave the role again; the result stays"
    log  "                              on the machine that took it"
}

# --- running a staged build, in the role that was booted for it ---------------
#
# The other half of `wk bench stage`, and the one that produces the number: the
# machine has been rebooted into its benchmark install, the payload is on the
# volume that is now `/`, and this runs it and records what it ran on.
#
# What was unknown until it was measured (2026-08-20, on this Mac, against a
# `Tools/Scripts` tree copied out of a base snapshot -- all four verified, and
# every one of them would otherwise have been discovered in bench mode
# with the machine already rebooted):
#
#   run-benchmark drives from a *partial* tree.  `Tools/Scripts` alone is
#   enough: `--list-plans` runs to completion with no checkout root, no
#   Source/, no WebKitBuild. Plan files are found relative to webkitpy itself
#   (BenchmarkRunner.plan_directory), and so are the patches a plan applies
#   (get_path_from_project_root resolves against the benchmark_runner package,
#   not against a checkout). So the staged tree does not have to grow into a
#   clone.
#
#   the browser is `--browser minibrowser --platform osx`, and
#   `--build-directory` is what makes it usable here: with one, the driver
#   launches <dir>/MiniBrowser.app/Contents/MacOS/MiniBrowser itself with
#   DYLD_FRAMEWORK_PATH set, instead of going through Tools/Scripts/
#   run-minibrowser -- which is the path that *would* have needed a checkout.
#   It insists the build directory contain a *.framework, and says so.
#
#   it has to run under a python that has PyObjC.  The driver's prepare_env
#   imports `webkitpy.autoinstalled.pyobjc_frameworks`, whose first line is a
#   bare `import objc` -- pyobjc-core is *not* autoinstalled. Apple's
#   /usr/bin/python3 has it (3.9.6, pyobjc 11.1 here); a Homebrew python3 does
#   not, and it is the one on PATH on this machine. So the interpreter is named
#   explicitly rather than left to `#!/usr/bin/env python3`.
#
#   everything else webkitpy needs, it installs itself, into the staged tree
#   (Tools/Scripts/libraries/autoinstalled) on first use. That needs the
#   network once -- or a tree staged from a guest where it has already
#   happened, which carries the packages with it.
#
# The refusal that matters most is the first one, and it is the one thing here
# that --force does not open: **a benchmark runs in bench mode or it
# does not run.** A run on the workstation shares the machine with a desktop, a
# podman VM, a browser and whatever else is open, and it would produce a number
# that looks exactly like a bare-metal one -- same command, same plan, same
# build, same shape of result. There is no way to tell them apart afterwards
# except by trusting a field, so the run does not happen. `--dry-run` still
# describes it from here, because describing is not measuring.
# The interpreter the run uses, and it is chosen by *property* rather than by
# path: what run-benchmark needs is a python that can `import objc`, because
# the macOS browser driver's prepare_env imports
# `webkitpy.autoinstalled.pyobjc_frameworks` and pyobjc-core is not
# autoinstalled. Which python that is varies by machine and is not guessable:
#
#   this Mac        /usr/bin/python3 is 3.9.6 with pyobjc 11.1  -- works
#   a macOS guest   /usr/bin/python3 shims to the *Xcode* python3, also 3.9.6,
#                   with no pyobjc at all -- and neither has Homebrew's
#
# Measured on both, 2026-08-20. So the runner looks for one and names what it
# found; hardcoding the path would have been right on the machine it was
# written on and wrong on the first one it was used on.
staged_python() {
    local p
    for p in "${WK_BENCH_PYTHON:-}" /usr/bin/python3 \
             /Library/Developer/CommandLineTools/usr/bin/python3 \
             /usr/local/bin/python3 /opt/homebrew/bin/python3; do
        [ -n "$p" ] || continue
        [ -x "$p" ] || continue
        "$p" -c 'import objc' >/dev/null 2>&1 || continue
        printf '%s' "$p"; return 0
    done
    return 1
}

# The fallback, so every message and dry run has something to name even when
# nothing on the machine qualifies.
STAGED_PY="$(staged_python || echo /usr/bin/python3)"

# Where the staged payloads are, from whichever role is asking.
#
# In bench mode the volume is `/`, so the path is absolute and short.
# In host mode it is a mounted disk, and the machine's own driver knows
# where -- the same b_bench_root that `wk bench stage` writes into, so there is
# one answer to "where do staged builds live" rather than two that can drift.
staged_root() {
    # An explicit answer wins. Two reasons it exists, and the second is why it
    # is not only a test hook: bench mode's payload need not be on the
    # boot volume (a second disk is the obvious variation), and the runner was
    # exercised from host mode by pointing this at a disposable
    # volume -- which is the only way to reach bench mode's code path
    # on a machine that has not been rebooted into it.
    [ -n "${WK_BENCH_ROOT:-}" ] && { printf '%s' "$WK_BENCH_ROOT"; return 0; }
    if in_bench_mode; then
        printf '/var/wk'
        return 0
    fi
    . "$WK_ROOT/boot/machines.sh"
    machine_load "${WK_BENCH_MACHINE:-mbp}" || return 1
    load_driver "$MACH_DRIVER"
    command -v b_bench_root >/dev/null 2>&1 || return 1
    b_bench_root
}

# The newest staged payload with a manifest, or the one named. The manifest is
# written last by `wk bench stage`, so a payload without one is a copy that was
# interrupted and is ignored rather than measured.
staged_pick() {
    local root="$1" want="${2:-}" d
    if [ -n "$want" ]; then
        [ -f "$root/staged/$want/stage.json" ] || return 1
        printf '%s' "$root/staged/$want"; return 0
    fi
    for d in $(ls -1r "$root/staged" 2>/dev/null); do
        [ -f "$root/staged/$d/stage.json" ] || continue
        printf '%s' "$root/staged/$d"; return 0
    done
    return 1
}

staged_field() {
    "$STAGED_PY" -c "
import json,sys
try: print(json.load(open(sys.argv[1])).get(sys.argv[2], '') or '')
except Exception: print('')" "$1/stage.json" "$2" 2>/dev/null
}

staged_usage() {
    cat >&2 <<'EOF'
usage: wk bench staged [options]        run a staged build, in bench mode

  --plan <name>       which benchmark (default: the one the payload names)
  --id <staged-id>    which staged payload (default: the newest complete one)
  --count <n>         iterations
  --timeout <s>       how long one iteration may take
  --subtests "A B"    a subset of the plan
  --payload <dir>     a pinned copy of the benchmark, instead of fetching it
  --browser-args "…"  passed through to MiniBrowser
  --ls                what is staged here, and what has been run
  --dry-run           resolve everything and print the command; run nothing
  --force             record the result even though preflight failed. It does
                      NOT run a benchmark in host mode -- nothing
                      does.
EOF
    exit 2
}

cmd_staged() {
    local id="" plan="" dry="" list="" PAYLOAD="" TIMEOUT=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --id)       id="${2:-}"; shift 2 ;;
            --plan)     plan="${2:-}"; shift 2 ;;
            --count)    COUNT="${2:-}"; shift 2 ;;
            --subtests) SUBTESTS="${2:-}"; shift 2 ;;
            --browser-args) BROWSER_ARGS="${2:-}"; shift 2 ;;
            # The payload, pinned. Same argument `wk bench seed` makes for a
            # container run: left to itself run-benchmark clones the benchmark
            # from GitHub on every run, so two runs meant to be compared can
            # differ by the benchmark rather than by the build.
            --payload)  PAYLOAD="${2:-}"; shift 2 ;;
            --timeout)  TIMEOUT="${2:-}"; shift 2 ;;
            --force)    FORCE=1; shift ;;
            --dry-run)  dry=1; shift ;;
            --ls)       list=1; shift ;;
            -h|--help)  staged_usage ;;
            *) die "unknown option: $1
    usage: wk bench staged [--plan P] [--id <staged-id>] [--count N]
                           [--subtests \"A B\"] [--ls] [--dry-run] [--force]" ;;
        esac
    done

    is_macos || die "'wk bench staged' is macOS bench mode. The Linux systems
    run their benchmark from the machine that serves them -- see
    docs/HANDOFF-netboot.md and docs/HANDOFF-benchmarking.md."

    local root
    root=$(staged_root) || die "this machine has no benchmark volume to read.
    In host mode it has to be attached ('wk boot mbp --status');
    in bench mode /etc/wk-image says which system is running."

    if [ -n "$list" ]; then
        local d
        [ -d "$root/staged" ] || { log "(nothing staged on $root)"; return 0; }
        for d in $(ls -1 "$root/staged" 2>/dev/null | sort); do
            [ -f "$root/staged/$d/stage.json" ] || { printf '  %-34s (incomplete)\n' "$d" >&2; continue; }
            printf '  %-34s %s %s\n' "$d" \
                "$(staged_field "$root/staged/$d" config)" \
                "$(staged_field "$root/staged/$d" webkit_sha | cut -c1-10)" >&2
        done
        [ -d "$root/results" ] && { log ""; log "  results:"; ls -1 "$root/results" 2>/dev/null | sed 's/^/    /' >&2; }
        return 0
    fi

    local dir
    dir=$(staged_pick "$root" "$id") || die "nothing staged on this machine's benchmark volume${id:+ under '$id'}.
    Stage a build from the workspace that built it:
        wk bench stage <workspace> --to mbp --config mac-release"

    local config sha ws
    config=$(staged_field "$dir" config)
    sha=$(staged_field "$dir" webkit_sha)
    ws=$(staged_field "$dir" workspace)
    [ -n "$plan" ] || plan=$(staged_field "$dir" plan)
    [ -n "$plan" ] || die "which benchmark? --plan <name>
    (the staged payload does not name one; 'wk bench staged --ls' shows what
    is here, and Tools/Scripts/run-benchmark --list-plans what it can run)"

    local build_dir runner_script out_id out
    build_dir=$(ls -d "$dir"/WebKitBuild/* 2>/dev/null | head -1)
    runner_script="$dir/Tools/Scripts/run-benchmark"
    out_id="$(date -u +%Y%m%dT%H%M%SZ)-$plan-$(basename "$dir")"
    out="$root/results/$out_id"

    # --- what has to be true, measured -------------------------------------
    info "preflight"

    local role marker_faked=""
    if in_bench_mode; then
        role=$(wk_image_id)
        # The override exists so this code path can be exercised at all on a
        # machine that has not been rebooted (lib/common.sh, WK_IMAGE_MARKER).
        # It is announced and recorded rather than merely allowed: the one
        # thing that must not happen is a workstation run that is *reported* as
        # a benchmark-role run, and a record that says so is the only defence
        # against a hook nobody remembers setting.
        if [ "$WK_IMAGE_MARKER" != /etc/wk-image ]; then
            marker_faked=1
            warn "WK_IMAGE_MARKER points at $WK_IMAGE_MARKER, not /etc/wk-image"
            log  "  this run is being told it is in bench mode. If that is"
            log  "  not true, the number is a workstation number. Recorded as such."
        fi
        check yes "bench mode" "${role:-image}${marker_faked:+ (marker overridden)}"
    elif [ -n "$dry" ]; then
        # A dry run describes; it does not refuse. Same rule as `wk profile
        # --dry-run`: the question is "what would this do", and answering it
        # needs no benchmark install.
        check no "bench mode" "this is host mode -- a real run refuses"
    else
        # Not a barrier, and deliberately not forceable: a barrier is a rule
        # you can decide to take responsibility for, and this is not a rule.
        # The workstation and the benchmark install produce results that are
        # indistinguishable on paper and incomparable in fact.
        die "this is host mode, and a benchmark does not run here.
    Nothing about a run on this machine-as-workstation is comparable with one
    on the benchmark install -- same command, same plan, same shape of result,
    a different machine underneath it -- and there is no way to tell the two
    apart afterwards. So it does not run.
        wk boot mbp        arm it; it prints the two clicks
        ... boot the benchmark volume, then run this there ...
    'wk bench staged --dry-run' still shows what it would do from here."
    fi

    if [ -x "$runner_script" ]; then
        check yes "run-benchmark" "$runner_script"
    else
        check no  "run-benchmark" "not in the staged tree: $runner_script"
    fi

    if [ -n "$build_dir" ] && [ -x "$build_dir/MiniBrowser.app/Contents/MacOS/MiniBrowser" ]; then
        if ls "$build_dir"/*.framework >/dev/null 2>&1; then
            check yes "the build" "$(basename "$build_dir") ${sha:+@${sha:0:10}}"
        else
            # The driver raises on exactly this, deep inside python.
            check no "the build" "no *.framework in $build_dir -- the driver refuses it"
        fi
    else
        check no "the build" "no MiniBrowser.app in ${build_dir:-$dir/WebKitBuild}"
    fi

    # PyObjC, in the interpreter this will actually use.
    if "$STAGED_PY" -c 'import objc' >/dev/null 2>&1; then
        check yes "python with PyObjC" "$STAGED_PY ($("$STAGED_PY" -V 2>&1))"
    else
        check no "python with PyObjC" "no python3 here can 'import objc' (tried /usr/bin, the CLT, Homebrew)"
        log  "        the browser driver needs it and does not autoinstall it. Either:"
        log  "          xcode-select --install                      (the CLT python3 ships it)"
        log  "          $STAGED_PY -m pip install --user pyobjc-framework-Quartz pyobjc-framework-Cocoa"
        log  "        or point WK_BENCH_PYTHON at one that has it."
    fi

    # A browser needs a window server, and a benchmark needs the *console*
    # session: driven over ssh with nobody logged in at the screen, MiniBrowser
    # has nowhere to draw and the run hangs rather than failing.
    local console; console=$(stat -f %Su /dev/console 2>/dev/null)
    if [ "$console" = "$(id -un)" ]; then
        check yes "the console session" "$console is logged in at the screen"
    else
        check no "the console session" "the screen belongs to '${console:-nobody}', not $(id -un)"
    fi

    # A laptop on battery throttles, and does it silently. A machine with no
    # battery at all -- a desktop, or a guest -- is on AC by construction, and
    # failing it for the absence of a battery would refuse every run on the one
    # kind of machine that never has this problem.
    local _batt; _batt=$(pmset -g batt 2>/dev/null | head -1)
    case "$_batt" in
        *"AC Power"*)      check yes "power" "AC" ;;
        *"Battery Power"*) check no  "power" "on battery -- the CPU is not the same CPU" ;;
        *)                 check yes "power" "no battery (a desktop, or a guest)" ;;
    esac

    # Everything the machine is doing that a run cannot pause (lib/quiet.sh).
    # Reported rather than checked one by one: each line says what it found.
    log "  the machine itself:"
    local quiet=yes
    macos_noise || quiet=no
    [ "$quiet" = yes ] || check no "quiet machine" "see above -- 'wk quiesce on' first"

    if [ "$PREFLIGHT_FAILS" -gt 0 ]; then
        if [ -n "$dry" ]; then
            warn "$PREFLIGHT_FAILS preflight check(s) would fail -- a real run would stop here"
        elif [ -z "$FORCE" ]; then
            die "$PREFLIGHT_FAILS preflight check(s) failed. Fix them, or --force to
    record the result with the failures attached to it."
        else
            warn "$PREFLIGHT_FAILS preflight failure(s) FORCED -- recorded with the result"
        fi
    fi

    # --- the run ------------------------------------------------------------
    local args="--plan $plan --browser minibrowser --platform osx"
    args="$args --build-directory $(sh_quote "$build_dir")"
    args="$args --output-file $(sh_quote "$out/result.json") --no-adjust-unit --show-iteration-values"
    [ -n "$COUNT" ] && args="$args --count $COUNT"
    [ -n "$TIMEOUT" ] && args="$args --timeout $TIMEOUT"
    [ -n "$SUBTESTS" ] && args="$args --subtests $SUBTESTS"
    # A payload that ships with the staged tree, when there is one: the run
    # then needs no network at all, which is the difference between a
    # reproducible number and one that depends on what GitHub served today.
    [ -z "$PAYLOAD" ] && [ -d "$dir/payload" ] && PAYLOAD="$dir/payload"
    [ -n "$PAYLOAD" ] && args="$args --local-copy $(sh_quote "$PAYLOAD")"
    [ -n "$BROWSER_ARGS" ] && args="$args -- $BROWSER_ARGS"

    if [ -n "$dry" ]; then
        info "dry run -- nothing was benchmarked"
        log  "  staged:  $dir"
        log  "  from:    workspace '$ws', $config${sha:+ @${sha:0:10}}"
        log  "  results: $out"
        log  "  would run, in $dir:"
        # The same string the run builds, quoting included: a volume name with
        # a space in it (the default is "WK Bench") makes an unquoted preview
        # a preview of something that would not work.
        printf '    %s\n' "$(sh_quote "$STAGED_PY") $(sh_quote "$runner_script") $args" >&2
        return 0
    fi

    ensure_dir "$out"
    staged_env_json "$out/env.json" "$dir" "$plan" "$config" "$sha" "$ws" "$role" "$marker_faked"

    info "$plan on $(sysctl -n hw.model), from '$ws' ($config${sha:+ @${sha:0:10}})"
    log  "  results: $out"

    # In the staged tree, because webkitpy resolves plans and patches relative
    # to itself and autoinstalls into it.
    set +e
    run_watched "$out/run.log" -- \
        bash -lc "cd $(sh_quote "$dir") && $(sh_quote "$STAGED_PY") $(sh_quote "$runner_script") $args"
    local rc=$?
    set -e

    staged_restore_desktop

    if [ "$rc" -ne 0 ]; then
        warn "run-benchmark exited $rc"
        # first_error knows what a *build* failure looks like; a benchmark
        # fails with a python traceback, whose interesting line is the last
        # one. Fall back to the tail rather than printing nothing, which is
        # what happened the first time this path was exercised.
        local _err; _err=$(first_error "$out/run.log" || true)
        if [ -n "$_err" ]; then
            printf '%s\n' "$_err" | sed 's/^/  /' >&2
        else
            tr '\r' '\n' < "$out/run.log" | tail -3 | sed 's/^/  /' >&2 || true
        fi
        log "  full log: $out/run.log"
        exit "$rc"
    fi

    info "BENCH OK  $plan -> $out/result.json"
    tr '\r' '\n' < "$out/run.log" | grep -iE '^(Score|Total|.*Score:)' | tail -5 | sed 's/^/  /' >&2 || true
    log ""
    log "  it is on the benchmark volume, so it survives the way back:"
    log "    wk boot mbp --back        reboot back into host mode"
    log "    wk bench staged --ls      list it from over there"
    log "    wk bench compare <other> $out/result.json"
}

# What a run that died halfway leaves behind on the desktop.
#
# The macOS browser driver turns the Dock's launch animation off before a run
# (prepare_env) and back on after it (restore_env) -- and restore_env does not
# run when the run raises, which a timed-out benchmark does. Measured: after
# one failed run, `com.apple.dock launchanim` was still 0. It is cosmetic and
# it is also *somebody's machine*, so it is put back here, and only when it is
# actually off, so this never fights webkitpy for it.
staged_restore_desktop() {
    [ "$(defaults read com.apple.dock launchanim 2>/dev/null)" = 0 ] || return 0
    defaults write com.apple.dock launchanim -bool true 2>/dev/null || return 0
    killall Dock 2>/dev/null || true
    info "restored the Dock's launch animation (the run left it off)"
}

# The record, in the same shape `wk bench` writes for a container run -- same
# file name, same three axes -- so `wk bench compare` can put one against the
# other and warn about exactly what differs.
staged_env_json() {
    local f="$1" dir="$2" plan="$3" config="$4" sha="$5" ws="$6" role="$7" faked="${8:-}"
    WK_M_PLAN="$plan" WK_M_WS="$ws" WK_M_CONFIG="$config" WK_M_SHA="$sha" \
    WK_M_ROLE="$role" WK_M_STAGED="$dir" WK_M_FAKED="$faked" \
    WK_M_COUNT="$COUNT" WK_M_FORCED="$FORCE" WK_M_NOTES="$PREFLIGHT_NOTES" \
    WK_M_CLASS="$(bench_class "$plan")" \
    WK_M_MODEL="$(sysctl -n hw.model 2>/dev/null)" \
    WK_M_CORES="$(sysctl -n hw.ncpu 2>/dev/null)" \
    WK_M_MEM="$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1024 / 1024 ))" \
    WK_M_OS="$(sw_vers -productVersion 2>/dev/null)" \
    WK_M_POWER="$(pmset -g batt 2>/dev/null | head -1)" \
    WK_M_THERM="$(pmset -g therm 2>/dev/null | sed -n 's/.*CPU_Speed_Limit *= *//p' | head -1)" \
    WK_M_DISPLAY="$("$STAGED_PY" -c 'from AppKit import NSScreen; f=NSScreen.mainScreen().frame(); print("%dx%d" % (f.size.width, f.size.height))' 2>/dev/null)" \
    "$STAGED_PY" - "$f" <<'PYEOF'
import json, os, sys
g = os.environ.get
json.dump({
    "plan": g("WK_M_PLAN"), "workspace": g("WK_M_WS"), "config": g("WK_M_CONFIG"),
    "browser": "minibrowser", "webkit_sha": g("WK_M_SHA"),
    "count": g("WK_M_COUNT"), "forced": bool(g("WK_M_FORCED")),
    "preflight_notes": g("WK_M_NOTES"),
    # The three axes, same names and same meanings as a container run.
    # bench_host is "image" and nothing else here: this code path is only
    # reachable from bench mode, because a run in any other role is
    # refused rather than relabelled.
    "class": g("WK_M_CLASS"), "runner": "browser", "arch": "native",
    "bench_host": "image", "role": g("WK_M_ROLE"),
    # True when the role was asserted by an override rather than by the
    # machine having booted the image. A run marked this way is a rehearsal.
    "role_marker_overridden": bool(g("WK_M_FAKED")),
    "staged_from": g("WK_M_STAGED"),
    # MotionMark and Speedometer both scale with the surface being drawn, so
    # the display size belongs with the number rather than in somebody's memory.
    "display": g("WK_M_DISPLAY"),
    "host": {
        "model": g("WK_M_MODEL"), "cores": g("WK_M_CORES"),
        "memory_mb": g("WK_M_MEM"), "macos": g("WK_M_OS"),
        "power": g("WK_M_POWER"), "cpu_speed_limit": g("WK_M_THERM") or "100",
    },
}, open(sys.argv[1], "w"), indent=2)
PYEOF
}

# --- dispatch ----------------------------------------------------------------
case "${1:-}" in
    ls)      shift; cmd_ls; exit 0 ;;
    compare) shift; [ $# -ge 2 ] || usage; cmd_compare "$@"; exit 0 ;;
    staged)  shift; cmd_staged "$@"; exit 0 ;;
    stage)   shift
             [ $# -ge 1 ] || usage
             cmd_stage "$@"; exit 0 ;;
    seed)    shift
             [ $# -ge 2 ] || usage
             load_bench_target "$1"
             ensure_dir "$SEED_DIR"
             seed_payload "$1" "$2" >/dev/null; exit 0 ;;
    ''|-h|--help) usage ;;
esac

WS="$1"; PLAN="${2:-}"; shift 2 2>/dev/null || usage
[ -n "$PLAN" ] || usage

while [ $# -gt 0 ]; do
    case "$1" in
        --config)   CONFIG="${2:-}"; shift 2 ;;
        --count)    COUNT="${2:-}"; shift 2 ;;
        --browser)  BROWSER="${2:-}"; shift 2 ;;
        --subtests) SUBTESTS="${2:-}"; shift 2 ;;
        --force)    FORCE=1; shift ;;
        --software) SOFTWARE=1; shift ;;
        --browser-args) BROWSER_ARGS="${2:-}"; shift 2 ;;
        *) die "unknown option: $1" ;;
    esac
done

ensure_dir "$BENCH_DIR"
ensure_dir "$SEED_DIR"
cmd_run "$WS" "$PLAN"
