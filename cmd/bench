#!/usr/bin/env python3
#
# wk bench run <workspace> <plan> [options] -- run a benchmark and keep the result defensible
# wk: where=workspace name=required takes=1 values=--list ready=yes group=workspaces needs python3 dryrun run,stage,staged,mac,mac-volume opts --list,--config=,--count=,--browser=,--subtests=,--software,--browser-args=,--cores=,--kill destructive --install,--all readonly --list,ls,precision
# wk: flag --list where=store name=none takes=0
# wk: flag --kill takes=0
# wk: sub run name=required@2 takes=1
# wk: sub stage,staged,mac,mac-volume,mac-ab,ab-summary,compare,report,precision where=host
# wk: sub seed where=dynamic name=required@2 takes=1 opts=
# wk: sub ls where=dynamic name=none takes=1 opts=--continued
# wk: sub compare,report name=none takes=4 opts=--html,--text
# wk: sub precision name=none takes=3 opts=--detect=
# wk: sub stage takes=1 opts=--to=,--config=,--plan=,--payload=
# wk: sub staged opts=--id=,--plan=,--expect-display=,--count=,--subtests=,--browser-args=,--payload=,--profile=,--timeout=,--ls,--gates
# wk: sub mac,mac-volume,mac-ab,ab-summary takes=0 passthrough=tail
#
# <plan> is Tools/Scripts/run-benchmark's own name; `wk bench --list` reads
# them off the machine's WebKit mirror, no workspace needed.
#
#   wk bench run <workspace> <plan> [--config C] [--count N] [--subtests "A B"]
#                                [--software] [--force] [--browser-args "..."]
#                                [--cores <set>]
#                                          in a container workspace, or in a
#                                          macOS guest (run-benchmark --platform
#                                          osx there, the result copied out)
#       --count N                          iterations per run (default: run-benchmark's own)
#       --cores 0-3                       pin the run to this Linux cpu list
#                                          (taskset -c) -- 0-3, 2,3, 0-1,4, 7.
#                                          Refused on a macOS guest or host:
#                                          there is no per-run pin there, only
#                                          the vCPU count chosen at boot.
#   wk bench run <workspace> --kill        stop the benchmark running there
#   wk bench seed <workspace> <plan>       fetch the benchmark payload only
#   wk bench stage <ws> --to <machine>     put a build where a bare-metal role
#                                          will find it (build in the guest,
#                                          run on the machine itself)
#       [--config C]
#       [--plan P [--payload <dir>]]...    repeatable: one pinned copy of each
#                                          benchmark the machine will run, since
#                                          a benchmark install has no network
#   wk bench staged                        run a staged build, in bench mode
#       [--plan P] [--id <staged-id>] [--count N] [--timeout S]
#       [--subtests "A B"] [--payload <dir>] [--browser-args "..."]
#       --profile <file>                   record the web process with samply
#                                          for the length of the run
#       --expect-display "<kind> <w>x<h>" the display this leg must be measured
#                                          on; refuses any other, and refuses a
#                                          second panel or a mirror set
#       --ls                               what is staged here, and what ran
#       --gates                            ask every gate a run needs -- quiet desktop,
#                                          quiesce, brightness, display mode, the
#                                          browser, this dry run, the window in
#                                          front, no virtual machine -- and run nothing
#       --force                            record it despite a preflight fail
#                                          (still refuses to run outside bench
#                                          mode -- nothing does)
#   wk bench mac <ws> [--plan P]           the whole macOS lane in one command,
#                                          driven from another machine: build,
#                                          stage, arm, wait for the one step a
#                                          person has to do, run, come back
#   wk bench mac-volume [options]          make or manage this Mac's benchmark
#                                          install, run on the Mac itself; see
#                                          wk bench mac-volume -h. --install (and --all)
#                                          erases the volume first, and asks
#   (mac, mac-volume, mac-ab and ab-summary read their own options: bench/*.sh)
#   wk bench mac-ab <ws> [--rounds N]      an interleaved A/B on the Mac's
#                                          benchmark install, with nobody in the
#                                          room: plant a job, reboot, read it
#                                          back. --preflight/--status/--collect
#   wk bench precision <run-a> <run-b>     how fine a difference the rounds so
#       [--detect PCT]                     far resolve, and how many more it
#                                          would take -- the rule an unattended
#                                          A/B stops on (default 0.3%)
#   wk bench ab-summary --runs <tsv>       the A/B's own verdict, per arm
#   wk bench report <task> [--html] [--text]  the task's A/B: one Score+Time per
#                                          subtest table, Welch/FDR, histograms
#                                          and variance per device and plan,
#                                          out of the rounds recorded so far --
#                                          a task still running is reported as
#                                          partial and says what is missing;
#                                          --html writes report-<device>-<plan>.html
#                                          into the task's directory
#   wk bench report <run-a> <run-b>        the same report for any two runs
#       [--html out.html] [--text]        (either side may be comma-separated
#                                          run directories, pooled)
#   wk bench compare <run-a> <run-b> [ws]  `wk bench report` in text mode; the
#                                          third argument is accepted and
#                                          ignored
#   wk bench ls                            every task in the fleet -- one per
#                                          wk ab, wk pi bench or wk bench
#                                          invocation, named for when it was
#                                          requested and what it measures --
#                                          with its state and each run's
#                                          directory. This machine's store
#                                          first, then every machine it knows
#                                          that answers for a store of its own,
#                                          each asked through its own wk: a
#                                          measurement is recorded once, on the
#                                          machine that took it, and read from
#                                          anywhere. WHERE names that machine
#   wk bench --list                        the plans in this machine's WebKit
#                                          mirror -- no workspace, never starts
#                                          the podman machine; it says which and
#                                          how to fix it, instead of the list,
#                                          when there is no mirror to read or
#                                          the podman machine that would answer
#                                          it is stopped
#
#   --config decides the runner: a browser port (wpe-release, gtk-release) runs
#   the plan in MiniBrowser, a JSCOnly port (jsc-release) runs it in the jsc
#   shell. The plan decides whether a GPU is required at all. `wk build --list`
#   prints every config name.
#
#   WK_BENCH_ASLR=off          disable ASLR for the run (Linux; setarch -R)
#   WK_BENCH_ENV_PAD=<bytes>   export a dummy env var of this size first
#   WK_BENCH_PATH_PAD=<n>      run through a symlink padded to <n> characters
#   WK_BENCH_SHARED_CACHE=avoid   disable macOS's dyld shared cache (variance probe)
#   every knob is off by default and is recorded into the result's
#   `configuration`, which `wk bench report` groups variance by.
#
#   WK_BENCH_MACHINE=<mbp|benchvm>   which fleet Mac this is, in host mode --
#                              nothing here can tell on its own
#   WK_BENCH_ROOT=<dir>        where staged payloads live, instead of the
#                              bench volume (host-mode testing)
#   WK_BENCH_PYTHON=<path>     the python3 to run staged benchmarks with,
#                              instead of searching for one with `objc`
#   WK_BENCH_MAX_LOAD=<n>      1-minute load average above which preflight
#                              calls the machine busy (default 4)
#   WK_STALL_SECONDS=<s>       silence before preflight warns (default 900;
#                              longer than a build's, since a benchmark
#                              reports once per subtest)
#   WK_ABORT_SECONDS=<s>       silence before a run is given up on (default 5400)
#
# Tools/Scripts/run-benchmark does the run. The environment is checked before it
# (a Speedometer score from llvmpipe is a different measurement, not a slow one),
# the payload is seeded once and pinned, and the environment -- kernel, driver,
# governor, compositor, sha, limits, architecture -- is recorded with the result.
# Preflight failures are fatal; --force downgrades them to warnings and records
# that in the run's metadata.
#
# Three axes decide what a run needs and what it may be compared with. They are
# derived rather than flagged and recorded with every result; `wk bench compare`
# warns when two runs differ on any of them:
#
#   class     gpu-class (Speedometer, MotionMark) needs a real compositor and
#             GPU; cpu-class (JetStream and the other JS benchmarks) does not,
#             which is what lets a workspace with no GPU measure anything at
#             all. Derived from the plan.
#   runner    `browser` is run-benchmark driving MiniBrowser, the official
#             number for every plan; `jsc` is the jsc shell running the
#             benchmark's own cli.js, the only thing a JSCOnly build can do.
#             Derived from the config's port.
#   host      bench_host=container (a workspace), guest (a macOS guest) or
#             image (a bootable bench system) -- not comparable with each other.

import os
import subprocess
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import act, decl, shell, targets  # noqa: E402
from wk.act import Refused  # noqa: E402
from wk.bench import cli, mac, pipeline  # noqa: E402
from wk.clock import Clock  # noqa: E402
from wk.machine import Local  # noqa: E402


BASH_ARMS = ("--list", "mac", "mac-volume", "mac-ab", "ab-summary")


def report_args(args):
    """(positionals, html, text): a bare --html is True; with a *.html word beside it, that file."""
    positional = list(args.positionals[1:])   # a third bare word is `wk bench compare`'s <ws>, accepted and ignored
    html = args.flag("--html")
    named = [p for p in positional if p.endswith(".html")]
    if html and named:
        positional.remove(named[-1])
        html = named[-1]
    return positional, html or "", args.flag("--text")


def run_arm(args, reg, clock, popen=subprocess.Popen):
    o = {"config": args.value("--config"), "count": args.value("--count"), "browser": args.value("--browser"),
         "subtests": args.value("--subtests"), "cores": args.value("--cores"), "browser_args": args.value("--browser-args"),
         "software": args.flag("--software")}
    return pipeline.run(ROOT, reg, args.positionals[1:], o, args.flag("--kill"), clock, popen)


def staged_options(args):
    return {"id": args.value("--id"), "plan": args.value("--plan"), "count": args.value("--count"), "subtests": args.value("--subtests"),
            "payload": args.value("--payload"), "profile": args.value("--profile"), "timeout": args.value("--timeout"),
            "browser_args": args.value("--browser-args"), "expect_display": args.value("--expect-display"),
            "ls": args.flag("--ls"), "gates": args.flag("--gates")}


def main(argv):
    reg = targets.Registry(ROOT, machine=Local())
    if argv[:1] == ["--where"]:
        print(cli.where(reg, argv[1:]))
        return 0
    verb = argv[0] if argv else ""
    args = decl.Args(decl.Decl(__file__), argv)
    bench = cli.Bench(ROOT, reg, Clock())
    if verb == "ls":
        return bench.ls(args.flag("--continued"))
    if verb in ("report", "compare"):
        positional, html, text = report_args(args)
        return bench.report(positional, html, text) if verb == "report" else bench.compare(positional, html)
    if verb == "precision":
        return bench.precision(args.positionals[1:], args.value("--detect") or "0.3")
    if verb == "seed":
        name = os.environ.get("WK_NAME", "")
        words = ([name] if name else []) + args.positionals[1:]
        return bench.seed(words[0] if words else "", words[1] if len(words) > 1 else "", bool(name))
    if verb == "run":
        return run_arm(args, reg, Clock())
    if verb == "stage":
        pairs = mac.plans(args.order, args.values("--plan"), args.values("--payload"))
        return mac.stage(ROOT, reg, Clock(), args.positionals[1:], args.value("--to") or "", args.value("--config"), pairs)
    if verb == "staged":
        return mac.staged(ROOT, reg, Clock(), staged_options(args))
    if verb in BASH_ARMS:
        shell.bench_arms(ROOT, *argv)
    act.die("usage: wk bench run <workspace> <plan> [options]; see wk bench -h")


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
