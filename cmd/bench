"""run a benchmark and keep the result defensible

<plan> is Tools/Scripts/run-benchmark's name for it; `wk bench plans` lists them. --preset picks the runner: a browser
port runs MiniBrowser, a JSCOnly port the jsc shell.

  wk bench run <workspace> <plan>        in a container workspace or a macOS guest
      --system <board> [--slot S]        on a board's booted bench system; in a workspace, a request to the broker
      --system <mac> [--slot S]          on a Mac's bench volume, in bench mode: its staged build S; --dry-run asks
                                         every gate a run needs and runs nothing
      --system <board> --ab A,B          an A/B of two slots on the board, or --ab-systems A,B [--slot S] of two
                                         systems holding one slot, each booted before its legs. Round 0 is a
                                         discarded warmup per arm (renderer, width, JIT tier, a profile) that can
                                         refuse the A/B; rounds alternate the lead; a subtest one arm's width cannot
                                         run is dropped from both (bench/subtest-exclusions.conf)
      --a-args "X" --b-args "Y"          an A/B of the workspace's one build under two argument sets
      --system <board> --slot <s>-instr --collect   one iteration of an instrumented slot, its PGO profile written
                                         for the next build phase
  wk bench deploy <ws> <board|mac>       put <ws>'s slot on a board's bench system, verified; or its build and a pinned
                                         copy of each plan's benchmark on a Mac's bench volume as its staged build
  wk bench ab <pr-spec|branch|sha> --devices <a,b>   an interleaved A/B of a change on the boards: slots base and
                                         pr<n> built against each device's image, deployed, alternated and reported.
                                         <pr-spec> is <n>, wpe:<n> or <owner>:<branch>
  wk bench ab --systems A,B --devices <board> --workspace <ws> [--slot S]   two bench systems on one board
  wk bench ab --devices <mac> --systems A,B --workspace <ws>   two builds staged on a Mac's bench volume, planted
                                         there, the Mac restarted into it to run them unattended; --detect defaults to
                                         0.3, --count to 2, --timeout to 1800
  wk bench ab <task> --kill              stop an A/B and every step it started
  wk bench seed <workspace> <plan>       fetch and pin the benchmark payload
  wk bench precision <run-a> <run-b>     how fine a difference the rounds resolve and how many more it would take
  wk bench report <task> | <run-a> <run-b> [out.html]   the A/B per device and plan: Score and Time per subtest,
                                         Welch/FDR, histograms, variance, the commit each arm measured and each
                                         check's verdict; each side may be comma-separated run directories, pooled
  wk bench compare <run-a> <run-b> [ws]  report in text mode; the third argument is ignored
  wk bench export <task>                 the task's report and records as <dir>/<task>.zip; --force exports one not
                                         complete
  wk bench ls                            every task on every machine this one reaches
  wk bench plans                         the plans in this machine's WebKit mirror

  WK_BENCH_ASLR=off, WK_BENCH_ENV_PAD=<bytes>, WK_BENCH_PATH_PAD=<n>, WK_BENCH_SHARED_CACHE=avoid
                                         variance probes, each recorded into the result's `configuration`, which
                                         report groups variance by
  WK_BENCH_PYTHON=<path>                 the python3 a Mac's bench volume runs benchmarks with
  WK_BENCH_ROOT=<dir>                    where a Mac's bench install keeps its staged builds and results (/var/wk)
  WK_BENCH_MAX_LOAD=<n>                  1-minute load above which preflight calls it busy (4)
  WK_STALL_SECONDS=<s>, WK_ABORT_SECONDS=<s>   silence before a warning (900) and before the run is given up on (5400)
"""
from wk import images, places, store
from wk.bench import cli
from wk.clock import Clock
from wk.decl import Command, Opt
from wk.machine import Local

ROOT = images.root()
PRESET = Opt("--preset", "the build preset", value="<preset>")
COUNT, TIMEOUT = Opt("--count", "iterations per run", value="<n>"), Opt("--timeout", "seconds one iteration may take", value="<s>")
TASK = Opt("--task", "record into an existing task (run: restart a one-run task, only if its run is not ok yet)", value="<task>")
SLOT = Opt("--slot", "the slot (default a)", value="<s>")
ROUNDS = (Opt("--rounds", "measured rounds (default 5)", value="<n>"),
          Opt("--max-rounds", "go on past --rounds until they resolve --detect, up to this (default 40)", value="<n>"),
          Opt("--detect", "the per cent the rounds must resolve (default 0: --rounds exactly)", value="<pct>"),
          Opt("--budget", "hours after which no new round starts; the one running finishes (default 8)", value="<h>"))
ARGS = (Opt("--a-args", "arm A's jsc or browser arguments", value='"X"'), Opt("--b-args", "arm B's", value='"Y"'))
COLLECT = Opt("--collect", "run: one iteration of an instrumented slot, writing its PGO profile; ab: read a Mac A/B's "
              "result onto the task and report it")
KILL = Opt("--kill", "stop it and every step it started", sets=dict(takes=()))
REPORT = dict(where="host", name="none", takes=("<task|run-a>", "[<run-b>]", "[<out.html|ws>]"),
              opts=(Opt("--html", "write report-<device>-<plan>.html into the task, or into the .html named"),
                    Opt("--text", "the text report alone")))
COMMAND = Command(name="required", ready=True, preset="--preset", values="plans", needs=("python3",), repos=("webkit",),
                  group="workspaces", subs={
    "plans": dict(where="store", name="none", readonly=True),
    "run": dict(where=cli.where, takes=("<plan>",), opts=(
        PRESET, COUNT, Opt("--browser", "the browser to drive", value="<name>"),
        Opt("--subtests", "the subtests to run", value='"A B"'), Opt("--software", "render in software (not comparable with a GPU run)"),
        Opt("--browser-args", "the browser's arguments", value='"..."'),
        Opt("--cores", "pin to this Linux cpu list (taskset -c); refused on macOS", value="<list>"), KILL,
        Opt("--system", "a board's or a Mac's bench system instead of the workspace", value="<machine>"), SLOT,
        Opt("--ab", "an A/B of two slots on the board", value="A,B"),
        Opt("--ab-systems", "an A/B of two systems holding one slot", value="A,B"), *ROUNDS, TASK, TIMEOUT,
        Opt("--exclude-subtests", "drop these subtests from both arms", value="A,B"),
        Opt("--no-warmup-profile", "no sampler in the warmup round"),
        Opt("--jit-tiers", "per-tier compile counts in the warmup round (their JSC options crash some builds)"),
        COLLECT, *ARGS)),
    "deploy": dict(takes=("<board|mac>",), opts=(SLOT, PRESET, Opt("--plan", "a plan to pin a copy of (repeatable)",
                                                                   value="<plan>"))),
    "seed": dict(where=cli.where, takes=("<plan>",)),
    "ls": dict(where=cli.where, name="none", readonly=True,
               opts=(Opt("--continued", "answer another machine's walk from this machine's store"),)),
    "compare": REPORT, "report": REPORT,
    "precision": dict(where="host", name="none", readonly=True, takes=("<run-a>", "<run-b>"),
                      opts=(Opt("--detect", "the difference to resolve, in per cent (default 0.3)", value="<pct>"),)),
    "export": dict(where="local", name="none", takes=("<task>",), destructive=True,
                   opts=(Opt("--to", "the directory the zip goes into (default ~/Downloads)", value="<dir>"),)),
    "ab": dict(where="host", name="none", takes=("[<spec|task>]",), destructive=True, opts=(
        Opt("--devices", "the boards (wk boot --list), or one Mac", value="<a,b>"),
        Opt("--release", "the image's release (default: the PR's base branch)", value="<x.y>"),
        Opt("--builder", "which image, when the release has several", value="<buildroot|yocto>"),
        Opt("--bits", "which image, when the release has several", value="<32|64>"),
        Opt("--base", "the unpatched side (default: the merge-base); more than one commit behind the head needs --force",
            value="<sha|ref>"),
        Opt("--build-on", "the machine each arm builds on, base first", value="<a[,b]>"),
        Opt("--plan", "repeatable (default speedometer3)", value="<plan>"), *ROUNDS, COUNT, TIMEOUT, TASK, KILL,
        Opt("--detach", "create the task and hand the rest to a process that outlives this one"),
        Opt("--systems", "two bench systems on one board, or two builds staged on a Mac", value="A,B"), SLOT,
        Opt("--patch", "build and stage both arms first (with --base and --preset, default mac-release-pgo)",
            value="<ref|diff>"),
        Opt("--workspace", "the workspace the arms come from", value="<ws>"), PRESET,
        Opt("--settle", "the pause before each leg (default 90)", value="<s>"), *ARGS,
        Opt("--plant", "plant the job and restart nothing"),
        Opt("--rehearse", "force every leg past its preflight, recorded as forced"),
        Opt("--preflight", "a Mac A/B's gates"), Opt("--progress", "a Mac A/B's steps"),
        Opt("--status", "the running Mac A/B job"), COLLECT))})


def words(args):
    """The workspace where the dispatcher did not take it (a Mac's bench volume holds none), then the verb's own words."""
    return ([args.name] if args.name and not store.ws_name() else []) + args.positionals[1:]


def report_args(args):
    """(positionals, html, text): a bare --html is True; with a *.html word beside it, that file."""
    positional = list(args.positionals[1:])   # a third bare word is `wk bench compare`'s <ws>, accepted and ignored
    html = args.flag("--html")
    named = [p for p in positional if p.endswith(".html")]
    if html and named:
        positional.remove(named[-1])
        html = named[-1]
    return positional, html or "", args.flag("--text")


def run(args, reg, clock):
    return cli.run(ROOT, reg, words(args), cli.options(args, preset=store.build_preset()), args.flag("--kill"), clock)


def main(args, inv):
    reg = places.Registry(ROOT, machine=Local())
    verb, word = args.positionals[0], (args.positionals[1:] or [""])[0]
    bench = cli.Bench(ROOT, reg, Clock())
    if verb == "ls":
        return bench.ls(args.flag("--continued"))
    if verb in ("report", "compare"):
        positional, html, text = report_args(args)
        return bench.report(positional, html, text) if verb == "report" else bench.compare(positional, html)
    if verb == "export":
        return bench.export(word, args.value("--to"))
    if verb == "precision":
        return bench.precision(args.positionals[1:], args.value("--detect") or "0.3")
    if verb == "seed":
        return bench.seed(store.ws_name() or args.name, word, bool(store.ws_name()))
    if verb == "run":
        return run(args, reg, Clock())
    if verb == "deploy":
        return bench.deploy(store.ws_name(), word, cli.options(args, plans=args.values("--plan"), preset=store.build_preset()))
    if verb == "ab":
        return bench.ab(word, cli.options(args, plans=args.values("--plan"), preset=store.build_preset()), args.flag("--kill"))
    return bench.plans()
