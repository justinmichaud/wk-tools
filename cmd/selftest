"""run the test suite in tests/

Three tiers, any combination; with none named, lint then unit run. A test over WK_TEST_BUDGET seconds (30) fails;
the summary prints the owed count and the slowest tests. Exempt from --dry-run: a test's effects are against fakes,
or are the live tier's purpose. A live run is refused beside another, or beside a build on this machine's books.
"""
import os
import sys

from wk import images
from wk.decl import Command, Opt
from wk.machine import here

ROOT = images.root()
COMMAND = Command(where="local", takes=("[<pattern>]",), needs=("python3",), dryrun=False, group="hosts", opts=(
    Opt("--lint", "the static rules: one pass over the tree"),
    Opt("--unit", "every test that needs no VM, machine or board"),
    Opt("--live", "the tests that make a real workspace or reach a real machine; each skips by name when its machine "
        "is absent"),
    Opt("-v", "one line per test")))


def main(args, inv):
    run = [f for f in ("--lint", "--unit", "--live", "-v") if args.flag(f)]
    for p in args.positionals:
        run += ["-k", p]
    return here().run_tty([sys.executable, os.path.join(ROOT, "tests", "run.py")] + run, cwd=ROOT).rc
