    check "a kernel config delta names an aport and well-formed options"    chk_bridge_kconfig_delta_is_declarable
    check "loads and names a device"                                      chk_bridge_confs_resolve
    check "is the inverse of"                                             chk_bridge_rm_is_inverse
    check "covers the half no command does"                               chk_bridge_help_topic
    check "is refused inside a workspace and on a shared build machine"   chk_bridge_host_only
    check "the profile and the bridge conf name the same phone"            chk_bridge_profiles_match
    check "the image carries every package the role requires"             chk_bridge_image_carries_role_packages
    check "resolves the whole chain with no"                               chk_bridge_provision_resolves
    check "refuses a headless run before it erases anything"               chk_bridge_provision_needs_a_tty
    check "can actually be told apart by content"                          chk_bridge_image_heads_are_distinguishable
    check "every pmos profile declares"                                    chk_bridge_pmos_profiles_declare_bands
    check "reaching the phone cannot hang"                                 chk_bridge_probe_cannot_hang
    check "ceiling reaches the whole process group"                        chk_capped_reaches_the_subtree
    check "a jump host's stanza carries the bounds its jump cannot inherit" chk_ssh_jump_hosts_bounded
    check "no fleet probe can outlive its ceiling"                         chk_fleet_probe_capped
    check "one tailscale auth key for the whole fleet"                     chk_one_tailnet_key
    check "puts the key on a command line"                                chk_no_authkey_in_argv
    check "the Yocto images are built with tailscale in them"             chk_tailnet_layer_is_wired
    check "the tailscale release is pinned in one file"                   chk_tailscale_pin_is_one_file
    check "no auth key is ever written into an image"                     chk_no_authkey_in_an_image
    check "a base image is never mistaken for a bench system"             chk_base_image_not_benchable
    check "every builder's output has somewhere"                          chk_gc_searches_every_build_location
    check "disk the machine is not running from"                          chk_card_helper_gate
fi

if want state; then
    section "state -- read-only is read-only, and one walk behind both listings"
    check "machine state identical before and after"                      chk_readonly_starts_nothing
    check "the same four start no guest, write no file, and repair nothing" chk_readonly_writes_nothing
    check "print the same workspace-name set on"                          chk_ls_status_same_names
    check "never copies"                                                  chk_push_keys_not_copied
    check "five words, each from the evidence that decides it"             chk_ws_state_words
    check "a status file written by an older schema"                      chk_status_files_are_claims
    check "every driver writes the same completion marker"                chk_ready_marker_one_name
    check "names each machine once"                                       chk_status_one_machine_each
    check "there is no Zed in here"                                       chk_zed_refuses_inside_a_workspace
fi

if want remote; then
    section "remote -- reaches every configured machine"
    check "a machine name is a target"          chk_remote_confs_resolve
    check "\`wk status\`/\`wk ls\` list what is on a configured machine" chk_remote_reachable
fi

[ -n "$LIST" ] && exit 0

# --- what the plan holds that this does not ----------------------------------
# Printed every run, because a runner that reports "ok" over a fraction of the
# plan and says nothing about the rest is exactly the silent pass the plan
# forbids.
plan_items=$(grep -cE '^- \[' "$PLAN" || true)
encoded=$(grep -cE '^ *check "' "$0" || true)

echo >&2
log "plan: $plan_items line items in docs/TESTING.md, $encoded encoded here"
log "      the rest are still hand-ticked -- and the manual ones always will be"

printf '\n' >&2
if [ "$drifts" -gt 0 ]; then
    warn "$passes ok, $fails failed, $skips skipped, $drifts drifted from the plan"
    exit 1
fi
if [ "$fails" -gt 0 ]; then
    warn "$passes ok, $fails failed, $skips skipped"
    exit 1
fi
info "$passes ok, $skips skipped"
exit 0
