#!/usr/bin/env bash
#
# wk selftest -- run docs/TESTING.md instead of reading it.
#
# The plan is a hand-ticked checklist, which means "run the test plan after a
# re-install" was not actually possible: every [V] in it is only as fresh as
# the last human pass. This executes the automatable part of it.
#
# Two rules, both from the plan's own preamble:
#
#   Test the property, not the configuration. Every check below runs a command
#   and looks at what happened, never at the file that was supposed to make it
#   happen.
#
#   A silent pass is not a pass. A check whose prerequisite is missing reports
#   SKIP with the reason, never nothing; and a check whose plan line has been
#   reworded reports DRIFT rather than quietly testing something the plan no
#   longer claims.
#
# That last one is what keeps this file and the plan together. Each check names
# a phrase from the docs/TESTING.md line it implements, and the phrase is
# looked up in the file at run time -- so deleting or rewriting a line without
# touching the runner is a failure, not a silent divergence.
#
# Not `wk doctor`. Doctor answers "what is provisioned here" by inspecting
# state and is safe to run anywhere at any time; this answers "does it
# behave" by running commands, and may take minutes. Doctor is run first, for
# context, and its verdict is reported rather than acted on: each section
# probes its own prerequisites, which is more honest than parsing a checklist.
#
#   0  every check passed (skips are not failures)
#   1  something failed, or the runner and the plan have drifted apart
#
# One rule for anyone adding a check here, and it is the same one at the top of
# bridge/bin/wk-bridge-healthcheck: do **not** write `something | grep -q ...`.
# grep -q exits at the first match, which can SIGPIPE the producer, and
# `pipefail` below then turns a *successful* match into a failed pipeline. It is
# invisible while the text is short and it appears as the text grows: this file
# had 34 of them, and the day docs/help/bridge.txt reached ~29 KB one of them
# started failing 24 times in 80 runs -- reported as a broken help topic, which
# it was not (2026-08-22). Use a here-string instead: `grep -q PATTERN <<<"$out"`
# reads a file rather than a pipe, so there is no producer to signal. Measured
# on the same text: 0 failures in 80.
#
# The rest of the tree still has instances of the pipe form (image/pmos-build.sh,
# cmd/sysimage, host/linux/rpi5/rpi5-setup.sh and others). They are latent for
# the same reason this one was, and sweeping them is its own job -- not silently
# half-done here.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

PLAN="$WK_ROOT/docs/TESTING.md"
WK="$WK_ROOT/wk"

SECTION=""
LIST=""

# Every section this runner knows. One list, because a name that is not in it
# has to be a refusal: `wk selftest --section <typo>` used to run nothing at
# all and exit 0 -- the silent pass the plan's own preamble forbids, and the
# worst possible one, since it is reported as "everything passed".
SECTIONS="quick state remote"

usage() {
    cat >&2 <<EOF
usage: wk selftest [--quick] [--section <name>] [--list]

  --quick            only checks that need no workspace, no podman and no ssh
  --section <name>   $(printf '%s' "$SECTIONS" | tr ' ' '|')        (more as they are encoded)
  --list             print the checks and the plan lines they implement

Exit 0 when everything checkable passed; 1 on any failure or plan drift.
EOF
    exit 2
}

while [ $# -gt 0 ]; do
    case "$1" in
        --quick)   SECTION=quick; shift ;;
        --section) SECTION="${2:-}"; shift 2 ;;
        --list)    LIST=1; shift ;;
        -h|--help) usage ;;
        *) die "unknown option: $1" ;;
    esac
done

# Before anything runs, so the refusal is immediate and names what there is.
if [ -n "$SECTION" ]; then
    case " $SECTIONS " in
        *" $SECTION "*) ;;
        *) die "no such section '$SECTION' -- there are: $SECTIONS" ;;
    esac
fi

TMP=$(mktemp -d)
_tmp_cleanup() { rm -rf "$TMP"; }
wk_atexit _tmp_cleanup

passes=0; fails=0; skips=0; drifts=0
pass()  { printf '  \033[32mok\033[0m    %s\n' "$*" >&2; passes=$((passes + 1)); }
fail()  { printf '  \033[31mFAIL\033[0m  %s\n' "$*" >&2; fails=$((fails + 1)); }
skip()  { printf '  \033[33mSKIP\033[0m  %s\n' "$*" >&2; skips=$((skips + 1)); }
drift() { printf '  \033[35mDRIFT\033[0m %s\n' "$*" >&2; drifts=$((drifts + 1)); }
detail() { printf '%s\n' "$*" | sed 's/^/        /' >&2; }
section() { printf '\n%s\n' "$*" >&2; }

want() { [ -z "$SECTION" ] || [ "$SECTION" = "$1" ]; }

# check <plan-anchor> <function>
#
# The anchor is a distinctive phrase from the docs/TESTING.md line this check
# implements, matched as a fixed string. A check that runs is a line of the
# plan actually exercised; a check whose anchor is gone is DRIFT.
#
# The function reports by exit status: 0 passed, 77 the prerequisite is absent
# (its output is the reason), anything else failed (its output is the evidence).
# 77 rather than a second function, because a prerequisite is usually only
# discoverable by starting to do the thing.
check() {
    local anchor="$1" fn="$2" out rc=0

    if [ -n "$LIST" ]; then
        printf '  %-8s %s\n' "$fn" "$anchor" >&2
        return 0
    fi

    if ! grep -qF -- "$anchor" "$PLAN"; then
        drift "$anchor"
        detail "no line in docs/TESTING.md contains this phrase any more."
        detail "Either restore the line or update the check ($fn)."
        return 0
    fi

    out=$("$fn" 2>&1) || rc=$?
    case "$rc" in
        0)  pass "$anchor" ;;
        77) skip "$anchor"; [ -n "$out" ] && detail "$out" ;;
        *)  fail "$anchor"; [ -n "$out" ] && detail "$out" ;;
    esac
    return 0
}

# --- shared helpers ----------------------------------------------------------

# Every shell file in the tree, by shebang rather than by extension -- `wk`,
# `setup` and everything under cmd/ have no suffix, and cmd/mcp is python and
# must not be handed to bash.
shell_files() {
    local f
    find "$WK_ROOT" -type f -not -path '*/.git/*' -not -path '*/__pycache__/*' 2>/dev/null \
    | while read -r f; do
        case "$(head -1 "$f" 2>/dev/null)" in
            '#!'*bash*|'#!'*/sh|'#!'*/sh\ *) echo "$f" ;;
        esac
    done
}

# A workspace that is not one: a marker naming a checkout that exists, so the
# in-workspace code paths can be exercised on a host without creating anything.
# $XDG_STATE_HOME goes with it, because targets/local.sh makes its store at
# source time and a test must not leave a directory in the real one.
fake_marker() {
    local d="$TMP/ws"
    mkdir -p "$d/WebKit" "$TMP/state"
    printf '%s\n' \
        '# written by wk selftest' \
        'name=selftest-ws' \
        "src=$d/WebKit" \
        'config=jsc-release' > "$d/marker"
    echo "$d/marker"
}

# Run `wk` as if this machine were a workspace.
as_workspace() {
    WK_MARKER="$(fake_marker)" XDG_STATE_HOME="$TMP/state" "$WK" "$@"
}

# --- quick: no workspace, no podman, no ssh ----------------------------------

# Every file, under both shells. macOS ships bash 3.2 and the host installs
# nothing extra, so a bash 5 idiom in anything the host runs is a syntax error
# on the machine it matters on.
chk_parse() {
    local f bad=""
    while read -r f; do
        [ -n "$f" ] || continue
        /bin/bash -n "$f" 2>/dev/null || bad="$bad
  bash 3.2: $f"
        bash -n "$f" 2>/dev/null || bad="$bad
  bash 5:   $f"
    done <<EOF
$(shell_files)
EOF
    [ -z "$bad" ] || { echo "does not parse:$bad"; return 1; }
}

# --- bridge: the spec, with no phone in the room ------------------------------
#
# A bridge's provisioner cannot be run here (it runs on a phone, over ssh), so
# what is checkable is the spec: that every declared bridge resolves, and that
# removal is the inverse of provisioning. The second one is the check that
# earns its place -- a file the provisioner leaves behind after `wk bridge rm`
# is a bridge that cannot be cleanly re-provisioned, and nothing notices until
# the phone behaves strangely months later.

chk_bridge_ls() {
    local out name
    out=$("$WK" bridge ls 2>&1) || { echo "exit $?: $out"; return 1; }
    for name in $(cd "$WK_ROOT/bridge/hosts" && ls *.conf 2>/dev/null | sed 's/\.conf$//'); do
        grep -q "^$name " <<<"$out" \
            || { echo "$name is declared but not listed"; return 1; }
    done
    grep -qE 'unreachable|bare|provisioned' <<<"$out" \
        || { echo "no state column in the listing"; return 1; }
}

# A kernel config delta has to be declared completely, and that is checkable
# here for nothing.
#
# `PMO_KCONFIG` makes image/pmos-build.sh patch an option into a pmaports
# kernel aport, which is the one place this repo edits somebody else's tree.
# Everything about it fails *late*: a delta with no aport to apply it to, an
# aport that does not exist in the channel, or a malformed assignment all stop
# a build that has already spent minutes installing a chroot. The declaration
# is config, so it can be read here instead.
chk_bridge_kconfig_delta_is_declarable() {
    local prof bad="" opt
    # shellcheck disable=SC1090
    . "$WK_ROOT/image/profiles.sh"
    for prof in bridge-pinephone bridge-librem5; do
        ( image_profile_load "$prof" >/dev/null 2>&1 || exit 0
          [ -n "${PMO_KCONFIG:-}" ] || exit 0
          [ -n "${PMO_KERNEL_APORT:-}" ] \
              || { echo "  $prof: PMO_KCONFIG with no PMO_KERNEL_APORT to apply it to"; exit 1; }
          # A path inside pmaports, so it must look like one rather than like a
          # bare package name -- `pmbootstrap checksum` takes the basename and
          # the edit takes the path, and only one of those survives a typo.
          case "$PMO_KERNEL_APORT" in
              */*) ;;
              *) echo "  $prof: PMO_KERNEL_APORT '$PMO_KERNEL_APORT' is not a path in pmaports"; exit 1 ;;
          esac
          for opt in $PMO_KCONFIG; do
              case "$opt" in
                  CONFIG_*=y|CONFIG_*=m|CONFIG_*=n) ;;
                  *) echo "  $prof: '$opt' is not CONFIG_<NAME>=y|m|n"; exit 1 ;;
              esac
          done
        ) || bad="$bad $prof"
    done
    [ -z "$bad" ] || { echo "kernel config deltas that would fail mid-build:$bad"; return 1; }
}

# An unknown host key must not read as an absent phone.
#
# This is the bug that cost the opening of 2026-08-22: `wk bridge ls` probed
# with plain ssh under BatchMode, which for an unknown key is *refuse* rather
# than ask, so both bridges reported `unreachable` while one of them was up,
# provisioned, healthy and one ssh away. A reflash changes the key, so this is
# the normal state of a newly installed bridge rather than an edge case.
#
# The two inputs are the messages ssh actually printed, captured from a real
# refusal against the phone (a bogus key in a temporary known_hosts) rather
# than written from memory -- which is the only way this test is worth
# anything, since it is the exact strings that make or break the match.
chk_bridge_unknown_key_is_not_absence() {
    local got
    eval "$(sed -n '/^_ls_classify()/,/^}/p' "$WK_ROOT/cmd/bridge")"
    command -v _ls_classify >/dev/null 2>&1 \
        || { echo "_ls_classify is no longer liftable out of cmd/bridge"; return 1; }

    got=$(_ls_classify "Host key verification failed.")
    [ "$got" = key-changed ] || { echo "a refused key classified as '$got'"; return 1; }

    got=$(_ls_classify "@@@ WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED! @@@
Host key for tailnet-bridge-generic has changed and you have requested strict checking.
Host key verification failed.")
    [ "$got" = key-changed ] || { echo "a changed key classified as '$got'"; return 1; }

    got=$(_ls_classify "ssh: connect to host x port 22: No route to host")
    [ "$got" = unreachable ] || { echo "an unroutable host classified as '$got'"; return 1; }

    # And the probe must ask ssh to accept a key it has never seen, or the
    # first case above is what every fresh phone reports forever.
    local probe
    probe=$(sed -n '/^_ls_probe()/,/^}/p' "$WK_ROOT/cmd/bridge")
    grep -q 'StrictHostKeyChecking=accept-new' <<<"$probe" \
        || { echo "_ls_probe does not pass accept-new -- an unflashed-looking phone is the result"; return 1; }
}

# --dry-run resolves the conf, the device table and every derived value, and
# touches nothing -- so it is also the check that a conf naming a device
# bridge/devices.sh has never heard of is a refusal rather than a surprise on
# the phone.
chk_bridge_confs_resolve() {
    local name out bad=""
    for name in $(cd "$WK_ROOT/bridge/hosts" && ls *.conf 2>/dev/null | sed 's/\.conf$//'); do
        out=$("$WK" bridge setup "$name" --dry-run 2>&1) || bad="$bad
  $name: $out"
    done
    [ -z "$bad" ] || { echo "does not resolve:$bad"; return 1; }
}

# `wk bridge provision --dry-run` is the whole chain resolved and nothing done:
# the profile derived from image/profiles.sh, the card read out of the conf, the
# image picked out of the store. Every one of those is a lookup that can come
# back empty, and a provision run that discovers it *after* erasing a card is
# the version of this that costs something -- so it is resolved here, with no
# phone in the room.
chk_bridge_provision_resolves() {
    local name out bad=""
    for name in $(cd "$WK_ROOT/bridge/hosts" && ls *.conf 2>/dev/null | sed 's/\.conf$//'); do
        # There is one route -- onto the phone's internal storage, through a
        # service image -- so a bridge either resolves the whole chain or is
        # refused for want of that service image. Both are correct outcomes;
        # anything else means one of the two derived joins has broken.
        if out=$("$WK" bridge provision "$name" --dry-run 2>&1); then
            # A dry run that resolved nothing would still exit 0, so each value
            # that cannot be defaulted is checked for rather than assumed.
            grep -q '^  profile:  bridge-' <<<"$out" \
                || bad="$bad
  $name: no profile derived -- no pmos profile in image/profiles.sh sets PMO_BRIDGE=$name"
            grep -q '^  card:     [a-z0-9-]*:/dev/' <<<"$out" \
                || bad="$bad
  $name: no card -- its conf sets no BR_CARD, so provision cannot write one"
            grep -q '^  onto:     the phone.s internal storage, through recovery-' <<<"$out" \
                || bad="$bad
  $name: resolved without naming the service image that reaches internal storage"
        else
            # The Librem 5's true state: Jumpdrive is a PinePhone project. A
            # refusal for any other reason means the PMO_DEVICE/FET_DEVICE join
            # has broken, and the PinePhone would be next.
            case "$out" in
                *"no service image for"*) ;;
                *) bad="$bad
  $name: refused, but not because no service image exists: $out" ;;
            esac
        fi
    done
    [ -z "$bad" ] || { echo "does not resolve:$bad"; return 1; }
}

# provision refuses to run without a terminal, and refuses *before* the write.
# Two of its steps are a person, so a headless run cannot finish -- and the
# order matters more than the refusal: finding out after erasing a card is the
# expensive way to learn it. Driven with --no-write so that a regression here
# cannot itself destroy a card.
chk_bridge_provision_needs_a_tty() {
    local out
    out=$("$WK" bridge provision tailnet-bridge-generic --no-write </dev/null 2>&1) \
        && { echo "it ran to completion with no terminal; it should have refused"; return 1; }
    case "$out" in
        *"needs a terminal"*) ;;
        *) echo "refused, but not for the reason it should have: $out"; return 1 ;;
    esac
}

# The eMMC route tells the Jumpdrive card from the phone's storage by hashing
# the first mebibyte of each and matching it against the image it just wrote. That
# only works if two things are true of the images themselves, and neither is
# something to assume: each carries its device's bootloader at the offset the
# device's ROM looks for it, and the two heads *differ*. Identical heads would
# make every exported disk look like the card.
chk_bridge_image_heads_are_distinguishable() {
    local a b ja jb f
    a=$("$WK" sysimage ls 2>/dev/null | awk '/^bridge-pinephone-/ { print $1 }' | tail -1)
    b=$("$WK" sysimage ls 2>/dev/null | awk '/^recovery-pinephone-/ { print $1 }' | tail -1)
    [ -n "$a" ] && [ -n "$b" ] || { echo "skip: needs a bridge-pinephone and a recovery-pinephone image in the store"; return 0; }
    a=$(_bridge_image_disk "$a"); b=$(_bridge_image_disk "$b")
    [ -f "$a" ] && [ -f "$b" ] || { echo "one of the images has no disk.img: $a $b"; return 1; }

    # eGON.BT0 at 8196 is the sunxi boot ROM's magic, and 8 KiB is the offset
    # `deviceinfo_sd_embed_firmware` declares for a PinePhone. Without it the
    # card is not bootable and every later step is moot.
    for f in "$a" "$b"; do
        [ "$(dd if="$f" bs=1 skip=8196 count=8 2>/dev/null)" = "eGON.BT0" ] \
            || { echo "$f has no sunxi SPL at offset 8192 -- that card would not boot"; return 1; }
    done

    ja=$(dd if="$a" bs=1048576 count=1 2>/dev/null | sha256sum | cut -d' ' -f1)
    jb=$(dd if="$b" bs=1048576 count=1 2>/dev/null | sha256sum | cut -d' ' -f1)
    [ -n "$ja" ] && [ "$ja" != "$jb" ] \
        || { echo "the two images' first mebibytes are identical ($ja) -- the eMMC route could not tell the card from the phone's storage"; return 1; }
    # And not the sha256 of nothing, which is what an unreadable file hashes to.
    [ "$ja" != e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 ] \
        || { echo "hashed zero bytes -- the discriminator would match nothing"; return 1; }
}

# Where an image's disk.img lives, without sourcing the store libs into the
# selftest: `wk sysimage show` is the interface that answers for the store.
_bridge_image_disk() {
    local root
    if [ "$(uname -s)" = Darwin ]; then root="${XDG_STATE_HOME:-$HOME/.local/state}/wk"
    else root="${WK_STORE:-/var/lib/wk}"; fi
    echo "$root/images/$1/disk.img"
}

# Every pmos profile has to declare which bands its phone's radio has, because
# the guard that stops an unreachable image being built reads that field and
# skips silently when it is empty. A new phone added without it gets no
# protection at all, and the failure it protects against is the expensive one:
# an image that verifies perfectly and boots into isolation.
chk_bridge_pmos_profiles_declare_bands() {
    local prof out bad=""
    for prof in bridge-pinephone bridge-librem5; do
        out=$("$WK" sysimage build "$prof" --dry-run 2>&1) \
            || { bad="$bad
  $prof: --dry-run does not resolve: $out"; continue; }
        grep -q '^  radio ' <<<"$out" \
            || bad="$bad
  $prof: its dry run names no radio bands, so PMO_WIFI_BANDS is unset and the
      uplink-band guard would pass anything for this phone"
    done
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}

# Reaching the phone must not be able to hang, and this is checkable without a
# phone.
#
# The bug it guards against was measured, not imagined: ssh's `ConnectTimeout`
# bounds the TCP connect and nothing after it, and BSD `nc -w` documents itself
# as "Timeout for connects and final net reads" while running 75 seconds against
# a black-holed address (1.05 s for `-G1`). A phone half-way into suspend
# accepts and stalls exactly that way, so the ceiling is enforced by `_capped`
# rather than by trusting any tool's own flag -- and what is tested here is the
# ceiling, not the flag.
chk_bridge_probe_cannot_hang() {
    local t0 t1 d
    # shellcheck disable=SC1090
    . "$WK_ROOT/lib/common.sh"
    eval "$(sed -n '/^_reaches()/,/^}/p' "$WK_ROOT/cmd/bridge")"

    # The cap itself: a command that would run for 20s must not.
    t0=$(date +%s); capped 1 sleep 20 >/dev/null 2>&1 || true; t1=$(date +%s)
    d=$((t1 - t0))
    [ "$d" -le 4 ] || { echo "capped 1 took ${d}s -- the ceiling is not being enforced"; return 1; }

    # And a reachability attempt against an address that will never answer.
    # 192.0.2.1 is TEST-NET-1, unroutable anywhere this runs.
    t0=$(date +%s); _reaches root@192.0.2.1 >/dev/null 2>&1 || true; t1=$(date +%s)
    d=$((t1 - t0))
    [ "$d" -le 16 ] || { echo "an unroutable address took ${d}s -- reaching the phone can hang"; return 1; }
}

# The ceiling has to reach what the command *started*, and it has to let go of a
# command that finished. Both halves have been wrong at some point in a
# hand-rolled version of this: `capped 5 probe` runs a function in a subshell, so
# a TERM aimed at the subshell alone leaves its ssh running -- holding the
# terminal, printing into a listing that has moved on -- and a watchdog reaped by
# signalling its wrapper rather than its `sleep` holds every caller for the whole
# ceiling, which would make each fleet probe cost its own timeout even when the
# machine answered instantly.
chk_capped_reaches_the_subtree() {
    local t0 d left
    # shellcheck disable=SC1090
    . "$WK_ROOT/lib/common.sh"

    # A grandchild with a duration nothing else in the tree uses, so pgrep can
    # only match this one.
    t0=$(date +%s)
    capped 1 bash -c 'sleep 31.5 & wait' >/dev/null 2>&1 || true
    d=$(( $(date +%s) - t0 ))
    [ "$d" -le 4 ] || { echo "capped 1 took ${d}s"; return 1; }

    left=$(pgrep -f 'sleep 31.5' 2>/dev/null | wc -l | tr -d ' ')
    [ "$left" = 0 ] || {
        pkill -f 'sleep 31.5' 2>/dev/null || true
        echo "the ceiling killed the child and left $left grandchild(ren) running"
        return 1
    }

    # And the fast path: a command that returns at once must not be held for the
    # rest of the ceiling.
    t0=$(date +%s); capped 20 true; d=$(( $(date +%s) - t0 ))
    [ "$d" -le 2 ] || { echo "capped 20 true took ${d}s -- callers pay the whole ceiling"; return 1; }
}

# Options on an ssh command line do not reach a ProxyJump child: the hop is
# `ssh -l <user> -p <port> -W host:port <jump>` and nothing else is passed. So
# every bound a probe through a jump host depends on has to be in that host's own
# stanza, and this reads the file the way the jump child reads it rather than
# grepping it -- what matters is what ssh resolves, not what the file appears to
# say. `wk status` hung on exactly this (docs/TESTING.md, the fleet block).
chk_ssh_jump_hosts_bounded() {
    local conf="$WK_ROOT/dotfiles/ssh/config" j opts mode to bad=""
    have ssh || { echo "no ssh on this machine"; return 77; }

    for j in $(awk '$1 == "ProxyJump" { print $2 }' "$conf" \
                 | tr ',' '\n' | sed 's/.*@//; s/:[0-9]*$//' | sort -u); do
        opts=$(ssh -G -F "$conf" "$j" 2>/dev/null) || opts=""
        mode=$(printf '%s\n' "$opts" | awk '$1 == "stricthostkeychecking" { print $2 }')
        to=$(printf   '%s\n' "$opts" | awk '$1 == "connecttimeout" { print $2 }')
        # `false` is how ssh -G spells StrictHostKeyChecking=no.
        case "$mode" in
            accept-new|no|false|off) ;;
            *) bad="$bad
  $j: StrictHostKeyChecking is '${mode:-unset}' -- an unknown key asks on the
      terminal, and a probe whose output goes to a file waits there forever" ;;
        esac
        case "$to" in
            ''|none|0) bad="$bad
  $j: no ConnectTimeout -- the hop is unbounded, and so is every probe
      through it" ;;
        esac
    done
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}

# A probe that never returns must cost the listing its ceiling and its own line,
# not the command. The stub stands in for the driver: what is being tested is
# report_fleet_device's contract, and a real hanging probe needs a phone in a
# drawer to reproduce.
chk_fleet_probe_capped() {
    local out t0 d
    # shellcheck disable=SC1090
    . "$WK_ROOT/lib/common.sh"
    # The record emitter as well as the function under test, and fd 3 opened
    # onto stdout, because that is where a record goes. Lifted by name rather
    # than by assuming a `printf`: what this checks is that a machine dropped
    # for time still *says something*, and how `wk status` says things is not
    # this check's business -- it was coupled to the old printf and broke on a
    # refactor that had kept the behaviour perfectly.
    eval "$(sed -n '/^_jesc()/,/^}/p'      "$WK_ROOT/cmd/status")"
    eval "$(sed -n '/^rec_start()/,/^}/p'  "$WK_ROOT/cmd/status")"
    eval "$(sed -n '/^report_fleet_device()/,/^}/p' "$WK_ROOT/cmd/status")"

    _fleet_probe() { sleep 30; }
    WK_FLEET_TIMEOUT=1

    t0=$(date +%s); out=$(report_fleet_device rpi4 3>&1 2>/dev/null); d=$(( $(date +%s) - t0 ))
    [ "$d" -le 10 ] || { echo "a probe that never returns held the fleet block ${d}s"; return 1; }
    case "$out" in
        *rpi4*) ;;
        *) echo "a probe killed for time said nothing about its machine: '$out'"; return 1 ;;
    esac
}

# One key, one place, every join path -- and no join that needs a person.
#
# The rule it serves is the fleet's: everything wk touches is on the tailnet, and
# a node is reached by its tailnet name with nothing about how to reach it stored
# anywhere (CLAUDE.md, "Cattle, not pets"). A path that stops to ask for a
# credential is a path that gets skipped, and a device that never joined is a
# device whose address somebody writes down.
chk_one_tailnet_key() {
    local f bad="" reads
    for f in cmd/pi cmd/bridge bench/mac-bench-volume.sh; do
        grep -q 'wk_tailscale_authkey' "$WK_ROOT/$f" || bad="$bad
  $f joins the tailnet without resolving the key through wk_tailscale_authkey"
    done

    # `prompt_secret` is the one reader of a secret, and it stores what it reads
    # so it is asked for once. A `read` of an auth key anywhere else is a second
    # copy of the credential and an unscriptable command.
    reads=$(grep -rn 'read -r[s]* *[A-Za-z_]*[Aa][Uu][Tt][Hh]' \
                "$WK_ROOT/cmd" "$WK_ROOT/bench" "$WK_ROOT/bridge" \
                "$WK_ROOT/boot" "$WK_ROOT/image" 2>/dev/null || true)
    [ -z "$reads" ] || bad="$bad
  an auth key is read outside prompt_secret:
$reads"

    [ -z "$bad" ] || { echo "$bad"; return 1; }
}

# argv is world readable in /proc, so a key on a command line is a key handed to
# anything with a shell on that machine -- including the board under test.
# `--auth-key file:<path>` is the spelling that does not do that.
chk_no_authkey_in_argv() {
    local hits line bad=""
    hits=$(grep -rn -e '--auth-\{0,1\}key' \
               "$WK_ROOT/cmd" "$WK_ROOT/bench" "$WK_ROOT/bridge" \
               "$WK_ROOT/boot" "$WK_ROOT/image" "$WK_ROOT/lib" 2>/dev/null \
             | sed 's/^\([^:]*:[0-9]*:\)[[:space:]]*/\1/' | grep -v ':#' || true)
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        case "$line" in
            *file:*) ;;
            *) bad="$bad
  $line" ;;
        esac
    done <<EOF
$hits
EOF
    [ -z "$bad" ] || { echo "a tailscale key is passed through argv:$bad"; return 1; }
}

# The image half of "everything wk touches is on the tailnet": tailscale is in
# the image, the build is allowed to fetch it, and the pin is one file.
#
# All three are checkable without a build, which matters because the build that
# would check them properly is hours long -- and the failure mode of getting it
# wrong is not a broken build but a *silent* one: an image that comes off the
# line without tailscale looks exactly like an image with it until a board is
# written, booted, and does not appear on the tailnet.
TS_INC="image/yocto/meta-wk-tailnet/recipes-network/tailscale/tailscale-release.inc"

chk_tailnet_layer_is_wired() {
    local bad="" f
    f="$WK_ROOT/image/yocto/meta-wk-tailnet"
    [ -f "$f/conf/layer.conf" ] || bad="$bad
  no layer at $f"
    grep -q 'meta-wk-tailnet' "$WK_ROOT/image/yocto-build.sh" || bad="$bad
  image/yocto-build.sh does not add the layer to bblayers, so the recipe is
      parsed by nothing and the image is built without it"
    grep -q 'IMAGE_INSTALL:append = " tailscale"' "$WK_ROOT/image/yocto-build.sh" || bad="$bad
  nothing puts tailscale in IMAGE_INSTALL: the layer would be on the layer list
      and the image still would not carry it"
    # The one fetch that cannot come from the Yocto source mirror.
    grep -q '"tailscale.com"' "$WK_ROOT/container/proxy/wk-proxy.py" || bad="$bad
  the workspace egress allowlist has no tailscale.com, so the recipe's fetch is
      refused and the build fails hours in"
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}

# One pin, two installers. `wk pi setup` pushes tailscale onto a board that is
# already running and the recipe ships it in the image; a version in both places
# is two versions the first time one of them is bumped.
chk_tailscale_pin_is_one_file() {
    local inc="$WK_ROOT/$TS_INC" ver bad="" a
    [ -f "$inc" ] || { echo "no $TS_INC"; return 1; }

    ver=$(sed -n 's/^TS_VERSION = "\(.*\)"$/\1/p' "$inc" | head -1)
    case "$ver" in
        [0-9]*.[0-9]*) ;;
        *) bad="$bad
  $TS_INC declares no usable TS_VERSION (got '${ver:-nothing}')" ;;
    esac

    # arm64 and arm, because the fleet is 64-bit boards plus one armv7l rpi3.
    for a in arm64 arm; do
        case "$(sed -n "s/^TS_SHA256_$a = \"\(.*\)\"\$/\1/p" "$inc" | head -1)" in
            [0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
            *) bad="$bad
  $TS_INC has no sha256 for $a, so that architecture cannot be verified" ;;
        esac
    done

    grep -q "require .*tailscale-release.inc" \
        "$WK_ROOT/image/yocto/meta-wk-tailnet/recipes-network/tailscale/tailscale.bb" \
        || bad="$bad
  the recipe does not require the release .inc, so its pin is its own"

    grep -q 'tailscale-release.inc' "$WK_ROOT/cmd/pi" || bad="$bad
  cmd/pi does not read the release .inc, so a board gets whatever version is
      written in cmd/pi"
    # The third installer: the buildroot images have no recipe and no systemd,
    # so they take the same bytes through a rootfs overlay -- and the same join
    # script, from the same file, rather than a copy that drifts.
    grep -q 'tailscale-release.inc' "$WK_ROOT/image/buildroot/tailnet-overlay.sh" || bad="$bad
  the buildroot overlay does not read the release .inc"
    grep -q 'meta-wk-tailnet/recipes-network/tailscale/files/wk-tailnet-join' \
        "$WK_ROOT/image/buildroot/tailnet-overlay.sh" || bad="$bad
  the buildroot overlay ships its own copy of wk-tailnet-join instead of the
      one the Yocto images run"
    # And no second copy of the version hiding in the pusher.
    grep -qE '^TS_VERSION="\$\{TS_VERSION:-[0-9]' "$WK_ROOT/cmd/pi" && bad="$bad
  cmd/pi still carries a literal tailscale version"

    [ -z "$bad" ] || { echo "$bad"; return 1; }
}

# An image is stored, compressed, copied between machines and kept after it is
# superseded. A credential inside one is a credential in every copy of it, and
# revoking it means revoking it for the whole fleet -- so the key reaches the
# *card*, one boot before the join spends it, and never the image.
chk_no_authkey_in_an_image() {
    local hits
    hits=$(grep -rln 'wk_tailscale_authkey' "$WK_ROOT/image" "$WK_ROOT/cmd/sysimage" 2>/dev/null || true)
    [ -z "$hits" ] || {
        echo "the image build path resolves an auth key, which puts it inside the artifact:
$hits"
        return 1
    }
    grep -q 'disk_seed_tailnet' "$WK_ROOT/cmd/sysimage" || {
        echo "nothing seeds the tailnet identity onto a written card, so an image that
      carries the join has nothing to join with"
        return 1
    }
}

# The base image is not a bench system, and the fleet has to be able to tell --
# which for months it could not: every image wk writes carries /etc/wk-image, so
# "has a marker" meant "is a bench system", and a board that had fallen back to
# the medium it is never armed from was measured like one. This is the
# classifier, checked against both boards' declared media, with no board in the
# room.
chk_base_image_not_benchable() {
    local bad="" got
    # shellcheck disable=SC1090
    . "$WK_ROOT/lib/common.sh"
    . "$WK_ROOT/lib/image.sh" 2>/dev/null || true
    . "$WK_ROOT/image/profiles.sh"
    . "$WK_ROOT/boot/machines.sh"

    machine_load rpi4 || { echo "no rpi4 machine conf"; return 1; }
    for pair in "/dev/sda2 bench" "/dev/mmcblk0p2 base" " unknown"; do
        set -- $pair
        got=$(b_system_kind "${2:+$1}")
        [ "$got" = "${2:-$1}" ] || bad="$bad
  rpi4: root on ${1:-<nothing>} classified '$got', expected '${2:-$1}'"
    done

    # The rpi3's decided shape (`wk help hardware`): one card, two systems --
    # the rescue on MACH_ROOT and the bench system in a second root beside it,
    # because that board's Ethernet is a USB device and its bench root must not
    # share that bus. So the same question -- which medium is this root on --
    # answers it here too, with MACH_ROOT tested first because on this board both
    # patterns match.
    machine_load rpi3 || { echo "no rpi3 machine conf"; return 1; }
    got=$(b_system_kind /dev/mmcblk0p2)
    [ "$got" = base ] || bad="$bad
  rpi3: its rescue root classified '$got', expected 'base'"
    got=$(b_system_kind /dev/mmcblk0p4)
    [ "$got" = bench ] || bad="$bad
  rpi3: a bench slot on the same card classified '$got', expected 'bench'"

    # And the refusal that uses it.
    grep -q 'b_system_kind' "$WK_ROOT/cmd/pi" || bad="$bad
  wk pi bench does not ask which medium the board booted from, so a base image
      passes its check exactly as it did before"
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}

# Every builder's output has somewhere `wk gc` looks.
#
# With no image store, output lives wherever the builder that made it put it --
# so the set of places to search grows with the set of builders, and a search
# that is a guess is one that misses the newest one. The list is declared
# (image_build_locations, lib/image.sh) with a `# builder: <name>` annotation per
# entry, and this checks the annotations against the builders that actually
# exist in image/profiles.sh. A builder added without a line there is caught
# here rather than by somebody wondering where 60 GB went.
chk_gc_searches_every_build_location() {
    local builders declared b bad=""
    builders=$(sed -n 's/^[[:space:]]*IMG_BUILDER=\([a-z]*\).*/\1/p' \
                   "$WK_ROOT/image/profiles.sh" | sort -u)
    # One annotation can name more than one builder, so split on the comma
    # *and* trim each piece before cutting the prose off it -- cutting at the
    # first space without trimming first turns " fetch -- ..." into nothing,
    # which is a check that passes while missing a builder.
    declared=$(sed -n '/^image_build_locations()/,/^}/p' "$WK_ROOT/lib/image.sh" \
             | sed -n 's/^[[:space:]]*#[[:space:]]*builder:[[:space:]]*//p' \
             | tr ',' '\n' \
             | sed 's/^[[:space:]]*//; s/[[:space:]].*$//' \
             | grep . | sort -u)

    for b in $builders; do
        printf '%s\n' "$declared" | grep -qx "$b" || bad="$bad
  IMG_BUILDER=$b has no entry in image_build_locations, so wk gc does not know
      where that builder leaves its output"
    done

    grep -q 'image_build_locations' "$WK_ROOT/cmd/gc" || bad="$bad
  wk gc does not read image_build_locations, so the list is a list of nothing"
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}

# The card helper's grant is what its gate refuses, so the gate is the thing to
# check -- and most of it is checkable with no card and no root, by reading the
# script. What cannot be checked here (does it actually refuse a running disk on
# a real machine) was run against the rpi4 on 2026-08-24 and is recorded in
# docs/TESTING.md; what is checked here is that the *shape* the grant depends on
# has not quietly changed.
chk_card_helper_gate() {
    local f="$WK_ROOT/admin/wk-card-priv" bad="" v
    [ -f "$f" ] || { echo "no card helper at $f"; return 1; }

    # Every verb that touches a device must run the gate. A verb that skips it
    # is a hole in a NOPASSWD grant, which is the one bug class here that
    # matters more than any other.
    for v in v_check v_write v_fleet v_tailnet v_identity v_grow v_eject; do
        sed -n "/^$v() {/,/^}/p" "$f" | grep -q 'gate ' \
            || bad="$bad
  $v does not call gate, so it would act on a device nothing validated"
    done

    # The two-item transport list, stated as such.
    sed -n '/^gate()/,/^}/p' "$f" | grep -q 'usb|mmc' || bad="$bad
  gate no longer restricts the transport to usb and mmc"
    sed -n '/^gate()/,/^}/p' "$f" | grep -q 'booted_disks' || bad="$bad
  gate no longer checks whether the machine is running from the disk -- every
      board here boots from exactly the kind of device the transport check allows"

    # No passthrough: the dispatcher's default must not run anything.
    sed -n '/^case "\$verb" in/,/^esac/p' "$f" | grep -q '\*) fail' || bad="$bad
  the verb dispatcher has a default that is not a refusal"

    # And the install must copy it root-owned rather than pointing sudoers at
    # the repo, which would make a branch checkout a root escalation.
    grep -q 'install -o root -m 0755 "\$_card_source" "\$_card_target"' \
        "$WK_ROOT/admin/install.sh" || bad="$bad
  admin/install.sh does not install the card helper root-owned"
    [ -z "$bad" ] || { echo "$bad"; return 1; }
}

chk_bridge_rm_is_inverse() {
    local written removed p tok covered missing=""

    # What provisioning writes, by our own name. Files it *edits* that belong to
    # the image (/etc/hostname, /etc/hosts, sshd_config's Include line) are
    # deliberately out of scope: those are edits, not files we own, and `rm`
    # leaving them alone is the correct behaviour.
    # `sed 's/"//'` and not `"\?"`: BSD sed has no `\?`, and a pattern that
    # silently matches nothing here would turn this check into a silent pass.
    # $BR_IF becomes a glob, because the interface name is a conf field.
    written=$( { grep -oE 'write_file "?/[^" ]+' "$WK_ROOT/bridge/provision.sh" \
                   | sed 's/^write_file //; s/^"//'
                 # The service files, which are installed rather than written.
                 ls "$WK_ROOT/bridge/init.d" 2>/dev/null | sed 's|^|/etc/init.d/|'
               } | grep wk-bridge | sed 's/\$BR_IF/*/' | sort -u)
    [ -n "$written" ] || { echo "no wk-bridge paths found in bridge/"; return 1; }

    # What removal actually removes: the script cmd_rm feeds to the phone, and
    # nothing else. Deriving this from the whole function was the first attempt
    # and it passed a deliberately broken `rm` -- because cmd_rm also *prints*
    # the paths it is about to remove, and prose counted as evidence. `$s` is
    # the service loop's variable, so it stands for any of our service names.
    removed=$(awk '/rsh "\$PRIV sh -s" <</ { on = 1; next } on && /^EOF$/ { exit } on { print }' \
                  "$WK_ROOT/cmd/bridge" \
              | grep -oE '/[a-zA-Z0-9_./$*-]+' | sed 's/\$s/wk-bridge-*/' | sort -u)
    [ -n "$removed" ] || { echo "cmd_rm's deprovisioning script did not parse out of cmd/bridge"; return 1; }

    for p in $written; do
        covered=""
        for tok in $removed; do
            # shellcheck disable=SC2053
            [[ "$p" == $tok ]] && { covered=1; break; }
        done
        [ -n "$covered" ] || missing="$missing
  $p"
    done
    [ -z "$missing" ] || { echo "written by provision.sh, never removed by 'wk bridge rm':$missing"; return 1; }
}

# A bridge's system and its role are declared in two files, and they have to
# agree: the profile says which phone it builds for, the bridge conf says which
# phone the role runs on. Disagreeing, they produce an image for one device
# provisioned as if it were the other -- and nothing before the phone fails to
# boot would notice.
chk_bridge_profiles_match() {
    local prof out device bridge conf declared bad=""
    for prof in bridge-pinephone bridge-librem5; do
        out=$("$WK" sysimage build "$prof" --dry-run 2>&1) || { echo "$prof: does not resolve: $out"; return 1; }
        device=$(printf '%s\n' "$out" | sed -n 's/^  device *\([^ ]*\).*/\1/p' | head -1)
        bridge=$(printf '%s\n' "$out" | sed -n 's/^  for bridge *\([^ ]*\).*/\1/p' | head -1)
        [ -n "$device" ] || { bad="$bad
  $prof: the dry run names no device"; continue; }
        conf="$WK_ROOT/bridge/hosts/$bridge.conf"
        [ -f "$conf" ] || { bad="$bad
  $prof: names bridge '$bridge', which has no conf"; continue; }
        declared=$(sed -n 's/^BR_DEVICE=//p' "$conf" | head -1)
        # pinephone <-> pine64-pinephone, librem5 <-> purism-librem5: the pmOS
        # codename has to contain the device name bridge/devices.sh uses.
        case "$device" in
            *"$declared"*) ;;
            *) bad="$bad
  $prof: builds for '$device' but $bridge.conf says BR_DEVICE=$declared" ;;
        esac
    done
    [ -z "$bad" ] || { echo "profile and bridge conf disagree:$bad"; return 1; }
}

# The image bakes in the packages the role needs, and the point of that is a
# provisioning run that touches no network: `wk bridge setup` reports "all
# packages present -- apk not contacted". A package the provisioner requires and
# the profile does not carry breaks that quietly -- provisioning still works,
# over egress the bridge segment may not have, against an apk index that may
# have moved on. Months later, on a phone in a drawer.
chk_bridge_image_carries_role_packages() {
    local required profile_pkgs p missing=""
    required=$(sed -n 's/^REQUIRED="\(.*\)"$/\1/p;s/^OPTIONAL="\(.*\)"$/\1/p' \
                   "$WK_ROOT/bridge/provision.sh")
    [ -n "$required" ] || { echo "could not read the package lists out of bridge/provision.sh"; return 1; }
    # Both profiles carry the same list plus ffmpeg for the camera one, so the
    # pinephone's is the strict subset to check against.
    profile_pkgs=$(sed -n 's/^ *PMO_PACKAGES="\([^"]*\)".*/\1/p' "$WK_ROOT/image/profiles.sh" \
                   | tr ',' ' ')
    [ -n "$profile_pkgs" ] || { echo "could not read PMO_PACKAGES out of image/profiles.sh"; return 1; }
    for p in $required; do
        case " $profile_pkgs " in
            *" $p "*) ;;
            *) missing="$missing $p" ;;
        esac
    done
    [ -z "$missing" ] || { echo "bridge/provision.sh needs these and the image does not carry them:$missing
  A first provision would then need egress from the phone to install them."; return 1; }
}

# The half no command does -- flashing postmarketOS -- has to be written down
# somewhere, and the topic is where a person looks.
chk_bridge_help_topic() {
    local out
    out=$("$WK" help bridge 2>&1) || { echo "exit $?"; return 1; }
    grep -qi 'postmarketos' <<<"$out" \
        || { echo "the topic never mentions postmarketOS, which is the part no command does"; return 1; }
    grep -q 'pine64-pinephone' <<<"$out" \
        || { echo "no pmOS device name in the topic"; return 1; }
}

# It acts on a phone over ssh from a workstation's own configuration, so it is
# host-only; and the listing is a report, which must not start anything.
chk_bridge_host_only() {
    local out before after
    out=$(as_workspace bridge ls 2>&1) && { echo "not refused inside a workspace"; return 1; }
    grep -q 'acts on a host' <<<"$out" \
        || { echo "refused, but not as a host-only command: $out"; return 1; }

    have podman || return 0
    before=$(podman machine inspect "${WK_MACHINE:-wk}" --format '{{.State}}' 2>/dev/null || echo none)
    [ "$before" = running ] && return 0
    "$WK" bridge ls >/dev/null 2>&1 || { echo "wk bridge ls failed"; return 1; }
    after=$(podman machine inspect "${WK_MACHINE:-wk}" --format '{{.State}}' 2>/dev/null || echo none)
    [ "$after" = "$before" ] || { echo "podman machine went $before -> $after"; return 1; }
}

# An orphan command is invisible: it works and nobody knows it is there.
chk_help_commands() {
    local help c n missing=""
    help=$("$WK" help 2>&1 || true)
    for c in "$WK_ROOT"/cmd/*; do
        [ -f "$c" ] && [ -x "$c" ] || continue
        n=$(basename "$c")
        grep -qE "^  $n( |\$)" <<<"$help" || missing="$missing $n"
    done
    [ -z "$missing" ] || { echo "not listed by 'wk help':$missing"; return 1; }
}

chk_build_list() {
    local out
    out=$("$WK" build --list 2>&1) || { echo "exit $?: $out"; return 1; }
    grep -q 'jsc-release' <<<"$out" || { echo "no jsc-release in the table"; return 1; }
    grep -q 'mac-release' <<<"$out" || { echo "no mac-release in the table"; return 1; }
}

# The table is a static lookup; it used to boot a two-minute VM to print it,
# and on a host without podman it failed naming a problem it did not have.
chk_build_list_starts_nothing() {
    local before after
    have podman || { echo "no podman on this machine"; return 77; }
    before=$(podman machine inspect "${WK_MACHINE:-wk}" --format '{{.State}}' 2>/dev/null || echo none)
    [ "$before" = running ] && { echo "the podman machine is already running"; return 77; }
    "$WK" build --list >/dev/null 2>&1 || { echo "wk build --list failed"; return 1; }
    after=$(podman machine inspect "${WK_MACHINE:-wk}" --format '{{.State}}' 2>/dev/null || echo none)
    [ "$after" = "$before" ] || { echo "podman machine went $before -> $after"; return 1; }
}

# The marker escaping into a host's $HOME makes every command act on a
# workspace that is not there, and it does it silently.
chk_no_host_marker() {
    in_workspace && { echo "this machine is workspace '$(wk_self)'"; return 77; }
    [ ! -e "$HOME/.wk-workspace" ] || { echo "$HOME/.wk-workspace exists on a host"; return 1; }
}

# A clean merge can leave two definitions of the same function in one file,
# with the wrong one live and nothing to show for it.
chk_no_duplicate_functions() {
    local f dups="" d
    while read -r f; do
        [ -n "$f" ] || continue
        d=$(grep -oE '^[a-zA-Z_][a-zA-Z0-9_]*\(\)' "$f" 2>/dev/null | sort | uniq -d | tr '\n' ' ') || true
        [ -n "$d" ] && dups="$dups
  $(basename "$f"): $d"
    done <<EOF
$(shell_files)
EOF
    [ -z "$dups" ] || { echo "defined twice in one file:$dups"; return 1; }
}

# A driver is a sourced file that sets globals. One that evaluates something at
# source time which is only true later breaks every command that merely loads
# it -- `wk start` and `wk stop` load all of them.
chk_drivers_source() {
    local t out rc
    for t in container vm remote; do
        rc=0
        out=$(bash -c '
            set -euo pipefail
            WK_ROOT="$1"
            . "$WK_ROOT/lib/common.sh"; . "$WK_ROOT/lib/resources.sh"
            . "$WK_ROOT/lib/store.sh";  . "$WK_ROOT/lib/target.sh"
            load_target "$2"' _ "$WK_ROOT" "$t" 2>&1) || rc=$?
        [ "$rc" -eq 0 ] || { echo "targets/$t.sh: exit $rc: $out"; return 1; }
    done

    # local.sh only means anything with a marker, and refuses without one --
    # which is itself the behaviour to keep.
    rc=0
    out=$(WK_MARKER="$(fake_marker)" XDG_STATE_HOME="$TMP/state" bash -c '
        set -euo pipefail
        WK_ROOT="$1"
        . "$WK_ROOT/lib/common.sh"; . "$WK_ROOT/lib/resources.sh"
        . "$WK_ROOT/lib/store.sh";  . "$WK_ROOT/lib/target.sh"
        load_target local' _ "$WK_ROOT" 2>&1) || rc=$?
    [ "$rc" -eq 0 ] || { echo "targets/local.sh with a marker: exit $rc: $out"; return 1; }
}

# A driver overrides the hooks it needs, and a function definition outlives the
# load -- so loading a second target in one process used to leave the first
# driver's overrides live. `wk status` walks every target in one process, which
# is exactly where it bit: the container driver's t_branch answered for remote
# workspaces and reported "-" for all of them.
chk_driver_overrides_do_not_leak() {
    local out rc=0
    out=$(bash -c '
        set -euo pipefail
        WK_ROOT="$1"
        . "$WK_ROOT/lib/common.sh"; . "$WK_ROOT/lib/resources.sh"
        . "$WK_ROOT/lib/store.sh";  . "$WK_ROOT/lib/target.sh"
        # The container driver overrides t_branch; the remote driver does not,
        # so after loading both the default must be back.
        load_target container
        first=$(type t_branch)
        load_target remote
        second=$(type t_branch)
        [ "$first" != "$second" ] || { echo "t_branch is the same after loading two drivers"; exit 1; }
    ' _ "$WK_ROOT" 2>&1) || rc=$?
    [ "$rc" -eq 0 ] || { echo "$out"; return 1; }
}

# Two argument forms for one command, and each has to lose to the other in the
# right place: `wk build <config>` in a workspace, `wk build <ws> <config>` on
# a host. Silently picking the wrong one builds the wrong thing.
chk_build_arg_forms() {
    local out rc

    rc=0; out=$(as_workspace build jsc-release --dry-run 2>&1) || rc=$?
    [ "$rc" -eq 0 ] || { echo "in-workspace 'wk build <config>' failed: $out"; return 1; }
    grep -q 'workspace: selftest-ws' <<<"$out" \
        || { echo "in-workspace form did not resolve this workspace:"; echo "$out"; return 1; }

    # The host form typed inside: read literally it would build this workspace
    # and report the config as unknown, explaining neither half.
    rc=0; out=$(as_workspace build otherws jsc-release --dry-run 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || { echo "'wk build <ws> <config>' was accepted inside a workspace"; return 1; }
    grep -q 'no name' <<<"$out" \
        || { echo "the refusal does not name the in-workspace form: $out"; return 1; }

    # And the workspace form typed outside: one bare argument is a workspace
    # name there, so it must ask for the config rather than guess.
    #
    # WK_IN_VM=1 pins this to the argument parsing, which is what is under
    # test. Without it a macOS host cannot know whether an unregistered name is
    # a container workspace without asking the podman VM -- so it starts one,
    # and a selftest that boots a two-minute VM to check an error message is a
    # selftest nobody runs.
    if ! in_workspace; then
        rc=0; out=$(WK_IN_VM=1 "$WK" build jsc-release 2>&1) || rc=$?
        [ "$rc" -eq 2 ] || { echo "host 'wk build <config>' exited $rc, expected 2: $out"; return 1; }
        grep -q 'usage: wk build <workspace> <config>' <<<"$out" \
            || { echo "the usage line does not show the host form: $out"; return 1; }
    fi
}

# The check's own gate was unset in a workspace, so it reported "sandbox
# intact" after measuring two things and skipping the boundary entirely.
chk_verify_refuses_inside() {
    local out rc=0
    out=$(as_workspace verify selftest-ws 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || { echo "wk verify succeeded inside a workspace"; return 1; }
    grep -q 'only means anything on the host' <<<"$out" \
        || { echo "refused, but not for the stated reason: $out"; return 1; }
}

# Host commands act on a store, a seat or a hypervisor. Inside a workspace they
# either no-op against an empty store and report success, or do real work in
# the wrong place -- `wk sync` would fetch a 13 GB mirror into a directory that
# is discarded with the workspace.
chk_host_only_refused_inside() {
    local c out rc
    for c in sync gc vm pi session quiesce; do
        rc=0; out=$(as_workspace "$c" 2>&1) || rc=$?
        [ "$rc" -ne 0 ] || { echo "'wk $c' was accepted inside a workspace"; return 1; }
        grep -q "acts on a host" <<<"$out" \
            || { echo "'wk $c' refused for some other reason: $out"; return 1; }
    done
}

# An agent reaching for a command it has not run before should be able to ask
# what it does rather than read it. That only holds while every command has a
# header comment to print -- a new one with none would explain itself as an
# empty answer, which is worse than no feature at all.
chk_explain_every_command() {
    local c n out bad=""
    for c in "$WK_ROOT"/cmd/*; do
        [ -f "$c" ] && [ -x "$c" ] || continue
        n=$(basename "$c")
        out=$("$WK" "$n" --explain 2>&1) || { bad="$bad $n(exit)"; continue; }
        grep -q '^  changes things: ' <<<"$out" || bad="$bad $n(no-role)"
        grep -q '^what it does' <<<"$out" || bad="$bad $n(no-header)"
        # Three lines of prose is not much to ask of a file's own header.
        [ "$(printf '%s\n' "$out" | sed -n '/^what it does/,$p' | wc -l)" -ge 4 ] \
            || bad="$bad $n(empty-header)"
    done
    [ -z "$bad" ] || { echo "'wk <cmd> --explain' is not usable for:$bad"; return 1; }
}

# A status command that prompts for a password is a status command nothing can
# script -- and `wk doctor` calls this one. The property is "it answers without
# a terminal", which is exactly what running it with no stdin proves.
chk_sudo_status_never_prompts() {
    local out rc=0
    out=$("$WK" sudo status </dev/null 2>&1) || rc=$?
    case "$rc" in 0|1) ;; *) echo "exit $rc: $out"; return 1 ;; esac
    grep -qi 'password' <<<"$out" || { echo "said nothing about passwords: $out"; return 1; }
}

chk_unknown_command() {
    local out rc=0
    out=$("$WK" nosuchcommand 2>&1) || rc=$?
    [ "$rc" -eq 2 ] || { echo "exited $rc, expected 2"; return 1; }
    grep -q 'unknown command' <<<"$out" || { echo "no 'unknown command': $out"; return 1; }
}

# A typo'd target must not be mistaken for a machine, and the error is where
# the conf format is documented.
chk_unknown_target() {
    local out rc=0
    out=$(WK_TARGET=nosuchtarget-selftest "$WK" ls 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || { echo "an unknown target was accepted"; return 1; }
    grep -q 'targets/nosuchtarget-selftest.conf' <<<"$out" \
        || { echo "the error does not name the conf to write: $out"; return 1; }
}

# The whole design is that daily work needs no password. quiesce and session
# are the deliberate exceptions and have their own privileged helper.
#
# `sudo -n` does not count, and the distinction is the point rather than a
# loophole: it never prompts, so a command that uses it stays usable by an
# agent and unattended. cmd/gc trims the filesystem that way and says so when
# it cannot -- which is the behaviour to keep, not to flag.
chk_no_sudo_daily() {
    local c hits found=""
    for c in build run test logs status ls new rm enter claude gui bench sync gc; do
        [ -f "$WK_ROOT/cmd/$c" ] || continue
        # In command position only. `sudo` inside a quoted string is advice --
        # cmd/gc prints "run 'sudo fstrim -av' yourself" when it cannot, which
        # is the opposite of the thing being looked for.
        hits=$(grep -nE '(^|;|&&|\|\||\bthen\b|\belse\b|\bdo\b)[[:space:]]*sudo[[:space:]]' \
                   "$WK_ROOT/cmd/$c" \
               | grep -v 'sudo -n' | grep -v '^[0-9]*:[[:space:]]*#' || true)
        [ -n "$hits" ] && found="$found
  cmd/$c: $(printf '%s' "$hits" | head -2 | tr '\n' ';')"
    done
    [ -z "$found" ] || { echo "sudo that can prompt:$found"; return 1; }
}

# --- locks -------------------------------------------------------------------
#
# The lock is the one piece of shared machinery every mutating command depends
# on, and every one of its failures is a race that only shows up under a kill
# or under load -- which is to say, never in the run where you would look for
# it. Each property below cost a real defect to learn (lib/common.sh, "locks").
#
# In a scratch lock directory, so a selftest cannot wedge a real command by
# leaving one behind, and so this runs the same on a machine in the middle of a
# build.
_lock_sh() {
    WK_LOCK_DIR="$TMP/locks" bash -c '
        set -uo pipefail
        . "$1/lib/common.sh"
        set +e
        shift
        eval "$@"' _ "$WK_ROOT" "$@"
}

# The property: a lock dies with its holder, however the holder dies -- and a
# lock with no holder recorded in it is not a lock, it is rubble.
chk_lock_dies_with_holder() {
    local out
    out=$(_lock_sh '
        # killed -9 with the lock held
        bash -c ". $WK_ROOT/lib/common.sh; hold_lock k; sleep 30" &
        p=$!; sleep 1; kill -9 $p 2>/dev/null; wait $p 2>/dev/null
        s=$(date +%s); ( hold_lock k -w 20 >/dev/null 2>&1 )
        [ $(( $(date +%s) - s )) -lt 3 ] || echo "killed holder: waited"

        # the window the mkdir form had: a lock naming nobody
        mkdir -p "$(_lock_path h)"
        s=$(date +%s); ( hold_lock h -w 20 >/dev/null 2>&1 )
        [ $(( $(date +%s) - s )) -lt 3 ] || echo "holder-less lock: waited it out"

        # and a live holder is still respected
        bash -c ". $WK_ROOT/lib/common.sh; hold_lock l; sleep 5" &
        q=$!; sleep 1
        ( hold_lock l -w 2 >/dev/null 2>&1 ) && echo "live holder: walked in"
        kill $q 2>/dev/null; wait $q 2>/dev/null
    ') || true
    [ -z "$out" ] || { echo "$out"; return 1; }
}

# The property: takers of one lock serialise, even when they start together and
# even when the lock they find is a dead one they all try to break at once.
# Twelve of them, each doing a read-modify-write no lock would survive.
chk_lock_serialises_under_contention() {
    local out
    out=$(_lock_sh '
        c="$WK_LOCK_DIR/n"; mkdir -p "$WK_LOCK_DIR"; echo 0 > "$c"
        ln -s "pid=99999998 tok=dead at=x cmd=x" "$(_lock_path r)"
        for i in $(seq 1 12); do
            ( hold_lock r -w 60 >/dev/null 2>&1
              n=$(cat "$c"); sleep 0.2; echo $((n + 1)) > "$c" ) &
        done
        wait
        [ "$(cat "$c")" = 12 ] || echo "twelve takers, $(cat "$c") critical sections"
        [ -L "$(_lock_path r)" ] && echo "the lock was left behind"
        true
    ') || true
    [ -z "$out" ] || { echo "$out"; return 1; }
}

# The property: a command may register its own end-of-run work without
# disabling anybody else's. There was one trap and several claimants, and bash
# keeps the last one set -- so `cmd/new`'s failure record silently replaced the
# lock release for the whole of a creation.
chk_exit_handlers_compose() {
    local out
    out=$(_lock_sh '
        r=$(bash -c ". $WK_ROOT/lib/common.sh
                     mine() { echo mine; }
                     hold_lock e; wk_atexit mine" 2>/dev/null)
        [ "$r" = mine ] || echo "the command own handler did not run"
        [ -L "$(_lock_path e)" ] && echo "the lock was not released"
        bash -c ". $WK_ROOT/lib/common.sh; hold_lock x; exit 7" >/dev/null 2>&1
        [ $? = 7 ] || echo "the exit status did not survive the handlers"
        true
    ') || true
    [ -z "$out" ] || { echo "$out"; return 1; }
    # And structurally: nothing outside lib/common.sh may take the EXIT trap,
    # because taking it is what disables everything else registered under it.
    #
    # In a process that has the registry, which is the whole point of the rule.
    # A file that never sources lib/common.sh has no wk_atexit to register with
    # -- image/pmos-build.sh is copied to a build host and run by its /bin/sh,
    # with none of this repo beside it -- and there `trap` is the only mechanism
    # there is, with nothing else under the trap to disable. So the scan asks
    # both questions rather than one: does this file take the trap, and could it
    # have done anything else.
    local claimants f
    claimants=""
    while read -r f; do
        [ -n "$f" ] || continue
        grep -q 'lib/common\.sh' "${f%%:*}" 2>/dev/null || continue
        claimants="$claimants
$f"
    done <<EOF
$(grep -rn "^[^#]*trap .*EXIT" "$WK_ROOT/cmd" "$WK_ROOT/lib" "$WK_ROOT/targets" \
      "$WK_ROOT/boot" "$WK_ROOT/image" 2>/dev/null | grep -v "lib/common.sh" || true)
EOF
    claimants=$(printf '%s' "$claimants" | sed '/^$/d')
    [ -z "$claimants" ] || { echo "these take the EXIT trap instead of registering a handler:
$claimants"; return 1; }
}

# One lock mechanism, everywhere. flock is the one that keeps coming back: it
# is the obvious answer, it is inherited by every child, and macOS does not
# ship it -- so a machine with no flock silently locked nothing.
chk_one_lock_mechanism() {
    local hits
    # This file is excluded, and has to be: a checker that forbids a word
    # cannot avoid containing it, and matching itself is the one hit that means
    # the check is working.
    hits=$(grep -rn '\bflock\b' "$WK_ROOT/cmd" "$WK_ROOT/lib" "$WK_ROOT/targets" \
               "$WK_ROOT/boot" "$WK_ROOT/image" "$WK_ROOT/wk" 2>/dev/null \
           | grep -v "^$0:" | grep -v '/selftest:' \
           | grep -v '^[^:]*:[0-9]*: *#' | grep -v '# ' || true)
    [ -z "$hits" ] || { echo "flock is still called here:
$hits"; return 1; }
}

# --- the commands that resolve a build without one ---------------------------
#
# `wk profile` and `wk bench stage` both compose an environment and a command
# line out of a config, a port and a target, and both are wrong in ways that
# only show up as a profile of the wrong thing: a JSC option spelled into the
# wrong position is ignored in silence, and a loader variable spelled for the
# wrong platform produces a binary that will not start. Their dry runs are
# where that is checkable without a build.
chk_profile_resolves() {
    local out bad=""

    # The jsc shell, Apple port: options before the script (jsc treats
    # everything after the file as the script's arguments, so a `--sample`
    # appended at the end turns the profiler off and passes the word on), and
    # DYLD_FRAMEWORK_PATH rather than LD_LIBRARY_PATH.
    out=$(as_workspace profile --config mac-release --dry-run bench.js 2>&1) || { echo "exit: $out"; return 1; }
    grep -q 'DYLD_FRAMEWORK_PATH' <<<"$out" || bad="$bad no-dyld"
    grep -qE '/jsc.* --sample.* .?bench\.js' <<<"$out" || bad="$bad flags-after-script"

    # A CMake port from the same workspace: the other loader variable, and
    # samply rather than xctrace under --mode native.
    out=$(as_workspace profile --config wpe-release --mode native --dry-run bench.js 2>&1) \
        || { echo "exit: $out"; return 1; }
    grep -q 'LD_LIBRARY_PATH' <<<"$out" || bad="$bad no-ld-library-path"
    grep -q 'samply record' <<<"$out" || bad="$bad native-is-not-samply"

    # And the Apple port picks Instruments for the same word.
    out=$(as_workspace profile --config mac-release --mode native --dry-run bench.js 2>&1) \
        || { echo "exit: $out"; return 1; }
    grep -q 'xctrace record' <<<"$out" || bad="$bad native-is-not-xctrace"

    # Every mode either resolves or refuses with a reason; none may traceback.
    local m
    for m in sampling bytecode samply instruments heaptrack massif; do
        out=$(as_workspace profile --mode "$m" --dry-run bench.js 2>&1) || {
            grep -q '^error:' <<<"$out" || bad="$bad $m(no-reason)"
        }
    done

    [ -z "$bad" ] || { echo "wk profile resolved wrongly:$bad"; return 1; }
}

# The fleet's third arming model. A machine whose transition is a person's act
# must never be reported as one that will move by itself, and must never leave
# an arming record for a role it could not even check was there.
chk_hands_on_arming() {
    is_macos || { echo "the hands-on machine is this Mac"; return 77; }
    local out rc=0
    out=$(WK_BENCH_VOLUME="wk-selftest-no-such-volume" "$WK" boot mbp --status 2>&1) || rc=$?
    [ "$rc" -eq 0 ] || { echo "wk boot mbp --status exited $rc: $out"; return 1; }
    grep -q 'not attached' <<<"$out" \
        || { echo "status did not notice the missing volume: $out"; return 1; }

    rc=0
    out=$(XDG_STATE_HOME="$TMP/state" WK_BENCH_VOLUME="wk-selftest-no-such-volume" \
          "$WK" boot mbp 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || { echo "arming succeeded with no volume attached"; return 1; }
    [ -e "$TMP/state/wk/boot-armed" ] \
        && { echo "a refused arming still wrote a record"; return 1; }
    return 0
}

# A benchmark that ran in host mode and a benchmark that ran on the
# benchmark install produce the same shape of result and are not comparable.
# Nothing tells them apart afterwards except the refusal, so the refusal is
# absolute: not a barrier, not forceable.
chk_bench_role_required() {
    is_macos || { echo "bare-metal bench mode is this Mac"; return 77; }
    local out rc=0

    # With a staged tree in reach it must still refuse -- and refuse the same
    # way with --force, which everywhere else in this tree opens a barrier.
    out=$(WK_BENCH_ROOT="$TMP/bench" "$WK" bench staged --plan jetstream2.2 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || { echo "a run was accepted with no benchmark volume at all"; return 1; }

    mkdir -p "$TMP/bench/staged/20260101T000000Z-mac-release/Tools/Scripts"
    mkdir -p "$TMP/bench/staged/20260101T000000Z-mac-release/WebKitBuild/Release/MiniBrowser.app/Contents/MacOS"
    : > "$TMP/bench/staged/20260101T000000Z-mac-release/stage.json"
    printf '{"config":"mac-release","plan":"jetstream2.2"}' \
        > "$TMP/bench/staged/20260101T000000Z-mac-release/stage.json"

    rc=0
    out=$(WK_BENCH_ROOT="$TMP/bench" "$WK" bench staged --plan jetstream2.2 --force 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || { echo "--force ran a benchmark in host mode"; return 1; }
    grep -q 'host mode' <<<"$out" \
        || { echo "refused for some other reason: $out"; return 1; }

    # A dry run still describes it: that is a question, not a measurement.
    rc=0
    out=$(WK_BENCH_ROOT="$TMP/bench" "$WK" bench staged --plan jetstream2.2 --dry-run 2>&1) || rc=$?
    [ "$rc" -eq 0 ] || { echo "--dry-run refused as well: $out"; return 1; }
    grep -q -- '--plan jetstream2.2 --browser minibrowser --platform osx' <<<"$out" \
        || { echo "the dry run does not show the command it would run: $out"; return 1; }
}

# A manifest that does not parse is worse than no manifest: every field a
# reader asks for comes back empty, and the reader cannot tell "this run has no
# workspace recorded" from "this file is not JSON". Found 2026-08-20 with
# `"payload_pinned": true/private/tmp/...` -- a `${x:+true}${x:-false}` where
# the second half expanded to the value instead of the default.
chk_stage_manifest_is_json() {
    local out
    out=$(as_workspace bench stage selftest-ws --to benchvm --dry-run 2>&1) || true
    # The dry run does not write one, so the shape is checked by generating the
    # same document the writer does, with a payload set -- the case that broke.
    printf '{\n  "payload_pinned": %s,\n  "plan": "%s"\n}\n' \
        "$([ -n "/tmp/x" ] && echo true || echo false)" "jetstream2.2" > "$TMP/stage.json"
    python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$TMP/stage.json" 2>/dev/null \
        || { echo "the generated manifest is not JSON"; return 1; }
    # And the writer itself, as it stands in the file: no shell expansion may
    # emit a bare value where a JSON literal belongs.
    grep -nE '"[a-z_]+": \$\{[a-z_]+:\+' "$WK_ROOT/cmd/bench" \
        && { echo "a JSON value is built from \${x:+...}\${x:-...}, which emits the value on the else branch"; return 1; }
    return 0
}

# A boot driver runs under `set -euo pipefail` and every one of its probes
# talks to a machine that may be off -- which is a normal state, not a failure.
# The guest driver got this wrong and `wk boot benchvm --status` printed
# nothing at all and exited 1, which is the least debuggable output there is.
chk_boot_status_survives_an_absent_machine() {
    local m out rc
    for m in $("$WK" boot --list 2>/dev/null | awk '{print $1}'); do
        rc=0; out=$("$WK" boot "$m" --status 2>&1) || rc=$?
        # 0 = in a mode, 2 = armed, 3 = unreachable. A machine another OS
        # drives is refused by the registry's os= field -- loudly, which is
        # this check's whole property -- so that refusal passes too.
        case "$rc" in
            0|2|3) ;;
            *) case "$out" in
                   *"driven from a"*"host only"*) ;;
                   *) echo "'wk boot $m --status' exited $rc: $out"; return 1 ;;
               esac ;;
        esac
        [ -n "$out" ] || { echo "'wk boot $m --status' printed nothing (exit $rc)"; return 1; }
    done
}

# --- state: the rules in docs/HANDOFF-workspace-state.md ---------------------

_machine_state() {
    podman machine inspect "${WK_MACHINE:-wk}" --format '{{.State}}' 2>/dev/null || echo none
}

# Every read-only command, run for real, with the machine stopped. Running it
# is the only honest check: the guard that was supposed to prevent this already
# existed in the dispatcher when a `wk status` was observed starting the
# machine anyway.
_readonly_commands() {
    "$WK" status >/dev/null 2>&1 || true
    "$WK" ls     >/dev/null 2>&1 || true
    "$WK" logs   selftest-nonexistent >/dev/null 2>&1 || true
    "$WK" doctor >/dev/null 2>&1 || true
}

chk_readonly_starts_nothing() {
    local before after
    have podman || { echo "no podman on this machine"; return 77; }
    before=$(_machine_state)
    [ "$before" = running ] && {
        echo "the podman machine is running; 'wk stop' first to check this"; return 77; }

    _readonly_commands

    after=$(_machine_state)
    [ "$after" = "$before" ] || { echo "podman machine went $before -> $after"; return 1; }
}

# The other half of the same rule: no guest booted, nothing written, nothing
# repaired. Guests are counted through tart directly rather than through `wk vm
# ls`, so the check does not depend on the thing it is checking; the write side
# is the host's own state directory, which is where every file a host-side
# command would write lives.
# Name, mtime and size of everything under the host's state directory. `stat`
# is spelled differently on the two platforms and the wrong spelling does not
# fail on either -- GNU stat -f reports the *filesystem*, which is identical
# before and after by construction, so the check would pass without measuring
# anything.
_state_fingerprint() {
    local d; d=$(wk_state_dir)
    [ -d "$d" ] || { echo "(absent)"; return 0; }
    if is_macos; then
        find "$d" -exec stat -f '%N %m %z' {} \; 2>/dev/null | sort
    else
        find "$d" -exec stat -c '%n %Y %s' {} \; 2>/dev/null | sort
    fi
}

chk_readonly_writes_nothing() {
    local guests_before guests_after before after d
    have podman || { echo "no podman on this machine"; return 77; }
    [ "$(_machine_state)" = running ] && {
        echo "the podman machine is running; 'wk stop' first to check this"; return 77; }

    guests_before=""; guests_after=""
    if have tart; then guests_before=$(tart list --format json 2>/dev/null || true); fi

    d=$(wk_state_dir)
    before=$(_state_fingerprint)

    _readonly_commands

    after=$(_state_fingerprint)
    if [ "$before" != "$after" ]; then
        # A control, before blaming the commands: this directory holds the
        # build logs and status files of every target, and a build running on
        # a remote machine writes into it once a second. Measured 2026-08-19,
        # where exactly that produced a failure the commands had no part in.
        local ctl_a ctl_b
        ctl_a=$(_state_fingerprint); sleep 3; ctl_b=$(_state_fingerprint)
        [ "$ctl_a" = "$ctl_b" ] || {
            echo "$d is being written by something else (a build, most likely);"
            echo "this check cannot tell that apart from a read-only command writing"
            return 77; }
        echo "$d changed:"
        printf '%s\n' "$before" > "$TMP/before"; printf '%s\n' "$after" > "$TMP/after"
        diff "$TMP/before" "$TMP/after" | head -10
        return 1
    fi

    if have tart; then guests_after=$(tart list --format json 2>/dev/null || true); fi
    [ "$guests_before" = "$guests_after" ] || { echo "the tart guest list changed"; return 1; }
}

# `wk ls` and `wk status` both claim to list "the workspaces". A name in one
# and not the other means one of them is enumerating from somewhere else --
# which is what a macOS host did for as long as `wk ls` was forwarded whole
# into the podman VM.
#
# Asked of `--json` rather than of the table: the document is what every view is
# drawn from, so this checks the thing that would be wrong rather than one
# rendering of it -- and it no longer breaks every time a column moves.
#
# A machine running an older copy of this repository cannot answer in records,
# so its workspaces arrive as one `raw` block of its own text; those names are
# taken from that text the same way `wk ls`'s are, or a stale build box would
# read as a disagreement between the two commands.
chk_ls_status_same_names() {
    local a b
    a=$("$WK" ls 2>/dev/null | tail -n +2 | awk 'NF {print $1}' | sort -u)
    b=$("$WK" status --json 2>/dev/null | python3 -c '
import json, re, sys
doc = json.load(sys.stdin)
names = []
for m in doc["machines"]:
    for g in m["methods"]:
        names += [w["name"] for w in g["workspaces"]]
    for r in m.get("raw", []):
        names += [ln.split()[0] for ln in r.get("text", "").splitlines()
                  if ln[:1] not in ("", " ")]
print("\n".join(sorted(set(names))))' | sort -u)
    [ "$a" = "$b" ] || {
        echo "wk ls lists: $(printf '%s' "$a" | tr '\n' ' ')"
        echo "wk status  : $(printf '%s' "$b" | tr '\n' ' ')"
        return 1; }
}

# One entry per machine in a `wk status` listing, and every entry a machine.
#
# Two processes assemble that listing on a macOS host -- this machine's own
# targets out here, its containers inside the podman VM -- and a third answers
# for each build box. They cannot agree between themselves about what to call
# this machine (`hostname` in the podman VM is `localhost`), so the records they
# write carry the name and the merge is by that name. Both halves of getting it
# wrong are checked here, because both have happened: the same machine appearing
# twice under two spellings, and a *target* name (`container`, `vm`) arriving
# where a machine name belongs -- which grew a machine called "container" with
# nothing on it, holding the podman VM's own facts.
chk_status_one_machine_each() {
    # Captured rather than piped: this command's exit status is meaningful (4 is
    # "a workspace needs a person", and there is usually one), and `pipefail`
    # would make that the check's own verdict.
    local doc; doc=$("$WK" status --json 2>/dev/null) || true
    printf '%s' "$doc" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
names = [m["name"] for m in doc["machines"]]
bad = []
dup = {n for n in names if names.count(n) > 1}
if dup:
    bad.append("named more than once: " + ", ".join(sorted(dup)))
kinds = {"container", "vm", "local", "remote", "localhost"}
wrong = kinds.intersection(names)
if wrong:
    bad.append("a target kind where a machine belongs: " + ", ".join(sorted(wrong)))
if not names:
    bad.append("no machines at all")
if bad:
    print("; ".join(bad))
    raise SystemExit(1)
'
}

# `wk zed` refuses inside a workspace, and says where to run it.
#
# A workspace has no Zed and never will -- a container has no display, and a
# macOS guest is driven from the host -- so the honest answer is the refusal
# and the command to type outside. Without it the failure is "zed is not
# installed", which is the same words the *host* prints when Zed really is
# missing, about a machine where it cannot be installed.
#
# Hermetic: the marker is what makes a machine a workspace (wk_marker,
# lib/target.sh), and WK_MARKER moves it.
chk_zed_refuses_inside_a_workspace() {
    local out rc=0
    printf 'name=selftest-ws\nsrc=/src/WebKit\n' > "$TMP/ws-marker"
    out=$(WK_MARKER="$TMP/ws-marker" "$WK" zed something 2>&1) || rc=$?
    [ "$rc" != 0 ] || { echo "opened an editor from inside a workspace"; return 1; }
    case "$out" in
        *"wk zed selftest-ws"*) return 0 ;;
        *) echo "$out"; return 1 ;;
    esac
}

# The five words ws_state can answer, each from the evidence that decides it.
#
# Hermetic, and a unit test rather than an end-to-end one on purpose: producing
# a real `broken` or `unreachable` workspace means removing a container by hand
# or taking a machine off the network, which is exactly the kind of thing the
# interruption matrix in the plan is hand-run for. What can be checked every
# run is that the combination logic is right -- a stub driver, five inputs, five
# answers -- because that logic is what every command now gates on.
chk_ws_state_words() {
    local out
    out=$(
        WK_STORE="$TMP/store"; export WK_STORE
        mkdir -p "$TMP/store/ws"
        # shellcheck disable=SC1090
        . "$WK_ROOT/lib/target.sh"
        wk_ws_dir() { echo "$WK_STORE/ws/$1"; }
        t_needs_base() { return 1; }

        _env=absent; _marker=""
        t_info()    { echo "$_env"; }
        t_created() { [ -n "$_marker" ]; }

        # nothing anywhere
        echo "1:$(ws_state nothing)"
        # the environment is up and creation finished
        mkdir -p "$WK_STORE/ws/done"; _env=running; _marker=1
        echo "2:$(ws_state done)"
        # the driver says so itself: still being made
        _env=creating
        echo "3:$(ws_state done)"
        # the machine did not answer
        _env=unreachable
        echo "4:$(ws_state done)"
        # a workspace directory with no environment behind it, and no marker:
        # rubble from an interrupted creation
        _env=absent; _marker=""
        echo "5:$(ws_state done)"
        # the same, but creation had finished: something outside wk removed it
        _marker=1
        echo "6:$(ws_state done)"
    ) || { echo "ws_state failed: $out"; return 1; }

    local want="1:absent
2:present
3:creating
4:unreachable
5:creating
6:broken"
    [ "$out" = "$want" ] || { echo "got:"; echo "$out"; echo "want:"; echo "$want"; return 1; }
}

# A status file is a claim: it is read tolerantly, and the process table is what
# decides whether what it claims is still happening.
chk_status_files_are_claims() {
    local f="$TMP/ws.status" got
    # shellcheck disable=SC1090
    . "$WK_ROOT/lib/detach.sh"

    status_write "$f" state=creating "pid=$$" stage=create
    [ "$(status_field "$f" state)" = creating ] || { echo "state did not round-trip"; return 1; }
    detach_alive "$f" || { echo "a live pid was read as dead"; return 1; }

    # An unknown key is ignored rather than fatal, and a key that is not there
    # is empty rather than an error -- that is what makes a file written by an
    # older wk-tools readable.
    status_write "$f" state=creating "pid=$$" "future_key=whatever"
    [ -z "$(status_field "$f" stage)" ] || { echo "a missing key was not empty"; return 1; }

    # A pid that cannot be running any more. 2^22 is above every default
    # pid_max on both platforms, so this is a dead pid by construction rather
    # than by luck.
    status_write "$f" state=creating pid=4194304 stage=create
    ! detach_alive "$f" || { echo "a dead pid was read as alive"; return 1; }

    # Garbage: still readable for what is there, never a crash.
    printf 'not a status file at all' > "$f"
    got=$(status_field "$f" state) || { echo "a garbage file failed the reader"; return 1; }
    [ -z "$got" ] || { echo "a garbage file produced a state: $got"; return 1; }
}

# One marker, one name. Every driver that creates a workspace has to write the
# same file, and the day one of them spells it differently is the day a
# workspace on that target reads as half-made forever.
chk_ready_marker_one_name() {
    local f missing=""
    for f in targets/container.sh targets/vm.sh targets/remote.sh; do
        grep -q 'WK_READY_MARKER' "$WK_ROOT/$f" || missing="$missing $f"
    done
    # The container's is written from inside, by provisioning, which is the last
    # act of creating one.
    grep -q '\.wk-ready' "$WK_ROOT/container/firstrun.sh" \
        || missing="$missing container/firstrun.sh"
    [ -z "$missing" ] || { echo "no ready marker in:$missing"; return 1; }

    # And nothing may hardcode the name where the variable is in scope -- one
    # place defines it, everything else spells it $WK_READY_MARKER.
    local hits
    hits=$(grep -n '\.wk-ready' "$WK_ROOT"/targets/*.sh "$WK_ROOT"/lib/*.sh 2>/dev/null \
           | grep -v 'WK_READY_MARKER=' | grep -vE '^[^:]*:[0-9]+:[[:space:]]*#' || true)
    [ -z "$hits" ] || { echo "hardcoded marker name:"; echo "$hits"; return 1; }
}

# The switch only works while the key a workspace uses is the one in the store.
# A copy inside a workspace is a push credential `wk push off` cannot take
# back, which is how it was before 2026-08-19 -- and the regression would be
# silent, because pushing keeps working, which is the failure.
chk_push_keys_not_copied() {
    local out
    have podman || { echo "no podman on this machine"; return 77; }
    [ "$(_machine_state)" = running ] || {
        echo "the podman machine is stopped; the keys live in its store"; return 77; }
    out=$("$WK" push status 2>&1) || true
    grep -q 'hold their own copy' <<<"$out" && {
        echo "$out"; return 1; }
    return 0
}

# --- remote: needs a configured machine, and reaches it ----------------------

chk_remote_confs_resolve() {
    local d f n bad="" any=""
    d=$(target_conf_dir)
    [ -d "$d" ] || { echo "no machines configured in $d"; return 77; }
    for f in "$d"/*.conf; do
        [ -f "$f" ] || continue
        any=1
        n=$(basename "$f" .conf)
        target_kind "$n" >/dev/null 2>&1 || bad="$bad $n"
    done
    [ -n "$any" ] || { echo "no machines configured in $d"; return 77; }
    [ -z "$bad" ] || { echo "configured but unresolvable:$bad"; return 1; }
}

chk_remote_reachable() {
    local d f n any="" bad=""
    d=$(target_conf_dir)
    [ -d "$d" ] || { echo "no machines configured"; return 77; }
    for f in "$d"/*.conf; do
        [ -f "$f" ] || continue
        n=$(basename "$f" .conf)
        [ "$(target_kind "$n" 2>/dev/null)" = remote ] || continue
        any=1
        ( load_target "$n"; t_info selftest-nonexistent >/dev/null 2>&1 ) \
            || bad="$bad $n"
    done
    [ -n "$any" ] || { echo "no remote machines configured"; return 77; }
    [ -z "$bad" ] || { echo "configured but unreachable:$bad"; return 1; }
}

