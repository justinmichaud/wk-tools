#!/usr/bin/env bash
#
# wk selftest [--quick] [-v] [<pattern>] -- run the test suite in tests/
# wk: where=local name=none group=hosts needs python3
#
# Real tests, stdlib unittest, one per behaviour. Tests that need the podman
# VM, a configured machine or a board skip by name when it is absent; a test
# that creates a workspace removes it in teardown.
#
#   --quick       only the modules that need no VM, machine or board
#   -v            one line per test
#   <pattern>     only tests whose name matches (unittest -k)

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"

QUICK="" VERBOSE="" PATTERN=()
while [ $# -gt 0 ]; do
    case "$1" in
        --quick) QUICK=1; shift ;;
        -v)      VERBOSE=-v; shift ;;
        -*)      die "usage: wk selftest [--quick] [-v] [<pattern>]; see wk selftest -h" ;;
        *)       PATTERN+=(-k "$1"); shift ;;
    esac
done

cd "$WK_ROOT"
if [ -n "$QUICK" ]; then
    exec python3 -m unittest discover -s tests -p 'test_[dq]*.py' $VERBOSE ${PATTERN[@]+"${PATTERN[@]}"}
fi
exec python3 -m unittest discover -s tests $VERBOSE ${PATTERN[@]+"${PATTERN[@]}"}
