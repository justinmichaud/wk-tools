#!/usr/bin/env bash
#
# wk selftest -- run docs/TESTING.md instead of reading it.
#
# The plan is a hand-ticked checklist, which means "run the test plan after a
# re-install" was not actually possible: every [V] in it is only as fresh as
# the last human pass. This executes the automatable part of it.
#
# Two rules, both from the plan's own preamble:
#
#   Test the property, not the configuration. Every check below runs a command
#   and looks at what happened, never at the file that was supposed to make it
#   happen.
#
#   A silent pass is not a pass. A check whose prerequisite is missing reports
#   SKIP with the reason, never nothing; and a check whose plan line has been
#   reworded reports DRIFT rather than quietly testing something the plan no
#   longer claims.
#
# That last one is what keeps this file and the plan together. Each check names
# a phrase from the docs/TESTING.md line it implements, and the phrase is
# looked up in the file at run time -- so deleting or rewriting a line without
# touching the runner is a failure, not a silent divergence.
#
# Not `wk doctor`. Doctor answers "what is provisioned here" by inspecting
# state and is safe to run anywhere at any time; this answers "does it
# behave" by running commands, and may take minutes. Doctor is run first, for
# context, and its verdict is reported rather than acted on: each section
# probes its own prerequisites, which is more honest than parsing a checklist.
#
#   0  every check passed (skips are not failures)
#   1  something failed, or the runner and the plan have drifted apart

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

PLAN="$WK_ROOT/docs/TESTING.md"
WK="$WK_ROOT/wk"

SECTION=""
LIST=""

# Every section this runner knows. One list, because a name that is not in it
# has to be a refusal: `wk selftest --section <typo>` used to run nothing at
# all and exit 0 -- the silent pass the plan's own preamble forbids, and the
# worst possible one, since it is reported as "everything passed".
SECTIONS="quick state remote netboot"

usage() {
    cat >&2 <<EOF
usage: wk selftest [--quick] [--section <name>] [--list]

  --quick            only checks that need no workspace, no podman and no ssh
  --section <name>   $(printf '%s' "$SECTIONS" | tr ' ' '|')        (more as they are encoded)
  --list             print the checks and the plan lines they implement

Exit 0 when everything checkable passed; 1 on any failure or plan drift.
EOF
    exit 2
}

while [ $# -gt 0 ]; do
    case "$1" in
        --quick)   SECTION=quick; shift ;;
        --section) SECTION="${2:-}"; shift 2 ;;
        --list)    LIST=1; shift ;;
        -h|--help) usage ;;
        *) die "unknown option: $1" ;;
    esac
done

# Before anything runs, so the refusal is immediate and names what there is.
if [ -n "$SECTION" ]; then
    case " $SECTIONS " in
        *" $SECTION "*) ;;
        *) die "no such section '$SECTION' -- there are: $SECTIONS" ;;
    esac
fi

TMP=$(mktemp -d)
_tmp_cleanup() { rm -rf "$TMP"; }
wk_atexit _tmp_cleanup

passes=0; fails=0; skips=0; drifts=0
pass()  { printf '  \033[32mok\033[0m    %s\n' "$*" >&2; passes=$((passes + 1)); }
fail()  { printf '  \033[31mFAIL\033[0m  %s\n' "$*" >&2; fails=$((fails + 1)); }
skip()  { printf '  \033[33mSKIP\033[0m  %s\n' "$*" >&2; skips=$((skips + 1)); }
drift() { printf '  \033[35mDRIFT\033[0m %s\n' "$*" >&2; drifts=$((drifts + 1)); }
detail() { printf '%s\n' "$*" | sed 's/^/        /' >&2; }
section() { printf '\n%s\n' "$*" >&2; }

want() { [ -z "$SECTION" ] || [ "$SECTION" = "$1" ]; }

# check <plan-anchor> <function>
#
# The anchor is a distinctive phrase from the docs/TESTING.md line this check
# implements, matched as a fixed string. A check that runs is a line of the
# plan actually exercised; a check whose anchor is gone is DRIFT.
#
# The function reports by exit status: 0 passed, 77 the prerequisite is absent
# (its output is the reason), anything else failed (its output is the evidence).
# 77 rather than a second function, because a prerequisite is usually only
# discoverable by starting to do the thing.
check() {
    local anchor="$1" fn="$2" out rc=0

    if [ -n "$LIST" ]; then
        printf '  %-8s %s\n' "$fn" "$anchor" >&2
        return 0
    fi

    if ! grep -qF -- "$anchor" "$PLAN"; then
        drift "$anchor"
        detail "no line in docs/TESTING.md contains this phrase any more."
        detail "Either restore the line or update the check ($fn)."
        return 0
    fi

    out=$("$fn" 2>&1) || rc=$?
    case "$rc" in
        0)  pass "$anchor" ;;
        77) skip "$anchor"; [ -n "$out" ] && detail "$out" ;;
        *)  fail "$anchor"; [ -n "$out" ] && detail "$out" ;;
    esac
    return 0
}

# --- shared helpers ----------------------------------------------------------

# Every shell file in the tree, by shebang rather than by extension -- `wk`,
# `setup` and everything under cmd/ have no suffix, and cmd/mcp is python and
# must not be handed to bash.
shell_files() {
    local f
    find "$WK_ROOT" -type f -not -path '*/.git/*' -not -path '*/__pycache__/*' 2>/dev/null \
    | while read -r f; do
        case "$(head -1 "$f" 2>/dev/null)" in
            '#!'*bash*|'#!'*/sh|'#!'*/sh\ *) echo "$f" ;;
        esac
    done
}

# A workspace that is not one: a marker naming a checkout that exists, so the
# in-workspace code paths can be exercised on a host without creating anything.
# $XDG_STATE_HOME goes with it, because targets/local.sh makes its store at
# source time and a test must not leave a directory in the real one.
fake_marker() {
    local d="$TMP/ws"
    mkdir -p "$d/WebKit" "$TMP/state"
    printf '%s\n' \
        '# written by wk selftest' \
        'name=selftest-ws' \
        "src=$d/WebKit" \
        'config=jsc-release' > "$d/marker"
    echo "$d/marker"
}

# Run `wk` as if this machine were a workspace.
as_workspace() {
    WK_MARKER="$(fake_marker)" XDG_STATE_HOME="$TMP/state" "$WK" "$@"
}

# --- quick: no workspace, no podman, no ssh ----------------------------------

# Every file, under both shells. macOS ships bash 3.2 and the host installs
# nothing extra, so a bash 5 idiom in anything the host runs is a syntax error
# on the machine it matters on.
chk_parse() {
    local f bad=""
    while read -r f; do
        [ -n "$f" ] || continue
        /bin/bash -n "$f" 2>/dev/null || bad="$bad
  bash 3.2: $f"
        bash -n "$f" 2>/dev/null || bad="$bad
  bash 5:   $f"
    done <<EOF
$(shell_files)
EOF
    [ -z "$bad" ] || { echo "does not parse:$bad"; return 1; }
}

# An orphan command is invisible: it works and nobody knows it is there.
chk_help_commands() {
    local help c n missing=""
    help=$("$WK" help 2>&1 || true)
    for c in "$WK_ROOT"/cmd/*; do
        [ -f "$c" ] && [ -x "$c" ] || continue
        n=$(basename "$c")
        printf '%s\n' "$help" | grep -qE "^  $n( |\$)" || missing="$missing $n"
    done
    [ -z "$missing" ] || { echo "not listed by 'wk help':$missing"; return 1; }
}

chk_build_list() {
    local out
    out=$("$WK" build --list 2>&1) || { echo "exit $?: $out"; return 1; }
    printf '%s\n' "$out" | grep -q 'jsc-release' || { echo "no jsc-release in the table"; return 1; }
    printf '%s\n' "$out" | grep -q 'mac-release' || { echo "no mac-release in the table"; return 1; }
}

# The table is a static lookup; it used to boot a two-minute VM to print it,
# and on a host without podman it failed naming a problem it did not have.
chk_build_list_starts_nothing() {
    local before after
    have podman || { echo "no podman on this machine"; return 77; }
    before=$(podman machine inspect "${WK_MACHINE:-wk}" --format '{{.State}}' 2>/dev/null || echo none)
    [ "$before" = running ] && { echo "the podman machine is already running"; return 77; }
    "$WK" build --list >/dev/null 2>&1 || { echo "wk build --list failed"; return 1; }
    after=$(podman machine inspect "${WK_MACHINE:-wk}" --format '{{.State}}' 2>/dev/null || echo none)
    [ "$after" = "$before" ] || { echo "podman machine went $before -> $after"; return 1; }
}

# The marker escaping into a host's $HOME makes every command act on a
# workspace that is not there, and it does it silently.
chk_no_host_marker() {
    in_workspace && { echo "this machine is workspace '$(wk_self)'"; return 77; }
    [ ! -e "$HOME/.wk-workspace" ] || { echo "$HOME/.wk-workspace exists on a host"; return 1; }
}

# A clean merge can leave two definitions of the same function in one file,
# with the wrong one live and nothing to show for it.
chk_no_duplicate_functions() {
    local f dups="" d
    while read -r f; do
        [ -n "$f" ] || continue
        d=$(grep -oE '^[a-zA-Z_][a-zA-Z0-9_]*\(\)' "$f" 2>/dev/null | sort | uniq -d | tr '\n' ' ') || true
        [ -n "$d" ] && dups="$dups
  $(basename "$f"): $d"
    done <<EOF
$(shell_files)
EOF
    [ -z "$dups" ] || { echo "defined twice in one file:$dups"; return 1; }
}

# A driver is a sourced file that sets globals. One that evaluates something at
# source time which is only true later breaks every command that merely loads
# it -- `wk start` and `wk stop` load all of them.
chk_drivers_source() {
    local t out rc
    for t in container vm remote; do
        rc=0
        out=$(bash -c '
            set -euo pipefail
            WK_ROOT="$1"
            . "$WK_ROOT/lib/common.sh"; . "$WK_ROOT/lib/resources.sh"
            . "$WK_ROOT/lib/store.sh";  . "$WK_ROOT/lib/target.sh"
            load_target "$2"' _ "$WK_ROOT" "$t" 2>&1) || rc=$?
        [ "$rc" -eq 0 ] || { echo "targets/$t.sh: exit $rc: $out"; return 1; }
    done

    # local.sh only means anything with a marker, and refuses without one --
    # which is itself the behaviour to keep.
    rc=0
    out=$(WK_MARKER="$(fake_marker)" XDG_STATE_HOME="$TMP/state" bash -c '
        set -euo pipefail
        WK_ROOT="$1"
        . "$WK_ROOT/lib/common.sh"; . "$WK_ROOT/lib/resources.sh"
        . "$WK_ROOT/lib/store.sh";  . "$WK_ROOT/lib/target.sh"
        load_target local' _ "$WK_ROOT" 2>&1) || rc=$?
    [ "$rc" -eq 0 ] || { echo "targets/local.sh with a marker: exit $rc: $out"; return 1; }
}

# A driver overrides the hooks it needs, and a function definition outlives the
# load -- so loading a second target in one process used to leave the first
# driver's overrides live. `wk status` walks every target in one process, which
# is exactly where it bit: the container driver's t_branch answered for remote
# workspaces and reported "-" for all of them.
chk_driver_overrides_do_not_leak() {
    local out rc=0
    out=$(bash -c '
        set -euo pipefail
        WK_ROOT="$1"
        . "$WK_ROOT/lib/common.sh"; . "$WK_ROOT/lib/resources.sh"
        . "$WK_ROOT/lib/store.sh";  . "$WK_ROOT/lib/target.sh"
        # The container driver overrides t_branch; the remote driver does not,
        # so after loading both the default must be back.
        load_target container
        first=$(type t_branch)
        load_target remote
        second=$(type t_branch)
        [ "$first" != "$second" ] || { echo "t_branch is the same after loading two drivers"; exit 1; }
    ' _ "$WK_ROOT" 2>&1) || rc=$?
    [ "$rc" -eq 0 ] || { echo "$out"; return 1; }
}

# Two argument forms for one command, and each has to lose to the other in the
# right place: `wk build <config>` in a workspace, `wk build <ws> <config>` on
# a host. Silently picking the wrong one builds the wrong thing.
chk_build_arg_forms() {
    local out rc

    rc=0; out=$(as_workspace build jsc-release --dry-run 2>&1) || rc=$?
    [ "$rc" -eq 0 ] || { echo "in-workspace 'wk build <config>' failed: $out"; return 1; }
    printf '%s\n' "$out" | grep -q 'workspace: selftest-ws' \
        || { echo "in-workspace form did not resolve this workspace:"; echo "$out"; return 1; }

    # The host form typed inside: read literally it would build this workspace
    # and report the config as unknown, explaining neither half.
    rc=0; out=$(as_workspace build otherws jsc-release --dry-run 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || { echo "'wk build <ws> <config>' was accepted inside a workspace"; return 1; }
    printf '%s\n' "$out" | grep -q 'no name' \
        || { echo "the refusal does not name the in-workspace form: $out"; return 1; }

    # And the workspace form typed outside: one bare argument is a workspace
    # name there, so it must ask for the config rather than guess.
    #
    # WK_IN_VM=1 pins this to the argument parsing, which is what is under
    # test. Without it a macOS host cannot know whether an unregistered name is
    # a container workspace without asking the podman VM -- so it starts one,
    # and a selftest that boots a two-minute VM to check an error message is a
    # selftest nobody runs.
    if ! in_workspace; then
        rc=0; out=$(WK_IN_VM=1 "$WK" build jsc-release 2>&1) || rc=$?
        [ "$rc" -eq 2 ] || { echo "host 'wk build <config>' exited $rc, expected 2: $out"; return 1; }
        printf '%s\n' "$out" | grep -q 'usage: wk build <workspace> <config>' \
            || { echo "the usage line does not show the host form: $out"; return 1; }
    fi
}

# The check's own gate was unset in a workspace, so it reported "sandbox
# intact" after measuring two things and skipping the boundary entirely.
chk_verify_refuses_inside() {
    local out rc=0
    out=$(as_workspace verify selftest-ws 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || { echo "wk verify succeeded inside a workspace"; return 1; }
    printf '%s\n' "$out" | grep -q 'only means anything on the host' \
        || { echo "refused, but not for the stated reason: $out"; return 1; }
}

# Host commands act on a store, a seat or a hypervisor. Inside a workspace they
# either no-op against an empty store and report success, or do real work in
# the wrong place -- `wk sync` would fetch a 13 GB mirror into a directory that
# is discarded with the workspace.
chk_host_only_refused_inside() {
    local c out rc
    for c in sync gc vm pi session quiesce; do
        rc=0; out=$(as_workspace "$c" 2>&1) || rc=$?
        [ "$rc" -ne 0 ] || { echo "'wk $c' was accepted inside a workspace"; return 1; }
        printf '%s\n' "$out" | grep -q "acts on a host" \
            || { echo "'wk $c' refused for some other reason: $out"; return 1; }
    done
}

# An agent reaching for a command it has not run before should be able to ask
# what it does rather than read it. That only holds while every command has a
# header comment to print -- a new one with none would explain itself as an
# empty answer, which is worse than no feature at all.
chk_explain_every_command() {
    local c n out bad=""
    for c in "$WK_ROOT"/cmd/*; do
        [ -f "$c" ] && [ -x "$c" ] || continue
        n=$(basename "$c")
        out=$("$WK" "$n" --explain 2>&1) || { bad="$bad $n(exit)"; continue; }
        printf '%s\n' "$out" | grep -q '^  changes things: ' || bad="$bad $n(no-role)"
        printf '%s\n' "$out" | grep -q '^what it does' || bad="$bad $n(no-header)"
        # Three lines of prose is not much to ask of a file's own header.
        [ "$(printf '%s\n' "$out" | sed -n '/^what it does/,$p' | wc -l)" -ge 4 ] \
            || bad="$bad $n(empty-header)"
    done
    [ -z "$bad" ] || { echo "'wk <cmd> --explain' is not usable for:$bad"; return 1; }
}

# A status command that prompts for a password is a status command nothing can
# script -- and `wk doctor` calls this one. The property is "it answers without
# a terminal", which is exactly what running it with no stdin proves.
chk_sudo_status_never_prompts() {
    local out rc=0
    out=$("$WK" sudo status </dev/null 2>&1) || rc=$?
    case "$rc" in 0|1) ;; *) echo "exit $rc: $out"; return 1 ;; esac
    printf '%s\n' "$out" | grep -qi 'password' || { echo "said nothing about passwords: $out"; return 1; }
}

chk_unknown_command() {
    local out rc=0
    out=$("$WK" nosuchcommand 2>&1) || rc=$?
    [ "$rc" -eq 2 ] || { echo "exited $rc, expected 2"; return 1; }
    printf '%s\n' "$out" | grep -q 'unknown command' || { echo "no 'unknown command': $out"; return 1; }
}

# A typo'd target must not be mistaken for a machine, and the error is where
# the conf format is documented.
chk_unknown_target() {
    local out rc=0
    out=$(WK_TARGET=nosuchtarget-selftest "$WK" ls 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || { echo "an unknown target was accepted"; return 1; }
    printf '%s\n' "$out" | grep -q 'targets/nosuchtarget-selftest.conf' \
        || { echo "the error does not name the conf to write: $out"; return 1; }
}

# The whole design is that daily work needs no password. quiesce and session
# are the deliberate exceptions and have their own privileged helper.
#
# `sudo -n` does not count, and the distinction is the point rather than a
# loophole: it never prompts, so a command that uses it stays usable by an
# agent and unattended. cmd/gc trims the filesystem that way and says so when
# it cannot -- which is the behaviour to keep, not to flag.
chk_no_sudo_daily() {
    local c hits found=""
    for c in build run test logs status ls new rm enter claude gui bench sync gc; do
        [ -f "$WK_ROOT/cmd/$c" ] || continue
        # In command position only. `sudo` inside a quoted string is advice --
        # cmd/gc prints "run 'sudo fstrim -av' yourself" when it cannot, which
        # is the opposite of the thing being looked for.
        hits=$(grep -nE '(^|;|&&|\|\||\bthen\b|\belse\b|\bdo\b)[[:space:]]*sudo[[:space:]]' \
                   "$WK_ROOT/cmd/$c" \
               | grep -v 'sudo -n' | grep -v '^[0-9]*:[[:space:]]*#' || true)
        [ -n "$hits" ] && found="$found
  cmd/$c: $(printf '%s' "$hits" | head -2 | tr '\n' ';')"
    done
    [ -z "$found" ] || { echo "sudo that can prompt:$found"; return 1; }
}

# --- locks -------------------------------------------------------------------
#
# The lock is the one piece of shared machinery every mutating command depends
# on, and every one of its failures is a race that only shows up under a kill
# or under load -- which is to say, never in the run where you would look for
# it. Each property below cost a real defect to learn (lib/common.sh, "locks").
#
# In a scratch lock directory, so a selftest cannot wedge a real command by
# leaving one behind, and so this runs the same on a machine in the middle of a
# build.
_lock_sh() {
    WK_LOCK_DIR="$TMP/locks" bash -c '
        set -uo pipefail
        . "$1/lib/common.sh"
        set +e
        shift
        eval "$@"' _ "$WK_ROOT" "$@"
}

# The property: a lock dies with its holder, however the holder dies -- and a
# lock with no holder recorded in it is not a lock, it is rubble.
chk_lock_dies_with_holder() {
    local out
    out=$(_lock_sh '
        # killed -9 with the lock held
        bash -c ". $WK_ROOT/lib/common.sh; hold_lock k; sleep 30" &
        p=$!; sleep 1; kill -9 $p 2>/dev/null; wait $p 2>/dev/null
        s=$(date +%s); ( hold_lock k -w 20 >/dev/null 2>&1 )
        [ $(( $(date +%s) - s )) -lt 3 ] || echo "killed holder: waited"

        # the window the mkdir form had: a lock naming nobody
        mkdir -p "$(_lock_path h)"
        s=$(date +%s); ( hold_lock h -w 20 >/dev/null 2>&1 )
        [ $(( $(date +%s) - s )) -lt 3 ] || echo "holder-less lock: waited it out"

        # and a live holder is still respected
        bash -c ". $WK_ROOT/lib/common.sh; hold_lock l; sleep 5" &
        q=$!; sleep 1
        ( hold_lock l -w 2 >/dev/null 2>&1 ) && echo "live holder: walked in"
        kill $q 2>/dev/null; wait $q 2>/dev/null
    ') || true
    [ -z "$out" ] || { echo "$out"; return 1; }
}

# The property: takers of one lock serialise, even when they start together and
# even when the lock they find is a dead one they all try to break at once.
# Twelve of them, each doing a read-modify-write no lock would survive.
chk_lock_serialises_under_contention() {
    local out
    out=$(_lock_sh '
        c="$WK_LOCK_DIR/n"; mkdir -p "$WK_LOCK_DIR"; echo 0 > "$c"
        ln -s "pid=99999998 tok=dead at=x cmd=x" "$(_lock_path r)"
        for i in $(seq 1 12); do
            ( hold_lock r -w 60 >/dev/null 2>&1
              n=$(cat "$c"); sleep 0.2; echo $((n + 1)) > "$c" ) &
        done
        wait
        [ "$(cat "$c")" = 12 ] || echo "twelve takers, $(cat "$c") critical sections"
        [ -L "$(_lock_path r)" ] && echo "the lock was left behind"
        true
    ') || true
    [ -z "$out" ] || { echo "$out"; return 1; }
}

# The property: a command may register its own end-of-run work without
# disabling anybody else's. There was one trap and several claimants, and bash
# keeps the last one set -- so `cmd/new`'s failure record silently replaced the
# lock release for the whole of a creation.
chk_exit_handlers_compose() {
    local out
    out=$(_lock_sh '
        r=$(bash -c ". $WK_ROOT/lib/common.sh
                     mine() { echo mine; }
                     hold_lock e; wk_atexit mine" 2>/dev/null)
        [ "$r" = mine ] || echo "the command own handler did not run"
        [ -L "$(_lock_path e)" ] && echo "the lock was not released"
        bash -c ". $WK_ROOT/lib/common.sh; hold_lock x; exit 7" >/dev/null 2>&1
        [ $? = 7 ] || echo "the exit status did not survive the handlers"
        true
    ') || true
    [ -z "$out" ] || { echo "$out"; return 1; }
    # And structurally: nothing outside lib/common.sh may take the EXIT trap,
    # because taking it is what disables everything else registered under it.
    local claimants
    claimants=$(grep -rn "^[^#]*trap .*EXIT" "$WK_ROOT/cmd" "$WK_ROOT/lib" "$WK_ROOT/targets" \
                    "$WK_ROOT/boot" "$WK_ROOT/image" 2>/dev/null \
                | grep -v "lib/common.sh" || true)
    [ -z "$claimants" ] || { echo "these take the EXIT trap instead of registering a handler:
$claimants"; return 1; }
}

# One lock mechanism, everywhere. flock is the one that keeps coming back: it
# is the obvious answer, it is inherited by every child, and macOS does not
# ship it -- so a machine with no flock silently locked nothing.
chk_one_lock_mechanism() {
    local hits
    # This file is excluded, and has to be: a checker that forbids a word
    # cannot avoid containing it, and matching itself is the one hit that means
    # the check is working.
    hits=$(grep -rn '\bflock\b' "$WK_ROOT/cmd" "$WK_ROOT/lib" "$WK_ROOT/targets" \
               "$WK_ROOT/boot" "$WK_ROOT/image" "$WK_ROOT/wk" 2>/dev/null \
           | grep -v "^$0:" | grep -v '/selftest:' \
           | grep -v '^[^:]*:[0-9]*: *#' | grep -v '# ' || true)
    [ -z "$hits" ] || { echo "flock is still called here:
$hits"; return 1; }
}

# --- the commands that resolve a build without one ---------------------------
#
# `wk profile` and `wk bench stage` both compose an environment and a command
# line out of a config, a port and a target, and both are wrong in ways that
# only show up as a profile of the wrong thing: a JSC option spelled into the
# wrong position is ignored in silence, and a loader variable spelled for the
# wrong platform produces a binary that will not start. Their dry runs are
# where that is checkable without a build.
chk_profile_resolves() {
    local out bad=""

    # The jsc shell, Apple port: options before the script (jsc treats
    # everything after the file as the script's arguments, so a `--sample`
    # appended at the end turns the profiler off and passes the word on), and
    # DYLD_FRAMEWORK_PATH rather than LD_LIBRARY_PATH.
    out=$(as_workspace profile --config mac-release --dry-run bench.js 2>&1) || { echo "exit: $out"; return 1; }
    printf '%s\n' "$out" | grep -q 'DYLD_FRAMEWORK_PATH' || bad="$bad no-dyld"
    printf '%s\n' "$out" | grep -qE '/jsc.* --sample.* .?bench\.js' || bad="$bad flags-after-script"

    # A CMake port from the same workspace: the other loader variable, and
    # samply rather than xctrace under --mode native.
    out=$(as_workspace profile --config wpe-release --mode native --dry-run bench.js 2>&1) \
        || { echo "exit: $out"; return 1; }
    printf '%s\n' "$out" | grep -q 'LD_LIBRARY_PATH' || bad="$bad no-ld-library-path"
    printf '%s\n' "$out" | grep -q 'samply record' || bad="$bad native-is-not-samply"

    # And the Apple port picks Instruments for the same word.
    out=$(as_workspace profile --config mac-release --mode native --dry-run bench.js 2>&1) \
        || { echo "exit: $out"; return 1; }
    printf '%s\n' "$out" | grep -q 'xctrace record' || bad="$bad native-is-not-xctrace"

    # Every mode either resolves or refuses with a reason; none may traceback.
    local m
    for m in sampling bytecode samply instruments heaptrack massif; do
        out=$(as_workspace profile --mode "$m" --dry-run bench.js 2>&1) || {
            printf '%s\n' "$out" | grep -q '^error:' || bad="$bad $m(no-reason)"
        }
    done

    [ -z "$bad" ] || { echo "wk profile resolved wrongly:$bad"; return 1; }
}

# The fleet's third arming model. A machine whose transition is a person's act
# must never be reported as one that will move by itself, and must never leave
# an arming record for a role it could not even check was there.
chk_hands_on_arming() {
    is_macos || { echo "the hands-on machine is this Mac"; return 77; }
    local out rc=0
    out=$(WK_BENCH_VOLUME="wk-selftest-no-such-volume" "$WK" boot mbp --status 2>&1) || rc=$?
    [ "$rc" -eq 0 ] || { echo "wk boot mbp --status exited $rc: $out"; return 1; }
    printf '%s\n' "$out" | grep -q 'not attached' \
        || { echo "status did not notice the missing volume: $out"; return 1; }

    rc=0
    out=$(XDG_STATE_HOME="$TMP/state" WK_BENCH_VOLUME="wk-selftest-no-such-volume" \
          "$WK" boot mbp 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || { echo "arming succeeded with no volume attached"; return 1; }
    [ -e "$TMP/state/wk/boot-armed" ] \
        && { echo "a refused arming still wrote a record"; return 1; }
    return 0
}

# A benchmark that ran in host mode and a benchmark that ran on the
# benchmark install produce the same shape of result and are not comparable.
# Nothing tells them apart afterwards except the refusal, so the refusal is
# absolute: not a barrier, not forceable.
chk_bench_role_required() {
    is_macos || { echo "bare-metal bench mode is this Mac"; return 77; }
    local out rc=0

    # With a staged tree in reach it must still refuse -- and refuse the same
    # way with --force, which everywhere else in this tree opens a barrier.
    out=$(WK_BENCH_ROOT="$TMP/bench" "$WK" bench staged --plan jetstream2.2 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || { echo "a run was accepted with no benchmark volume at all"; return 1; }

    mkdir -p "$TMP/bench/staged/20260101T000000Z-mac-release/Tools/Scripts"
    mkdir -p "$TMP/bench/staged/20260101T000000Z-mac-release/WebKitBuild/Release/MiniBrowser.app/Contents/MacOS"
    : > "$TMP/bench/staged/20260101T000000Z-mac-release/stage.json"
    printf '{"config":"mac-release","plan":"jetstream2.2"}' \
        > "$TMP/bench/staged/20260101T000000Z-mac-release/stage.json"

    rc=0
    out=$(WK_BENCH_ROOT="$TMP/bench" "$WK" bench staged --plan jetstream2.2 --force 2>&1) || rc=$?
    [ "$rc" -ne 0 ] || { echo "--force ran a benchmark in host mode"; return 1; }
    printf '%s\n' "$out" | grep -q 'host mode' \
        || { echo "refused for some other reason: $out"; return 1; }

    # A dry run still describes it: that is a question, not a measurement.
    rc=0
    out=$(WK_BENCH_ROOT="$TMP/bench" "$WK" bench staged --plan jetstream2.2 --dry-run 2>&1) || rc=$?
    [ "$rc" -eq 0 ] || { echo "--dry-run refused as well: $out"; return 1; }
    printf '%s\n' "$out" | grep -q -- '--plan jetstream2.2 --browser minibrowser --platform osx' \
        || { echo "the dry run does not show the command it would run: $out"; return 1; }
}

# A manifest that does not parse is worse than no manifest: every field a
# reader asks for comes back empty, and the reader cannot tell "this run has no
# workspace recorded" from "this file is not JSON". Found 2026-08-20 with
# `"payload_pinned": true/private/tmp/...` -- a `${x:+true}${x:-false}` where
# the second half expanded to the value instead of the default.
chk_stage_manifest_is_json() {
    local out
    out=$(as_workspace bench stage selftest-ws --to benchvm --dry-run 2>&1) || true
    # The dry run does not write one, so the shape is checked by generating the
    # same document the writer does, with a payload set -- the case that broke.
    printf '{\n  "payload_pinned": %s,\n  "plan": "%s"\n}\n' \
        "$([ -n "/tmp/x" ] && echo true || echo false)" "jetstream2.2" > "$TMP/stage.json"
    python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$TMP/stage.json" 2>/dev/null \
        || { echo "the generated manifest is not JSON"; return 1; }
    # And the writer itself, as it stands in the file: no shell expansion may
    # emit a bare value where a JSON literal belongs.
    grep -nE '"[a-z_]+": \$\{[a-z_]+:\+' "$WK_ROOT/cmd/bench" \
        && { echo "a JSON value is built from \${x:+...}\${x:-...}, which emits the value on the else branch"; return 1; }
    return 0
}

# A boot driver runs under `set -euo pipefail` and every one of its probes
# talks to a machine that may be off -- which is a normal state, not a failure.
# The guest driver got this wrong and `wk boot benchvm --status` printed
# nothing at all and exited 1, which is the least debuggable output there is.
chk_boot_status_survives_an_absent_machine() {
    local m out rc
    for m in $("$WK" boot --list 2>/dev/null | awk '{print $1}'); do
        rc=0; out=$("$WK" boot "$m" --status 2>&1) || rc=$?
        # 0 = in a role, 2 = armed, 3 = unreachable. Anything else, or no
        # output at all, is the failure this check is about.
        case "$rc" in 0|2|3) ;; *) echo "'wk boot $m --status' exited $rc: $out"; return 1 ;; esac
        [ -n "$out" ] || { echo "'wk boot $m --status' printed nothing (exit $rc)"; return 1; }
    done
}

# --- state: the rules in docs/HANDOFF-workspace-state.md ---------------------

_machine_state() {
    podman machine inspect "${WK_MACHINE:-wk}" --format '{{.State}}' 2>/dev/null || echo none
}

# Every read-only command, run for real, with the machine stopped. Running it
# is the only honest check: the guard that was supposed to prevent this already
# existed in the dispatcher when a `wk status` was observed starting the
# machine anyway.
_readonly_commands() {
    "$WK" status >/dev/null 2>&1 || true
    "$WK" ls     >/dev/null 2>&1 || true
    "$WK" logs   selftest-nonexistent >/dev/null 2>&1 || true
    "$WK" doctor >/dev/null 2>&1 || true
}

chk_readonly_starts_nothing() {
    local before after
    have podman || { echo "no podman on this machine"; return 77; }
    before=$(_machine_state)
    [ "$before" = running ] && {
        echo "the podman machine is running; 'wk stop' first to check this"; return 77; }

    _readonly_commands

    after=$(_machine_state)
    [ "$after" = "$before" ] || { echo "podman machine went $before -> $after"; return 1; }
}

# The other half of the same rule: no guest booted, nothing written, nothing
# repaired. Guests are counted through tart directly rather than through `wk vm
# ls`, so the check does not depend on the thing it is checking; the write side
# is the host's own state directory, which is where every file a host-side
# command would write lives.
# Name, mtime and size of everything under the host's state directory. `stat`
# is spelled differently on the two platforms and the wrong spelling does not
# fail on either -- GNU stat -f reports the *filesystem*, which is identical
# before and after by construction, so the check would pass without measuring
# anything.
_state_fingerprint() {
    local d; d=$(wk_state_dir)
    [ -d "$d" ] || { echo "(absent)"; return 0; }
    if is_macos; then
        find "$d" -exec stat -f '%N %m %z' {} \; 2>/dev/null | sort
    else
        find "$d" -exec stat -c '%n %Y %s' {} \; 2>/dev/null | sort
    fi
}

chk_readonly_writes_nothing() {
    local guests_before guests_after before after d
    have podman || { echo "no podman on this machine"; return 77; }
    [ "$(_machine_state)" = running ] && {
        echo "the podman machine is running; 'wk stop' first to check this"; return 77; }

    guests_before=""; guests_after=""
    if have tart; then guests_before=$(tart list --format json 2>/dev/null || true); fi

    d=$(wk_state_dir)
    before=$(_state_fingerprint)

    _readonly_commands

    after=$(_state_fingerprint)
    if [ "$before" != "$after" ]; then
        # A control, before blaming the commands: this directory holds the
        # build logs and status files of every target, and a build running on
        # a remote machine writes into it once a second. Measured 2026-08-19,
        # where exactly that produced a failure the commands had no part in.
        local ctl_a ctl_b
        ctl_a=$(_state_fingerprint); sleep 3; ctl_b=$(_state_fingerprint)
        [ "$ctl_a" = "$ctl_b" ] || {
            echo "$d is being written by something else (a build, most likely);"
            echo "this check cannot tell that apart from a read-only command writing"
            return 77; }
        echo "$d changed:"
        printf '%s\n' "$before" > "$TMP/before"; printf '%s\n' "$after" > "$TMP/after"
        diff "$TMP/before" "$TMP/after" | head -10
        return 1
    fi

    if have tart; then guests_after=$(tart list --format json 2>/dev/null || true); fi
    [ "$guests_before" = "$guests_after" ] || { echo "the tart guest list changed"; return 1; }
}

# `wk ls` and `wk status` both claim to list "the workspaces". A name in one
# and not the other means one of them is enumerating from somewhere else --
# which is what a macOS host did for as long as `wk ls` was forwarded whole
# into the podman VM.
#
# stdout only: every warning, header and note goes to stderr, so the rows are
# the answer. In `wk status` a workspace's own line starts at column 1 and its
# build/test/babysit lines are indented, which is what separates them here.
chk_ls_status_same_names() {
    local a b
    a=$("$WK" ls 2>/dev/null | tail -n +2 | awk 'NF {print $1}' | sort -u)
    b=$("$WK" status 2>/dev/null | awk '/^[^ ]/ && NF {print $1}' | sort -u)
    [ "$a" = "$b" ] || {
        echo "wk ls lists: $(printf '%s' "$a" | tr '\n' ' ')"
        echo "wk status  : $(printf '%s' "$b" | tr '\n' ' ')"
        return 1; }
}

# The five words ws_state can answer, each from the evidence that decides it.
#
# Hermetic, and a unit test rather than an end-to-end one on purpose: producing
# a real `broken` or `unreachable` workspace means removing a container by hand
# or taking a machine off the network, which is exactly the kind of thing the
# interruption matrix in the plan is hand-run for. What can be checked every
# run is that the combination logic is right -- a stub driver, five inputs, five
# answers -- because that logic is what every command now gates on.
chk_ws_state_words() {
    local out
    out=$(
        WK_STORE="$TMP/store"; export WK_STORE
        mkdir -p "$TMP/store/ws"
        # shellcheck disable=SC1090
        . "$WK_ROOT/lib/target.sh"
        wk_ws_dir() { echo "$WK_STORE/ws/$1"; }
        t_needs_base() { return 1; }

        _env=absent; _marker=""
        t_info()    { echo "$_env"; }
        t_created() { [ -n "$_marker" ]; }

        # nothing anywhere
        echo "1:$(ws_state nothing)"
        # the environment is up and creation finished
        mkdir -p "$WK_STORE/ws/done"; _env=running; _marker=1
        echo "2:$(ws_state done)"
        # the driver says so itself: still being made
        _env=creating
        echo "3:$(ws_state done)"
        # the machine did not answer
        _env=unreachable
        echo "4:$(ws_state done)"
        # a workspace directory with no environment behind it, and no marker:
        # rubble from an interrupted creation
        _env=absent; _marker=""
        echo "5:$(ws_state done)"
        # the same, but creation had finished: something outside wk removed it
        _marker=1
        echo "6:$(ws_state done)"
    ) || { echo "ws_state failed: $out"; return 1; }

    local want="1:absent
2:present
3:creating
4:unreachable
5:creating
6:broken"
    [ "$out" = "$want" ] || { echo "got:"; echo "$out"; echo "want:"; echo "$want"; return 1; }
}

# A status file is a claim: it is read tolerantly, and the process table is what
# decides whether what it claims is still happening.
chk_status_files_are_claims() {
    local f="$TMP/ws.status" got
    # shellcheck disable=SC1090
    . "$WK_ROOT/lib/detach.sh"

    status_write "$f" state=creating "pid=$$" stage=create
    [ "$(status_field "$f" state)" = creating ] || { echo "state did not round-trip"; return 1; }
    detach_alive "$f" || { echo "a live pid was read as dead"; return 1; }

    # An unknown key is ignored rather than fatal, and a key that is not there
    # is empty rather than an error -- that is what makes a file written by an
    # older wk-tools readable.
    status_write "$f" state=creating "pid=$$" "future_key=whatever"
    [ -z "$(status_field "$f" stage)" ] || { echo "a missing key was not empty"; return 1; }

    # A pid that cannot be running any more. 2^22 is above every default
    # pid_max on both platforms, so this is a dead pid by construction rather
    # than by luck.
    status_write "$f" state=creating pid=4194304 stage=create
    ! detach_alive "$f" || { echo "a dead pid was read as alive"; return 1; }

    # Garbage: still readable for what is there, never a crash.
    printf 'not a status file at all' > "$f"
    got=$(status_field "$f" state) || { echo "a garbage file failed the reader"; return 1; }
    [ -z "$got" ] || { echo "a garbage file produced a state: $got"; return 1; }
}

# One marker, one name. Every driver that creates a workspace has to write the
# same file, and the day one of them spells it differently is the day a
# workspace on that target reads as half-made forever.
chk_ready_marker_one_name() {
    local f missing=""
    for f in targets/container.sh targets/vm.sh targets/remote.sh; do
        grep -q 'WK_READY_MARKER' "$WK_ROOT/$f" || missing="$missing $f"
    done
    # The container's is written from inside, by provisioning, which is the last
    # act of creating one.
    grep -q '\.wk-ready' "$WK_ROOT/container/firstrun.sh" \
        || missing="$missing container/firstrun.sh"
    [ -z "$missing" ] || { echo "no ready marker in:$missing"; return 1; }

    # And nothing may hardcode the name where the variable is in scope -- one
    # place defines it, everything else spells it $WK_READY_MARKER.
    local hits
    hits=$(grep -n '\.wk-ready' "$WK_ROOT"/targets/*.sh "$WK_ROOT"/lib/*.sh 2>/dev/null \
           | grep -v 'WK_READY_MARKER=' | grep -vE '^[^:]*:[0-9]+:[[:space:]]*#' || true)
    [ -z "$hits" ] || { echo "hardcoded marker name:"; echo "$hits"; return 1; }
}

# The switch only works while the key a workspace uses is the one in the store.
# A copy inside a workspace is a push credential `wk push off` cannot take
# back, which is how it was before 2026-08-19 -- and the regression would be
# silent, because pushing keeps working, which is the failure.
chk_push_keys_not_copied() {
    local out
    have podman || { echo "no podman on this machine"; return 77; }
    [ "$(_machine_state)" = running ] || {
        echo "the podman machine is stopped; the keys live in its store"; return 77; }
    out=$("$WK" push status 2>&1) || true
    printf '%s\n' "$out" | grep -q 'hold their own copy' && {
        echo "$out"; return 1; }
    return 0
}

# --- remote: needs a configured machine, and reaches it ----------------------

chk_remote_confs_resolve() {
    local d f n bad="" any=""
    d=$(target_conf_dir)
    [ -d "$d" ] || { echo "no machines configured in $d"; return 77; }
    for f in "$d"/*.conf; do
        [ -f "$f" ] || continue
        any=1
        n=$(basename "$f" .conf)
        target_kind "$n" >/dev/null 2>&1 || bad="$bad $n"
    done
    [ -n "$any" ] || { echo "no machines configured in $d"; return 77; }
    [ -z "$bad" ] || { echo "configured but unresolvable:$bad"; return 1; }
}

chk_remote_reachable() {
    local d f n any="" bad=""
    d=$(target_conf_dir)
    [ -d "$d" ] || { echo "no machines configured"; return 77; }
    for f in "$d"/*.conf; do
        [ -f "$f" ] || continue
        n=$(basename "$f" .conf)
        [ "$(target_kind "$n" 2>/dev/null)" = remote ] || continue
        any=1
        ( load_target "$n"; t_info selftest-nonexistent >/dev/null 2>&1 ) \
            || bad="$bad $n"
    done
    [ -n "$any" ] || { echo "no remote machines configured"; return 77; }
    [ -z "$bad" ] || { echo "configured but unreachable:$bad"; return 1; }
}

# --- run ---------------------------------------------------------------------

[ -f "$PLAN" ] || die "no test plan at $PLAN"

if [ -z "$LIST" ]; then
    info "wk selftest on $(wk_os) ($(hostname))${SECTION:+ -- section $SECTION}"

    # Context, not a gate. Its exit status says whether this machine is fully
    # provisioned; the sections below decide for themselves what they can run.
    if [ -z "$SECTION" ] || [ "$SECTION" != quick ]; then
        if "$WK" doctor >/dev/null 2>&1; then
            log "  wk doctor: everything it can check is provisioned"
        else
            log "  wk doctor: something is missing -- expect skips ('wk doctor' for the list)"
        fi
    fi
fi

# --- netboot: the resolver a board's firmware talks to ------------------------
#
# These are here rather than in a scratch script because this resolver halted
# the fleet's rpi4 twice in one afternoon, and both times the mistake was
# invisible from outside: the files were in the served tree, the tree looked
# right, and the server answered NOT FOUND. A resolver whose failures cost a
# trip to the device is one that should be exercised on every edit.
#
# All of it is offline, so it belongs in --quick.

# One fixture, the layout of a flash-kernel image's boot partition -- which is
# the layout that broke. `README` at the root *and* `overlays/README` under the
# prefix is not incidental: it is the pair that proves the fallback does not
# answer with the wrong file.
_nb_fixture() {
    local d; d=$(mktemp -d "$TMP/netboot.XXXXXX")
    mkdir -p "$d/current/overlays"
    printf 'root\n'   > "$d/README"
    printf 'nested\n' > "$d/current/overlays/README"
    : > "$d/start4.elf"; : > "$d/fixup4.dat"
    : > "$d/current/vmlinuz"; : > "$d/current/initrd.img"
    : > "$d/current/cmdline.txt"; : > "$d/current/bcm2711-rpi-4-b.dtb"
    {
        echo '[all]'
        echo 'os_prefix=current/'
        echo '[tryboot]'
        echo 'os_prefix=new/'
        echo '[all]'
        echo 'arm_64bit=1'
        echo 'kernel=vmlinuz'
        echo 'cmdline=cmdline.txt'
        echo 'initramfs initrd.img followkernel'
    } > "$d/config.txt"
    echo "$d"
}

# Ask the real resolver what one request maps to, through the same entry point
# cmd/serve uses to certify a tree.
_nb_resolve() {
    python3 "$WK_ROOT/boot/check-boot-files.py" \
        --root "$1" --tftpd "$WK_ROOT/boot/wk-tftpd.py" --resolve "$2"
}

chk_tftp_fallback_keeps_path() {
    local d got; d=$(_nb_fixture)
    got=$(_nb_resolve "$d" "7da7aee3/current/vmlinuz")
    [ "$got" = "current/vmlinuz" ] || {
        echo "7da7aee3/current/vmlinuz resolved to '${got:-NOTHING}', wanted current/vmlinuz"
        echo "that is the halt: an os_prefix= image's kernel unreachable over TFTP"
        return 1
    }
}

chk_tftp_fallback_never_substitutes() {
    local d got; d=$(_nb_fixture)
    got=$(_nb_resolve "$d" "7da7aee3/current/overlays/README")
    [ "$got" = "current/overlays/README" ] || {
        echo "resolved to '${got:-NOTHING}', wanted current/overlays/README"
        echo "answering with the root's own README is the wrong bytes under the right name"
        return 1
    }
}

chk_tftp_fallback_yields_to_real_dir() {
    local d got; d=$(_nb_fixture)
    mkdir -p "$d/7da7aee3"; printf 'serial\n' > "$d/7da7aee3/start4.elf"
    got=$(_nb_resolve "$d" "7da7aee3/start4.elf")
    [ "$got" = "7da7aee3/start4.elf" ] || {
        echo "resolved to '${got:-NOTHING}'; a populated serial directory must win"
        return 1
    }
}

chk_tftp_traversal_refused() {
    local d n; d=$(_nb_fixture)
    for n in "../../etc/passwd" "deadbeef/../../etc/passwd"; do
        [ -z "$(_nb_resolve "$d" "$n")" ] || { echo "$n resolved to something"; return 1; }
    done
}

chk_boot_files_check_catches_missing_kernel() {
    local d out; d=$(_nb_fixture)
    rm -f "$d/current/vmlinuz"
    out=$(python3 "$WK_ROOT/boot/check-boot-files.py" --root "$d" \
              --tftpd "$WK_ROOT/boot/wk-tftpd.py" --dtb bcm2711-rpi-4-b.dtb 2>&1) && {
        echo "a tree with no kernel was reported serveable"; return 1; }
    case "$out" in
        *current/vmlinuz*) ;;
        *) echo "did not name the missing kernel: $out"; return 1 ;;
    esac
}

chk_self_disarm_sh_is_single_quote_free() {
    # Every driver that offers b_self_disarm_sh has its output dropped straight
    # into ExecStart=/bin/sh -c '<here>'. A single quote in it does not error --
    # it silently reshapes the command, which on this mechanism means the image
    # never disarms and the board needs a hand on its power supply.
    local d out found=0
    for d in "$WK_ROOT"/boot/*.sh; do
        grep -q '^b_self_disarm_sh()' "$d" || continue
        found=1
        # shellcheck disable=SC1090
        out=$( MACH_DEVICE=/dev/sda MACH_NAME=selftest; . "$d"; b_self_disarm_sh )
        case "$out" in
            *\'*) echo "$(basename "$d") emits a single quote: $out"; return 1 ;;
        esac
        [ -n "$out" ] || { echo "$(basename "$d") emits nothing"; return 1; }
    done
    [ "$found" = 1 ] || return 77
}

chk_piusb_type_byte_roundtrips() {
    # The rpi4's whole arming is this one byte, and getting the offset or the
    # dd flags wrong is not a recoverable mistake on a boot medium -- without
    # conv=notrunc, dd truncates the device to one byte.
    local d img before after back
    d=$(mktemp -d "$TMP/piusb.XXXXXX"); img="$d/mbr.img"
    # A 2 MB file with the one byte this is about set to 0x0c, written the same
    # way the thing under test writes it.
    #
    # The fixture used to be built by feeding a keystroke script to `fdisk`,
    # which is Linux fdisk's interface and not macOS fdisk's -- so on this Mac
    # the fixture came out as partition type 00 and the check failed for a
    # reason that had nothing to do with the code. The selftest has to run on
    # both workstations, the same rule as `wk boot --status` (lib/common.sh,
    # epoch_to_utc). Nothing here needs a real partition table: the property is
    # that one byte at offset 450 round-trips and the write does not truncate.
    dd if=/dev/zero of="$img" bs=1024 count=2048 status=none 2>/dev/null \
        || { echo "could not make the fixture"; return 77; }
    # The byte round-trip needs none of this, but the sfdisk assertion at the
    # bottom reads a *table*, and a table is more than the type byte: without
    # the 0x55AA signature at 510 and a partition entry with a start and a
    # size, sfdisk sees no MBR at all -- which is how rebuilding this fixture
    # on the Mac (where the sfdisk branch is skipped) broke the check on
    # Linux without anyone seeing it. Entry 1 at 446: status 0, CHS zeroed
    # (sfdisk reads the LBA fields), start sector 2048, 2048 sectors long.
    printf '\000\000\000\000\000\000\000\000\000\010\000\000\000\010\000\000' \
        | dd of="$img" bs=1 seek=446 count=16 conv=notrunc status=none
    printf '\125\252' \
        | dd of="$img" bs=1 seek=510 count=2 conv=notrunc status=none
    printf '\'"$(printf '%03o' 0x0c)" \
        | dd of="$img" bs=1 seek=450 count=1 conv=notrunc status=none

    # shellcheck disable=SC1090
    ( MACH_DEVICE=/dev/null; . "$WK_ROOT/boot/pi-usb.sh"
      [ "$PIUSB_TYPE_OFFSET" = 450 ] || { echo "offset is $PIUSB_TYPE_OFFSET, not 450"; exit 1; } ) || return 1

    before=$(dd if="$img" bs=1 skip=450 count=1 status=none | od -An -tx1 | tr -d ' ')
    [ "$before" = 0c ] || { echo "fixture is type $before, wanted 0c"; return 1; }

    printf '\'"$(printf '%03o' 0x83)" \
        | dd of="$img" bs=1 seek=450 count=1 conv=notrunc status=none
    after=$(dd if="$img" bs=1 skip=450 count=1 status=none | od -An -tx1 | tr -d ' ')
    [ "$after" = 83 ] || { echo "disarm wrote $after, wanted 83"; return 1; }
    # `wc -c`, not `stat -c %s`: BSD stat spells it `-f %z` and answers the GNU
    # form with a usage block, which is the same portability trap as the
    # fixture above.
    [ "$(wc -c < "$img" | tr -d ' ')" = 2097152 ] || { echo "the write truncated the device"; return 1; }

    printf '\'"$(printf '%03o' 0x0c)" \
        | dd of="$img" bs=1 seek=450 count=1 conv=notrunc status=none
    back=$(dd if="$img" bs=1 skip=450 count=1 status=none | od -An -tx1 | tr -d ' ')
    [ "$back" = 0c ] || { echo "arm wrote $back, wanted 0c"; return 1; }
    # The last assertion is the interesting one and the least portable: that a
    # *partition tool* agrees the byte means FAT32, rather than only that the
    # byte is 0x0c. sfdisk is util-linux and this Mac has none, so it is asked
    # for only where it exists -- the byte-level round trip above is the part
    # that has to hold everywhere, and it does.
    if have sfdisk; then
        sfdisk -l "$img" 2>/dev/null | grep -q 'FAT32' \
            || { echo "sfdisk no longer reads the round-tripped table as FAT32"; return 1; }
    fi
}

chk_image_seed_prose_is_inert() {
    # `user_data` in cmd/sysimage is an unquoted heredoc, because it interpolates
    # the profile's values. That makes every line of it shell input, including
    # the lines that look like YAML comments -- so a backticked command name in
    # prose runs on the build host and leaves an empty gap in the emitted file.
    # Found by a build printing "Command line to execute required." three times.
    local body
    body=$(awk '/^user_data\(\) \{/ {inside=1} inside && /^EOF$/ {print; exit} inside {print}' \
               "$WK_ROOT/cmd/sysimage")
    [ -n "$body" ] || { echo "could not find user_data()'s heredoc in cmd/sysimage"; return 1; }
    if printf '%s\n' "$body" | grep -nP '(?<!\\)`' >/dev/null 2>&1; then
        echo "unescaped backticks in the cloud-init seed heredoc -- these run on the build host:"
        printf '%s\n' "$body" | grep -nP '(?<!\\)`' | sed 's/^/    /'
        return 1
    fi
}

chk_boot_files_accepts_autodetected_kernel() {
    # The regression this guards: deriving one expected kernel name from
    # `arm_64bit` refused the Dev@CI Yocto image, whose config.txt names
    # neither and whose kernel8.img boots the rpi4 every day. A check that
    # refuses a working image is worse than no check -- it stops the lane it
    # was built to protect.
    local d out; d=$(_nb_fixture)
    printf '[all]\ndtoverlay=vc4-kms-v3d\n' > "$d/config.txt"
    rm -rf "$d/current"
    : > "$d/kernel8.img"; : > "$d/cmdline.txt"; : > "$d/bcm2711-rpi-4-b.dtb"
    out=$(python3 "$WK_ROOT/boot/check-boot-files.py" --root "$d" \
              --tftpd "$WK_ROOT/boot/wk-tftpd.py" --dtb bcm2711-rpi-4-b.dtb \
              --serial "" 2>&1) \
        || { echo "an auto-detected kernel8.img image was refused: $out"; return 1; }
}

chk_boot_files_check_uses_the_running_server() {
    # The --tftpd argument exists so the check can interrogate the root-owned
    # copy that actually serves. If cmd/serve stopped passing it, the check
    # would go back to certifying a file that is not the one about to run --
    # which is exactly what it did on the day it was written.
    grep -q -- '--tftpd "\$server"' "$WK_ROOT/cmd/serve" \
        || { echo "cmd/serve no longer points the boot-file check at the server it starts"; return 1; }
    grep -q -- 'server="\$PRIV"' "$WK_ROOT/cmd/serve" \
        || { echo "cmd/serve no longer prefers the privileged helper when checking"; return 1; }
}

chk_serve_refuses_stale_helper() {
    local priv=/usr/local/libexec/wk-tftpd out
    [ -f "$priv" ] || { echo "no privileged helper installed"; return 77; }
    grep -q 'check_helper_current' "$WK_ROOT/cmd/serve" \
        || { echo "cmd/serve no longer compares the installed helper"; return 1; }
    # In sync, so the refusal cannot be provoked without breaking the install.
    # The guard being wired in is all that is checkable here.
    cmp -s "$WK_ROOT/boot/wk-tftpd.py" "$priv" && return 0
    out=$("$WK" serve --system wk-selftest-no-such-image 2>&1) || true
    case "$out" in
        *"not the server in this checkout"*) return 0 ;;
        *) echo "the helper is stale but wk serve did not say so:"; echo "$out"; return 1 ;;
    esac
}

