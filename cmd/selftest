# --- the boot-file check `wk sysimage write` runs before a disk is written ----
#
# These are here rather than in a scratch script because the failure this check
# guards against halted the fleet's rpi4 twice in one afternoon: the files were
# all present in the tree and unreachable through the names the firmware asks
# for.
#
# All of it is offline, so it belongs in --quick.

# One fixture, the layout of a flash-kernel image's boot partition -- which is
# the layout that broke.
_nb_fixture() {
    local d; d=$(mktemp -d "$TMP/bootfiles.XXXXXX")
    mkdir -p "$d/current/overlays"
    printf 'root\n'   > "$d/README"
    printf 'nested\n' > "$d/current/overlays/README"
    : > "$d/start4.elf"; : > "$d/fixup4.dat"
    : > "$d/current/vmlinuz"; : > "$d/current/initrd.img"
    : > "$d/current/cmdline.txt"; : > "$d/current/bcm2711-rpi-4-b.dtb"
    {
        echo '[all]'
        echo 'os_prefix=current/'
        echo '[tryboot]'
        echo 'os_prefix=new/'
        echo '[all]'
        echo 'arm_64bit=1'
        echo 'kernel=vmlinuz'
        echo 'cmdline=cmdline.txt'
        echo 'initramfs initrd.img followkernel'
    } > "$d/config.txt"
    echo "$d"
}

# Ask the resolver what one request maps to, through the same entry point
# image_check_boot_files uses to certify a tree.
_nb_resolve() {
    python3 "$WK_ROOT/boot/check-boot-files.py" --root "$1" --resolve "$2"
}

chk_machine_registry() {
    # The fleet is config, not code (CLAUDE.md): every machine is
    # a conf under boot/machines/ that loads cleanly and answers the questions
    # every consumer asks of it. A conf that half-loads would surface as a
    # driver error at arming time, on the machine it matters on.
    local f n bad=""
    # shellcheck disable=SC1090
    . "$WK_ROOT/lib/image.sh"
    # shellcheck disable=SC1090
    . "$WK_ROOT/image/profiles.sh"
    # shellcheck disable=SC1090
    . "$WK_ROOT/boot/machines.sh"
    for f in "$WK_ROOT"/boot/machines/*.conf; do
        [ -f "$f" ] || { echo "no machine confs at all"; return 1; }
        n=$(basename "$f" .conf)
        ( machine_load "$n" || exit 1
          [ -n "$MACH_DRIVER" ] || { echo "  $n: no MACH_DRIVER"; exit 1; }
          [ -f "$WK_ROOT/boot/$MACH_DRIVER.sh" ] || { echo "  $n: driver boot/$MACH_DRIVER.sh does not exist"; exit 1; }
          case "$MACH_ROLE" in workstation|bench-device) ;; *) echo "  $n: role '$MACH_ROLE' is not in the vocabulary"; exit 1 ;; esac
          case "$MACH_OS" in any|macos|linux) ;; *) echo "  $n: os '$MACH_OS' is not any|macos|linux"; exit 1 ;; esac
          [ -n "$MACH_PROFILE" ] || { echo "  $n: no MACH_PROFILE"; exit 1; }
          # And, where wk builds the system, it must *resolve* rather than
          # merely be spelt. Non-empty was the whole test until the rpi3's
          # entry was found naming `perf-linux-rpi3` -- a profile
          # image/profiles.sh refuses by name, because Ubuntu publishes no
          # armhf raspi image to seed one from. So the fleet's only 32-bit
          # board pointed at a system that could never be built, and nothing
          # said so until someone tried to build it. A machine whose default
          # system does not exist is not a machine wk can reproduce from this
          # repo, which is the cattle rule's whole claim.
          #
          # Except on macOS, and not as an exemption of convenience: a Mac's
          # bench system is a macOS *install*, personalised by the machine's
          # own secure storage, and `wk sysimage build` cannot produce one
          # (docs/HANDOFF-mac-perf-mode.md). `perf-macos-tolken` is therefore
          # vocabulary -- the name a run records -- and not a build recipe, so
          # asking image/profiles.sh to resolve it is asking the wrong
          # question. MACH_OS is what already draws that line.
          if [ "$MACH_OS" != macos ]; then
              # A subshell of its own because image_profile_load refuses by
              # `die`, which exits rather than returning -- so without one it
              # takes this check's own shell down and the `||` never runs,
              # leaving the machine named as bad with no reason beside it. The
              # IMG_* it would set are not wanted here; only the verdict is.
              ( image_profile_load "$MACH_PROFILE" ) >/dev/null 2>&1 \
                  || { echo "  $n: MACH_PROFILE '$MACH_PROFILE' does not resolve"; exit 1; }
          fi
          [ -n "$MACH_NOTE" ] || { echo "  $n: no MACH_NOTE"; exit 1; }
        ) || bad="$bad $n"
    done
    [ -z "$bad" ] || { echo "machine confs that do not stand alone:$bad"; return 1; }
    # The listing and the directory must be the same set: a conf the listing
    # skips is a machine that exists and is invisible.
    local listed dir_names
    listed=$(machine_list | awk '{print $1}' | sort)
    dir_names=$(ls "$WK_ROOT"/boot/machines/*.conf 2>/dev/null | xargs -n1 basename 2>/dev/null | sed 's/\.conf$//' | sort)
    [ "$listed" = "$dir_names" ] || { echo "machine_list and boot/machines/ disagree:
  listed: $(printf '%s' "$listed" | tr '\n' ' ')
  dir:    $(printf '%s' "$dir_names" | tr '\n' ' ')"; return 1; }
}

chk_boot_traversal_refused() {
    local d n; d=$(_nb_fixture)
    for n in "../../etc/passwd" "deadbeef/../../etc/passwd"; do
        [ -z "$(_nb_resolve "$d" "$n")" ] || { echo "$n resolved to something"; return 1; }
    done
}

chk_boot_files_check_catches_missing_kernel() {
    local d out; d=$(_nb_fixture)
    rm -f "$d/current/vmlinuz"
    out=$(python3 "$WK_ROOT/boot/check-boot-files.py" --root "$d" \
              --dtb bcm2711-rpi-4-b.dtb 2>&1) && {
        echo "a tree with no kernel was reported bootable"; return 1; }
    case "$out" in
        *current/vmlinuz*) ;;
        *) echo "did not name the missing kernel: $out"; return 1 ;;
    esac
}

chk_self_disarm_sh_is_single_quote_free() {
    # Every driver that offers b_self_disarm_sh has its output dropped straight
    # into ExecStart=/bin/sh -c '<here>'. A single quote in it does not error --
    # it silently reshapes the command, which on this mechanism means the image
    # never disarms and the board needs a hand on its power supply.
    local d out found=0
    for d in "$WK_ROOT"/boot/*.sh; do
        grep -q '^b_self_disarm_sh()' "$d" || continue
        found=1
        # shellcheck disable=SC1090
        out=$( MACH_DEVICE=/dev/sda MACH_NAME=selftest; . "$d"; b_self_disarm_sh )
        case "$out" in
            *\'*) echo "$(basename "$d") emits a single quote: $out"; return 1 ;;
        esac
        [ -n "$out" ] || { echo "$(basename "$d") emits nothing"; return 1; }
    done
    [ "$found" = 1 ] || return 77
}

chk_piusb_type_byte_roundtrips() {
    # The rpi4's whole arming is this one byte, and getting the offset or the
    # dd flags wrong is not a recoverable mistake on a boot medium -- without
    # conv=notrunc, dd truncates the device to one byte.
    local d img before after back
    d=$(mktemp -d "$TMP/piusb.XXXXXX"); img="$d/mbr.img"
    # A 2 MB file with the one byte this is about set to 0x0c, written the same
    # way the thing under test writes it.
    #
    # The fixture used to be built by feeding a keystroke script to `fdisk`,
    # which is Linux fdisk's interface and not macOS fdisk's -- so on this Mac
    # the fixture came out as partition type 00 and the check failed for a
    # reason that had nothing to do with the code. The selftest has to run on
    # both workstations, the same rule as `wk boot --status` (lib/common.sh,
    # epoch_to_utc). Nothing here needs a real partition table: the property is
    # that one byte at offset 450 round-trips and the write does not truncate.
    dd if=/dev/zero of="$img" bs=1024 count=2048 status=none 2>/dev/null \
        || { echo "could not make the fixture"; return 77; }
    # The byte round-trip needs none of this, but the sfdisk assertion at the
    # bottom reads a *table*, and a table is more than the type byte: without
    # the 0x55AA signature at 510 and a partition entry with a start and a
    # size, sfdisk sees no MBR at all -- which is how rebuilding this fixture
    # on the Mac (where the sfdisk branch is skipped) broke the check on
    # Linux without anyone seeing it. Entry 1 at 446: status 0, CHS zeroed
    # (sfdisk reads the LBA fields), start sector 2048, 2048 sectors long.
    printf '\000\000\000\000\000\000\000\000\000\010\000\000\000\010\000\000' \
        | dd of="$img" bs=1 seek=446 count=16 conv=notrunc status=none
    printf '\125\252' \
        | dd of="$img" bs=1 seek=510 count=2 conv=notrunc status=none
    printf '\'"$(printf '%03o' 0x0c)" \
        | dd of="$img" bs=1 seek=450 count=1 conv=notrunc status=none

    # shellcheck disable=SC1090
    ( MACH_DEVICE=/dev/null; . "$WK_ROOT/boot/pi-usb.sh"
      [ "$PIUSB_TYPE_OFFSET" = 450 ] || { echo "offset is $PIUSB_TYPE_OFFSET, not 450"; exit 1; } ) || return 1

    before=$(dd if="$img" bs=1 skip=450 count=1 status=none | od -An -tx1 | tr -d ' ')
    [ "$before" = 0c ] || { echo "fixture is type $before, wanted 0c"; return 1; }

    printf '\'"$(printf '%03o' 0x83)" \
        | dd of="$img" bs=1 seek=450 count=1 conv=notrunc status=none
    after=$(dd if="$img" bs=1 skip=450 count=1 status=none | od -An -tx1 | tr -d ' ')
    [ "$after" = 83 ] || { echo "disarm wrote $after, wanted 83"; return 1; }
    # `wc -c`, not `stat -c %s`: BSD stat spells it `-f %z` and answers the GNU
    # form with a usage block, which is the same portability trap as the
    # fixture above.
    [ "$(wc -c < "$img" | tr -d ' ')" = 2097152 ] || { echo "the write truncated the device"; return 1; }

    printf '\'"$(printf '%03o' 0x0c)" \
        | dd of="$img" bs=1 seek=450 count=1 conv=notrunc status=none
    back=$(dd if="$img" bs=1 skip=450 count=1 status=none | od -An -tx1 | tr -d ' ')
    [ "$back" = 0c ] || { echo "arm wrote $back, wanted 0c"; return 1; }
    # The last assertion is the interesting one and the least portable: that a
    # *partition tool* agrees the byte means FAT32, rather than only that the
    # byte is 0x0c. sfdisk is util-linux and this Mac has none, so it is asked
    # for only where it exists -- the byte-level round trip above is the part
    # that has to hold everywhere, and it does.
    if have sfdisk; then
        local table
        table=$(sfdisk -l "$img" 2>/dev/null || true)
        grep -q 'FAT32' <<<"$table" \
            || { echo "sfdisk no longer reads the round-tripped table as FAT32"; return 1; }
    fi
}

chk_image_seed_prose_is_inert() {
    # `user_data` in cmd/sysimage is an unquoted heredoc, because it interpolates
    # the profile's values. That makes every line of it shell input, including
    # the lines that look like YAML comments -- so a backticked command name in
    # prose runs on the build host and leaves an empty gap in the emitted file.
    # Found by a build printing "Command line to execute required." three times.
    local body
    body=$(awk '/^user_data\(\) \{/ {inside=1} inside && /^EOF$/ {print; exit} inside {print}' \
               "$WK_ROOT/cmd/sysimage")
    [ -n "$body" ] || { echo "could not find user_data()'s heredoc in cmd/sysimage"; return 1; }
    if printf '%s\n' "$body" | grep -nP '(?<!\\)`' >/dev/null 2>&1; then
        echo "unescaped backticks in the cloud-init seed heredoc -- these run on the build host:"
        printf '%s\n' "$body" | grep -nP '(?<!\\)`' | sed 's/^/    /'
        return 1
    fi
}

chk_boot_files_accepts_autodetected_kernel() {
    # The regression this guards: deriving one expected kernel name from
    # `arm_64bit` refused the Dev@CI Yocto image, whose config.txt names
    # neither and whose kernel8.img boots the rpi4 every day. A check that
    # refuses a working image is worse than no check -- it stops the lane it
    # was built to protect.
    local d out; d=$(_nb_fixture)
    printf '[all]\ndtoverlay=vc4-kms-v3d\n' > "$d/config.txt"
    rm -rf "$d/current"
    : > "$d/kernel8.img"; : > "$d/cmdline.txt"; : > "$d/bcm2711-rpi-4-b.dtb"
    out=$(python3 "$WK_ROOT/boot/check-boot-files.py" --root "$d" \
              --dtb bcm2711-rpi-4-b.dtb 2>&1) \
        || { echo "an auto-detected kernel8.img image was refused: $out"; return 1; }
}

