#!/usr/bin/env python3
#
# wk selftest [--lint] [--unit] [--live] [-v] [<pattern>] -- run the test suite in tests/
# wk: where=local name=none group=hosts needs python3 takes=1 opts --lint,--unit,--live,-v nodryrun
#
# Three tiers, any combination; with none named, lint then unit run. A test
# over WK_TEST_BUDGET seconds (30) fails; the summary prints the owed count and
# the slowest tests. Exempt from --dry-run: it runs tests, whose own effects
# are against fakes or are the live tier's purpose.
#
#   --lint        the static rules: one pass over the tree
#   --unit        every test that needs no VM, machine or board
#   --live        the tests that make a real workspace or reach a real machine;
#                 each skips by name when its machine is absent. One run at a
#                 time, and never beside a build on this machine's books
#   -v            one line per test
#   <pattern>     only tests whose name matches (unittest -k)

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images  # noqa: E402

ROOT = images.root()
sys.path.insert(0, ROOT)

from wk import act, decl  # noqa: E402
from wk.clock import Clock  # noqa: E402
from wk.lock import Lock  # noqa: E402
from wk.machine import here  # noqa: E402
from wk.store import Store  # noqa: E402


def refuse_live_beside(lock):
    """A live run makes workspaces and builds in them: it and a build starve each other, and two take one podman machine."""
    from tests.support import builds_on_the_books
    busy = builds_on_the_books()
    if busy:
        act.barrier("a build is on this machine's books:\n%s\n    A live run makes workspaces and builds in them, and a live "
                    "run and a\n    build starve each other. Wait for it ('wk status' follows it), or run\n    the tiers that "
                    "need no machine:\n        wk selftest" % "".join("      %s\n" % b for b in busy).rstrip("\n"))
    pid = lock.holder_pid("selftest")
    if pid is not None and lock.machine.alive(pid):
        act.die("a live 'wk selftest' is already running here (pid %d).\n    Two of them take the same podman machine, and "
                "the loaded one fails\n    wall-clock assertions that pass alone. Wait for it, or run the tiers\n    that "
                "need no machine:\n        wk selftest" % pid)
    lock.hold("selftest", 0)


def main(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    given = {"--lint": args.flag("--lint"), "--unit": args.flag("--unit"), "--live": args.flag("--live"), "-v": args.flag("-v")}
    run = [f for f, on in given.items() if on]
    for p in args.positionals:
        run += ["-k", p]
    if args.flag("--live"):
        refuse_live_beside(Lock(Store(), here(), Clock()))
    return here().run_tty([sys.executable, os.path.join(ROOT, "tests", "run.py")] + run, cwd=ROOT).rc


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except act.Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
