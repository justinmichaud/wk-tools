#!/usr/bin/env bash
#
# wk selftest [--lint] [--unit] [--live] [-v] [<pattern>] -- run the test suite in tests/
# wk: where=local name=none group=hosts needs python3 takes=1 opts --lint,--unit,--live,--quick,-v
#
# Three tiers, any combination; with none named, lint then unit run. A test
# over WK_TEST_BUDGET seconds (30) fails; the summary prints the owed count and
# the slowest tests.
#
#   --lint        the static rules: one pass over the tree
#   --unit        every test that needs no VM, machine or board
#   --live        the tests that make a real workspace or reach a real machine;
#                 each skips by name when its machine is absent. One run at a
#                 time, and never beside a build on this machine's books
#   -v            one line per test
#   <pattern>     only tests whose name matches (unittest -k)

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"

LIVE="" ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --quick) die "--quick is gone: 'wk selftest' with no tier named runs lint then unit and makes no workspace" ;;
        --live)  LIVE=1; ARGS+=("$1"); shift ;;
        --lint|--unit|-v) ARGS+=("$1"); shift ;;
        *)       ARGS+=(-k "$1"); shift ;;
    esac
done

cd "$WK_ROOT"

_builds_on_the_books() {   # the suite's own reading, asked here rather than spelled a second time
    python3 -c 'from tests.support import builds_on_the_books
print("\n".join(builds_on_the_books()))' 2>/dev/null
}

if [ -n "$LIVE" ]; then
    BUSY=$(_builds_on_the_books)
    [ -z "$BUSY" ] || barrier "a build is on this machine's books:
$(printf '%s\n' "$BUSY" | sed 's/^/      /')
    A live run makes workspaces and builds in them, and a live run and a
    build starve each other. Wait for it ('wk status' follows it), or run
    the tiers that need no machine:
        wk selftest"
    lock_alive selftest && die "a live 'wk selftest' is already running here (pid $(lock_holder_pid "$(_lock_path selftest)")).
    Two of them take the same podman machine, and the loaded one fails
    wall-clock assertions that pass alone. Wait for it, or run the tiers
    that need no machine:
        wk selftest"
    hold_lock selftest -w 0
fi

# Not exec'd: the EXIT trap that drops the lock has to outlive the run (lib/lockrun.sh).
rc=0
python3 tests/run.py ${ARGS[@]+"${ARGS[@]}"} || rc=$?
exit "$rc"
