"""quiet the machine for benchmarking, or give it a real graphical session

Privileged actions go through the sudoers-allowlisted helper (wk-quiesce-priv).

  on      quiet the machine for one run: stop every process in bench/quiet/macos.tsv, disable App Nap, keep
          MiniBrowser frontmost and the display awake (macOS); in bench mode also write this account's desktop
          settings. Settles for 30 seconds before returning.
  off     undo everything `on` did.
  status  what is quiesced now, and the helper's own account of it.

  session on [--bmc]   the benchmark session: cage alone on seat0; a no-op when someone is logged in or the mode is
                       already running.
  session gdm [--bmc]  a desktop to log into instead of the kiosk.
  session off          outputs modeset off, a placeholder compositor holding the device so fbcon cannot repaint them;
                       `session gdm` undoes it.
  session status       unit, socket, display manager and DRM state.
"""
import os

from wk import act, images, quiet, session
from wk.act import die
from wk.clock import Clock
from wk.decl import Command, Opt
from wk.machine import Local, is_linux

ROOT = images.root()
BMC = Opt("--bmc", "move the session from the GPU to the BMC's `ast` chip (software-rendered; the monitor goes dark)")
COMMAND = Command(where="host", needs=("quiesce-helper",), default="status", group="hosts", subs={
    "on": {}, "off": {}, "status": dict(readonly=True, needs=()),
    "session": dict(default="status", subs={"on": dict(opts=(BMC,)), "gdm": dict(opts=(BMC,)), "off": {},
                                             "status": dict(readonly=True, needs=())})})


def main(args, inv):
    verb = args.positionals[0]
    if verb == "session":
        if not is_linux():
            die("wk quiesce session is Linux-only (macOS workspaces have no GPU to reach)")
        s = session.Session(ROOT, Local(), Clock(), os.environ)
        action = args.positionals[1]
        return s.on(args.flag("--bmc")) if action == "on" else s.gdm(args.flag("--bmc")) if action == "gdm" else getattr(s, action)()
    act.terminate_as_interrupt()
    return getattr(quiet.Quiesce(ROOT, Local(), Clock(), os.environ), verb)()
