#!/usr/bin/env bash
#
# wk quiesce on|off|status -- quiet the machine for benchmarking
#
# wk: where=host name=none group=hosts needs quiesce-helper
# wk: sub status needs=
#
# Privileged actions go through the sudoers-allowlisted helper
# (wk-quiesce-priv); everything that needs no privilege stays here, keeping
# the root helper a short, auditable, fixed allowlist.
#
#   on      quiet the machine: pause background daemons, disable the
#           screensaver and lock screen, disable App Nap and keep MiniBrowser
#           frontmost (macOS), stop Notification Center, keep the display
#           awake. Settles for WK_SETTLE_SECONDS (default 30) before
#           returning.
#   off     undo everything `on` did, reading this machine's one state
#           directory.
#   status  what is quiesced right now, plus the privileged helper's own
#           account of what it did.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
# macos_noise is shared: this asks before and after a run, and `wk bench
# staged` asks before it will believe a number.
. "$WK_ROOT/lib/quiet.sh"

PRIV=/usr/local/libexec/wk-quiesce-priv

ACTION="${1:-status}"
[ $# -le 1 ] || die "usage: wk quiesce on|off|status -- quiet the machine for benchmarking.; see wk quiesce -h"

# One state directory per machine, not `${TMPDIR:-/tmp}/wk-quiesce`: on macOS
# $TMPDIR is per-user *and per-session*, so a terminal and an ssh login get
# different values -- `on` at the keyboard and `off` over ssh (an unattended
# benchmark lane) would look in two different directories and strand state.
STATE="${WK_QUIESCE_STATE:-$(wk_state_dir)/quiesce}"
# An older wk-tools wrote its state here; not read or migrated, but `status`
# names it so a person can `rm -rf` it themselves.
STALE_STATE="${TMPDIR:-/tmp}/wk-quiesce"

run_priv() {
    [ -x "$PRIV" ] || die "$PRIV is not installed, so the privileged half of quiesce
    cannot run.
    Remedy:  ./setup --stage quiesce"
    sudo -n "$PRIV" "$1" || die "passwordless sudo is not set up for $PRIV.
    Remedy:  ./setup --stage quiesce"
}

# Interrupting `on` partway through must not leave the machine wedged between
# states: daemons killall-STOPped forever, or NotificationCenter booted out
# with nothing to restart it. `off` already undoes exactly what `on` did, one
# idempotent step per artifact in $STATE, so INT/TERM during `on` runs it
# rather than inventing a second unwind path.
_quiesce_on_interrupted() {
    warn "interrupted -- undoing what 'quiesce on' already did"
    "$0" off || true
}

case "$ACTION" in
on)
    on_interrupt _quiesce_on_interrupted
    run_priv on
    mkdir -p "$STATE"

    if is_macos; then
        if [ ! -f "$STATE/caffeinate.pid" ]; then
            # All three descriptors detached: a backgrounded process holding
            # the inherited ones keeps an ssh session open with it (ssh waits
            # on the streams, not the shell), hanging `on` over ssh forever.
            caffeinate -dimsu </dev/null >/dev/null 2>&1 &
            echo $! > "$STATE/caffeinate.pid"
            info "caffeinate started"
        fi
        # The largest remaining noise source, and need no privilege to pause.
        killall -STOP photoanalysisd mediaanalysisd suggestd \
            knowledgeconstructiond parsecd proactived \
            AMPLibraryAgent bird cloudd ReportCrash 2>/dev/null || true
        touch "$STATE/daemons_paused"
        info "background daemons paused"
        # DND can't be scripted reliably, so Notification Center itself is
        # booted out instead: a banner is compositor work that can steal
        # focus, and a MiniBrowser that loses focus gets rAF-throttled into
        # the silent exit-124 timeout. Booting needs no root and is
        # self-reversing at next login.
        #
        # `com.apple.notificationcenterui` is the plist *filename*, not its
        # label -- macOS 26 answers "could not find service" for it while the
        # agent keeps running, so the verdict comes from `pgrep`, not
        # launchctl's exit status.
        if pgrep -x NotificationCenter >/dev/null 2>&1; then
            nc_label=$(/usr/libexec/PlistBuddy -c 'Print :Label' \
                /System/Library/LaunchAgents/com.apple.notificationcenterui.plist 2>/dev/null)
            for lbl in "$nc_label" com.apple.notificationcenterui.agent com.apple.notificationcenterui; do
                [ -n "$lbl" ] || continue
                launchctl bootout "gui/$(id -u)/$lbl" >/dev/null 2>&1
                sleep 1
                pgrep -x NotificationCenter >/dev/null 2>&1 || break
            done
            if pgrep -x NotificationCenter >/dev/null 2>&1; then
                warn "NotificationCenter is still running -- a banner can appear mid-run"
            else
                info "NotificationCenter stopped (label '${lbl}'; no banners can be drawn)"
                printf '%s' "$lbl" > "$STATE/notifications_stopped"
            fi
        else
            info "NotificationCenter was not running"
        fi

        # No keyboard/mouse input during a run, so the idle timer can engage
        # the screensaver mid-run -- same "nowhere to draw" failure as a
        # stolen focus. `caffeinate -dimsu` usually suppresses this via
        # display sleep; this makes it explicit. -currentHost is where
        # idleTime actually lives.
        defaults -currentHost write com.apple.screensaver idleTime -int 0 2>/dev/null || true
        defaults write com.apple.screensaver askForPassword -int 0 2>/dev/null || true
        v=$(defaults -currentHost read com.apple.screensaver idleTime 2>/dev/null || echo "?")
        [ "$v" = 0 ] && info "screensaver disabled (idleTime=0)" \
                     || warn "screensaver idleTime reads '$v' -- the screen can still lock mid-run"

        # MiniBrowser is launched via a raw exec, so macOS never *activates*
        # it: an unfocused window's page is marked hidden and rAF throttled,
        # ending in a stalled, silent exit-124. Two halves, since either
        # alone is insufficient: App Nap off stops the throttling policy, and
        # the raiser keeps the window frontmost. The raiser only acts when
        # MiniBrowser isn't already frontmost, so it's safe to leave up
        # across many relaunches.
        defaults write org.webkit.MiniBrowser NSAppSleepDisabled -bool YES 2>/dev/null \
            && { touch "$STATE/appnap_disabled"; info "App Nap disabled for MiniBrowser"; } \
            || warn "could not disable App Nap for MiniBrowser -- rAF may be throttled mid-run"
        if [ -f "$STATE/raiser.pid" ] && kill -0 "$(cat "$STATE/raiser.pid")" 2>/dev/null; then
            info "raiser already running"
        elif /usr/bin/python3 -c 'import AppKit' >/dev/null 2>&1; then
            cat > "$STATE/raiser.py" <<'RAISEREOF'
#!/usr/bin/python3
# Picks up each round's relaunched instance by bundle id;
# activateIgnoringOtherApps pulls it into the current Space when the driving
# terminal is fullscreen.
import sys, time
from AppKit import (NSRunningApplication, NSWorkspace,
                    NSApplicationActivateIgnoringOtherApps)
BID = "org.webkit.MiniBrowser"
INTERVAL = float(sys.argv[1]) if len(sys.argv) > 1 else 1.0
while True:
    f = NSWorkspace.sharedWorkspace().frontmostApplication()
    if f is None or f.bundleIdentifier() != BID:
        for a in NSRunningApplication.runningApplicationsWithBundleIdentifier_(BID):
            a.activateWithOptions_(NSApplicationActivateIgnoringOtherApps)
    time.sleep(INTERVAL)
RAISEREOF
            # Detached like caffeinate above, same reason.
            /usr/bin/python3 "$STATE/raiser.py" 1 </dev/null >"$STATE/raiser.log" 2>&1 &
            echo $! > "$STATE/raiser.pid"
            info "raiser started -- MiniBrowser is kept frontmost during runs"
        else
            warn "no python3 AppKit here, so no raiser: MiniBrowser can be backgrounded and
    its rAF throttled. /usr/bin/python3 with pyobjc is what a benchmark install needs
    anyway -- see docs/HANDOFF-mac-perf-mode.md."
        fi

        # Reported just before a run, not in a status command nobody ran.
        info "measured, now that both halves have run:"
        macos_noise || warn "the machine is noisier than a benchmark install should be (above)"
    fi

    wk_sleep "${WK_SETTLE_SECONDS:-30}"
    info "quiesced; settle time elapsed"
    ;;

off)
    if is_macos && [ -d "$STATE" ]; then
        if [ -f "$STATE/caffeinate.pid" ]; then
            kill "$(cat "$STATE/caffeinate.pid")" 2>/dev/null || true
            rm -f "$STATE/caffeinate.pid"
            info "caffeinate stopped"
        fi
        if [ -f "$STATE/raiser.pid" ]; then
            kill "$(cat "$STATE/raiser.pid")" 2>/dev/null || true
            rm -f "$STATE/raiser.pid"
            info "raiser stopped"
        fi
        if [ -f "$STATE/appnap_disabled" ]; then
            defaults delete org.webkit.MiniBrowser NSAppSleepDisabled 2>/dev/null || true
            rm -f "$STATE/appnap_disabled"
            info "App Nap restored for MiniBrowser"
        fi
        # Comes back on its own at next login on a benchmark install that
        # reboots; restarted here anyway so `quiesce off` hands the
        # workstation desktop back exactly as it was found.
        if [ -f "$STATE/notifications_stopped" ]; then
            # The label that actually worked, not a guess -- see the note in `on`.
            nc_label=$(cat "$STATE/notifications_stopped" 2>/dev/null)
            launchctl bootstrap "gui/$(id -u)" \
                /System/Library/LaunchAgents/com.apple.notificationcenterui.plist >/dev/null 2>&1 \
                || launchctl kickstart "gui/$(id -u)/${nc_label:-com.apple.notificationcenterui.agent}" >/dev/null 2>&1 \
                || open -a NotificationCenter >/dev/null 2>&1 || true
            rm -f "$STATE/notifications_stopped"
            info "NotificationCenter restarted"
        fi
        if [ -f "$STATE/daemons_paused" ]; then
            killall -CONT photoanalysisd mediaanalysisd suggestd \
                knowledgeconstructiond parsecd proactived \
                AMPLibraryAgent bird cloudd ReportCrash 2>/dev/null || true
            rm -f "$STATE/daemons_paused"
            info "background daemons resumed"
        fi
    fi
    run_priv off
    ;;

status)
    # Labelled rather than merged with what this machine says now: their
    # disagreement is the finding. `|| true` guards the assignment, so a
    # missing helper's die becomes the claim rather than aborting this report.
    _claim=$(run_priv status 2>&1) || true
    if [ -n "$_claim" ]; then
        log "  the privileged half's own account:"
        printf '%s\n' "$_claim" | sed 's/^/    /' >&2
    fi
    log "  measured here, now:"
    # kill -0 asks the process, not the file: a pid left by a dead caffeinate
    # is not "running".
    [ -f "$STATE/caffeinate.pid" ] && kill -0 "$(cat "$STATE/caffeinate.pid")" 2>/dev/null \
        && log "  caffeinate: running" || log "  caffeinate: no"
    [ -f "$STATE/daemons_paused" ] && log "  daemons:    paused" || log "  daemons:    running"
    [ -d "$STALE_STATE" ] && log "  stale: $STALE_STATE (an older wk-tools' state; not read -- rm -rf it)"
    if is_macos; then
        [ -f "$STATE/raiser.pid" ] && kill -0 "$(cat "$STATE/raiser.pid")" 2>/dev/null \
            && log "  raiser:     running (MiniBrowser kept frontmost)" \
            || log "  raiser:     no"
        [ "$(defaults read org.webkit.MiniBrowser NSAppSleepDisabled 2>/dev/null)" = 1 ] \
            && log "  app nap:    disabled for MiniBrowser" \
            || log "  app nap:    default (rAF can be throttled when backgrounded)"
    fi
    is_macos && { macos_noise || true; }
    ;;

*)
    die "usage: wk quiesce on|off|status -- quiet the machine for benchmarking.; see wk quiesce -h"
    ;;
esac
