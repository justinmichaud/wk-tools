#!/usr/bin/env python3
#
# wk quiesce on|off|status | session on|gdm|off|status [--bmc] -- quiet the machine for benchmarking, or give it a real graphical session
#
# wk: where=host name=none group=hosts needs quiesce-helper takes=1 verbs=on,off,status,session default=status dryrun on,off
# wk: readonly status
# wk: sub status needs=
# wk: sub session takes=2 needs= opts=--bmc dryrun=yes
# wk: sub session on,gdm,off needs=quiesce-helper
# wk: sub session status readonly=yes
#
# Privileged actions go through the sudoers-allowlisted helper (wk-quiesce-priv).
#
#   on      quiet the machine for one run: stop every process in
#           bench/quiet/macos.tsv, disable App Nap, keep MiniBrowser frontmost
#           and the display awake (macOS); in bench mode also write this
#           account's desktop settings. Settles for WK_SETTLE_SECONDS
#           (default 30) before returning.
#   off     undo everything `on` did.
#   status  what is quiesced now, and the helper's own account of it.
#
#   session on [--bmc]   the benchmark session: cage alone on seat0. A no-op
#                when someone is logged in or the mode is already running.
#   session gdm [--bmc]  a desktop to log into instead of the kiosk.
#   session off  outputs modeset off, a placeholder compositor holding the
#                device so fbcon cannot repaint them; `session gdm` undoes it.
#   session status   unit, socket, display manager and DRM state.
#
#   --bmc moves the session from the GPU to the BMC's `ast` chip
#   (software-rendered; the monitor goes dark). The compositor's socket is
#   $XDG_RUNTIME_DIR/wk/display/wayland-0.

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images  # noqa: E402

ROOT = images.root()

from wk import act, decl, quiet, session  # noqa: E402
from wk.act import Refused, die  # noqa: E402
from wk.clock import Clock  # noqa: E402
from wk.machine import Local, is_linux  # noqa: E402

SESSION_VERBS = ("on", "gdm", "off", "status")


def graphical(words, bmc):
    action = words[0] if words else "status"
    if action not in SESSION_VERBS:
        die("'%s' is not a verb of wk quiesce session: on, gdm, off or status; see wk quiesce -h" % action)
    if bmc and action not in ("on", "gdm"):
        die("--bmc moves the session 'on' or 'gdm' starts: wk quiesce session on --bmc")
    if not is_linux():
        die("wk quiesce session is Linux-only (macOS workspaces have no GPU to reach)")
    s = session.Session(ROOT, Local(), Clock(), os.environ)
    return s.on(bmc) if action == "on" else s.gdm(bmc) if action == "gdm" else getattr(s, action)()


def main(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    verb = args.positionals[0]
    if verb == "session":
        return graphical(args.positionals[1:], args.flag("--bmc"))
    act.terminate_as_interrupt()
    q = quiet.Quiesce(ROOT, Local(), Clock(), os.environ)
    return getattr(q, verb)()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
