#!/usr/bin/env bash
#
# wk quiesce on|off|status -- quiet the machine for benchmarking.
#
# Split in two: the privileged actions go through the sudoers-allowlisted
# helper, and everything that needs no privilege stays here. Keeping the
# unprivileged half out of the root helper is what lets the root helper stay a
# short, auditable, fixed allowlist.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
# macos_noise lives in a library because two commands ask the same question:
# this one before and after a run, and `wk bench staged` before it will believe
# a number (docs/HANDOFF-benchmarking.md).
. "$WK_ROOT/lib/quiet.sh"

PRIV=/usr/local/libexec/wk-quiesce-priv

ACTION="${1:-status}"
STATE="${TMPDIR:-/tmp}/wk-quiesce"

run_priv() {
    if [ -x "$PRIV" ]; then
        sudo -n "$PRIV" "$1" 2>/dev/null && return 0
        warn "passwordless sudo unavailable; re-run ./setup to install the sudoers rule"
        sudo "$PRIV" "$1"
    else
        warn "$PRIV is not installed; run ./setup. Continuing with unprivileged steps only."
    fi
}

case "$ACTION" in
on)
    run_priv on
    mkdir -p "$STATE"

    if is_macos; then
        # Keep the machine awake for the whole run without touching power
        # settings permanently.
        if [ ! -f "$STATE/caffeinate.pid" ]; then
            # stdin, stdout and stderr all detached, and that is not tidiness:
            # a backgrounded process that keeps the inherited descriptors open
            # holds an ssh session open with it, because ssh waits for the
            # streams and not for the shell. `wk quiesce on` over ssh therefore
            # hung for ever instead of returning -- measured 2026-08-22 driving
            # the benchmark install from another machine, which is the only way
            # this command is ever run unattended.
            caffeinate -dimsu </dev/null >/dev/null 2>&1 &
            echo $! > "$STATE/caffeinate.pid"
            info "caffeinate started"
        fi
        # Background analysis daemons are the largest remaining noise source
        # and need no privilege to pause.
        killall -STOP photoanalysisd mediaanalysisd suggestd \
            knowledgeconstructiond parsecd proactived \
            AMPLibraryAgent bird cloudd ReportCrash 2>/dev/null || true
        touch "$STATE/daemons_paused"
        info "background daemons paused"
        # NOTIFICATIONS: REMOVE THE THING THAT DRAWS, RATHER THAN ASK IT NICELY.
        #
        # This line used to read `warn "set Do Not Disturb by hand -- it cannot
        # be scripted reliably"`, which is true about Do Not Disturb and useless
        # here: this command's whole purpose is an unattended run, so "by hand"
        # means "not at all". Notifications were therefore live through every
        # benchmark this lane has ever taken. Observed on the benchmark install's
        # own screen, 2026-08-24 -- banners visible after a full A/B.
        #
        # A banner is not a cosmetic problem. It is compositor work in the middle
        # of a measurement and it can take focus, and a browser that loses focus
        # is throttled to the silent exit-124 timeout that `screen_blocker`
        # exists to prevent and cannot see (a banner is not a frontmost
        # application).
        #
        # So the Focus/DND setting is not touched at all. Notification Center is
        # *booted out* instead: it cannot draw a banner if it is not running.
        # That needs no root (a gui/<uid> domain agent), no TCC prompt, and no
        # knowledge of where Apple keeps Focus state this year -- and it is
        # per-login and self-reversing, which is the shape of everything else
        # here. Verified by asking whether the process is gone, not by the exit
        # status of the bootout.
        # THE LABEL IS NOT WHAT IT LOOKS LIKE. The first version booted out
        # `com.apple.notificationcenterui`, which is the *plist filename* and not
        # the label inside it: macOS 26 answers "Could not find service
        # com.apple.notificationcenterui in domain for user gui: 501" and the
        # agent keeps running. Measured on the benchmark install 2026-08-24,
        # where the warning below fired on every one of six arms. The label is
        # `com.apple.notificationcenterui.agent` -- read out of
        # /System/Library/LaunchAgents/com.apple.notificationcenterui.plist.
        #
        # So the label is *discovered* from the plist where possible and only
        # falls back to a guess, and either way the verdict comes from `pgrep`
        # rather than from launchctl's exit status. Same rule as everywhere else
        # on this platform: ask whether the thing is gone, not whether the
        # command said so.
        if pgrep -x NotificationCenter >/dev/null 2>&1; then
            nc_label=$(/usr/libexec/PlistBuddy -c 'Print :Label' \
                /System/Library/LaunchAgents/com.apple.notificationcenterui.plist 2>/dev/null)
            for lbl in "$nc_label" com.apple.notificationcenterui.agent com.apple.notificationcenterui; do
                [ -n "$lbl" ] || continue
                launchctl bootout "gui/$(id -u)/$lbl" >/dev/null 2>&1
                sleep 1
                pgrep -x NotificationCenter >/dev/null 2>&1 || break
            done
            if pgrep -x NotificationCenter >/dev/null 2>&1; then
                warn "NotificationCenter is still running -- a banner can appear mid-run"
            else
                info "NotificationCenter stopped (label '${lbl}'; no banners can be drawn)"
                printf '%s' "$lbl" > "$STATE/notifications_stopped"
            fi
        else
            info "NotificationCenter was not running"
        fi

        # THE SCREEN LOCK, which nothing in this repository had ever touched --
        # `screensaver` and `askForPassword` appear in no file. The handoff's
        # provisioning list claims "sleep and screen saver off"; it was never
        # implemented, and on 2026-08-24 the benchmark install locked itself
        # while sitting on a finished job.
        #
        # It matters more than it looks, because a benchmark generates no
        # keyboard or mouse input: the idle timer runs at full CPU load exactly
        # as it does on an abandoned machine. So the screensaver can start, and
        # the lock behind it can engage, *during* a run -- and a locked screen is
        # the same "nowhere to draw" failure as a stolen focus.
        #
        # `caffeinate -dimsu` above prevents display sleep, which usually
        # suppresses the screensaver too; this makes it explicit rather than
        # relying on that coupling. -currentHost because that is where the
        # screensaver's idleTime actually lives.
        defaults -currentHost write com.apple.screensaver idleTime -int 0 2>/dev/null || true
        defaults write com.apple.screensaver askForPassword -int 0 2>/dev/null || true
        v=$(defaults -currentHost read com.apple.screensaver idleTime 2>/dev/null || echo "?")
        [ "$v" = 0 ] && info "screensaver disabled (idleTime=0)" \
                     || warn "screensaver idleTime reads '$v' -- the screen can still lock mid-run"

        # Reported at the moment it matters -- just before a run, not in a
        # status command nobody ran -- and deliberately not fixed: see
        # macos_noise.
        info "measured, now that both halves have run:"
        macos_noise || warn "the machine is noisier than a benchmark install should be (above)"
    fi

    sleep "${WK_SETTLE_SECONDS:-30}"
    info "quiesced; settle time elapsed"
    ;;

off)
    if is_macos; then
        if [ -f "$STATE/caffeinate.pid" ]; then
            kill "$(cat "$STATE/caffeinate.pid")" 2>/dev/null || true
            rm -f "$STATE/caffeinate.pid"
            info "caffeinate stopped"
        fi
        # Notification Center comes back on its own at the next login, so there
        # is nothing to undo on a benchmark install that reboots. Restarted here
        # anyway for the workstation case, where `quiesce off` is expected to
        # hand the desktop back exactly as it was found.
        if [ -f "$STATE/notifications_stopped" ]; then
            # The label that actually worked, not a guess -- see the note in `on`.
            nc_label=$(cat "$STATE/notifications_stopped" 2>/dev/null)
            launchctl bootstrap "gui/$(id -u)" \
                /System/Library/LaunchAgents/com.apple.notificationcenterui.plist >/dev/null 2>&1 \
                || launchctl kickstart "gui/$(id -u)/${nc_label:-com.apple.notificationcenterui.agent}" >/dev/null 2>&1 \
                || open -a NotificationCenter >/dev/null 2>&1 || true
            rm -f "$STATE/notifications_stopped"
            info "NotificationCenter restarted"
        fi
        if [ -f "$STATE/daemons_paused" ]; then
            killall -CONT photoanalysisd mediaanalysisd suggestd \
                knowledgeconstructiond parsecd proactived \
                AMPLibraryAgent bird cloudd ReportCrash 2>/dev/null || true
            rm -f "$STATE/daemons_paused"
            info "background daemons resumed"
        fi
    fi
    run_priv off
    ;;

status)
    # The privileged half's account is a claim -- it says what it did, from a
    # process that is gone -- and the block under it is what this machine says
    # now. They are labelled rather than merged, because when they disagree the
    # disagreement is the finding.
    _claim=$(run_priv status 2>&1 || true)
    if [ -n "$_claim" ]; then
        log "  the privileged half's own account:"
        printf '%s\n' "$_claim" | sed 's/^/    /' >&2
    fi
    log "  measured here, now:"
    [ -f "$STATE/caffeinate.pid" ] && log "  caffeinate: running" || log "  caffeinate: no"
    [ -f "$STATE/daemons_paused" ] && log "  daemons:    paused" || log "  daemons:    running"
    is_macos && { macos_noise || true; }
    ;;

*)
    die "usage: wk quiesce on|off|status"
    ;;
esac
