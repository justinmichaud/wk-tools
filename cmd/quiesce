#!/usr/bin/env python3
#
# wk quiesce on|off|status -- quiet the machine for benchmarking
#
# wk: where=host name=none group=hosts needs quiesce-helper takes=1 dryrun on,off
# wk: readonly status
# wk: sub status needs=
#
# Privileged actions go through the sudoers-allowlisted helper (wk-quiesce-priv);
# everything else stays here.
#
#   on      quiet the machine for the length of a run and no longer: stop
#           every process in bench/quiet/macos.tsv's table -- the agents a
#           login session starts and the background daemons alike -- disable
#           App Nap, keep MiniBrowser frontmost and the display awake (macOS).
#           In bench mode it also writes this account's desktop settings, which
#           a first boot cannot make hold for an account with no session yet.
#           Settles for WK_SETTLE_SECONDS (default 30) before returning.
#   off     undo everything `on` did, reading this machine's one state
#           directory.
#   status  what is quiesced right now, plus the privileged helper's own
#           account of what it did.
#
#   What a measured Mac is permanently is written at provisioning time
#   (`wk sysimage build perf-macos-tolken --provision`); `status` reports both.

import os
import signal
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import decl, quiet  # noqa: E402
from wk.act import Refused, die  # noqa: E402
from wk.clock import Clock  # noqa: E402
from wk.machine import Local  # noqa: E402

USAGE = "usage: wk quiesce on|off|status -- quiet the machine for benchmarking.; see wk quiesce -h"


def parse(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    action = args.positionals[0] if args.positionals else "status"
    if len(args.positionals) > 1 or action not in ("on", "off", "status"):
        die(USAGE)
    return action


def interrupted(signum, frame):
    raise KeyboardInterrupt


def main(argv):
    action = parse(argv)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, interrupted)
    q = quiet.Quiesce(ROOT, Local(), Clock(), os.environ)
    return getattr(q, action)()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
