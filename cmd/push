#!/usr/bin/env bash
#
# wk push on|off|status -- whether a workspace can push to git at all
# wk: where=store name=none group=sources
# wk: readonly status
# wk: flag --all,--target where=local
#
# The rule this implements, from docs/HANDOFF-sandboxing.md: only the person at
# the keyboard pushes. An agent in a workspace must not be able to publish
# anything -- the failures that produced this were Claude pushing over work and
# replying to reviewers on GitHub -- while a shell in the same workspace, run by
# a human who asked for it, should push perfectly normally.
#
# So it is a switch, and the switch is *where the key is*, not a flag anything
# reads:
#
#   on    the private deploy keys are in the store's secrets directory, which
#         every workspace has mounted read-only at /secrets and links to from
#         ~/.ssh. Push works.
#   off   they are in $WK_STORE/push-keys, which nothing mounts anywhere. The
#         links in every workspace dangle, ssh has no identity to offer, and a
#         push is refused by GitHub. Nothing in a workspace can undo this: the
#         only copy is on the far side of a read-only mount, on a filesystem a
#         container cannot see.
#
# That is the whole design. There is no state file to disagree with reality,
# nothing to restore after a crash, and `status` is a directory listing rather
# than a claim -- the same rule the rest of the workspace state follows
# (README.md).
#
# `wk claude` turns it off before handing over control, which is the case the
# switch exists for; see the note there about when it turns it back on.
#
#   --target <machine>   throw the switch on that fleet machine's own store
#                        instead of this one's (a build machine keeps its own
#                        key under its own wk root)
#   --all                throw it everywhere: this machine and every other one
#                        (wk boot --list names them); a machine that does not
#                        answer is skipped, not fatal
#
#   0  push is on (status), or the action succeeded
#   1  push is off (status), or the action failed
#   4  there are no deploy keys on this machine at all

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# $WK_STORE is target-dependent: /var/lib/wk in the podman VM, the remote
# root on a build machine. Loading the target this machine *is* puts the
# keys where this machine actually keeps them.
load_target "$(default_target)" 2>/dev/null || true

# Refused inside a workspace, but *not* on a build machine: the switch acts
# on the machine that holds the key, and on a shared box that is the box.
in_workspace && die "'wk push' moves the deploy keys, and this is workspace '$(wk_self)'.
    The keys are on the host and a workspace cannot reach them -- which is what
    makes the switch a switch. Run it on the host."

ACTION=status
TARGET=""
while [ $# -gt 0 ]; do
    case "$1" in
        on|off|status) ACTION="$1"; shift ;;
        --target) TARGET="${2:-}"; [ -n "$TARGET" ] || die "--target needs a name"; shift 2 ;;
        --all) TARGET=--all; shift ;;
        *) die "usage: wk push on|off|status; see wk push -h" ;;
    esac
done

# A build machine keeps its own key under its own wk root, so the switch has
# to be thrown *there*: the machine answers for itself by running this same
# file, exactly as `wk sudo` does. The fan-out runs on the workstation and
# nowhere else -- it needs the target confs and the ssh reach to the fleet --
# which is what the `flag --all,--target where=local` declaration says.
if [ -n "$TARGET" ]; then
    _row() { sed "s/^/$(printf '%-22s' "$1")/"; }

    _one() {
        local t="$1" rc=0 out
        load_target "$t"
        machine_answers "$t" || return 1
        out=$(t_wk push "$ACTION" 2>&1) || rc=$?
        printf '%s\n' "$out" | _row "$t"
        return "$rc"
    }

    # This machine holds a store too, and for_each_machine walks only the
    # others -- so `--all` asks this one through its own `wk`, which is the
    # hop that reaches the podman VM on a macOS workstation.
    _here() {
        local rc=0 out
        out=$("$WK_ROOT/wk" push "$ACTION" 2>&1) || rc=$?
        printf '%s\n' "$out" | _row "$(wk_machine_name)"
        return "$rc"
    }

    if [ "$TARGET" = --all ]; then
        rc=0; _here || rc=$?
        fan=0; for_each_machine _one || fan=$?
        [ "$fan" -gt "$rc" ] && rc="$fan"
        exit "$rc"
    fi
    _one "$TARGET"
    exit $?
fi

# Where the keys go when push is off. Deliberately not under secrets/: that
# directory is bind-mounted into every workspace, so a subdirectory of it would
# be just as reachable as the keys were.
HELD="$WK_STORE/push-keys"
LIVE="$WK_STORE/secrets"

forks() { wk_push_forks | awk 'NF {print $1}'; }

# The evidence, per fork: live | held | absent. A key that is somehow in both
# places is reported as `live`, because that is what a workspace would use --
# and `wk push off` then moves it and the duplicate is gone.
where() {
    local r="$1"
    [ -f "$LIVE/build_key_$r" ] && { echo live; return 0; }
    [ -f "$HELD/build_key_$r" ] && { echo held; return 0; }
    echo absent
}

# Copies of a key inside a workspace's own home (from firstrun `install`ing
# it rather than linking it) are keys this switch cannot reach, so they are
# removed rather than reported. A symlink is the current arrangement and is
# left alone.
copies() {
    local d f r
    [ -d "$WK_STORE/ws" ] || return 0
    for d in "$WK_STORE"/ws/*/; do
        [ -d "$d" ] || continue
        for r in $(forks); do
            f="$d/home/.ssh/id_$r"
            [ -f "$f" ] && [ ! -L "$f" ] && printf '%s\n' "$f"
        done
    done
    return 0
}

purge_copies() {
    local f n=0
    while read -r f; do
        [ -n "$f" ] || continue
        if rm -f "$f" 2>/dev/null; then
            n=$((n + 1))
        else
            warn "could not remove a copy of a deploy key: $f"
        fi
    done <<EOF
$(copies)
EOF
    [ "$n" -eq 0 ] || info "removed $n key copy/copies left in workspace homes"
}

# Every private key in the directory, not only the ones wk_push_forks
# names: an old or hand-added key here is exactly as usable as one it knows
# about. Public halves stay -- `wk key check`/`show` need them while off.
private_keys_in() {
    local d="$1" f
    [ -d "$d" ] || return 0
    for f in "$d"/build_key*; do
        [ -f "$f" ] || continue
        case "$f" in *.pub) continue ;; esac
        printf '%s\n' "$f"
    done
}

# The count comes back in MOVED rather than on stdout. Neither errexit nor a
# `die` crosses a command substitution -- it is a subshell, and the assignment
# takes its status -- so a store this machine could not even create still
# reported "push is already OFF" about keys nothing had looked for.
MOVED=0
move_keys() {
    local from="$1" to="$2" f b
    MOVED=0
    ensure_dir "$to" 0700 >/dev/null
    while read -r f; do
        [ -n "$f" ] || continue
        b=$(basename "$f")
        mv "$f" "$to/$b"
        chmod 0600 "$to/$b"
        # The public half goes with it: ssh will offer a public key it finds
        # beside IdentityFile even without the private half.
        [ -f "$from/$b.pub" ] && mv "$from/$b.pub" "$to/$b.pub"
        MOVED=$((MOVED + 1))
    done <<EOF
$(private_keys_in "$from")
EOF
}

# The workspaces here in which a claude process is running -- asked of the
# machine, not of a record: a session started by hand from `wk enter` counts
# the same as one `wk claude` started. Exposing the keys while one runs would
# put them in that session's mount, so `on` is refused until it ends.
# A running agent is one whose executable resolves under the Claude install
# (`~/.local/share/claude/versions/...`, firstrun.sh), read from /proc inside
# the workspace -- evidence, not a name match: the process is called `claude`,
# `node` or a version string depending on how it was launched, but its exe
# path is not. Scoped to inside the container, so `cmd/claude` on the host and
# a human's `git` never register.
agent_sessions() {
    local ws
    while IFS=$(printf '\t') read -r ws _; do
        [ -n "$ws" ] || continue
        t_exec "$ws" sh -c '
            for e in /proc/[0-9]*/exe; do
                case "$(readlink "$e" 2>/dev/null)" in
                    */claude/versions/*|*/.local/bin/claude) exit 0 ;;
                esac
            done
            exit 1' >/dev/null 2>&1 && printf '%s\n' "$ws"
    done <<EOF
$(t_list 2>/dev/null)
EOF
    return 0
}

case "$ACTION" in
on)
    busy=$(agent_sessions)
    if [ -n "$busy" ]; then
        barrier "an agent session (a claude process) is running in $(printf '%s' "$busy" | tr '\n' ' ')-- exposing
    the keys puts them in its mount, and its commit wall stays until it exits.
    End that session first, or force this."
    fi
    move_keys "$HELD" "$LIVE"; n="$MOVED"
    # Idempotent, and it says which of the two it was: a switch that reports
    # "on" whether or not it did anything is a switch you have to verify by
    # hand afterwards.
    if [ "$n" -gt 0 ]; then
        changed "push is ON -- $n deploy key(s) exposed to every workspace"
    else
        info "push is already ON"
    fi
    log "  every workspace can push to the forks now, including any agent in one."
    log "  'wk push off' when you are done; 'wk claude' turns it off by itself."
    # The switch is one of two things a push needs; whether GitHub has this
    # machine's key, it can't see, so this names the command rather than
    # pretending to know.
    log "  a push also needs this machine's key registered:  wk key check"
    ;;

off)
    move_keys "$LIVE" "$HELD"; n="$MOVED"
    purge_copies
    if [ "$n" -gt 0 ]; then
        changed "push is OFF -- $n deploy key(s) held in $HELD"
    else
        info "push is already OFF"
    fi
    log "  workspaces keep their remotes and can fetch; a push is refused at the door."
    ;;

status)
    live=0; held=0; absent=0
    for r in $(forks); do
        case "$(where "$r")" in
            live)   live=$((live + 1));   printf '%-10s %s\n' "$r" "push allowed" ;;
            held)   held=$((held + 1));   printf '%-10s %s\n' "$r" "held back ($HELD)" ;;
            absent) absent=$((absent + 1)); printf '%-10s %s\n' "$r" "no key ('wk key register')" ;;
        esac
    done

    # Anything else with a private half in there is a push credential too, and
    # this is the one place that would notice it.
    other=$(private_keys_in "$LIVE" | while read -r f; do
                b=$(basename "$f"); keep=""
                for r in $(forks); do [ "$b" = "build_key_$r" ] && keep=1; done
                [ -n "$keep" ] || printf '%s\n' "$b"
            done)
    if [ -n "$other" ]; then
        warn "other private key(s) exposed to every workspace: $(printf '%s' "$other" | tr '\n' ' ')"
        log  "  'wk push off' holds these back too"
    fi

    c=$(copies | wc -l | tr -d ' ')
    if [ "$c" -gt 0 ]; then
        warn "$c workspace(s) hold their own copy of a key, which this switch cannot reach"
        log  "  'wk push off' removes them (the key itself lives in the store)"
    fi

    if [ "$live" -gt 0 ]; then
        info "push is ON"
        exit 0
    fi
    if [ "$held" -gt 0 ]; then
        info "push is OFF -- 'wk push on' to allow it"
        exit 1
    fi
    warn "there are no deploy keys here at all -- 'wk key register' makes them"
    exit 4
    ;;

*)
    die "usage: wk push on|off|status; see wk push -h"
    ;;
esac
