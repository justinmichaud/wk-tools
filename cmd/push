#!/usr/bin/env python3
#
# wk push on|off|status -- whether a workspace can push to git at all
# wk: where=local name=none group=sources takes=1 verbs=on,off,status default=status dryrun on,off
# wk: sub on,off,status opts=--target=,--all
# wk: readonly status
# wk: destructive on
#
# The rule this implements: only the person at the
# keyboard pushes. An agent in a workspace must not be able to publish anything,
# while a shell in the same workspace, run by a human, should push normally.
#
# A switch over *credentials nothing in a workspace ever holds*: the private
# deploy keys sit in an ssh-agent outside the workspace, and the GitHub API token
# and the Bugzilla API key in the injector that terminates TLS for api.github.com
# and bugs.webkit.org. README.md has the mechanism.
#
#   on     the keys are in the agent and the token and the Bugzilla key are
#          where the injector reads them. `git push` and `git-webkit pr` work,
#          the bug included. A claude session running in any workspace would be
#          handed that push, so `on` asks once and ends every one of them --
#          `--force` keeps them and loads the keys anyway.
#   off    `ssh-add -D` empties the agent and both files are removed. ssh has
#          no identity to offer, and the injector refuses a write with a 412
#          naming this switch. Nothing in a workspace can undo any of it.
#
# There is no state file to disagree with reality: `status` asks the agent what it
# holds (`ssh-add -l`) and the machine whether the credential files are there. A machine
# runs an agent per kind of workspace -- one in the podman machine the containers
# mount its socket from, and on macOS one here for the guests, which cannot see a
# unix socket across the hypervisor and reach it through a forward (lib/wk/guest.py).
# `on` and `off` switch every one of them or name the one they could not reach,
# and `status` says ON while any of them holds a key. All of it runs here
# (where=local). `wk ai claude` turns it off before handing over control.
#
#   --target <machine>   ask that fleet machine instead of this one, through
#                        its own wk. A build box holds no deploy key: `wk enter`
#                        forwards this machine's agent to a shell there, so it
#                        reports off, with no switch of its own
#   --all                ask everywhere: this machine and every other one
#                        (wk boot --list names them)
#   --force              `on` leaves a running claude session alone and loads the
#                        keys anyway; that session can push until it exits
#
#   0  push is on (status), or the action succeeded
#   1  push is off (status), or the action failed; a build box with no key at rest
#   3  a machine did not answer, so its position is unknown -- never "off"; in
#      the podman machine, `on`/`off` switched its half and not the host's guests'
#   4  there are no deploy keys on this machine at all
#   5  this machine has no switch: it holds no key, or one is live at rest

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images  # noqa: E402

ROOT = images.root()

from wk import decl, record, secrets, status, targets  # noqa: E402
from wk.act import Refused, die, warn  # noqa: E402
from wk.clock import Clock  # noqa: E402
from wk.pushswitch import UNASKED, Push  # noqa: E402


def parse(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    action = args.positionals[0]
    target_named = {"--all": "--all" if args.flag("--all") else None, "--target": args.value("--target")}
    target = ""
    for opt in args.order:
        named = target_named.get(opt)
        if named is not None:
            target = named
    return action, target


class FanOut:
    """Another machine's switch, asked of its own wk: the credentials never travel."""

    def __init__(self, reg, action, out):
        self.reg, self.action, self.out = reg, action, out
        self.unasked = []

    def row(self, name, text):
        for line in text.rstrip("\n").split("\n"):
            self.out.write("%-22s%s\n" % (name, line))

    def one(self, name):
        try:
            t = self.reg.load(name)
        except LookupError as e:
            die(str(e))
        side, why = t.probe()
        if side != "answering":
            # One that cannot be asked may be holding keys, so it is 3 and never 1, which `wk ai` reads as off.
            self.out.write("%-22s %s\n" % (name, status.far_side_reason(t, side, why)))
            self.unasked.append(name)
            return UNASKED
        rc, text = t.wk("push", self.action)
        self.row(name, text)
        return rc

    def here(self):
        r = self.reg.machine.run(["sh", "-c", '"$0" push "$1" 2>&1', os.path.join(ROOT, "wk"), self.action], input="")
        self.row(record.machine_name(self.reg.env, self.reg.machine), r.out)
        return r.rc

    def run(self, target):
        if target in ("--all",):
            rc = self.here()
            for m in self.reg.machines():
                rc = max(rc, self.one(m))
        else:
            rc = self.one(target)
        if self.unasked:
            warn("not asked: %s -- the keys there are wherever they were, which\n    is not 'off'. 'wk push %s --target <machine>' "
                 "once each one answers." % (" ".join(self.unasked), self.action))
            return UNASKED
        return rc


def main(argv, env=None, reg=None, clock=None, out=None):
    env = os.environ if env is None else env
    reg = reg or targets.Registry(ROOT, env)
    # Refused before the target loads: in a workspace the default is `local`, which names no switch.
    if reg.in_workspace():
        die("'wk push' throws the credential switch, and this is workspace '%s'.\n    The keys and the token are on the host and "
            "a workspace cannot reach either --\n    which is what makes the switch a switch. Run it on the host."
            % reg.workspace_name())
    action, target = parse(argv)
    if target:
        return FanOut(reg, action, out or sys.stdout).run(target)
    return Push(reg, secrets.Secrets(ROOT, env, reg.machine), clock or Clock(), out).run(action)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
