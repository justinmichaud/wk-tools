#!/usr/bin/env python3
#
# wk push on|off|status -- whether a workspace can push to git at all
# wk: where=local name=none group=sources takes=1 opts --target=,--all dryrun on,off
# wk: readonly status
# wk: destructive on
#
# The rule this implements: only the person at the
# keyboard pushes. An agent in a workspace must not be able to publish anything,
# while a shell in the same workspace, run by a human, should push normally.
#
# A switch over *credentials nothing in a workspace ever holds*: the private
# deploy keys sit in an ssh-agent outside the workspace, and the GitHub API token
# and the Bugzilla API key in the injector that terminates TLS for api.github.com
# and bugs.webkit.org. README.md has the mechanism.
#
#   on     the keys are in the agent and the token and the Bugzilla key are
#          where the injector reads them. `git push` and `git-webkit pr` work,
#          the bug included. A claude session running in any workspace would be
#          handed that push, so `on` asks once and ends every one of them --
#          `--force` keeps them and loads the keys anyway.
#   off    `ssh-add -D` empties the agent and both files are removed. ssh has
#          no identity to offer, and the injector refuses a write with a 412
#          naming this switch. Nothing in a workspace can undo any of it.
#
# There is no state file to disagree with reality: `status` asks the agent what it
# holds (`ssh-add -l`) and the machine whether the credential files are there. A machine
# runs an agent per kind of workspace -- one in the podman machine the containers
# mount its socket from, and on macOS one here for the guests, which cannot see a
# unix socket across the hypervisor and reach it through a forward (lib/wk/guest.py).
# `on` and `off` switch every one of them or name the one they could not reach,
# and `status` says ON while any of them holds a key. All of it runs here
# (where=local). `wk ai claude` turns it off before handing over control.
#
#   --target <machine>   ask that fleet machine instead of this one, through
#                        its own wk. A `remote` target names no ssh-agent
#                        socket, so it reports that there is no switch there
#   --all                ask everywhere: this machine and every other one
#                        (wk boot --list names them)
#   --force              `on` leaves a running claude session alone and loads the
#                        keys anyway; that session can push until it exits
#
#   0  push is on (status), or the action succeeded
#   1  push is off (status), or the action failed
#   3  a machine did not answer, so its position is unknown -- never "off"
#   4  there are no deploy keys on this machine at all
#   5  this machine has no switch: its keys are live wherever they sit

import os
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import act, decl, guest, record, secrets, status, targets  # noqa: E402
from wk.act import Refused, die, info, log, warn  # noqa: E402
from wk.clock import Clock  # noqa: E402

USAGE = "usage: wk push on|off|status; see wk push -h"
UNASKED, NO_KEYS, NO_SWITCH = 3, 4, 5

# The process is called `claude`, `node` or a version string, but its exe path resolves under the Claude install.
AGENT_PID_SCAN = '''for e in /proc/[0-9]*/exe; do
    case "$(readlink "$e" 2>/dev/null)" in
        */claude/versions/*|*/.local/bin/claude) p=${e#/proc/}; printf "%s\\n" "${p%/exe}" ;;
    esac
done'''


def parse(argv):
    args = decl.Args(decl.Decl(__file__), argv)
    action = "status"
    if args.positionals:
        if len(args.positionals) > 1 or args.positionals[0] not in ("on", "off", "status"):
            die(USAGE)
        action = args.positionals[0]
    target_named = {"--all": "--all" if args.flag("--all") else None, "--target": args.value("--target")}
    target = ""
    for opt in args.order:
        named = target_named.get(opt)
        if named is not None:
            target = named
    return action, target


def changed(msg):
    info(("dry run: " if act.dry_run() else "") + msg)


class FanOut:
    """Another machine's switch, asked of its own wk: the credentials never travel."""

    def __init__(self, reg, action, out):
        self.reg, self.action, self.out = reg, action, out
        self.unasked = []

    def row(self, name, text):
        for line in text.rstrip("\n").split("\n"):
            self.out.write("%-22s%s\n" % (name, line))

    def one(self, name):
        try:
            t = self.reg.load(name)
        except LookupError as e:
            die(str(e))
        side, why = t.probe()
        if side != "answering":
            # One that cannot be asked may be holding keys, so it is 3 and never 1, which `wk ai` reads as off.
            self.out.write("%-22s %s\n" % (name, status.far_side_reason(t, side, why)))
            self.unasked.append(name)
            return UNASKED
        rc, text = t.wk("push", self.action)
        self.row(name, text)
        return rc

    def here(self):
        r = self.reg.machine.run(["sh", "-c", '"$0" push "$1" 2>&1', os.path.join(ROOT, "wk"), self.action], input="")
        self.row(record.machine_name(self.reg.env, self.reg.machine), r.out)
        return r.rc

    def run(self, target):
        if target in ("--all",):
            rc = self.here()
            for m in self.reg.machines():
                rc = max(rc, self.one(m))
        else:
            rc = self.one(target)
        if self.unasked:
            warn("not asked: %s -- the keys there are wherever they were, which\n    is not 'off'. 'wk push %s --target <machine>' "
                 "once each one answers." % (" ".join(self.unasked), self.action))
            return UNASKED
        return rc


class Push:
    def __init__(self, reg, sec, clock, out=None):
        self.reg, self.sec, self.clock = reg, sec, clock
        self.out = out or sys.stdout
        self.target_name = reg.default()
        try:
            self.target = reg.load(self.target_name)
        except LookupError:
            self.target = None
        self.ws_sock = self.target.agent_sock() if self.target else None
        self.sock, self.pat, self.bz = sec.machine_sock(), sec.machine_pat(), sec.machine_bugzilla_key()
        self.guest_live = False

    def say(self, what, text):
        self.out.write("%-10s %s\n" % (what, text))

    def run(self, action):
        rc = getattr(self, "switch_" + action)()
        if action != "status":
            rc = max(rc, self.converge_guests(action))
        return rc

    # -- the claude sessions `on` would hand a push

    def agent_pids(self, ws):
        return self.target.exec(ws, ["sh", "-c", AGENT_PID_SCAN]).out.replace("\r", "").split()

    def agent_sessions(self):
        return [ws for ws, _ in self.target.list() if ws and self.agent_pids(ws)]

    def wait_gone(self, ws, limit):
        waited = 0
        while waited < limit and self.agent_pids(ws):
            self.clock.sleep(1)
            waited += 1
        return waited

    def end_agent_sessions(self, sessions):
        """False when one outlived the KILL."""
        ok = True
        for ws in sessions:
            pids = self.agent_pids(ws)
            if not pids:
                continue
            info("ending the claude session(s) in '%s' (pid %s)" % (ws, " ".join(pids)))
            self.target.act_exec(ws, ["sh", "-c", "kill %s 2>/dev/null; exit 0" % " ".join(pids)])
            if act.dry_run():
                continue
            waited = self.wait_gone(ws, int(self.reg.env.get("WK_KILL_WAIT") or 15))
            pids = self.agent_pids(ws)
            if not pids:
                continue
            warn("pid %s did not stop on TERM after %ds -- killing" % (" ".join(pids), waited))
            self.target.act_exec(ws, ["sh", "-c", "kill -KILL %s 2>/dev/null; exit 0" % " ".join(pids)])
            self.wait_gone(ws, 5)
            ok = ok and not self.agent_pids(ws)
        return ok

    def end_sessions_first(self, sessions):
        if sessions and os.environ.get("WK_FORCE"):
            act.barrier("a claude session is running in %s -- loading the deploy keys hands it a\n    working push for as long "
                        "as it runs, and its commit wall stays until it exits." % " ".join(sessions))
        elif sessions:
            warn("a claude session is running in %s -- loading the keys\n    would hand it a working push, and its commit wall "
                 "stays until it exits, so\n    it is ended first. Whatever it has not written down cannot be undone." % " ".join(sessions))
            if not act.confirm("end the claude session(s) in %s?" % " ".join(sessions)):
                die("push stays off -- nothing was loaded and no session was touched")
            if not self.end_agent_sessions(sessions):
                die("a claude session outlived a KILL, so the keys stay out of the agent.\n    Find it:  wk enter <workspace>")
            return
        # Ending a session is `on`'s one destructive effect, and past this gate none is left to end.
        act.nothing_to_ask()

    def require_agent_target(self):
        if self.ws_sock:
            return
        warn("'%s' workspaces name no ssh-agent socket (t_agent_sock), so the\n    deploy keys have nowhere to live outside one and "
             "there is no switch here.\n    Giving this target one -- wk-ssh-agent.service, the way host/linux/sdk.sh\n    installs it "
             "-- is owed (docs/PLAN.md). Until then, push\n    from the workstation that holds the keys." % self.target_name)
        raise Refused(NO_SWITCH)

    # -- the switch

    def switch_on(self):
        sec = self.sec
        self.require_agent_target()
        self.end_sessions_first(self.agent_sessions())
        if not sec.agent_answers(self.sock):
            warn("no ssh-agent answers at %s on the machine that runs the\n    workspaces, so there is nothing to load the deploy "
                 "keys into" % self.sock)
            log("  ./setup installs and starts wk-ssh-agent.service there")
            return 1
        # Before the keys, since `wk key deploy` may have minted public halves since the store was made.
        sec.publish()
        rows = [state for _, state in sec.agent_load(self.sock)]
        if rows.count("FAILED"):
            warn("%d deploy key(s) would not load into the agent, so push is not fully on" % rows.count("FAILED"))
            log("  the agent is at %s; 'wk push on' again once it answers" % self.sock)
            return 1
        if not rows.count("loaded"):
            warn("no deploy key here to load -- 'wk key deploy' makes them")
            return NO_KEYS
        changed("push is ON -- %d deploy key(s) in the agent outside every workspace" % rows.count("loaded"))
        if rows.count("no-key"):
            log("  %d fork(s) have no key here ('wk key deploy')" % rows.count("no-key"))
        log("  every workspace can push to the forks now, including any agent in one.")
        log("  'wk push off' when you are done; 'wk ai claude' turns it off by itself.")
        if sec.cred_write(self.pat, "github-pat"):
            changed("the GitHub API token is where the injector reads it (%s)" % sec.github_user())
            log("  'git-webkit pr' in a workspace posts as that account; the token stays here")
        else:
            sec.cred_clear(self.pat)
            warn("there is no GitHub API token here, so 'git-webkit pr' in a workspace gets 401")
            log("  'wk key set github-pat' stores one (repo scope; it never enters a workspace)")
        if sec.cred_write(self.bz, "bugzilla-api-key"):
            changed("the Bugzilla API key is where the injector reads it (%s)" % (sec.bugzilla_user() or "no login in the mirror"))
            log("  'git-webkit pr' in a workspace files and updates the bug as that login; the key stays here")
        else:
            sec.cred_clear(self.bz)
            warn("there is no Bugzilla API key here, so 'git-webkit pr' in a workspace cannot file or update a bug")
            log("  'wk key set bugzilla-api-key' stores one (it never enters a workspace)")
        log("  a push also needs this machine's key registered:  wk key check")
        return 0

    def switch_off(self):
        sec = self.sec
        self.require_agent_target()
        sec.agent_clear(self.sock)
        sec.cred_clear(self.pat)
        sec.cred_clear(self.bz)
        # It names public halves and a socket, not a credential, and an unresolvable `github-webkit` fails with a hostname error.
        sec.publish()
        if act.dry_run():
            changed("push is OFF -- nothing was cleared, so nothing is read back")
            return 0
        # Evidence, not the exit status of the clear: an agent that ignored `ssh-add -D` is one a workspace can still push with.
        left = sec.agent_list(self.sock)
        if left:
            warn("the agent at %s still holds %d identity/identities" % (self.sock, len(left)))
            log("  push is NOT off; 'wk push off' again, or restart wk-ssh-agent.service there")
            return 1
        for path, what in ((self.pat, "GitHub API token"), (self.bz, "Bugzilla API key")):
            if sec.cred_present(path):
                warn("the %s is still at %s on that machine" % (what, path))
                log("  push is NOT off; 'wk push off' again")
                return 1
        changed("push is OFF -- the agent is empty and the injector has no token and no Bugzilla key")
        log("  workspaces keep their remotes and can fetch; a push and an API call are")
        log("  both refused at the door. The keys never left %s." % sec.held_dir())
        return 0

    def where(self, fork, in_agent):
        """loaded | held | live | absent; `live` is a key on a machine with no agent socket (remote/provision.sh)."""
        pub = self.sec.pub_path(fork)
        if self.sec.machine.exists(pub):
            fp = self.sec.machine.run(["ssh-keygen", "-lf", pub], input="").out.split()
            if len(fp) > 1 and fp[1] in in_agent:
                return "loaded"
        if self.sec.machine.exists(self.sec.push_key_path(fork)):
            return "held" if self.ws_sock else "live"
        return "absent"

    def exposed_private_keys(self):
        d = self.sec.secrets_dir()
        m = self.sec.machine
        names = m.listdir(d) if m.isdir(d) else []
        return [f for f in names if f.startswith("build_key") and not f.endswith(".pub") and not m.isdir(os.path.join(d, f))]

    def switch_status(self):
        sec = self.sec
        held_dir = sec.held_dir()
        in_agent = {line.split()[1] for line in sec.agent_list(self.sock) if len(line.split()) > 1}
        words = {"loaded": "push allowed (in the agent)", "held": "held back (%s)" % held_dir,
                 "live": "always live (%s) -- no switch on this machine" % held_dir, "absent": "no key ('wk key deploy')"}
        count = {w: 0 for w in words}
        for fork in [f[0] for f in sec.forks()]:
            w = self.where(fork, in_agent)
            count[w] += 1
            self.say(fork, words[w])

        cred_live = False
        for what, path, name, allowed, held_path in (
                ("api", self.pat, "github-pat", "'git-webkit pr' allowed (token at %s)", sec.github_pat_path()),
                ("bugzilla", self.bz, "bugzilla-api-key", "'git-webkit pr' can file the bug (key at %s)", sec.bugzilla_key_path())):
            if sec.cred_present(path):
                cred_live = True
                self.say(what, allowed % path)
            elif secrets.first_line(sec.cred_read(name)):
                self.say(what, "held back (%s)" % held_path)
            else:
                self.say(what, "no %s ('wk key set %s')" % ("token" if name == "github-pat" else "key", name))

        exposed = self.exposed_private_keys()
        if exposed:
            warn("private key(s) in the mounted secrets directory, readable by every workspace:\n    %s" % " ".join(exposed))
            log("  move them to %s, which nothing mounts anywhere" % held_dir)

        if not self.ws_sock:
            warn("'%s' workspaces name no ssh-agent socket, so there is no switch\n    on this machine: a checkout here is a plain one "
                 "with no container around it\n    and its core.sshCommand names the private half directly\n    (remote/provision.sh). "
                 "The key above is live whatever the switch says\n    anywhere else, and 'wk push on|off' here refuses rather than "
                 "pretending.\n    Installing wk-ssh-agent.service here is owed (docs/PLAN.md)." % self.target_name)
        elif (count["held"] or count["loaded"]) and not sec.agent_answers(self.sock):
            log("  no ssh-agent answers at %s ('./setup' installs it there)" % self.sock)

        self.guest_agent_row()
        self.guest_rows()

        if count["live"]:
            info("push is ON here and cannot be switched off -- %d key(s) are live" % count["live"])
            return 0
        if count["loaded"] or self.guest_live:
            info("push is ON")
            return 0
        # The injector's write token and Bugzilla key are credentials an agent could spend on a comment or a bug.
        if cred_live:
            info("push is ON -- no deploy key is loaded, but the injector has a write credential")
            return 0
        if count["held"]:
            info("push is OFF -- 'wk push on' to allow it")
            return 1
        warn("there are no deploy keys here at all -- 'wk key deploy' makes them")
        return NO_KEYS

    # -- a macOS host's guests: an ssh-agent here and an `ssh -N -R` per guest (lib/wk/guest.py)

    def converge_guests(self, action):
        if not self.sec.macos or guest.vm_push_keys_converge(ROOT, self.sec.machine, action):
            return 0
        warn("the guest(s) named above were not converged and may still reach the agent;\n    'wk push %s' again once each one "
             "answers" % action)
        return 1

    def guest_agent_row(self):
        """A key in the guests' agent is a push from every guest holding a forward, whether or not one is up now."""
        n = guest.vm_push_agent_keys(ROOT, self.sec.machine) if self.sec.macos else None
        if n is None:
            return
        self.guest_live = self.guest_live or n > 0
        self.say("guests", "%d key(s) in the agent this host runs for them" % n if n else "the agent this host runs for them holds nothing")

    def guest_rows(self):
        for g, state, forks in guest.vm_push_keys_state(ROOT, self.sec.machine) if self.sec.macos else []:
            if state != "running":
                self.out.write("guest %-10s %s\n" % (g, "%s -- not read; 'wk vm start %s' converges it" % (state, g)))
            elif forks:
                self.guest_live = True
                self.out.write("guest %-10s %s\n" % (g, forks))
            else:
                self.out.write("guest %-10s %s\n" % (g, "no agent socket -- a push from in there is refused"))


def main(argv, env=None, reg=None, clock=None, out=None):
    env = os.environ if env is None else env
    reg = reg or targets.Registry(ROOT, env)
    # Refused before the target loads: in a workspace the default is `local`, which names no switch.
    if reg.in_workspace():
        die("'wk push' throws the credential switch, and this is workspace '%s'.\n    The keys and the token are on the host and "
            "a workspace cannot reach either --\n    which is what makes the switch a switch. Run it on the host."
            % targets.read_conf(reg.marker_path()).get("name", ""))
    action, target = parse(argv)
    if target:
        return FanOut(reg, action, out or sys.stdout).run(target)
    return Push(reg, secrets.Secrets(ROOT, env, reg.machine), clock or Clock(), out).run(action)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
