#!/usr/bin/env bash
#
# wk push on|off|status -- whether a workspace can push to git at all
# wk: where=store name=none group=sources
# wk: readonly status
# wk: sub on,off,status where=local
# wk: flag --all,--target where=local
# wk: flag --store where=store
#
# The rule this implements, from docs/HANDOFF-sandboxing.md: only the person at
# the keyboard pushes. An agent in a workspace must not be able to publish
# anything -- the failures that produced this were Claude pushing over work and
# replying to reviewers on GitHub -- while a shell in the same workspace, run by
# a human who asked for it, should push perfectly normally.
#
# So it is a switch, and the switch is *where the key is*, not a flag anything
# reads:
#
#   on    the private deploy keys are in the store's secrets directory, which
#         every workspace has mounted read-only at /secrets and links to from
#         ~/.ssh. Push works.
#   off   they are in $WK_STORE/push-keys, which nothing mounts anywhere. The
#         links in every workspace dangle, ssh has no identity to offer, and a
#         push is refused by GitHub. Nothing in a workspace can undo this: the
#         only copy is on the far side of a read-only mount, on a filesystem a
#         container cannot see.
#
# That is the whole design. There is no state file to disagree with reality,
# nothing to restore after a crash, and `status` is a directory listing rather
# than a claim -- the same rule the rest of the workspace state follows
# (README.md).
#
# A macOS guest mounts nothing of ours, so for a guest "where the key is" means
# the copy in it (targets/vm.sh writes one on every start). That makes the
# switch two halves on two machines:
#
#   the store    the keys move. On a macOS workstation the store is inside the
#                podman machine, so this half is handed back to the dispatcher
#                with `--store` and forwarded there -- `wk`'s own forward, the
#                only one there is.
#   the guests   every running guest is converged, here, after the keys have
#                moved. This host is the machine that drives its guests; inside
#                the podman machine there are none.
#
# Which is why `on`/`off`/`status` are declared where=local and `--store`
# where=store. A container needs no second half: it reads the keys live
# through the read-only mount, so moving them is the whole of it.
#
# `wk ai claude` turns it off before handing over control, which is the case the
# switch exists for; see the note there about when it turns it back on.
#
#   --target <machine>   throw the switch on that fleet machine's own store
#                        instead of this one's (a build machine keeps its own
#                        key under its own wk root)
#   --all                throw it everywhere: this machine and every other one
#                        (wk boot --list names them); a machine that does not
#                        answer is skipped, not fatal
#   --store              move the keys and nothing else -- the half that has to
#                        run on the machine holding them. This is the hop the
#                        two lines above and a plain `wk push on` make into the
#                        podman machine; it is not a second way to throw the
#                        switch, since it leaves this host's guests alone.
#
#   0  push is on (status), or the action succeeded
#   1  push is off (status), or the action failed
#   4  there are no deploy keys on this machine at all

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# Refused inside a workspace, but *not* on a build machine: the switch acts
# on the machine that holds the key, and on a shared box that is the box.
#
# Before load_target, and that order is load-bearing: `on`/`off`/`status` are
# declared where=local (this host drives its own guests), so the dispatcher no
# longer refuses them and this is the whole of the rule -- while
# `default_target` in a workspace is `local`, a target with no store, whose
# load would exit before the refusal was ever printed.
in_workspace && die "'wk push' moves the deploy keys, and this is workspace '$(wk_self)'.
    The keys are on the host and a workspace cannot reach them -- which is what
    makes the switch a switch. Run it on the host."

# $WK_STORE is target-dependent: /var/lib/wk in the podman VM, the remote
# root on a build machine. Loading the target this machine *is* puts the
# keys where this machine actually keeps them.
load_target "$(default_target)" 2>/dev/null || true

ACTION=status
TARGET=""
STORE_ONLY=""
while [ $# -gt 0 ]; do
    case "$1" in
        on|off|status) ACTION="$1"; shift ;;
        --target) TARGET="${2:-}"; [ -n "$TARGET" ] || die "--target needs a name"; shift 2 ;;
        --all) TARGET=--all; shift ;;
        --store) STORE_ONLY=1; shift ;;
        *) die "usage: wk push on|off|status; see wk push -h" ;;
    esac
done

# A build machine keeps its own key under its own wk root, so the switch has
# to be thrown *there*: the machine answers for itself by running this same
# file, exactly as `wk sudo` does. The fan-out runs on the workstation and
# nowhere else -- it needs the target confs and the ssh reach to the fleet --
# which is what the `flag --all,--target where=local` declaration says.
if [ -n "$TARGET" ]; then
    _row() { sed "s/^/$(printf '%-22s' "$1")/"; }

    _one() {
        local t="$1" rc=0 out
        load_target "$t"
        machine_answers "$t" || return 1
        out=$(t_wk push "$ACTION" 2>&1) || rc=$?
        printf '%s\n' "$out" | _row "$t"
        return "$rc"
    }

    # This machine holds a store too, and for_each_machine walks only the
    # others -- so `--all` asks this one through its own `wk`, which is the
    # hop that reaches the podman VM on a macOS workstation.
    _here() {
        local rc=0 out
        out=$("$WK_ROOT/wk" push "$ACTION" 2>&1) || rc=$?
        printf '%s\n' "$out" | _row "$(wk_machine_name)"
        return "$rc"
    }

    if [ "$TARGET" = --all ]; then
        rc=0; _here || rc=$?
        fan=0; for_each_machine _one || fan=$?
        [ "$fan" -gt "$rc" ] && rc="$fan"
        exit "$rc"
    fi
    _one "$TARGET"
    exit $?
fi

# Where the keys go when push is off. Deliberately not under secrets/: that
# directory is bind-mounted into every workspace, so a subdirectory of it would
# be just as reachable as the keys were.
HELD="$WK_STORE/push-keys"
LIVE="$WK_STORE/secrets"

forks() { wk_push_forks | awk 'NF {print $1}'; }

# The evidence, per fork: live | held | absent. A key that is somehow in both
# places is reported as `live`, because that is what a workspace would use --
# and `wk push off` then moves it and the duplicate is gone.
where() {
    local r="$1"
    [ -f "$LIVE/build_key_$r" ] && { echo live; return 0; }
    [ -f "$HELD/build_key_$r" ] && { echo held; return 0; }
    echo absent
}

# Copies of a key inside a workspace's own home (from firstrun `install`ing
# it rather than linking it) are keys this switch cannot reach, so they are
# removed rather than reported. A symlink is the current arrangement and is
# left alone.
copies() {
    local d f r
    [ -d "$WK_STORE/ws" ] || return 0
    for d in "$WK_STORE"/ws/*/; do
        [ -d "$d" ] || continue
        for r in $(forks); do
            f="$d/home/.ssh/id_$r"
            [ -f "$f" ] && [ ! -L "$f" ] && printf '%s\n' "$f"
        done
    done
    return 0
}

purge_copies() {
    local f n=0
    while read -r f; do
        [ -n "$f" ] || continue
        if rm -f "$f" 2>/dev/null; then
            n=$((n + 1))
        else
            warn "could not remove a copy of a deploy key: $f"
        fi
    done <<EOF
$(copies)
EOF
    [ "$n" -eq 0 ] || info "removed $n key copy/copies left in workspace homes"
}

# Every private key in the directory, not only the ones wk_push_forks
# names: an old or hand-added key here is exactly as usable as one it knows
# about. Public halves stay -- `wk key check`/`show` need them while off.
private_keys_in() {
    local d="$1" f
    [ -d "$d" ] || return 0
    for f in "$d"/build_key*; do
        [ -f "$f" ] || continue
        case "$f" in *.pub) continue ;; esac
        printf '%s\n' "$f"
    done
}

# The count comes back in MOVED rather than on stdout. Neither errexit nor a
# `die` crosses a command substitution -- it is a subshell, and the assignment
# takes its status -- so a store this machine could not even create still
# reported "push is already OFF" about keys nothing had looked for.
#
# STUCK counts the keys that did not move. A key still in the `on` position
# after `wk push off` is the switch not having been thrown, so it is a failing
# status and not a warning in passing.
MOVED=0
STUCK=0
move_keys() {
    local from="$1" to="$2" f b
    MOVED=0
    STUCK=0
    ensure_dir "$to" 0700 >/dev/null
    while read -r f; do
        [ -n "$f" ] || continue
        b=$(basename "$f")
        mv "$f" "$to/$b" || { warn "could not move $b out of $from"; STUCK=$((STUCK + 1)); continue; }
        chmod 0600 "$to/$b"
        # The public half goes with it: ssh will offer a public key it finds
        # beside IdentityFile even without the private half.
        [ -f "$from/$b.pub" ] && { mv "$from/$b.pub" "$to/$b.pub" || warn "could not move $b.pub out of $from"; }
        MOVED=$((MOVED + 1))
    done <<EOF
$(private_keys_in "$from")
EOF
    [ "$STUCK" -eq 0 ]
}

# The workspaces here in which a claude process is running -- asked of the
# machine, not of a record: a session started by hand from `wk enter` counts
# the same as one `wk ai claude` started. Exposing the keys while one runs would
# put them in that session's mount, so `on` is refused until it ends.
# A running agent is one whose executable resolves under the Claude install
# (`~/.local/share/claude/versions/...`, firstrun.sh), read from /proc inside
# the workspace -- evidence, not a name match: the process is called `claude`,
# `node` or a version string depending on how it was launched, but its exe
# path is not. Scoped to inside the container, so `cmd/ai` on the host and
# a human's `git` never register.
agent_sessions() {
    local ws
    while IFS=$(printf '\t') read -r ws _; do
        [ -n "$ws" ] || continue
        t_exec "$ws" sh -c '
            for e in /proc/[0-9]*/exe; do
                case "$(readlink "$e" 2>/dev/null)" in
                    */claude/versions/*|*/.local/bin/claude) exit 0 ;;
                esac
            done
            exit 1' >/dev/null 2>&1 && printf '%s\n' "$ws"
    done <<EOF
$(t_list 2>/dev/null)
EOF
    return 0
}

# The store half: the keys move where they live. On a macOS workstation that is
# inside the podman machine, so this hands the same command back to the
# dispatcher with `--store` and lets it forward -- one forward in the tree, and
# the readonly declaration keeps `status` from starting the machine to read it.
store_half() {
    if [ -n "$STORE_ONLY" ] && ! store_is_local; then
        die "'wk push --store' moves the keys where they are, and this machine's store
    ($WK_STORE) cannot be read from here. Without --store, 'wk push $ACTION'
    reaches into the machine that holds it."
    fi
    if [ -z "$STORE_ONLY" ] && ! store_is_local; then
        info "the deploy keys live in the podman machine's store, so this reaches into it"
        log  "  it is started if it is stopped; 'wk push status' reads without starting it"
        local rc=0
        "$WK_ROOT/wk" push "$ACTION" --store || rc=$?
        return "$rc"
    fi

    case "$ACTION" in
on)
    busy=$(agent_sessions)
    if [ -n "$busy" ]; then
        barrier "an agent session (a claude process) is running in $(printf '%s' "$busy" | tr '\n' ' ')-- exposing
    the keys puts them in its mount, and its commit wall stays until it exits.
    End that session first, or force this."
    fi
    moved_ok=0; move_keys "$HELD" "$LIVE" || moved_ok=1; n="$MOVED"
    if [ "$moved_ok" -ne 0 ]; then
        warn "$STUCK deploy key(s) did not move out of $HELD, so push is not fully on"
        log  "  check the permissions on $HELD and $LIVE, then 'wk push on' again"
        return 1
    fi
    # Idempotent, and it says which of the two it was: a switch that reports
    # "on" whether or not it did anything is a switch you have to verify by
    # hand afterwards.
    if [ "$n" -gt 0 ]; then
        changed "push is ON -- $n deploy key(s) exposed to every workspace"
    else
        info "push is already ON"
    fi
    log "  every workspace can push to the forks now, including any agent in one."
    log "  'wk push off' when you are done; 'wk ai claude' turns it off by itself."
    # The switch is one of two things a push needs; whether GitHub has this
    # machine's key, it can't see, so this names the command rather than
    # pretending to know.
    log "  a push also needs this machine's key registered:  wk key check"
    ;;

off)
    moved_ok=0; move_keys "$LIVE" "$HELD" || moved_ok=1; n="$MOVED"
    purge_copies
    if [ "$moved_ok" -ne 0 ]; then
        warn "$STUCK deploy key(s) are still in $LIVE, exposed to every workspace"
        log  "  push is NOT off; check the permissions on $LIVE and $HELD, then 'wk push off' again"
        return 1
    fi
    if [ "$n" -gt 0 ]; then
        changed "push is OFF -- $n deploy key(s) held in $HELD"
    else
        info "push is already OFF"
    fi
    log "  workspaces keep their remotes and can fetch; a push is refused at the door."
    ;;

status)
    live=0; held=0; absent=0
    for r in $(forks); do
        case "$(where "$r")" in
            live)   live=$((live + 1));   printf '%-10s %s\n' "$r" "push allowed" ;;
            held)   held=$((held + 1));   printf '%-10s %s\n' "$r" "held back ($HELD)" ;;
            absent) absent=$((absent + 1)); printf '%-10s %s\n' "$r" "no key ('wk key register')" ;;
        esac
    done

    # Anything else with a private half in there is a push credential too, and
    # this is the one place that would notice it.
    other=$(private_keys_in "$LIVE" | while read -r f; do
                b=$(basename "$f"); keep=""
                for r in $(forks); do [ "$b" = "build_key_$r" ] && keep=1; done
                [ -n "$keep" ] || printf '%s\n' "$b"
            done)
    if [ -n "$other" ]; then
        warn "other private key(s) exposed to every workspace: $(printf '%s' "$other" | tr '\n' ' ')"
        log  "  'wk push off' holds these back too"
    fi

    c=$(copies | wc -l | tr -d ' ')
    if [ "$c" -gt 0 ]; then
        warn "$c workspace(s) hold their own copy of a key, which this switch cannot reach"
        log  "  'wk push off' removes them (the key itself lives in the store)"
    fi

    if [ "$live" -gt 0 ]; then
        info "push is ON"
        return 0
    fi
    if [ "$held" -gt 0 ]; then
        info "push is OFF -- 'wk push on' to allow it"
        return 1
    fi
    warn "there are no deploy keys here at all -- 'wk key register' makes them"
    return 4
    ;;

*)
    die "usage: wk push on|off|status; see wk push -h"
    ;;
    esac
}

# --- the guests on this host -------------------------------------------------
# A container reads the keys live through its read-only mount, so the store
# half above is the whole switch for one. A macOS guest mounts nothing of ours
# and holds a copy (targets/vm.sh's _write_deploy_keys), so the switch is
# thrown in the guest too -- and only this host can do that: `tart` is macOS
# only, and inside the podman machine, where the store half runs, there are no
# guests at all.
#
# The driver goes in a subshell because it points $WK_STORE at its own state
# directory, which nothing after this may inherit.
_in_vm_driver() { # <function to call in the vm driver>
    is_macos || return 0
    ( load_target vm >/dev/null 2>&1 && "$1" )
}

# The guest half's own status, folded into this command's at the end. A guest
# whose ssh failed during `wk push off` has moved keys in the store and an
# unchanged copy in the guest -- exit 0 there is the report cmd/ai's
# `push_switch status || return 0` reads as a closed switch.
GUEST_RC=0
GUEST_LIVE=0

converge_guests() {
    _in_vm_driver vm_push_keys_converge && return 0
    GUEST_RC=1
    warn "the guest(s) named above were not converged and may still hold a deploy key;
    'wk push $ACTION' again once each one answers"
}

# One row per guest, from the guest. A stopped guest cannot be read and is not
# started to find out: it is converged by `wk vm start` before anything in it
# can run, which is what the row says.
guest_rows() {
    local rows g state forks
    rows=$(_in_vm_driver vm_push_keys_state) || return 0
    [ -n "$rows" ] || return 0
    while IFS="$(printf '\t')" read -r g state forks; do
        [ -n "$g" ] || continue
        if [ "$state" != running ]; then
            printf 'guest %-10s %s\n' "$g" "$state -- not read; 'wk vm start $g' converges it"
        elif [ -n "$forks" ]; then
            GUEST_LIVE=1
            printf 'guest %-10s %s\n' "$g" "holds $forks"
        else
            printf 'guest %-10s %s\n' "$g" "no key -- a push from in there is refused"
        fi
    done <<EOF
$rows
EOF
}

STORE_RC=0
store_half || STORE_RC=$?

# `--store` is the store half by name, so it stops here: the guests belong to
# the host that made this hop, not to the machine holding the keys.
[ -z "$STORE_ONLY" ] || exit "$STORE_RC"

case "$ACTION" in
    on|off) converge_guests ;;
    status) guest_rows ;;
esac

# The switch is ON when *anything* can push, and a running guest holding its
# own copy can -- whatever the store says. Reporting the store's half as the
# whole is what would hand an agent a guest that can still push.
if [ "$ACTION" = status ] && [ "$GUEST_LIVE" -eq 1 ] && [ "$STORE_RC" -ne 0 ]; then
    info "push is ON -- a running guest above still holds a key ('wk push off')"
    STORE_RC=0
fi

# A bare `wk push` names no subverb, so the `sub` declaration above does not
# apply to it and where=store does: it is answered on the machine holding the
# keys, which on a macOS workstation is the podman machine -- where there are no
# guests to see. Say so rather than reporting half the switch as the whole of it.
[ -z "${WK_IN_VM:-}" ] \
    || log "  the host's macOS guests are not reachable from in here; 'wk push $ACTION' on the host reaches them"

# Both halves, so a guest that did not answer is a failure and not a warning
# in passing.
if [ "$GUEST_RC" -gt "$STORE_RC" ]; then
    exit "$GUEST_RC"
fi
exit "$STORE_RC"
