#!/usr/bin/env bash
#
# wk push on|off|status -- whether a workspace can push to git at all
# wk: where=local name=none group=sources
# wk: readonly status
#
# The rule this implements (docs/HANDOFF-sandboxing.md): only the person at the
# keyboard pushes. An agent in a workspace must not be able to publish anything,
# while a shell in the same workspace, run by a human, should push normally.
#
# A switch over *credentials nothing in a workspace ever holds*: the private
# deploy keys sit in an ssh-agent outside the workspace, and the GitHub API token
# in the injector that terminates TLS for api.github.com. README.md has the
# mechanism.
#
#   on     the keys are in the agent and the token is where the injector reads
#          it. `git push` and `git-webkit pr` work.
#   off    `ssh-add -D` empties the agent and the token file is removed. ssh has
#          no identity to offer and the injector answers 401. Nothing in a
#          workspace can undo either.
#
# There is no state file to disagree with reality: `status` asks the agent what it
# holds (`ssh-add -l`) and the machine whether the token file is there. Both
# halves run here (where=local): a macOS guest cannot see a unix socket across the
# hypervisor, so its ssh half is a forward this host holds open while push is on
# (targets/vm.sh). `wk ai claude` turns it off before handing over control.
#
#   --target <machine>   ask that fleet machine instead of this one, through
#                        its own wk. A `remote` target names no ssh-agent
#                        socket, so it reports that there is no switch there
#   --all                ask everywhere: this machine and every other one
#                        (wk boot --list names them); a machine that does not
#                        answer is skipped, not fatal
#
#   0  push is on (status), or the action succeeded
#   1  push is off (status), or the action failed
#   4  there are no deploy keys on this machine at all

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

# Refused inside a workspace, not on a build machine: the switch acts where the credentials are. Before load_target, or `default_target` (`local` in a workspace) would exit before the refusal printed.
in_workspace && die "'wk push' throws the credential switch, and this is workspace '$(wk_self)'.
    The keys and the token are on the host and a workspace cannot reach either --
    which is what makes the switch a switch. Run it on the host."

load_target "$(default_target)" 2>/dev/null || true

ACTION=status
TARGET=""
while [ $# -gt 0 ]; do
    case "$1" in
        on|off|status) ACTION="$1"; shift ;;
        --target) TARGET="${2:-}"; [ -n "$TARGET" ] || die "--target needs a name"; shift 2 ;;
        --all) TARGET=--all; shift ;;
        *) die "usage: wk push on|off|status; see wk push -h" ;;
    esac
done

# Each machine answers for itself, by running this same file over there -- the credentials never travel.
if [ -n "$TARGET" ]; then
    _row() { sed "s/^/$(printf '%-22s' "$1")/"; }

    _one() {
        local t="$1" rc=0 out
        load_target "$t"
        machine_answers "$t" || return 1
        out=$(t_wk push "$ACTION" 2>&1) || rc=$?
        printf '%s\n' "$out" | _row "$t"
        return "$rc"
    }

    _here() {
        local rc=0 out
        out=$("$WK_ROOT/wk" push "$ACTION" 2>&1) || rc=$?
        printf '%s\n' "$out" | _row "$(wk_machine_name)"
        return "$rc"
    }

    if [ "$TARGET" = --all ]; then
        rc=0; _here || rc=$?
        fan=0; for_each_machine _one || fan=$?
        [ "$fan" -gt "$rc" ] && rc="$fan"
        exit "$rc"
    fi
    _one "$TARGET"
    exit $?
fi

# Nothing moves between the two: HELD holds every private half and the API token and is mounted nowhere; LIVE is the mounted one, with the public halves.
HELD="$(wk_push_held_dir)"
LIVE="$(wk_secrets_dir)"

# push_agent_* expands these on the machine holding the workspaces, because /run/user/501 is not on a Mac.
WS_SOCK=$(t_agent_sock 2>/dev/null) || WS_SOCK=""
MACHINE_SOCK="$(push_agent_machine_sock)"
MACHINE_PAT="$(push_agent_machine_pat)"

forks() { wk_push_forks | awk 'NF {print $1}'; }

AGENT_KEYS="$(push_agent_list push_agent_exec "$MACHINE_SOCK")"

# Matched by the public half's own fingerprint: `ssh-add -l` prints a fingerprint and a comment, never a name this switch chose.
agent_holds() { # <fork>
    local fp
    [ -f "$LIVE/build_key_$1.pub" ] || return 1
    fp=$(ssh-keygen -lf "$LIVE/build_key_$1.pub" 2>/dev/null | awk '{print $2}')
    [ -n "$fp" ] || return 1
    printf '%s\n' "$AGENT_KEYS" | awk '{print $2}' | grep -qxF "$fp"
}

# loaded | held | live | absent. `live` is a key on a machine with no agent socket: remote/provision.sh points `core.sshCommand` at it directly.
where() {
    local r="$1"
    agent_holds "$r" && { echo loaded; return 0; }
    if [ -f "$HELD/build_key_$r" ]; then
        [ -n "$WS_SOCK" ] && echo held || echo live
        return 0
    fi
    echo absent
}

exposed_private_keys() {
    local f
    [ -d "$LIVE" ] || return 0
    for f in "$LIVE"/build_key*; do
        [ -f "$f" ] || continue
        case "$f" in *.pub) continue ;; esac
        printf '%s\n' "$(basename "$f")"
    done
    return 0
}

# Asked of the machine, not of a record: the process is called `claude`, `node` or a version string, but its exe path resolves under the Claude install.
agent_sessions() {
    local ws
    while IFS=$(printf '\t') read -r ws _; do
        [ -n "$ws" ] || continue
        t_exec "$ws" sh -c '
            for e in /proc/[0-9]*/exe; do
                case "$(readlink "$e" 2>/dev/null)" in
                    */claude/versions/*|*/.local/bin/claude) exit 0 ;;
                esac
            done
            exit 1' >/dev/null 2>&1 && printf '%s\n' "$ws"
    done <<EOF
$(t_list 2>/dev/null)
EOF
    return 0
}

require_agent_target() {
    [ -n "$WS_SOCK" ] && return 0
    die "'$WK_TARGET' workspaces name no ssh-agent socket (t_agent_sock), so the
    deploy keys have nowhere to live outside one and there is no switch here.
    Giving this target one -- wk-ssh-agent.service, the way host/linux/sdk.sh
    installs it -- is owed work (docs/HANDOFF-sandboxing.md). Until then, push
    from the workstation that holds the keys."
}

switch_half() {
    case "$ACTION" in
on)
    require_agent_target
    busy=$(agent_sessions)
    if [ -n "$busy" ]; then
        barrier "an agent session (a claude process) is running in $(printf '%s' "$busy" | tr '\n' ' ')-- loading
    the keys hands that session a working push, and its commit wall stays
    until it exits. End that session first, or force this."
    fi

    if ! push_agent_ensure push_agent_exec "$MACHINE_SOCK"; then
        warn "no ssh-agent answers at $MACHINE_SOCK on the machine that runs the
    workspaces, so there is nothing to load the deploy keys into"
        log  "  ./setup installs and starts wk-ssh-agent.service there"
        return 1
    fi

    # Before the keys: a workspace whose ssh config names no fork host cannot use an agent that holds one. Republished here because `wk key register` may have minted new public halves since the store was made.
    secrets_publish \
        || die "could not write $LIVE/ssh_config, which every workspace includes"

    rows=$(push_agent_load push_agent_exec "$MACHINE_SOCK")
    loaded=$(printf '%s\n' "$rows" | awk '$2 == "loaded"'  | grep -c . || true)
    failed=$(printf '%s\n' "$rows" | awk '$2 == "FAILED"'  | grep -c . || true)
    nokey=$( printf '%s\n' "$rows" | awk '$2 == "no-key"'  | grep -c . || true)

    if [ "$failed" -gt 0 ]; then
        warn "$failed deploy key(s) would not load into the agent, so push is not fully on"
        log  "  the agent is at $MACHINE_SOCK; 'wk push on' again once it answers"
        return 1
    fi
    if [ "$loaded" -eq 0 ]; then
        warn "no deploy key here to load -- 'wk key register' makes them"
        return 4
    fi
    changed "push is ON -- $loaded deploy key(s) in the agent outside every workspace"
    [ "$nokey" -eq 0 ] || log "  $nokey fork(s) have no key here ('wk key register')"
    log "  every workspace can push to the forks now, including any agent in one."
    log "  'wk push off' when you are done; 'wk ai claude' turns it off by itself."

    if push_agent_pat_write push_agent_exec "$MACHINE_PAT"; then
        changed "the GitHub API token is where the injector reads it ($(wk_github_user))"
        log  "  'git-webkit pr' in a workspace posts as that account; the token stays here"
    else
        push_agent_pat_clear push_agent_exec "$MACHINE_PAT" || true
        warn "there is no GitHub API token here, so 'git-webkit pr' in a workspace gets 401"
        log  "  'wk key set github-pat' stores one (repo scope; it never enters a workspace)"
    fi

    log "  a push also needs this machine's key registered:  wk key check"
    ;;

off)
    require_agent_target
    push_agent_clear    push_agent_exec "$MACHINE_SOCK" || true
    push_agent_pat_clear push_agent_exec "$MACHINE_PAT" || true
    # Rewritten on `off` too: it names public halves and a socket, not a credential, and an unresolvable `github-webkit` fails with a hostname error.
    secrets_publish \
        || warn "could not rewrite $LIVE/ssh_config; a push from a workspace will fail
    on the host alias rather than on the missing identity"

    # Evidence, not the exit status of the clear: an agent that ignored `ssh-add -D` is an agent a workspace can still push with.
    left=$(push_agent_list push_agent_exec "$MACHINE_SOCK")
    if [ -n "$left" ]; then
        warn "the agent at $MACHINE_SOCK still holds $(printf '%s\n' "$left" | grep -c .) identity/identities"
        log  "  push is NOT off; 'wk push off' again, or restart wk-ssh-agent.service there"
        return 1
    fi
    if push_agent_pat_present push_agent_exec "$MACHINE_PAT"; then
        warn "the GitHub API token is still at $MACHINE_PAT on that machine"
        log  "  push is NOT off; 'wk push off' again"
        return 1
    fi
    changed "push is OFF -- the agent is empty and the injector has no token"
    log "  workspaces keep their remotes and can fetch; a push and an API call are"
    log "  both refused at the door. The keys never left $HELD."
    ;;

status)
    loaded=0; held=0; live=0; absent=0
    for r in $(forks); do
        case "$(where "$r")" in
            loaded) loaded=$((loaded + 1)); printf '%-10s %s\n' "$r" "push allowed (in the agent)" ;;
            held)   held=$((held + 1));     printf '%-10s %s\n' "$r" "held back ($HELD)" ;;
            live)   live=$((live + 1));     printf '%-10s %s\n' "$r" "always live ($HELD) -- no switch on this machine" ;;
            absent) absent=$((absent + 1)); printf '%-10s %s\n' "$r" "no key ('wk key register')" ;;
        esac
    done

    if push_agent_pat_present push_agent_exec "$MACHINE_PAT"; then
        printf '%-10s %s\n' "api" "'git-webkit pr' allowed (token at $MACHINE_PAT)"
    elif [ -n "$(wk_github_pat)" ]; then
        printf '%-10s %s\n' "api" "held back ($(wk_github_pat_path))"
    else
        printf '%-10s %s\n' "api" "no token ('wk key set github-pat')"
    fi

    exposed=$(exposed_private_keys)
    if [ -n "$exposed" ]; then
        warn "private key(s) in the mounted secrets directory, readable by every workspace:
    $(printf '%s' "$exposed" | tr '\n' ' ')"
        log  "  move them to $HELD, which nothing mounts anywhere"
    fi

    if [ -z "$WS_SOCK" ]; then
        warn "'$WK_TARGET' workspaces name no ssh-agent socket, so there is no switch
    on this machine: a checkout here is a plain one with no container around it
    and its core.sshCommand names the private half directly
    (remote/provision.sh). The key above is live whatever the switch says
    anywhere else, and 'wk push on|off' here refuses rather than pretending.
    Installing wk-ssh-agent.service here is owed work (docs/HANDOFF-sandboxing.md)."
    elif [ "$held" -gt 0 ] || [ "$loaded" -gt 0 ]; then
        push_agent_ensure push_agent_exec "$MACHINE_SOCK" \
            || log "  no ssh-agent answers at $MACHINE_SOCK ('./setup' installs it there)"
    fi

    # A 0 here would tell cmd/ai's `push_switch status || return 0` the fleet is shut when one box is not.
    if [ "$live" -gt 0 ]; then
        info "push is ON here and cannot be switched off -- $live key(s) are live"
        return 0
    fi
    if [ "$loaded" -gt 0 ]; then
        info "push is ON"
        return 0
    fi
    if [ "$held" -gt 0 ]; then
        info "push is OFF -- 'wk push on' to allow it"
        return 1
    fi
    warn "there are no deploy keys here at all -- 'wk key register' makes them"
    return 4
    ;;

*)
    die "usage: wk push on|off|status; see wk push -h"
    ;;
    esac
}

# A container reads the agent's socket through its /run/wk mount; a macOS guest cannot, so its half is an ssh-agent here and an `ssh -N -R` per guest (targets/vm.sh), driven in a subshell that re-points $WK_STORE.
_in_vm_driver() { # <function to call in the vm driver> [args...]
    is_macos || return 0
    local fn="$1"; shift
    ( load_target vm >/dev/null 2>&1 && "$fn" "$@" )
}

GUEST_RC=0
GUEST_LIVE=0

converge_guests() {
    _in_vm_driver vm_push_keys_converge "$ACTION" && return 0
    GUEST_RC=1
    warn "the guest(s) named above were not converged and may still reach the agent;
    'wk push $ACTION' again once each one answers"
}

# A stopped guest is not started to find out: `wk vm start` converges it before anything in it can run.
guest_rows() {
    local rows g state forks
    rows=$(_in_vm_driver vm_push_keys_state) || return 0
    [ -n "$rows" ] || return 0
    while IFS="$(printf '\t')" read -r g state forks; do
        [ -n "$g" ] || continue
        if [ "$state" != running ]; then
            printf 'guest %-10s %s\n' "$g" "$state -- not read; 'wk vm start $g' converges it"
        elif [ -n "$forks" ]; then
            GUEST_LIVE=1
            printf 'guest %-10s %s\n' "$g" "$forks"
        else
            printf 'guest %-10s %s\n' "$g" "no agent socket -- a push from in there is refused"
        fi
    done <<EOF
$rows
EOF
}

SWITCH_RC=0
switch_half || SWITCH_RC=$?

case "$ACTION" in
    on|off) converge_guests ;;
    status) guest_rows ;;
esac

if [ "$ACTION" = status ] && [ "$GUEST_LIVE" -eq 1 ] && [ "$SWITCH_RC" -ne 0 ]; then
    info "push is ON -- a running guest above still reaches the agent ('wk push off')"
    SWITCH_RC=0
fi

if [ "$GUEST_RC" -gt "$SWITCH_RC" ]; then
    exit "$GUEST_RC"
fi
exit "$SWITCH_RC"
