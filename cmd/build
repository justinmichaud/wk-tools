"""build WebKit or JSC

The job count is derived from the memory available now. --dry-run prints the command line it would run, prefixed
`running:`, and builds nothing. Everything after `--` goes to build-webkit verbatim.

  WK_BABYSIT_MODEL=<model>    the model `--babysit` uses (default haiku)
  WK_BABYSIT_ATTEMPTS=<n>     fixes the babysitter tries before giving up (default 5)
  WK_NO_COMPILE_COMMANDS=1    write no compile_commands.json (it costs the Apple ports their precompiled prefix headers)
  WK_NO_COMPILATION_CACHE=1   build without Xcode's compilation cache
  WK_JOBS, WK_NICE            the job count and nice level the place half runs at
"""
from wk import build, images, places, store
from wk.decl import Command, Opt

ROOT = images.root()
COMMAND = Command(name="required", takes=("<preset>",), preset="arg", ready=True, repos=("webkit",), tail="--",
                  group="workspaces", opts=(
    Opt("--list", "print the available presets and exit", sets=dict(where="local", name="none", takes=())),
    Opt("--no-defaults", "skip the build machine's build_args conf default"),
    Opt("--detach", "hand the build to the machine that runs it, and return once it has started"),
    Opt("--kill", "stop the build running in this workspace, wherever it runs, and record it as cancelled",
        sets=dict(takes=(), opts=(Opt("--kill", "stop the build"),))),
    Opt("--babysit", "run under a Claude fix loop until it builds or gives up"),
    Opt("--_babysit", "the babysitter's own detached run"),
    Opt("--branch", "check out this branch first", value="<name>"),
    Opt("--mem-budget", "memory ceiling for the watchdog", value="<MB>"),
    Opt("--mem-floor", "memory floor for the watchdog", value="<MB>"),
    Opt("--cmake", "extra CMake flags, added to the preset's own (repeatable)", value="<flags>"),
    Opt("--env", "extra environment for the build, overriding the preset's (repeatable)", value="NAME=VALUE"),
    Opt("--cmakeargs", "replace the preset's CMake flags (a barrier: --force crosses it)", value="<args>")))


def parse(args):
    return {"list": args.flag("--list"), "kill": args.flag("--kill"), "detach": args.flag("--detach"),
            "no_defaults": args.flag("--no-defaults"), "babysit": args.flag("--babysit"),
            "babysit_driver": args.flag("--_babysit"), "branch": args.value("--branch"),
            "mem_budget": args.value("--mem-budget"), "mem_floor": args.value("--mem-floor"),
            "cmakeargs": args.value("--cmakeargs"), "cmake": args.values("--cmake"), "env": args.values("--env"),
            "pass": args.tail, "preset": store.build_preset()}


def main(args, inv, reg=None, clock=None):
    opts = parse(args)
    if opts["list"]:
        return build.list_presets()
    reg = reg or places.Registry(ROOT)
    return build.Build(reg, store.ws_name(reg.env), opts, args.argv(), clock).front()
