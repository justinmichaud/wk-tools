#!/usr/bin/env python3
#
# wk build <workspace> <config> -- build WebKit or JSC
# wk: where=workspace name=required takes=1 values=--list ready=yes group=workspaces dryrun passthrough
# wk: opts --list,--no-defaults,--detach,--kill,--babysit,--_babysit,--branch=,--mem-budget=,--mem-floor=,--cmake=,--env=,--cmakeargs=,--sysroot=
# wk: flag --list where=local name=none takes=0
# wk: flag --kill takes=0 opts=--kill
#
# The job count is derived from memory actually available right now, and the
# build runs where the scheduler and the OOM killer will pick it over your
# desktop session. Under wk's --dry-run it resolves everything and prints the
# exact command line this build would run, prefixed `running:`, and builds nothing.
# Our own flags are taken off the argument list; everything left passes
# through to the build untouched.
#
#   --list                 print the available configs (wk build --list) and exit
#   --no-defaults          skip this target's WK_BUILD_ARGS conf default
#   --detach                hand the build to the machine that runs it, and return
#                           once it has started; a foreground build is cancelled if
#                           its terminal or its ssh goes away (the driver takes the HUP)
#   --kill                  stop the build running in this workspace, wherever it
#                           runs, and record it as cancelled; takes no config
#   --babysit               run under a Claude fix loop until it builds or gives up
#   --branch <name>         check out this branch first
#   --mem-budget <MB>       memory ceiling for the watchdog
#   --mem-floor <MB>        memory floor for the watchdog
#   --cmake <flags>         extra CMake flags, added to the config's own (repeatable)
#   --env NAME=VALUE        extra environment for the build, overriding the config's (repeatable)
#   --                      everything after this goes to build-webkit verbatim
#
#   WK_BABYSIT_MODEL=<model>    the model `--babysit` uses (default haiku)
#   WK_BABYSIT_ATTEMPTS=<n>     fixes the babysitter tries before giving up
#                               (default 5)
#   WK_MEM_INTERVAL=<s>         how often the memory watchdog samples (default 30)
#   WK_MEM_BUDGET_MB, WK_MEM_FLOOR_MB   what --mem-budget and --mem-floor set
#   WK_NO_COMPILE_COMMANDS=1    write no compile_commands.json (it costs the Apple
#                               ports their precompiled prefix headers)
#   WK_NO_COMPILATION_CACHE=1   build without Xcode's compilation cache
#   WK_JOBS, WK_NICE            the job count and nice level the target half runs at

import os
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import build, targets  # noqa: E402
from wk.act import Refused  # noqa: E402


def parse(argv):
    """The options as the dispatcher hands them on, a declared `--x=` as `--x <value>`."""
    o = {"cmake": [], "env": [], "pass": []}
    i = 0
    while i < len(argv):
        a = argv[i]
        v = argv[i + 1] if i + 1 < len(argv) else ""
        i += 1
        if a == "--":
            o["pass"] += argv[i:]
            break
        if a == "--list":
            o["list"] = True
        elif a == "--kill":
            o["kill"] = True
        elif a == "--detach":
            o["detach"] = True
        elif a == "--no-defaults":
            o["no_defaults"] = True
        elif a == "--babysit":
            o["babysit"] = True
        elif a == "--_babysit":
            o["babysit_driver"] = True
        elif a == "--branch" or a == "--mem-budget" or a == "--mem-floor" or a == "--cmakeargs" or a == "--sysroot":
            o[a[2:].replace("-", "_")] = v
            i += 1
        elif a == "--cmake" or a == "--env":
            o[a[2:]].append(v)
            i += 1
        elif "config" not in o:
            o["config"] = a
        else:
            o["pass"].append(a)
    return o


def main(argv, reg=None, clock=None):
    opts = parse(argv)
    if opts.get("list"):
        return build.list_configs()
    reg = reg or targets.Registry(ROOT)
    return build.Build(reg, reg.env.get("WK_NAME", ""), opts, argv, clock).front()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
