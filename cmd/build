#!/usr/bin/env bash
#
# wk build <workspace> <config> -- build WebKit or JSC.
#
# The reason to use this rather than calling build-webkit directly: the job
# count is derived from memory actually available right now, and the build runs
# where the scheduler and the OOM killer will pick it over your desktop
# session. A plain `ninja -j$(nproc)` on a WebKit link step is the reliable way
# to make a machine stop responding.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/arch.sh"
. "$WK_ROOT/build/configs.sh"

if [ "${1:-}" = --list ]; then
    log "available configs:"
    config_list | sed 's/^/  /'
    exit 0
fi

# --dry-run is accepted on either side of the config, because both readings are
# natural and the name/config parse below would otherwise consume it as one or
# the other. See the flag itself further down.
DRY=""
[ "${1:-}" = --dry-run ] && { DRY=1; shift; }

# The workspace name is optional inside a workspace: there is exactly one, it is
# this machine, and `wk build <config>` is the form claude/CLAUDE.md documents
# and the only one available in there. The leading argument is consumed as a
# name only when it really is this workspace's own name -- and not when that
# word is also a config, so a workspace named after one still builds.
NAME="${1:-}"; CONFIG="${2:-}"
if in_workspace && { [ "$NAME" != "$(wk_self)" ] || config_load "$NAME" 2>/dev/null; }; then
    # A name *and* a config, where the name is not this workspace's, is the host
    # form typed in the wrong place. Read literally it would build this
    # workspace and report the config as unknown, which explains neither half.
    if [ -n "$CONFIG" ] && config_load "$CONFIG" 2>/dev/null; then
        die "no such workspace: $NAME -- this is workspace '$(wk_self)', so the
    form in here is 'wk build $CONFIG' with no name"
    fi
    NAME=$(wk_self); CONFIG="${1:-}"
    shift 1 2>/dev/null || true
else
    shift 2 2>/dev/null || true
fi

# --dry-run: resolve everything and print what would happen, build nothing.
#
# Here because a cold Apple-port build is ~99 minutes, so "does `wk build` reach
# the right target with the right config and job count" cannot be answered by
# running one -- which is exactly the question a workspace's first in-workspace
# build asks. Taken off what is left of the argument list, which is otherwise
# passed through to the build untouched.
[ "${1:-}" = --dry-run ] && { DRY=1; shift; }

require_name "$NAME"
[ -n "$CONFIG" ] || {
    if in_workspace; then log "usage: wk build <config>"
    else log "usage: wk build <workspace> <config>"; fi
    config_list | sed 's/^/  /'; exit 2
}

config_load "$CONFIG" || die "unknown config '$CONFIG' (wk build --list)"

TARGET="${WK_TARGET:-$(target_of "$NAME" 2>/dev/null || default_target)}"
load_target "$TARGET"

[ "$(t_info "$NAME")" != absent ] || die "no such workspace: $NAME"

# The workspace's own architecture, from the driver rather than from a flag.
# It was fixed when the workspace was created and cannot change afterwards --
# the container is armhf or it is not -- so there is nothing to pass and
# nothing to get wrong per build. The flags it implies are in lib/arch.sh.
ARCH=$(t_arch "$NAME")

# Reserved, so that the day it exists it cannot be confused with the above.
# --arch is what the workspace runs; --sysroot would be what a build targets
# from a native workspace. They are different mechanisms with different flags
# (see lib/arch.sh), and silently passing this through to build-webkit -- which
# has no such option -- would fail 40 lines into a perl script.
for _a in ${@+"$@"}; do
    case "$_a" in
        --sysroot|--sysroot=*)
            die "--sysroot is not implemented (docs/HANDOFF-cross-compile.md).
    This workspace is $ARCH; a --sysroot build would be a *cross* build from a
    native workspace, which is a different mechanism -- an aarch64 clang, -m32,
    CMAKE_LIBRARY_ARCHITECTURE and another rootfs to link against." ;;
    esac
done

# Shared boxes get the polite calculation: other people are building too.
POLITE=""
NICE=10
if [ "$WK_TARGET_KIND" = remote ]; then POLITE=1; NICE=19; fi

# Size the build from what the *target* has, not from this machine's free
# memory. Inside a container the kernel still reports the whole machine's
# MemAvailable, so deriving jobs from it picks a number the cgroup will
# OOM-kill mid-link; and for a macOS VM this half runs on the host, whose
# memory has nothing to do with what the guest was booted with.
#
# For a remote target none of the local numbers mean anything at all -- it is
# somebody else's machine, reached over ssh -- so the driver's answers replace
# the measurement instead of capping it, and the load average has to come from
# over there as well. See avail_mem_mb().
if [ "$WK_TARGET_KIND" = remote ]; then
    WK_AVAIL_MB=$(t_mem_mb "$NAME")
    WK_CGROUP_CORES=$(t_cores "$NAME")
    WK_LOAD=$(t_load "$NAME")
    export WK_AVAIL_MB WK_CGROUP_CORES WK_LOAD
else
    WK_CGROUP_MB=$(t_mem_mb "$NAME")
    WK_CGROUP_CORES=$(t_cores "$NAME")
    export WK_CGROUP_MB WK_CGROUP_CORES
fi

# Where ccache keeps its cache inside the target. /ccache in a container, which
# is the bind-mounted store cache; a directory of our own on a machine we share
# with other people, whose cache is not ours to write to.
WK_CCACHE_DIR=$(t_ccache_dir "$NAME")
export WK_CCACHE_DIR

JOBS=$(explain_jobs "$POLITE")

# Everything above is resolution; everything below changes something. A dry run
# stops on the line between the two -- before the tooling sync and before the
# status file, so it cannot leave a workspace looking like it is building.
if [ -n "$DRY" ]; then
    config_build_env "$(t_src "$NAME")" "$JOBS" "$NICE" "$ARCH"
    ARCH_LABEL=$(arch_label "$ARCH")
    log "dry run -- nothing was built."
    log "  workspace: $NAME ($TARGET, $(t_info "$NAME")${ARCH_LABEL:+, $ARCH_LABEL})"
    log "  config:    $CONFIG ($CFG_BUILDSYS${CFG_PORT:+ $CFG_PORT}${CFG_ARGS:+ $CFG_ARGS})"
    [ -n "$ARCH_LABEL" ] && log "  arch:      $ARCH_LABEL, native ($(arch_wrapper "$ARCH") $(arch_cflags "$ARCH"))"
    log "  src:       $(t_src "$NAME")"
    log "  build dir: $(config_build_dir "$(t_src "$NAME")")"
    log "  jobs:      $JOBS (nice $NICE)"
    log "  would run: env ${CFG_ENV[*]} $(t_tools "$NAME")/build/build-in-target.sh $*"
    exit 0
fi

# Push the tooling in before anything else. A no-op for the container, which
# bind-mounts it; an rsync of differences for a VM.
#
# Deliberately ahead of the status file: anything that fails after
# `state=running` is written but before the build is reaped leaves the
# workspace looking like it is building forever.
t_sync_tools "$NAME"

WS=$(wk_ws_dir "$NAME")
LOG="$WS/build.log"
STATUS="$WS/build.status"

STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
START_EPOCH=$(date +%s)

# Written here, and -- for a target that is a machine of its own -- pushed
# there too, so that `wk status` gets the same answer from either end instead
# of whichever half of the truth it is standing on. t_state_put is a no-op
# everywhere else.
write_status() {
    local content
    content=$(cat <<EOF
state=$1
config=$CONFIG
arch=$ARCH
exit=${2:-}
started=$STARTED
finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)
seconds=$(( $(date +%s) - START_EPOCH ))
log=$LOG
EOF
)
    printf '%s\n' "$content" > "$STATUS"
    printf '%s\n' "$content" | t_state_put "$NAME"
}

RUNNING=$(printf 'state=running\nconfig=%s\narch=%s\nstarted=%s\nlog=%s\n' \
    "$CONFIG" "$ARCH" "$STARTED" "$LOG")
printf '%s\n' "$RUNNING" > "$STATUS"
printf '%s\n' "$RUNNING" | t_state_put "$NAME"

# ccache is on. jscb-configure used to pass --no-use-ccache unconditionally,
# which meant the shared cache never did anything for JSC builds.
ARCH_LABEL=$(arch_label "$ARCH")
info "building $CONFIG${ARCH_LABEL:+ ($ARCH_LABEL)} in '$NAME' with -j$JOBS (nice $NICE)"
log  "  log: $LOG"
log  "  stall warning after ${WK_STALL_SECONDS}s of silence; abort after ${WK_ABORT_SECONDS}s"

# The build environment comes from one place, shared with the golden-base
# prebuild, so the two cannot drift into building subtly different things.
config_build_env "$(t_src "$NAME")" "$JOBS" "$NICE" "$ARCH"

set +e
# t_exec_build, not t_exec: on a shared machine the build is the one thing that
# has to be serialised against your own other builds, and the lock that does it
# must not sit on every small command as well.
run_watched "$LOG" -- \
    t_exec_build "$NAME" env "${CFG_ENV[@]}" \
        "$(t_tools "$NAME")/build/build-in-target.sh" "$@"
rc=$?
set -e

ELAPSED=$(( $(date +%s) - START_EPOCH ))
MINS=$(( ELAPSED / 60 )); SECS=$(( ELAPSED % 60 ))

echo >&2
case $rc in
0)
    write_status ok 0
    info "BUILD OK  $CONFIG${ARCH_LABEL:+ ($ARCH_LABEL)} in '$NAME'  (${MINS}m${SECS}s)"
    ;;
124)
    write_status stalled 124
    die "BUILD STALLED  $CONFIG in '$NAME'  (killed after ${MINS}m${SECS}s with no output)
    log: $LOG
    A stall is usually memory pressure -- check 'wk status $NAME' for OOM kills."
    ;;
*)
    write_status failed "$rc"
    warn "BUILD FAILED  $CONFIG in '$NAME'  (exit $rc after ${MINS}m${SECS}s)"
    log "first error(s):"
    first_error "$LOG" | sed 's/^/  /' || true
    log ""
    log "  full log: $LOG"
    exit "$rc"
    ;;
esac
