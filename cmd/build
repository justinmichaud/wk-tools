#!/usr/bin/env bash
#
# wk build <workspace> <config> -- build WebKit or JSC
# wk: where=workspace name=required values=--list ready=yes group=workspaces
# wk: flag --list where=local
#
# The job count is derived from memory actually available right now, and the
# build runs where the scheduler and the OOM killer will pick it over your
# desktop session.
#
#   --list                 print the available configs (wk build --list) and exit
#   --dry-run              resolve everything and print the exact command line
#                          this build would run, prefixed `running:`; build nothing
#   --no-defaults          skip this target's WK_BUILD_ARGS conf default
#   --detach                hand the build to the machine that runs it, and return
#   --babysit[=model]       run under a Claude fix loop until it builds or gives up
#   --branch <name>         check out this branch first
#   --mem-budget <MB>       memory ceiling for the watchdog
#   --mem-floor <MB>        memory floor for the watchdog
#   --cmake <flags>         extra CMake flags, added to the config's own (repeatable)
#   --env NAME=VALUE        extra environment for the build, overriding the config's (repeatable)
#   --                      everything after this goes to build-webkit verbatim
#
#   WK_BABYSIT_MODEL=<model>    the model bare `--babysit` (no `=model`) uses
#                               (default haiku)
#   WK_BABYSIT_ATTEMPTS=<n>     fixes the babysitter tries before giving up
#                               (default 5)
#   WK_BUILD_LOCK_WAIT=<s>      how long a build waits for another build on
#                               the same workspace before giving up (default 3600)
#   WK_MEM_INTERVAL=<s>         how often the memory watchdog samples (default 30)

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/detach.sh"
. "$WK_ROOT/lib/arch.sh"
. "$WK_ROOT/build/configs.sh"

# Kept whole, before any parsing consumes it: `--detach` re-runs this same command.
_ALL_ARGS=("$@")

if [ "${1:-}" = --list ]; then
    [ $# -eq 1 ] || die "usage: wk build --list; see wk build -h
    unexpected argument: $2"
    log "available configs:"
    config_list | sed 's/^/  /'
    exit 0
fi

DRY=""
[ "${1:-}" = --dry-run ] && { DRY=1; shift; }

NAME="${WK_NAME:-}"
require_name "$NAME"

# Before any config_load: on macOS a config does not choose its own build system, so the target has to be known first (t_os).
TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

if in_workspace; then
    # A subshell, because this only asks whether the word names a config at all: config_load refuses an Apple config on a Linux target.
    if [ -n "${2:-}" ] && ( config_load "${2:-}" "$(t_os)" ) >/dev/null 2>&1; then
        die "no such workspace: ${1:-} -- this is workspace '$NAME', so the
    form in here is 'wk build ${2:-}' with no name"
    fi
fi
CONFIG="${1:-}"
shift 1 2>/dev/null || true

[ "${1:-}" = --dry-run ] && { DRY=1; shift; }

[ -n "$CONFIG" ] || {
    if in_workspace; then log "usage: wk build <config>"
    else log "usage: wk build <workspace> <config>"; fi
    config_list | sed 's/^/  /'; exit 2
}

config_load "$CONFIG" "$(t_os)" || die "unknown config '$CONFIG' (wk build --list)"

# Captured ahead of the flag parsing, since --no-defaults must override it.
TARGET_BUILD_ARGS="${WK_BUILD_ARGS:-}"

WS_STATE=$(ws_state "$NAME")   # for the dry-run report below

ARCH=$(t_arch "$NAME")

WS=$(wk_ws_dir "$NAME")
LOG="$WS/build.log"

# The one writer for build.status. `running` carries no exit/finished/seconds/peak_mb and touches the log fresh, so build_live has evidence.
write_status() {
    local state="$1" rc="${2:-}" content
    if [ "$state" = running ]; then
        ensure_dir "$WS" >/dev/null
        : > "$LOG"
        content=$(cat <<EOF
state=running
config=$CONFIG
arch=$ARCH
started=$STARTED
log=$LOG
EOF
)
    else
        content=$(cat <<EOF
state=$state
config=$CONFIG
arch=$ARCH
exit=$rc
started=$STARTED
finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)
seconds=$(( $(date +%s) - START_EPOCH ))
log=$LOG
peak_mb=${MEM_PEAK:-}
EOF
)
    fi
    printf '%s\n' "$content" | t_status_put "$NAME"
}

# Our own flags are taken off the argument list; everything left passes
# through to the build untouched. --sysroot is reserved so it is not confused with --arch, which would fail 40 lines into a perl script.
BABYSIT=""; BRANCH=""; EXTRA_CMAKE=""; MEM_BUDGET=""; MEM_FLOOR=""; DETACH=""; NO_DEFAULTS=""; _PASS=()
EXTRA_ENV=""; _NL='
'   # newline-separated, since an environment value may contain spaces
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)   DRY=1; shift ;;
        --detach)    DETACH=1; shift ;;
        --no-defaults) NO_DEFAULTS=1; shift ;;
        --babysit)   BABYSIT="${WK_BABYSIT_MODEL:-haiku}"; shift ;;
        --babysit=*) BABYSIT="${1#*=}"; shift ;;
        --branch)    BRANCH="${2:-}"; [ -n "$BRANCH" ] || die "--branch needs a name"; shift 2 ;;
        --branch=*)  BRANCH="${1#*=}"; shift ;;

        # Flags, not only environment: a container build on a macOS host is forwarded into the podman VM, where only the command line survives.
        --mem-budget)  MEM_BUDGET="${2:-}"; [ -n "$MEM_BUDGET" ] || die "--mem-budget needs MB"; shift 2 ;;
        --mem-budget=*) MEM_BUDGET="${1#*=}"; shift ;;
        --mem-floor)   MEM_FLOOR="${2:-}"; [ -n "$MEM_FLOOR" ] || die "--mem-floor needs MB"; shift 2 ;;
        --mem-floor=*)  MEM_FLOOR="${1#*=}"; shift ;;

        --cmake)     [ -n "${2:-}" ] || die "--cmake needs at least one flag"
                     EXTRA_CMAKE="$EXTRA_CMAKE $2"; shift 2 ;;
        --cmake=*)   EXTRA_CMAKE="$EXTRA_CMAKE ${1#*=}"; shift ;;

        --env)       [ -n "${2:-}" ] || die "--env needs NAME=VALUE"
                     case "$2" in
                         [A-Za-z_]*=*) ;;
                         *) die "--env takes NAME=VALUE, got $(sh_quote "$2")" ;;
                     esac
                     EXTRA_ENV="$EXTRA_ENV$2$_NL"; shift 2 ;;
        --env=*)     _v="${1#*=}"
                     case "$_v" in
                         [A-Za-z_]*=*) ;;
                         *) die "--env takes NAME=VALUE, got $(sh_quote "$_v")" ;;
                     esac
                     EXTRA_ENV="$EXTRA_ENV$_v$_NL"; shift ;;
        --cmakeargs|--cmakeargs=*)
            barrier "--cmakeargs would replace the config's CMake flags rather than add to
    them: build-webkit takes one --cmakeargs, so the last one on the command
    line wins and '$CONFIG' would lose $(config_cmake_summary).
    Use --cmake instead, which is added to them:
        wk build$(in_workspace || printf ' %s' "$NAME") $CONFIG --cmake $(sh_quote "${1#*=}")"
                     _PASS+=("$1"); shift ;;
        --) shift; _PASS+=(${@+"$@"}); break ;;

        --sysroot|--sysroot=*)
            die "--sysroot is not implemented (docs/Nice to have/HANDOFF-cross-compile.md).
    This workspace is $ARCH; a --sysroot build would be a *cross* build from a
    native workspace, which is a different mechanism -- an aarch64 clang, -m32,
    CMAKE_LIBRARY_ARCHITECTURE and another rootfs to link against." ;;
        *) _PASS+=("$1"); shift ;;
    esac
done
set -- ${_PASS[@]+"${_PASS[@]}"}

[ -z "$NO_DEFAULTS" ] || TARGET_BUILD_ARGS=""

if [ -n "$BABYSIT" ]; then
    in_workspace && die "--babysit runs on the host: it re-runs 'wk build' and starts
    Claude in the workspace, neither of which works from in here"
    case "$WK_TARGET_KIND" in
        remote) die "refusing to babysit on a remote target: the fixer is Claude, and
    a shared machine has no sandbox to run it in (the same rule as 'wk ai claude')" ;;
        local)  die "already inside a workspace -- run the build and claude directly" ;;
    esac

    WS=$(wk_ws_dir "$NAME")
    if [ -f "$WS/babysit.status" ]; then
        _state=$(status_field "$WS/babysit.status" state)
        case "$_DETACH_RUNNING" in
            *" ${_state:-none} "*)
                _pid=$(status_field "$WS/babysit.status" pid)
                detach_alive "$WS/babysit.status" \
                    && die "a babysitter is already running for '$NAME' (pid $_pid, $_state).
    Follow it:  tail -f $WS/babysit.log" ;;
        esac
    fi

    if [ -n "$DRY" ]; then
        log "dry run -- nothing was built, no babysitter started."
        log "  would run detached: build/babysit.sh $NAME $CONFIG $BABYSIT \\"
        log "    ${WK_BABYSIT_ATTEMPTS:-5} '$BRANCH' $*"
        exit 0
    fi

    ensure_dir "$WS" >/dev/null
    _pid=$(detach_run "$WS/babysit.status" "$WS/babysit.log" -- \
        "$WK_ROOT/build/babysit.sh" "$NAME" "$CONFIG" "$BABYSIT" \
        "${WK_BABYSIT_ATTEMPTS:-5}" "$BRANCH" ${@+"$@"})
    info "babysitter started for $CONFIG in '$NAME' (pid $_pid, model $BABYSIT${BRANCH:+, branch $BRANCH})"
    log  "  it survives this terminal; up to ${WK_BABYSIT_ATTEMPTS:-5} fixes, then it closes itself"
    log  "  state:   wk status $NAME"
    log  "  follow:  tail -f $WS/babysit.log"
    log  "  report:  $WS/babysit.report"
    exit 0
fi

# A WebKit build is tens of minutes and the connection driving it is not: anything that kills the driver takes the build with it.
if [ -n "$DETACH" ]; then
    # _ALL_ARGS still has the workspace name the dispatcher resolved and dropped ($WK_NAME now, not $1).
    _det=()
    in_workspace || _det+=("$NAME")
    for _a in ${_ALL_ARGS[@]+"${_ALL_ARGS[@]}"}; do
        [ "$_a" = --detach ] && continue
        _det+=("$_a")
    done

    STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    write_status running

    _pid=$(detach_run "" "$WS/detached.log" -- \
        "$WK_ROOT/wk" build ${_det[@]+"${_det[@]}"})
    info "building $CONFIG in '$NAME', detached as pid $_pid -- this end can go away"
    log "  follow:  wk logs $NAME -f"
    log "  state:   wk status $NAME"
    exit 0
fi

POLITE=""
NICE=10
if [ "$WK_TARGET_KIND" = remote ]; then POLITE=1; NICE=19; fi

# Inside a container the kernel still reports the whole machine's MemAvailable, which the cgroup will OOM-kill mid-link for.
export_target_resources "$NAME"

WK_EXTRA_CMAKE="${EXTRA_CMAKE# }"
export WK_EXTRA_CMAKE
WK_EXTRA_ENV="$EXTRA_ENV"
export WK_EXTRA_ENV

WK_TARGET_BUILD_ARGS="$TARGET_BUILD_ARGS"
export WK_TARGET_BUILD_ARGS

[ -z "$MEM_BUDGET" ] || { WK_MEM_BUDGET_MB="$MEM_BUDGET"; export WK_MEM_BUDGET_MB; }
[ -z "$MEM_FLOOR" ]  || { WK_MEM_FLOOR_MB="$MEM_FLOOR";   export WK_MEM_FLOOR_MB; }

WK_CCACHE_DIR=$(t_ccache_dir "$NAME")
export WK_CCACHE_DIR

[ -z "${WK_REMOTE_MAX_JOBS:-}" ] || \
    warn "WK_REMOTE_MAX_JOBS is set in $TARGET's conf and is ignored: the job count
  is derived per build from what that machine has free. Delete the line."

JOBS=$(explain_jobs "$POLITE")
BUDGET_MB=${WK_MEM_BUDGET_MB:-$(( JOBS * ${WK_MB_PER_JOB:-1536} ))}
[ -n "$DRY" ] || build_admit "this build" "$JOBS"

if [ -n "$DRY" ]; then
    config_build_env "$(t_src "$NAME")" "$JOBS" "$NICE" "$ARCH"
    ARCH_LABEL=$(arch_label "$ARCH")
    log "dry run -- nothing was built."
    log "  workspace: $NAME ($TARGET, $WS_STATE${ARCH_LABEL:+, $ARCH_LABEL})"
    [ -n "$BRANCH" ] && log "  branch:    $BRANCH (would be checked out first)"
    log "  config:    $CONFIG ($CFG_BUILDSYS${CFG_PORT:+ $CFG_PORT}${CFG_ARGS:+ $CFG_ARGS})"
    [ -n "${WK_TARGET_CMAKE:-}" ] && log "  machine:   $WK_TARGET_CMAKE (WK_TARGET_CMAKE, from $TARGET's conf)"
    [ -n "$TARGET_BUILD_ARGS" ] && log "  defaults:  $TARGET_BUILD_ARGS (WK_BUILD_ARGS, from $TARGET's conf; --no-defaults skips it)"
    [ -n "$WK_EXTRA_CMAKE" ] && log "  --cmake:   $WK_EXTRA_CMAKE (added to the config's)"
    [ -n "$WK_EXTRA_ENV" ] && log "  --env:     $(printf '%s' "$WK_EXTRA_ENV" | tr '\n' ' ')(overrides the config's)"
    [ $# -gt 0 ] && log "  passed on: $* (straight to build-webkit)"
    [ -n "$ARCH_LABEL" ] && log "  arch:      $ARCH_LABEL, native ($(arch_wrapper "$ARCH") $(arch_cflags "$ARCH"))"
    log "  src:       $(t_src "$NAME")"
    log "  build dir: $(config_build_dir "$(t_src "$NAME")")"
    log "  jobs:      $JOBS (nice $NICE)"
    log "  memory:    budget ${BUDGET_MB}MB, floor ${WK_MEM_FLOOR_MB:-2048}MB, watched every ${WK_MEM_INTERVAL:-30}s"
    log "  would run: env ${CFG_ENV[*]} $(t_tools "$NAME")/build/build-in-target.sh $*"

    # t_exec, not t_exec_build: a dry run should not wait behind a link step. Guarded on the far copy knowing WK_DRY_RUN.
    _bit="$(t_tools "$NAME")/build/build-in-target.sh"
    if ! t_exec "$NAME" grep -q WK_DRY_RUN "$_bit" 2>/dev/null; then
        warn "  the wk-tools in '$NAME' predates --dry-run's target half, so the commands"
        log  "  it would run cannot be asked for without risking a real build."
        log  "  push this tree there first:  wk sync --tools $TARGET"
        exit 0
    fi
    if _cmd=$(t_exec "$NAME" env "${CFG_ENV[@]}" WK_DRY_RUN=1 \
            "$_bit" ${@+"$@"} 2>/dev/null); then
        log "  running:   $(printf '%s' "$_cmd" | tr -d '\r')"
    else
        warn "  could not ask '$NAME' itself what it would run -- the lines above are"
        log  "  this side's half of it. Is the workspace up? (wk status $NAME)"
    fi
    exit 0
fi

hold_lock "ws-$NAME" -w "${WK_BUILD_LOCK_WAIT:-3600}"

# A job detached *into* the workspace holds no lock out here (ws_busy_reason).
if _busy=$(ws_busy_reason "$NAME"); then
    barrier "'$NAME' already has a detached job running in it: $_busy
    Two builds in one checkout corrupt both, and this one would be the second.
    See what it is:  wk logs $NAME --all
    Stop it:         wk sysimage build <profile> --stop   (for a Yocto stage)"
fi

if [ -n "$BRANCH" ]; then
    info "checking out '$BRANCH' in '$NAME'"
    t_exec "$NAME" bash -c "cd $(sh_quote "$(t_src "$NAME")") && {
        git checkout -q $(sh_quote "$BRANCH") 2>/dev/null ||
        { $(origin_branch_fetch_step "$BRANCH" "$(t_mirror_dir "$NAME")") &&
          git checkout -q $(sh_quote "$BRANCH"); }; }" \
        || die "could not check out '$BRANCH' in '$NAME'"
fi

t_sync_tools "$NAME"

STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
START_EPOCH=$(date +%s)
write_status running

ARCH_LABEL=$(arch_label "$ARCH")
info "building $CONFIG${ARCH_LABEL:+ ($ARCH_LABEL)} in '$NAME' with -j$JOBS (nice $NICE)"
log  "  log: $LOG"
log  "  stall warning after ${WK_STALL_SECONDS}s of silence; abort after ${WK_ABORT_SECONDS}s"

config_build_env "$(t_src "$NAME")" "$JOBS" "$NICE" "$ARCH"

_bit="$(t_tools "$NAME")/build/build-in-target.sh"
if _cmd=$(t_exec "$NAME" env "${CFG_ENV[@]}" WK_DRY_RUN=1 "$_bit" ${@+"$@"} 2>/dev/null); then
    log "running:   $(printf '%s' "$_cmd" | tr -d '\r')"
fi

build_record "wk build $NAME ($CONFIG)" "$JOBS" "$BUDGET_MB" "pid:$$"

set +e
# t_exec_build, not t_exec: on a shared machine the build serialises against your own others, and that lock must not sit on every small command.
run_watched "$LOG" -- \
    t_exec_build "$NAME" env "${CFG_ENV[@]}" \
        "$(t_tools "$NAME")/build/build-in-target.sh" "$@"
rc=$?
set -e

# Lifted out of the log: the one channel that survives a dropped ssh.
MEM_PEAK=$(grep -a 'wk: memory: peak' "$LOG" 2>/dev/null | tail -1 \
           | sed -n 's/.*peak \([0-9]*\)MB.*/\1/p' || true)
MEM_KILLED=""
grep -aq 'wk: MEMORY LIMIT' "$LOG" 2>/dev/null && MEM_KILLED=1

ELAPSED=$(( $(date +%s) - START_EPOCH ))
MINS=$(( ELAPSED / 60 )); SECS=$(( ELAPSED % 60 ))

echo >&2
case $rc in
0)
    write_status ok 0
    info "BUILD OK  $CONFIG${ARCH_LABEL:+ ($ARCH_LABEL)} in '$NAME'  (${MINS}m${SECS}s)"
    ;;
124)
    write_status stalled 124
    die "BUILD STALLED  $CONFIG in '$NAME'  (killed after ${MINS}m${SECS}s with no output)
    log: $LOG
    A stall is usually memory pressure -- check 'wk status $NAME' for OOM kills."
    ;;
*)
    if [ -n "$MEM_KILLED" ]; then
        write_status oom "$rc"
        warn "BUILD KILLED FOR MEMORY  $CONFIG in '$NAME'  (after ${MINS}m${SECS}s)"
        grep -a 'wk: MEMORY LIMIT' "$LOG" | tail -2 | sed 's/^wk: /  /' >&2
        log "  peak ${MEM_PEAK:-?}MB. Fewer jobs: WK_MB_PER_JOB=3072 wk build $NAME $CONFIG"
        log "  full log: $LOG"
        exit "$rc"
    fi
    write_status failed "$rc"
    warn "BUILD FAILED  $CONFIG in '$NAME'  (exit $rc after ${MINS}m${SECS}s)"
    log "first error(s):"
    first_error "$LOG" | sed 's/^/  /' || true

    if grep -q 'xcbuilddata/manifest.json' "$LOG" 2>/dev/null; then
        log ""
        warn "that is Xcode's build description, not your code."
        log  "  It is derived, and an interrupted build can leave it unusable."
        log  "  The products survive; only the plan has to be rebuilt:"
        log  "    wk enter $NAME rm -rf $(t_src "$NAME")/WebKitBuild/$(basename "$(config_build_dir "$(t_src "$NAME")")")/XCBuildData"
        log  "    wk build $NAME $CONFIG"
    fi

    log ""
    log "  full log: $LOG"
    exit "$rc"
    ;;
esac
