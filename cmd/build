#!/usr/bin/env bash
#
# wk build <workspace> <config> -- build WebKit or JSC
# wk: where=workspace name=required ready=yes group=workspaces
# wk: flag --list where=local
#
# The job count is derived from memory actually available right now, and the
# build runs where the scheduler and the OOM killer will pick it over your
# desktop session.
#
#   --list                 print the available configs (wk build --list) and exit
#   --dry-run              resolve everything and print the exact command line
#                          this build would run, prefixed `running:`; build nothing
#   --no-defaults          skip this target's WK_BUILD_ARGS conf default
#   --detach                hand the build to the machine that runs it, and return
#   --babysit[=model]       run under a Claude fix loop until it builds or gives up
#   --branch <name>         check out this branch first
#   --mem-budget <MB>       memory ceiling for the watchdog
#   --mem-floor <MB>        memory floor for the watchdog
#   --cmake <flags>         extra CMake flags, added to the config's own (repeatable)
#   --env NAME=VALUE        extra environment for the build, overriding the config's (repeatable)
#   --                      everything after this goes to build-webkit verbatim

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/detach.sh"
. "$WK_ROOT/lib/arch.sh"
. "$WK_ROOT/build/configs.sh"

# Kept whole, before any parsing below consumes it: `--detach` re-runs this
# same command on the machine that will do the work.
_ALL_ARGS=("$@")

if [ "${1:-}" = --list ]; then
    log "available configs:"
    config_list | sed 's/^/  /'
    exit 0
fi

# --dry-run is accepted on either side of the config, since both readings are
# natural and the name/config parse below would otherwise consume it as one.
DRY=""
[ "${1:-}" = --dry-run ] && { DRY=1; shift; }

# Inside a workspace there is exactly one name (this machine); the dispatcher
# resolves $WK_NAME and drops it on a host, so what's left is the config
# either way -- except in here, where a second word is a mistaken name.
NAME="${WK_NAME:-}"
if in_workspace; then
    # A name *and* a config, where the first word is not this workspace's own
    # name, is the host form typed in the wrong place: read literally it would
    # build this workspace and report the second word as an unknown config.
    if [ -n "${2:-}" ] && config_load "${2:-}" 2>/dev/null; then
        die "no such workspace: ${1:-} -- this is workspace '$NAME', so the
    form in here is 'wk build ${2:-}' with no name"
    fi
fi
CONFIG="${1:-}"
shift 1 2>/dev/null || true

[ "${1:-}" = --dry-run ] && { DRY=1; shift; }

require_name "$NAME"
[ -n "$CONFIG" ] || {
    if in_workspace; then log "usage: wk build <config>"
    else log "usage: wk build <workspace> <config>"; fi
    config_list | sed 's/^/  /'; exit 2
}

config_load "$CONFIG" || die "unknown config '$CONFIG' (wk build --list)"

TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

# This target's own default build flags (targets/hosts/<name>.conf; captured
# now, ahead of the flag parsing below, since --no-defaults must override it).
TARGET_BUILD_ARGS="${WK_BUILD_ARGS:-}"

WS_STATE=$(ws_state "$NAME")   # for the dry-run report below

# Fixed when the workspace was created and cannot change per build -- the
# container is armhf or it is not. The flags it implies are in lib/arch.sh.
ARCH=$(t_arch "$NAME")

# Named here, ahead of everything that resolves or writes: --detach (below)
# writes the running record itself before forking off a build it won't wait
# for, rather than leaving a window where `wk status` reads a stale one.
WS=$(wk_ws_dir "$NAME")
LOG="$WS/build.log"

# The one writer for build.status; t_status_put decides where it lands.
# `running` carries no exit/finished/seconds/peak_mb and touches the log
# fresh, so a reader judging liveness by log age (build_live, lib/detach.sh)
# has real evidence rather than a stale mtime.
write_status() {
    local state="$1" rc="${2:-}" content
    if [ "$state" = running ]; then
        ensure_dir "$WS" >/dev/null
        : > "$LOG"
        content=$(cat <<EOF
state=running
config=$CONFIG
arch=$ARCH
started=$STARTED
log=$LOG
EOF
)
    else
        content=$(cat <<EOF
state=$state
config=$CONFIG
arch=$ARCH
exit=$rc
started=$STARTED
finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)
seconds=$(( $(date +%s) - START_EPOCH ))
log=$LOG
peak_mb=${MEM_PEAK:-}
EOF
)
    fi
    printf '%s\n' "$content" | t_status_put "$NAME"
}

# Our own flags are taken off the argument list; everything left passes
# through to the build untouched. --sysroot is reserved so it can't be
# confused with --arch (lib/arch.sh) -- silently passing it through would
# fail 40 lines into a perl script instead of here.
BABYSIT=""; BRANCH=""; EXTRA_CMAKE=""; MEM_BUDGET=""; MEM_FLOOR=""; DETACH=""; NO_DEFAULTS=""; _PASS=()
EXTRA_ENV=""; _NL='
'   # newline-separated, since an environment value may contain spaces
while [ $# -gt 0 ]; do
    case "$1" in
        --detach)    DETACH=1; shift ;;
        --no-defaults) NO_DEFAULTS=1; shift ;;
        --babysit)   BABYSIT="${WK_BABYSIT_MODEL:-haiku}"; shift ;;
        --babysit=*) BABYSIT="${1#*=}"; shift ;;
        --branch)    BRANCH="${2:-}"; [ -n "$BRANCH" ] || die "--branch needs a name"; shift 2 ;;
        --branch=*)  BRANCH="${1#*=}"; shift ;;

        # Flags, not only environment: a container build on a macOS host is
        # forwarded into the podman VM over ssh, and only the command line survives.
        --mem-budget)  MEM_BUDGET="${2:-}"; [ -n "$MEM_BUDGET" ] || die "--mem-budget needs MB"; shift 2 ;;
        --mem-budget=*) MEM_BUDGET="${1#*=}"; shift ;;
        --mem-floor)   MEM_FLOOR="${2:-}"; [ -n "$MEM_FLOOR" ] || die "--mem-floor needs MB"; shift 2 ;;
        --mem-floor=*)  MEM_FLOOR="${1#*=}"; shift ;;

        # *Added* to the config's own -- build-webkit's own --cmakeargs is a
        # single option, so passing it by hand would silently replace them.
        # Appended last, so where a -D repeats, the one typed here wins.
        --cmake)     [ -n "${2:-}" ] || die "--cmake needs at least one flag"
                     EXTRA_CMAKE="$EXTRA_CMAKE $2"; shift 2 ;;
        --cmake=*)   EXTRA_CMAKE="$EXTRA_CMAKE ${1#*=}"; shift ;;

        # Added last so it *overrides* the config's own (`env` takes the last
        # assignment). Exporting CC here does nothing -- the build runs in
        # the target, and only what config_build_env carries gets there.
        --env)       [ -n "${2:-}" ] || die "--env needs NAME=VALUE"
                     case "$2" in
                         [A-Za-z_]*=*) ;;
                         *) die "--env takes NAME=VALUE, got $(sh_quote "$2")" ;;
                     esac
                     EXTRA_ENV="$EXTRA_ENV$2$_NL"; shift 2 ;;
        --env=*)     _v="${1#*=}"
                     case "$_v" in
                         [A-Za-z_]*=*) ;;
                         *) die "--env takes NAME=VALUE, got $(sh_quote "$_v")" ;;
                     esac
                     EXTRA_ENV="$EXTRA_ENV$_v$_NL"; shift ;;
        --cmakeargs|--cmakeargs=*)
            barrier "--cmakeargs would replace the config's CMake flags rather than add to
    them: build-webkit takes one --cmakeargs, so the last one on the command
    line wins and '$CONFIG' would lose $(config_cmake_summary).
    Use --cmake instead, which is added to them:
        wk build$(in_workspace || printf ' %s' "$NAME") $CONFIG --cmake $(sh_quote "${1#*=}")"
                     _PASS+=("$1"); shift ;;
        # Everything after `--` is the build's, verbatim -- otherwise there
        # is no way to pass build-webkit an option this command also defines.
        --) shift; _PASS+=(${@+"$@"}); break ;;

        --sysroot|--sysroot=*)
            die "--sysroot is not implemented (docs/Nice to have/HANDOFF-cross-compile.md).
    This workspace is $ARCH; a --sysroot build would be a *cross* build from a
    native workspace, which is a different mechanism -- an aarch64 clang, -m32,
    CMAKE_LIBRARY_ARCHITECTURE and another rootfs to link against." ;;
        *) _PASS+=("$1"); shift ;;
    esac
done
set -- ${_PASS[@]+"${_PASS[@]}"}

[ -z "$NO_DEFAULTS" ] || TARGET_BUILD_ARGS=""

# --babysit: hand the whole thing to a detached loop (build/babysit.sh) that
# rebuilds after every fix a sandboxed Claude makes, and exit. Refused where
# `wk claude` would refuse (the fixer runs through it), and from inside a
# workspace, which has no host store or second sandbox.
if [ -n "$BABYSIT" ]; then
    in_workspace && die "--babysit runs on the host: it re-runs 'wk build' and starts
    Claude in the workspace, neither of which works from in here"
    case "$WK_TARGET_KIND" in
        remote) die "refusing to babysit on a remote target: the fixer is Claude, and
    a shared machine has no sandbox to run it in (the same rule as 'wk claude')" ;;
        local)  die "already inside a workspace -- run the build and claude directly" ;;
    esac

    WS=$(wk_ws_dir "$NAME")
    # The file is a claim, the process table is the fact (lib/detach.sh): a
    # "building" state whose pid is gone is last run's file, and starting a
    # second babysitter over it is right.
    if [ -f "$WS/babysit.status" ]; then
        _state=$(status_field "$WS/babysit.status" state)
        case "$_DETACH_RUNNING" in
            *" ${_state:-none} "*)
                _pid=$(status_field "$WS/babysit.status" pid)
                detach_alive "$WS/babysit.status" \
                    && die "a babysitter is already running for '$NAME' (pid $_pid, $_state).
    Follow it:  tail -f $WS/babysit.log" ;;
        esac
    fi

    if [ -n "$DRY" ]; then
        log "dry run -- nothing was built, no babysitter started."
        log "  would run detached: build/babysit.sh $NAME $CONFIG $BABYSIT \\"
        log "    ${WK_BABYSIT_ATTEMPTS:-5} '$BRANCH' $*"
        exit 0
    fi

    ensure_dir "$WS" >/dev/null
    _pid=$(detach_run "$WS/babysit.status" "$WS/babysit.log" -- \
        "$WK_ROOT/build/babysit.sh" "$NAME" "$CONFIG" "$BABYSIT" \
        "${WK_BABYSIT_ATTEMPTS:-5}" "$BRANCH" ${@+"$@"})
    info "babysitter started for $CONFIG in '$NAME' (pid $_pid, model $BABYSIT${BRANCH:+, branch $BRANCH})"
    log  "  it survives this terminal; up to ${WK_BABYSIT_ATTEMPTS:-5} fixes, then it closes itself"
    log  "  state:   wk status $NAME"
    log  "  follow:  tail -f $WS/babysit.log"
    log  "  report:  $WS/babysit.report"
    exit 0
fi

# --detach: hand the build to the machine that will run it and come back.
# A WebKit build is tens of minutes and the connection driving it is not:
# anything that kills the driver (a timeout, a closed laptop, a dropped ssh)
# takes the build with it, leaving `build.status` stuck at `running`.
# Where it detaches *to* needs no special-casing: a container build on a
# macOS host was already forwarded into the podman VM, so the nohup happens
# there; a remote target hands the command to that machine's own `wk`.
if [ -n "$DETACH" ]; then
    # _ALL_ARGS still has the workspace name the dispatcher already resolved
    # and dropped ($WK_NAME now, not $1); the recursive `wk build` this
    # reassembles needs it back on the front to resolve a name from.
    _det=()
    in_workspace || _det+=("$NAME")
    for _a in ${_ALL_ARGS[@]+"${_ALL_ARGS[@]}"}; do
        [ "$_a" = --detach ] && continue
        _det+=("$_a")
    done

    # Written before the child exists: the alternative is a window in which
    # `wk status` reads whatever the previous build left behind -- an "ok" or
    # a "failed" from an hour ago, answering for a build that hasn't run yet.
    STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    write_status running

    if t_has_wk && t_wk_detach build ${_det[@]+"${_det[@]}"} >/dev/null 2>&1; then
        info "building $CONFIG in '$NAME' on $TARGET, detached -- this end can go away"
    else
        # No status file passed here: the child rewrites build.status, and
        # liveness is the log's age (cmd/status), not a pid.
        _pid=$(detach_run "" "$WS/detached.log" -- \
            "$WK_ROOT/wk" build ${_det[@]+"${_det[@]}"})
        info "building $CONFIG in '$NAME', detached as pid $_pid -- this end can go away"
    fi
    log "  follow:  wk logs $NAME -f"
    log "  state:   wk status $NAME"
    exit 0
fi

# Shared boxes get the polite calculation: other people are building too.
POLITE=""
NICE=10
if [ "$WK_TARGET_KIND" = remote ]; then POLITE=1; NICE=19; fi

# Size the build from what the *target* has, not this machine's free memory:
# inside a container the kernel still reports the whole machine's
# MemAvailable, which the cgroup will OOM-kill mid-link for; a macOS VM's
# host memory has nothing to do with the guest's.
#
# For a remote target no local number means anything -- the driver's answers
# replace the measurement instead of capping it. See avail_mem_mb().
export_target_resources "$NAME"

# Extra CMake flags from the command line, read by config_build_env when it
# assembles WK_BUILD_CMAKE. An environment variable rather than a parameter
# because config_build_env already takes four positional arguments and is
# called from three places, only one of which has a command line at all.
WK_EXTRA_CMAKE="${EXTRA_CMAKE# }"
export WK_EXTRA_CMAKE

# The same, for the environment (--env). Read by config_build_env, which
# appends each line to CFG_ENV last so it overrides the config's own.
WK_EXTRA_ENV="$EXTRA_ENV"
export WK_EXTRA_ENV

# This target's own default build flags (WK_BUILD_ARGS in its conf, captured
# above as TARGET_BUILD_ARGS before --no-defaults could clear it). A name of
# its own, not WK_BUILD_ARGS itself: config_build_env already writes an
# environment variable of that name into CFG_ENV for the config's own
# --port/--release flags, and reusing it here would silently replace those
# rather than add to them.
WK_TARGET_BUILD_ARGS="$TARGET_BUILD_ARGS"
export WK_TARGET_BUILD_ARGS

# Flags win over the environment; both are read by config_build_env, which is
# what carries them into the target.
[ -z "$MEM_BUDGET" ] || { WK_MEM_BUDGET_MB="$MEM_BUDGET"; export WK_MEM_BUDGET_MB; }
[ -z "$MEM_FLOOR" ]  || { WK_MEM_FLOOR_MB="$MEM_FLOOR";   export WK_MEM_FLOOR_MB; }

# Where ccache keeps its cache inside the target. /ccache in a container, which
# is the bind-mounted store cache; a directory of our own on a machine we share
# with other people, whose cache is not ours to write to.
WK_CCACHE_DIR=$(t_ccache_dir "$NAME")
export WK_CCACHE_DIR

# A conf that still sets the old ceiling is not an error and is not obeyed
# either -- saying so where the job count is chosen is the only place it would
# be noticed.
[ -z "${WK_REMOTE_MAX_JOBS:-}" ] || \
    warn "WK_REMOTE_MAX_JOBS is set in $TARGET's conf and is ignored: the job count
  is derived per build from what that machine has free. Delete the line."

JOBS=$(explain_jobs "$POLITE")

# Everything above is resolution; everything below changes something. A dry run
# stops on the line between the two -- before the tooling sync and before the
# status file, so it cannot leave a workspace looking like it is building.
if [ -n "$DRY" ]; then
    config_build_env "$(t_src "$NAME")" "$JOBS" "$NICE" "$ARCH"
    ARCH_LABEL=$(arch_label "$ARCH")
    log "dry run -- nothing was built."
    log "  workspace: $NAME ($TARGET, $WS_STATE${ARCH_LABEL:+, $ARCH_LABEL})"
    [ -n "$BRANCH" ] && log "  branch:    $BRANCH (would be checked out first)"
    log "  config:    $CONFIG ($CFG_BUILDSYS${CFG_PORT:+ $CFG_PORT}${CFG_ARGS:+ $CFG_ARGS})"
    [ -n "${WK_TARGET_CMAKE:-}" ] && log "  machine:   $WK_TARGET_CMAKE (WK_TARGET_CMAKE, from $TARGET's conf)"
    [ -n "$TARGET_BUILD_ARGS" ] && log "  defaults:  $TARGET_BUILD_ARGS (WK_BUILD_ARGS, from $TARGET's conf; --no-defaults skips it)"
    [ -n "$WK_EXTRA_CMAKE" ] && log "  --cmake:   $WK_EXTRA_CMAKE (added to the config's)"
    [ -n "$WK_EXTRA_ENV" ] && log "  --env:     $(printf '%s' "$WK_EXTRA_ENV" | tr '\n' ' ')(overrides the config's)"
    [ $# -gt 0 ] && log "  passed on: $* (straight to build-webkit)"
    [ -n "$ARCH_LABEL" ] && log "  arch:      $ARCH_LABEL, native ($(arch_wrapper "$ARCH") $(arch_cflags "$ARCH"))"
    log "  src:       $(t_src "$NAME")"
    log "  build dir: $(config_build_dir "$(t_src "$NAME")")"
    log "  jobs:      $JOBS (nice $NICE)"
    log "  memory:    budget ${WK_MEM_BUDGET_MB:-$(( JOBS * ${WK_MB_PER_JOB:-1536} ))}MB, floor ${WK_MEM_FLOOR_MB:-2048}MB, watched every ${WK_MEM_INTERVAL:-30}s"
    log "  would run: env ${CFG_ENV[*]} $(t_tools "$NAME")/build/build-in-target.sh $*"

    # ...and the commands *that* runs, from the half that knows them
    # (WK_DRY_RUN in build/build-in-target.sh). Asked through the target's own
    # exec path, not reconstructed here: ionice, choom, cgroup clamps, the
    # Apple path's settings are all resolved inside the target, and rendering
    # them out here would be a second implementation that can disagree.
    #
    # t_exec, not t_exec_build: the build path takes that machine's build
    # lock, and a dry run shouldn't wait an hour behind somebody's link step.
    #
    # Guarded on the far copy understanding the flag -- not belt-and-braces,
    # the whole safety of the mechanism: a copy predating WK_DRY_RUN ignores
    # the variable and builds for real, so an old tree turns a dry run into a
    # real build-webkit inside somebody else's workspace.
    _bit="$(t_tools "$NAME")/build/build-in-target.sh"
    if ! t_exec "$NAME" grep -q WK_DRY_RUN "$_bit" 2>/dev/null; then
        warn "  the wk-tools in '$NAME' predates --dry-run's target half, so the commands"
        log  "  it would run cannot be asked for without risking a real build."
        log  "  push this tree there first:  wk sync --target $TARGET"
        exit 0
    fi
    if _cmd=$(t_exec "$NAME" env "${CFG_ENV[@]}" WK_DRY_RUN=1 \
            "$_bit" ${@+"$@"} 2>/dev/null); then
        log "  running:   $(printf '%s' "$_cmd" | tr -d '\r')"
    else
        warn "  could not ask '$NAME' itself what it would run -- the lines above are"
        log  "  this side's half of it. Is the workspace up? (wk status $NAME)"
    fi
    exit 0
fi

# One lock per mutated resource (rule 4): this workspace, for the rest of
# this process. Everything below writes to the checkout and status files,
# and two builds interleaved in one workspace corrupt both.
#
# After --dry-run and --babysit above, neither of which builds anything. A
# remote target locks here *and* on the far machine (targets/remote.sh): this
# serialises the workstation's own builds, that one the machine's.
hold_lock "ws-$NAME" -w "${WK_BUILD_LOCK_WAIT:-3600}"

# And the half the lock cannot cover: a job detached *into* the workspace
# outlives the command that started it, so it holds no lock out here
# (ws_busy_reason, lib/target.sh). A six-hour Yocto build sharing one
# checkout with this one would not survive it.
#
# A barrier, not a refusal: the evidence is a pid this end can't fully
# inspect, so a reused pid names a job that isn't really there -- only a
# person looking at it can tell. --force says so and proceeds.
if _busy=$(ws_busy_reason "$NAME"); then
    barrier "'$NAME' already has a detached job running in it: $_busy
    Two builds in one checkout corrupt both, and this one would be the second.
    See what it is:  wk logs $NAME --all
    Stop it:         wk sysimage build <profile> --stop   (for a Yocto stage)"
fi

# The branch, before anything is recorded about this build. checkout first,
# fetch only when the name is not already local -- a fetch per build would put
# a network round trip in front of every offline rebuild.
if [ -n "$BRANCH" ]; then
    info "checking out '$BRANCH' in '$NAME'"
    t_exec "$NAME" bash -c "cd $(sh_quote "$(t_src "$NAME")") && {
        git checkout -q $(sh_quote "$BRANCH") 2>/dev/null ||
        { git fetch -q origin $(sh_quote "$BRANCH") &&
          git checkout -q $(sh_quote "$BRANCH"); }; }" \
        || die "could not check out '$BRANCH' in '$NAME'"
fi

# Push the tooling in before anything else. A no-op for the container, which
# bind-mounts it; an rsync of differences for a VM.
#
# Deliberately ahead of the status file: anything that fails after
# `state=running` is written but before the build is reaped leaves the
# workspace looking like it is building forever.
t_sync_tools "$NAME"

STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
START_EPOCH=$(date +%s)
write_status running

# ccache is on: `--no-use-ccache` passed unconditionally by jscb-configure means
# the shared cache does nothing for JSC builds.
ARCH_LABEL=$(arch_label "$ARCH")
info "building $CONFIG${ARCH_LABEL:+ ($ARCH_LABEL)} in '$NAME' with -j$JOBS (nice $NICE)"
log  "  log: $LOG"
log  "  stall warning after ${WK_STALL_SECONDS}s of silence; abort after ${WK_ABORT_SECONDS}s"

# The build environment comes from one place, shared with the golden-base
# prebuild, so the two cannot drift into building subtly different things.
config_build_env "$(t_src "$NAME")" "$JOBS" "$NICE" "$ARCH"

# The exact command about to run, fetched the same way --dry-run gets it
# (build-in-target.sh's own WK_DRY_RUN rendering) so the two can never
# disagree, and printed before the build starts so it can be reproduced by
# hand outside wk without guessing at flags. Best-effort: this is a
# reproducibility courtesy, never a reason to hold up the build it describes.
_bit="$(t_tools "$NAME")/build/build-in-target.sh"
if _cmd=$(t_exec "$NAME" env "${CFG_ENV[@]}" WK_DRY_RUN=1 "$_bit" ${@+"$@"} 2>/dev/null); then
    log "running:   $(printf '%s' "$_cmd" | tr -d '\r')"
fi

set +e
# t_exec_build, not t_exec: on a shared machine the build is the one thing that
# has to be serialised against your own other builds, and the lock that does it
# must not sit on every small command as well.
run_watched "$LOG" -- \
    t_exec_build "$NAME" env "${CFG_ENV[@]}" \
        "$(t_tools "$NAME")/build/build-in-target.sh" "$@"
rc=$?
set -e

# What the memory watchdog saw, lifted out of the log it wrote it to. The
# log is the one channel that survives everything (a dropped ssh, a killed
# driver), and reading the markers back turns "the build died" into "killed
# for using 96 GB against a 94 GB budget" -- a mystery vs. a job count to fix.
MEM_PEAK=$(grep -a 'wk: memory: peak' "$LOG" 2>/dev/null | tail -1 \
           | sed -n 's/.*peak \([0-9]*\)MB.*/\1/p' || true)
MEM_KILLED=""
grep -aq 'wk: MEMORY LIMIT' "$LOG" 2>/dev/null && MEM_KILLED=1

ELAPSED=$(( $(date +%s) - START_EPOCH ))
MINS=$(( ELAPSED / 60 )); SECS=$(( ELAPSED % 60 ))

echo >&2
case $rc in
0)
    write_status ok 0
    info "BUILD OK  $CONFIG${ARCH_LABEL:+ ($ARCH_LABEL)} in '$NAME'  (${MINS}m${SECS}s)"
    ;;
124)
    write_status stalled 124
    die "BUILD STALLED  $CONFIG in '$NAME'  (killed after ${MINS}m${SECS}s with no output)
    log: $LOG
    A stall is usually memory pressure -- check 'wk status $NAME' for OOM kills."
    ;;
*)
    if [ -n "$MEM_KILLED" ]; then
        write_status oom "$rc"
        warn "BUILD KILLED FOR MEMORY  $CONFIG in '$NAME'  (after ${MINS}m${SECS}s)"
        grep -a 'wk: MEMORY LIMIT' "$LOG" | tail -2 | sed 's/^wk: /  /' >&2
        log "  peak ${MEM_PEAK:-?}MB. Fewer jobs: WK_MB_PER_JOB=3072 wk build $NAME $CONFIG"
        log "  full log: $LOG"
        exit "$rc"
    fi
    write_status failed "$rc"
    warn "BUILD FAILED  $CONFIG in '$NAME'  (exit $rc after ${MINS}m${SECS}s)"
    log "first error(s):"
    first_error "$LOG" | sed 's/^/  /' || true

    # One failure that reads as a broken checkout and isn't: Xcode's build
    # description (WebKitBuild/<config>/XCBuildData) can be left unusable by
    # an interrupted build -- exit 65, "unable to open .../manifest.json".
    # Nothing in the source is wrong; deleting the derived directory is the
    # whole repair, but named rather than done automatically, since this is
    # somebody's build tree.
    if grep -q 'xcbuilddata/manifest.json' "$LOG" 2>/dev/null; then
        log ""
        warn "that is Xcode's build description, not your code."
        log  "  It is derived, and an interrupted build can leave it unusable."
        log  "  The products survive; only the plan has to be rebuilt:"
        log  "    wk enter $NAME rm -rf $(t_src "$NAME")/WebKitBuild/$(basename "$(config_build_dir "$(t_src "$NAME")")")/XCBuildData"
        log  "    wk build $NAME $CONFIG"
    fi

    log ""
    log "  full log: $LOG"
    exit "$rc"
    ;;
esac
