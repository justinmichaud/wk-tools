#!/usr/bin/env bash
#
# wk build <workspace> <config> -- build WebKit or JSC.
#
# The reason to use this rather than calling build-webkit directly: the job
# count is derived from memory actually available right now, and the build runs
# where the scheduler and the OOM killer will pick it over your desktop
# session. A plain `ninja -j$(nproc)` on a WebKit link step is the reliable way
# to make a machine stop responding.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/watchdog.sh"
. "$WK_ROOT/lib/target.sh"
. "$WK_ROOT/lib/arch.sh"
. "$WK_ROOT/build/configs.sh"

# Kept whole, before any of the parsing below consumes it: `--detach` re-runs
# this same command on the machine that will do the work, and the only
# reliable way to reproduce an argument list is to have kept it.
_ALL_ARGS=("$@")

if [ "${1:-}" = --list ]; then
    log "available configs:"
    config_list | sed 's/^/  /'
    exit 0
fi

# --dry-run is accepted on either side of the config, because both readings are
# natural and the name/config parse below would otherwise consume it as one or
# the other. See the flag itself further down.
DRY=""
[ "${1:-}" = --dry-run ] && { DRY=1; shift; }

# The workspace name is optional inside a workspace: there is exactly one, it is
# this machine, and `wk build <config>` is the form claude/CLAUDE.md documents
# and the only one available in there. The leading argument is consumed as a
# name only when it really is this workspace's own name -- and not when that
# word is also a config, so a workspace named after one still builds.
NAME="${1:-}"; CONFIG="${2:-}"
if in_workspace && { [ "$NAME" != "$(wk_self)" ] || config_load "$NAME" 2>/dev/null; }; then
    # A name *and* a config, where the name is not this workspace's, is the host
    # form typed in the wrong place. Read literally it would build this
    # workspace and report the config as unknown, which explains neither half.
    if [ -n "$CONFIG" ] && config_load "$CONFIG" 2>/dev/null; then
        die "no such workspace: $NAME -- this is workspace '$(wk_self)', so the
    form in here is 'wk build $CONFIG' with no name"
    fi
    NAME=$(wk_self); CONFIG="${1:-}"
    shift 1 2>/dev/null || true
else
    shift 2 2>/dev/null || true
fi

# --dry-run: resolve everything and print what would happen, build nothing.
#
# Here because a cold Apple-port build is ~99 minutes, so "does `wk build` reach
# the right target with the right config and job count" cannot be answered by
# running one -- which is exactly the question a workspace's first in-workspace
# build asks. Taken off what is left of the argument list, which is otherwise
# passed through to the build untouched.
[ "${1:-}" = --dry-run ] && { DRY=1; shift; }

require_name "$NAME"
[ -n "$CONFIG" ] || {
    if in_workspace; then log "usage: wk build <config>"
    else log "usage: wk build <workspace> <config>"; fi
    config_list | sed 's/^/  /'; exit 2
}

config_load "$CONFIG" || die "unknown config '$CONFIG' (wk build --list)"

TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

# The lifecycle, not the environment (ws_state in lib/target.sh): a container
# somebody removed by hand is not "no such workspace", and answering that sends
# a person looking for a name they typed correctly. Every other state gets its
# own words from wait_ready further down; `absent` is the one that has to be
# refused before the config, the job count and the flags are resolved.
WS_STATE=$(ws_state "$NAME")
case "$WS_STATE" in
    absent) die "no such workspace: $NAME" ;;
    # Neither of these gets better by resolving a config and a job count first
    # -- one needs a repair and the other needs a network -- and wait_ready is
    # where both are worded, so it is asked now rather than at the gate below.
    # It does not wait for either.
    broken|unreachable) wait_ready "$NAME" ;;
esac

# The workspace's own architecture, from the driver rather than from a flag.
# It was fixed when the workspace was created and cannot change afterwards --
# the container is armhf or it is not -- so there is nothing to pass and
# nothing to get wrong per build. The flags it implies are in lib/arch.sh.
ARCH=$(t_arch "$NAME")

# Our own flags are taken off the argument list; everything left is passed
# through to the build untouched.
#
# --sysroot is reserved, so that the day it exists it cannot be confused with
# --arch: --arch is what the workspace runs; --sysroot would be what a build
# targets from a native workspace. They are different mechanisms with
# different flags (see lib/arch.sh), and silently passing this through to
# build-webkit -- which has no such option -- would fail 40 lines into a perl
# script.
BABYSIT=""; BRANCH=""; EXTRA_CMAKE=""; MEM_BUDGET=""; MEM_FLOOR=""; DETACH=""; _PASS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --detach)    DETACH=1; shift ;;
        --babysit)   BABYSIT="${WK_BABYSIT_MODEL:-haiku}"; shift ;;
        --babysit=*) BABYSIT="${1#*=}"; shift ;;
        --branch)    BRANCH="${2:-}"; [ -n "$BRANCH" ] || die "--branch needs a name"; shift 2 ;;
        --branch=*)  BRANCH="${1#*=}"; shift ;;

        # Extra CMake flags for this build, *added* to the config's own.
        # Repeatable, and quoted as one argument per use:
        #
        #   wk build ws jsc-release --cmake '-DENABLE_X=ON -DENABLE_Y=OFF'
        #
        # This exists because the obvious spelling is a trap. build-webkit
        # takes --cmakeargs as a single option, so a second one on the command
        # line replaces the first: passing --cmakeargs by hand silently drops
        # every flag the config sets (DEVELOPER_MODE, USE_LIBBACKTRACE, the
        # architecture's flags) and builds something else entirely, with no
        # sign that it happened. Appended last, so where the same -D appears
        # twice the one typed here wins -- cmake takes the last value.
        # The memory watchdog's two numbers, as flags rather than only as
        # environment: a container build on a macOS host is forwarded into the
        # podman VM over ssh, and only what is on the command line survives
        # that. Both default to the derivation in build/build-in-target.sh.
        --mem-budget)  MEM_BUDGET="${2:-}"; [ -n "$MEM_BUDGET" ] || die "--mem-budget needs MB"; shift 2 ;;
        --mem-budget=*) MEM_BUDGET="${1#*=}"; shift ;;
        --mem-floor)   MEM_FLOOR="${2:-}"; [ -n "$MEM_FLOOR" ] || die "--mem-floor needs MB"; shift 2 ;;
        --mem-floor=*)  MEM_FLOOR="${1#*=}"; shift ;;

        --cmake)     [ -n "${2:-}" ] || die "--cmake needs at least one flag"
                     EXTRA_CMAKE="$EXTRA_CMAKE $2"; shift 2 ;;
        --cmake=*)   EXTRA_CMAKE="$EXTRA_CMAKE ${1#*=}"; shift ;;
        --cmakeargs|--cmakeargs=*)
            barrier "--cmakeargs would replace the config's CMake flags rather than add to
    them: build-webkit takes one --cmakeargs, so the last one on the command
    line wins and '$CONFIG' would lose $(config_cmake_summary).
    Use --cmake instead, which is added to them:
        wk build$(in_workspace || printf ' %s' "$NAME") $CONFIG --cmake $(sh_quote "${1#*=}")"
                     _PASS+=("$1"); shift ;;
        # Everything after `--` is the build's, verbatim -- including words
        # that would otherwise be read as ours. Without it there is no way to
        # pass build-webkit an option this command also defines.
        --) shift; _PASS+=(${@+"$@"}); break ;;

        --sysroot|--sysroot=*)
            die "--sysroot is not implemented (docs/HANDOFF-cross-compile.md).
    This workspace is $ARCH; a --sysroot build would be a *cross* build from a
    native workspace, which is a different mechanism -- an aarch64 clang, -m32,
    CMAKE_LIBRARY_ARCHITECTURE and another rootfs to link against." ;;
        *) _PASS+=("$1"); shift ;;
    esac
done
set -- ${_PASS[@]+"${_PASS[@]}"}

# --babysit: hand the whole thing to a detached loop (build/babysit.sh) that
# rebuilds after every fix a sandboxed Claude makes, and exit. nohup and no
# terminal, so the loop belongs to nobody's ssh session; `wk status` renders
# its state file and the report says afterwards what was done.
#
# Refused where `wk claude` would refuse -- the fixer runs through it, so the
# sandbox rules are its rules -- and refused from inside a workspace, where
# there is no host store for the state and no second sandbox to start.
if [ -n "$BABYSIT" ]; then
    in_workspace && die "--babysit runs on the host: it re-runs 'wk build' and starts
    Claude in the workspace, neither of which works from in here"
    case "$WK_TARGET_KIND" in
        remote) die "refusing to babysit on a remote target: the fixer is Claude, and
    a shared machine has no sandbox to run it in (the same rule as 'wk claude')" ;;
        local)  die "already inside a workspace -- run the build and claude directly" ;;
    esac

    WS=$(wk_ws_dir "$NAME")
    if [ -f "$WS/babysit.status" ]; then
        _pid=$(awk -F= '/^pid=/{print $2}' "$WS/babysit.status")
        _state=$(awk -F= '/^state=/{print $2}' "$WS/babysit.status")
        case "$_state" in
            starting|building|fixing)
                [ -n "$_pid" ] && kill -0 "$_pid" 2>/dev/null \
                    && die "a babysitter is already running for '$NAME' (pid $_pid, $_state).
    Follow it:  tail -f $WS/babysit.log" ;;
        esac
    fi

    if [ -n "$DRY" ]; then
        log "dry run -- nothing was built, no babysitter started."
        log "  would run detached: build/babysit.sh $NAME $CONFIG $BABYSIT \\"
        log "    ${WK_BABYSIT_ATTEMPTS:-5} '$BRANCH' $*"
        exit 0
    fi

    ensure_dir "$WS" >/dev/null
    nohup "$WK_ROOT/build/babysit.sh" "$NAME" "$CONFIG" "$BABYSIT" \
        "${WK_BABYSIT_ATTEMPTS:-5}" "$BRANCH" ${@+"$@"} \
        > "$WS/babysit.log" 2>&1 < /dev/null &
    _pid=$!
    info "babysitter started for $CONFIG in '$NAME' (pid $_pid, model $BABYSIT${BRANCH:+, branch $BRANCH})"
    log  "  it survives this terminal; up to ${WK_BABYSIT_ATTEMPTS:-5} fixes, then it closes itself"
    log  "  state:   wk status $NAME"
    log  "  follow:  tail -f $WS/babysit.log"
    log  "  report:  $WS/babysit.report"
    exit 0
fi

# --detach: hand the build to the machine that will run it and come back.
#
# A WebKit build is tens of minutes and the connection driving it is not.
# Anything that kills the driver -- a tool call's timeout, a closed laptop, a
# dropped ssh -- takes the build with it today, at whatever object it had
# reached, and leaves `build.status` still saying `running`. Detaching moves
# the process to the far end of that fragility: the machine that builds owns
# it, and this end is free to go away.
#
# Where it detaches *to* depends on where the work is, and this needs no
# special-casing because of where this file is already running: a container
# build on a macOS host was forwarded into the podman VM before it got here,
# so the nohup happens in the VM; a remote target hands the command to that
# machine's own `wk` over ssh and drops the connection.
#
# Deliberately after --dry-run and the babysitter, which detach in their own
# ways, and before anything that writes: the detached run does all of it
# again, including taking the lock.
if [ -n "$DETACH" ]; then
    _det=()
    for _a in ${_ALL_ARGS[@]+"${_ALL_ARGS[@]}"}; do
        [ "$_a" = --detach ] && continue
        _det+=("$_a")
    done

    if t_has_wk && t_wk_detach build ${_det[@]+"${_det[@]}"} >/dev/null 2>&1; then
        info "building $CONFIG in '$NAME' on $TARGET, detached -- this end can go away"
    else
        WS=$(wk_ws_dir "$NAME"); ensure_dir "$WS" >/dev/null
        nohup "$WK_ROOT/wk" build ${_det[@]+"${_det[@]}"} \
            > "$WS/detached.log" 2>&1 < /dev/null &
        info "building $CONFIG in '$NAME', detached as pid $! -- this end can go away"
    fi
    log "  follow:  wk logs $NAME -f"
    log "  state:   wk status $NAME"
    exit 0
fi

# Shared boxes get the polite calculation: other people are building too.
POLITE=""
NICE=10
if [ "$WK_TARGET_KIND" = remote ]; then POLITE=1; NICE=19; fi

# Size the build from what the *target* has, not from this machine's free
# memory. Inside a container the kernel still reports the whole machine's
# MemAvailable, so deriving jobs from it picks a number the cgroup will
# OOM-kill mid-link; and for a macOS VM this half runs on the host, whose
# memory has nothing to do with what the guest was booted with.
#
# For a remote target none of the local numbers mean anything at all -- it is
# somebody else's machine, reached over ssh -- so the driver's answers replace
# the measurement instead of capping it, and the load average has to come from
# over there as well. See avail_mem_mb().
if [ "$WK_TARGET_KIND" = remote ]; then
    WK_AVAIL_MB=$(t_mem_mb "$NAME")
    WK_CGROUP_CORES=$(t_cores "$NAME")
    WK_LOAD=$(t_load "$NAME")
    export WK_AVAIL_MB WK_CGROUP_CORES WK_LOAD
else
    WK_CGROUP_MB=$(t_mem_mb "$NAME")
    WK_CGROUP_CORES=$(t_cores "$NAME")
    export WK_CGROUP_MB WK_CGROUP_CORES
fi

# Extra CMake flags from the command line, read by config_build_env when it
# assembles WK_BUILD_CMAKE. An environment variable rather than a parameter
# because config_build_env already takes four positional arguments and is
# called from three places, only one of which has a command line at all.
WK_EXTRA_CMAKE="${EXTRA_CMAKE# }"
export WK_EXTRA_CMAKE

# Flags win over the environment; both are read by config_build_env, which is
# what carries them into the target.
[ -z "$MEM_BUDGET" ] || { WK_MEM_BUDGET_MB="$MEM_BUDGET"; export WK_MEM_BUDGET_MB; }
[ -z "$MEM_FLOOR" ]  || { WK_MEM_FLOOR_MB="$MEM_FLOOR";   export WK_MEM_FLOOR_MB; }

# Where ccache keeps its cache inside the target. /ccache in a container, which
# is the bind-mounted store cache; a directory of our own on a machine we share
# with other people, whose cache is not ours to write to.
WK_CCACHE_DIR=$(t_ccache_dir "$NAME")
export WK_CCACHE_DIR

# A conf that still sets the old ceiling is not an error and is not obeyed
# either -- saying so where the job count is chosen is the only place it would
# be noticed.
[ -z "${WK_REMOTE_MAX_JOBS:-}" ] || \
    warn "WK_REMOTE_MAX_JOBS is set in $TARGET's conf and is ignored: the job count
  is derived per build from what that machine has free. Delete the line."

JOBS=$(explain_jobs "$POLITE")

# Everything above is resolution; everything below changes something. A dry run
# stops on the line between the two -- before the tooling sync and before the
# status file, so it cannot leave a workspace looking like it is building.
if [ -n "$DRY" ]; then
    config_build_env "$(t_src "$NAME")" "$JOBS" "$NICE" "$ARCH"
    ARCH_LABEL=$(arch_label "$ARCH")
    log "dry run -- nothing was built."
    log "  workspace: $NAME ($TARGET, $WS_STATE${ARCH_LABEL:+, $ARCH_LABEL})"
    [ -n "$BRANCH" ] && log "  branch:    $BRANCH (would be checked out first)"
    log "  config:    $CONFIG ($CFG_BUILDSYS${CFG_PORT:+ $CFG_PORT}${CFG_ARGS:+ $CFG_ARGS})"
    [ -n "${WK_TARGET_CMAKE:-}" ] && log "  machine:   $WK_TARGET_CMAKE (WK_TARGET_CMAKE, from $TARGET's conf)"
    [ -n "$WK_EXTRA_CMAKE" ] && log "  --cmake:   $WK_EXTRA_CMAKE (added to the config's)"
    [ $# -gt 0 ] && log "  passed on: $* (straight to build-webkit)"
    [ -n "$ARCH_LABEL" ] && log "  arch:      $ARCH_LABEL, native ($(arch_wrapper "$ARCH") $(arch_cflags "$ARCH"))"
    log "  src:       $(t_src "$NAME")"
    log "  build dir: $(config_build_dir "$(t_src "$NAME")")"
    log "  jobs:      $JOBS (nice $NICE)"
    log "  memory:    budget ${WK_MEM_BUDGET_MB:-$(( JOBS * ${WK_MB_PER_JOB:-1536} ))}MB, floor ${WK_MEM_FLOOR_MB:-2048}MB, watched every ${WK_MEM_INTERVAL:-30}s"
    log "  would run: env ${CFG_ENV[*]} $(t_tools "$NAME")/build/build-in-target.sh $*"
    exit 0
fi

# One gate, before anything is written: a build must not start on a workspace
# that is still being created (lib/target.sh, wait_ready). It returns at once
# for a finished workspace, waits while a detached `wk new` is still working,
# and refuses -- naming the repair -- for the three states no amount of waiting
# fixes: a creation whose driver is gone, an environment removed from under the
# record, and a machine that will not answer.
#
# Bounded, because this is a build and not a watch: a creation that has not
# finished in half an hour is something to look at rather than to keep waiting
# on. `--babysit` inherits the gate for free, since it re-runs this command.
wait_ready "$NAME" "${WK_BUILD_READY_WAIT:-1800}"

# One lock per mutated resource (rule 4): this workspace, for the rest of this
# process. Everything above resolves and reports; everything below writes to
# the checkout and to the status files, and two builds interleaved in one
# workspace corrupt both the build directory and the record of it.
#
# Taken after --dry-run and after the --babysit dispatch above: neither of
# those builds anything, and the babysitter re-runs `wk build`, which takes
# this lock itself for each attempt. A remote target locks here *and* on the
# far machine (targets/remote.sh) -- this one serialises this workstation's own
# builds, that one serialises the machine's.
hold_lock "ws-$NAME" -w "${WK_BUILD_LOCK_WAIT:-3600}"

# The branch, before anything is recorded about this build. checkout first,
# fetch only when the name is not already local -- a fetch per build would put
# a network round trip in front of every offline rebuild.
if [ -n "$BRANCH" ]; then
    info "checking out '$BRANCH' in '$NAME'"
    t_exec "$NAME" bash -c "cd $(sh_quote "$(t_src "$NAME")") && {
        git checkout -q $(sh_quote "$BRANCH") 2>/dev/null ||
        { git fetch -q origin $(sh_quote "$BRANCH") &&
          git checkout -q $(sh_quote "$BRANCH"); }; }" \
        || die "could not check out '$BRANCH' in '$NAME'"
fi

# Push the tooling in before anything else. A no-op for the container, which
# bind-mounts it; an rsync of differences for a VM.
#
# Deliberately ahead of the status file: anything that fails after
# `state=running` is written but before the build is reaped leaves the
# workspace looking like it is building forever.
t_sync_tools "$NAME"

WS=$(wk_ws_dir "$NAME")
LOG="$WS/build.log"
STATUS="$WS/build.status"

STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
START_EPOCH=$(date +%s)

# Written here, and -- for a target that is a machine of its own -- pushed
# there too, so that `wk status` gets the same answer from either end instead
# of whichever half of the truth it is standing on. t_state_put is a no-op
# everywhere else.
write_status() {
    local content
    content=$(cat <<EOF
state=$1
config=$CONFIG
arch=$ARCH
exit=${2:-}
started=$STARTED
finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)
seconds=$(( $(date +%s) - START_EPOCH ))
log=$LOG
peak_mb=${MEM_PEAK:-}
EOF
)
    printf '%s\n' "$content" > "$STATUS"
    printf '%s\n' "$content" | t_state_put "$NAME"
}

RUNNING=$(printf 'state=running\nconfig=%s\narch=%s\nstarted=%s\nlog=%s\n' \
    "$CONFIG" "$ARCH" "$STARTED" "$LOG")
printf '%s\n' "$RUNNING" > "$STATUS"
printf '%s\n' "$RUNNING" | t_state_put "$NAME"

# ccache is on. jscb-configure used to pass --no-use-ccache unconditionally,
# which meant the shared cache never did anything for JSC builds.
ARCH_LABEL=$(arch_label "$ARCH")
info "building $CONFIG${ARCH_LABEL:+ ($ARCH_LABEL)} in '$NAME' with -j$JOBS (nice $NICE)"
log  "  log: $LOG"
log  "  stall warning after ${WK_STALL_SECONDS}s of silence; abort after ${WK_ABORT_SECONDS}s"

# The build environment comes from one place, shared with the golden-base
# prebuild, so the two cannot drift into building subtly different things.
config_build_env "$(t_src "$NAME")" "$JOBS" "$NICE" "$ARCH"

set +e
# t_exec_build, not t_exec: on a shared machine the build is the one thing that
# has to be serialised against your own other builds, and the lock that does it
# must not sit on every small command as well.
run_watched "$LOG" -- \
    t_exec_build "$NAME" env "${CFG_ENV[@]}" \
        "$(t_tools "$NAME")/build/build-in-target.sh" "$@"
rc=$?
set -e

# What the memory watchdog saw, lifted out of the log it wrote it to.
#
# The log is the one channel that survives everything: a dropped ssh, a killed
# driver, a build started from the other end. Reading the markers back here is
# what turns "the build died" into "the build was killed for using 96 GB
# against a 94 GB budget", which is the difference between a mystery and a
# job count to change.
MEM_PEAK=$(grep -a 'wk: memory: peak' "$LOG" 2>/dev/null | tail -1 \
           | sed -n 's/.*peak \([0-9]*\)MB.*/\1/p' || true)
MEM_KILLED=""
grep -aq 'wk: MEMORY LIMIT' "$LOG" 2>/dev/null && MEM_KILLED=1

ELAPSED=$(( $(date +%s) - START_EPOCH ))
MINS=$(( ELAPSED / 60 )); SECS=$(( ELAPSED % 60 ))

echo >&2
case $rc in
0)
    write_status ok 0
    info "BUILD OK  $CONFIG${ARCH_LABEL:+ ($ARCH_LABEL)} in '$NAME'  (${MINS}m${SECS}s)"
    ;;
124)
    write_status stalled 124
    die "BUILD STALLED  $CONFIG in '$NAME'  (killed after ${MINS}m${SECS}s with no output)
    log: $LOG
    A stall is usually memory pressure -- check 'wk status $NAME' for OOM kills."
    ;;
*)
    if [ -n "$MEM_KILLED" ]; then
        write_status oom "$rc"
        warn "BUILD KILLED FOR MEMORY  $CONFIG in '$NAME'  (after ${MINS}m${SECS}s)"
        grep -a 'wk: MEMORY LIMIT' "$LOG" | tail -2 | sed 's/^wk: /  /' >&2
        log "  peak ${MEM_PEAK:-?}MB. Fewer jobs: WK_MB_PER_JOB=3072 wk build $NAME $CONFIG"
        log "  full log: $LOG"
        exit "$rc"
    fi
    write_status failed "$rc"
    warn "BUILD FAILED  $CONFIG in '$NAME'  (exit $rc after ${MINS}m${SECS}s)"
    log "first error(s):"
    first_error "$LOG" | sed 's/^/  /' || true
    log ""
    log "  full log: $LOG"
    exit "$rc"
    ;;
esac
