#!/usr/bin/env bash
#
# wk vm <sub> -- disposable macOS VMs for building the Apple ports.
#
# macOS has no container primitive for macOS userspace -- Apple's `container`
# CLI runs Linux containers -- so isolation for an Apple-port build means a
# virtual machine, and there is no lighter option.
#
# This is lifecycle only. Everything else -- build, test, run, claude, rm --
# goes through the ordinary commands, because `wk new <name> --target vm`
# registers the target and they resolve it from there. `wk vm new` is a
# shorthand for that one case.
#
# `wk vm base` is the exception that is not lifecycle-per-workspace: the golden
# guest every workspace is cloned from. It is built once (hours), fast-forwarded
# week to week (--refresh), remade (--rebuild) or erased (--rm) -- and it is by
# a wide margin the largest thing wk stores on a macOS host, which `wk disk`
# reports and `wk help disk` explains.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

load_target vm

is_macos || die "macOS VMs need a macOS host (Virtualization.framework)"

# The address changes on every boot, so the alias is rewritten at start rather
# than written once at creation. Zed and plain `ssh wk-<name>` then both work
# without anyone having to look an IP up.
_write_alias() {
    ssh_alias_set "$1" "$2" "$WK_VM_USER" "$WK_VM_KEY"
    info "ssh alias wk-$1 -> $WK_VM_USER@$2"
}

SUB="${1:-ls}"; shift || true

case "$SUB" in
ls)
    printf '%-20s %s\n' NAME STATE
    # t_list is tab-separated so it stays machine-readable; the columns are a
    # presentation concern and belong here, not in the driver.
    t_list 2>/dev/null | awk -F'\t' '{printf "%-20s %s\n", $1, $2}' || true
    ;;
new)
    NAME="${1:-}"; require_name "$NAME"
    t_create "$NAME"
    target_register "$NAME" vm
    info "created; start it with: wk vm start $NAME"
    ;;
start)
    NAME="${1:-}"; require_name "$NAME"
    ip=$(t_start "$NAME")
    _write_alias "$NAME" "$ip"
    info "$NAME is up at $ip"
    log  "  wk build $NAME mac-release"
    log  "  zed ssh://wk-$NAME$(t_src "$NAME")"
    ;;
stop)
    NAME="${1:-}"; require_name "$NAME"
    t_stop "$NAME"
    ;;
ip)
    NAME="${1:-}"; require_name "$NAME"
    t_ssh_host "$NAME" || die "'$NAME' is not running"
    ;;
enter)
    NAME="${1:-}"; require_name "$NAME"
    t_enter "$NAME"
    ;;
sync)
    # Push the current working tree of wk-tools into a running guest. The same
    # thing `wk build` does first, exposed on its own for when you are editing
    # this repo and want the change in the guest without starting a build.
    NAME="${1:-}"; require_name "$NAME"
    t_sync_tools "$NAME"
    info "synced wk-tools into $NAME"
    ;;
base)
    # The golden image: pulled, provisioned and shut down once, then cloned for
    # every workspace. Nothing here is ever repeated per workspace, which is
    # what makes `wk vm new` fast.
    case "${1:-}" in
    --rebuild)
        # Throws away the guest and re-pulls nothing -- the OCI cache is still
        # there -- but does redo the WebKit clone and the installers.
        confirm "delete and rebuild the golden base VM '$WK_VM_BASE'?" || die "aborted"
        _tart delete "$WK_VM_BASE" 2>/dev/null || true
        _ensure_base
        ;;
    --rm)
        # Erasing the largest single thing on the machine, which is why it is a
        # command rather than a note in the docs: 162 GB measured on this host,
        # and nothing else here comes close.
        #
        # Two artifacts, asked about separately because they cost differently to
        # get back: the golden guest (hours -- Xcode, a checkout and a full
        # mac-release prebuild) and the pulled OCI image it was cloned from (a
        # download). Existing workspaces are unaffected either way: a `tart
        # clone` is an independent guest, and APFS keeps the blocks alive for as
        # long as anything references them.
        _base_exists || die "no golden base '$WK_VM_BASE' on this machine -- nothing to erase.
    'wk vm base' builds one; 'wk disk' says what everything here costs."
        sz=$(du -sh "${TART_HOME:-$HOME/.tart}/vms/$WK_VM_BASE" 2>/dev/null | cut -f1 | tr -d ' ' || echo '?')
        confirm "delete the golden base VM '$WK_VM_BASE' ($sz)? rebuilding it is hours" \
            || die "aborted -- nothing was changed"
        _tart delete "$WK_VM_BASE"
        info "deleted '$WK_VM_BASE' -- existing vm workspaces are unaffected"
        log  "  'wk vm base' builds it again; until then 'wk vm new' has nothing to clone"

        cache="${TART_HOME:-$HOME/.tart}/cache"
        if [ -d "$cache" ] && [ -n "$(ls -A "$cache" 2>/dev/null)" ]; then
            csz=$(du -sh "$cache" 2>/dev/null | cut -f1 | tr -d ' ' || echo '?')
            if confirm "also drop the pulled image cache ($csz)? it is re-downloadable"; then
                _tart prune --space-budget 0
                info "pruned the image cache"
            else
                log "  kept: $cache"
            fi
        fi
        exit 0
        ;;
    --refresh)
        # The cheap one, and the one you actually want week to week: boot the
        # existing base, fast-forward its checkout, shut it down. New
        # workspaces then start from current main instead of from whenever the
        # base was first built. Existing workspaces are unaffected -- they are
        # already independent clones.
        _base_exists || die "no golden base yet -- run 'wk vm base'"
        _provision_base
        ;;
    "")
        _ensure_base
        ;;
    *)
        die "usage: wk vm base [--refresh|--rebuild|--rm]"
        ;;
    esac
    info "golden base '$WK_VM_BASE' is ready"
    ;;
rm)
    NAME="${1:-}"; require_name "$NAME"
    confirm "delete macOS VM '$NAME'?" || die "aborted"
    t_destroy "$NAME"
    ssh_alias_remove "$NAME"
    target_forget "$NAME"
    ;;
*)
    die "usage: wk vm ls|new|start|stop|ip|enter|sync|rm <name>
       wk vm base [--refresh|--rebuild|--rm]"
    ;;
esac
