#!/usr/bin/env bash
#
# wk version -- which wk-tools this machine is running
# wk: where=local name=none readonly group=hosts
#
# Every machine in the fleet runs its own copy of this repository: a git
# checkout on a build box or a macOS guest (lib/tools.sh puts a commit there),
# a file copy inside the podman VM. Either goes stale silently.
#
# One identity: the commit, plus whether tracked files have been changed
# since. `sha` is `-` where the copy is not a checkout (the podman VM); dirty
# is judged on tracked files only, since untracked and ignored files (a
# .DS_Store, a __pycache__, a per-machine conf) differ legitimately between
# two checkouts of the same commit.
#
# Derived on every call; nothing is written down.

set -euo pipefail
# lib/common.sh is always this script's own, sourced by its own location;
# WK_ROOT -- the tree reported on -- keeps whatever the caller already set
# (lib/common.sh's own default), which lets a test point it at a scratch
# checkout with no lib/ of its own.
. "$(cd "$(dirname "$0")/.." && pwd)/lib/common.sh"

git_sha() {
    git -C "$WK_ROOT" rev-parse HEAD 2>/dev/null || echo -
}

git_dirty() {
    git -C "$WK_ROOT" rev-parse HEAD >/dev/null 2>&1 || { echo unknown; return 0; }
    [ -z "$(git -C "$WK_ROOT" status --porcelain --untracked-files=no 2>/dev/null)" ] && echo no || echo yes
}

case "${1:-}" in
'')
    printf 'sha=%s\n'   "$(git_sha)"
    printf 'dirty=%s\n' "$(git_dirty)"
    ;;
*) die "usage: wk version; see wk version -h" ;;
esac
