#!/usr/bin/env python3
#
# wk version -- which wk-tools this machine is running
# wk: where=local name=none readonly group=hosts
#
# Prints two fields, derived on every call:
#
#   sha     the commit HEAD is at, or `-` where the copy is not a git checkout
#   dirty   yes/no/unknown, judged on tracked files only

import os
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk.machine import Local  # noqa: E402


def main():
    git = Local()
    head = git.run(["git", "-C", ROOT, "rev-parse", "HEAD"])
    if not head.ok:
        print("sha=-")
        print("dirty=unknown")
        return 0
    status = git.run(["git", "-C", ROOT, "status", "--porcelain", "--untracked-files=no"])
    print("sha=%s" % head.out.strip())
    print("dirty=%s" % ("no" if status.ok and not status.out.strip() else "yes"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
