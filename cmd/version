#!/usr/bin/env bash
#
# wk version [--tree] -- which wk-tools this machine is running
# wk: where=local name=none readonly group=hosts
#
# Every machine in the fleet runs an rsynced *copy* of this repository,
# which goes stale silently and fails in confusing ways.
#
# Two identifiers, since neither is enough on its own:
#
#   sha     the git commit -- only the workstation has one (copies are
#           rsynced with --exclude .git), so this is `-` elsewhere and says
#           nothing about uncommitted edits by itself.
#   tree    a hash of the file contents, computed identically everywhere.
#           Answers "is that machine running what I am", uncommitted work included.
#
# Both are derived on every call; nothing is written down.
#
#   wk version            the two identifiers, one per line
#   wk version --tree     just the tree hash (what a caller compares)

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"

# macOS ships `shasum` (perl) and no `sha256sum`; Fedora CoreOS and Ubuntu
# ship both. A *command*, not a function, since xargs has to exec it.
if have sha256sum;  then SHA256=sha256sum
elif have shasum;   then SHA256="shasum -a 256"
else die "no sha256 program on this machine (sha256sum or shasum)"
fi

_sha256() { $SHA256; }

# Paths are relative to the root, since hashing absolute paths would make
# two identical trees look different. `.git` is excluded as not part of
# what runs; `lock.mdb` because an LMDB lock file is rewritten by any
# process that opens the database, even a read, reporting permanent false
# drift. Sorted under LC_ALL=C so two machines with different locales agree.
# Symlinks count: bin/wk is one, and it is the name every shell's PATH holds,
# so a copy that lost it must not hash equal to one that has it. A link goes in
# as its own target text, never followed -- `$SHA256` on a link to a directory
# is an error, and a link's content *is* where it points.
tree_hash() {
    # shellcheck disable=SC2086 -- $SHA256 is a deliberate command word list.
    ( cd "$WK_ROOT" && \
      { find . -type f -not -path './.git/*' -not -name '*.pyc' -not -name 'lock.mdb' -print0 \
        | LC_ALL=C sort -z \
        | xargs -0 $SHA256
        find . -type l -not -path './.git/*' -print0 \
        | LC_ALL=C sort -z \
        | while IFS= read -r -d "" _l; do printf '%s -> %s\n' "$_l" "$(readlink "$_l")"; done
      } ) | _sha256 | cut -c1-12
}

git_sha() {
    git -C "$WK_ROOT" rev-parse --short HEAD 2>/dev/null || echo -
}

git_dirty() {
    git -C "$WK_ROOT" rev-parse HEAD >/dev/null 2>&1 || { echo unknown; return 0; }
    [ -z "$(git -C "$WK_ROOT" status --porcelain 2>/dev/null)" ] && echo no || echo yes
}

case "${1:-}" in
--tree) tree_hash ;;
'')
    printf 'sha=%s\n'   "$(git_sha)"
    printf 'dirty=%s\n' "$(git_dirty)"
    printf 'tree=%s\n'  "$(tree_hash)"
    printf 'root=%s\n'  "$WK_ROOT"
    ;;
*) die "usage: wk version [--tree]; see wk version -h" ;;
esac
