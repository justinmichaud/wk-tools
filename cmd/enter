#!/usr/bin/env bash
#
# wk enter <workspace> -- interactive shell in a workspace
# wk: where=workspace name=required ready=yes group=workspaces
#
# Opens an interactive shell in the workspace, or runs a given command there
# and exits. On Linux this is also where GPU and desktop integration happens:
# benchmarks need real acceleration, so the Wayland socket and /dev/dri are
# passed in. Display integration and network isolation are independent -- the
# workspace keeps the GPU while still being unable to reach the LAN.
#
#   --zed        open the workspace in Zed instead of a shell
#   [--] <cmd>   run one command there and exit, instead of a shell. The `--`
#                is optional (matching `wk run`'s convention for anyone who
#                types it out of habit) and is dropped rather than handed to
#                the workspace as the first word of its command.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

NAME="${WK_NAME:-}"
require_name "$NAME"

ZED=""
while [ $# -gt 0 ]; do
    case "$1" in
        --zed) ZED=1; shift ;;
        --)    shift; break ;;
        *)     break ;;
    esac
done

TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

# One implementation of "open this in Zed", in cmd/zed: the readiness gate, the
# transport a container needs, the alias and the launch are all the same
# whether the ask came from here, from `wk new --zed`, or from `wk zed`.
if [ -n "$ZED" ]; then
    exec "$WK_ROOT/cmd/zed" "$NAME"
fi

[ "$(t_info "$NAME")" != absent ] || die "no such workspace: $NAME"

# No `exec`: t_exec is a shell function, and exec can only replace the process
# with a real program. `exec t_exec ...` fails with "t_exec: not found".
if [ $# -gt 0 ]; then
    t_exec "$NAME" "$@"
    exit $?
fi

# The workspace sees the compositor at a fixed path, so what matters is whether
# a session is running here -- not whether this particular shell has one, which
# it never does over ssh.
if is_linux && [ ! -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wk/display/wayland-0" ]; then
    warn "no benchmark session running; GPU-accelerated tests fall back to software rendering"
    log  "  start one with:  wk session on"
elif is_linux; then
    # There is a session, but it may be one of the slow ones -- and from inside
    # the workspace the socket looks identical either way.
    session_mode_warn || true
fi

# No `exec` here either: t_enter is a shell function (the vm driver's own
# t_enter execs ssh itself when that is the right thing).
t_enter "$NAME"
