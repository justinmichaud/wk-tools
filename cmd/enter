#!/usr/bin/env bash
#
# wk enter <workspace> -- interactive shell in a workspace.
#
# On Linux this is also where GPU and desktop integration happens: benchmarks
# need real acceleration, so the Wayland socket and /dev/dri are passed in.
# Note that display integration and network isolation are independent -- the
# workspace keeps the GPU while still being unable to reach the LAN.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"

NAME="${1:-}"; shift || true
require_name "$NAME"

ZED=""
[ "${1:-}" = --zed ] && { ZED=1; shift; }

TARGET="${WK_TARGET:-container}"
. "$WK_ROOT/targets/$TARGET.sh"

[ "$(t_info "$NAME")" != absent ] || die "no such workspace: $NAME"

if [ -n "$ZED" ]; then
    have zed || die "zed is not on PATH"
    exec zed "ssh://wk-$NAME/src/WebKit"
fi

if [ $# -gt 0 ]; then
    exec t_exec "$NAME" "$@"
fi

# The workspace sees the compositor at a fixed path, so what matters is whether
# a session is running here -- not whether this particular shell has one, which
# it never does over ssh.
if is_linux && [ ! -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wk/display/wayland-0" ]; then
    warn "no benchmark session running; GPU-accelerated tests fall back to software rendering"
    log  "  start one with:  wk session on"
fi

exec t_enter "$NAME"
