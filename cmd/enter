#!/usr/bin/env bash
#
# wk enter <workspace> -- interactive shell in a workspace.
#
# On Linux this is also where GPU and desktop integration happens: benchmarks
# need real acceleration, so the Wayland socket and /dev/dri are passed in.
# Note that display integration and network isolation are independent -- the
# workspace keeps the GPU while still being unable to reach the LAN.

set -euo pipefail
WK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/store.sh"
. "$WK_ROOT/lib/target.sh"

NAME="${1:-}"; shift || true
require_name "$NAME"

ZED=""
[ "${1:-}" = --zed ] && { ZED=1; shift; }

TARGET="$(ws_target "$NAME")"
load_target "$TARGET"

if [ -n "$ZED" ]; then
    # Wait for it, rather than opening an editor on a checkout that is still
    # being cloned -- which is what this did, and which shows up as a tree of
    # missing files and a remote-development session against a workspace that
    # was not there yet. The waiter stays in the foreground on purpose: if this
    # end dies, creation continues detached and re-running this command is the
    # resume (lib/target.sh, wait_ready).
    wait_ready "$NAME"
    Z=$(zed_cli) || die "zed is not installed (no 'zed' on PATH, no /Applications/Zed.app)"
    host=$(t_ssh_host "$NAME") || die "'$NAME' is not running"
    exec "$Z" "ssh://$host$(t_src "$NAME")"
fi

[ "$(t_info "$NAME")" != absent ] || die "no such workspace: $NAME"

# No `exec`: t_exec is a shell function, and exec can only replace the process
# with a real program. `exec t_exec ...` fails with "t_exec: not found".
if [ $# -gt 0 ]; then
    t_exec "$NAME" "$@"
    exit $?
fi

# The workspace sees the compositor at a fixed path, so what matters is whether
# a session is running here -- not whether this particular shell has one, which
# it never does over ssh.
if is_linux && [ ! -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wk/display/wayland-0" ]; then
    warn "no benchmark session running; GPU-accelerated tests fall back to software rendering"
    log  "  start one with:  wk session on"
elif is_linux; then
    # There is a session, but it may be one of the slow ones -- and from inside
    # the workspace the socket looks identical either way.
    session_mode_warn || true
fi

# No `exec` here either: t_enter is a shell function (the vm driver's own
# t_enter execs ssh itself when that is the right thing).
t_enter "$NAME"
