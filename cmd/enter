#!/usr/bin/env python3
#
# wk enter <workspace> -- interactive shell in a workspace
# wk: where=workspace name=required ready=yes group=workspaces dryrun opts --zed,--own passthrough=tail
#
# On Linux the Wayland socket and /dev/dri are passed in, so the workspace
# keeps the GPU while still unable to reach the LAN.
#
#   --zed        open the workspace in Zed instead of a shell
#   [--] <cmd>   run one command there and exit, instead of a shell; the `--`
#                is optional and is not passed on
#   --own <cmd>  run it as wk's own run, not as a shell of yours: nothing it
#                starts can publish (the push service and the injector serve
#                only what a person's shell started). What wk's host-side
#                commands reach a container through
#
# A shell here is yours: it pushes and commits, and an agent session started
# in it ('claude', 'wk ai') cannot.

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from wk import images, store  # noqa: E402

ROOT = images.root()

from wk import decl, places, session  # noqa: E402
from wk.act import Refused, die, log, warn  # noqa: E402
from wk.machine import is_linux  # noqa: E402


def session_display_warning(env):
    if not places.session_socket_present(env):
        warn("no benchmark session running; GPU-accelerated tests fall back to software rendering")
        log("  start one with:  wk quiesce session on")
    else:
        session.here(ROOT, env).mode_warn()


def parse(argv):
    """--zed and --own are flags only as leading tokens; one leading `--` past them is dropped, the rest is the command tail verbatim."""
    n = next((i for i, a in enumerate(argv) if a not in ("--zed", "--own")), len(argv))
    args = decl.Args(decl.Decl(__file__), argv[:n])
    cmd = list(argv[n:])
    if cmd[:1] == ["--"]:
        cmd = cmd[1:]
    return args.flag("--zed"), args.flag("--own"), cmd


def main(argv):
    name = store.ws_name()
    zed, own, cmd = parse(argv)
    if own and not cmd:
        die("--own takes a command: a shell is always your own")

    reg = places.Registry(ROOT)
    if zed:
        reg.machine.exec([os.path.join(ROOT, "cmd", "zed"), name])
        return
    driver = reg.present(name)

    if cmd:
        tty = sys.stdin.isatty() and sys.stdout.isatty()
        argv, cwd = driver.exec_argv(name, cmd, tty=tty, person=not own)
        reg.machine.exec(argv, cwd)
        return

    if is_linux():
        session_display_warning(os.environ)

    argv, cwd = driver.enter_argv(name)
    reg.machine.exec(argv, cwd)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
