#!/usr/bin/env python3
#
# wk enter <workspace> -- interactive shell in a workspace
# wk: where=workspace name=required ready=yes group=workspaces opts --zed passthrough=tail
#
# On Linux the Wayland socket and /dev/dri are passed in, so the workspace
# keeps the GPU while still unable to reach the LAN.
#
#   --zed        open the workspace in Zed instead of a shell
#   [--] <cmd>   run one command there and exit, instead of a shell; the `--`
#                is optional and is not passed on

import os
import sys

ROOT = os.environ.get("WK_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

from wk import decl, shell, targets  # noqa: E402
from wk.act import Refused, die, exec_into, log, warn  # noqa: E402
from wk.machine import is_linux  # noqa: E402


def session_display_warning(env):
    if not targets.session_socket_present(env):
        warn("no benchmark session running; GPU-accelerated tests fall back to software rendering")
        log("  start one with:  wk session on")
    else:
        shell.session_mode_warn(ROOT, env=env)


def parse(argv):
    """--zed is the flag only as the leading token; one leading `--` past it is dropped, the rest is the command tail verbatim."""
    zed = decl.Args(decl.Decl(__file__), argv[:1]).flag("--zed")
    cmd = list(argv[1:] if zed else argv)
    if cmd[:1] == ["--"]:
        cmd = cmd[1:]
    return zed, cmd


def main(argv):
    name = os.environ.get("WK_NAME", "")
    zed, cmd = parse(argv)

    reg = targets.Registry(ROOT)
    try:
        tname = reg.ws_target(name)
        target = reg.load(tname)
    except LookupError as e:
        die(str(e))

    if zed:
        exec_into([os.path.join(ROOT, "cmd", "zed"), name])
        return

    if target.info(name) == "absent":
        die("no such workspace: %s" % name)

    if cmd:
        tty = sys.stdin.isatty() and sys.stdout.isatty()
        argv, cwd = target.exec_argv(name, cmd, tty=tty)
        exec_into(argv, cwd)
        return

    if is_linux():
        session_display_warning(os.environ)

    argv, cwd = target.enter_argv(name)
    exec_into(argv, cwd)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        sys.exit(e.status)
    except KeyboardInterrupt:
        sys.exit(130)
