ui = false
api_addr = "{{ wk_bao_addr }}"
cluster_addr = "http://{{ wk_tailnet_address }}:{{ wk_openbao_port | int + 1 }}"

# The tailnet is the transport's encryption and the only network this listens on.
listener "tcp" {
  address = "{{ wk_tailnet_address }}:{{ wk_openbao_port }}"
  tls_disable = true
}

storage "raft" {
  path = "{{ wk_openbao_dir }}/data"
  node_id = "{{ inventory_hostname }}"
}

# Unattended unseal: the server reads its key at start, so a reboot needs no person.
seal "static" {
  current_key_id = "wk-1"
  current_key = "file://{{ wk_openbao_dir }}/unseal.key"
}
