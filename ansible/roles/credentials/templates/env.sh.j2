# Written by the credentials role and sourced by an interactive shell, an agent session's too.
{% for var, name in wk_env_names %}
{% if name in wk_store_names %}
export {{ var }}={{ lookup('ansible.builtin.file', wk_store ~ '/' ~ name) | quote }}
{% endif %}
{% endfor %}
{# git reads these as configuration (2.31 on): a push to the fork's https URL goes through the alias that selects its key. #}
{% for repo in wk_forks %}
export GIT_CONFIG_KEY_{{ loop.index0 }}={{ ('url.git@github-' ~ (repo | replace('/', '-') | lower) ~ ':' ~ repo ~ '.git.pushInsteadOf') | quote }}
export GIT_CONFIG_VALUE_{{ loop.index0 }}={{ ('https://github.com/' ~ repo ~ '.git') | quote }}
{% endfor %}
{% if wk_forks %}
export GIT_CONFIG_COUNT={{ wk_forks | length }}
{% endif %}
