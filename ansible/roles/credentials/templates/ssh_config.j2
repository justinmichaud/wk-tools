# Written by the credentials role: one alias per repository, each offering that repository's deploy key alone and
# trusting GitHub's published host keys alone.
{# ssh lowercases the host it is given. #}
{% for repo in wk_forks %}
Host github-{{ repo | replace('/', '-') | lower }}
    HostName github.com
    User git
    IdentityFile {{ wk_secrets }}/deploy/{{ repo | replace('/', '--') }}
    IdentitiesOnly yes
    UserKnownHostsFile {{ wk_secrets }}/known_hosts
    StrictHostKeyChecking yes
{% endfor %}
