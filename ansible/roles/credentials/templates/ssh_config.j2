# Written by the credentials role: one alias per repository, each offering that repository's deploy key alone.
{# ssh lowercases the host it is given. #}
{% for repo in wk_forks %}
Host github-{{ repo | replace('/', '-') | lower }}
    HostName github.com
    User git
    IdentityFile {{ wk_secrets }}/deploy/{{ repo | replace('/', '--') }}
    IdentitiesOnly yes
{% endfor %}
