{
  "CHECKOUT": "WebKit",
  "MIRROR": "WebKit.git",
  "SRC": "/src/WebKit",
  "REPO": "webkit",
  "REPOS": {"webkit": {"clone": "snapshot"},
            "wk-tools": {"clone": "tools-origin", "checkout": "wk-tools"}},
  "BUILD_DIR": "WebKitBuild",
  "SCRIPTS": "Tools/Scripts",
  "PR_TOOL": "git-webkit",
  "PR_TOOL_SETUP": "webkitscmpy.setup",
  "BUGZILLA": "https://bugs.webkit.org",
  "BUGZILLA_ENV": ["BUGS_WEBKIT_ORG_USERNAME", "BUGS_WEBKIT_ORG_PASSWORD"],
  "REMOTES": [["origin", "https://github.com/WebKit/WebKit.git"],
              ["wpe", "https://github.com/WebPlatformForEmbedded/WPEWebKit.git"],
              ["fork", "https://github.com/justinmichaud/WebKit.git"],
              ["forkwpe", "https://github.com/justinmichaud/WPEWebKit.git"]],
  "FORKS": [["fork", "justinmichaud/WebKit", "github-webkit"],
            ["forkwpe", "justinmichaud/WPEWebKit", "github-wpe"]],
  "RELEASES": "webkitglib",
  "SDK": "webkit-container-sdk",
  "SDK_IMAGE": "ghcr.io/igalia/wkdev-sdk",
  "SDK_IMAGE_ARMHF": "ghcr.io/igalia/wkdev-sdk:24.04_arm32",
  "SDK_CREATE": "wkdev-create",
  "SDK_ENTER": "wkdev-enter",
  "SDK_ENV": "WKDEV_",
  "SDK_FIRSTRUN": ".wkdev-firstrun",
  "DEPS_DIRS": ["Tools/gtk", "Tools/wpe"],
  "LLDB_SCRIPT": "Tools/lldb/lldb_webkit.py",
  "PRESETS": {
    "jsc-debug": "JSCOnly, Debug, assertions on",
    "jsc-release": "JSCOnly, Release, the default for benchmarking",
    "jsc-release-asan": "JSCOnly, Release + AddressSanitizer",
    "gtk-debug": "GTK port, Debug, developer mode",
    "gtk-release": "GTK port, Release",
    "gtk-release-asan": "GTK port, Release + AddressSanitizer",
    "wpe-release": "WPE port, Release",
    "mac-debug": "macOS (Apple port), Debug, Xcode",
    "mac-release": "macOS (Apple port), Release, Xcode",
    "mac-release-pgo": "macOS (Apple port), Release + PGO and full LTO -- the perf build",
    "mac-release-asan": "macOS (Apple port), Release + AddressSanitizer",
    "ios-sim-release": "iOS Simulator, Release, Xcode"
  },
  "MAC_PRESET": "mac-release",
  "BENCH_PRESET": "wpe-release",
  "PGO_COLLECT": "wpe-cross-pgo-collect",
  "PGO_USE": "wpe-cross-pgo-use",
  "BROWSER": "MiniBrowser",
  "BROWSER_BUNDLE": "org.webkit.MiniBrowser",
  "BROWSER_PRODUCTS": ["bin/MiniBrowser", "bin/WPEWebProcess"],
  "MAC_WEB_PROCESS": "com.apple.WebKit.WebContent",
  "SOFTWARE_ENV": ["WEBKIT_DISABLE_DMABUF_RENDERER=1"],
  "SHA_FIELD": "webkit_sha",
  "SHELL": "jsc",
  "SHELL_PORT": "JSCOnly",
  "SHELL_DRIVER": "cli.js",
  "BENCH_RUNNER": "Tools/Scripts/run-benchmark",
  "BENCH_DRIVERS": "Tools/Scripts/webkitpy/benchmark_runner/browser_driver",
  "BENCH_BROWSERS": {"--wpe": "minibrowser-wpe", "--gtk": "minibrowser-gtk", "macos": "minibrowser"},
  "BENCH_PID_MATCH": "*run-benchmark* *cli.js*",
  "CPU_PLANS": ["jetstream", "octane", "kraken", "sunspider", "ares6", "jsbench"],
  "SLOT_COMMAND": "wk sysimage webkit",
  "SLOT_ENV": [["LD_LIBRARY_PATH", "lib_dir"], ["WEBKIT_EXEC_PATH", "exec_dir"], ["WEBKIT_INJECTED_BUNDLE_PATH", "bundle_dir"]],
  "BOARD_BROWSERS": {"cog": "cog", "minibrowser": "MiniBrowser"},
  "BOARD_HELPERS": ["WPEWebProcess", "WPENetworkProcess"],
  "BOARD_BACKEND": "export WPE_BACKEND_LIBRARY=libWPEBackend-fdo-1.0.so && ",
  "JIT_TIERS": ["JSC_reportDFGCompileTimes=1", "JSC_reportFTLCompileTimes=1"]
}
