#!/sbin/openrc-run
# The packaged nftables service stays disabled: its stock configuration opens with `flush ruleset`, which would take out tailscale's ts-input and ts-forward chains.
description="The bridge's nftables table (never flushes the ruleset)"

depend() {
    before net
}

start() {
    ebegin "Loading the wkbridge nftables table"
    /usr/sbin/nft -f /etc/nftables.d/wk-bridge.nft
    eend $?
}

stop() {
    ebegin "Removing the wkbridge nftables table"
    /usr/sbin/nft delete table inet wkbridge 2>/dev/null
    eend 0
}
