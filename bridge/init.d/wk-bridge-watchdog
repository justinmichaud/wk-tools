#!/sbin/openrc-run
# udev's coldplug usually autoloads the watchdog platform driver by modalias, but "usually" will not do for the one mechanism that recovers a hung kernel, so start_pre loads it.
description="Feed the hardware watchdog"

supervisor=supervise-daemon
command=/bin/busybox
command_args="watchdog -F -t 10 -T 30 /dev/watchdog"
respawn_delay=5
respawn_max=0

depend() {
    after net
}

start_pre() {
    /usr/local/sbin/wk-bridge-watchdog-load || true
}
