#!/sbin/openrc-run
# The driver resets charge_control_end_threshold to its hardware default at every power-on, so the cap must be re-applied on each boot.
description="Cap the battery charge threshold"

depend() {
    after localmount
}

start() {
    ebegin "Applying the battery charge limit"
    /usr/local/sbin/wk-bridge-battery
    eend $?
}

stop() {
    return 0
}
