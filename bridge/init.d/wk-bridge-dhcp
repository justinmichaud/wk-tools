#!/sbin/openrc-run
# dnsmasq, with one conf file named explicitly and nothing else read.
#
# Not the packaged dnsmasq service, and that is a scar rather than a
# preference: a distribution's unit reads /etc/dnsmasq.conf and a conf
# *directory*, so `port=0` in our file never reached the daemon and it fought
# the system resolver for port 53. One daemon, one file, no conf-dir.
description="DHCP (and the NTP hand-off) for the bridge segment"

supervisor=supervise-daemon
command=/usr/sbin/dnsmasq
command_args="-k --conf-file=/etc/dnsmasq.d/wk-bridge.conf"
respawn_delay=5
respawn_max=0

depend() {
    # `after net`, not `need net`: be listening as early as there is anything to
    # listen with.
    #
    # Nothing here needs `net` to have finished. `bind-dynamic` is exactly the
    # option that lets dnsmasq start before its interface exists and bind when
    # it appears -- checked on the phone rather than assumed, with a throwaway
    # instance on a nonexistent interface, which starts and stays up. The DNS
    # half re-reads /etc/resolv.conf on change by inotify, so it does not need
    # the resolver settled either.
    #
    # What this does *not* do is fix the delay it was first written for, and the
    # honest version is worth keeping. After a reboot of the phone the board's
    # segment address took over two minutes to come back, and the reason is that
    # the board asks for DHCP when the *kernel* enumerates the adapter -- seconds
    # into the boot, before any of this phone's userspace can possibly answer --
    # and then backs off: its DHCPDISCOVER lands 134 s after boot, and starting
    # dnsmasq earlier moves that by nothing, because
    # no userspace start is early enough. The thing that actually shortens it is
    # wk-bridge-netwatch flapping the link once the server *is* up, which makes
    # a backed-off client ask again immediately.
    #
    # One side effect, so it does not have to be re-discovered: starting this
    # early can put dnsmasq ahead of syslog, and its own startup lines then go
    # nowhere. The DHCP exchanges are logged normally; only the banner is lost.
    after net wk-bridge-usb-host
}
