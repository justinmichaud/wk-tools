#!/sbin/openrc-run
# One conf file named explicitly, because the packaged service also reads /etc/dnsmasq.conf and a conf directory, so `port=0` never reaches the daemon and it fights the resolver for port 53. `after net`, not `need net`: `bind-dynamic` binds the interface when it appears; the board's DHCPDISCOVER lands 134 s after boot whatever userspace does, and wk-bridge-netwatch flapping the link is what makes a backed-off client ask again.
description="DHCP (and the NTP hand-off) for the bridge segment"

supervisor=supervise-daemon
command=/usr/sbin/dnsmasq
command_args="-k --conf-file=/etc/dnsmasq.d/wk-bridge.conf"
respawn_delay=5
respawn_max=0

depend() {
    after net wk-bridge-usb-host
}
