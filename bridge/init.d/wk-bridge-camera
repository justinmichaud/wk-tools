#!/sbin/openrc-run
# Idles rather than fails with no capture device: the kill switch is hardware, and with it off the sensor is electrically disconnected.
description="Stream the camera over the tailnet, while the kill switch allows it"

supervisor=supervise-daemon
command=/usr/local/sbin/wk-bridge-camera
respawn_delay=10
respawn_max=0

depend() {
    need net
    after tailscale
}
