#!/sbin/openrc-run
# Before net, so the downstream adapter has enumerated by the time anything looks for it; always eend 0, since a dock plugged in later must not hold up the boot. The watchdog re-asserts host mode if the port drops back to device mode.
description="Force the Type-C port into USB host mode"

depend() {
    before net
}

start() {
    ebegin "Asserting USB host mode"
    /usr/local/sbin/wk-bridge-usb-host
    eend 0
}

stop() {
    return 0
}
