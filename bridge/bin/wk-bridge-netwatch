#!/bin/sh
# Escalating recovery for a WiFi-uplinked tailscale subnet router.
#
# Both phones' WiFi is the weakest link: the Librem 5's RS9116 wedges its
# firmware in a way a link bounce does not clear, and the PinePhone's 8723cs
# drops associations under load. So recovery is a ladder, not a retry -- each
# consecutive failed check climbs one rung, any success resets to the bottom:
#
#   1      log only (most failures are a roam that recovers itself)
#   2-3    bounce the WiFi interface
#   4-5    restart NetworkManager
#   6-7    reload the WiFi driver module
#   8-9    restart tailscaled
#   10+    reboot -- rate limited, never in the first 15 minutes of uptime
#
# The rate limit matters: an unconditional reboot rung turns a clearing fault
# into a device that reboots forever and that you cannot walk up to.
#
# Runs under supervise-daemon rather than a cron/timer one-shot: OpenRC has no
# timer units, and the escalation counter is a live variable rather than a
# file that would need to survive a crash.
set -u

INTERVAL="${WK_BRIDGE_NETWATCH_INTERVAL:-60}"
REBOOTLOG=/var/lib/wk-bridge/reboots
MIN_UPTIME=900          # don't reboot within 15 min of booting
MAX_REBOOTS=3           # ...or more than 3 times in
REBOOT_WINDOW=21600     # ...6 hours

iface=lan0
segment=""
# Defaulted like the two above: `set -u` must not turn a missing or older conf
# into an unbound-variable crash.
leases=""
leasefile=/var/lib/misc/dnsmasq.leases
[ -f /etc/wk-bridge.conf ] && . /etc/wk-bridge.conf

log() { logger -t wk-bridge-netwatch -- "$*"; printf 'wk-bridge-netwatch: %s\n' "$*"; }

# Service names differ between distros and packagings (NetworkManager vs
# networkmanager); a restart aimed at a name that doesn't exist silently does
# nothing, so it is resolved from what is actually installed.
svc() {
    local n
    for n in "$@"; do
        if [ -x "/etc/init.d/$n" ]; then
            printf '%s' "$n"
            return 0
        fi
    done
    return 1
}
NM_SVC=$(svc networkmanager NetworkManager) || NM_SVC=""
TS_SVC=$(svc tailscale tailscaled) || TS_SVC=""

# Asked of the *reservations*, not the lease file: they're declared rather
# than discovered, so a yes is unambiguous. A segment with none declared falls
# back to the lease file -- the only evidence there is in that case, but not a
# reliable one, since these leases never expire and it records history, not
# the present.
segment_answers() {
    local l ip any=""
    for l in $leases; do
        ip=$(printf '%s' "$l" | cut -d, -f2)
        [ -n "$ip" ] || continue
        any=1
        ping -c 1 -W 2 "$ip" >/dev/null 2>&1 && return 0
    done
    [ -n "$any" ] && return 1
    [ -s "$leasefile" ]
}

wifi_if() {
    nmcli -t -f DEVICE,TYPE device status 2>/dev/null \
        | awk -F: '$2 == "wifi" { print $1; exit }'
}

healthy() {
    # `-o`, not `-br`: BusyBox ip has no brief mode and exits 1 with a usage
    # message, which would read back empty and climb this ladder against a
    # working uplink.
    addr=$(ip -4 -o addr show dev "$WIFI" 2>/dev/null | awk '{print $4; exit}')
    [ -n "$addr" ] || { log "no IPv4 address on $WIFI"; return 1; }

    gw=$(ip -4 route show default dev "$WIFI" 2>/dev/null | awk '{print $3; exit}')
    [ -n "$gw" ] || { log "no default route via $WIFI"; return 1; }
    ping -c 2 -W 3 -I "$WIFI" "$gw" >/dev/null 2>&1 \
        || { log "gateway $gw unreachable"; return 1; }

    st=$(tailscale status --json --peers=false 2>/dev/null) \
        || { log "tailscale status failed"; return 1; }
    [ "$(printf '%s' "$st" | jq -r '.BackendState')" = Running ] \
        || { log "tailscale backend not Running"; return 1; }
    [ "$(printf '%s' "$st" | jq -r '.Self.Online')" = true ] \
        || { log "tailscale reports self offline"; return 1; }

    # Noted, never escalated on: an unapproved route is a tailnet-policy
    # problem no reboot fixes. `wk bridge status` is where this gets noticed.
    if [ -n "$segment" ]; then
        printf '%s' "$st" | jq -e --arg r "$segment" \
            '.Self.PrimaryRoutes // [] | index($r)' >/dev/null 2>&1 \
            || log "note: $segment is not an approved route (autoApprovers? tag?)"
    fi
    return 0
}

reload_wifi_driver() {
    drv=$(basename "$(readlink -f "/sys/class/net/$WIFI/device/driver" 2>/dev/null)" 2>/dev/null)
    [ -n "$drv" ] || return 1
    # Sleeps rather than a wait loop: the firmware upload is what takes the
    # time, and nothing observable happens before it finishes.
    log "reloading wifi driver module '$drv'"
    modprobe -r "$drv" 2>/dev/null || true
    sleep 3
    modprobe "$drv" 2>/dev/null || true
    sleep 5
}

may_reboot() {
    up=$(awk '{print int($1)}' /proc/uptime)
    [ "$up" -ge "$MIN_UPTIME" ] || { log "uptime ${up}s < ${MIN_UPTIME}s, not rebooting"; return 1; }
    now=$(date +%s)
    mkdir -p "$(dirname "$REBOOTLOG")"
    touch "$REBOOTLOG"
    cnt=$(awk -v n="$now" -v w="$REBOOT_WINDOW" '$1 > n - w' "$REBOOTLOG" | wc -l)
    [ "$cnt" -lt "$MAX_REBOOTS" ] || {
        log "already rebooted ${cnt}x in the last $((REBOOT_WINDOW / 3600))h, refusing"
        return 1
    }
    printf '%s\n' "$now" >> "$REBOOTLOG"
    tail -50 "$REBOOTLOG" > "$REBOOTLOG.tmp" && mv "$REBOOTLOG.tmp" "$REBOOTLOG"
    return 0
}

fails=0
nopeer=0
flapped=""
while :; do
    WIFI=$(wifi_if)
    [ -n "$WIFI" ] || { log "no wifi device present"; WIFI=wlan0; }

    # Every pass: power save comes back on after a reassociation on both
    # ends, and is the single most reliable way to turn a working uplink into
    # one that answers every third ping.
    iw dev "$WIFI" set power_save off 2>/dev/null || true

    # Downstream leg: checked but never escalated on -- losing it is a dock or
    # cable fault, and rebooting the phone over it would take out the uplink
    # that is the only way to be told about any of this. Run every pass, not
    # only when the interface is missing: a NIC fallen to the companion
    # full-speed controller is present and in host mode, merely forty times
    # too slow, which is invisible to every other check here.
    /usr/local/sbin/wk-bridge-usb-host 2>/dev/null || true

    if [ ! -e "/sys/class/net/$iface" ]; then
        log "$iface missing -- re-asserting USB host mode"
        /usr/local/sbin/wk-bridge-usb-host 2>/dev/null || true
        if [ -e "/sys/class/net/$iface" ]; then
            log "$iface came back"
        else
            # Not "check the dock/power/cable": a dock can be powered, cabled
            # and in host mode with the NIC still never enumerating.
            # wk-bridge-healthcheck tells the cases apart; this just points at it.
            log "$iface still absent -- wk-bridge-healthcheck says which fault"
        fi
    elif [ "$(cat "/sys/class/net/$iface/carrier" 2>/dev/null)" = 1 ] \
         && ! segment_answers; then
        # Carrier up but nothing answers: a client asks for an address only
        # when the link comes up, so one that missed that window stays without
        # one -- only taking the carrier away and back makes it ask again.
        # Reachability, not an empty lease file, is the trigger: these leases
        # never expire, so an already-addressed client re-uses it via ARP
        # after a carrier drop and never files another request.
        nopeer=$((nopeer + 1))
        # Two passes before flapping, except right after this phone's own
        # boot: measured, a board's DHCPDISCOVER can land 134s after this
        # phone reboots (its own retry schedule, not this phone's readiness),
        # so flapping on pass 1 there turns a two-minute wait into ~20s. Once
        # per episode either way, via a flag rather than the counter, so two
        # failing passes in a row don't flap twice.
        up=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 999)
        if [ -z "$flapped" ] && { [ "$nopeer" -ge 2 ] || [ "$up" -lt 180 ]; }; then
            flapped=1
            log "$iface has carrier and nothing answers -- flapping it so a client re-asks"
            ip link set "$iface" down 2>/dev/null || true
            sleep 2
            ip link set "$iface" up 2>/dev/null || true
        fi
    else
        nopeer=0
        flapped=""
    fi

    if healthy; then
        [ "$fails" -gt 0 ] && log "recovered after $fails failed checks"
        fails=0
    else
        fails=$((fails + 1))
        log "health check failed (consecutive: $fails)"
        case "$fails" in
            1) ;;
            2|3)
                log "bouncing $WIFI"
                nmcli device reapply "$WIFI" 2>/dev/null \
                    || nmcli device connect "$WIFI" 2>/dev/null || true
                ;;
            4|5)
                [ -n "$NM_SVC" ] && { log "restarting $NM_SVC"; rc-service "$NM_SVC" restart; }
                ;;
            6|7)
                reload_wifi_driver
                [ -n "$NM_SVC" ] && rc-service "$NM_SVC" restart
                ;;
            8|9)
                [ -n "$TS_SVC" ] && { log "restarting $TS_SVC"; rc-service "$TS_SVC" restart; }
                ;;
            *)
                log "escalating to reboot"
                if may_reboot; then
                    fails=0
                    reboot
                fi
                ;;
        esac
    fi

    sleep "$INTERVAL"
done
