#!/bin/sh
# Escalating recovery for a WiFi-uplinked tailscale subnet router: each consecutive failed check climbs a rung and any success drops back to the bottom -- 1 log only, 2-3 bounce WiFi, 4-5 restart NetworkManager, 6-7 reload the WiFi driver, 8-9 restart tailscaled, 10+ reboot. The reboot rung is rate limited because an unconditional one turns a clearing fault into a device that reboots forever.
# The driver rung exists because the Librem 5's RS9116 wedges its firmware in a way a link bounce does not clear, and the PinePhone's 8723cs drops associations under load.
set -u

INTERVAL="${WK_BRIDGE_NETWATCH_INTERVAL:-60}"
REBOOTLOG=/var/lib/wk-bridge/reboots
MIN_UPTIME=900          # don't reboot within 15 min of booting
MAX_REBOOTS=3           # ...or more than 3 times in
REBOOT_WINDOW=21600     # ...6 hours

iface=lan0
segment=""
leases=""
leasefile=/var/lib/misc/dnsmasq.leases
[ -f /etc/wk-bridge.conf ] && . /etc/wk-bridge.conf

log() { logger -t wk-bridge-netwatch -- "$*"; printf 'wk-bridge-netwatch: %s\n' "$*"; }

# Service names differ between distros and packagings (NetworkManager vs networkmanager), and a restart aimed at a name that does not exist silently does nothing.
svc() {
    local n
    for n in "$@"; do
        if [ -x "/etc/init.d/$n" ]; then
            printf '%s' "$n"
            return 0
        fi
    done
    return 1
}
NM_SVC=$(svc networkmanager NetworkManager) || NM_SVC=""
TS_SVC=$(svc tailscale tailscaled) || TS_SVC=""

segment_answers() {
    local l ip any=""
    for l in $leases; do
        ip=$(printf '%s' "$l" | cut -d, -f2)
        [ -n "$ip" ] || continue
        any=1
        ping -c 1 -W 2 "$ip" >/dev/null 2>&1 && return 0
    done
    [ -n "$any" ] && return 1
    [ -s "$leasefile" ]
}

wifi_if() {
    nmcli -t -f DEVICE,TYPE device status 2>/dev/null \
        | awk -F: '$2 == "wifi" { print $1; exit }'
}

healthy() {
    # `-o`, not `-br`: BusyBox ip has no brief mode and exits 1 with a usage message, which reads back empty and would climb this ladder against a working uplink.
    addr=$(ip -4 -o addr show dev "$WIFI" 2>/dev/null | awk '{print $4; exit}')
    [ -n "$addr" ] || { log "no IPv4 address on $WIFI"; return 1; }

    gw=$(ip -4 route show default dev "$WIFI" 2>/dev/null | awk '{print $3; exit}')
    [ -n "$gw" ] || { log "no default route via $WIFI"; return 1; }
    ping -c 2 -W 3 -I "$WIFI" "$gw" >/dev/null 2>&1 \
        || { log "gateway $gw unreachable"; return 1; }

    st=$(tailscale status --json --peers=false 2>/dev/null) \
        || { log "tailscale status failed"; return 1; }
    [ "$(printf '%s' "$st" | jq -r '.BackendState')" = Running ] \
        || { log "tailscale backend not Running"; return 1; }
    [ "$(printf '%s' "$st" | jq -r '.Self.Online')" = true ] \
        || { log "tailscale reports self offline"; return 1; }

    if [ -n "$segment" ]; then
        printf '%s' "$st" | jq -e --arg r "$segment" \
            '.Self.PrimaryRoutes // [] | index($r)' >/dev/null 2>&1 \
            || log "note: $segment is not an approved route (autoApprovers? tag?)"
    fi
    return 0
}

reload_wifi_driver() {
    drv=$(basename "$(readlink -f "/sys/class/net/$WIFI/device/driver" 2>/dev/null)" 2>/dev/null)
    [ -n "$drv" ] || return 1
    log "reloading wifi driver module '$drv'"
    modprobe -r "$drv" 2>/dev/null || true
    sleep 3
    modprobe "$drv" 2>/dev/null || true
    sleep 5
}

may_reboot() {
    up=$(awk '{print int($1)}' /proc/uptime)
    [ "$up" -ge "$MIN_UPTIME" ] || { log "uptime ${up}s < ${MIN_UPTIME}s, not rebooting"; return 1; }
    now=$(date +%s)
    mkdir -p "$(dirname "$REBOOTLOG")"
    touch "$REBOOTLOG"
    cnt=$(awk -v n="$now" -v w="$REBOOT_WINDOW" '$1 > n - w' "$REBOOTLOG" | wc -l)
    [ "$cnt" -lt "$MAX_REBOOTS" ] || {
        log "already rebooted ${cnt}x in the last $((REBOOT_WINDOW / 3600))h, refusing"
        return 1
    }
    printf '%s\n' "$now" >> "$REBOOTLOG"
    tail -50 "$REBOOTLOG" > "$REBOOTLOG.tmp" && mv "$REBOOTLOG.tmp" "$REBOOTLOG"
    return 0
}

fails=0
nopeer=0
flapped=""
while :; do
    WIFI=$(wifi_if)
    [ -n "$WIFI" ] || { log "no wifi device present"; WIFI=wlan0; }

    # Every pass: power save comes back on after a reassociation on both chips, and turns a working uplink into one that answers every third ping.
    iw dev "$WIFI" set power_save off 2>/dev/null || true

    # Downstream leg, never escalated on: losing it is a dock or cable fault and rebooting over it takes out the uplink. Re-asserted every pass, not only when the interface is missing, since the companion-controller trap leaves it present but forty times too slow.
    /usr/local/sbin/wk-bridge-usb-host 2>/dev/null || true

    if [ ! -e "/sys/class/net/$iface" ]; then
        log "$iface missing -- re-asserting USB host mode"
        /usr/local/sbin/wk-bridge-usb-host 2>/dev/null || true
        if [ -e "/sys/class/net/$iface" ]; then
            log "$iface came back"
        else
            log "$iface still absent -- wk-bridge-healthcheck says which fault"
        fi
    elif [ "$(cat "/sys/class/net/$iface/carrier" 2>/dev/null)" = 1 ] \
         && ! segment_answers; then
        # Carrier up and nothing answers: these leases never expire, so a client that missed the window re-uses its address by ARP and never files another request -- taking the carrier away and back is what makes it ask. Two passes before flapping, except within 180 s of this phone's own boot, where a board's DHCPDISCOVER was measured landing 134 s in on its own retry schedule.
        nopeer=$((nopeer + 1))
        up=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 999)
        if [ -z "$flapped" ] && { [ "$nopeer" -ge 2 ] || [ "$up" -lt 180 ]; }; then
            flapped=1
            log "$iface has carrier and nothing answers -- flapping it so a client re-asks"
            ip link set "$iface" down 2>/dev/null || true
            sleep 2
            ip link set "$iface" up 2>/dev/null || true
        fi
    else
        nopeer=0
        flapped=""
    fi

    if healthy; then
        [ "$fails" -gt 0 ] && log "recovered after $fails failed checks"
        fails=0
    else
        fails=$((fails + 1))
        log "health check failed (consecutive: $fails)"
        case "$fails" in
            1) ;;
            2|3)
                log "bouncing $WIFI"
                nmcli device reapply "$WIFI" 2>/dev/null \
                    || nmcli device connect "$WIFI" 2>/dev/null || true
                ;;
            4|5)
                [ -n "$NM_SVC" ] && { log "restarting $NM_SVC"; rc-service "$NM_SVC" restart; }
                ;;
            6|7)
                reload_wifi_driver
                [ -n "$NM_SVC" ] && rc-service "$NM_SVC" restart
                ;;
            8|9)
                [ -n "$TS_SVC" ] && { log "restarting $TS_SVC"; rc-service "$TS_SVC" restart; }
                ;;
            *)
                log "escalating to reboot"
                if may_reboot; then
                    fails=0
                    reboot
                fi
                ;;
        esac
    fi

    sleep "$INTERVAL"
done
