#!/bin/sh
# One-shot health report for a tailnet bridge. Read-only; changes nothing.
# Exit 0 if everything essential is up, 1 otherwise -- so it is safe from cron,
# and it is what `wk bridge status` runs.
#
# One rule for anyone editing this file: do **not** write `cmd | grep -q ...`.
# grep -q exits at the first match, which SIGPIPEs the producer; with pipefail
# set that turns a successful check into a reported failure, and this exact bug
# once made the report claim SSH password authentication was enabled when it was
# not. Capture the value and compare it.
set -u

name=unknown
device=unknown
iface=lan0
segment=""
router=""
leases=""
egress=none
camera=off
leasefile=/var/lib/misc/dnsmasq.leases
[ -f /etc/wk-bridge.conf ] && . /etc/wk-bridge.conf

fail=0
ok()   { printf '  \033[1;32mOK\033[0m    %s\n' "$*"; }
bad()  { printf '  \033[1;31mFAIL\033[0m  %s\n' "$*"; fail=1; }
note() { printf '        %s\n' "$*"; }
hdr()  { printf '\n\033[1;36m%s\033[0m\n' "$*"; }

svc() {
    local n
    for n in "$@"; do
        if [ -x "/etc/init.d/$n" ]; then
            printf '%s' "$n"
            return 0
        fi
    done
    return 1
}

printf '\033[1m%s\033[0m (%s)\n' "$name" "$device"

hdr "Uplink"
wifi=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2 == "wifi" { print $1; exit }')
[ -n "$wifi" ] || wifi=wlan0
# `-o`, not `-br`. BusyBox ip -- which is what Alpine and therefore pmOS ships
# -- has no brief mode: `ip -4 -br addr` exits 1 with a usage message, so this
# read back empty and the check reported an uplink with no address on a phone
# holding a perfectly good lease. `-o[neline]` is in BusyBox's own usage string.
addr=$(ip -4 -o addr show dev "$wifi" 2>/dev/null | awk '{print $4; exit}')
if [ -n "$addr" ]; then ok "$wifi $addr"; else bad "$wifi has no IPv4 address"; fi
note "$(iw dev "$wifi" link 2>/dev/null | awk '/SSID|signal/ { $1 = $1; print }' | tr '\n' ' ')"
ps=$(iw dev "$wifi" get power_save 2>/dev/null | awk '{print $3}')
if [ "$ps" = off ]; then ok "wifi power save off"; else bad "wifi power save is ON ($ps) -- causes dropped links"; fi

hdr "Segment ${segment:-?}"
if ip -o link show "$iface" >/dev/null 2>&1; then
    ok "$iface $(ip -4 -o addr show "$iface" 2>/dev/null | awk '{print $4; exit}')"
    if [ "$(cat "/sys/class/net/$iface/carrier" 2>/dev/null)" = 1 ]; then
        ok "cable connected"
    else
        bad "no carrier on $iface -- check the cable"
    fi
else
    bad "$iface missing -- USB host mode? run wk-bridge-usb-host"
fi
note "typec data_role: $(cat /sys/class/typec/port0/data_role 2>/dev/null)"

# The lease file is the ground truth for "did the thing behind me get an
# address", and the failure it exists to make visible is a *different* device
# holding the address you meant -- which is what an infinite lease on a
# one-address pool guarantees if the cable is in the wrong socket.
if [ -s "$leasefile" ]; then
    ok "DHCP leases:"
    sed 's/^/          /' "$leasefile"
else
    bad "no DHCP lease issued (leasefile $leasefile empty)"
fi

# Ping every reservation. A reservation that does not answer is either unplugged
# or holding a different address than the one written down here.
for l in $leases; do
    ip=$(printf '%s' "$l" | cut -d, -f2)
    nm=$(printf '%s' "$l" | cut -d, -f3)
    [ -n "$ip" ] || continue
    if ping -c 2 -W 2 "$ip" >/dev/null 2>&1; then
        ok "$ip (${nm:-reserved}) responds"
    else
        bad "$ip (${nm:-reserved}) unreachable"
    fi
done

hdr "Tailnet"
st=$(tailscale status --json --peers=false 2>/dev/null) || st=""
backend=$(printf '%s' "$st" | jq -r '.BackendState // "none"' 2>/dev/null)
if [ "$backend" = Running ]; then ok "tailscaled running"; else bad "tailscale backend is $backend"; fi
online=$(printf '%s' "$st" | jq -r '.Self.Online // false' 2>/dev/null)
if [ "$online" = true ]; then ok "online"; else bad "reported offline"; fi
tags=$(printf '%s' "$st" | jq -rc '.Self.Tags // "none"' 2>/dev/null)
# An untagged node is the failure that hides: it works today and its key
# expires in 180 days, which is exactly the kind of outage this device exists
# to prevent. Tagged nodes never key-expire.
if [ "$tags" != none ]; then ok "tags $tags"; else bad "UNTAGGED -- the node key will expire"; fi
routes=$(printf '%s' "$st" | jq -rc '.Self.PrimaryRoutes // "none"' 2>/dev/null)
if [ "$routes" != none ]; then
    ok "routes $routes"
    case "$routes" in
        *"$segment"*) ;;
        *) bad "$segment is advertised but not approved -- nothing behind this bridge is reachable" ;;
    esac
else
    bad "no approved subnet route -- nothing behind this bridge is reachable"
fi

hdr "Services"
for s in wk-bridge-dhcp wk-bridge-nftables wk-bridge-netwatch wk-bridge-usb-host; do
    if rc-service "$s" status >/dev/null 2>&1; then ok "$s"; else bad "$s is not running"; fi
done
for pair in "sshd:sshd" "chronyd:chronyd chrony" "networkmanager:networkmanager NetworkManager" "tailscale:tailscale tailscaled"; do
    want=${pair%%:*}
    if s=$(svc ${pair#*:}); then
        if rc-service "$s" status >/dev/null 2>&1; then ok "$s"; else bad "$s is not running"; fi
    else
        bad "$want is not installed"
    fi
done
if nft list table inet wkbridge >/dev/null 2>&1; then ok "nftables table loaded"; else bad "nftables table inet wkbridge missing"; fi

hdr "Routing"
fwd=$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)
if [ "$fwd" = 1 ]; then ok "ipv4 forwarding on"; else bad "ipv4 forwarding is off"; fi
case "$egress" in
    nat)
        if nft list table inet wkbridge 2>/dev/null | grep masquerade >/dev/null 2>&1; then
            ok "egress: NAT to the uplink"
        else
            bad "egress is declared nat but no masquerade rule is loaded"
        fi
        ;;
    *) ok "egress: none (nothing behind this bridge reaches the internet)" ;;
esac

# The two that took a whole afternoon to find, both invisible in every other
# check: a bridge with no DNS and a bridge at 1970 both look like "no internet"
# while ping and routing are perfect, and both stop `tailscale up` dead.
hdr "Name resolution and time"
if [ -f /etc/resolv.conf ]; then
    ns=$(grep -c '^nameserver' /etc/resolv.conf 2>/dev/null)
    case "$(grep '^nameserver' /etc/resolv.conf 2>/dev/null | head -1)" in
        *127.0.0.53*)
            bad "resolv.conf points at 127.0.0.53 -- a systemd-resolved stub, and there is no systemd-resolved here"
            note "every lookup fails while routing works. NetworkManager should own this file." ;;
        '') bad "resolv.conf lists no nameserver" ;;
        *)  if [ "${ns:-0}" -gt 0 ]; then ok "resolv.conf: $ns nameserver(s)"; else bad "resolv.conf lists no nameserver"; fi ;;
    esac
else
    bad "no /etc/resolv.conf at all"
fi
if nslookup login.tailscale.com >/dev/null 2>&1; then
    ok "DNS resolves"
else
    bad "DNS does not resolve -- tailscale cannot reach its coordination server"
fi

# A clock this far out fails every TLS certificate check there is, which is what
# a phone with no RTC does on every boot until chrony steps it.
year=$(date -u +%Y)
if [ "${year:-1970}" -ge 2024 ] 2>/dev/null; then
    ok "clock sane ($(date -u '+%Y-%m-%d %H:%M UTC'))"
else
    bad "clock is $year -- every TLS check fails, so tailscale cannot log in"
    note "chrony needs 'makestep 1.0 -1' on a device with no RTC"
fi

hdr "Hardening"
pwauth=$(sshd -T 2>/dev/null | awk '/^passwordauthentication/ { print $2; exit }')
if [ "$pwauth" = no ]; then ok "SSH password auth disabled"; else bad "SSH password auth is ENABLED ($pwauth)"; fi
if [ -e /dev/watchdog ]; then
    if rc-service wk-bridge-watchdog status >/dev/null 2>&1; then
        ok "hardware watchdog fed"
    else
        bad "/dev/watchdog exists but nothing is feeding it -- a hang stays hung"
    fi
else
    bad "no /dev/watchdog on this device"
fi
# Swap on eMMC wears out the only storage the phone has, and a bridge that
# swapped its way through a memory spike is a bridge whose flash died early.
# /proc/swaps, not `swapon --show`: the flag is util-linux's and busybox's
# swapon does not have it, which would report "no swap" on a phone that is
# quietly wearing out its eMMC.
nonzram=$(awk 'NR > 1 && $1 !~ /zram/ { c++ } END { print c + 0 }' /proc/swaps 2>/dev/null)
if [ "${nonzram:-0}" -eq 0 ]; then ok "swap is zram only"; else bad "swap on a non-zram device (eMMC wear)"; fi

if [ "$camera" != off ]; then
    hdr "Camera"
    # The kill switch is the access control and it is hardware: switched off,
    # the sensor is electrically disconnected, so there is no capture device and
    # the service cannot come up. That is a *note*, not a failure -- off is a
    # legitimate state and the whole reason the switch exists.
    if [ -e /dev/video0 ]; then
        if rc-service wk-bridge-camera status >/dev/null 2>&1; then
            ok "streaming (see 'wk bridge status' for the URL)"
        else
            bad "a capture device exists but the stream is not running"
        fi
    else
        note "no capture device -- the camera kill switch is off, so nothing streams"
    fi
fi

hdr "System"
# Crashed services, minus the ones whose "crash" is how they are built.
#
# OpenRC marks a service crashed when its process is gone while the service is
# marked started -- which is the normal end state of a one-shot. pmOS ships two
# that do exactly that, and reporting them as faults every single run trains
# whoever reads this to skip the crashed line, which is the one line here that
# must never be skipped.
#
#   kill-pbsplash        "Stop the splash animation": runs once, exits
#   postmarketos-tweakd  settings daemon; short-lived on a headless-ish boot,
#                        and nothing in this role depends on it
#
# Anything else crashing is reported.
crashed=$(rc-status --crashed 2>/dev/null | sed '/^$/d' \
          | grep -vxE 'kill-pbsplash|postmarketos-tweakd')
if [ -z "$crashed" ]; then
    ok "no crashed services (ignoring pmOS one-shots kill-pbsplash, postmarketos-tweakd)"
else
    bad "crashed: $(printf '%s' "$crashed" | tr '\n' ' ')"
fi
note "uptime $(uptime | sed 's/^ *//')"
for b in /sys/class/power_supply/*/capacity; do
    [ -f "$b" ] || continue
    d=$(dirname "$b")
    note "battery $(cat "$b")% $(cat "$d/status" 2>/dev/null) ($(basename "$d"))"
done

echo
if [ "$fail" -eq 0 ]; then
    printf '\033[1;32mAll checks passed.\033[0m\n'
else
    printf '\033[1;31mProblems found -- see FAIL lines above, and wk help bridge.\033[0m\n'
fi
exit "$fail"
