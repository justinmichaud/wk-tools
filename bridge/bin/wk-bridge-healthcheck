#!/bin/sh
# Raw key=value facts for a tailnet bridge; the phone has no python3, so lib/wk/bridge judges them.
set -u

name=unknown
device=unknown
iface=lan0
segment=""
router=""
leases=""
egress=none
camera=off
leasefile=/var/lib/misc/dnsmasq.leases
[ -f /etc/wk-bridge.conf ] && . /etc/wk-bridge.conf

f() { printf '%s=%s\n' "$1" "$2"; }

# First line out, so its presence tells "ran, then blank" from "never started" (bridge_record's `facts` check).
f facts yes
f name "$name"
f device "$device"
f segment "$segment"
f egress "$egress"
f camera "$camera"

wifi=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2 == "wifi" { print $1; exit }')
[ -n "$wifi" ] || wifi=wlan0
f wifi_iface "$wifi"
# `-o`, not `-br`: BusyBox ip has no brief mode and exits 1 with a usage message, reading back empty against a good lease.
f wifi_addr "$(ip -4 -o addr show dev "$wifi" 2>/dev/null | awk '{print $4; exit}')"
f wifi_ssid "$(iw dev "$wifi" link 2>/dev/null | awk -F: '/SSID/ { sub(/^ /, "", $2); print $2; exit }')"
f wifi_signal "$(iw dev "$wifi" link 2>/dev/null | awk '/signal:/ { print $2; exit }')"
f wifi_power_save "$(iw dev "$wifi" get power_save 2>/dev/null | awk '{print $3}')"

if ip -o link show "$iface" >/dev/null 2>&1; then
    f seg_iface_exists yes
    f seg_addr "$(ip -4 -o addr show "$iface" 2>/dev/null | awk '{print $4; exit}')"
    f seg_carrier "$(cat "/sys/class/net/$iface/carrier" 2>/dev/null)"
    nicdev=$(readlink -f "/sys/class/net/$iface/device" 2>/dev/null)
    f seg_usb_speed "$(cat "${nicdev%/*}/speed" 2>/dev/null)"
else
    f seg_iface_exists no
    f seg_typec_role "$(cat /sys/class/typec/port0/data_role 2>/dev/null)"
    downstream=""
    for d in /sys/bus/usb/devices/*-*; do
        [ -f "$d/idVendor" ] || continue
        downstream="$downstream$(cat "$d/idVendor"):$(cat "$d/idProduct" 2>/dev/null) $(cat "$d/product" 2>/dev/null),"
    done
    f seg_downstream "$downstream"
    found=""
    for n in /sys/class/net/*; do
        nn=$(basename "$n")
        case "$nn" in lo|wlan*|tailscale*|dummy*|usb*|"$iface") continue ;; esac
        [ -e "$n/device/subsystem" ] || continue
        case "$(readlink -f "$n/device/subsystem")" in
            */usb) found="$found$nn($(cat "$n/address" 2>/dev/null))," ;;
        esac
    done
    f seg_renamed_candidates "$found"
    # 02 (communications) and 0a (CDC data) are an ethernet adapter's classes; ff is ASIX/Realtek's vendor-specific one.
    unclaimed=""
    for i in /sys/bus/usb/devices/*-*/*:*; do
        [ -f "$i/bInterfaceClass" ] || continue
        [ -e "$i/driver" ] && continue
        case "$(cat "$i/bInterfaceClass" 2>/dev/null)" in
            02|0a|ff) unclaimed="$unclaimed$(basename "$i")," ;;
        esac
    done
    f seg_unclaimed "$unclaimed"
fi

if [ -s "$leasefile" ]; then f leases_file_nonempty yes; else f leases_file_nonempty no; fi

pinged=""
for l in $leases; do
    ip=$(printf '%s' "$l" | cut -d, -f2)
    nm=$(printf '%s' "$l" | cut -d, -f3)
    [ -n "$ip" ] || continue
    if ping -c 2 -W 2 "$ip" >/dev/null 2>&1; then
        pinged="$pinged$ip,${nm:-},up;"
    else
        pinged="$pinged$ip,${nm:-},down;"
    fi
done
f leases_ping "$pinged"

st=$(tailscale status --json --peers=false 2>/dev/null) || st=""
f ts_backend "$(printf '%s' "$st" | jq -r '.BackendState // "none"' 2>/dev/null)"
f ts_online "$(printf '%s' "$st" | jq -r '.Self.Online // false' 2>/dev/null)"
f ts_tags "$(printf '%s' "$st" | jq -rc '.Self.Tags // "none"' 2>/dev/null)"
f ts_routes "$(printf '%s' "$st" | jq -rc '.Self.PrimaryRoutes // "none"' 2>/dev/null)"

svc() {
    local n
    for n in "$@"; do
        [ -x "/etc/init.d/$n" ] && { printf '%s' "$n"; return 0; }
    done
    return 1
}
svcstate() {
    local s
    s=$(svc "$@") || { printf missing; return 0; }
    if rc-service "$s" status >/dev/null 2>&1; then printf running; else printf stopped; fi
}
for s in wk-bridge-dhcp wk-bridge-nftables wk-bridge-netwatch wk-bridge-usb-host; do
    f "svc_$s" "$(svcstate "$s")"
done
f svc_sshd "$(svcstate sshd)"
f svc_chrony "$(svcstate chronyd chrony)"
f svc_nm "$(svcstate networkmanager NetworkManager)"
f svc_tailscale "$(svcstate tailscale tailscaled)"

if nft list table inet wkbridge >/dev/null 2>&1; then
    f nft_table yes
    if nft list table inet wkbridge 2>/dev/null | grep -q masquerade; then f nft_masquerade yes; else f nft_masquerade no; fi
else
    f nft_table no
fi

f ip_forward "$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)"

if [ -f /etc/resolv.conf ]; then
    f resolv_exists yes
    f resolv_nameservers "$(grep -c '^nameserver' /etc/resolv.conf 2>/dev/null)"
    f resolv_first "$(grep '^nameserver' /etc/resolv.conf 2>/dev/null | head -1)"
else
    f resolv_exists no
fi
if nslookup login.tailscale.com >/dev/null 2>&1; then f dns_resolves yes; else f dns_resolves no; fi

f clock_year "$(date -u +%Y)"
f clock_iso "$(date -u '+%Y-%m-%d %H:%M UTC')"

f sshd_password_auth "$(sshd -T 2>/dev/null | awk '/^passwordauthentication/ { print $2; exit }')"

if [ -e /dev/watchdog ]; then
    f watchdog_device yes
    if rc-service wk-bridge-watchdog status >/dev/null 2>&1; then f watchdog_fed yes; else f watchdog_fed no; fi
else
    f watchdog_device no
    wdt=$(ls -d /proc/device-tree/*/watchdog@* 2>/dev/null | head -1)
    if [ -n "$wdt" ]; then
        f watchdog_dt_node "$(basename "$wdt")"
        f watchdog_dt_compatible "$(tr '\000' ' ' < "$wdt/compatible" 2>/dev/null)"
    fi
fi

# /proc/swaps, not `swapon --show`: that flag is util-linux's, and busybox's swapon misreports it.
f swap_nonzram "$(awk 'NR > 1 && $1 !~ /zram/ { c++ } END { print c + 0 }' /proc/swaps 2>/dev/null)"

if [ -e /dev/video0 ]; then
    f camera_device yes
    if rc-service wk-bridge-camera status >/dev/null 2>&1; then f camera_streaming yes; else f camera_streaming no; fi
else
    f camera_device no
fi

# kill-pbsplash and postmarketos-tweakd are one-shots OpenRC always marks crashed once they exit.
crashed=$(rc-status --crashed 2>/dev/null | sed '/^$/d' | grep -vxE 'kill-pbsplash|postmarketos-tweakd')
f crashed "$(printf '%s' "$crashed" | tr '\n' ',')"
f uptime "$(uptime | sed 's/^ *//')"

battery=""
for b in /sys/class/power_supply/*/capacity; do
    [ -f "$b" ] || continue
    d=$(dirname "$b")
    battery="$battery$(basename "$d"),$(cat "$b"),$(cat "$d/status" 2>/dev/null);"
done
f battery "$battery"

exit 0
