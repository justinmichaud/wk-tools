#!/bin/sh
# Exits 0 when there is nothing to apply, 1 only when the node exists and the write did not take -- verified by reading the node back, since a sysfs write can succeed against a value the driver then clamps.
set -u

CONF="${WK_BRIDGE_BATTERY_CONF:-/etc/wk-bridge-battery.conf}"
[ -f "$CONF" ] || exit 0

node=$(sed -n 's/^node=//p' "$CONF")
limit=$(sed -n 's/^limit=//p' "$CONF")
[ -n "$node" ] && [ -n "$limit" ] || exit 0

f="$node/charge_control_end_threshold"
if [ ! -w "$f" ]; then
    logger -t wk-bridge-battery "$f is not writable -- cannot cap the charge limit"
    exit 1
fi

cur=$(cat "$f" 2>/dev/null || echo '')
[ "$cur" = "$limit" ] && exit 0

printf '%s' "$limit" > "$f" 2>/dev/null

cur=$(cat "$f" 2>/dev/null || echo '?')
if [ "$cur" = "$limit" ]; then
    logger -t wk-bridge-battery "set $node charge_control_end_threshold=$limit%"
    exit 0
fi
logger -t wk-bridge-battery "wrote $limit to $f but it reads ${cur}% -- the write did not take"
exit 1
