#!/bin/sh
# Apply the charge-control threshold from /etc/wk-bridge-battery.conf. Run at
# boot by the wk-bridge-battery service -- the driver resets
# charge_control_end_threshold to its hardware default on every power-on, so
# nothing here survives on its own -- and once immediately by
# bridge/provision.sh so a re-run takes effect without a reboot.
#
# Idempotent: a node already at the target value is left alone. Exits 0 when
# there is nothing to apply (no conf yet, or this phone has no such node) so
# neither the boot nor bridge/provision.sh's restart loop treats "not
# supported here" as a crash; exits 1 only when the node exists but the write
# did not take, which is the one case worth a service marked failed.
set -u

# WK_BRIDGE_BATTERY_CONF overrides the path for tests/test_battery.py, which
# has no /etc to write into and no real charge_control_end_threshold to read
# back; ssh never sets it, so a real run always takes the default.
CONF="${WK_BRIDGE_BATTERY_CONF:-/etc/wk-bridge-battery.conf}"
[ -f "$CONF" ] || exit 0

node=$(sed -n 's/^node=//p' "$CONF")
limit=$(sed -n 's/^limit=//p' "$CONF")
[ -n "$node" ] && [ -n "$limit" ] || exit 0

f="$node/charge_control_end_threshold"
if [ ! -w "$f" ]; then
    logger -t wk-bridge-battery "$f is not writable -- cannot cap the charge limit"
    exit 1
fi

cur=$(cat "$f" 2>/dev/null || echo '')
[ "$cur" = "$limit" ] && exit 0

printf '%s' "$limit" > "$f" 2>/dev/null

# Verified by reading the node back, not assumed from the write's exit
# status: a sysfs write can succeed against a value the driver clamps
# (bridge/provision.sh does the same read-back for the same reason).
cur=$(cat "$f" 2>/dev/null || echo '?')
if [ "$cur" = "$limit" ]; then
    logger -t wk-bridge-battery "set $node charge_control_end_threshold=$limit%"
    exit 0
fi
logger -t wk-bridge-battery "wrote $limit to $f but it reads ${cur}% -- the write did not take"
exit 1
