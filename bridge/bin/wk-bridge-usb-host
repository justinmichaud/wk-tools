#!/bin/sh
# Put the Type-C port into host mode, so the USB Ethernet adapter enumerates.
#
# Both phones have exactly one USB-C port and both default to *device* mode:
# they become a host only if the attached dock asks for it on the CC pins, and
# a powered dock makes the phone a power sink, whose data role follows unless
# the dock performs a Data Role Swap. Some docks do, some do not, and the same
# dock does not always do it in the same order of plugging.
#
# So the role is asserted rather than hoped for -- at boot, and again by the
# watchdog whenever the downstream interface disappears (a re-plug, a PD
# renegotiation, a resume all drop it back). If the role will not change at
# all, the dock is refusing the swap and no amount of configuration fixes it;
# powering the dock *before* connecting it to the phone changes the negotiation
# and is the thing worth trying.
#
# Ordinary exit 0 even when nothing could be done: this runs at boot in front
# of the network, and a dock that is simply not plugged in yet must not hold
# the boot back or mark a service failed.
set -u

changed=0

for f in /sys/class/typec/port*/data_role; do
    [ -w "$f" ] || continue
    # Reads like "device [host]" or "[device] host" -- the brackets mark which
    # role is active, and the other word is what it could be switched to. A
    # port that lists no `host` at all cannot be switched and is skipped.
    cur=$(cat "$f" 2>/dev/null)
    case "$cur" in
        *"[host]"*) ;;
        *host*)
            if printf 'host\n' > "$f" 2>/dev/null; then
                changed=1
                logger -t wk-bridge-usb-host "set $(basename "$(dirname "$f")") data_role=host"
            fi
            ;;
    esac
done

# The other half of the same knob: the USB controller's own role, which on some
# kernels is what actually moves even when the Type-C port agrees already.
for f in /sys/class/usb_role/*/role; do
    [ -w "$f" ] || continue
    [ "$(cat "$f" 2>/dev/null)" = host ] && continue
    if printf 'host\n' > "$f" 2>/dev/null; then
        changed=1
        logger -t wk-bridge-usb-host "set $(basename "$(dirname "$f")") role=host"
    fi
done

# Enumeration is not instant, and the caller's next act is usually to look for
# the interface. Only when something actually moved: at boot, with the dock
# already in host mode, this would otherwise be three seconds of nothing.
[ "$changed" -eq 1 ] && sleep 3

# --- the companion-controller trap -------------------------------------------
#
# A downstream NIC can enumerate perfectly and still be forty times too slow,
# and nothing above notices because host mode is *correct* in that state.
#
# What happens on a PinePhone: the dock asks for the data
# role swap itself and the phone is host by 3.5 s, but at 13 s the pmOS
# initramfs sets up its USB-gadget network and flips the phy back to peripheral
# (`Changing dr_mode to 2`) with a hub physically attached. EHCI then spends a
# minute failing -- `device descriptor read/64, error -110`, port power cycles
# -- and gives up at 77 s with "unable to enumerate USB device". The port falls
# to the *companion* OHCI controller, and the dock comes up at full speed: 12
# Mbit/s instead of 480, capping a 100 Mbit ethernet at about eight.
#
# It is a race, so it is intermittent: which controller wins can differ
# between boots of the same phone, which is the worst way for a fault like
# this to behave.
#
# Recovery is a four-step rebind, and the order is the whole thing: the
# *companion* has to let go of the device before EHCI will take it.
#
#   unbind OHCI   releases the device, so the port has nothing attached
#   unbind EHCI   makes it forget that it gave up on this port
#   bind EHCI     it enumerates the re-connecting device, at high speed
#   bind OHCI     put the companion back for low/full-speed devices
#
# Rebinding EHCI *alone* is not enough: without first releasing the device
# from OHCI, the rebind can run indefinitely without ever moving the device
# off OHCI -- logging a recovery it is not performing. A repair that repeats
# forever is a fault, not a recovery.
#
# Hence the attempt cap. In /run, so its scope is one boot: if the fourth
# attempt has not worked, something about this dock is not what was measured,
# and the health check reporting 12 Mbit/s is more use than a bridge that
# resets its own USB controllers every minute for a day.
#
# Everything below is derived from sysfs rather than named: which interface is
# the downstream NIC, which controller it sits on, and which EHCI controller is
# that one's companion -- the last from the sunxi convention that the pair sits
# 0x400 apart, and only ever acted on when a platform device by that name
# actually exists. On a device with no such pair, nothing matches and nothing
# happens.
nic_usb_dev() {
    local n d p
    for n in /sys/class/net/*; do
        d=$(basename "$n")
        # usb* is the gadget, which is what this whole file exists to get out of
        case "$d" in lo|wlan*|tailscale*|dummy*|usb*) continue ;; esac
        [ -e "$n/device/subsystem" ] || continue
        case "$(readlink -f "$n/device/subsystem")" in */usb) ;; *) continue ;; esac
        p=$(readlink -f "$n/device")
        printf '%s' "${p%/*}"        # the usb_device dir, not the interface
        return 0
    done
    return 1
}

nic=$(nic_usb_dev) || exit 0
speed=$(cat "$nic/speed" 2>/dev/null || echo 0)
case "$speed" in
    480|5000|10000|20000) exit 0 ;;   # high speed or better: nothing to do
    0|'') exit 0 ;;                   # no answer; not something to act on
esac

ctrl=$(printf '%s' "$nic" | sed -n 's|.*/\([0-9a-f]*\)\.usb/usb[0-9]*/.*|\1|p')
[ -n "$ctrl" ] || exit 0
companion=$(printf '%x' $(( 0x$ctrl - 0x400 )) 2>/dev/null) || exit 0
[ -e /sys/devices/platform/soc/"$companion".usb ] || exit 0

TRIES=/run/wk-bridge-usb-speed-tries
tries=$(cat "$TRIES" 2>/dev/null || echo 0)
case "$tries" in ''|*[!0-9]*) tries=0 ;; esac
if [ "$tries" -ge 3 ]; then
    if [ "$tries" -eq 3 ]; then
        printf '%s' 4 > "$TRIES"
        logger -t wk-bridge-usb-host \
            "downstream NIC still at ${speed}Mbit/s after 3 rebinds -- leaving it until the next boot"
    fi
    exit 0
fi
printf '%s' "$((tries + 1))" > "$TRIES"

ohci=/sys/bus/platform/drivers/ohci-platform
ehci=/sys/bus/platform/drivers/ehci-platform

logger -t wk-bridge-usb-host \
    "downstream NIC is at ${speed}Mbit/s on $ctrl.usb -- rebinding (attempt $((tries + 1)))"

# Each step guarded on the current binding state: unbinding something already
# unbound is an error, and a sequence that aborts half-done leaves that port
# with no USB at all until the next boot.
[ -e "$ohci/$ctrl.usb" ] && { printf '%s\n' "$ctrl.usb" > "$ohci/unbind" 2>/dev/null || true; }
sleep 2
[ -e "$ehci/$companion.usb" ] && { printf '%s\n' "$companion.usb" > "$ehci/unbind" 2>/dev/null || true; }
sleep 1
[ -e "$ehci/$companion.usb" ] || { printf '%s\n' "$companion.usb" > "$ehci/bind" 2>/dev/null || true; }
sleep 5
[ -e "$ohci/$ctrl.usb" ] || { printf '%s\n' "$ctrl.usb" > "$ohci/bind" 2>/dev/null || true; }
sleep 3

nic=$(nic_usb_dev) || exit 0
now=$(cat "$nic/speed" 2>/dev/null || echo 0)
logger -t wk-bridge-usb-host "downstream NIC is now at ${now}Mbit/s"
case "$now" in 480|5000|10000|20000) rm -f "$TRIES" ;; esac
exit 0
