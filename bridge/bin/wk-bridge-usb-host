#!/bin/sh
# Put the Type-C port into host mode, so the USB Ethernet adapter enumerates.
#
# Both phones default to device mode and become host only if the dock
# performs a Data Role Swap on the CC pins -- not every dock does, and not
# always in the same plug order, so the role is asserted at boot and again by
# the watchdog whenever the downstream interface disappears. Exits 0 even when
# nothing could be done: a dock not yet plugged in must not hold boot back.
set -u

changed=0

for f in /sys/class/typec/port*/data_role; do
    [ -w "$f" ] || continue
    # "device [host]": brackets mark the active role; no `host` listed means unswitchable.
    cur=$(cat "$f" 2>/dev/null)
    case "$cur" in
        *"[host]"*) ;;
        *host*)
            if printf 'host\n' > "$f" 2>/dev/null; then
                changed=1
                logger -t wk-bridge-usb-host "set $(basename "$(dirname "$f")") data_role=host"
            fi
            ;;
    esac
done

# The USB controller's own role: on some kernels this moves even when the Type-C port already agrees.
for f in /sys/class/usb_role/*/role; do
    [ -w "$f" ] || continue
    [ "$(cat "$f" 2>/dev/null)" = host ] && continue
    if printf 'host\n' > "$f" 2>/dev/null; then
        changed=1
        logger -t wk-bridge-usb-host "set $(basename "$(dirname "$f")") role=host"
    fi
done

# Enumeration is not instant; only wait when something actually moved.
[ "$changed" -eq 1 ] && sleep 3

# --- the companion-controller trap -------------------------------------------
# A downstream NIC can enumerate at OHCI (12Mbit/s) instead of EHCI
# (480Mbit/s) even with host mode otherwise correct. On a PinePhone: the dock
# swaps role and the phone is host by 3.5s, but at 13s pmOS's initramfs flips
# the phy back to peripheral, so EHCI fails and gives up at 77s, and the port
# falls to the companion OHCI controller -- a race, intermittent between boots.
#
# Recovery is a four-step rebind in this order -- OHCI must release the device
# before EHCI's rebind will take it: unbind OHCI, unbind EHCI, bind EHCI, bind
# OHCI. Capped at 3 attempts (state in /run, scoped to one boot): a repair
# that repeats forever is a fault, not a recovery.
#
# NIC/controller/companion are found via sysfs, not named: the sunxi companion
# sits 0x400 below its OHCI controller.
nic_usb_dev() {
    local n d p
    for n in /sys/class/net/*; do
        d=$(basename "$n")
        # usb*: the gadget interface this file exists to get out of
        case "$d" in lo|wlan*|tailscale*|dummy*|usb*) continue ;; esac
        [ -e "$n/device/subsystem" ] || continue
        case "$(readlink -f "$n/device/subsystem")" in */usb) ;; *) continue ;; esac
        p=$(readlink -f "$n/device")
        printf '%s' "${p%/*}"        # the usb_device dir, not the interface
        return 0
    done
    return 1
}

nic=$(nic_usb_dev) || exit 0
speed=$(cat "$nic/speed" 2>/dev/null || echo 0)
case "$speed" in
    480|5000|10000|20000) exit 0 ;;   # high speed or better: nothing to do
    0|'') exit 0 ;;                   # no answer; not something to act on
esac

ctrl=$(printf '%s' "$nic" | sed -n 's|.*/\([0-9a-f]*\)\.usb/usb[0-9]*/.*|\1|p')
[ -n "$ctrl" ] || exit 0
companion=$(printf '%x' $(( 0x$ctrl - 0x400 )) 2>/dev/null) || exit 0
[ -e /sys/devices/platform/soc/"$companion".usb ] || exit 0

TRIES=/run/wk-bridge-usb-speed-tries
tries=$(cat "$TRIES" 2>/dev/null || echo 0)
case "$tries" in ''|*[!0-9]*) tries=0 ;; esac
if [ "$tries" -ge 3 ]; then
    if [ "$tries" -eq 3 ]; then
        printf '%s' 4 > "$TRIES"
        logger -t wk-bridge-usb-host \
            "downstream NIC still at ${speed}Mbit/s after 3 rebinds -- leaving it until the next boot"
    fi
    exit 0
fi
printf '%s' "$((tries + 1))" > "$TRIES"

ohci=/sys/bus/platform/drivers/ohci-platform
ehci=/sys/bus/platform/drivers/ehci-platform

logger -t wk-bridge-usb-host \
    "downstream NIC is at ${speed}Mbit/s on $ctrl.usb -- rebinding (attempt $((tries + 1)))"

# Guarded on binding state: a half-done sequence leaves the port with no USB until the next boot.
[ -e "$ohci/$ctrl.usb" ] && { printf '%s\n' "$ctrl.usb" > "$ohci/unbind" 2>/dev/null || true; }
sleep 2
[ -e "$ehci/$companion.usb" ] && { printf '%s\n' "$companion.usb" > "$ehci/unbind" 2>/dev/null || true; }
sleep 1
[ -e "$ehci/$companion.usb" ] || { printf '%s\n' "$companion.usb" > "$ehci/bind" 2>/dev/null || true; }
sleep 5
[ -e "$ohci/$ctrl.usb" ] || { printf '%s\n' "$ctrl.usb" > "$ohci/bind" 2>/dev/null || true; }
sleep 3

nic=$(nic_usb_dev) || exit 0
now=$(cat "$nic/speed" 2>/dev/null || echo 0)
logger -t wk-bridge-usb-host "downstream NIC is now at ${now}Mbit/s"
case "$now" in 480|5000|10000|20000) rm -f "$TRIES" ;; esac
exit 0
