#!/bin/sh
# UNTESTED on either phone: libcamera's sensor formats are not always what a plain v4l2 consumer expects, so the pipeline below may need work. With the camera kill switch off the sensor is electrically disconnected, so this waits for a device rather than failing without one.
set -u

camera=off
camera_device=""
camera_port=8081
[ -f /etc/wk-bridge.conf ] && . /etc/wk-bridge.conf

log() { logger -t wk-bridge-camera -- "$*"; printf 'wk-bridge-camera: %s\n' "$*"; }

# sleep, not exit: an exit here is a service supervise-daemon restarts forever.
if [ "$camera" = off ]; then
    log "camera is off in /etc/wk-bridge.conf -- nothing to do"
    while :; do sleep 3600; done
fi

pick_device() {
    [ -n "$camera_device" ] && { [ -e "$camera_device" ] && printf '%s' "$camera_device"; return; }
    for d in /dev/video*; do
        [ -e "$d" ] || continue
        if v4l2-ctl -d "$d" --all 2>/dev/null | grep "Video Capture" >/dev/null 2>&1; then
            printf '%s' "$d"; return
        fi
    done
}

while :; do
    dev=$(pick_device)
    if [ -z "$dev" ]; then
        sleep 30
        continue
    fi

    addr=$(tailscale ip -4 2>/dev/null | head -1)
    if [ -z "$addr" ]; then
        log "no tailnet address yet -- waiting rather than binding to the house network"
        sleep 30
        continue
    fi

    log "streaming $dev on http://$addr:$camera_port/"
    ffmpeg -nostdin -hide_banner -loglevel warning \
        -f v4l2 -framerate 5 -video_size 640x480 -i "$dev" \
        -q:v 8 -f mjpeg -listen 1 "http://$addr:$camera_port" \
        || log "ffmpeg exited ($?) -- retrying"
    sleep 5
done
