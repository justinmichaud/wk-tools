#!/bin/sh
# Matched by the device's own MODALIAS from sysfs, so it works across kernels; the PinePhone's sun50i-a64-wdt is a module only because image/profiles.sh sets CONFIG_SUNXI_WATCHDOG=m. No watchdog is a valid state, so this always exits 0.
set -u

[ -e /dev/watchdog ] && exit 0

for d in /sys/bus/platform/devices/*watchdog* /sys/bus/platform/devices/*wdt*; do
    [ -f "$d/uevent" ] || continue
    alias=$(sed -n 's/^MODALIAS=//p' "$d/uevent")
    [ -n "$alias" ] || continue
    modprobe -q "$alias" 2>/dev/null || continue
    if [ -e /dev/watchdog ]; then
        logger -t wk-bridge-watchdog-load "loaded the watchdog driver for $(basename "$d")"
        exit 0
    fi
done

exit 0
