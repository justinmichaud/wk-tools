#!/bin/sh
# Loads the driver for this device's hardware watchdog, if it has one.
# Matched by the device's own MODALIAS from sysfs (works across kernels,
# no-ops where absent). PinePhone needs sun50i-a64-wdt, built via
# image/profiles.sh's CONFIG_SUNXI_WATCHDOG=m; always exits 0, since no watchdog is valid too.
set -u

[ -e /dev/watchdog ] && exit 0

for d in /sys/bus/platform/devices/*watchdog* /sys/bus/platform/devices/*wdt*; do
    [ -f "$d/uevent" ] || continue
    alias=$(sed -n 's/^MODALIAS=//p' "$d/uevent")
    [ -n "$alias" ] || continue
    modprobe -q "$alias" 2>/dev/null || continue
    if [ -e /dev/watchdog ]; then
        logger -t wk-bridge-watchdog-load "loaded the watchdog driver for $(basename "$d")"
        exit 0
    fi
done

exit 0
