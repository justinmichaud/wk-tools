#!/usr/bin/env bash
#
# Bootstrap this machine. Idempotent: running it twice in a row must report no
# changes the second time, and it must never install software the host does not
# strictly need. Everything mutable belongs in a workspace, not here.
#
#   ./setup              everything for this OS
#   ./setup --stage X    just one stage (tools, settings, dotfiles, claude,
#                        mcp, sharing, machine, vmtools, softnet, sdk,
#                        broker, benchkey, quiesce)
#   ./setup --dry-run    report what would change

set -euo pipefail

WK_ROOT="$(cd "$(dirname "$0")" && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"

STAGE=all
export WK_DRY_RUN=""

while [ $# -gt 0 ]; do
    case "$1" in
        --stage) STAGE="${2:-}"; shift 2 ;;
        --dry-run) WK_DRY_RUN=1; shift ;;
        -h|--help) sed -n '2,10p' "$0" >&2; exit 0 ;;
        *) die "unknown option: $1" ;;
    esac
done

# Stages are independent, so one failing must not skip the rest.
#
# Not sourced directly: `set -e` inside a stage would then abort
# the whole script -- and the stages that need a password (packages, the group
# membership, the privileged helper) are the last three. A machine could come
# back from ./setup with no quiesce helper and no indication that a stage had
# been skipped rather than run.
#
# Each stage now runs in a subshell so a failure is contained, and the failures
# are collected and reported together at the end. The change count survives via
# an EXIT trap, so it is right even for a stage that died partway.
WK_FAILED_STAGES=""

run_stage() {
    local name="$1" script="$2"
    case "$STAGE" in
        all|"$name") ;;
        *) return 0 ;;
    esac
    [ -f "$script" ] || { debug "no $name stage for this OS"; return 0; }
    info "stage: $name"

    local tmp rc sub
    tmp="$(mktemp)"

    set +e
    # shellcheck disable=SC1090
    # `set -e` is re-enabled inside: the subshell inherits the parent's state,
    # and the `set +e` above would otherwise let a stage run on past its own
    # failure -- turning a contained failure into a stage that does half its
    # work and reports success.
    # The path is expanded now, the count when the trap fires: a local of this
    # function is not reliably still in scope by the time an errexit-killed
    # subshell runs its EXIT trap, and "tmp: unbound variable" at that point is
    # a confusing way to learn it.
    ( set -e; trap "echo \$WK_CHANGES > $tmp" EXIT; . "$script" )
    rc=$?
    set -e

    sub=$(cat "$tmp" 2>/dev/null || echo "$WK_CHANGES")
    rm -f "$tmp"
    case "$sub" in ''|*[!0-9]*) sub="$WK_CHANGES" ;; esac
    WK_CHANGES="$sub"

    if [ "$rc" -ne 0 ]; then
        warn "stage '$name' failed (exit $rc) -- continuing with the remaining stages"
        WK_FAILED_STAGES="$WK_FAILED_STAGES $name"
    fi
}

OS="$(wk_os)"
info "wk-tools setup on $OS ($(describe_cores), $(host_mem_mb) MB)"

# --- one password, once -------------------------------------------------------
#
# Several stages need root: the packages, the group membership, and the two
# privileged helpers. `wk sudo` deliberately holds the authentication for only
# 30 seconds (cmd/sudo says why it is neither 0 nor sudo's five minutes), and
# that window is sized for *one command's own privileged sequence*. This is one
# command -- but its privileged steps are minutes apart, because `apt-get
# install` sits between them, so the window closes in the gaps and every stage
# that follows asks again.
#
# So the authentication happens once, here, and a refresher holds it open for
# exactly as long as setup runs. That is not a weakening of the policy: the
# window stays 30 seconds and it is closed the moment this exits, which is the
# property the short timeout exists for. What it removes is the prompt arriving
# four times at unpredictable moments -- the thing that makes a person go
# looking for the switch that turns the whole mechanism off.
#
# Skipped when there is nothing to hold open: with no terminal there is nothing
# to prompt on (each stage already reports what it could not do), and where
# sudo needs no password at all there is no timestamp to keep warm.
_sudo_keepalive_pid=""
_sudo_keepalive_stop() {
    [ -n "$_sudo_keepalive_pid" ] || return 0
    kill "$_sudo_keepalive_pid" 2>/dev/null || true
    _sudo_keepalive_pid=""
    return 0
}

sudo_prime() {
    [ -z "${WK_DRY_RUN:-}" ] || return 0
    have sudo || return 0
    [ -t 0 ] || return 0                       # nothing to prompt on
    sudo -n true 2>/dev/null && return 0       # no password wanted here

    info "setup needs root for a few steps; authenticating once now"
    log  "  the window is held open only while setup runs, and closes when it ends"
    sudo -v || { warn "not authenticated -- the stages that need root will say so"; return 0; }

    # Half the window, so a refresh is never racing its own expiry. `sudo -n -v`
    # so a refresher that somehow outlives the timestamp fails silently instead
    # of prompting from the background, where nobody could answer it.
    #
    # Bounded by this process, and that is the load-bearing part rather than a
    # tidiness one. `wk_atexit` traps EXIT only, so a setup that is killed does
    # not necessarily run it -- and an orphaned refresher would go on renewing
    # root authentication for ever, which is precisely what a 30-second window
    # exists to make impossible. Checking the parent each pass caps the leak at
    # one sleep interval, whatever kills setup and whether or not the trap runs.
    _setup_pid=$$
    ( while kill -0 "$_setup_pid" 2>/dev/null; do
          sleep 15
          sudo -n -v 2>/dev/null || exit 0
      done ) &
    _sudo_keepalive_pid=$!
    wk_atexit _sudo_keepalive_stop
}

sudo_prime

HOST_DIR="$WK_ROOT/host/$OS"

run_stage tools    "$HOST_DIR/tools.sh"
run_stage settings "$HOST_DIR/settings.sh"
run_stage dotfiles "$WK_ROOT/host/dotfiles.sh"
run_stage claude   "$WK_ROOT/claude/install.sh"
run_stage mcp      "$HOST_DIR/mcp.sh"
run_stage sharing  "$HOST_DIR/sharing.sh"
run_stage machine  "$HOST_DIR/machine.sh"
run_stage vmtools  "$HOST_DIR/vmtools.sh"
run_stage softnet  "$HOST_DIR/softnet.sh"
run_stage sdk      "$HOST_DIR/sdk.sh"
# The fleet-request broker, after the SDK and the VM tooling: on macOS it
# publishes its socket into the podman machine, so the machine has to exist
# first, and on Linux it binds next to the proxy the sdk stage just started.
run_stage broker   "$HOST_DIR/broker.sh"
run_stage benchkey "$HOST_DIR/benchkey.sh"
run_stage quiesce  "$WK_ROOT/admin/install.sh"

echo >&2
if [ -n "$WK_FAILED_STAGES" ]; then
    warn "stage(s) failed:$WK_FAILED_STAGES"
    log  "  re-run ./setup, or a single stage with: ./setup --stage <name>"
fi

if [ "$WK_CHANGES" -eq 0 ]; then
    info "no changes -- this machine is already set up"
else
    info "$WK_CHANGES change(s) applied"
    log  "re-run ./setup to confirm it now reports no changes"
fi
log "wk doctor shows what is provisioned and what still needs a manual step"

# macOS: say plainly what is still missing, rather than leaving it to be
# discovered when a command refuses to run.
if is_macos && [ "$STAGE" = all ]; then
    _todo=""
    if ! have tart && [ ! -x "$HOME/.local/bin/tart" ]; then
        _todo="$_todo\n  - tart is not installed; 'wk vm' (Apple ports) is unavailable -- README.md, Setup"
    elif ! [ -x "${WK_SOFTNET_BIN:-/usr/local/bin/softnet}" ]; then
        _todo="$_todo\n  - softnet is not installed; 'wk vm start' refuses to boot a guest: ./setup --stage softnet"
    fi
    if [ -n "$_todo" ]; then
        echo >&2
        warn "still to do before macOS VM workspaces:"
        printf "%b\n" "$_todo" >&2
    fi
    unset _todo
fi

# Linux: say plainly what is still missing, rather than leaving it to be
# discovered when a benchmark refuses to run.
if is_linux && [ "$STAGE" = all ]; then
    _todo=""
    have cage || _todo="$_todo\n  - cage is not installed; 'wk session on' cannot start a compositor"
    [ -x /usr/local/libexec/wk-quiesce-priv ] \
        || _todo="$_todo\n  - the privileged helper is missing; 'wk quiesce' and 'wk session' will not work"
    # Two different questions: is the account configured, and does *this*
    # shell have the group yet. Group membership only reaches a process at
    # login, so reporting "not in the render group" right after adding it is
    # true of the shell and false of the machine, which reads as setup having
    # failed when it succeeded.
    case " $(id -nG "$(id -un)") " in
        *" render "*)
            case " $(id -nG) " in
                *" render "*) ;;
                *) _todo="$_todo\n  - the 'render' group is configured but not active in this shell;"
                   _todo="$_todo\n    log out and back in (or 'wk session on' grants access via logind's ACL)" ;;
            esac ;;
        *) _todo="$_todo\n  - not in the 'render' group; /dev/dri is unreachable from an ssh session" ;;
    esac
    if [ -n "$_todo" ]; then
        echo >&2
        warn "still to do before GPU benchmarks:"
        printf "%b\n" "$_todo" >&2
    fi
    unset _todo
fi

[ -z "$WK_FAILED_STAGES" ]
