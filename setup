#!/usr/bin/env bash
#
# Bootstrap this machine. Idempotent: running it twice in a row must report no
# changes the second time, and it must never install software the host does not
# strictly need. Everything mutable belongs in a workspace, not here.
#
#   ./setup              everything for this OS
#   ./setup --stage X    just one stage (tools, settings, dotfiles, claude,
#                        mcp, sharing, machine, vmtools, softnet, sdk,
#                        broker, benchkey, quiesce)
#   ./setup --dry-run    report what would change (WK_DRY_RUN=1; host/macos/
#                        sharing.sh reads the same variable)

set -euo pipefail

WK_ROOT="$(cd "$(dirname "$0")" && pwd)"
. "$WK_ROOT/lib/common.sh"
. "$WK_ROOT/lib/resources.sh"

STAGE=all
export WK_DRY_RUN=""

while [ $# -gt 0 ]; do
    case "$1" in
        --stage) STAGE="${2:-}"; shift 2 ;;
        --dry-run) WK_DRY_RUN=1; shift ;;
        -h|--help) sed -n '2,12p' "$0" >&2; exit 0 ;;
        *) die "unknown option: $1" ;;
    esac
done

# Each stage runs in a subshell rather than sourced: `set -e` inside a stage would
# abort the whole script, and the stages that need a password are the last three.
WK_FAILED_STAGES=""

run_stage() {
    local name="$1" script="$2"
    case "$STAGE" in
        all|"$name") ;;
        *) return 0 ;;
    esac
    [ -f "$script" ] || { debug "no $name stage for this OS"; return 0; }
    info "stage: $name"

    local tmp rc sub
    tmp="$(mktemp)"

    set +e
    # shellcheck disable=SC1090
    # `set -e` re-enabled inside: the subshell inherits the `set +e` above. $tmp is
    # expanded now, not in the trap, where this function's locals may be out of scope.
    ( set -e; trap "echo \$WK_CHANGES > $tmp" EXIT; . "$script" )
    rc=$?
    set -e

    sub=$(cat "$tmp" 2>/dev/null || echo "$WK_CHANGES")
    rm -f "$tmp"
    case "$sub" in ''|*[!0-9]*) sub="$WK_CHANGES" ;; esac
    WK_CHANGES="$sub"

    if [ "$rc" -ne 0 ]; then
        warn "stage '$name' failed (exit $rc) -- continuing with the remaining stages"
        WK_FAILED_STAGES="$WK_FAILED_STAGES $name"
    fi
}

OS="$(wk_os)"
info "wk-tools setup on $OS ($(describe_cores), $(host_mem_mb) MB)"

# `wk sudo`'s 30-second window closes in the gaps between setup's privileged steps.
_sudo_keepalive_pid=""
_sudo_keepalive_stop() {
    [ -n "$_sudo_keepalive_pid" ] || return 0
    kill "$_sudo_keepalive_pid" 2>/dev/null || true
    _sudo_keepalive_pid=""
    return 0
}

sudo_prime() {
    [ -z "${WK_DRY_RUN:-}" ] || return 0
    have sudo || return 0
    [ -t 0 ] || return 0                       # nothing to prompt on
    sudo -n true 2>/dev/null && return 0       # no password wanted here

    info "setup needs root for a few steps; authenticating once now"
    log  "  the window is held open only while setup runs, and closes when it ends"
    sudo -v || { warn "not authenticated -- the stages that need root will say so"; return 0; }

    # Half the window, so a refresh never races its own expiry; `sudo -n -v` so a
    # background refresher fails rather than prompts, and the parent check bounds it.
    _setup_pid=$$
    ( while kill -0 "$_setup_pid" 2>/dev/null; do
          sleep 15
          sudo -n -v 2>/dev/null || exit 0
      done ) &
    _sudo_keepalive_pid=$!
    wk_atexit _sudo_keepalive_stop
}

sudo_prime

HOST_DIR="$WK_ROOT/host/$OS"

run_stage tools    "$HOST_DIR/tools.sh"
run_stage settings "$HOST_DIR/settings.sh"
run_stage dotfiles "$WK_ROOT/host/dotfiles.sh"
run_stage claude   "$WK_ROOT/claude/install.sh"
run_stage mcp      "$HOST_DIR/mcp.sh"
run_stage sharing  "$HOST_DIR/sharing.sh"
run_stage machine  "$HOST_DIR/machine.sh"
run_stage vmtools  "$HOST_DIR/vmtools.sh"
run_stage softnet  "$HOST_DIR/softnet.sh"
run_stage sdk      "$HOST_DIR/sdk.sh"
# After sdk and vmtools: the broker publishes its socket into the podman machine
# on macOS, and binds beside the proxy the sdk stage started on Linux.
run_stage broker   "$HOST_DIR/broker.sh"
run_stage benchkey "$HOST_DIR/benchkey.sh"
run_stage quiesce  "$WK_ROOT/admin/install.sh"

echo >&2
if [ -n "$WK_FAILED_STAGES" ]; then
    warn "stage(s) failed:$WK_FAILED_STAGES"
    log  "  re-run ./setup, or a single stage with: ./setup --stage <name>"
fi

if [ "$WK_CHANGES" -eq 0 ]; then
    info "no changes -- this machine is already set up"
else
    info "$WK_CHANGES change(s) applied"
    log  "re-run ./setup to confirm it now reports no changes"
fi
log "wk doctor shows what is provisioned and what still needs a manual step"

if is_macos && [ "$STAGE" = all ]; then
    _todo=""
    if ! have tart && [ ! -x "$HOME/.local/bin/tart" ]; then
        _todo="$_todo\n  - tart is not installed; 'wk vm' (Apple ports) is unavailable -- README.md, Setup"
    elif ! [ -x "${WK_SOFTNET_BIN:-/usr/local/bin/softnet}" ]; then
        _todo="$_todo\n  - softnet is not installed; 'wk vm start' refuses to boot a guest: ./setup --stage softnet"
    fi
    if [ -n "$_todo" ]; then
        echo >&2
        warn "still to do before macOS VM workspaces:"
        printf "%b\n" "$_todo" >&2
    fi
    unset _todo
fi

if is_linux && [ "$STAGE" = all ]; then
    _todo=""
    have cage || _todo="$_todo\n  - cage is not installed; 'wk session on' cannot start a compositor"
    [ -x /usr/local/libexec/wk-quiesce-priv ] \
        || _todo="$_todo\n  - the privileged helper is missing; 'wk quiesce' and 'wk session' will not work"
    # Group membership only reaches a process at login: configured is not yet active.
    case " $(id -nG "$(id -un)") " in
        *" render "*)
            case " $(id -nG) " in
                *" render "*) ;;
                *) _todo="$_todo\n  - the 'render' group is configured but not active in this shell;"
                   _todo="$_todo\n    log out and back in (or 'wk session on' grants access via logind's ACL)" ;;
            esac ;;
        *) _todo="$_todo\n  - not in the 'render' group; /dev/dri is unreachable from an ssh session" ;;
    esac
    if [ -n "$_todo" ]; then
        echo >&2
        warn "still to do before GPU benchmarks:"
        printf "%b\n" "$_todo" >&2
    fi
    unset _todo
fi

[ -z "$WK_FAILED_STAGES" ]
