{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:bugs.webkit.org)",
      "WebFetch(domain:ews-build.webkit.org)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/private/tmp"
    ],
    "deny": [
      "Bash(ninja *)",
      "Bash(*/ninja *)",
      "Bash(cmake *)",
      "Bash(*/cmake *)",
      "Bash(make *)",
      "Bash(*/make *)",
      "Bash(xcodebuild *)",
      "Bash(*/xcodebuild *)",
      "Bash(build-webkit *)",
      "Bash(*/build-webkit *)",
      "Bash(build-jsc *)",
      "Bash(*/build-jsc *)",
      "Bash(run-javascriptcore-tests *)",
      "Bash(*/run-javascriptcore-tests *)",
      "Bash(run-webkit-tests *)",
      "Bash(*/run-webkit-tests *)",
      "Bash(run-benchmark *)",
      "Bash(*/run-benchmark *)"
    ]
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/webkit-jsc-skill-reminder.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "theme": "dark",
  "autoCompactEnabled": false,
  "precomputeCompactionEnabled": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
