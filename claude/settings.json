{
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:bugs.webkit.org)",
      "WebFetch(domain:ews-build.webkit.org)",
      "WebFetch(domain:isocpp.org)",
      "WebFetch(domain:www.open-std.org)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Skill(jsc)",
      "Skill(jsc:*)",
      "Skill(build-webkit)",
      "Skill(build-webkit:*)",
      "Skill(add-file-to-webkit)",
      "Skill(add-file-to-webkit:*)",
      "Skill(fix-webkit-ews)",
      "Skill(fix-webkit-ews:*)"
    ],
    "deny": [
      "Bash(ninja *)",
      "Bash(*/ninja *)",
      "Bash(cmake *)",
      "Bash(*/cmake *)",
      "Bash(make *)",
      "Bash(*/make *)",
      "Bash(xcodebuild *)",
      "Bash(*/xcodebuild *)",
      "Bash(build-webkit *)",
      "Bash(*/build-webkit *)",
      "Bash(build-jsc *)",
      "Bash(*/build-jsc *)",
      "Bash(run-javascriptcore-tests *)",
      "Bash(*/run-javascriptcore-tests *)",
      "Bash(run-webkit-tests *)",
      "Bash(*/run-webkit-tests *)",
      "Bash(run-benchmark *)",
      "Bash(*/run-benchmark *)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/private/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/webkit-jsc-skill-reminder.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "theme": "dark",
  "autoCompactEnabled": false,
  "precomputeCompactionEnabled": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
